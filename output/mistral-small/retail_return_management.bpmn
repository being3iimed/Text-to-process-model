<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="empty-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="ReturnProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CustomerInitiatesReturnRequest-id-0001" name="Customer Initiates Return Request">
      <bpmn:outgoing>SequenceFlow-StartToCustomerInitiatesReturnRequest-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CustomerInitiatesReturnRequest-id-0001" name="Customer Initiates Return Request">
      <bpmn:incoming>SequenceFlow-StartToCustomerInitiatesReturnRequest-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerInitiatesReturnRequestToValidateReturnEligibility-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ValidateReturnEligibility-id-0001" name="Validate Return Eligibility">
      <bpmn:incoming>SequenceFlow-CustomerInitiatesReturnRequestToValidateReturnEligibility-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidateReturnEligibilityToEligible-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ValidateReturnEligibilityToNotEligible-id-0002</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ReturnEligibility-id-0001" name="Return Eligible?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ValidateReturnEligibilityToEligible-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReturnEligibilityToSendReturnShippingLabel-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-SendReturnShippingLabel-id-0001" name="Send: Return Shipping Label">
      <bpmn:incoming>SequenceFlow-ReturnEligibilityToSendReturnShippingLabel-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendReturnShippingLabelToCustomerShipsItem-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-CustomerShipsItem-id-0001" name="Customer Ships Item">
      <bpmn:incoming>SequenceFlow-SendReturnShippingLabelToCustomerShipsItem-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerShipsItemToWarehouseVerifiesItemCondition-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-WarehouseVerifiesItemCondition-id-0001" name="Warehouse Verifies Item Condition">
      <bpmn:incoming>SequenceFlow-CustomerShipsItemToWarehouseVerifiesItemCondition-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WarehouseVerifiesItemConditionToAcceptable-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-WarehouseVerifiesItemConditionToDamaged-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ItemCondition-id-0001" name="Item Condition Acceptable?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-WarehouseVerifiesItemConditionToAcceptable-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ItemConditionToProcessRefund-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ProcessRefund-id-0001" name="Process Refund">
      <bpmn:incoming>SequenceFlow-ItemConditionToProcessRefund-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProcessRefundToSendRefundConfirmationEmail-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendRefundConfirmationEmail-id-0001" name="Send: Refund Confirmation Email">
      <bpmn:incoming>SequenceFlow-ProcessRefundToSendRefundConfirmationEmail-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendRefundConfirmationEmailToEndEvent-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask-SendReturnDeniedNotification-id-0001" name="Send: Return Denied Notification">
      <bpmn:incoming>SequenceFlow-WarehouseVerifiesItemConditionToDamaged-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendReturnDeniedNotificationToEndEvent-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask-SendReturnDeniedNotification-id-0002" name="Send: Return Denied Notification">
      <bpmn:incoming>SequenceFlow-ValidateReturnEligibilityToNotEligible-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendReturnDeniedNotificationToEndEvent-id-0002</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0001" name="Process Complete">
      <bpmn:incoming>SequenceFlow-SendRefundConfirmationEmailToEndEvent-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SendReturnDeniedNotificationToEndEvent-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SendReturnDeniedNotificationToEndEvent-id-0002</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCustomerInitiatesReturnRequest-id-0001" sourceRef="StartEvent-CustomerInitiatesReturnRequest-id-0001" targetRef="UserTask-CustomerInitiatesReturnRequest-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerInitiatesReturnRequestToValidateReturnEligibility-id-0001" sourceRef="UserTask-CustomerInitiatesReturnRequest-id-0001" targetRef="ServiceTask-ValidateReturnEligibility-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidateReturnEligibilityToEligible-id-0001" name="eligible" sourceRef="ServiceTask-ValidateReturnEligibility-id-0001" targetRef="ExclusiveGateway-ReturnEligibility-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidateReturnEligibilityToNotEligible-id-0002" name="not eligible" sourceRef="ServiceTask-ValidateReturnEligibility-id-0001" targetRef="SendTask-SendReturnDeniedNotification-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ReturnEligibilityToSendReturnShippingLabel-id-0001" sourceRef="ExclusiveGateway-ReturnEligibility-id-0001" targetRef="SendTask-SendReturnShippingLabel-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendReturnShippingLabelToCustomerShipsItem-id-0001" sourceRef="SendTask-SendReturnShippingLabel-id-0001" targetRef="UserTask-CustomerShipsItem-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerShipsItemToWarehouseVerifiesItemCondition-id-0001" sourceRef="UserTask-CustomerShipsItem-id-0001" targetRef="UserTask-WarehouseVerifiesItemCondition-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WarehouseVerifiesItemConditionToAcceptable-id-0001" name="acceptable" sourceRef="UserTask-WarehouseVerifiesItemCondition-id-0001" targetRef="ExclusiveGateway-ItemCondition-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WarehouseVerifiesItemConditionToDamaged-id-0002" name="damaged" sourceRef="UserTask-WarehouseVerifiesItemCondition-id-0001" targetRef="SendTask-SendReturnDeniedNotification-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ItemConditionToProcessRefund-id-0001" sourceRef="ExclusiveGateway-ItemCondition-id-0001" targetRef="ServiceTask-ProcessRefund-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProcessRefundToSendRefundConfirmationEmail-id-0001" sourceRef="ServiceTask-ProcessRefund-id-0001" targetRef="SendTask-SendRefundConfirmationEmail-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendRefundConfirmationEmailToEndEvent-id-0001" sourceRef="SendTask-SendRefundConfirmationEmail-id-0001" targetRef="EndEvent-ProcessComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendReturnDeniedNotificationToEndEvent-id-0001" sourceRef="SendTask-SendReturnDeniedNotification-id-0001" targetRef="EndEvent-ProcessComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendReturnDeniedNotificationToEndEvent-id-0002" sourceRef="SendTask-SendReturnDeniedNotification-id-0002" targetRef="EndEvent-ProcessComplete-id-0001" />
  </bpmn:process>
