      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ItemCondition-id-0001_di" bpmnElement="ExclusiveGateway-ItemCondition-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
