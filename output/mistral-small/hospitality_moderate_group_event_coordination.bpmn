<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions-ClientRequestProcess-id-0001" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process-ClientRequestProcess-id-0001" name="Client Request Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ClientRequest-id-0001" name="Client Requests Conference Room and Catering">
      <bpmn:outgoing>SequenceFlow-StartToClientRequest-id-0033</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ClientRequest-id-0002" name="Client Requests Conference Room and Catering">
      <bpmn:incoming>SequenceFlow-StartToClientRequest-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ClientRequestToSystemCalculatesSetup-id-0034</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-SystemCalculatesSetup-id-0003" name="System Calculates Setup Requirements">
      <bpmn:incoming>SequenceFlow-ClientRequestToSystemCalculatesSetup-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SystemCalculatesSetupToAvailabilityCheck-id-0035</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AvailabilityCheck-id-0004" name="Availability Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SystemCalculatesSetupToAvailabilityCheck-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AvailabilityCheckToUnavailabilityNotice-id-0036</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AvailabilityCheckToEventDetailsToCatering-id-0038</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-UnavailabilityNotice-id-0005" name="Send: Unavailability Notice to Client">
      <bpmn:incoming>SequenceFlow-AvailabilityCheckToUnavailabilityNotice-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UnavailabilityNoticeToEventUnavailable-id-0037</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-EventUnavailable-id-0006" name="Event Unavailable">
      <bpmn:incoming>SequenceFlow-UnavailabilityNoticeToEventUnavailable-id-0037</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-EventDetailsToCatering-id-0007" name="Send: Event Details to Catering">
      <bpmn:incoming>SequenceFlow-AvailabilityCheckToEventDetailsToCatering-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EventDetailsToCateringToClientApprovesMenu-id-0039</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-ClientApprovesMenu-id-0008" name="Client Approves Menu and Headcount">
      <bpmn:incoming>SequenceFlow-EventDetailsToCateringToClientApprovesMenu-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ClientApprovesMenuToApprovalCheck-id-0040</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ApprovalCheck-id-0009" name="Approval Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ClientApprovesMenuToApprovalCheck-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalCheckToRejectionNotice-id-0041</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ApprovalCheckToCateringPreparation-id-0043</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-RejectionNotice-id-0010" name="Send: Rejection Notice to Client">
      <bpmn:incoming>SequenceFlow-ApprovalCheckToRejectionNotice-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RejectionNoticeToEventRejected-id-0042</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-EventRejected-id-0011" name="Event Rejected">
      <bpmn:incoming>SequenceFlow-RejectionNoticeToEventRejected-id-0042</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess-CateringPreparation-id-0012" name="Catering Preparation">
      <bpmn:incoming>SequenceFlow-ApprovalCheckToCateringPreparation-id-0043</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CateringPreparationToRoomSetup-id-0044</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-CateringPreparationStart-id-0013" name="Catering Preparation Start">
        <bpmn:outgoing>SequenceFlow-CateringPreparationStartToPreparesFood-id-0018</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-CateringPreparesFood-id-0014" name="Catering Prepares Food Day Before">
        <bpmn:incoming>SequenceFlow-CateringPreparationStartToPreparesFood-id-0018</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CateringPreparesFoodToStoresFood-id-0019</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CateringStoresFood-id-0015" name="Catering Stores Food Appropriately">
        <bpmn:incoming>SequenceFlow-CateringPreparesFoodToStoresFood-id-0019</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CateringStoresFoodToPreparesSupplies-id-0020</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CateringPreparesSupplies-id-0016" name="Catering Prepares Serving Supplies">
        <bpmn:incoming>SequenceFlow-CateringStoresFoodToPreparesSupplies-id-0020</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CateringPreparesSuppliesToComplete-id-0021</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-CateringPreparationComplete-id-0017" name="Catering Preparation Complete">
        <bpmn:incoming>SequenceFlow-CateringPreparesSuppliesToComplete-id-0021</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-CateringPreparationStartToPreparesFood-id-0018" sourceRef="StartEvent-CateringPreparationStart-id-0013" targetRef="ServiceTask-CateringPreparesFood-id-0014" />
      <bpmn:sequenceFlow id="SequenceFlow-CateringPreparesFoodToStoresFood-id-0019" sourceRef="ServiceTask-CateringPreparesFood-id-0014" targetRef="ServiceTask-CateringStoresFood-id-0015" />
      <bpmn:sequenceFlow id="SequenceFlow-CateringStoresFoodToPreparesSupplies-id-0020" sourceRef="ServiceTask-CateringStoresFood-id-0015" targetRef="ServiceTask-CateringPreparesSupplies-id-0016" />
      <bpmn:sequenceFlow id="SequenceFlow-CateringPreparesSuppliesToComplete-id-0021" sourceRef="ServiceTask-CateringPreparesSupplies-id-0016" targetRef="EndEvent-CateringPreparationComplete-id-0017" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-RoomSetup-id-0022" name="Room Setup">
      <bpmn:incoming>SequenceFlow-CateringPreparationToRoomSetup-id-0044</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RoomSetupToEventComplete-id-0045</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-RoomSetupStart-id-0023" name="Room Setup Start">
        <bpmn:outgoing>SequenceFlow-RoomSetupStartToSetsUpRoom-id-0028</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-HousekeepingSetsUpRoom-id-0024" name="Housekeeping Sets Up Room">
        <bpmn:incoming>SequenceFlow-RoomSetupStartToSetsUpRoom-id-0028</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-HousekeepingSetsUpRoomToTestsAV-id-0029</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-ITTeamTestsAV-id-0025" name="IT Team Tests AV Equipment">
        <bpmn:incoming>SequenceFlow-HousekeepingSetsUpRoomToTestsAV-id-0029</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ITTeamTestsAVToDeliversBuffet-id-0030</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CateringDeliversBuffet-id-0026" name="Catering Delivers and Sets Up Buffet">
        <bpmn:incoming>SequenceFlow-ITTeamTestsAVToDeliversBuffet-id-0030</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CateringDeliversBuffetToComplete-id-0031</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-RoomSetupComplete-id-0027" name="Room Setup Complete">
        <bpmn:incoming>SequenceFlow-CateringDeliversBuffetToComplete-id-0031</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-RoomSetupStartToSetsUpRoom-id-0028" sourceRef="StartEvent-RoomSetupStart-id-0023" targetRef="ServiceTask-HousekeepingSetsUpRoom-id-0024" />
      <bpmn:sequenceFlow id="SequenceFlow-HousekeepingSetsUpRoomToTestsAV-id-0029" sourceRef="ServiceTask-HousekeepingSetsUpRoom-id-0024" targetRef="ServiceTask-ITTeamTestsAV-id-0025" />
      <bpmn:sequenceFlow id="SequenceFlow-ITTeamTestsAVToDeliversBuffet-id-0030" sourceRef="ServiceTask-ITTeamTestsAV-id-0025" targetRef="ServiceTask-CateringDeliversBuffet-id-0026" />
      <bpmn:sequenceFlow id="SequenceFlow-CateringDeliversBuffetToComplete-id-0031" sourceRef="ServiceTask-CateringDeliversBuffet-id-0026" targetRef="EndEvent-RoomSetupComplete-id-0027" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent-EventComplete-id-0032" name="Event Complete">
      <bpmn:incoming>SequenceFlow-RoomSetupToEventComplete-id-0045</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToClientRequest-id-0033" sourceRef="StartEvent-ClientRequest-id-0001" targetRef="UserTask-ClientRequest-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ClientRequestToSystemCalculatesSetup-id-0034" sourceRef="UserTask-ClientRequest-id-0002" targetRef="ServiceTask-SystemCalculatesSetup-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-SystemCalculatesSetupToAvailabilityCheck-id-0035" name="room_available AND catering_available" sourceRef="ServiceTask-SystemCalculatesSetup-id-0003" targetRef="ExclusiveGateway-AvailabilityCheck-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-AvailabilityCheckToUnavailabilityNotice-id-0036" sourceRef="ExclusiveGateway-AvailabilityCheck-id-0004" targetRef="SendTask-UnavailabilityNotice-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-UnavailabilityNoticeToEventUnavailable-id-0037" sourceRef="SendTask-UnavailabilityNotice-id-0005" targetRef="EndEvent-EventUnavailable-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-AvailabilityCheckToEventDetailsToCatering-id-0038" sourceRef="ExclusiveGateway-AvailabilityCheck-id-0004" targetRef="SendTask-EventDetailsToCatering-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-EventDetailsToCateringToClientApprovesMenu-id-0039" sourceRef="SendTask-EventDetailsToCatering-id-0007" targetRef="UserTask-ClientApprovesMenu-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ClientApprovesMenuToApprovalCheck-id-0040" sourceRef="UserTask-ClientApprovesMenu-id-0008" targetRef="ExclusiveGateway-ApprovalCheck-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalCheckToRejectionNotice-id-0041" sourceRef="ExclusiveGateway-ApprovalCheck-id-0009" targetRef="SendTask-RejectionNotice-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-RejectionNoticeToEventRejected-id-0042" sourceRef="SendTask-RejectionNotice-id-0010" targetRef="EndEvent-EventRejected-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalCheckToCateringPreparation-id-0043" sourceRef="ExclusiveGateway-ApprovalCheck-id-0009" targetRef="SubProcess-CateringPreparation-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-CateringPreparationToRoomSetup-id-0044" sourceRef="SubProcess-CateringPreparation-id-0012" targetRef="SubProcess-RoomSetup-id-0022" />
    <bpmn:sequenceFlow id="SequenceFlow-RoomSetupToEventComplete-id-0045" sourceRef="SubProcess-RoomSetup-id-0022" targetRef="EndEvent-EventComplete-id-0032" />
  </bpmn:process>
