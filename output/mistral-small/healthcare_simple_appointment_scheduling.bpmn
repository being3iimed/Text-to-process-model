<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process_1" name="Appointment Booking Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_PatientRequestsAppointment_id_0001" name="Patient Requests Appointment">
      <bpmn:outgoing>SequenceFlow_StartEventToReceiveTask_id_0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="ReceiveTask_ReceiveAppointmentRequest_id_0001" name="Receive: appointment request">
      <bpmn:incoming>SequenceFlow_StartEventToReceiveTask_id_0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveToUserTask_id_0001</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="UserTask_ReceptionistChecksAvailability_id_0001" name="Receptionist checks availability">
      <bpmn:incoming>SequenceFlow_ReceiveToUserTask_id_0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UserTaskToGateway_id_0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_SlotsAvailable_id_0001" name="Slots Available?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_UserTaskToGateway_id_0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayToBookAppointment_id_0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GatewayToUserTask_id_0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_BookAppointment_id_0001" name="Book appointment">
      <bpmn:incoming>SequenceFlow_GatewayToBookAppointment_id_0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BookToSendTask_id_0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask_SendConfirmationEmail_id_0001" name="Send: confirmation email">
      <bpmn:incoming>SequenceFlow_BookToSendTask_id_0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToEndEvent_id_0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_AppointmentBooked_id_0001" name="Appointment Booked">
      <bpmn:incoming>SequenceFlow_SendToEndEvent_id_0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_AddToWaitlist_id_0001" name="Add to waitlist">
      <bpmn:incoming>SequenceFlow_GatewayToUserTask_id_0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UserTaskToEndEvent_id_0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_PatientWaitlisted_id_0001" name="Patient Waitlisted">
      <bpmn:incoming>SequenceFlow_UserTaskToEndEvent_id_0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_WaitlistManagement_id_0001" name="Waitlist Management">
      <bpmn:startEvent id="StartEvent_WaitlistStart_id_0001" name="Waitlist Start">
        <bpmn:outgoing>SequenceFlow_StartEventToReceiveTask_id_0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask_MonitorCancellations_id_0001" name="Monitor cancellations">
        <bpmn:incoming>SequenceFlow_StartEventToReceiveTask_id_0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_MonitorToTimer_id_0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_TimerBoundary_id_0001" name="1 Hour Timer">
        <bpmn:incoming>SequenceFlow_MonitorToTimer_id_0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_TimerToSendTask_id_0001</bpmn:outgoing>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="SendTask_SendCancellationOffer_id_0001" name="Send: cancellation offer">
        <bpmn:incoming>SequenceFlow_TimerToSendTask_id_0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_SendToReceiveTask_id_0001</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask_ReceivePatientConfirmation_id_0001" name="Receive: patient confirmation">
        <bpmn:incoming>SequenceFlow_SendToReceiveTask_id_0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_ReceiveToGateway_id_0001</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway_PatientAccepts_id_0001" name="Patient Accepts?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow_ReceiveToGateway_id_0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_GatewayToBookAppointment_id_0001</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_GatewayToEndEvent_id_0001</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask_BookAppointmentFromWaitlist_id_0001" name="Book appointment">
        <bpmn:incoming>SequenceFlow_GatewayToBookAppointment_id_0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_BookToSendTask_id_0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SendTask_SendConfirmationEmailFromWaitlist_id_0001" name="Send: confirmation email">
        <bpmn:incoming>SequenceFlow_BookToSendTask_id_0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_SendToEndEvent_id_0001</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_AppointmentBookedFromWaitlist_id_0001" name="Appointment Booked">
        <bpmn:incoming>SequenceFlow_SendToEndEvent_id_0001</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="EndEvent_WaitlistContinues_id_0001" name="Waitlist Continues">
        <bpmn:incoming>SequenceFlow_GatewayToEndEvent_id_0001</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow_StartEventToReceiveTask_id_0001" sourceRef="StartEvent_WaitlistStart_id_0001" targetRef="ServiceTask_MonitorCancellations_id_0001" />
      <bpmn:sequenceFlow id="SequenceFlow_MonitorToTimer_id_0001" sourceRef="ServiceTask_MonitorCancellations_id_0001" targetRef="IntermediateCatchEvent_TimerBoundary_id_0001" />
      <bpmn:sequenceFlow id="SequenceFlow_TimerToSendTask_id_0001" sourceRef="IntermediateCatchEvent_TimerBoundary_id_0001" targetRef="SendTask_SendCancellationOffer_id_0001" />
      <bpmn:sequenceFlow id="SequenceFlow_SendToReceiveTask_id_0001" sourceRef="SendTask_SendCancellationOffer_id_0001" targetRef="ReceiveTask_ReceivePatientConfirmation_id_0001" />
      <bpmn:sequenceFlow id="SequenceFlow_ReceiveToGateway_id_0001" sourceRef="ReceiveTask_ReceivePatientConfirmation_id_0001" targetRef="ExclusiveGateway_PatientAccepts_id_0001" />
      <bpmn:sequenceFlow id="SequenceFlow_GatewayToBookAppointment_id_0001" name="patient_accepts" sourceRef="ExclusiveGateway_PatientAccepts_id_0001" targetRef="ServiceTask_BookAppointmentFromWaitlist_id_0001" />
      <bpmn:sequenceFlow id="SequenceFlow_BookToSendTask_id_0001" sourceRef="ServiceTask_BookAppointmentFromWaitlist_id_0001" targetRef="SendTask_SendConfirmationEmailFromWaitlist_id_0001" />
      <bpmn:sequenceFlow id="SequenceFlow_SendToEndEvent_id_0001" sourceRef="SendTask_SendConfirmationEmailFromWaitlist_id_0001" targetRef="EndEvent_AppointmentBookedFromWaitlist_id_0001" />
      <bpmn:sequenceFlow id="SequenceFlow_GatewayToEndEvent_id_0001" sourceRef="ExclusiveGateway_PatientAccepts_id_0001" targetRef="EndEvent_WaitlistContinues_id_0001" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveToUserTask_id_0001" sourceRef="ReceiveTask_ReceiveAppointmentRequest_id_0001" targetRef="UserTask_ReceptionistChecksAvailability_id_0001" />
    <bpmn:sequenceFlow id="SequenceFlow_UserTaskToGateway_id_0001" sourceRef="UserTask_ReceptionistChecksAvailability_id_0001" targetRef="ExclusiveGateway_SlotsAvailable_id_0001" />
    <bpmn:sequenceFlow id="SequenceFlow_GatewayToUserTask_id_0001" sourceRef="ExclusiveGateway_SlotsAvailable_id_0001" targetRef="UserTask_AddToWaitlist_id_0001" />
    <bpmn:sequenceFlow id="SequenceFlow_UserTaskToEndEvent_id_0001" sourceRef="UserTask_AddToWaitlist_id_0001" targetRef="EndEvent_PatientWaitlisted_id_0001" />
  </bpmn:process>
