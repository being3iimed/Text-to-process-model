<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="empty-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="BookingProcess-id-0001" name="Hotel Booking Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-GuestInitiatesBooking-id-0001" name="Guest initiates booking">
      <bpmn:outgoing>SequenceFlow-StartToSearch-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-GuestSearchesAvailability-id-0001" name="Guest searches availability">
      <bpmn:incoming>SequenceFlow-StartToSearch-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SearchToRetrieve-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-RetrieveRoomAvailability-id-0001" name="Retrieve room availability">
      <bpmn:incoming>SequenceFlow-SearchToRetrieve-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RetrieveToSelect-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-GuestSelectsRoom-id-0001" name="Guest selects room">
      <bpmn:incoming>SequenceFlow-RetrieveToSelect-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToCollect-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CollectPayment-id-0001" name="Collect payment">
      <bpmn:incoming>SequenceFlow-SelectToCollect-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CollectToSend-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendBookingConfirmationEmail-id-0001" name="Send booking confirmation email">
      <bpmn:incoming>SequenceFlow-CollectToSend-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToLink-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-LinkToLoyaltyAccount-id-0001" name="Link to loyalty account">
      <bpmn:incoming>SequenceFlow-SendToLink-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LinkToUpdate-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-UpdateHousekeepingSchedule-id-0001" name="Update housekeeping schedule">
      <bpmn:incoming>SequenceFlow-LinkToUpdate-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToEnd-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-BookingComplete-id-0001" name="Booking complete">
      <bpmn:incoming>SequenceFlow-UpdateToEnd-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSearch-id-0001" sourceRef="StartEvent-GuestInitiatesBooking-id-0001" targetRef="UserTask-GuestSearchesAvailability-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SearchToRetrieve-id-0001" sourceRef="UserTask-GuestSearchesAvailability-id-0001" targetRef="ServiceTask-RetrieveRoomAvailability-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RetrieveToSelect-id-0001" sourceRef="ServiceTask-RetrieveRoomAvailability-id-0001" targetRef="UserTask-GuestSelectsRoom-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToCollect-id-0001" sourceRef="UserTask-GuestSelectsRoom-id-0001" targetRef="ServiceTask-CollectPayment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CollectToSend-id-0001" sourceRef="ServiceTask-CollectPayment-id-0001" targetRef="SendTask-SendBookingConfirmationEmail-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToLink-id-0001" sourceRef="SendTask-SendBookingConfirmationEmail-id-0001" targetRef="ServiceTask-LinkToLoyaltyAccount-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-LinkToUpdate-id-0001" sourceRef="ServiceTask-LinkToLoyaltyAccount-id-0001" targetRef="ServiceTask-UpdateHousekeepingSchedule-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToEnd-id-0001" sourceRef="ServiceTask-UpdateHousekeepingSchedule-id-0001" targetRef="EndEvent-BookingComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BookingProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_BookingProcess-id-0001" bpmnElement="BookingProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-GuestInitiatesBooking-id-0001_di" bpmnElement="StartEvent-GuestInitiatesBooking-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-GuestSearchesAvailability-id-0001_di" bpmnElement="UserTask-GuestSearchesAvailability-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RetrieveRoomAvailability-id-0001_di" bpmnElement="ServiceTask-RetrieveRoomAvailability-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-GuestSelectsRoom-id-0001_di" bpmnElement="UserTask-GuestSelectsRoom-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CollectPayment-id-0001_di" bpmnElement="ServiceTask-CollectPayment-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendBookingConfirmationEmail-id-0001_di" bpmnElement="SendTask-SendBookingConfirmationEmail-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-LinkToLoyaltyAccount-id-0001_di" bpmnElement="ServiceTask-LinkToLoyaltyAccount-id-0001">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-UpdateHousekeepingSchedule-id-0001_di" bpmnElement="ServiceTask-UpdateHousekeepingSchedule-id-0001">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-BookingComplete-id-0001_di" bpmnElement="EndEvent-BookingComplete-id-0001">
        <dc:Bounds x="1257" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSearch-id-0001_di" bpmnElement="SequenceFlow-StartToSearch-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SearchToRetrieve-id-0001_di" bpmnElement="SequenceFlow-SearchToRetrieve-id-0001">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RetrieveToSelect-id-0001_di" bpmnElement="SequenceFlow-RetrieveToSelect-id-0001">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectToCollect-id-0001_di" bpmnElement="SequenceFlow-SelectToCollect-id-0001">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CollectToSend-id-0001_di" bpmnElement="SequenceFlow-CollectToSend-id-0001">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendToLink-id-0001_di" bpmnElement="SequenceFlow-SendToLink-id-0001">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LinkToUpdate-id-0001_di" bpmnElement="SequenceFlow-LinkToUpdate-id-0001">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UpdateToEnd-id-0001_di" bpmnElement="SequenceFlow-UpdateToEnd-id-0001">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1257" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
