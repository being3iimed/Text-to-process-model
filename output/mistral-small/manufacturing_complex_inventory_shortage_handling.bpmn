<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions-InventoryCheckProcess-id-0001" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process-InventoryCheckProcess-id-0001" name="Inventory Check Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-InventoryCheckTriggered-id-0001" name="Inventory Check Triggered" />
    <bpmn:serviceTask id="ServiceTask-CheckInventoryForComponentX-id-0001" name="Check Inventory for Component X" />
    <bpmn:exclusiveGateway id="ExclusiveGateway-InventoryCheck-id-0001" name="Inventory Check" gatewayDirection="Diverging" />
    <bpmn:endEvent id="EndEvent-ProductionProceeds-id-0001" name="Production Proceeds" />
    <bpmn:serviceTask id="ServiceTask-CheckNextSupplierDelivery-id-0001" name="Check Next Supplier Delivery" />
    <bpmn:exclusiveGateway id="ExclusiveGateway-DeliveryTimeCheck-id-0001" name="Delivery Time Check" gatewayDirection="Diverging" />
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-WaitForDelivery-id-0001" name="Wait for Delivery" />
    <bpmn:endEvent id="EndEvent-ProductionResumes-id-0001" name="Production Resumes" />
    <bpmn:serviceTask id="ServiceTask-CheckForAlternativeComponents-id-0001" name="Check for Alternative Components" />
    <bpmn:exclusiveGateway id="ExclusiveGateway-AlternativeComponentCheck-id-0001" name="Alternative Component Check" gatewayDirection="Diverging" />
    <bpmn:sendTask id="SendTask-NotifyProductionToUseAlternative-id-0001" name="Notify Production to Use Alternative" />
    <bpmn:subProcess id="SubProcess-ExpediteHandling-id-0001" name="Expedite Handling">
      <bpmn:startEvent id="StartEvent-ExpediteStart-id-0001" name="Expedite Start" />
      <bpmn:serviceTask id="ServiceTask-RequestSupplierExpedite-id-0001" name="Request Supplier Expedite" />
      <bpmn:boundaryEvent id="BoundaryEvent-SupplierExpediteError-id-0001" name="Supplier Expedite Error" attachedToRef="ServiceTask-RequestSupplierExpedite-id-0001">
        <bpmn:errorEventDefinition id="BoundaryEvent-SupplierExpediteError-id-0001_EventDef" errorRef="SUPPLIER_EXPEDITE_ERROR" />
      </bpmn:boundaryEvent>
      <bpmn:subProcess id="SubProcess-BackupSupplierProcess-id-0001" name="Backup Supplier Process">
        <bpmn:startEvent id="StartEvent-BackupSupplierStart-id-0001" name="Backup Supplier Start" />
        <bpmn:userTask id="UserTask-ProcurementManagerFindsBackupSupplier-id-0001" name="Procurement Manager Finds Backup Supplier" />
        <bpmn:serviceTask id="ServiceTask-CreatePurchaseOrder-id-0001" name="Create Purchase Order" />
        <bpmn:boundaryEvent id="BoundaryEvent-BackupSupplierUnavailable-id-0001" name="Backup Supplier Unavailable" attachedToRef="ServiceTask-CreatePurchaseOrder-id-0001">
          <bpmn:errorEventDefinition id="BoundaryEvent-BackupSupplierUnavailable-id-0001_EventDef" errorRef="BACKUP_SUPPLIER_UNAVAILABLE" />
        </bpmn:boundaryEvent>
        <bpmn:userTask id="UserTask-ProcurementManagerFindsAlternativeBackupSupplier-id-0001" name="Procurement Manager Finds Alternative Backup Supplier" />
        <bpmn:sendTask id="SendTask-ConfirmBackupSupplierDelivery-id-0001" name="Confirm Backup Supplier Delivery" />
        <bpmn:endEvent id="EndEvent-BackupSupplierProcessComplete-id-0001" name="Backup Supplier Process Complete" />
      </bpmn:subProcess>
      <bpmn:sendTask id="SendTask-NotifyProductionOfExpedite-id-0001" name="Notify Production of Expedite" />
      <bpmn:exclusiveGateway id="ExclusiveGateway-ExpediteSuccessCheck-id-0001" name="Expedite Success Check" gatewayDirection="Diverging" />
      <bpmn:endEvent id="EndEvent-ExpediteComplete-id-0001" name="Expedite Complete" />
      <bpmn:endEvent id="EndEvent-ProceedToBackupSupplier-id-0001" name="Proceed to Backup Supplier" />
    </bpmn:subProcess>
    <bpmn:sendTask id="SendTask-NotifyDependentProductionLines-id-0001" name="Notify Dependent Production Lines of Potential Delay" />
    <bpmn:serviceTask id="ServiceTask-LogCostVariance-id-0001" name="Log Cost Variance" />
    <bpmn:serviceTask id="ServiceTask-UpdateSupplierMetrics-id-0001" name="Update Supplier Metrics" />
  </bpmn:process>
  <bpmn:error id="SUPPLIER_EXPEDITE_ERROR" name="SUPPLIER_EXPEDITE_ERROR" />
  <bpmn:error id="BACKUP_SUPPLIER_UNAVAILABLE" name="BACKUP_SUPPLIER_UNAVAILABLE" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process-InventoryCheckProcess-id-0001">
