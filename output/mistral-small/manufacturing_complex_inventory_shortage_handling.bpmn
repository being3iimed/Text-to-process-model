      <bpmndi:BPMNShape id="SendTask-NotifyDependentProductionLines-id-0001_di" bpmnElement="SendTask-NotifyDependentProductionLines-id-0001">
        <dc:Bounds x="25" y="1710" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-LogCostVariance-id-0001_di" bpmnElement="ServiceTask-LogCostVariance-id-0001">
        <dc:Bounds x="25" y="1850" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-UpdateSupplierMetrics-id-0001_di" bpmnElement="ServiceTask-UpdateSupplierMetrics-id-0001">
        <dc:Bounds x="25" y="1990" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-ExpediteHandling-id-0001">
