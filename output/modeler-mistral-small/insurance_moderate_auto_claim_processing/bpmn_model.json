          "name": "4 Hour Timeout",
          "attachedToRef": "UserTask-CollectClaimDetails-id-0001",
          "cancelActivity": true,
          "eventDefinitions": [
            {
              "$type": "bpmn:TimerEventDefinition",
              "timeDuration": "PT4H"
