        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ChairMakesFinalDetermination-id-0001",
          "name": "Chair makes final determination"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendOutcomeNotification-id-0001",
          "name": "Send: outcome notification to student"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-RegistrarUpdatesSystem-id-0001",
          "name": "Registrar updates system"
        },
        {
