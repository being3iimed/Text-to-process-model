          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ActivationToLogin-id-0015",
          "sourceRef": "ReceiveTask-WaitForActivation-id-0001",
          "targetRef": "UserTask-LogIntoAccount-id-0001",
          "name": ""
