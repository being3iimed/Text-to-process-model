          "outgoing": [
            "SequenceFlow-StartToSelectCourse-id-0001"
          ]
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-SelectDesiredCourse-id-0001",
          "name": "Select Desired Course",
          "incoming": [
            "SequenceFlow-StartToSelectCourse-id-0001"
          ],
          "outgoing": [
            "SequenceFlow-SelectToSlotsCheck-id-0002"
          ]
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-SlotsAvailable-id-0001",
