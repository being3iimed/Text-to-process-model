{
  "$type": "bpmn:Definitions",
  "id": "DismissalProcessDefinitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "BPMN Modeler",
  "exporterVersion": "1.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "DismissalProcess",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-DismissalInitiated-id-0001",
          "name": "Dismissal Process Initiated"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendDismissalToMSPO-id-0001",
          "name": "Send: dismissal to MSPO"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-MSPOReviewsDismissal-id-0001",
          "name": "MSPO reviews dismissal"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-DismissalDecision-id-0001",
          "name": "Dismissal Decision",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-MSPORejectsDismissal-id-0001",
          "name": "MSPO rejects dismissal"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-MSPOConfirmsDismissal-id-0001",
          "name": "MSPO confirms dismissal"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-DismissalComplete-id-0001",
          "name": "Dismissal Process Complete"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToSend-id-0001",
          "sourceRef": "StartEvent-DismissalInitiated-id-0001",
          "targetRef": "SendTask-SendDismissalToMSPO-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SendToReview-id-0002",
          "sourceRef": "SendTask-SendDismissalToMSPO-id-0001",
          "targetRef": "UserTask-MSPOReviewsDismissal-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReviewToGateway-id-0003",
          "sourceRef": "UserTask-MSPOReviewsDismissal-id-0001",
          "targetRef": "ExclusiveGateway-DismissalDecision-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToReject-id-0004",
          "name": "dismissal_rejected",
          "sourceRef": "ExclusiveGateway-DismissalDecision-id-0001",
          "targetRef": "UserTask-MSPORejectsDismissal-id-0001",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToConfirm-id-0005",
          "name": "dismissal_confirmed",
          "sourceRef": "ExclusiveGateway-DismissalDecision-id-0001",
          "targetRef": "UserTask-MSPOConfirmsDismissal-id-0001",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-RejectToEnd-id-0006",
          "sourceRef": "UserTask-MSPORejectsDismissal-id-0001",
          "targetRef": "EndEvent-DismissalComplete-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ConfirmToEnd-id-0007",
          "sourceRef": "UserTask-MSPOConfirmsDismissal-id-0001",
          "targetRef": "EndEvent-DismissalComplete-id-0001"
        }
      ]
    }
  ]
}