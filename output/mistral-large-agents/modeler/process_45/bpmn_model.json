{
  "$type": "bpmn:Definitions",
  "id": "shopping-process-definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "ShoppingProcess-id-0001",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-StartShoppingProcess-id-0001",
          "name": "Start Shopping Process"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-EnterLoginCredentials-id-0001",
          "name": "Enter Login Credentials"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CheckCredentials-id-0001",
          "name": "Check Credentials"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-CredentialsValid-id-0001",
          "name": "Credentials Valid?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-LoginFailed-id-0001",
          "name": "Login Failed"
        },
        {
          "$type": "bpmn:SubProcess",
          "id": "SubProcess-ProductSelection-id-0001",
          "name": "Product Selection",
          "flowElements": [
            {
              "$type": "bpmn:StartEvent",
              "id": "StartEvent-BeginProductSelection-id-0001",
              "name": "Begin Product Selection"
            },
            {
              "$type": "bpmn:UserTask",
              "id": "UserTask-SelectProduct-id-0001",
              "name": "Select Product"
            },
            {
              "$type": "bpmn:ServiceTask",
              "id": "ServiceTask-AddToCart-id-0001",
              "name": "Add to Cart"
            },
            {
              "$type": "bpmn:ServiceTask",
              "id": "ServiceTask-SaveProduct-id-0001",
              "name": "Save Product"
            },
            {
              "$type": "bpmn:ScriptTask",
              "id": "ScriptTask-CheckAllProductsSelected-id-0001",
              "name": "Computation: check if all products selected"
            },
            {
              "$type": "bpmn:ExclusiveGateway",
              "id": "ExclusiveGateway-AllProductsSelected-id-0001",
              "name": "All Products Selected?",
              "gatewayDirection": "Diverging"
            },
            {
              "$type": "bpmn:EndEvent",
              "id": "EndEvent-ProductSelectionComplete-id-0001",
              "name": "Product Selection Complete"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SubProcessStartToSelect-id-0001",
              "sourceRef": "StartEvent-BeginProductSelection-id-0001",
              "targetRef": "UserTask-SelectProduct-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SelectToAdd-id-0002",
              "sourceRef": "UserTask-SelectProduct-id-0001",
              "targetRef": "ServiceTask-AddToCart-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-AddToSave-id-0003",
              "sourceRef": "ServiceTask-AddToCart-id-0001",
              "targetRef": "ServiceTask-SaveProduct-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SaveToCheck-id-0004",
              "sourceRef": "ServiceTask-SaveProduct-id-0001",
              "targetRef": "ScriptTask-CheckAllProductsSelected-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-CheckToGateway-id-0005",
              "sourceRef": "ScriptTask-CheckAllProductsSelected-id-0001",
              "targetRef": "ExclusiveGateway-AllProductsSelected-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-GatewayToComplete-id-0006",
              "name": "all_products_selected",
              "sourceRef": "ExclusiveGateway-AllProductsSelected-id-0001",
              "targetRef": "EndEvent-ProductSelectionComplete-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-GatewayToSelect-id-0007",
              "name": "",
              "sourceRef": "ExclusiveGateway-AllProductsSelected-id-0001",
              "targetRef": "UserTask-SelectProduct-id-0001",
              "isDefault": true
            }
          ]
        },
        {
          "$type": "bpmn:ParallelGateway",
          "id": "ParallelGateway-PreparePaymentShipment-id-0001",
          "name": "Prepare Payment and Shipment",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-PreparePayment-id-0001",
          "name": "Prepare Payment"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-PrepareShipment-id-0001",
          "name": "Prepare Shipment"
        },
        {
          "$type": "bpmn:SubProcess",
          "id": "SubProcess-PaymentProcessing-id-0001",
          "name": "Payment Processing",
          "flowElements": [
            {
              "$type": "bpmn:StartEvent",
              "id": "StartEvent-PaymentInitiated-id-0001",
              "name": "Payment Initiated"
            },
            {
              "$type": "bpmn:UserTask",
              "id": "UserTask-EnterPaymentData-id-0001",
              "name": "Enter Payment Data"
            },
            {
              "$type": "bpmn:ReceiveTask",
              "id": "ReceiveTask-BankPaymentConfirmation-id-0001",
              "name": "Receive: bank payment confirmation"
            },
            {
              "$type": "bpmn:BoundaryEvent",
              "id": "BoundaryEvent-Timer5Min-PaymentConfirmation-id-0001",
              "name": "5 Minute Timeout",
              "attachedToRef": "ReceiveTask-BankPaymentConfirmation-id-0001",
              "cancelActivity": true,
              "eventDefinitions": [
                {
                  "$type": "bpmn:TimerEventDefinition",
                  "timeDuration": "PT5M"
                }
              ]
            },
            {
              "$type": "bpmn:SendTask",
              "id": "SendTask-PaymentTimeoutNotification-id-0001",
              "name": "Send: payment timeout notification"
            },
            {
              "$type": "bpmn:EndEvent",
              "id": "EndEvent-PaymentConfirmed-id-0001",
              "name": "Payment Confirmed"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-PaymentStartToEnterData-id-0001",
              "sourceRef": "StartEvent-PaymentInitiated-id-0001",
              "targetRef": "UserTask-EnterPaymentData-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-EnterDataToReceive-id-0002",
              "sourceRef": "UserTask-EnterPaymentData-id-0001",
              "targetRef": "ReceiveTask-BankPaymentConfirmation-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-BoundaryToNotification-id-0003",
              "sourceRef": "BoundaryEvent-Timer5Min-PaymentConfirmation-id-0001",
              "targetRef": "SendTask-PaymentTimeoutNotification-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-ReceiveToPaymentEnd-id-0004",
              "sourceRef": "ReceiveTask-BankPaymentConfirmation-id-0001",
              "targetRef": "EndEvent-PaymentConfirmed-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-NotificationToPaymentEnd-id-0005",
              "sourceRef": "SendTask-PaymentTimeoutNotification-id-0001",
              "targetRef": "EndEvent-PaymentConfirmed-id-0001"
            }
          ]
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-EnterShippingAddress-id-0001",
          "name": "Enter Shipping Address"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-BillingAddressNeeded-id-0001",
          "name": "Billing Address Needed?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-EnterBillingAddress-id-0001",
          "name": "Enter Billing Address"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-FinalizeOrder-id-0001",
          "name": "Finalize Order"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-OrderComplete-id-0001",
          "name": "Order Complete"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToLogin-id-0001",
          "sourceRef": "StartEvent-StartShoppingProcess-id-0001",
          "targetRef": "UserTask-EnterLoginCredentials-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-LoginToCheck-id-0002",
          "sourceRef": "UserTask-EnterLoginCredentials-id-0001",
          "targetRef": "ServiceTask-CheckCredentials-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CheckToGateway-id-0003",
          "sourceRef": "ServiceTask-CheckCredentials-id-0001",
          "targetRef": "ExclusiveGateway-CredentialsValid-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToLoginFailed-id-0004",
          "name": "",
          "sourceRef": "ExclusiveGateway-CredentialsValid-id-0001",
          "targetRef": "EndEvent-LoginFailed-id-0001",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToProductSelection-id-0005",
          "name": "credentials_valid",
          "sourceRef": "ExclusiveGateway-CredentialsValid-id-0001",
          "targetRef": "SubProcess-ProductSelection-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ProductSelectionToPrepare-id-0006",
          "sourceRef": "SubProcess-ProductSelection-id-0001",
          "targetRef": "ParallelGateway-PreparePaymentShipment-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-PrepareToPayment-id-0007",
          "sourceRef": "ParallelGateway-PreparePaymentShipment-id-0001",
          "targetRef": "ServiceTask-PreparePayment-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-PrepareToShipment-id-0008",
          "sourceRef": "ParallelGateway-PreparePaymentShipment-id-0001",
          "targetRef": "ServiceTask-PrepareShipment-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-PaymentToPaymentSubprocess-id-0009",
          "sourceRef": "ServiceTask-PreparePayment-id-0001",
          "targetRef": "SubProcess-PaymentProcessing-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ShipmentToAddress-id-0010",
          "sourceRef": "ServiceTask-PrepareShipment-id-0001",
          "targetRef": "UserTask-EnterShippingAddress-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AddressToBillingGateway-id-0011",
          "sourceRef": "UserTask-EnterShippingAddress-id-0001",
          "targetRef": "ExclusiveGateway-BillingAddressNeeded-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-BillingGatewayToBillingAddress-id-0012",
          "name": "shipping_address != billing_address",
          "sourceRef": "ExclusiveGateway-BillingAddressNeeded-id-0001",
          "targetRef": "UserTask-EnterBillingAddress-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-BillingGatewayToFinalize-id-0013",
          "name": "",
          "sourceRef": "ExclusiveGateway-BillingAddressNeeded-id-0001",
          "targetRef": "ServiceTask-FinalizeOrder-id-0001",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-BillingAddressToFinalize-id-0014",
          "sourceRef": "UserTask-EnterBillingAddress-id-0001",
          "targetRef": "ServiceTask-FinalizeOrder-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-FinalizeToOrderComplete-id-0015",
          "sourceRef": "ServiceTask-FinalizeOrder-id-0001",
          "targetRef": "EndEvent-OrderComplete-id-0001"
        }
      ]
    }
  ]
}