{
  "$type": "bpmn:Definitions",
  "id": "MarketingCampaignExecution",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "BPMN Modeler",
  "exporterVersion": "1.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Process-MarketingCampaignExecution-id-0001",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-CampaignPlanningInitiated-id-0001",
          "name": "Campaign Planning Initiated"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-DefineCampaignObjectives-id-0001",
          "name": "Define Campaign Objectives",
          "documentation": "Set target audience, goals (lead generation/brand awareness), and KPIs"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CreateContentAndDesignVisuals-id-0002",
          "name": "Create Content and Design Visuals"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-SelectPromotionChannels-id-0003",
          "name": "Select Promotion Channels",
          "documentation": "Options: Digital Ads, Email Marketing, Social Media Posts"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-LaunchCampaign-id-0001",
          "name": "Launch Campaign",
          "documentation": "Deploy campaign across selected channels"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-TrackPerformanceMetrics-id-0002",
          "name": "Track Performance Metrics",
          "documentation": "Metrics: Click-Through Rates, Conversions, Engagement. Real-time tracking."
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CollectLeadsInCRM-id-0003",
          "name": "Collect Leads in CRM",
          "documentation": "System: CRM System. Action: Automated lead data transfer."
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-SalesFollowUp-id-0004",
          "name": "Sales Follow-Up",
          "documentation": "Sales team contacts leads for conversion."
        },
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-CampaignEndDate-id-0002",
          "name": "Campaign End Date",
          "eventDefinitions": [
            {
              "$type": "bpmn:TimerEventDefinition",
              "timeDate": "2024-12-31T23:59:59"
            }
          ]
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-AnalyzeCampaignPerformance-id-0004",
          "name": "Analyze Campaign Performance",
          "documentation": "Generate reports on KPIs vs. goals for future optimization."
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-CampaignAnalysisComplete-id-0001",
          "name": "Campaign Analysis Complete"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToDefineObjectives-id-0001",
          "sourceRef": "StartEvent-CampaignPlanningInitiated-id-0001",
          "targetRef": "UserTask-DefineCampaignObjectives-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-DefineToCreateContent-id-0002",
          "sourceRef": "UserTask-DefineCampaignObjectives-id-0001",
          "targetRef": "UserTask-CreateContentAndDesignVisuals-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CreateToSelectChannels-id-0003",
          "sourceRef": "UserTask-CreateContentAndDesignVisuals-id-0002",
          "targetRef": "UserTask-SelectPromotionChannels-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SelectToLaunch-id-0004",
          "sourceRef": "UserTask-SelectPromotionChannels-id-0003",
          "targetRef": "ServiceTask-LaunchCampaign-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-LaunchToTrack-id-0005",
          "sourceRef": "ServiceTask-LaunchCampaign-id-0001",
          "targetRef": "ServiceTask-TrackPerformanceMetrics-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-TrackToCollectLeads-id-0006",
          "sourceRef": "ServiceTask-TrackPerformanceMetrics-id-0002",
          "targetRef": "ServiceTask-CollectLeadsInCRM-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CollectToSalesFollowUp-id-0007",
          "sourceRef": "ServiceTask-CollectLeadsInCRM-id-0003",
          "targetRef": "UserTask-SalesFollowUp-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SalesToTimerTrigger-id-0008",
          "sourceRef": "UserTask-SalesFollowUp-id-0004",
          "targetRef": "StartEvent-CampaignEndDate-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-TimerToAnalyze-id-0009",
          "sourceRef": "StartEvent-CampaignEndDate-id-0002",
          "targetRef": "ServiceTask-AnalyzeCampaignPerformance-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AnalyzeToEnd-id-0010",
          "sourceRef": "ServiceTask-AnalyzeCampaignPerformance-id-0004",
          "targetRef": "EndEvent-CampaignAnalysisComplete-id-0001"
        }
      ]
    }
  ]
}