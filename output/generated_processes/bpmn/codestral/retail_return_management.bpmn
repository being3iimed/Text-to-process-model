        <di:waypoint x="1275" y="140" />
        <di:waypoint x="675" y="140" />
        <di:waypoint x="675" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EligibilityCheckToDenialNotice-id-0038_di" bpmnElement="SequenceFlow-EligibilityCheckToDenialNotice-id-0038">
        <di:waypoint x="1300" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DenialNoticeToProcessComplete-id-0039_di" bpmnElement="SequenceFlow-DenialNoticeToProcessComplete-id-0039">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1557" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-ReturnVerification-id-0008">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-ReturnVerification-id-0008" bpmnElement="SubProcess-ReturnVerification-id-0008">
      <bpmndi:BPMNShape id="StartEvent-VerificationStart-id-0009_di" bpmnElement="StartEvent-VerificationStart-id-0009">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-VerifyItemCondition-id-0010_di" bpmnElement="UserTask-VerifyItemCondition-id-0010">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ConditionCheck-id-0011_di" bpmnElement="ExclusiveGateway-ConditionCheck-id-0011" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcessRefund-id-0012_di" bpmnElement="ServiceTask-ProcessRefund-id-0012">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-Error-ProcessRefund-id-0013_di" bpmnElement="BoundaryEvent-Error-ProcessRefund-id-0013">
        <dc:Bounds x="507" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RefundProcessed-id-0015_di" bpmnElement="EndEvent-RefundProcessed-id-0015">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ManualRefundProcessing-id-0014_di" bpmnElement="UserTask-ManualRefundProcessing-id-0014">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendReturnDenialNotice-id-0016_di" bpmnElement="SendTask-SendReturnDenialNotice-id-0016">
        <dc:Bounds x="475" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ReturnDenied-id-0017_di" bpmnElement="EndEvent-ReturnDenied-id-0017">
        <dc:Bounds x="657" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-VerificationStartToVerify-id-0018_di" bpmnElement="SequenceFlow-VerificationStartToVerify-id-0018">
