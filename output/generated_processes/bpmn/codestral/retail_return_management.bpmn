        <di:waypoint x="525" y="128" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ManualRefundToRefundProcessed-id-0023_di" bpmnElement="SequenceFlow-ManualRefundToRefundProcessed-id-0023">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="825" y="210" />
        <di:waypoint x="825" y="88" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DenialNoticeToReturnDenied-id-0025_di" bpmnElement="SequenceFlow-DenialNoticeToReturnDenied-id-0025">
        <di:waypoint x="575" y="350" />
        <di:waypoint x="657" y="350" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
