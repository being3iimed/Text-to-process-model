        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-WarehouseReceivesPackage-id-0007_di" bpmnElement="ReceiveTask-WarehouseReceivesPackage-id-0007">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-ReturnVerification-id-0008_di" bpmnElement="SubProcess-ReturnVerification-id-0008">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendRefundConfirmation-id-0026_di" bpmnElement="SendTask-SendRefundConfirmation-id-0026">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-EligibilityCheck-id-0005_di" bpmnElement="ExclusiveGateway-EligibilityCheck-id-0005" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendReturnDenialNotice-id-0027_di" bpmnElement="SendTask-SendReturnDenialNotice-id-0027">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessComplete-id-0028_di" bpmnElement="EndEvent-ProcessComplete-id-0028">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-ProcessBeginsToCustomerInitiates-id-0029_di" bpmnElement="SequenceFlow-ProcessBeginsToCustomerInitiates-id-0029">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CustomerInitiatesToValidate-id-0030_di" bpmnElement="SequenceFlow-CustomerInitiatesToValidate-id-0030">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ValidateToEligibilityCheck-id-0031_di" bpmnElement="SequenceFlow-ValidateToEligibilityCheck-id-0031">
        <di:waypoint x="375" y="110" />
        <di:waypoint x="375" y="140" />
        <di:waypoint x="1275" y="140" />
        <di:waypoint x="1275" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TimerToExpirationNotice-id-0032_di" bpmnElement="SequenceFlow-TimerToExpirationNotice-id-0032">
        <di:waypoint x="375" y="128" />
        <di:waypoint x="375" y="140" />
        <di:waypoint x="450" y="140" />
        <di:waypoint x="450" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ShippingLabelToWarehouseReceives-id-0034_di" bpmnElement="SequenceFlow-ShippingLabelToWarehouseReceives-id-0034">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-WarehouseReceivesToVerification-id-0035_di" bpmnElement="SequenceFlow-WarehouseReceivesToVerification-id-0035">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-VerificationToRefundConfirmation-id-0036_di" bpmnElement="SequenceFlow-VerificationToRefundConfirmation-id-0036">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RefundConfirmationToProcessComplete-id-0037_di" bpmnElement="SequenceFlow-RefundConfirmationToProcessComplete-id-0037">
