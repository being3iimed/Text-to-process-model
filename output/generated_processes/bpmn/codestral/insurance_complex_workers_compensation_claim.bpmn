      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CollectInjuryDetails-id-0010_di" bpmnElement="ServiceTask-CollectInjuryDetails-id-0010">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ConfirmMedicalFacility-id-0011_di" bpmnElement="ServiceTask-ConfirmMedicalFacility-id-0011">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-DetermineCoverageAndBenefits-id-0012_di" bpmnElement="SubProcess-DetermineCoverageAndBenefits-id-0012">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-MonitorRecovery-id-0028_di" bpmnElement="SubProcess-MonitorRecovery-id-0028">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-DisputeArises-id-0038_di" bpmnElement="ExclusiveGateway-DisputeArises-id-0038" isMarkerVisible="true">
        <dc:Bounds x="1400" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-HandleDispute-id-0039_di" bpmnElement="SubProcess-HandleDispute-id-0039">
