<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="material-procurement-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="MaterialProcurementProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ProcessBegins-id-0001" name="Process Begins">
      <bpmn:outgoing>SequenceFlow-StartToForecast-id-0016</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-ForecastMaterialNeeds-id-0002" name="Forecast Material Needs">
      <bpmn:incoming>SequenceFlow-StartToForecast-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ForecastToGenerate-id-0017</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GeneratePurchaseOrders-id-0003" name="Generate Purchase Orders">
      <bpmn:incoming>SequenceFlow-ForecastToGenerate-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateToSend-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendPurchaseOrders-id-0004" name="Send: Purchase Orders to Suppliers">
      <bpmn:incoming>SequenceFlow-GenerateToSend-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToReceive-id-0019</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveSupplierConfirmation-id-0005" name="Receive Supplier Confirmation">
      <bpmn:incoming>SequenceFlow-SendToReceive-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToVerify-id-0020</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="ServiceTask-VerifyMaterialQuality-id-0006" name="Verify Material Quality">
      <bpmn:incoming>SequenceFlow-ReceiveToVerify-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToQualityGateway-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-QualityCheck-id-0007" name="Quality Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-VerifyToQualityGateway-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-QualityGatewayToLog-id-0022</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-QualityGatewayToReject-id-0023</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-LogMaterialsIntoInventory-id-0008" name="Log Materials into Inventory">
      <bpmn:incoming>SequenceFlow-QualityGatewayToLog-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LogToRoute-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-RouteMaterialsToProduction-id-0009" name="Route Materials to Production">
      <bpmn:incoming>SequenceFlow-LogToRoute-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RouteToEnd-id-0025</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-RouteToMatch-id-0027</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendRejectionNotice-id-0010" name="Send: Rejection Notice to Supplier">
      <bpmn:incoming>SequenceFlow-QualityGatewayToReject-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RejectToEnd-id-0026</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-MatchInvoiceToPOAndReceipt-id-0011" name="Match Invoice to PO and Receipt">
      <bpmn:incoming>SequenceFlow-RouteToMatch-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MatchToInvoiceGateway-id-0028</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InvoiceCheck-id-0012" name="Invoice Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-MatchToInvoiceGateway-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InvoiceGatewayToApprove-id-0029</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-InvoiceGatewayToInvestigate-id-0030</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ApproveInvoiceForPayment-id-0013" name="Approve Invoice for Payment">
      <bpmn:incoming>SequenceFlow-InvoiceGatewayToApprove-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApproveToEnd-id-0031</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-InvestigateMismatch-id-0014" name="Investigate Mismatch">
      <bpmn:incoming>SequenceFlow-InvoiceGatewayToInvestigate-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InvestigateToEnd-id-0032</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0015" name="Process Complete">
      <bpmn:incoming>SequenceFlow-RouteToEnd-id-0025</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-RejectToEnd-id-0026</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ApproveToEnd-id-0031</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-InvestigateToEnd-id-0032</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToForecast-id-0016" sourceRef="StartEvent-ProcessBegins-id-0001" targetRef="ServiceTask-ForecastMaterialNeeds-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ForecastToGenerate-id-0017" sourceRef="ServiceTask-ForecastMaterialNeeds-id-0002" targetRef="ServiceTask-GeneratePurchaseOrders-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateToSend-id-0018" sourceRef="ServiceTask-GeneratePurchaseOrders-id-0003" targetRef="SendTask-SendPurchaseOrders-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToReceive-id-0019" sourceRef="SendTask-SendPurchaseOrders-id-0004" targetRef="ReceiveTask-ReceiveSupplierConfirmation-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveToVerify-id-0020" sourceRef="ReceiveTask-ReceiveSupplierConfirmation-id-0005" targetRef="ServiceTask-VerifyMaterialQuality-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyToQualityGateway-id-0021" sourceRef="ServiceTask-VerifyMaterialQuality-id-0006" targetRef="ExclusiveGateway-QualityCheck-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-QualityGatewayToLog-id-0022" name="quantity matches PO AND quality matches specifications AND no damage during shipping" sourceRef="ExclusiveGateway-QualityCheck-id-0007" targetRef="ServiceTask-LogMaterialsIntoInventory-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-QualityGatewayToReject-id-0023" sourceRef="ExclusiveGateway-QualityCheck-id-0007" targetRef="SendTask-SendRejectionNotice-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-LogToRoute-id-0024" sourceRef="ServiceTask-LogMaterialsIntoInventory-id-0008" targetRef="ServiceTask-RouteMaterialsToProduction-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-RouteToEnd-id-0025" sourceRef="ServiceTask-RouteMaterialsToProduction-id-0009" targetRef="EndEvent-ProcessComplete-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-RejectToEnd-id-0026" sourceRef="SendTask-SendRejectionNotice-id-0010" targetRef="EndEvent-ProcessComplete-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-RouteToMatch-id-0027" sourceRef="ServiceTask-RouteMaterialsToProduction-id-0009" targetRef="ServiceTask-MatchInvoiceToPOAndReceipt-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-MatchToInvoiceGateway-id-0028" sourceRef="ServiceTask-MatchInvoiceToPOAndReceipt-id-0011" targetRef="ExclusiveGateway-InvoiceCheck-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-InvoiceGatewayToApprove-id-0029" name="invoice matches PO and receipt" sourceRef="ExclusiveGateway-InvoiceCheck-id-0012" targetRef="ServiceTask-ApproveInvoiceForPayment-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-InvoiceGatewayToInvestigate-id-0030" sourceRef="ExclusiveGateway-InvoiceCheck-id-0012" targetRef="UserTask-InvestigateMismatch-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-ApproveToEnd-id-0031" sourceRef="ServiceTask-ApproveInvoiceForPayment-id-0013" targetRef="EndEvent-ProcessComplete-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-InvestigateToEnd-id-0032" sourceRef="UserTask-InvestigateMismatch-id-0014" targetRef="EndEvent-ProcessComplete-id-0015" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_MaterialProcurementProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_MaterialProcurementProcess-id-0001" bpmnElement="MaterialProcurementProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProcessBegins-id-0001_di" bpmnElement="StartEvent-ProcessBegins-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ForecastMaterialNeeds-id-0002_di" bpmnElement="ServiceTask-ForecastMaterialNeeds-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GeneratePurchaseOrders-id-0003_di" bpmnElement="ServiceTask-GeneratePurchaseOrders-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendPurchaseOrders-id-0004_di" bpmnElement="SendTask-SendPurchaseOrders-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveSupplierConfirmation-id-0005_di" bpmnElement="ReceiveTask-ReceiveSupplierConfirmation-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-VerifyMaterialQuality-id-0006_di" bpmnElement="ServiceTask-VerifyMaterialQuality-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-QualityCheck-id-0007_di" bpmnElement="ExclusiveGateway-QualityCheck-id-0007" isMarkerVisible="true">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-LogMaterialsIntoInventory-id-0008_di" bpmnElement="ServiceTask-LogMaterialsIntoInventory-id-0008">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RouteMaterialsToProduction-id-0009_di" bpmnElement="ServiceTask-RouteMaterialsToProduction-id-0009">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-MatchInvoiceToPOAndReceipt-id-0011_di" bpmnElement="ServiceTask-MatchInvoiceToPOAndReceipt-id-0011">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-InvoiceCheck-id-0012_di" bpmnElement="ExclusiveGateway-InvoiceCheck-id-0012" isMarkerVisible="true">
        <dc:Bounds x="1550" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ApproveInvoiceForPayment-id-0013_di" bpmnElement="ServiceTask-ApproveInvoiceForPayment-id-0013">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessComplete-id-0015_di" bpmnElement="EndEvent-ProcessComplete-id-0015">
        <dc:Bounds x="1857" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendRejectionNotice-id-0010_di" bpmnElement="SendTask-SendRejectionNotice-id-0010">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-InvestigateMismatch-id-0014_di" bpmnElement="UserTask-InvestigateMismatch-id-0014">
        <dc:Bounds x="1675" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToForecast-id-0016_di" bpmnElement="SequenceFlow-StartToForecast-id-0016">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ForecastToGenerate-id-0017_di" bpmnElement="SequenceFlow-ForecastToGenerate-id-0017">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GenerateToSend-id-0018_di" bpmnElement="SequenceFlow-GenerateToSend-id-0018">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendToReceive-id-0019_di" bpmnElement="SequenceFlow-SendToReceive-id-0019">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveToVerify-id-0020_di" bpmnElement="SequenceFlow-ReceiveToVerify-id-0020">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-VerifyToQualityGateway-id-0021_di" bpmnElement="SequenceFlow-VerifyToQualityGateway-id-0021">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="950" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-QualityGatewayToLog-id-0022_di" bpmnElement="SequenceFlow-QualityGatewayToLog-id-0022">
        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-QualityGatewayToReject-id-0023_di" bpmnElement="SequenceFlow-QualityGatewayToReject-id-0023">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LogToRoute-id-0024_di" bpmnElement="SequenceFlow-LogToRoute-id-0024">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RouteToEnd-id-0025_di" bpmnElement="SequenceFlow-RouteToEnd-id-0025">
        <di:waypoint x="1275" y="110" />
        <di:waypoint x="1275" y="140" />
        <di:waypoint x="1875" y="140" />
        <di:waypoint x="1875" y="88" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RouteToMatch-id-0027_di" bpmnElement="SequenceFlow-RouteToMatch-id-0027">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MatchToInvoiceGateway-id-0028_di" bpmnElement="SequenceFlow-MatchToInvoiceGateway-id-0028">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1550" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InvoiceGatewayToApprove-id-0029_di" bpmnElement="SequenceFlow-InvoiceGatewayToApprove-id-0029">
        <di:waypoint x="1600" y="70" />
        <di:waypoint x="1675" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InvoiceGatewayToInvestigate-id-0030_di" bpmnElement="SequenceFlow-InvoiceGatewayToInvestigate-id-0030">
        <di:waypoint x="1575" y="95" />
        <di:waypoint x="1575" y="210" />
        <di:waypoint x="1675" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ApproveToEnd-id-0031_di" bpmnElement="SequenceFlow-ApproveToEnd-id-0031">
        <di:waypoint x="1775" y="70" />
        <di:waypoint x="1857" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RejectToEnd-id-0026_di" bpmnElement="SequenceFlow-RejectToEnd-id-0026">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1200" y="210" />
        <di:waypoint x="1200" y="140" />
        <di:waypoint x="1800" y="140" />
        <di:waypoint x="1800" y="70" />
        <di:waypoint x="1857" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InvestigateToEnd-id-0032_di" bpmnElement="SequenceFlow-InvestigateToEnd-id-0032">
        <di:waypoint x="1775" y="210" />
        <di:waypoint x="1875" y="210" />
        <di:waypoint x="1875" y="88" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
