<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="GraduationProcessDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="GraduationProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-GraduationCheckRequested-id-0001" name="Graduation Check Requested">
      <bpmn:outgoing>SequenceFlow-StartToSubProcess-id-0015</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess-ValidateAcademicRequirements-id-0001" name="Validate Academic Requirements">
      <bpmn:incoming>SequenceFlow-StartToSubProcess-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubProcessToXOR-id-0016</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-ValidationStart-id-0001" name="Validation Start">
        <bpmn:outgoing>SequenceFlow-StartToAudit-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-AuditDegreeRequirements-id-0001" name="Audit Degree Requirements">
        <bpmn:incoming>SequenceFlow-StartToAudit-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AuditToSplit-id-0002</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway-Split-id-0001" name="Parallel Validation" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-AuditToSplit-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToMajor-id-0003</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToGE-id-0004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToCredit-id-0005</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToGPA-id-0006</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="ServiceTask-VerifyMajorCourseCompletion-id-0002" name="Verify Major Course Completion">
        <bpmn:incoming>SequenceFlow-SplitToMajor-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MajorToJoin-id-0007</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-VerifyGeneralEducationCompletion-id-0003" name="Verify General Education Completion">
        <bpmn:incoming>SequenceFlow-SplitToGE-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GEToJoin-id-0008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CheckCreditTotal-id-0004" name="Check Credit Total (120 minimum)">
        <bpmn:incoming>SequenceFlow-SplitToCredit-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CreditToJoin-id-0009</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CheckGPA-id-0005" name="Check GPA (2.0 cumulative, major-specific minimum)">
        <bpmn:incoming>SequenceFlow-SplitToGPA-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GPAToJoin-id-0010</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway-Join-id-0002" name="Validation Complete" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-MajorToJoin-id-0007</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-GEToJoin-id-0008</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-CreditToJoin-id-0009</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-GPAToJoin-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToXOR-id-0011</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:exclusiveGateway id="ExclusiveGateway-AllRequirementsMet-id-0001" name="All Requirements Met?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-JoinToXOR-id-0011</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-XORToPassed-id-0012</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-XORToFailed-id-0013</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent-ValidationPassed-id-0001" name="Validation Passed">
        <bpmn:incoming>SequenceFlow-XORToPassed-id-0012</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="ServiceTask-GenerateDeficiencyReport-id-0006" name="Generate Deficiency Report">
        <bpmn:incoming>SequenceFlow-XORToFailed-id-0013</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReportToFailedEnd-id-0014</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-ValidationFailed-id-0002" name="Validation Failed">
        <bpmn:incoming>SequenceFlow-ReportToFailedEnd-id-0014</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToAudit-id-0001" sourceRef="StartEvent-ValidationStart-id-0001" targetRef="ServiceTask-AuditDegreeRequirements-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-AuditToSplit-id-0002" sourceRef="ServiceTask-AuditDegreeRequirements-id-0001" targetRef="ParallelGateway-Split-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToMajor-id-0003" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-VerifyMajorCourseCompletion-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToGE-id-0004" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-VerifyGeneralEducationCompletion-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToCredit-id-0005" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-CheckCreditTotal-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToGPA-id-0006" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-CheckGPA-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-MajorToJoin-id-0007" sourceRef="ServiceTask-VerifyMajorCourseCompletion-id-0002" targetRef="ParallelGateway-Join-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-GEToJoin-id-0008" sourceRef="ServiceTask-VerifyGeneralEducationCompletion-id-0003" targetRef="ParallelGateway-Join-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-CreditToJoin-id-0009" sourceRef="ServiceTask-CheckCreditTotal-id-0004" targetRef="ParallelGateway-Join-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-GPAToJoin-id-0010" sourceRef="ServiceTask-CheckGPA-id-0005" targetRef="ParallelGateway-Join-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToXOR-id-0011" sourceRef="ParallelGateway-Join-id-0002" targetRef="ExclusiveGateway-AllRequirementsMet-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-XORToPassed-id-0012" name="all_requirements_met == true" sourceRef="ExclusiveGateway-AllRequirementsMet-id-0001" targetRef="EndEvent-ValidationPassed-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-XORToFailed-id-0013" name="all_requirements_met == false" sourceRef="ExclusiveGateway-AllRequirementsMet-id-0001" targetRef="ServiceTask-GenerateDeficiencyReport-id-0006" />
      <bpmn:sequenceFlow id="SequenceFlow-ReportToFailedEnd-id-0014" sourceRef="ServiceTask-GenerateDeficiencyReport-id-0006" targetRef="EndEvent-ValidationFailed-id-0002" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ValidationPassed-id-0002" name="Validation Passed?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SubProcessToXOR-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-XORToApprove-id-0017</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-XORToDeficiencies-id-0018</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ApproveGraduation-id-0007" name="Approve Graduation">
      <bpmn:incoming>SequenceFlow-XORToApprove-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApproveToSplit-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-GraduationPrepSplit-id-0003" name="Graduation Preparation" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ApproveToSplit-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToDiploma-id-0020</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToCapGown-id-0021</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToCeremonySlot-id-0022</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-PrepareDiploma-id-0008" name="Prepare Diploma">
      <bpmn:incoming>SequenceFlow-SplitToDiploma-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DiplomaToJoin-id-0023</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PlaceCapAndGownOrder-id-0009" name="Place Cap-and-Gown Order">
      <bpmn:incoming>SequenceFlow-SplitToCapGown-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CapGownToJoin-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AssignGraduationCeremonySlot-id-0010" name="Assign Graduation Ceremony Slot">
      <bpmn:incoming>SequenceFlow-SplitToCeremonySlot-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CeremonySlotToJoin-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-GraduationPrepJoin-id-0004" name="Preparation Complete" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-DiplomaToJoin-id-0023</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CapGownToJoin-id-0024</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CeremonySlotToJoin-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToAttendance-id-0026</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-VerifyCeremonyAttendance-id-0011" name="Verify Ceremony Attendance">
      <bpmn:incoming>SequenceFlow-JoinToAttendance-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AttendanceToConfer-id-0027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ConferDegree-id-0012" name="Confer Degree">
      <bpmn:incoming>SequenceFlow-AttendanceToConfer-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConferToTranscript-id-0028</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-IssueTranscript-id-0013" name="Issue Transcript">
      <bpmn:incoming>SequenceFlow-ConferToTranscript-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TranscriptToEnd-id-0029</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-GraduationApproved-id-0003" name="Graduation Approved">
      <bpmn:incoming>SequenceFlow-TranscriptToEnd-id-0029</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-DeficienciesIdentified-id-0004" name="Deficiencies Identified">
      <bpmn:incoming>SequenceFlow-XORToDeficiencies-id-0018</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSubProcess-id-0015" sourceRef="StartEvent-GraduationCheckRequested-id-0001" targetRef="SubProcess-ValidateAcademicRequirements-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubProcessToXOR-id-0016" sourceRef="SubProcess-ValidateAcademicRequirements-id-0001" targetRef="ExclusiveGateway-ValidationPassed-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-XORToApprove-id-0017" name="validation_passed == true" sourceRef="ExclusiveGateway-ValidationPassed-id-0002" targetRef="ServiceTask-ApproveGraduation-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-XORToDeficiencies-id-0018" name="validation_passed == false" sourceRef="ExclusiveGateway-ValidationPassed-id-0002" targetRef="EndEvent-DeficienciesIdentified-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-ApproveToSplit-id-0019" sourceRef="ServiceTask-ApproveGraduation-id-0007" targetRef="ParallelGateway-GraduationPrepSplit-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToDiploma-id-0020" sourceRef="ParallelGateway-GraduationPrepSplit-id-0003" targetRef="ServiceTask-PrepareDiploma-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToCapGown-id-0021" sourceRef="ParallelGateway-GraduationPrepSplit-id-0003" targetRef="ServiceTask-PlaceCapAndGownOrder-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToCeremonySlot-id-0022" sourceRef="ParallelGateway-GraduationPrepSplit-id-0003" targetRef="ServiceTask-AssignGraduationCeremonySlot-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-DiplomaToJoin-id-0023" sourceRef="ServiceTask-PrepareDiploma-id-0008" targetRef="ParallelGateway-GraduationPrepJoin-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-CapGownToJoin-id-0024" sourceRef="ServiceTask-PlaceCapAndGownOrder-id-0009" targetRef="ParallelGateway-GraduationPrepJoin-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-CeremonySlotToJoin-id-0025" sourceRef="ServiceTask-AssignGraduationCeremonySlot-id-0010" targetRef="ParallelGateway-GraduationPrepJoin-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToAttendance-id-0026" sourceRef="ParallelGateway-GraduationPrepJoin-id-0004" targetRef="UserTask-VerifyCeremonyAttendance-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-AttendanceToConfer-id-0027" sourceRef="UserTask-VerifyCeremonyAttendance-id-0011" targetRef="ServiceTask-ConferDegree-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-ConferToTranscript-id-0028" sourceRef="ServiceTask-ConferDegree-id-0012" targetRef="ServiceTask-IssueTranscript-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-TranscriptToEnd-id-0029" sourceRef="ServiceTask-IssueTranscript-id-0013" targetRef="EndEvent-GraduationApproved-id-0003" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_GraduationProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_GraduationProcess" bpmnElement="GraduationProcess">
      <bpmndi:BPMNShape id="StartEvent-GraduationCheckRequested-id-0001_di" bpmnElement="StartEvent-GraduationCheckRequested-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-ValidateAcademicRequirements-id-0001_di" bpmnElement="SubProcess-ValidateAcademicRequirements-id-0001">
