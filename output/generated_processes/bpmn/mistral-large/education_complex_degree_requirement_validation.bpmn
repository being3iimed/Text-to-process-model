    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-ValidateAcademicRequirements-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-ValidateAcademicRequirements-id-0001" bpmnElement="SubProcess-ValidateAcademicRequirements-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ValidationStart-id-0001_di" bpmnElement="StartEvent-ValidationStart-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AuditDegreeRequirements-id-0001_di" bpmnElement="ServiceTask-AuditDegreeRequirements-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Split-id-0001_di" bpmnElement="ParallelGateway-Split-id-0001">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-VerifyMajorCourseCompletion-id-0002_di" bpmnElement="ServiceTask-VerifyMajorCourseCompletion-id-0002">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Join-id-0002_di" bpmnElement="ParallelGateway-Join-id-0002">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
