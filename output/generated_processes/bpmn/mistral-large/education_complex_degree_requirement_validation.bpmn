      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ValidationPassed-id-0002_di" bpmnElement="ExclusiveGateway-ValidationPassed-id-0002" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ApproveGraduation-id-0007_di" bpmnElement="ServiceTask-ApproveGraduation-id-0007">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-GraduationPrepSplit-id-0003_di" bpmnElement="ParallelGateway-GraduationPrepSplit-id-0003">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PrepareDiploma-id-0008_di" bpmnElement="ServiceTask-PrepareDiploma-id-0008">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-GraduationPrepJoin-id-0004_di" bpmnElement="ParallelGateway-GraduationPrepJoin-id-0004">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-VerifyCeremonyAttendance-id-0011_di" bpmnElement="UserTask-VerifyCeremonyAttendance-id-0011">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ConferDegree-id-0012_di" bpmnElement="ServiceTask-ConferDegree-id-0012">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-IssueTranscript-id-0013_di" bpmnElement="ServiceTask-IssueTranscript-id-0013">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-GraduationApproved-id-0003_di" bpmnElement="EndEvent-GraduationApproved-id-0003">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-DeficienciesIdentified-id-0004_di" bpmnElement="EndEvent-DeficienciesIdentified-id-0004">
        <dc:Bounds x="507" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PlaceCapAndGownOrder-id-0009_di" bpmnElement="ServiceTask-PlaceCapAndGownOrder-id-0009">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AssignGraduationCeremonySlot-id-0010_di" bpmnElement="ServiceTask-AssignGraduationCeremonySlot-id-0010">
        <dc:Bounds x="775" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSubProcess-id-0015_di" bpmnElement="SequenceFlow-StartToSubProcess-id-0015">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SubProcessToXOR-id-0016_di" bpmnElement="SequenceFlow-SubProcessToXOR-id-0016">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-XORToApprove-id-0017_di" bpmnElement="SequenceFlow-XORToApprove-id-0017">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-XORToDeficiencies-id-0018_di" bpmnElement="SequenceFlow-XORToDeficiencies-id-0018">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="210" />
        <di:waypoint x="507" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ApproveToSplit-id-0019_di" bpmnElement="SequenceFlow-ApproveToSplit-id-0019">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToDiploma-id-0020_di" bpmnElement="SequenceFlow-SplitToDiploma-id-0020">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
