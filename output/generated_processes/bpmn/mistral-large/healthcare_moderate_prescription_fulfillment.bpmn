<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="prescription-process-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="PrescriptionProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-PrescriptionProcessInitiated-id-0001" name="Prescription Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToDoctorPrescribes-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-DoctorPrescribesMedication-id-0001" name="Doctor Prescribes Medication">
      <bpmn:incoming>SequenceFlow-StartToDoctorPrescribes-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DoctorToSendPrescription-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-SendPrescriptionToPharmacy-id-0002" name="Send Prescription to Pharmacy">
      <bpmn:incoming>SequenceFlow-DoctorToSendPrescription-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendPrescriptionToCheckInsurance-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-PharmacyTechnicianChecksInsurance-id-0003" name="Pharmacy Technician Checks Insurance">
      <bpmn:incoming>SequenceFlow-SendPrescriptionToCheckInsurance-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckInsuranceToPriorAuthCheck-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PriorAuthCheck-id-0001" name="Prior Authorization Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckInsuranceToPriorAuthCheck-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PriorAuthRequiredToContactInsurance-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PriorAuthNotRequiredToFillPrescription-id-0017</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ContactInsuranceForPriorAuthorization-id-0004" name="Contact Insurance for Prior Authorization">
      <bpmn:incoming>SequenceFlow-PriorAuthRequiredToContactInsurance-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ContactInsuranceToReceiveResponse-id-0006</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveInsuranceApprovalDenial-id-0005" name="Receive: insurance approval/denial">
      <bpmn:incoming>SequenceFlow-ContactInsuranceToReceiveResponse-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveResponseToInsuranceDecision-id-0007</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InsuranceDecision-id-0002" name="Insurance Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReceiveResponseToInsuranceDecision-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InsuranceApprovedToFillPrescription-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-InsuranceDeniedToSendDenialNotification-id-0013</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-FillPrescription-id-0006" name="Fill Prescription">
      <bpmn:incoming>SequenceFlow-InsuranceApprovedToFillPrescription-id-0008</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PriorAuthNotRequiredToFillPrescription-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FillPrescriptionToSendNotification-id-0009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendPickupNotificationToPatient-id-0007" name="Send: pickup notification to patient">
      <bpmn:incoming>SequenceFlow-FillPrescriptionToSendNotification-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendNotificationToPatientSigns-id-0010</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-PatientSignsReceipt-id-0008" name="Patient Signs Receipt">
      <bpmn:incoming>SequenceFlow-SendNotificationToPatientSigns-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PatientSignsToDispense-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-DispenseMedication-id-0009" name="Dispense Medication">
      <bpmn:incoming>SequenceFlow-PatientSignsToDispense-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DispenseToPrescriptionDispensed-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-PrescriptionDispensed-id-0001" name="Prescription Dispensed">
      <bpmn:incoming>SequenceFlow-DispenseToPrescriptionDispensed-id-0012</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-SendDenialNotificationToPatientAndDoctor-id-0010" name="Send: denial notification to patient and doctor">
      <bpmn:incoming>SequenceFlow-InsuranceDeniedToSendDenialNotification-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendDenialToDenialHandling-id-0014</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DenialHandling-id-0003" name="Denial Handling" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SendDenialToDenialHandling-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PatientAppealsToAppealProcess-id-0015</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DoctorPrescribesAlternativeToAlternativePrescribed-id-0016</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-AppealProcessInitiated-id-0002" name="Appeal Process Initiated">
      <bpmn:incoming>SequenceFlow-PatientAppealsToAppealProcess-id-0015</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-AlternativePrescribed-id-0003" name="Alternative Prescribed">
      <bpmn:incoming>SequenceFlow-DoctorPrescribesAlternativeToAlternativePrescribed-id-0016</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDoctorPrescribes-id-0001" sourceRef="StartEvent-PrescriptionProcessInitiated-id-0001" targetRef="UserTask-DoctorPrescribesMedication-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DoctorToSendPrescription-id-0002" sourceRef="UserTask-DoctorPrescribesMedication-id-0001" targetRef="ServiceTask-SendPrescriptionToPharmacy-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SendPrescriptionToCheckInsurance-id-0003" sourceRef="ServiceTask-SendPrescriptionToPharmacy-id-0002" targetRef="UserTask-PharmacyTechnicianChecksInsurance-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckInsuranceToPriorAuthCheck-id-0004" sourceRef="UserTask-PharmacyTechnicianChecksInsurance-id-0003" targetRef="ExclusiveGateway-PriorAuthCheck-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PriorAuthRequiredToContactInsurance-id-0005" name="prior_auth_required == true" sourceRef="ExclusiveGateway-PriorAuthCheck-id-0001" targetRef="ServiceTask-ContactInsuranceForPriorAuthorization-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-ContactInsuranceToReceiveResponse-id-0006" sourceRef="ServiceTask-ContactInsuranceForPriorAuthorization-id-0004" targetRef="ReceiveTask-ReceiveInsuranceApprovalDenial-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveResponseToInsuranceDecision-id-0007" sourceRef="ReceiveTask-ReceiveInsuranceApprovalDenial-id-0005" targetRef="ExclusiveGateway-InsuranceDecision-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-InsuranceApprovedToFillPrescription-id-0008" name="insurance_response == &#39;approved&#39;" sourceRef="ExclusiveGateway-InsuranceDecision-id-0002" targetRef="ServiceTask-FillPrescription-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-FillPrescriptionToSendNotification-id-0009" sourceRef="ServiceTask-FillPrescription-id-0006" targetRef="SendTask-SendPickupNotificationToPatient-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-SendNotificationToPatientSigns-id-0010" sourceRef="SendTask-SendPickupNotificationToPatient-id-0007" targetRef="UserTask-PatientSignsReceipt-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-PatientSignsToDispense-id-0011" sourceRef="UserTask-PatientSignsReceipt-id-0008" targetRef="ServiceTask-DispenseMedication-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-DispenseToPrescriptionDispensed-id-0012" sourceRef="ServiceTask-DispenseMedication-id-0009" targetRef="EndEvent-PrescriptionDispensed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InsuranceDeniedToSendDenialNotification-id-0013" name="insurance_response == &#39;denied&#39;" sourceRef="ExclusiveGateway-InsuranceDecision-id-0002" targetRef="SendTask-SendDenialNotificationToPatientAndDoctor-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-SendDenialToDenialHandling-id-0014" sourceRef="SendTask-SendDenialNotificationToPatientAndDoctor-id-0010" targetRef="ExclusiveGateway-DenialHandling-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-PatientAppealsToAppealProcess-id-0015" name="patient_action == &#39;appeal&#39;" sourceRef="ExclusiveGateway-DenialHandling-id-0003" targetRef="EndEvent-AppealProcessInitiated-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DoctorPrescribesAlternativeToAlternativePrescribed-id-0016" name="doctor_action == &#39;prescribe_alternative&#39;" sourceRef="ExclusiveGateway-DenialHandling-id-0003" targetRef="EndEvent-AlternativePrescribed-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-PriorAuthNotRequiredToFillPrescription-id-0017" name="prior_auth_required == false" sourceRef="ExclusiveGateway-PriorAuthCheck-id-0001" targetRef="ServiceTask-FillPrescription-id-0006" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PrescriptionProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_PrescriptionProcess" bpmnElement="PrescriptionProcess">
      <bpmndi:BPMNShape id="StartEvent-PrescriptionProcessInitiated-id-0001_di" bpmnElement="StartEvent-PrescriptionProcessInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DoctorPrescribesMedication-id-0001_di" bpmnElement="UserTask-DoctorPrescribesMedication-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SendPrescriptionToPharmacy-id-0002_di" bpmnElement="ServiceTask-SendPrescriptionToPharmacy-id-0002">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-PharmacyTechnicianChecksInsurance-id-0003_di" bpmnElement="UserTask-PharmacyTechnicianChecksInsurance-id-0003">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PriorAuthCheck-id-0001_di" bpmnElement="ExclusiveGateway-PriorAuthCheck-id-0001" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ContactInsuranceForPriorAuthorization-id-0004_di" bpmnElement="ServiceTask-ContactInsuranceForPriorAuthorization-id-0004">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveInsuranceApprovalDenial-id-0005_di" bpmnElement="ReceiveTask-ReceiveInsuranceApprovalDenial-id-0005">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-InsuranceDecision-id-0002_di" bpmnElement="ExclusiveGateway-InsuranceDecision-id-0002" isMarkerVisible="true">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-FillPrescription-id-0006_di" bpmnElement="ServiceTask-FillPrescription-id-0006">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendPickupNotificationToPatient-id-0007_di" bpmnElement="SendTask-SendPickupNotificationToPatient-id-0007">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-PatientSignsReceipt-id-0008_di" bpmnElement="UserTask-PatientSignsReceipt-id-0008">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DispenseMedication-id-0009_di" bpmnElement="ServiceTask-DispenseMedication-id-0009">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PrescriptionDispensed-id-0001_di" bpmnElement="EndEvent-PrescriptionDispensed-id-0001">
        <dc:Bounds x="1857" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendDenialNotificationToPatientAndDoctor-id-0010_di" bpmnElement="SendTask-SendDenialNotificationToPatientAndDoctor-id-0010">
        <dc:Bounds x="1225" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-DenialHandling-id-0003_di" bpmnElement="ExclusiveGateway-DenialHandling-id-0003" isMarkerVisible="true">
        <dc:Bounds x="1400" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-AppealProcessInitiated-id-0002_di" bpmnElement="EndEvent-AppealProcessInitiated-id-0002">
        <dc:Bounds x="1557" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-AlternativePrescribed-id-0003_di" bpmnElement="EndEvent-AlternativePrescribed-id-0003">
        <dc:Bounds x="1557" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToDoctorPrescribes-id-0001_di" bpmnElement="SequenceFlow-StartToDoctorPrescribes-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DoctorToSendPrescription-id-0002_di" bpmnElement="SequenceFlow-DoctorToSendPrescription-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendPrescriptionToCheckInsurance-id-0003_di" bpmnElement="SequenceFlow-SendPrescriptionToCheckInsurance-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckInsuranceToPriorAuthCheck-id-0004_di" bpmnElement="SequenceFlow-CheckInsuranceToPriorAuthCheck-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PriorAuthRequiredToContactInsurance-id-0005_di" bpmnElement="SequenceFlow-PriorAuthRequiredToContactInsurance-id-0005">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PriorAuthNotRequiredToFillPrescription-id-0017_di" bpmnElement="SequenceFlow-PriorAuthNotRequiredToFillPrescription-id-0017">
        <di:waypoint x="675" y="95" />
        <di:waypoint x="675" y="140" />
        <di:waypoint x="1275" y="140" />
        <di:waypoint x="1275" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ContactInsuranceToReceiveResponse-id-0006_di" bpmnElement="SequenceFlow-ContactInsuranceToReceiveResponse-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveResponseToInsuranceDecision-id-0007_di" bpmnElement="SequenceFlow-ReceiveResponseToInsuranceDecision-id-0007">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InsuranceApprovedToFillPrescription-id-0008_di" bpmnElement="SequenceFlow-InsuranceApprovedToFillPrescription-id-0008">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InsuranceDeniedToSendDenialNotification-id-0013_di" bpmnElement="SequenceFlow-InsuranceDeniedToSendDenialNotification-id-0013">
        <di:waypoint x="1125" y="95" />
        <di:waypoint x="1125" y="210" />
        <di:waypoint x="1225" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FillPrescriptionToSendNotification-id-0009_di" bpmnElement="SequenceFlow-FillPrescriptionToSendNotification-id-0009">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendNotificationToPatientSigns-id-0010_di" bpmnElement="SequenceFlow-SendNotificationToPatientSigns-id-0010">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1525" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PatientSignsToDispense-id-0011_di" bpmnElement="SequenceFlow-PatientSignsToDispense-id-0011">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1675" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DispenseToPrescriptionDispensed-id-0012_di" bpmnElement="SequenceFlow-DispenseToPrescriptionDispensed-id-0012">
        <di:waypoint x="1775" y="70" />
        <di:waypoint x="1857" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendDenialToDenialHandling-id-0014_di" bpmnElement="SequenceFlow-SendDenialToDenialHandling-id-0014">
        <di:waypoint x="1325" y="210" />
        <di:waypoint x="1400" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PatientAppealsToAppealProcess-id-0015_di" bpmnElement="SequenceFlow-PatientAppealsToAppealProcess-id-0015">
        <di:waypoint x="1450" y="210" />
        <di:waypoint x="1557" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DoctorPrescribesAlternativeToAlternativePrescribed-id-0016_di" bpmnElement="SequenceFlow-DoctorPrescribesAlternativeToAlternativePrescribed-id-0016">
        <di:waypoint x="1425" y="235" />
        <di:waypoint x="1425" y="350" />
        <di:waypoint x="1557" y="350" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
