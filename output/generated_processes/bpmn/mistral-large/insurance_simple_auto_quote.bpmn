<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_QuoteRequestProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process_QuoteRequestProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-QuoteRequestInitiated-id-0001" name="Quote Request Initiated">
      <bpmn:outgoing>SequenceFlow-StartToEnterVehicle-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-EnterVehicleInformation-id-0001" name="Enter Vehicle Information">
      <bpmn:incoming>SequenceFlow-StartToEnterVehicle-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnterToQueryRisk-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-QueryRiskDatabase-id-0001" name="Query Risk Database">
      <bpmn:incoming>SequenceFlow-EnterToQueryRisk-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-QueryToCalculate-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CalculatePremium-id-0001" name="Calculate Premium">
      <bpmn:incoming>SequenceFlow-QueryToCalculate-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateToGenerate-id-0004</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GenerateQuote-id-0001" name="Generate Quote">
      <bpmn:incoming>SequenceFlow-CalculateToGenerate-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateToReview-id-0005</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ReviewQuote-id-0001" name="Review Quote">
      <bpmn:incoming>SequenceFlow-GenerateToReview-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToDecision-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CustomerDecision-id-0001" name="Customer Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToDecision-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DecisionToProcessPayment-id-0007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DecisionToSendConfirmation-id-0010</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ProcessPayment-id-0001" name="Process Payment">
      <bpmn:incoming>SequenceFlow-DecisionToProcessPayment-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProcessToSendPolicy-id-0008</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendPolicyDocuments-id-0001" name="Send: Policy Documents">
      <bpmn:incoming>SequenceFlow-ProcessToSendPolicy-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendPolicyToPurchased-id-0009</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-QuotePurchased-id-0001" name="Quote Purchased">
      <bpmn:incoming>SequenceFlow-SendPolicyToPurchased-id-0009</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-SendQuoteConfirmation-id-0001" name="Send: Quote Confirmation">
      <bpmn:incoming>SequenceFlow-DecisionToSendConfirmation-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendConfirmationToSaved-id-0011</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-QuoteSaved-id-0002" name="Quote Saved">
      <bpmn:incoming>SequenceFlow-SendConfirmationToSaved-id-0011</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToEnterVehicle-id-0001" sourceRef="StartEvent-QuoteRequestInitiated-id-0001" targetRef="UserTask-EnterVehicleInformation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EnterToQueryRisk-id-0002" sourceRef="UserTask-EnterVehicleInformation-id-0001" targetRef="ServiceTask-QueryRiskDatabase-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-QueryToCalculate-id-0003" sourceRef="ServiceTask-QueryRiskDatabase-id-0001" targetRef="ServiceTask-CalculatePremium-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateToGenerate-id-0004" sourceRef="ServiceTask-CalculatePremium-id-0001" targetRef="ServiceTask-GenerateQuote-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateToReview-id-0005" sourceRef="ServiceTask-GenerateQuote-id-0001" targetRef="UserTask-ReviewQuote-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToDecision-id-0006" sourceRef="UserTask-ReviewQuote-id-0001" targetRef="ExclusiveGateway-CustomerDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DecisionToProcessPayment-id-0007" name="purchase == true" sourceRef="ExclusiveGateway-CustomerDecision-id-0001" targetRef="ServiceTask-ProcessPayment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProcessToSendPolicy-id-0008" sourceRef="ServiceTask-ProcessPayment-id-0001" targetRef="SendTask-SendPolicyDocuments-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendPolicyToPurchased-id-0009" sourceRef="SendTask-SendPolicyDocuments-id-0001" targetRef="EndEvent-QuotePurchased-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DecisionToSendConfirmation-id-0010" sourceRef="ExclusiveGateway-CustomerDecision-id-0001" targetRef="SendTask-SendQuoteConfirmation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendConfirmationToSaved-id-0011" sourceRef="SendTask-SendQuoteConfirmation-id-0001" targetRef="EndEvent-QuoteSaved-id-0002" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_QuoteRequestProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_QuoteRequestProcess-id-0001" bpmnElement="Process_QuoteRequestProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-QuoteRequestInitiated-id-0001_di" bpmnElement="StartEvent-QuoteRequestInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EnterVehicleInformation-id-0001_di" bpmnElement="UserTask-EnterVehicleInformation-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-QueryRiskDatabase-id-0001_di" bpmnElement="ServiceTask-QueryRiskDatabase-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CalculatePremium-id-0001_di" bpmnElement="ServiceTask-CalculatePremium-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateQuote-id-0001_di" bpmnElement="ServiceTask-GenerateQuote-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewQuote-id-0001_di" bpmnElement="UserTask-ReviewQuote-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-CustomerDecision-id-0001_di" bpmnElement="ExclusiveGateway-CustomerDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcessPayment-id-0001_di" bpmnElement="ServiceTask-ProcessPayment-id-0001">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendPolicyDocuments-id-0001_di" bpmnElement="SendTask-SendPolicyDocuments-id-0001">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-QuotePurchased-id-0001_di" bpmnElement="EndEvent-QuotePurchased-id-0001">
        <dc:Bounds x="1407" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendQuoteConfirmation-id-0001_di" bpmnElement="SendTask-SendQuoteConfirmation-id-0001">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-QuoteSaved-id-0002_di" bpmnElement="EndEvent-QuoteSaved-id-0002">
        <dc:Bounds x="1257" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToEnterVehicle-id-0001_di" bpmnElement="SequenceFlow-StartToEnterVehicle-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EnterToQueryRisk-id-0002_di" bpmnElement="SequenceFlow-EnterToQueryRisk-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-QueryToCalculate-id-0003_di" bpmnElement="SequenceFlow-QueryToCalculate-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CalculateToGenerate-id-0004_di" bpmnElement="SequenceFlow-CalculateToGenerate-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GenerateToReview-id-0005_di" bpmnElement="SequenceFlow-GenerateToReview-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToDecision-id-0006_di" bpmnElement="SequenceFlow-ReviewToDecision-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="950" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DecisionToProcessPayment-id-0007_di" bpmnElement="SequenceFlow-DecisionToProcessPayment-id-0007">
        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DecisionToSendConfirmation-id-0010_di" bpmnElement="SequenceFlow-DecisionToSendConfirmation-id-0010">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProcessToSendPolicy-id-0008_di" bpmnElement="SequenceFlow-ProcessToSendPolicy-id-0008">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendPolicyToPurchased-id-0009_di" bpmnElement="SequenceFlow-SendPolicyToPurchased-id-0009">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1407" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendConfirmationToSaved-id-0011_di" bpmnElement="SequenceFlow-SendConfirmationToSaved-id-0011">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1257" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
