<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="MobileServiceSignupDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="MobileServiceSignupProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-MobileServiceSignup-id-0001" name="Mobile Service Signup">
      <bpmn:outgoing>SequenceFlow-StartToCustomerSignsUp-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CustomerSignsUp-id-0001" name="Customer Signs Up">
      <bpmn:incoming>SequenceFlow-StartToCustomerSignsUp-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerSignsUpToSelectPlan-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CustomerSelectsPlanAndPhone-id-0002" name="Customer Selects Plan and Phone">
      <bpmn:incoming>SequenceFlow-CustomerSignsUpToSelectPlan-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectPlanToCreateAccount-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CreateAccount-id-0001" name="Create Account">
      <bpmn:incoming>SequenceFlow-SelectPlanToCreateAccount-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateAccountToAssignPhone-id-0004</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AssignPhoneNumber-id-0002" name="Assign Phone Number">
      <bpmn:incoming>SequenceFlow-CreateAccountToAssignPhone-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignPhoneToActivateSIM-id-0005</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ActivateSIMOnNetwork-id-0003" name="Activate SIM on Network">
      <bpmn:incoming>SequenceFlow-AssignPhoneToActivateSIM-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ActivateSIMToSendSMS-id-0006</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendWelcomeSMS-id-0001" name="Send: Welcome SMS">
      <bpmn:incoming>SequenceFlow-ActivateSIMToSendSMS-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendSMSToEnd-id-0007</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ServiceReadyForUse-id-0001" name="Service Ready for Use">
      <bpmn:incoming>SequenceFlow-SendSMSToEnd-id-0007</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCustomerSignsUp-id-0001" sourceRef="StartEvent-MobileServiceSignup-id-0001" targetRef="UserTask-CustomerSignsUp-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerSignsUpToSelectPlan-id-0002" sourceRef="UserTask-CustomerSignsUp-id-0001" targetRef="UserTask-CustomerSelectsPlanAndPhone-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectPlanToCreateAccount-id-0003" sourceRef="UserTask-CustomerSelectsPlanAndPhone-id-0002" targetRef="ServiceTask-CreateAccount-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateAccountToAssignPhone-id-0004" sourceRef="ServiceTask-CreateAccount-id-0001" targetRef="ServiceTask-AssignPhoneNumber-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-AssignPhoneToActivateSIM-id-0005" sourceRef="ServiceTask-AssignPhoneNumber-id-0002" targetRef="ServiceTask-ActivateSIMOnNetwork-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ActivateSIMToSendSMS-id-0006" sourceRef="ServiceTask-ActivateSIMOnNetwork-id-0003" targetRef="SendTask-SendWelcomeSMS-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendSMSToEnd-id-0007" sourceRef="SendTask-SendWelcomeSMS-id-0001" targetRef="EndEvent-ServiceReadyForUse-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_MobileServiceSignupProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_MobileServiceSignupProcess" bpmnElement="MobileServiceSignupProcess">
      <bpmndi:BPMNShape id="StartEvent-MobileServiceSignup-id-0001_di" bpmnElement="StartEvent-MobileServiceSignup-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CustomerSignsUp-id-0001_di" bpmnElement="UserTask-CustomerSignsUp-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CustomerSelectsPlanAndPhone-id-0002_di" bpmnElement="UserTask-CustomerSelectsPlanAndPhone-id-0002">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CreateAccount-id-0001_di" bpmnElement="ServiceTask-CreateAccount-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AssignPhoneNumber-id-0002_di" bpmnElement="ServiceTask-AssignPhoneNumber-id-0002">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ActivateSIMOnNetwork-id-0003_di" bpmnElement="ServiceTask-ActivateSIMOnNetwork-id-0003">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendWelcomeSMS-id-0001_di" bpmnElement="SendTask-SendWelcomeSMS-id-0001">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ServiceReadyForUse-id-0001_di" bpmnElement="EndEvent-ServiceReadyForUse-id-0001">
        <dc:Bounds x="1107" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCustomerSignsUp-id-0001_di" bpmnElement="SequenceFlow-StartToCustomerSignsUp-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CustomerSignsUpToSelectPlan-id-0002_di" bpmnElement="SequenceFlow-CustomerSignsUpToSelectPlan-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectPlanToCreateAccount-id-0003_di" bpmnElement="SequenceFlow-SelectPlanToCreateAccount-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CreateAccountToAssignPhone-id-0004_di" bpmnElement="SequenceFlow-CreateAccountToAssignPhone-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssignPhoneToActivateSIM-id-0005_di" bpmnElement="SequenceFlow-AssignPhoneToActivateSIM-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ActivateSIMToSendSMS-id-0006_di" bpmnElement="SequenceFlow-ActivateSIMToSendSMS-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendSMSToEnd-id-0007_di" bpmnElement="SequenceFlow-SendSMSToEnd-id-0007">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1107" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
