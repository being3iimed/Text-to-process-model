<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WeddingPlanningProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="WeddingPlanningProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-WeddingContractInitiated-id-0001" name="Wedding Contract Initiated">
      <bpmn:outgoing>SequenceFlow-StartToContract-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="SendTask-SendContractForSignature-id-0001" name="Send: Contract for Signature">
      <bpmn:incoming>SequenceFlow-StartToContract-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ContractToSign-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-SignWeddingContract-id-0001" name="Sign Wedding Contract">
      <bpmn:incoming>SequenceFlow-ContractToSign-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SignToSystem-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-EnterContractDetails-id-0001" name="Enter Contract Details into System">
      <bpmn:incoming>SequenceFlow-SignToSystem-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SystemToCeremonyTime-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ConfirmCeremonyTime-id-0001" name="Confirm Ceremony Time">
      <bpmn:incoming>SequenceFlow-SystemToCeremonyTime-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CeremonyTimeToGuestCount-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConfirmGuestCount-id-0001" name="Confirm Guest Count">
      <bpmn:incoming>SequenceFlow-CeremonyTimeToGuestCount-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GuestCountToGateway-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-GuestCountCheck-id-0001" name="Guest Count &#62; 100?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-GuestCountToGateway-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToOverflow-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToDefaultRooms-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-AdjustRoomBlockForOverflow-id-0001" name="Adjust Room Block for Overflow">
      <bpmn:incoming>SequenceFlow-GatewayToOverflow-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OverflowToAssignRooms-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AssignGuestRooms-id-0001" name="Assign Guest Rooms">
      <bpmn:incoming>SequenceFlow-GatewayToDefaultRooms-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-OverflowToAssignRooms-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignRoomsToMenu-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectMenuItems-id-0001" name="Select Menu Items">
      <bpmn:incoming>SequenceFlow-AssignRoomsToMenu-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MenuToDietary-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SpecifyDietaryRestrictions-id-0001" name="Specify Dietary Restrictions">
      <bpmn:incoming>SequenceFlow-MenuToDietary-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DietaryToBeverage-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectBeveragePackage-id-0001" name="Select Beverage Package">
      <bpmn:incoming>SequenceFlow-DietaryToBeverage-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BeverageToGateway-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-BeveragePackageCheck-id-0001" name="Beverage Package Type?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-BeverageToGateway-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BeverageGatewayToOpenBar-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-BeverageGatewayToCashBar-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-BeverageGatewayToLimitedBar-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-FlagUnlimitedAlcoholAuthorization-id-0001" name="Flag Unlimited Alcohol Authorization">
      <bpmn:incoming>SequenceFlow-BeverageGatewayToOpenBar-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OpenBarToMusic-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PreparePOSForCashTransactions-id-0001" name="Prepare POS for Cash Transactions">
      <bpmn:incoming>SequenceFlow-BeverageGatewayToCashBar-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CashBarToMusic-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-SetLimitedBarInventoryControls-id-0001" name="Set Limited Bar Inventory Controls">
      <bpmn:incoming>SequenceFlow-BeverageGatewayToLimitedBar-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LimitedBarToMusic-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ConfirmMusicDJArrangement-id-0001" name="Confirm Music/DJ Arrangement">
      <bpmn:incoming>SequenceFlow-OpenBarToMusic-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CashBarToMusic-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-LimitedBarToMusic-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MusicToTimeline-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CreateMasterTimeline-id-0001" name="Create Master Timeline">
      <bpmn:incoming>SequenceFlow-MusicToTimeline-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TimelineToSend-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendTimelineDraft-id-0001" name="Send: Timeline Draft">
      <bpmn:incoming>SequenceFlow-TimelineToSend-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToApprove-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-ApproveMasterTimeline-id-0001" name="Approve Master Timeline">
      <bpmn:incoming>SequenceFlow-SendToApprove-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApproveTo14Days-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent-14DaysBeforeEvent-id-0001" name="14 Days Before Event">
      <bpmn:incoming>SequenceFlow-ApproveTo14Days-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-14DaysToSplit-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-14DaysPrepSplit-id-0001" name="Parallel 14-Day Prep Tasks" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-14DaysToSplit-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-14DaysSplitToHeadcount-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-14DaysSplitToRooms-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-14DaysSplitToDietary-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-14DaysSplitToAV-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-FinalHeadcountConfirmation-id-0001" name="Final Headcount Confirmation">
      <bpmn:incoming>SequenceFlow-14DaysSplitToHeadcount-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HeadcountToBoundary-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent-HeadcountSLA-id-0001" name="3-Day Headcount SLA" attachedToRef="UserTask-FinalHeadcountConfirmation-id-0001">
      <bpmn:incoming>SequenceFlow-HeadcountToBoundary-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BoundaryToPenalty-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-HeadcountSLA-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-SendLateConfirmationPenaltyNotice-id-0001" name="Send: Late Confirmation Penalty Notice">
      <bpmn:incoming>SequenceFlow-BoundaryToPenalty-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PenaltyToJoin-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-FinalRoomBlockConfirmation-id-0001" name="Final Room Block Confirmation">
      <bpmn:incoming>SequenceFlow-14DaysSplitToRooms-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RoomsToJoin-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-FinalizeDietaryRestrictionsList-id-0001" name="Finalize Dietary Restrictions List">
      <bpmn:incoming>SequenceFlow-14DaysSplitToDietary-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DietaryToJoin-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ReserveAVEquipment-id-0001" name="Reserve AV Equipment">
      <bpmn:incoming>SequenceFlow-14DaysSplitToAV-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AVToJoin-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-14DaysPrepJoin-id-0001" name="Synchronize 14-Day Prep" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-PenaltyToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-RoomsToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DietaryToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AVToJoin-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-14DaysJoinTo7Days-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:startEvent id="StartEvent-7DaysBeforeEvent-id-0001" name="7 Days Before Event">
      <bpmn:incoming>SequenceFlow-14DaysJoinTo7Days-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-7DaysToSplit-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-7DaysPrepSplit-id-0001" name="Parallel 7-Day Prep Tasks" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-7DaysToSplit-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-7DaysSplitToWalkthrough-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-7DaysSplitToSeating-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-7DaysSplitToPlacards-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-7DaysSplitToKitchen-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-7DaysSplitToAlcohol-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-FacilityWalkthrough-id-0001" name="Facility Walkthrough">
      <bpmn:incoming>SequenceFlow-7DaysSplitToWalkthrough-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WalkthroughToJoin-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-FinalizeSeatingChart-id-0001" name="Finalize Seating Chart">
      <bpmn:incoming>SequenceFlow-7DaysSplitToSeating-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SeatingToBoundary-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent-SeatingChartSLA-id-0001" name="24-Hour Seating Chart SLA" attachedToRef="UserTask-FinalizeSeatingChart-id-0001">
      <bpmn:incoming>SequenceFlow-SeatingToBoundary-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SeatingBoundaryToAlert-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-SeatingChartSLA-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-SendSeatingChartOverdueAlert-id-0001" name="Send: Seating Chart Overdue Alert">
      <bpmn:incoming>SequenceFlow-SeatingBoundaryToAlert-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AlertToJoin-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-PrepareNamePlacards-id-0001" name="Prepare Name Placards">
      <bpmn:incoming>SequenceFlow-7DaysSplitToPlacards-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PlacardsToJoin-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GenerateKitchenPrepTimeline-id-0001" name="Generate Kitchen Prep Timeline">
      <bpmn:incoming>SequenceFlow-7DaysSplitToKitchen-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-KitchenToJoin-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CalculateAlcoholQuantities-id-0001" name="Calculate Alcohol Quantities">
      <bpmn:incoming>SequenceFlow-7DaysSplitToAlcohol-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AlcoholToJoin-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-7DaysPrepJoin-id-0001" name="Synchronize 7-Day Prep" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-AlertToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-WalkthroughToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PlacardsToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-KitchenToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AlcoholToJoin-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-7DaysJoinToDayOf-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:startEvent id="StartEvent-DayOfEvent0800-id-0001" name="Day of Event - 08:00">
      <bpmn:incoming>SequenceFlow-7DaysJoinToDayOf-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DayOfToSetupSplit-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-DayOfSetupSplit-id-0001" name="Parallel Setup Tasks" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-DayOfToSetupSplit-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SetupSplitToCeremonyRoom-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SetupSplitToReception-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SetupSplitToAV-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-ArrangeCeremonyRoom-id-0001" name="Arrange Ceremony Room">
      <bpmn:incoming>SequenceFlow-SetupSplitToCeremonyRoom-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CeremonyRoomToJoin-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ArrangeReceptionTables-id-0001" name="Arrange Reception Tables">
      <bpmn:incoming>SequenceFlow-SetupSplitToReception-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceptionToJoin-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TestAVEquipment-id-0001" name="Test AV Equipment">
      <bpmn:incoming>SequenceFlow-SetupSplitToAV-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AVToJoin-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-DayOfSetupJoin-id-0001" name="Synchronize Setup" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-CeremonyRoomToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReceptionToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AVToJoin-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SetupJoinToBuffer-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-CeremonyBuffer-id-0001" name="Ceremony-to-Reception Buffer">
      <bpmn:incoming>SequenceFlow-SetupJoinToBuffer-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BufferToCeremonyStart-id-0001</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="StartEvent-DayOfEvent1500-id-0001" name="Day of Event - 15:00">
      <bpmn:incoming>SequenceFlow-BufferToCeremonyStart-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CeremonyStartToCheckIn-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-CoordinateGuestCheckIn-id-0001" name="Coordinate Guest Check-In">
      <bpmn:incoming>SequenceFlow-CeremonyStartToCheckIn-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckInToCatering-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CheckInToRooms-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess-CateringExecution-id-0001" name="Catering Execution">
      <bpmn:incoming>SequenceFlow-CheckInToCatering-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CateringToBill-id-0001</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-CateringServiceBegins-id-0001" name="Catering Service Begins">
        <bpmn:outgoing>SequenceFlow-CateringStartToService-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-BeginCateringService-id-0001" name="Begin Catering Service">
        <bpmn:incoming>SequenceFlow-CateringStartToService-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ServiceToBar-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-OpenBarService-id-0001" name="Open Bar Service">
        <bpmn:incoming>SequenceFlow-ServiceToBar-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BarToSplit-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway-CateringServiceSplit-id-0001" name="Parallel Service Operations" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-BarToSplit-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToKitchen-id-0001</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToBar-id-0001</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="ServiceTask-ExecuteKitchenTimeline-id-0001" name="Execute Kitchen Timeline">
        <bpmn:incoming>SequenceFlow-SplitToKitchen-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-KitchenToJoin-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-MonitorBarInventory-id-0001" name="Monitor Bar Inventory">
        <bpmn:incoming>SequenceFlow-SplitToBar-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BarToJoin-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway-CateringServiceJoin-id-0001" name="Synchronize Service" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-KitchenToJoin-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-BarToJoin-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToTimer-id-0001</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-ReceptionDuration-id-0001" name="Reception Duration">
        <bpmn:incoming>SequenceFlow-JoinToTimer-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TimerToCleanup-id-0001</bpmn:outgoing>
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="ServiceTask-BeginCleanup-id-0001" name="Begin Cleanup">
        <bpmn:incoming>SequenceFlow-TimerToCleanup-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CleanupToEnd-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-CateringServiceComplete-id-0001" name="Catering Service Complete">
        <bpmn:incoming>SequenceFlow-CleanupToEnd-id-0001</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-CateringStartToService-id-0001" sourceRef="StartEvent-CateringServiceBegins-id-0001" targetRef="ServiceTask-BeginCateringService-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ServiceToBar-id-0001" sourceRef="ServiceTask-BeginCateringService-id-0001" targetRef="ServiceTask-OpenBarService-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BarToSplit-id-0001" sourceRef="ServiceTask-OpenBarService-id-0001" targetRef="ParallelGateway-CateringServiceSplit-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToKitchen-id-0001" sourceRef="ParallelGateway-CateringServiceSplit-id-0001" targetRef="ServiceTask-ExecuteKitchenTimeline-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToBar-id-0001" sourceRef="ParallelGateway-CateringServiceSplit-id-0001" targetRef="ServiceTask-MonitorBarInventory-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-KitchenToJoin-id-0001" sourceRef="ServiceTask-ExecuteKitchenTimeline-id-0001" targetRef="ParallelGateway-CateringServiceJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BarToJoin-id-0001" sourceRef="ServiceTask-MonitorBarInventory-id-0001" targetRef="ParallelGateway-CateringServiceJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToTimer-id-0001" sourceRef="ParallelGateway-CateringServiceJoin-id-0001" targetRef="IntermediateCatchEvent-ReceptionDuration-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TimerToCleanup-id-0001" sourceRef="IntermediateCatchEvent-ReceptionDuration-id-0001" targetRef="ServiceTask-BeginCleanup-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CleanupToEnd-id-0001" sourceRef="ServiceTask-BeginCleanup-id-0001" targetRef="EndEvent-CateringServiceComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-GuestRoomManagement-id-0001" name="Guest Room Management">
      <bpmn:incoming>SequenceFlow-CheckInToRooms-id-0001</bpmn:incoming>
