<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ED-Admission-Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="EmergencyDepartmentAdmissionProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-PatientArrival-id-0001" name="Patient Arrival in ED">
      <bpmn:outgoing>SequenceFlow-PatientArrivalToTriage-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-TriageNurseAssessesPatient-id-0001" name="Triage Nurse Assesses Patient">
      <bpmn:incoming>SequenceFlow-PatientArrivalToTriage-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TriageToAcuityBedDecision-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer15Min-TriageNurseAssessesPatient-id-0001" name="15 Minute Triage SLA" attachedToRef="UserTask-TriageNurseAssessesPatient-id-0001">
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer15Min-TriageNurseAssessesPatient-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-TriageDelayAlert-id-0001" name="Send: Triage Delay Alert to Charge Nurse" />
    <bpmn:exclusiveGateway id="ExclusiveGateway-AcuityBedDecision-id-0001" name="Acuity and Bed Availability Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-TriageToAcuityBedDecision-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AcuityBedDecisionToMonitoredBed-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AcuityBedDecisionToEDWait-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AcuityBedDecisionToStandardEDBay-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-AdmitToMonitoredBed-id-0001" name="Admit to Monitored Bed">
      <bpmn:incoming>SequenceFlow-AcuityBedDecisionToMonitoredBed-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MonitoredBedToPhysicianAssessment-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-PatientWaitsInEDArea-id-0001" name="Patient Waits in ED Area">
      <bpmn:incoming>SequenceFlow-AcuityBedDecisionToEDWait-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EDWaitToPhysicianAssessment-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-AdmitToStandardEDBay-id-0001" name="Admit to Standard ED Bay">
      <bpmn:incoming>SequenceFlow-AcuityBedDecisionToStandardEDBay-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StandardEDBayToPhysicianAssessment-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-PhysicianPerformsAssessment-id-0001" name="Physician Performs Assessment">
      <bpmn:incoming>SequenceFlow-EDWaitToPhysicianAssessment-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-StandardEDBayToPhysicianAssessment-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-MonitoredBedToPhysicianAssessment-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PhysicianAssessmentToOrderTests-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer4Hour-PhysicianPerformsAssessment-id-0001" name="4 Hour Assessment SLA" attachedToRef="UserTask-PhysicianPerformsAssessment-id-0001">
      <bpmn:outgoing>SequenceFlow-PhysicianAssessmentToEscalation-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer4Hour-PhysicianPerformsAssessment-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-EscalationToDepartmentHead-id-0001" name="Send: Escalation to Department Head">
      <bpmn:incoming>SequenceFlow-PhysicianAssessmentToEscalation-id-0001</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Error-PhysicianPerformsAssessment-id-0001" name="Assessment Error" attachedToRef="UserTask-PhysicianPerformsAssessment-id-0001">
      <bpmn:outgoing>SequenceFlow-PhysicianAssessmentToSeniorPhysician-id-0001</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BoundaryEvent-Error-PhysicianPerformsAssessment-id-0001_EventDef" errorRef="ASSESSMENT_ERROR" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask-SeniorPhysicianTakesOverAssessment-id-0001" name="Senior Physician Takes Over Assessment">
      <bpmn:incoming>SequenceFlow-PhysicianAssessmentToSeniorPhysician-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SeniorPhysicianToOrderTests-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-OrderDiagnosticTests-id-0001" name="Order Diagnostic Tests">
      <bpmn:incoming>SequenceFlow-PhysicianAssessmentToOrderTests-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SeniorPhysicianToOrderTests-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OrderTestsToAdmissionDecision-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-OrderTestsToMonitorOrders-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AdmissionDecision-id-0001" name="Admission Required?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-OrderTestsToAdmissionDecision-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdmissionDecisionToAdmissionWorkflow-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AdmissionDecisionToDischarge-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess-AdmissionWorkflow-id-0001" name="Admission Workflow">
      <bpmn:incoming>SequenceFlow-AdmissionDecisionToAdmissionWorkflow-id-0001</bpmn:incoming>
      <bpmn:startEvent id="StartEvent-AdmissionInitiated-id-0001" name="Admission Initiated">
        <bpmn:outgoing>SequenceFlow-AdmissionStartToBedCheck-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-CheckBedAvailability-id-0001" name="Check Bed Availability">
        <bpmn:incoming>SequenceFlow-AdmissionStartToBedCheck-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BedCheckToBedTypeDecision-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="BoundaryEvent-Error-CheckBedAvailability-id-0001" name="Bed Availability System Error" attachedToRef="ServiceTask-CheckBedAvailability-id-0001">
        <bpmn:outgoing>SequenceFlow-BedCheckErrorToManualAssignment-id-0001</bpmn:outgoing>
        <bpmn:errorEventDefinition id="BoundaryEvent-Error-CheckBedAvailability-id-0001_EventDef" errorRef="BED_SYSTEM_ERROR" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="UserTask-ManualBedAssignmentByAdmissions-id-0001" name="Manual Bed Assignment by Admissions">
        <bpmn:incoming>SequenceFlow-BedCheckErrorToManualAssignment-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ManualAssignmentToBedTypeDecision-id-0001</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-BedTypeDecision-id-0001" name="Bed Type Decision" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-BedCheckToBedTypeDecision-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ManualAssignmentToBedTypeDecision-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BedTypeDecisionToICUBed-id-0001</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-BedTypeDecisionToGeneralBed-id-0001</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-BedTypeDecisionToWaitingQueue-id-0001</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-AssignICUBed-id-0001" name="Assign ICU Bed">
        <bpmn:incoming>SequenceFlow-BedTypeDecisionToICUBed-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ICUBedToTransfer-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-AssignGeneralWardBed-id-0001" name="Assign General Ward Bed">
        <bpmn:incoming>SequenceFlow-BedTypeDecisionToGeneralBed-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GeneralBedToTransfer-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-PlaceInWaitingQueue-id-0001" name="Place in Waiting Queue">
        <bpmn:incoming>SequenceFlow-BedTypeDecisionToWaitingQueue-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-WaitingQueueToNotification-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SendTask-NotificationToNursingManager-id-0001" name="Send: Notification to Nursing Manager">
        <bpmn:incoming>SequenceFlow-WaitingQueueToNotification-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-NotificationToWaitingEnd-id-0001</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="EndEvent-WaitingQueuePlacement-id-0001" name="Waiting Queue Placement">
        <bpmn:incoming>SequenceFlow-NotificationToWaitingEnd-id-0001</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="ServiceTask-TransferPatientToAssignedBed-id-0001" name="Transfer Patient to Assigned Bed">
        <bpmn:incoming>SequenceFlow-ICUBedToTransfer-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-GeneralBedToTransfer-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TransferToProtocols-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-InitiateAdmissionProtocols-id-0001" name="Initiate Admission Protocols">
        <bpmn:incoming>SequenceFlow-TransferToProtocols-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ProtocolsToMedRec-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:subProcess id="SubProcess-MedicationReconciliation-id-0001" name="Medication Reconciliation">
        <bpmn:incoming>SequenceFlow-ProtocolsToMedRec-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MedRecToInsuranceCheck-id-0001</bpmn:outgoing>
        <bpmn:startEvent id="StartEvent-MedRecStarted-id-0001" name="Med Rec Started">
          <bpmn:outgoing>SequenceFlow-MedRecStartToVerifyAllergies-id-0001</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="ServiceTask-VerifyAllergies-id-0001" name="Verify Allergies">
          <bpmn:incoming>SequenceFlow-MedRecStartToVerifyAllergies-id-0001</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow-VerifyAllergiesToPharmacyReview-id-0001</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="ServiceTask-PharmacyReviewsMedications-id-0001" name="Pharmacy Reviews Medications">
          <bpmn:incoming>SequenceFlow-VerifyAllergiesToPharmacyReview-id-0001</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow-PharmacyReviewToInteractionCheck-id-0001</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:boundaryEvent id="BoundaryEvent-Timer4Hour-PharmacyReviewsMedications-id-0001" name="4 Hour Pharmacy Review SLA" attachedToRef="ServiceTask-PharmacyReviewsMedications-id-0001">
          <bpmn:outgoing>SequenceFlow-BoundaryToUrgentAlert-id-0001</bpmn:outgoing>
          <bpmn:timerEventDefinition id="BoundaryEvent-Timer4Hour-PharmacyReviewsMedications-id-0001_EventDef">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sendTask id="SendTask-UrgentPharmacyAlert-id-0001" name="Send: Urgent Pharmacy Alert">
          <bpmn:incoming>SequenceFlow-BoundaryToUrgentAlert-id-0001</bpmn:incoming>
        </bpmn:sendTask>
        <bpmn:exclusiveGateway id="ExclusiveGateway-MedicationInteraction-id-0001" name="Medication Interaction Found?" gatewayDirection="Diverging">
          <bpmn:incoming>SequenceFlow-PharmacyReviewToInteractionCheck-id-0001</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow-InteractionCheckToAdjustment-id-0001</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow-InteractionCheckToNoInteractions-id-0001</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:userTask id="UserTask-PrescribingPhysicianAdjustsMedicationRegimen-id-0001" name="Prescribing Physician Adjusts Medication Regimen">
          <bpmn:incoming>SequenceFlow-InteractionCheckToAdjustment-id-0001</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow-AdjustmentToRegimenAdjusted-id-0001</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="EndEvent-RegimenAdjusted-id-0001" name="Regimen Adjusted">
          <bpmn:incoming>SequenceFlow-AdjustmentToRegimenAdjusted-id-0001</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="EndEvent-NoInteractions-id-0001" name="No Interactions">
          <bpmn:incoming>SequenceFlow-InteractionCheckToNoInteractions-id-0001</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow-MedRecStartToVerifyAllergies-id-0001" sourceRef="StartEvent-MedRecStarted-id-0001" targetRef="ServiceTask-VerifyAllergies-id-0001" />
        <bpmn:sequenceFlow id="SequenceFlow-VerifyAllergiesToPharmacyReview-id-0001" sourceRef="ServiceTask-VerifyAllergies-id-0001" targetRef="ServiceTask-PharmacyReviewsMedications-id-0001" />
        <bpmn:sequenceFlow id="SequenceFlow-PharmacyReviewToInteractionCheck-id-0001" sourceRef="ServiceTask-PharmacyReviewsMedications-id-0001" targetRef="ExclusiveGateway-MedicationInteraction-id-0001" />
        <bpmn:sequenceFlow id="SequenceFlow-InteractionCheckToAdjustment-id-0001" name="interaction_found == true" sourceRef="ExclusiveGateway-MedicationInteraction-id-0001" targetRef="UserTask-PrescribingPhysicianAdjustsMedicationRegimen-id-0001" />
        <bpmn:sequenceFlow id="SequenceFlow-InteractionCheckToNoInteractions-id-0001" name="ELSE" sourceRef="ExclusiveGateway-MedicationInteraction-id-0001" targetRef="EndEvent-NoInteractions-id-0001" />
        <bpmn:sequenceFlow id="SequenceFlow-AdjustmentToRegimenAdjusted-id-0001" sourceRef="UserTask-PrescribingPhysicianAdjustsMedicationRegimen-id-0001" targetRef="EndEvent-RegimenAdjusted-id-0001" />
        <bpmn:sequenceFlow id="SequenceFlow-BoundaryToUrgentAlert-id-0001" sourceRef="BoundaryEvent-Timer4Hour-PharmacyReviewsMedications-id-0001" targetRef="SendTask-UrgentPharmacyAlert-id-0001" />
      </bpmn:subProcess>
      <bpmn:serviceTask id="ServiceTask-TrackInsuranceAuthorization-id-0001" name="Track Insurance Authorization">
        <bpmn:incoming>SequenceFlow-MedRecToInsuranceCheck-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-InsuranceCheckToApprovalCheck-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-InsuranceApproval-id-0001" name="Insurance Approval Check" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-InsuranceCheckToApprovalCheck-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ApprovalCheckToBillingContact-id-0001</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-ApprovalCheckToAdmissionComplete-id-0001</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UserTask-BillingTeamContactsPatient-id-0001" name="Billing Team Contacts Patient">
        <bpmn:incoming>SequenceFlow-ApprovalCheckToBillingContact-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BillingContactToAdmissionComplete-id-0001</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EndEvent-AdmissionComplete-id-0001" name="Admission Complete">
        <bpmn:incoming>SequenceFlow-ApprovalCheckToAdmissionComplete-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-BillingContactToAdmissionComplete-id-0001</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-AdmissionStartToBedCheck-id-0001" sourceRef="StartEvent-AdmissionInitiated-id-0001" targetRef="ServiceTask-CheckBedAvailability-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BedCheckToBedTypeDecision-id-0001" sourceRef="ServiceTask-CheckBedAvailability-id-0001" targetRef="ExclusiveGateway-BedTypeDecision-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BedTypeDecisionToICUBed-id-0001" name="icu_bed_available == true AND acuity == 1" sourceRef="ExclusiveGateway-BedTypeDecision-id-0001" targetRef="ServiceTask-AssignICUBed-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BedTypeDecisionToGeneralBed-id-0001" name="general_bed_available == true AND acuity &#60;= 3" sourceRef="ExclusiveGateway-BedTypeDecision-id-0001" targetRef="ServiceTask-AssignGeneralWardBed-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BedTypeDecisionToWaitingQueue-id-0001" name="ELSE" sourceRef="ExclusiveGateway-BedTypeDecision-id-0001" targetRef="ServiceTask-PlaceInWaitingQueue-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-WaitingQueueToNotification-id-0001" sourceRef="ServiceTask-PlaceInWaitingQueue-id-0001" targetRef="SendTask-NotificationToNursingManager-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-NotificationToWaitingEnd-id-0001" sourceRef="SendTask-NotificationToNursingManager-id-0001" targetRef="EndEvent-WaitingQueuePlacement-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ICUBedToTransfer-id-0001" sourceRef="ServiceTask-AssignICUBed-id-0001" targetRef="ServiceTask-TransferPatientToAssignedBed-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GeneralBedToTransfer-id-0001" sourceRef="ServiceTask-AssignGeneralWardBed-id-0001" targetRef="ServiceTask-TransferPatientToAssignedBed-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TransferToProtocols-id-0001" sourceRef="ServiceTask-TransferPatientToAssignedBed-id-0001" targetRef="ServiceTask-InitiateAdmissionProtocols-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ProtocolsToMedRec-id-0001" sourceRef="ServiceTask-InitiateAdmissionProtocols-id-0001" targetRef="SubProcess-MedicationReconciliation-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-MedRecToInsuranceCheck-id-0001" sourceRef="SubProcess-MedicationReconciliation-id-0001" targetRef="ServiceTask-TrackInsuranceAuthorization-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-InsuranceCheckToApprovalCheck-id-0001" sourceRef="ServiceTask-TrackInsuranceAuthorization-id-0001" targetRef="ExclusiveGateway-InsuranceApproval-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ApprovalCheckToBillingContact-id-0001" name="authorization_approved == false" sourceRef="ExclusiveGateway-InsuranceApproval-id-0001" targetRef="UserTask-BillingTeamContactsPatient-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ApprovalCheckToAdmissionComplete-id-0001" name="ELSE" sourceRef="ExclusiveGateway-InsuranceApproval-id-0001" targetRef="EndEvent-AdmissionComplete-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BillingContactToAdmissionComplete-id-0001" sourceRef="UserTask-BillingTeamContactsPatient-id-0001" targetRef="EndEvent-AdmissionComplete-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BedCheckErrorToManualAssignment-id-0001" sourceRef="BoundaryEvent-Error-CheckBedAvailability-id-0001" targetRef="UserTask-ManualBedAssignmentByAdmissions-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ManualAssignmentToBedTypeDecision-id-0001" sourceRef="UserTask-ManualBedAssignmentByAdmissions-id-0001" targetRef="ExclusiveGateway-BedTypeDecision-id-0001" />
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask-PhysicianDocumentsDischargeInstructions-id-0001" name="Physician Documents Discharge Instructions">
      <bpmn:incoming>SequenceFlow-AdmissionDecisionToDischarge-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DischargeToDischargeComplete-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-DischargeComplete-id-0001" name="Discharge Complete">
      <bpmn:incoming>SequenceFlow-DischargeToDischargeComplete-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-MonitorPhysicianOrders-id-0001" name="Monitor Physician Orders">
      <bpmn:incoming>SequenceFlow-OrderTestsToMonitorOrders-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MonitorOrdersToCriticalLabCheck-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CriticalLabValue-id-0001" name="Critical Lab Value Detected?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-MonitorOrdersToCriticalLabCheck-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CriticalLabCheckToAlert-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CriticalLabCheckToContinue-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-CriticalLabAlertToPhysician-id-0001" name="Send: Critical Lab Alert to Physician">
      <bpmn:incoming>SequenceFlow-CriticalLabCheckToAlert-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AlertToPhysicianReview-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-PhysicianReviewsAlert-id-0001" name="Physician Reviews Alert">
      <bpmn:incoming>SequenceFlow-AlertToPhysicianReview-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PhysicianReviewToAlertReviewed-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-AlertReviewed-id-0001" name="Alert Reviewed">
      <bpmn:incoming>SequenceFlow-CriticalLabCheckToContinue-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PhysicianReviewToAlertReviewed-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-PatientArrivalToTriage-id-0001" sourceRef="StartEvent-PatientArrival-id-0001" targetRef="UserTask-TriageNurseAssessesPatient-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TriageToAcuityBedDecision-id-0001" sourceRef="UserTask-TriageNurseAssessesPatient-id-0001" targetRef="ExclusiveGateway-AcuityBedDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AcuityBedDecisionToMonitoredBed-id-0001" name="acuity == 1 AND bed_available == true" sourceRef="ExclusiveGateway-AcuityBedDecision-id-0001" targetRef="ServiceTask-AdmitToMonitoredBed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AcuityBedDecisionToEDWait-id-0001" name="acuity &#60;= 5 AND bed_available == false" sourceRef="ExclusiveGateway-AcuityBedDecision-id-0001" targetRef="UserTask-PatientWaitsInEDArea-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AcuityBedDecisionToStandardEDBay-id-0001" name="ELSE" sourceRef="ExclusiveGateway-AcuityBedDecision-id-0001" targetRef="ServiceTask-AdmitToStandardEDBay-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EDWaitToPhysicianAssessment-id-0001" sourceRef="UserTask-PatientWaitsInEDArea-id-0001" targetRef="UserTask-PhysicianPerformsAssessment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StandardEDBayToPhysicianAssessment-id-0001" sourceRef="ServiceTask-AdmitToStandardEDBay-id-0001" targetRef="UserTask-PhysicianPerformsAssessment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MonitoredBedToPhysicianAssessment-id-0001" sourceRef="ServiceTask-AdmitToMonitoredBed-id-0001" targetRef="UserTask-PhysicianPerformsAssessment-id-0001" />
