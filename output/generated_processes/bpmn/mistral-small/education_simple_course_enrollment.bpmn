<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="empty-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="CourseEnrollmentProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-StudentLogsIn-id-0001" name="Student Logs In">
      <bpmn:outgoing>SequenceFlow-StartToSearch-id-0013</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-SearchForAvailableCourses-id-0002" name="Search for Available Courses">
      <bpmn:incoming>SequenceFlow-StartToSearch-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SearchToCheck-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CheckCourseDetails-id-0003" name="Check Course Details">
      <bpmn:incoming>SequenceFlow-SearchToCheck-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckToGateway-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CourseEligibility-id-0004" name="Course Eligibility" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckToGateway-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToVerify-id-0016</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToNotPossible-id-0023</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-VerifyPrerequisites-id-0005" name="Verify Prerequisites">
      <bpmn:incoming>SequenceFlow-GatewayToVerify-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToCheckSeat-id-0017</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CheckSeatAvailability-id-0006" name="Check Seat Availability">
      <bpmn:incoming>SequenceFlow-VerifyToCheckSeat-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckSeatToEnroll-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-EnrollInCourse-id-0007" name="Enroll in Course">
      <bpmn:incoming>SequenceFlow-CheckSeatToEnroll-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnrollToConfirm-id-0019</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ConfirmEnrollment-id-0008" name="Confirm Enrollment">
      <bpmn:incoming>SequenceFlow-EnrollToConfirm-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConfirmToGenerate-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GenerateCourseSchedule-id-0009" name="Generate Course Schedule">
      <bpmn:incoming>SequenceFlow-ConfirmToGenerate-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateToUpdate-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-UpdateCourseRoster-id-0010" name="Update Course Roster">
      <bpmn:incoming>SequenceFlow-GenerateToUpdate-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToComplete-id-0022</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-EnrollmentComplete-id-0011" name="Enrollment Complete">
      <bpmn:incoming>SequenceFlow-UpdateToComplete-id-0022</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-EnrollmentNotPossible-id-0012" name="Enrollment Not Possible">
      <bpmn:incoming>SequenceFlow-GatewayToNotPossible-id-0023</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSearch-id-0013" sourceRef="StartEvent-StudentLogsIn-id-0001" targetRef="UserTask-SearchForAvailableCourses-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SearchToCheck-id-0014" sourceRef="UserTask-SearchForAvailableCourses-id-0002" targetRef="UserTask-CheckCourseDetails-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckToGateway-id-0015" sourceRef="UserTask-CheckCourseDetails-id-0003" targetRef="ExclusiveGateway-CourseEligibility-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToVerify-id-0016" name="prerequisites_met AND seats_available" sourceRef="ExclusiveGateway-CourseEligibility-id-0004" targetRef="ServiceTask-VerifyPrerequisites-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyToCheckSeat-id-0017" sourceRef="ServiceTask-VerifyPrerequisites-id-0005" targetRef="ServiceTask-CheckSeatAvailability-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckSeatToEnroll-id-0018" sourceRef="ServiceTask-CheckSeatAvailability-id-0006" targetRef="UserTask-EnrollInCourse-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-EnrollToConfirm-id-0019" sourceRef="UserTask-EnrollInCourse-id-0007" targetRef="ServiceTask-ConfirmEnrollment-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ConfirmToGenerate-id-0020" sourceRef="ServiceTask-ConfirmEnrollment-id-0008" targetRef="ServiceTask-GenerateCourseSchedule-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateToUpdate-id-0021" sourceRef="ServiceTask-GenerateCourseSchedule-id-0009" targetRef="ServiceTask-UpdateCourseRoster-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToComplete-id-0022" sourceRef="ServiceTask-UpdateCourseRoster-id-0010" targetRef="EndEvent-EnrollmentComplete-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToNotPossible-id-0023" sourceRef="ExclusiveGateway-CourseEligibility-id-0004" targetRef="EndEvent-EnrollmentNotPossible-id-0012" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CourseEnrollmentProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_CourseEnrollmentProcess-id-0001" bpmnElement="CourseEnrollmentProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-StudentLogsIn-id-0001_di" bpmnElement="StartEvent-StudentLogsIn-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SearchForAvailableCourses-id-0002_di" bpmnElement="UserTask-SearchForAvailableCourses-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CheckCourseDetails-id-0003_di" bpmnElement="UserTask-CheckCourseDetails-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-CourseEligibility-id-0004_di" bpmnElement="ExclusiveGateway-CourseEligibility-id-0004" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-VerifyPrerequisites-id-0005_di" bpmnElement="ServiceTask-VerifyPrerequisites-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CheckSeatAvailability-id-0006_di" bpmnElement="ServiceTask-CheckSeatAvailability-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EnrollInCourse-id-0007_di" bpmnElement="UserTask-EnrollInCourse-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ConfirmEnrollment-id-0008_di" bpmnElement="ServiceTask-ConfirmEnrollment-id-0008">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateCourseSchedule-id-0009_di" bpmnElement="ServiceTask-GenerateCourseSchedule-id-0009">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-UpdateCourseRoster-id-0010_di" bpmnElement="ServiceTask-UpdateCourseRoster-id-0010">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-EnrollmentComplete-id-0011_di" bpmnElement="EndEvent-EnrollmentComplete-id-0011">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-EnrollmentNotPossible-id-0012_di" bpmnElement="EndEvent-EnrollmentNotPossible-id-0012">
        <dc:Bounds x="657" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSearch-id-0013_di" bpmnElement="SequenceFlow-StartToSearch-id-0013">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SearchToCheck-id-0014_di" bpmnElement="SequenceFlow-SearchToCheck-id-0014">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckToGateway-id-0015_di" bpmnElement="SequenceFlow-CheckToGateway-id-0015">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToVerify-id-0016_di" bpmnElement="SequenceFlow-GatewayToVerify-id-0016">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToNotPossible-id-0023_di" bpmnElement="SequenceFlow-GatewayToNotPossible-id-0023">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="657" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-VerifyToCheckSeat-id-0017_di" bpmnElement="SequenceFlow-VerifyToCheckSeat-id-0017">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckSeatToEnroll-id-0018_di" bpmnElement="SequenceFlow-CheckSeatToEnroll-id-0018">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EnrollToConfirm-id-0019_di" bpmnElement="SequenceFlow-EnrollToConfirm-id-0019">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ConfirmToGenerate-id-0020_di" bpmnElement="SequenceFlow-ConfirmToGenerate-id-0020">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GenerateToUpdate-id-0021_di" bpmnElement="SequenceFlow-GenerateToUpdate-id-0021">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UpdateToComplete-id-0022_di" bpmnElement="SequenceFlow-UpdateToComplete-id-0022">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1557" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
