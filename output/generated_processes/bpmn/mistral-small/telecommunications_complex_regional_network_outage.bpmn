<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions-1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process-NetworkIncidentResolution-id-0001" name="Network Incident Resolution" isExecutable="true">
    <bpmn:startEvent id="StartEvent-NetworkMonitoringAlert-id-0001" name="Network Monitoring Alert">
      <bpmn:outgoing>SequenceFlow-StartToAnalyzeAffectedTowers-id-0054</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-AnalyzeAffectedTowers-id-0002" name="Analyze: affected towers and services">
      <bpmn:incoming>SequenceFlow-StartToAnalyzeAffectedTowers-id-0054</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeAffectedTowersToCalculateCustomerImpact-id-0055</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CalculateCustomerImpact-id-0003" name="Calculate: customer impact">
      <bpmn:incoming>SequenceFlow-AnalyzeAffectedTowersToCalculateCustomerImpact-id-0055</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateCustomerImpactToRerouteTraffic-id-0056</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-RerouteTraffic-id-0004" name="Reroute: traffic to adjacent towers">
      <bpmn:incoming>SequenceFlow-CalculateCustomerImpactToRerouteTraffic-id-0056</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RerouteTrafficToSendIncidentAlert-id-0057</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendIncidentAlert-id-0005" name="Send: incident alert to on-call engineers and NOC team">
      <bpmn:incoming>SequenceFlow-RerouteTrafficToSendIncidentAlert-id-0057</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendIncidentAlertToDispatchFieldEngineers-id-0058</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-DispatchFieldEngineers-id-0006" name="Dispatch: field engineers to affected towers">
      <bpmn:incoming>SequenceFlow-SendIncidentAlertToDispatchFieldEngineers-id-0058</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DispatchFieldEngineersToRootCauseAnalysis-id-0059</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess-RootCauseAnalysis-id-0007" name="Root Cause Analysis">
      <bpmn:incoming>SequenceFlow-DispatchFieldEngineersToRootCauseAnalysis-id-0059</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RootCauseAnalysisToTimerBoundary-id-0060</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-RootCauseAnalysisStart-id-0008" name="Root Cause Analysis Start">
        <bpmn:outgoing>SequenceFlow-StartToAnalyzeRootCause-id-0015</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-AnalyzeRootCause-id-0009" name="Analyze: root cause from logs">
        <bpmn:incoming>SequenceFlow-StartToAnalyzeRootCause-id-0015</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AnalyzeRootCauseToGateway-id-0016</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-RootCause-id-0010" name="Root Cause" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-AnalyzeRootCauseToGateway-id-0016</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GatewayToRetrieveSpareParts-id-0017</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToPrioritizeTraffic-id-0018</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToRollbackSoftware-id-0019</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-RetrieveSpareParts-id-0011" name="Retrieve: spare parts from inventory">
        <bpmn:incoming>SequenceFlow-GatewayToRetrieveSpareParts-id-0017</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RetrieveSparePartsToEnd-id-0020</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-PrioritizeTraffic-id-0012" name="Prioritize: traffic to critical services">
        <bpmn:incoming>SequenceFlow-GatewayToPrioritizeTraffic-id-0018</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PrioritizeTrafficToEnd-id-0021</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-RollbackSoftware-id-0013" name="Rollback: software to previous version">
        <bpmn:incoming>SequenceFlow-GatewayToRollbackSoftware-id-0019</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RollbackSoftwareToEnd-id-0022</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-RootCauseAnalysisComplete-id-0014" name="Root Cause Analysis Complete">
        <bpmn:incoming>SequenceFlow-RetrieveSparePartsToEnd-id-0020</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-PrioritizeTrafficToEnd-id-0021</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-RollbackSoftwareToEnd-id-0022</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToAnalyzeRootCause-id-0015" sourceRef="StartEvent-RootCauseAnalysisStart-id-0008" targetRef="ServiceTask-AnalyzeRootCause-id-0009" />
      <bpmn:sequenceFlow id="SequenceFlow-AnalyzeRootCauseToGateway-id-0016" sourceRef="ServiceTask-AnalyzeRootCause-id-0009" targetRef="ExclusiveGateway-RootCause-id-0010" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToRetrieveSpareParts-id-0017" name="hardware_failure_suspected" sourceRef="ExclusiveGateway-RootCause-id-0010" targetRef="ServiceTask-RetrieveSpareParts-id-0011" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToPrioritizeTraffic-id-0018" name="capacity_overload_suspected" sourceRef="ExclusiveGateway-RootCause-id-0010" targetRef="ServiceTask-PrioritizeTraffic-id-0012" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToRollbackSoftware-id-0019" sourceRef="ExclusiveGateway-RootCause-id-0010" targetRef="ServiceTask-RollbackSoftware-id-0013" />
      <bpmn:sequenceFlow id="SequenceFlow-RetrieveSparePartsToEnd-id-0020" sourceRef="ServiceTask-RetrieveSpareParts-id-0011" targetRef="EndEvent-RootCauseAnalysisComplete-id-0014" />
      <bpmn:sequenceFlow id="SequenceFlow-PrioritizeTrafficToEnd-id-0021" sourceRef="ServiceTask-PrioritizeTraffic-id-0012" targetRef="EndEvent-RootCauseAnalysisComplete-id-0014" />
      <bpmn:sequenceFlow id="SequenceFlow-RollbackSoftwareToEnd-id-0022" sourceRef="ServiceTask-RollbackSoftware-id-0013" targetRef="EndEvent-RootCauseAnalysisComplete-id-0014" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-TimerBoundary-id-0023" name="2 Hour Timeout">
      <bpmn:incoming>SequenceFlow-RootCauseAnalysisToTimerBoundary-id-0060</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TimerBoundaryToFieldTeamActions-id-0061</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="SubProcess-FieldTeamActions-id-0024" name="Field Team Actions">
      <bpmn:incoming>SequenceFlow-TimerBoundaryToFieldTeamActions-id-0061</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FieldTeamActionsToLogIncidentSummary-id-0062</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-FieldTeamActionsStart-id-0025" name="Field Team Actions Start">
        <bpmn:outgoing>SequenceFlow-StartToConnectDiagnosticEquipment-id-0039</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-ConnectDiagnosticEquipment-id-0026" name="Connect: diagnostic equipment">
        <bpmn:incoming>SequenceFlow-StartToConnectDiagnosticEquipment-id-0039</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ConnectDiagnosticEquipmentToConfirmSystemHypothesis-id-0040</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="UserTask-ConfirmSystemHypothesis-id-0027" name="Confirm: system hypothesis">
        <bpmn:incoming>SequenceFlow-ConnectDiagnosticEquipmentToConfirmSystemHypothesis-id-0040</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ConfirmSystemHypothesisToPerformFix-id-0041</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="UserTask-PerformFix-id-0028" name="Perform: fix (replace hardware, rollback software, or activate backup circuit)">
        <bpmn:incoming>SequenceFlow-ConfirmSystemHypothesisToPerformFix-id-0041</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PerformFixToRerouteTrafficDuringMaintenance-id-0042</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="SendTask-SendEscalation-id-0029" name="Send: escalation to senior engineer">
        <bpmn:incoming>SequenceFlow-BoundaryEventToSendEscalation-id-0049</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SendEscalationToRerouteTrafficDuringMaintenance-id-0050</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="ServiceTask-EscalateForInvestigation-id-0030" name="Escalate: for further investigation">
        <bpmn:incoming>SequenceFlow-GatewayToFailed-id-0047</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-BoundaryEventToEscalateForInvestigation-id-0051</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-EscalateForInvestigationToFailed-id-0048</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-RerouteTrafficDuringMaintenance-id-0031" name="Reroute: traffic during maintenance">
        <bpmn:incoming>SequenceFlow-PerformFixToRerouteTrafficDuringMaintenance-id-0042</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SendEscalationToRerouteTrafficDuringMaintenance-id-0050</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RerouteTrafficDuringMaintenanceToSendNotifications-id-0043</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SendTask-SendNotifications-id-0032" name="Send: notifications to affected customers">
        <bpmn:incoming>SequenceFlow-RerouteTrafficDuringMaintenanceToSendNotifications-id-0043</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SendNotificationsToValidateNetworkMetrics-id-0044</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="ServiceTask-ValidateNetworkMetrics-id-0033" name="Validate: network metrics returned to normal">
        <bpmn:incoming>SequenceFlow-SendNotificationsToValidateNetworkMetrics-id-0044</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ValidateNetworkMetricsToGateway-id-0045</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-MetricsNormal-id-0034" name="Metrics Normal?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-ValidateNetworkMetricsToGateway-id-0045</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GatewayToComplete-id-0046</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToFailed-id-0047</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent-FieldTeamActionsComplete-id-0035" name="Field Team Actions Complete">
        <bpmn:incoming>SequenceFlow-GatewayToComplete-id-0046</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="EndEvent-FieldTeamActionsFailed-id-0036" name="Field Team Actions Failed">
        <bpmn:incoming>SequenceFlow-EscalateForInvestigationToFailed-id-0048</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="BoundaryEvent-TimerBoundaryOnConnect-id-0037" name="4 Hour Timeout" attachedToRef="UserTask-ConnectDiagnosticEquipment-id-0026">
        <bpmn:outgoing>SequenceFlow-BoundaryEventToSendEscalation-id-0049</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-TimerBoundaryOnConnect-id-0037_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="BoundaryEvent-ErrorBoundaryOnPerformFix-id-0038" name="Fix Failed" attachedToRef="UserTask-PerformFix-id-0028">
        <bpmn:outgoing>SequenceFlow-BoundaryEventToEscalateForInvestigation-id-0051</bpmn:outgoing>
        <bpmn:errorEventDefinition id="BoundaryEvent-ErrorBoundaryOnPerformFix-id-0038_EventDef" errorRef="FIX_FAILED" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToConnectDiagnosticEquipment-id-0039" sourceRef="StartEvent-FieldTeamActionsStart-id-0025" targetRef="UserTask-ConnectDiagnosticEquipment-id-0026" />
      <bpmn:sequenceFlow id="SequenceFlow-ConnectDiagnosticEquipmentToConfirmSystemHypothesis-id-0040" sourceRef="UserTask-ConnectDiagnosticEquipment-id-0026" targetRef="UserTask-ConfirmSystemHypothesis-id-0027" />
      <bpmn:sequenceFlow id="SequenceFlow-ConfirmSystemHypothesisToPerformFix-id-0041" sourceRef="UserTask-ConfirmSystemHypothesis-id-0027" targetRef="UserTask-PerformFix-id-0028" />
      <bpmn:sequenceFlow id="SequenceFlow-PerformFixToRerouteTrafficDuringMaintenance-id-0042" sourceRef="UserTask-PerformFix-id-0028" targetRef="ServiceTask-RerouteTrafficDuringMaintenance-id-0031" />
      <bpmn:sequenceFlow id="SequenceFlow-RerouteTrafficDuringMaintenanceToSendNotifications-id-0043" sourceRef="ServiceTask-RerouteTrafficDuringMaintenance-id-0031" targetRef="SendTask-SendNotifications-id-0032" />
      <bpmn:sequenceFlow id="SequenceFlow-SendNotificationsToValidateNetworkMetrics-id-0044" sourceRef="SendTask-SendNotifications-id-0032" targetRef="ServiceTask-ValidateNetworkMetrics-id-0033" />
      <bpmn:sequenceFlow id="SequenceFlow-ValidateNetworkMetricsToGateway-id-0045" sourceRef="ServiceTask-ValidateNetworkMetrics-id-0033" targetRef="ExclusiveGateway-MetricsNormal-id-0034" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToComplete-id-0046" name="metrics_normal" sourceRef="ExclusiveGateway-MetricsNormal-id-0034" targetRef="EndEvent-FieldTeamActionsComplete-id-0035" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToFailed-id-0047" sourceRef="ExclusiveGateway-MetricsNormal-id-0034" targetRef="ServiceTask-EscalateForInvestigation-id-0030" />
      <bpmn:sequenceFlow id="SequenceFlow-EscalateForInvestigationToFailed-id-0048" sourceRef="ServiceTask-EscalateForInvestigation-id-0030" targetRef="EndEvent-FieldTeamActionsFailed-id-0036" />
      <bpmn:sequenceFlow id="SequenceFlow-BoundaryEventToSendEscalation-id-0049" sourceRef="BoundaryEvent-TimerBoundaryOnConnect-id-0037" targetRef="SendTask-SendEscalation-id-0029" />
      <bpmn:sequenceFlow id="SequenceFlow-SendEscalationToRerouteTrafficDuringMaintenance-id-0050" sourceRef="SendTask-SendEscalation-id-0029" targetRef="ServiceTask-RerouteTrafficDuringMaintenance-id-0031" />
      <bpmn:sequenceFlow id="SequenceFlow-BoundaryEventToEscalateForInvestigation-id-0051" sourceRef="BoundaryEvent-ErrorBoundaryOnPerformFix-id-0038" targetRef="ServiceTask-EscalateForInvestigation-id-0030" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="ServiceTask-LogIncidentSummary-id-0052" name="Log: incident summary for post-mortem analysis">
      <bpmn:incoming>SequenceFlow-FieldTeamActionsToLogIncidentSummary-id-0062</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LogIncidentSummaryToIncidentResolved-id-0063</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-IncidentResolved-id-0053" name="Incident Resolved">
      <bpmn:incoming>SequenceFlow-LogIncidentSummaryToIncidentResolved-id-0063</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToAnalyzeAffectedTowers-id-0054" sourceRef="StartEvent-NetworkMonitoringAlert-id-0001" targetRef="ServiceTask-AnalyzeAffectedTowers-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeAffectedTowersToCalculateCustomerImpact-id-0055" sourceRef="ServiceTask-AnalyzeAffectedTowers-id-0002" targetRef="ServiceTask-CalculateCustomerImpact-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateCustomerImpactToRerouteTraffic-id-0056" sourceRef="ServiceTask-CalculateCustomerImpact-id-0003" targetRef="ServiceTask-RerouteTraffic-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-RerouteTrafficToSendIncidentAlert-id-0057" sourceRef="ServiceTask-RerouteTraffic-id-0004" targetRef="SendTask-SendIncidentAlert-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-SendIncidentAlertToDispatchFieldEngineers-id-0058" sourceRef="SendTask-SendIncidentAlert-id-0005" targetRef="ServiceTask-DispatchFieldEngineers-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-DispatchFieldEngineersToRootCauseAnalysis-id-0059" sourceRef="ServiceTask-DispatchFieldEngineers-id-0006" targetRef="SubProcess-RootCauseAnalysis-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-RootCauseAnalysisToTimerBoundary-id-0060" sourceRef="SubProcess-RootCauseAnalysis-id-0007" targetRef="IntermediateCatchEvent-TimerBoundary-id-0023" />
    <bpmn:sequenceFlow id="SequenceFlow-TimerBoundaryToFieldTeamActions-id-0061" sourceRef="IntermediateCatchEvent-TimerBoundary-id-0023" targetRef="SubProcess-FieldTeamActions-id-0024" />
    <bpmn:sequenceFlow id="SequenceFlow-FieldTeamActionsToLogIncidentSummary-id-0062" sourceRef="SubProcess-FieldTeamActions-id-0024" targetRef="ServiceTask-LogIncidentSummary-id-0052" />
    <bpmn:sequenceFlow id="SequenceFlow-LogIncidentSummaryToIncidentResolved-id-0063" sourceRef="ServiceTask-LogIncidentSummary-id-0052" targetRef="EndEvent-IncidentResolved-id-0053" />
  </bpmn:process>
  <bpmn:error id="FIX_FAILED" name="FIX_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process-NetworkIncidentResolution-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Process-NetworkIncidentResolution-id-0001" bpmnElement="Process-NetworkIncidentResolution-id-0001">
      <bpmndi:BPMNShape id="StartEvent-NetworkMonitoringAlert-id-0001_di" bpmnElement="StartEvent-NetworkMonitoringAlert-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AnalyzeAffectedTowers-id-0002_di" bpmnElement="ServiceTask-AnalyzeAffectedTowers-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CalculateCustomerImpact-id-0003_di" bpmnElement="ServiceTask-CalculateCustomerImpact-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RerouteTraffic-id-0004_di" bpmnElement="ServiceTask-RerouteTraffic-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendIncidentAlert-id-0005_di" bpmnElement="SendTask-SendIncidentAlert-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DispatchFieldEngineers-id-0006_di" bpmnElement="ServiceTask-DispatchFieldEngineers-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-RootCauseAnalysis-id-0007_di" bpmnElement="SubProcess-RootCauseAnalysis-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent-TimerBoundary-id-0023_di" bpmnElement="IntermediateCatchEvent-TimerBoundary-id-0023">
        <dc:Bounds x="1107" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-FieldTeamActions-id-0024_di" bpmnElement="SubProcess-FieldTeamActions-id-0024">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-LogIncidentSummary-id-0052_di" bpmnElement="ServiceTask-LogIncidentSummary-id-0052">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-IncidentResolved-id-0053_di" bpmnElement="EndEvent-IncidentResolved-id-0053">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToAnalyzeAffectedTowers-id-0054_di" bpmnElement="SequenceFlow-StartToAnalyzeAffectedTowers-id-0054">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalyzeAffectedTowersToCalculateCustomerImpact-id-0055_di" bpmnElement="SequenceFlow-AnalyzeAffectedTowersToCalculateCustomerImpact-id-0055">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CalculateCustomerImpactToRerouteTraffic-id-0056_di" bpmnElement="SequenceFlow-CalculateCustomerImpactToRerouteTraffic-id-0056">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RerouteTrafficToSendIncidentAlert-id-0057_di" bpmnElement="SequenceFlow-RerouteTrafficToSendIncidentAlert-id-0057">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendIncidentAlertToDispatchFieldEngineers-id-0058_di" bpmnElement="SequenceFlow-SendIncidentAlertToDispatchFieldEngineers-id-0058">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DispatchFieldEngineersToRootCauseAnalysis-id-0059_di" bpmnElement="SequenceFlow-DispatchFieldEngineersToRootCauseAnalysis-id-0059">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RootCauseAnalysisToTimerBoundary-id-0060_di" bpmnElement="SequenceFlow-RootCauseAnalysisToTimerBoundary-id-0060">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1107" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TimerBoundaryToFieldTeamActions-id-0061_di" bpmnElement="SequenceFlow-TimerBoundaryToFieldTeamActions-id-0061">
        <di:waypoint x="1143" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FieldTeamActionsToLogIncidentSummary-id-0062_di" bpmnElement="SequenceFlow-FieldTeamActionsToLogIncidentSummary-id-0062">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LogIncidentSummaryToIncidentResolved-id-0063_di" bpmnElement="SequenceFlow-LogIncidentSummaryToIncidentResolved-id-0063">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1557" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-FieldTeamActions-id-0024">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-FieldTeamActions-id-0024" bpmnElement="SubProcess-FieldTeamActions-id-0024">
      <bpmndi:BPMNShape id="StartEvent-FieldTeamActionsStart-id-0025_di" bpmnElement="StartEvent-FieldTeamActionsStart-id-0025">
