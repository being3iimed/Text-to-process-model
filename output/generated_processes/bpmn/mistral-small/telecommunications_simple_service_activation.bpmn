<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="empty-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Customer-Onboarding-Process-id-0001" name="Customer Onboarding Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CustomerSignsUp-id-0001" name="Customer Signs Up">
      <bpmn:outgoing>SequenceFlow-StartToSelectPlan-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CustomerSelectsPlanAndPhone-id-0001" name="Customer Selects Plan and Phone">
      <bpmn:incoming>SequenceFlow-StartToSelectPlan-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToCreateAccount-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CreateAccount-id-0001" name="Create Account">
      <bpmn:incoming>SequenceFlow-SelectToCreateAccount-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateToAssignNumber-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AssignPhoneNumber-id-0001" name="Assign Phone Number">
      <bpmn:incoming>SequenceFlow-CreateToAssignNumber-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignToActivateSIM-id-0004</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ActivateSIMCard-id-0001" name="Activate SIM Card">
      <bpmn:incoming>SequenceFlow-AssignToActivateSIM-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ActivateToSendSMS-id-0005</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendWelcomeSMS-id-0001" name="Send Welcome SMS">
      <bpmn:incoming>SequenceFlow-ActivateToSendSMS-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToEnd-id-0006</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ServiceReady-id-0001" name="Service Ready">
      <bpmn:incoming>SequenceFlow-SendToEnd-id-0006</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSelectPlan-id-0001" sourceRef="StartEvent-CustomerSignsUp-id-0001" targetRef="UserTask-CustomerSelectsPlanAndPhone-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToCreateAccount-id-0002" sourceRef="UserTask-CustomerSelectsPlanAndPhone-id-0001" targetRef="ServiceTask-CreateAccount-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateToAssignNumber-id-0003" sourceRef="ServiceTask-CreateAccount-id-0001" targetRef="ServiceTask-AssignPhoneNumber-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AssignToActivateSIM-id-0004" sourceRef="ServiceTask-AssignPhoneNumber-id-0001" targetRef="ServiceTask-ActivateSIMCard-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ActivateToSendSMS-id-0005" sourceRef="ServiceTask-ActivateSIMCard-id-0001" targetRef="SendTask-SendWelcomeSMS-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToEnd-id-0006" sourceRef="SendTask-SendWelcomeSMS-id-0001" targetRef="EndEvent-ServiceReady-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Customer-Onboarding-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Customer-Onboarding-Process-id-0001" bpmnElement="Customer-Onboarding-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-CustomerSignsUp-id-0001_di" bpmnElement="StartEvent-CustomerSignsUp-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CustomerSelectsPlanAndPhone-id-0001_di" bpmnElement="UserTask-CustomerSelectsPlanAndPhone-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CreateAccount-id-0001_di" bpmnElement="ServiceTask-CreateAccount-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AssignPhoneNumber-id-0001_di" bpmnElement="ServiceTask-AssignPhoneNumber-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ActivateSIMCard-id-0001_di" bpmnElement="ServiceTask-ActivateSIMCard-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendWelcomeSMS-id-0001_di" bpmnElement="SendTask-SendWelcomeSMS-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ServiceReady-id-0001_di" bpmnElement="EndEvent-ServiceReady-id-0001">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSelectPlan-id-0001_di" bpmnElement="SequenceFlow-StartToSelectPlan-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectToCreateAccount-id-0002_di" bpmnElement="SequenceFlow-SelectToCreateAccount-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CreateToAssignNumber-id-0003_di" bpmnElement="SequenceFlow-CreateToAssignNumber-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssignToActivateSIM-id-0004_di" bpmnElement="SequenceFlow-AssignToActivateSIM-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ActivateToSendSMS-id-0005_di" bpmnElement="SequenceFlow-ActivateToSendSMS-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendToEnd-id-0006_di" bpmnElement="SequenceFlow-SendToEnd-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
