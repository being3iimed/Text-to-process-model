<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WeddingEventProcess-Definitions-id-0001" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="2.0">
  <bpmn:process id="WeddingEventProcess-id-0001" name="Wedding Event Coordination Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-WeddingContractSigned-id-0001" name="Wedding Contract Signed">
      <bpmn:outgoing>SequenceFlow-ContractToSign-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-SignContract-id-0001" name="Sign Contract">
      <bpmn:incoming>SequenceFlow-ContractToSign-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SignToCeremonyTime-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConfirmCeremonyTime-id-0002" name="Confirm Ceremony Time">
      <bpmn:incoming>SequenceFlow-SignToCeremonyTime-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CeremonyTimeToPlanningSplit-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-InitialPlanningSplit-id-0001" name="Initial Planning Parallel Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CeremonyTimeToPlanningSplit-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PlanningSplitToGuestCount-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PlanningSplitToGuestRooms-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PlanningSplitToMenuItems-id-0006</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-FinalizeGuestCount-id-0003" name="Finalize Guest Count">
      <bpmn:incoming>SequenceFlow-PlanningSplitToGuestCount-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GuestCountToPlanningJoin-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AssignGuestRooms-id-0004" name="Assign Guest Rooms">
      <bpmn:incoming>SequenceFlow-PlanningSplitToGuestRooms-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GuestRoomsToPlanningJoin-id-0016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectMenuItems-id-0005" name="Select Menu Items">
      <bpmn:incoming>SequenceFlow-PlanningSplitToMenuItems-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MenuItemsToDietary-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DietaryRestrictions-id-0001" name="Dietary Restrictions?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-MenuItemsToDietary-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DietaryToSpecify-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DietaryToNoRestrictions-id-0009</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-SpecifyDietaryRestrictions-id-0006" name="Specify Dietary Restrictions">
      <bpmn:incoming>SequenceFlow-DietaryToSpecify-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SpecifyToDietaryMerge-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-NoRestrictionsNote-id-0001" name="Note: no restrictions">
      <bpmn:incoming>SequenceFlow-DietaryToNoRestrictions-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NoRestrictionsToDietaryMerge-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-DietaryMerge-id-0001" name="Dietary Restrictions Merge" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-SpecifyToDietaryMerge-id-0010</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NoRestrictionsToDietaryMerge-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DietaryMergeToBeverage-id-0012</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-ChooseBeverageSelections-id-0007" name="Choose Beverage Selections">
      <bpmn:incoming>SequenceFlow-DietaryMergeToBeverage-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BeverageToMusic-id-0013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ArrangeMusicDJ-id-0008" name="Arrange Music/DJ">
      <bpmn:incoming>SequenceFlow-BeverageToMusic-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MusicToPlanningJoin-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-InitialPlanningJoin-id-0002" name="Initial Planning Parallel Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-MusicToPlanningJoin-id-0014</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-GuestCountToPlanningJoin-id-0015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-GuestRoomsToPlanningJoin-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PlanningJoinToThreeMonths-id-0017</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:startEvent id="StartEvent-ThreeMonthsBefore-id-0002" name="3 Months Before Event">
      <bpmn:incoming>SequenceFlow-PlanningJoinToThreeMonths-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ThreeMonthsToTimeline-id-0018</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CreateMasterTimeline-id-0009" name="Coordinator Creates Master Timeline">
      <bpmn:incoming>SequenceFlow-ThreeMonthsToTimeline-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TimelineToDistribute-id-0019</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-DistributeTimeline-id-0002" name="Distribute to Departments">
      <bpmn:incoming>SequenceFlow-TimelineToDistribute-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DistributeToTwoWeeks-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent-TwoWeeksBefore-id-0003" name="2 Weeks Before Event">
      <bpmn:incoming>SequenceFlow-DistributeToTwoWeeks-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TwoWeeksToHeadcount-id-0021</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-FinalHeadcountConfirmation-id-0010" name="Final Headcount Confirmation">
      <bpmn:incoming>SequenceFlow-TwoWeeksToHeadcount-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HeadcountToRoomBlock-id-0022</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-HeadcountToBoundary-id-0055</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent-HeadcountTimeout-id-0001" name="4 Hour SLA Exceeded" attachedToRef="UserTask-FinalHeadcountConfirmation-id-0010">
      <bpmn:incoming>SequenceFlow-HeadcountToBoundary-id-0055</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BoundaryToLateFee-id-0056</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-HeadcountTimeout-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-LateFeeNotification-id-0001" name="Send: late fee notification">
      <bpmn:incoming>SequenceFlow-BoundaryToLateFee-id-0056</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LateFeeToRoomBlock-id-0057</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-RoomBlockFinalization-id-0011" name="Room Block Finalization">
      <bpmn:incoming>SequenceFlow-HeadcountToRoomBlock-id-0022</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-LateFeeToRoomBlock-id-0057</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RoomBlockToDietaryList-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DietaryRestrictionsListFinalized-id-0012" name="Dietary Restrictions List Finalized">
      <bpmn:incoming>SequenceFlow-RoomBlockToDietaryList-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DietaryListToAVReserve-id-0024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ReserveAVEquipment-id-0003" name="Reserve AV Equipment">
      <bpmn:incoming>SequenceFlow-DietaryListToAVReserve-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AVReserveToOneWeek-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent-OneWeekBefore-id-0004" name="1 Week Before Event">
      <bpmn:incoming>SequenceFlow-AVReserveToOneWeek-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OneWeekToWalkthrough-id-0026</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-FacilityWalkthrough-id-0013" name="Facility Walkthrough">
      <bpmn:incoming>SequenceFlow-OneWeekToWalkthrough-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WalkthroughToSeating-id-0027</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-WalkthroughToBoundary-id-0058</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent-WalkthroughTimeout-id-0002" name="24 Hour SLA Exceeded" attachedToRef="UserTask-FacilityWalkthrough-id-0013">
      <bpmn:incoming>SequenceFlow-WalkthroughToBoundary-id-0058</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WalkthroughBoundaryToAlert-id-0059</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-WalkthroughTimeout-id-0002_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-WalkthroughOverdueAlert-id-0002" name="Send: walkthrough overdue alert">
      <bpmn:incoming>SequenceFlow-WalkthroughBoundaryToAlert-id-0059</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AlertToSeating-id-0060</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-FinalizeSeatingChart-id-0014" name="Finalize Seating Chart">
      <bpmn:incoming>SequenceFlow-WalkthroughToSeating-id-0027</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AlertToSeating-id-0060</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SeatingToNamePlacards-id-0028</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-PrepareNamePlacards-id-0004" name="Prepare Name Placards">
      <bpmn:incoming>SequenceFlow-SeatingToNamePlacards-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NamePlacardsToAlcoholCalc-id-0029</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="ScriptTask-CalculateAlcoholQuantities-id-0001" name="Computation: calculate alcohol quantities by guest count">
      <bpmn:incoming>SequenceFlow-NamePlacardsToAlcoholCalc-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AlcoholCalcToDayOf-id-0030</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:startEvent id="StartEvent-DayOfEvent-id-0005" name="Day of Event - 8:00 AM">
      <bpmn:incoming>SequenceFlow-AlcoholCalcToDayOf-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DayOfToMorningSetup-id-0031</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-MorningSetup-id-0005" name="Morning Setup">
      <bpmn:incoming>SequenceFlow-DayOfToMorningSetup-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MorningSetupToSplit-id-0032</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-MorningSetupSplit-id-0003" name="Morning Setup Parallel Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-MorningSetupToSplit-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToCeremonyRoom-id-0033</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToReceptionTables-id-0034</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-ArrangeCeremonyRoom-id-0006" name="Arrange Ceremony Room">
      <bpmn:incoming>SequenceFlow-SplitToCeremonyRoom-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CeremonyRoomToJoin-id-0035</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ArrangeReceptionTables-id-0007" name="Arrange Reception Tables">
      <bpmn:incoming>SequenceFlow-SplitToReceptionTables-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceptionTablesToJoin-id-0036</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-MorningSetupJoin-id-0004" name="Morning Setup Parallel Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-CeremonyRoomToJoin-id-0035</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReceptionTablesToJoin-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToAVTest-id-0037</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-AVEquipmentTest-id-0008" name="AV Equipment Test">
      <bpmn:incoming>SequenceFlow-JoinToAVTest-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AVTestToCeremonyBuffer-id-0038</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-CeremonyBuffer-id-0001" name="Ceremony Buffer">
      <bpmn:incoming>SequenceFlow-AVTestToCeremonyBuffer-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CeremonyBufferToCheckin-id-0039</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UserTask-GuestCheckinProcessing-id-0015" name="Guest Check-in Processing">
      <bpmn:incoming>SequenceFlow-CeremonyBufferToCheckin-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckinToCeremony-id-0040</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConductCeremony-id-0016" name="Conduct Ceremony">
      <bpmn:incoming>SequenceFlow-CheckinToCeremony-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CeremonyToCatering-id-0041</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CeremonyToWeddingComplete-id-0068</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SubProcess-CateringPreparation-id-0001" name="Catering Preparation">
      <bpmn:incoming>SequenceFlow-CeremonyToCatering-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CateringToBar-id-0042</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-KitchenPrepBegins-id-0006" name="Kitchen Prep Begins">
        <bpmn:outgoing>SequenceFlow-KitchenPrepToSchedule-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-FinalizeCookingSchedule-id-0009" name="Finalize Cooking Schedule">
        <bpmn:incoming>SequenceFlow-KitchenPrepToSchedule-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ScheduleToColdPrep-id-0002</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-PrepColdItems-id-0010" name="Prep Cold Items">
        <bpmn:incoming>SequenceFlow-ScheduleToColdPrep-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ColdPrepToPlating-id-0003</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CoordinatePlating-id-0011" name="Coordinate Plating">
        <bpmn:incoming>SequenceFlow-ColdPrepToPlating-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PlatingToBuffet-id-0004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-SetUpBuffetStations-id-0012" name="Set Up Buffet Stations">
        <bpmn:incoming>SequenceFlow-PlatingToBuffet-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BuffetToExecute-id-0005</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-ExecuteServiceTimeline-id-0013" name="Execute Service Timeline">
        <bpmn:incoming>SequenceFlow-BuffetToExecute-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ExecuteToComplete-id-0006</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-CateringServiceComplete-id-0002" name="Catering Service Complete">
        <bpmn:incoming>SequenceFlow-ExecuteToComplete-id-0006</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-KitchenPrepToSchedule-id-0001" sourceRef="StartEvent-KitchenPrepBegins-id-0006" targetRef="ServiceTask-FinalizeCookingSchedule-id-0009" />
      <bpmn:sequenceFlow id="SequenceFlow-ScheduleToColdPrep-id-0002" sourceRef="ServiceTask-FinalizeCookingSchedule-id-0009" targetRef="ServiceTask-PrepColdItems-id-0010" />
      <bpmn:sequenceFlow id="SequenceFlow-ColdPrepToPlating-id-0003" sourceRef="ServiceTask-PrepColdItems-id-0010" targetRef="ServiceTask-CoordinatePlating-id-0011" />
      <bpmn:sequenceFlow id="SequenceFlow-PlatingToBuffet-id-0004" sourceRef="ServiceTask-CoordinatePlating-id-0011" targetRef="ServiceTask-SetUpBuffetStations-id-0012" />
      <bpmn:sequenceFlow id="SequenceFlow-BuffetToExecute-id-0005" sourceRef="ServiceTask-SetUpBuffetStations-id-0012" targetRef="ServiceTask-ExecuteServiceTimeline-id-0013" />
      <bpmn:sequenceFlow id="SequenceFlow-ExecuteToComplete-id-0006" sourceRef="ServiceTask-ExecuteServiceTimeline-id-0013" targetRef="EndEvent-CateringServiceComplete-id-0002" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-BarServiceOperation-id-0002" name="Bar Service Operation">
      <bpmn:incoming>SequenceFlow-CateringToBar-id-0042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BarToDancing-id-0043</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-BarSetupBegins-id-0007" name="Bar Setup Begins">
        <bpmn:outgoing>SequenceFlow-BarSetupToInventory-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-InventoryVerification-id-0014" name="Inventory Verification">
        <bpmn:incoming>SequenceFlow-BarSetupToInventory-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-InventoryToBriefing-id-0002</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-StaffBriefing-id-0015" name="Staff Briefing">
        <bpmn:incoming>SequenceFlow-InventoryToBriefing-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BriefingToOpen-id-0003</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-OpenBarService-id-0016" name="Open Bar Service">
        <bpmn:incoming>SequenceFlow-BriefingToOpen-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-OpenToMonitor-id-0004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-MonitorConsumption-id-0017" name="Monitor Consumption">
        <bpmn:incoming>SequenceFlow-OpenToMonitor-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MonitorToClose-id-0005</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CloseBarService-id-0018" name="Close Bar Service">
        <bpmn:incoming>SequenceFlow-MonitorToClose-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CloseToComplete-id-0006</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-BarServiceComplete-id-0003" name="Bar Service Complete">
        <bpmn:incoming>SequenceFlow-CloseToComplete-id-0006</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-BarSetupToInventory-id-0001" sourceRef="StartEvent-BarSetupBegins-id-0007" targetRef="ServiceTask-InventoryVerification-id-0014" />
      <bpmn:sequenceFlow id="SequenceFlow-InventoryToBriefing-id-0002" sourceRef="ServiceTask-InventoryVerification-id-0014" targetRef="ServiceTask-StaffBriefing-id-0015" />
      <bpmn:sequenceFlow id="SequenceFlow-BriefingToOpen-id-0003" sourceRef="ServiceTask-StaffBriefing-id-0015" targetRef="ServiceTask-OpenBarService-id-0016" />
      <bpmn:sequenceFlow id="SequenceFlow-OpenToMonitor-id-0004" sourceRef="ServiceTask-OpenBarService-id-0016" targetRef="ServiceTask-MonitorConsumption-id-0017" />
      <bpmn:sequenceFlow id="SequenceFlow-MonitorToClose-id-0005" sourceRef="ServiceTask-MonitorConsumption-id-0017" targetRef="ServiceTask-CloseBarService-id-0018" />
      <bpmn:sequenceFlow id="SequenceFlow-CloseToComplete-id-0006" sourceRef="ServiceTask-CloseBarService-id-0018" targetRef="EndEvent-BarServiceComplete-id-0003" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="ServiceTask-DancingEntertainment-id-0019" name="Dancing/Entertainment">
      <bpmn:incoming>SequenceFlow-BarToDancing-id-0043</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DancingToCleanupBuffer-id-0044</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-CleanupBuffer-id-0002" name="Cleanup Buffer">
      <bpmn:incoming>SequenceFlow-DancingToCleanupBuffer-id-0044</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CleanupBufferToCleanup-id-0045</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ServiceTask-PostEventCleanup-id-0020" name="Post-Event Cleanup">
      <bpmn:incoming>SequenceFlow-CleanupBufferToCleanup-id-0045</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CleanupToSplit-id-0046</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-CleanupSplit-id-0005" name="Cleanup Parallel Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CleanupToSplit-id-0046</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CleanupSplitToRemove-id-0047</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CleanupSplitToReset-id-0048</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-RemoveFurniture-id-0021" name="Remove Furniture">
      <bpmn:incoming>SequenceFlow-CleanupSplitToRemove-id-0047</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RemoveToJoin-id-0049</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ResetFacility-id-0022" name="Reset Facility">
      <bpmn:incoming>SequenceFlow-CleanupSplitToReset-id-0048</bpmn:incoming>
