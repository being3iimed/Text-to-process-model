<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Customer-Signup-Activation-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="2.0.0">
  <bpmn:process id="Customer-Signup-Activation-Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CustomerSignupInitiated-id-0001" name="Customer Signup Initiated">
      <bpmn:outgoing>SequenceFlow-StartToCustomerSelectsPlan-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CustomerSelectsPlanAndPhone-id-0001" name="Customer Selects Plan and Phone">
      <bpmn:incoming>SequenceFlow-StartToCustomerSelectsPlan-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerSelectsPlanToCreateAccount-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CreateCustomerAccount-id-0001" name="Create Customer Account">
      <bpmn:incoming>SequenceFlow-CustomerSelectsPlanToCreateAccount-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateAccountToAssignNumber-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AssignPhoneNumber-id-0001" name="Assign Phone Number">
      <bpmn:incoming>SequenceFlow-CreateAccountToAssignNumber-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignNumberToActivateSIM-id-0004</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ActivateSIMOnNetwork-id-0001" name="Activate SIM on Network">
      <bpmn:incoming>SequenceFlow-AssignNumberToActivateSIM-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ActivateSIMToSendSMS-id-0005</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendWelcomeSMS-id-0001" name="Send: Welcome SMS">
      <bpmn:incoming>SequenceFlow-ActivateSIMToSendSMS-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendSMSToEnd-id-0006</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ServiceActivationComplete-id-0001" name="Service Activation Complete">
      <bpmn:incoming>SequenceFlow-SendSMSToEnd-id-0006</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCustomerSelectsPlan-id-0001" sourceRef="StartEvent-CustomerSignupInitiated-id-0001" targetRef="UserTask-CustomerSelectsPlanAndPhone-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerSelectsPlanToCreateAccount-id-0002" sourceRef="UserTask-CustomerSelectsPlanAndPhone-id-0001" targetRef="ServiceTask-CreateCustomerAccount-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateAccountToAssignNumber-id-0003" sourceRef="ServiceTask-CreateCustomerAccount-id-0001" targetRef="ServiceTask-AssignPhoneNumber-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AssignNumberToActivateSIM-id-0004" sourceRef="ServiceTask-AssignPhoneNumber-id-0001" targetRef="ServiceTask-ActivateSIMOnNetwork-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ActivateSIMToSendSMS-id-0005" sourceRef="ServiceTask-ActivateSIMOnNetwork-id-0001" targetRef="SendTask-SendWelcomeSMS-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendSMSToEnd-id-0006" sourceRef="SendTask-SendWelcomeSMS-id-0001" targetRef="EndEvent-ServiceActivationComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Customer-Signup-Activation-Process">
    <bpmndi:BPMNPlane id="BPMNPlane_Customer-Signup-Activation-Process" bpmnElement="Customer-Signup-Activation-Process">
      <bpmndi:BPMNShape id="StartEvent-CustomerSignupInitiated-id-0001_di" bpmnElement="StartEvent-CustomerSignupInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CustomerSelectsPlanAndPhone-id-0001_di" bpmnElement="UserTask-CustomerSelectsPlanAndPhone-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CreateCustomerAccount-id-0001_di" bpmnElement="ServiceTask-CreateCustomerAccount-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AssignPhoneNumber-id-0001_di" bpmnElement="ServiceTask-AssignPhoneNumber-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ActivateSIMOnNetwork-id-0001_di" bpmnElement="ServiceTask-ActivateSIMOnNetwork-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendWelcomeSMS-id-0001_di" bpmnElement="SendTask-SendWelcomeSMS-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ServiceActivationComplete-id-0001_di" bpmnElement="EndEvent-ServiceActivationComplete-id-0001">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCustomerSelectsPlan-id-0001_di" bpmnElement="SequenceFlow-StartToCustomerSelectsPlan-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CustomerSelectsPlanToCreateAccount-id-0002_di" bpmnElement="SequenceFlow-CustomerSelectsPlanToCreateAccount-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CreateAccountToAssignNumber-id-0003_di" bpmnElement="SequenceFlow-CreateAccountToAssignNumber-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssignNumberToActivateSIM-id-0004_di" bpmnElement="SequenceFlow-AssignNumberToActivateSIM-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ActivateSIMToSendSMS-id-0005_di" bpmnElement="SequenceFlow-ActivateSIMToSendSMS-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendSMSToEnd-id-0006_di" bpmnElement="SequenceFlow-SendSMSToEnd-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
