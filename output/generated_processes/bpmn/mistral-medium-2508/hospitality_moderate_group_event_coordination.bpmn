<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ConferencePlanningDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="ConferencePlanningProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ConferenceRequestReceived-id-0001" name="Conference Request Received">
      <bpmn:outgoing>SequenceFlow-StartToConfirmDates-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ConfirmDatesAndRoomAvailability-id-0001" name="Confirm Dates and Room Availability">
      <bpmn:incoming>SequenceFlow-StartToConfirmDates-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConfirmDatesToCalculateRequirements-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CalculateRoomSetupRequirements-id-0001" name="Calculate Room Setup Requirements">
      <bpmn:incoming>SequenceFlow-ConfirmDatesToCalculateRequirements-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateRequirementsToSendDetails-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendEventDetailstoCatering-id-0001" name="Send: Event Details to Catering">
      <bpmn:incoming>SequenceFlow-CalculateRequirementsToSendDetails-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendDetailsToClientApproval-id-0004</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-ClientApprovesMenuandHeadcount-id-0001" name="Client Approves Menu and Headcount">
      <bpmn:incoming>SequenceFlow-SendDetailsToClientApproval-id-0004</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-RevisionRequestToClientApproval-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ClientApprovalToDecisionGateway-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ClientApprovalToDecisionJoin-id-0020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ClientApprovalDecision-id-0001" name="Client Approval Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ClientApprovalToDecisionGateway-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalDecisionToCateringPrep-id-0006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ApprovalDecisionToRevisionRequest-id-0007</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-SendMenuRevisionRequest-id-0001" name="Send: Menu Revision Request">
      <bpmn:incoming>SequenceFlow-ApprovalDecisionToRevisionRequest-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RevisionRequestToClientApproval-id-0008</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:subProcess id="SubProcess-CateringPreparation-id-0001" name="Catering Preparation">
      <bpmn:incoming>SequenceFlow-ApprovalDecisionToCateringPrep-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CateringPrepToDayOfExecution-id-0009</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CateringPrepToDecisionJoin-id-0021</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-CateringPrepStart-id-0001" name="Catering Prep Start">
        <bpmn:outgoing>SequenceFlow-CateringPrepStartToPrepareFood-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-CateringPreparesFood-id-0001" name="Catering Prepares Food">
        <bpmn:incoming>SequenceFlow-CateringPrepStartToPrepareFood-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CateringPrepareFoodToStoreFood-id-0002</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CateringStoresFood-id-0001" name="Catering Stores Food">
        <bpmn:incoming>SequenceFlow-CateringPrepareFoodToStoreFood-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CateringStoreFoodToPrepareSupplies-id-0003</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CateringPreparesServingSupplies-id-0001" name="Catering Prepares Serving Supplies">
        <bpmn:incoming>SequenceFlow-CateringStoreFoodToPrepareSupplies-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CateringPrepareSuppliesToPrepComplete-id-0004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-CateringPrepComplete-id-0001" name="Catering Prep Complete">
        <bpmn:incoming>SequenceFlow-CateringPrepareSuppliesToPrepComplete-id-0004</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-CateringPrepStartToPrepareFood-id-0001" sourceRef="StartEvent-CateringPrepStart-id-0001" targetRef="ServiceTask-CateringPreparesFood-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CateringPrepareFoodToStoreFood-id-0002" sourceRef="ServiceTask-CateringPreparesFood-id-0001" targetRef="ServiceTask-CateringStoresFood-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CateringStoreFoodToPrepareSupplies-id-0003" sourceRef="ServiceTask-CateringStoresFood-id-0001" targetRef="ServiceTask-CateringPreparesServingSupplies-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CateringPrepareSuppliesToPrepComplete-id-0004" sourceRef="ServiceTask-CateringPreparesServingSupplies-id-0001" targetRef="EndEvent-CateringPrepComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="ParallelGateway-DayOfExecutionSplit-id-0001" name="Day-of Execution Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CateringPrepToDayOfExecution-id-0009</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DecisionJoinToDayOfExecution-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DayOfExecutionToHousekeepingSetup-id-0010</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DayOfExecutionToITTestAV-id-0011</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DayOfExecutionToCateringDeliver-id-0012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DayOfExecutionToCateringSetup-id-0013</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-HousekeepingSetsUpRoom-id-0001" name="Housekeeping Sets Up Room">
      <bpmn:incoming>SequenceFlow-DayOfExecutionToHousekeepingSetup-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HousekeepingSetupToExecutionJoin-id-0014</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ITTestsAVEquipment-id-0001" name="IT Tests AV Equipment">
      <bpmn:incoming>SequenceFlow-DayOfExecutionToITTestAV-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ITTestAVToExecutionJoin-id-0015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CateringDeliversFood-id-0001" name="Catering Delivers Food">
      <bpmn:incoming>SequenceFlow-DayOfExecutionToCateringDeliver-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CateringDeliverToExecutionJoin-id-0016</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CateringSetsUpBuffet-id-0001" name="Catering Sets Up Buffet">
      <bpmn:incoming>SequenceFlow-DayOfExecutionToCateringSetup-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CateringSetupToExecutionJoin-id-0017</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-DayOfExecutionJoin-id-0002" name="Day-of Execution Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-HousekeepingSetupToExecutionJoin-id-0014</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ITTestAVToExecutionJoin-id-0015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CateringDeliverToExecutionJoin-id-0016</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CateringSetupToExecutionJoin-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExecutionJoinToHousekeepingBreakdown-id-0018</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-HousekeepingBreaksDownSetup-id-0001" name="Housekeeping Breaks Down Setup">
      <bpmn:incoming>SequenceFlow-ExecutionJoinToHousekeepingBreakdown-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HousekeepingBreakdownToEnd-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-RoomRestoredtoStandard-id-0001" name="Room Restored to Standard">
      <bpmn:incoming>SequenceFlow-HousekeepingBreakdownToEnd-id-0019</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ClientApprovalDecisionJoin-id-0002" name="Client Approval Decision Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ClientApprovalToDecisionJoin-id-0020</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CateringPrepToDecisionJoin-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DecisionJoinToDayOfExecution-id-0022</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow-StartToConfirmDates-id-0001" sourceRef="StartEvent-ConferenceRequestReceived-id-0001" targetRef="UserTask-ConfirmDatesAndRoomAvailability-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ConfirmDatesToCalculateRequirements-id-0002" sourceRef="UserTask-ConfirmDatesAndRoomAvailability-id-0001" targetRef="ServiceTask-CalculateRoomSetupRequirements-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateRequirementsToSendDetails-id-0003" sourceRef="ServiceTask-CalculateRoomSetupRequirements-id-0001" targetRef="SendTask-SendEventDetailstoCatering-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendDetailsToClientApproval-id-0004" sourceRef="SendTask-SendEventDetailstoCatering-id-0001" targetRef="UserTask-ClientApprovesMenuandHeadcount-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ClientApprovalToDecisionGateway-id-0005" sourceRef="UserTask-ClientApprovesMenuandHeadcount-id-0001" targetRef="ExclusiveGateway-ClientApprovalDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalDecisionToCateringPrep-id-0006" name="approval == &#34;approved&#34;" sourceRef="ExclusiveGateway-ClientApprovalDecision-id-0001" targetRef="SubProcess-CateringPreparation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalDecisionToRevisionRequest-id-0007" name="approval == &#34;revision needed&#34;" sourceRef="ExclusiveGateway-ClientApprovalDecision-id-0001" targetRef="SendTask-SendMenuRevisionRequest-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RevisionRequestToClientApproval-id-0008" sourceRef="SendTask-SendMenuRevisionRequest-id-0001" targetRef="UserTask-ClientApprovesMenuandHeadcount-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CateringPrepToDayOfExecution-id-0009" sourceRef="SubProcess-CateringPreparation-id-0001" targetRef="ParallelGateway-DayOfExecutionSplit-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DayOfExecutionToHousekeepingSetup-id-0010" sourceRef="ParallelGateway-DayOfExecutionSplit-id-0001" targetRef="ServiceTask-HousekeepingSetsUpRoom-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DayOfExecutionToITTestAV-id-0011" sourceRef="ParallelGateway-DayOfExecutionSplit-id-0001" targetRef="ServiceTask-ITTestsAVEquipment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DayOfExecutionToCateringDeliver-id-0012" sourceRef="ParallelGateway-DayOfExecutionSplit-id-0001" targetRef="ServiceTask-CateringDeliversFood-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DayOfExecutionToCateringSetup-id-0013" sourceRef="ParallelGateway-DayOfExecutionSplit-id-0001" targetRef="ServiceTask-CateringSetsUpBuffet-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-HousekeepingSetupToExecutionJoin-id-0014" sourceRef="ServiceTask-HousekeepingSetsUpRoom-id-0001" targetRef="ParallelGateway-DayOfExecutionJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ITTestAVToExecutionJoin-id-0015" sourceRef="ServiceTask-ITTestsAVEquipment-id-0001" targetRef="ParallelGateway-DayOfExecutionJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CateringDeliverToExecutionJoin-id-0016" sourceRef="ServiceTask-CateringDeliversFood-id-0001" targetRef="ParallelGateway-DayOfExecutionJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CateringSetupToExecutionJoin-id-0017" sourceRef="ServiceTask-CateringSetsUpBuffet-id-0001" targetRef="ParallelGateway-DayOfExecutionJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ExecutionJoinToHousekeepingBreakdown-id-0018" sourceRef="ParallelGateway-DayOfExecutionJoin-id-0002" targetRef="ServiceTask-HousekeepingBreaksDownSetup-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-HousekeepingBreakdownToEnd-id-0019" sourceRef="ServiceTask-HousekeepingBreaksDownSetup-id-0001" targetRef="EndEvent-RoomRestoredtoStandard-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ClientApprovalToDecisionJoin-id-0020" sourceRef="UserTask-ClientApprovesMenuandHeadcount-id-0001" targetRef="ExclusiveGateway-ClientApprovalDecisionJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CateringPrepToDecisionJoin-id-0021" sourceRef="SubProcess-CateringPreparation-id-0001" targetRef="ExclusiveGateway-ClientApprovalDecisionJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DecisionJoinToDayOfExecution-id-0022" sourceRef="ExclusiveGateway-ClientApprovalDecisionJoin-id-0002" targetRef="ParallelGateway-DayOfExecutionSplit-id-0001" />
  </bpmn:process>
