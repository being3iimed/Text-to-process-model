{
  "$type": "bpmn:Definitions",
  "id": "MobileServiceSignup-definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "MobileServiceSignup-Process-id-0001",
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-CustomerSignsUp-id-0001",
          "name": "Customer signs up for mobile service"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-SelectPlanAndPhone-id-0002",
          "name": "Customer selects plan and phone"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CreateAccount-id-0003",
          "name": "System creates account and assigns phone number"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ActivateSIM-id-0004",
          "name": "SIM card is activated on network"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-WelcomeSMS-id-0005",
          "name": "Welcome SMS is sent"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ServiceReady-id-0006",
          "name": "Customer can immediately use service"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToSelect-id-0007",
          "sourceRef": "StartEvent-CustomerSignsUp-id-0001",
          "targetRef": "UserTask-SelectPlanAndPhone-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SelectToCreate-id-0008",
          "sourceRef": "UserTask-SelectPlanAndPhone-id-0002",
          "targetRef": "ServiceTask-CreateAccount-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CreateToActivate-id-0009",
          "sourceRef": "ServiceTask-CreateAccount-id-0003",
          "targetRef": "ServiceTask-ActivateSIM-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ActivateToSend-id-0010",
          "sourceRef": "ServiceTask-ActivateSIM-id-0004",
          "targetRef": "SendTask-WelcomeSMS-id-0005"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SendToEnd-id-0011",
          "sourceRef": "SendTask-WelcomeSMS-id-0005",
          "targetRef": "EndEvent-ServiceReady-id-0006"
        }
      ],
      "isExecutable": true
    }
  ]
}