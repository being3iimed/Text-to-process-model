{
  "$type": "bpmn:Definitions",
  "id": "Graduation-Process-Definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Graduation-Process-id-0001",
      "name": "Graduation Process",
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-GraduationCheckRequested-id-0001",
          "name": "Graduation Check Requested"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-StudentSubmitsGraduationRequest-id-0002",
          "name": "Student submits graduation request"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-SystemAuditsDegreeRequirements-id-0003",
          "name": "System audits degree requirements"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-RequirementsMet-id-0004",
          "name": "Requirements Met?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-SystemChecksDisciplinaryHolds-id-0005",
          "name": "System checks disciplinary holds, library fees, and visa status"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-AdditionalRequirementsMet-id-0006",
          "name": "Additional Requirements Met?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-SystemVerifiesMajorCourses-id-0007",
          "name": "System verifies completion of all major courses"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-SystemVerifiesGeneralEducation-id-0008",
          "name": "System verifies completion of all general education requirements"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-AllRequirementsMet-id-0009",
          "name": "All Requirements Met?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-GraduationApproved-id-0010",
          "name": "Graduation approved"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-DiplomaPrepared-id-0011",
          "name": "Diploma prepared"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CapAndGownOrderPlaced-id-0012",
          "name": "Cap-and-gown order placed"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-GraduationCeremonySlotAssigned-id-0013",
          "name": "Graduation ceremony slot assigned"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-StudentAttendsGraduationCeremony-id-0014",
          "name": "Student attends graduation ceremony"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-AttendanceVerified-id-0015",
          "name": "Attendance verified"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-DegreeConferred-id-0016",
          "name": "Degree conferred"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-TranscriptIssued-id-0017",
          "name": "Transcript issued"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-GraduationComplete-id-0018",
          "name": "Graduation Complete"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-GenerateDetailedReport-id-0019",
          "name": "Generate detailed report of missing requirements"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-StudentCompletesMissingRequirements-id-0020",
          "name": "Student completes missing requirements by deadline"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ReEvaluateGraduationRequirements-id-0021",
          "name": "Re-evaluate graduation requirements"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-GraduationRequirementsNotMet-id-0022",
          "name": "Graduation Requirements Not Met"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToSubmitRequest-id-0023",
          "sourceRef": "StartEvent-GraduationCheckRequested-id-0001",
          "targetRef": "UserTask-StudentSubmitsGraduationRequest-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SubmitToAudit-id-0024",
          "sourceRef": "UserTask-StudentSubmitsGraduationRequest-id-0002",
          "targetRef": "ServiceTask-SystemAuditsDegreeRequirements-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AuditToGateway-id-0025",
          "sourceRef": "ServiceTask-SystemAuditsDegreeRequirements-id-0003",
          "targetRef": "ExclusiveGateway-RequirementsMet-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-RequirementsMetToChecks-id-0026",
          "name": "all_courses_completed AND all_credits_earned >= 120 AND cumulative_GPA >= 2.0 AND major_GPA >= minimum_major_GPA",
          "sourceRef": "ExclusiveGateway-RequirementsMet-id-0004",
          "targetRef": "ServiceTask-SystemChecksDisciplinaryHolds-id-0005",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-RequirementsNotMetToReport-id-0027",
          "name": "",
          "sourceRef": "ExclusiveGateway-RequirementsMet-id-0004",
          "targetRef": "ServiceTask-GenerateDetailedReport-id-0019",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ChecksToAdditionalGateway-id-0028",
          "sourceRef": "ServiceTask-SystemChecksDisciplinaryHolds-id-0005",
          "targetRef": "ExclusiveGateway-AdditionalRequirementsMet-id-0006"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AdditionalRequirementsMetToVerification-id-0029",
          "name": "no_disciplinary_holds AND library_fees_paid AND visa_status_current",
          "sourceRef": "ExclusiveGateway-AdditionalRequirementsMet-id-0006",
          "targetRef": "ServiceTask-SystemVerifiesMajorCourses-id-0007",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AdditionalRequirementsNotMetToReport-id-0030",
          "name": "",
          "sourceRef": "ExclusiveGateway-AdditionalRequirementsMet-id-0006",
          "targetRef": "ServiceTask-GenerateDetailedReport-id-0019",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-VerifyMajorToVerifyGeneral-id-0031",
          "sourceRef": "ServiceTask-SystemVerifiesMajorCourses-id-0007",
          "targetRef": "ServiceTask-SystemVerifiesGeneralEducation-id-0008"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-VerifyGeneralToFinalGateway-id-0032",
          "sourceRef": "ServiceTask-SystemVerifiesGeneralEducation-id-0008",
          "targetRef": "ExclusiveGateway-AllRequirementsMet-id-0009"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AllRequirementsMetToApproval-id-0033",
          "name": "all_major_courses_completed AND all_general_education_requirements_completed",
          "sourceRef": "ExclusiveGateway-AllRequirementsMet-id-0009",
          "targetRef": "ServiceTask-GraduationApproved-id-0010",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AllRequirementsNotMetToReport-id-0034",
          "name": "",
          "sourceRef": "ExclusiveGateway-AllRequirementsMet-id-0009",
          "targetRef": "ServiceTask-GenerateDetailedReport-id-0019",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ApprovalToDiploma-id-0035",
          "sourceRef": "ServiceTask-GraduationApproved-id-0010",
          "targetRef": "ServiceTask-DiplomaPrepared-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-DiplomaToCapAndGown-id-0036",
          "sourceRef": "ServiceTask-DiplomaPrepared-id-0011",
          "targetRef": "ServiceTask-CapAndGownOrderPlaced-id-0012"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CapAndGownToCeremonySlot-id-0037",
          "sourceRef": "ServiceTask-CapAndGownOrderPlaced-id-0012",
          "targetRef": "ServiceTask-GraduationCeremonySlotAssigned-id-0013"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CeremonySlotToAttendCeremony-id-0038",
          "sourceRef": "ServiceTask-GraduationCeremonySlotAssigned-id-0013",
          "targetRef": "UserTask-StudentAttendsGraduationCeremony-id-0014"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AttendCeremonyToVerifyAttendance-id-0039",
          "sourceRef": "UserTask-StudentAttendsGraduationCeremony-id-0014",
          "targetRef": "ServiceTask-AttendanceVerified-id-0015"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-VerifyAttendanceToConferDegree-id-0040",
          "sourceRef": "ServiceTask-AttendanceVerified-id-0015",
          "targetRef": "ServiceTask-DegreeConferred-id-0016"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ConferDegreeToIssueTranscript-id-0041",
          "sourceRef": "ServiceTask-DegreeConferred-id-0016",
          "targetRef": "ServiceTask-TranscriptIssued-id-0017"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-IssueTranscriptToComplete-id-0042",
          "sourceRef": "ServiceTask-TranscriptIssued-id-0017",
          "targetRef": "EndEvent-GraduationComplete-id-0018"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReportToCompleteRequirements-id-0043",
          "sourceRef": "ServiceTask-GenerateDetailedReport-id-0019",
          "targetRef": "UserTask-StudentCompletesMissingRequirements-id-0020"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CompleteRequirementsToReEvaluate-id-0044",
          "sourceRef": "UserTask-StudentCompletesMissingRequirements-id-0020",
          "targetRef": "ServiceTask-ReEvaluateGraduationRequirements-id-0021"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReEvaluateToNotMet-id-0045",
          "sourceRef": "ServiceTask-ReEvaluateGraduationRequirements-id-0021",
          "targetRef": "EndEvent-GraduationRequirementsNotMet-id-0022"
        }
      ],
      "isExecutable": true
    }
  ]
}