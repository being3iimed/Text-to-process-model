{
  "$type": "bpmn:Definitions",
  "id": "course-enrollment-definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "CourseEnrollmentProcess-id-0001",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-CourseEnrollmentStarted-id-0001",
          "name": "Course Enrollment Process Started"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-SearchCourses-id-0001",
          "name": "Search for Courses"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CheckCourseDetails-id-0002",
          "name": "Check Course Details"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-CourseEligibility-id-0001",
          "name": "Course Eligibility Check",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-ConfirmEnrollment-id-0003",
          "name": "Confirm Enrollment"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ProcessEnrollment-id-0001",
          "name": "Process Enrollment"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-GenerateSchedule-id-0002",
          "name": "Generate Course Schedule"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-UpdateRoster-id-0003",
          "name": "Update Course Roster"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-EnrollmentComplete-id-0001",
          "name": "Enrollment Complete"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-EnrollmentFailed-id-0002",
          "name": "Enrollment Failed"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToSearch-id-0001",
          "sourceRef": "StartEvent-CourseEnrollmentStarted-id-0001",
          "targetRef": "UserTask-SearchCourses-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SearchToCheck-id-0002",
          "sourceRef": "UserTask-SearchCourses-id-0001",
          "targetRef": "UserTask-CheckCourseDetails-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CheckToGateway-id-0003",
          "sourceRef": "UserTask-CheckCourseDetails-id-0002",
          "targetRef": "ExclusiveGateway-CourseEligibility-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToConfirm-id-0004",
          "name": "prerequisites_met AND seats_available",
          "sourceRef": "ExclusiveGateway-CourseEligibility-id-0001",
          "targetRef": "UserTask-ConfirmEnrollment-id-0003",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToFailed-id-0005",
          "sourceRef": "ExclusiveGateway-CourseEligibility-id-0001",
          "targetRef": "EndEvent-EnrollmentFailed-id-0002",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ConfirmToProcess-id-0006",
          "sourceRef": "UserTask-ConfirmEnrollment-id-0003",
          "targetRef": "ServiceTask-ProcessEnrollment-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ProcessToGenerate-id-0007",
          "sourceRef": "ServiceTask-ProcessEnrollment-id-0001",
          "targetRef": "ServiceTask-GenerateSchedule-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GenerateToUpdate-id-0008",
          "sourceRef": "ServiceTask-GenerateSchedule-id-0002",
          "targetRef": "ServiceTask-UpdateRoster-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-UpdateToComplete-id-0009",
          "sourceRef": "ServiceTask-UpdateRoster-id-0003",
          "targetRef": "EndEvent-EnrollmentComplete-id-0001"
        }
      ]
    }
  ]
}