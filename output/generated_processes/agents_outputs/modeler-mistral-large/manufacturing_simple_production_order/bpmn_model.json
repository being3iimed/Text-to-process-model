{
  "$type": "bpmn:Definitions",
  "id": "production-process-definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "ProductionProcess-id-0001",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-ProductionProcessInitiated-id-0001",
          "name": "Production Process Initiated"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CreateWorkOrder-id-0001",
          "name": "Create Work Order"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-PullBillOfMaterials-id-0001",
          "name": "Pull Bill of Materials"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ReserveRawMaterials-id-0001",
          "name": "Reserve Raw Materials"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ScheduleProductionLine-id-0001",
          "name": "Schedule Production Line"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ManufactureComponents-id-0001",
          "name": "Manufacture Components"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-PerformQualityCheck-id-0001",
          "name": "Perform Quality Check"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-QualityCheckResult-id-0001",
          "name": "Quality Check Result",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-MoveToFinishedGoods-id-0001",
          "name": "Move to Finished Goods"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProductionCompletePassed-id-0001",
          "name": "Production Complete - Passed"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ScrapDefectiveProduct-id-0001",
          "name": "Scrap Defective Product"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-LogWaste-id-0001",
          "name": "Log Waste"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProductionCompleteFailed-id-0002",
          "name": "Production Complete - Failed"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToCreateWorkOrder-id-0001",
          "sourceRef": "StartEvent-ProductionProcessInitiated-id-0001",
          "targetRef": "UserTask-CreateWorkOrder-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CreateWorkOrderToPullBOM-id-0002",
          "sourceRef": "UserTask-CreateWorkOrder-id-0001",
          "targetRef": "ServiceTask-PullBillOfMaterials-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-PullBOMToReserveMaterials-id-0003",
          "sourceRef": "ServiceTask-PullBillOfMaterials-id-0001",
          "targetRef": "ServiceTask-ReserveRawMaterials-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReserveMaterialsToSchedule-id-0004",
          "sourceRef": "ServiceTask-ReserveRawMaterials-id-0001",
          "targetRef": "ServiceTask-ScheduleProductionLine-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ScheduleToManufacture-id-0005",
          "sourceRef": "ServiceTask-ScheduleProductionLine-id-0001",
          "targetRef": "ServiceTask-ManufactureComponents-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ManufactureToQualityCheck-id-0006",
          "sourceRef": "ServiceTask-ManufactureComponents-id-0001",
          "targetRef": "UserTask-PerformQualityCheck-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-QualityCheckToGateway-id-0007",
          "sourceRef": "UserTask-PerformQualityCheck-id-0001",
          "targetRef": "ExclusiveGateway-QualityCheckResult-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToMoveFinishedGoods-id-0008",
          "name": "quality_check == passed",
          "sourceRef": "ExclusiveGateway-QualityCheckResult-id-0001",
          "targetRef": "ServiceTask-MoveToFinishedGoods-id-0001",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-MoveFinishedGoodsToEndPassed-id-0009",
          "sourceRef": "ServiceTask-MoveToFinishedGoods-id-0001",
          "targetRef": "EndEvent-ProductionCompletePassed-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToScrapProduct-id-0010",
          "name": "quality_check == failed",
          "sourceRef": "ExclusiveGateway-QualityCheckResult-id-0001",
          "targetRef": "ServiceTask-ScrapDefectiveProduct-id-0001",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ScrapToLogWaste-id-0011",
          "sourceRef": "ServiceTask-ScrapDefectiveProduct-id-0001",
          "targetRef": "ServiceTask-LogWaste-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-LogWasteToEndFailed-id-0012",
          "sourceRef": "ServiceTask-LogWaste-id-0001",
          "targetRef": "EndEvent-ProductionCompleteFailed-id-0002"
        }
      ]
    }
  ]
}