<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BulkOrderProcessing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="BulkOrderProcess-id-0001" name="Bulk Order Processing" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ProcessBegins-id-0001" name="Process Begins">
      <bpmn:outgoing>SequenceFlow-StartToSubmit-id-0016</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ManagerSubmitsBulkOrder-id-0002" name="Manager Submits Bulk Order">
      <bpmn:incoming>SequenceFlow-StartToSubmit-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubmitToCheck-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CheckInventoryAvailability-id-0003" name="Check Inventory Availability">
      <bpmn:incoming>SequenceFlow-SubmitToCheck-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckToGateway-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AllProductsSufficient-id-0004" name="All Products Sufficient?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckToGateway-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToReserve-id-0019</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToReview-id-0022</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ReserveOrder-id-0005" name="Reserve Order">
      <bpmn:incoming>SequenceFlow-GatewayToReserve-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReserveToPacking-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-SchedulePacking-id-0006" name="Schedule Packing">
      <bpmn:incoming>SequenceFlow-ReserveToPacking-id-0020</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-WaitFullStockToPacking-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PackingToEnd-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-OrderProcessed-id-0007" name="Order Processed">
      <bpmn:incoming>SequenceFlow-PackingToEnd-id-0021</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ShipBackorderToEnd-id-0028</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-ManagerReviewsShortage-id-0008" name="Manager Reviews Shortage">
      <bpmn:incoming>SequenceFlow-GatewayToReview-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToPartialGateway-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ProceedWithPartial-id-0009" name="Proceed With Partial Shipment?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToPartialGateway-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PartialGatewayToSplit-id-0024</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PartialGatewayToHold-id-0029</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-SplitOrder-id-0010" name="Split Order">
      <bpmn:incoming>SequenceFlow-PartialGatewayToSplit-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToShipAvailable-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ShipAvailableItems-id-0011" name="Ship Available Items">
      <bpmn:incoming>SequenceFlow-SplitToShipAvailable-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ShipAvailableToWait-id-0026</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-WaitForBackorder-id-0012" name="Wait for Backorder Items">
      <bpmn:incoming>SequenceFlow-ShipAvailableToWait-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WaitToShipBackorder-id-0027</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ServiceTask-ShipBackorderItems-id-0013" name="Ship Backorder Items">
      <bpmn:incoming>SequenceFlow-WaitToShipBackorder-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ShipBackorderToEnd-id-0028</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-HoldOrder-id-0014" name="Hold Order">
      <bpmn:incoming>SequenceFlow-PartialGatewayToHold-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HoldToWaitFullStock-id-0030</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-WaitForFullStock-id-0015" name="Wait for Full Stock">
      <bpmn:incoming>SequenceFlow-HoldToWaitFullStock-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WaitFullStockToPacking-id-0031</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSubmit-id-0016" sourceRef="StartEvent-ProcessBegins-id-0001" targetRef="UserTask-ManagerSubmitsBulkOrder-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SubmitToCheck-id-0017" sourceRef="UserTask-ManagerSubmitsBulkOrder-id-0002" targetRef="ServiceTask-CheckInventoryAvailability-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckToGateway-id-0018" sourceRef="ServiceTask-CheckInventoryAvailability-id-0003" targetRef="ExclusiveGateway-AllProductsSufficient-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToReserve-id-0019" name="all products have sufficient stock" sourceRef="ExclusiveGateway-AllProductsSufficient-id-0004" targetRef="ServiceTask-ReserveOrder-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ReserveToPacking-id-0020" sourceRef="ServiceTask-ReserveOrder-id-0005" targetRef="ServiceTask-SchedulePacking-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-PackingToEnd-id-0021" sourceRef="ServiceTask-SchedulePacking-id-0006" targetRef="EndEvent-OrderProcessed-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToReview-id-0022" name="any product has insufficient stock" sourceRef="ExclusiveGateway-AllProductsSufficient-id-0004" targetRef="UserTask-ManagerReviewsShortage-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToPartialGateway-id-0023" sourceRef="UserTask-ManagerReviewsShortage-id-0008" targetRef="ExclusiveGateway-ProceedWithPartial-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-PartialGatewayToSplit-id-0024" name="proceed with partial shipment" sourceRef="ExclusiveGateway-ProceedWithPartial-id-0009" targetRef="ServiceTask-SplitOrder-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToShipAvailable-id-0025" sourceRef="ServiceTask-SplitOrder-id-0010" targetRef="ServiceTask-ShipAvailableItems-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-ShipAvailableToWait-id-0026" sourceRef="ServiceTask-ShipAvailableItems-id-0011" targetRef="IntermediateCatchEvent-WaitForBackorder-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-WaitToShipBackorder-id-0027" sourceRef="IntermediateCatchEvent-WaitForBackorder-id-0012" targetRef="ServiceTask-ShipBackorderItems-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-ShipBackorderToEnd-id-0028" sourceRef="ServiceTask-ShipBackorderItems-id-0013" targetRef="EndEvent-OrderProcessed-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-PartialGatewayToHold-id-0029" name="wait for full stock" sourceRef="ExclusiveGateway-ProceedWithPartial-id-0009" targetRef="ServiceTask-HoldOrder-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-HoldToWaitFullStock-id-0030" sourceRef="ServiceTask-HoldOrder-id-0014" targetRef="IntermediateCatchEvent-WaitForFullStock-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-WaitFullStockToPacking-id-0031" sourceRef="IntermediateCatchEvent-WaitForFullStock-id-0015" targetRef="ServiceTask-SchedulePacking-id-0006" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BulkOrderProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_BulkOrderProcess-id-0001" bpmnElement="BulkOrderProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProcessBegins-id-0001_di" bpmnElement="StartEvent-ProcessBegins-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ManagerSubmitsBulkOrder-id-0002_di" bpmnElement="UserTask-ManagerSubmitsBulkOrder-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CheckInventoryAvailability-id-0003_di" bpmnElement="ServiceTask-CheckInventoryAvailability-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-AllProductsSufficient-id-0004_di" bpmnElement="ExclusiveGateway-AllProductsSufficient-id-0004" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ReserveOrder-id-0005_di" bpmnElement="ServiceTask-ReserveOrder-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SchedulePacking-id-0006_di" bpmnElement="ServiceTask-SchedulePacking-id-0006">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-OrderProcessed-id-0007_di" bpmnElement="EndEvent-OrderProcessed-id-0007">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ManagerReviewsShortage-id-0008_di" bpmnElement="UserTask-ManagerReviewsShortage-id-0008">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ProceedWithPartial-id-0009_di" bpmnElement="ExclusiveGateway-ProceedWithPartial-id-0009" isMarkerVisible="true">
        <dc:Bounds x="800" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SplitOrder-id-0010_di" bpmnElement="ServiceTask-SplitOrder-id-0010">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ShipAvailableItems-id-0011_di" bpmnElement="ServiceTask-ShipAvailableItems-id-0011">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent-WaitForBackorder-id-0012_di" bpmnElement="IntermediateCatchEvent-WaitForBackorder-id-0012">
        <dc:Bounds x="1257" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ShipBackorderItems-id-0013_di" bpmnElement="ServiceTask-ShipBackorderItems-id-0013">
        <dc:Bounds x="1375" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-HoldOrder-id-0014_di" bpmnElement="ServiceTask-HoldOrder-id-0014">
        <dc:Bounds x="925" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent-WaitForFullStock-id-0015_di" bpmnElement="IntermediateCatchEvent-WaitForFullStock-id-0015">
        <dc:Bounds x="1107" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSubmit-id-0016_di" bpmnElement="SequenceFlow-StartToSubmit-id-0016">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SubmitToCheck-id-0017_di" bpmnElement="SequenceFlow-SubmitToCheck-id-0017">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckToGateway-id-0018_di" bpmnElement="SequenceFlow-CheckToGateway-id-0018">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToReserve-id-0019_di" bpmnElement="SequenceFlow-GatewayToReserve-id-0019">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToReview-id-0022_di" bpmnElement="SequenceFlow-GatewayToReview-id-0022">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReserveToPacking-id-0020_di" bpmnElement="SequenceFlow-ReserveToPacking-id-0020">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PackingToEnd-id-0021_di" bpmnElement="SequenceFlow-PackingToEnd-id-0021">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1557" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToPartialGateway-id-0023_di" bpmnElement="SequenceFlow-ReviewToPartialGateway-id-0023">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="800" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PartialGatewayToSplit-id-0024_di" bpmnElement="SequenceFlow-PartialGatewayToSplit-id-0024">
        <di:waypoint x="850" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PartialGatewayToHold-id-0029_di" bpmnElement="SequenceFlow-PartialGatewayToHold-id-0029">
        <di:waypoint x="825" y="235" />
        <di:waypoint x="825" y="350" />
        <di:waypoint x="925" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToShipAvailable-id-0025_di" bpmnElement="SequenceFlow-SplitToShipAvailable-id-0025">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ShipAvailableToWait-id-0026_di" bpmnElement="SequenceFlow-ShipAvailableToWait-id-0026">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1257" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-WaitToShipBackorder-id-0027_di" bpmnElement="SequenceFlow-WaitToShipBackorder-id-0027">
        <di:waypoint x="1293" y="210" />
        <di:waypoint x="1375" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ShipBackorderToEnd-id-0028_di" bpmnElement="SequenceFlow-ShipBackorderToEnd-id-0028">
        <di:waypoint x="1475" y="210" />
        <di:waypoint x="1575" y="210" />
        <di:waypoint x="1575" y="88" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-HoldToWaitFullStock-id-0030_di" bpmnElement="SequenceFlow-HoldToWaitFullStock-id-0030">
        <di:waypoint x="1025" y="350" />
        <di:waypoint x="1107" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-WaitFullStockToPacking-id-0031_di" bpmnElement="SequenceFlow-WaitFullStockToPacking-id-0031">
        <di:waypoint x="1143" y="350" />
        <di:waypoint x="1200" y="350" />
        <di:waypoint x="1200" y="140" />
        <di:waypoint x="1200" y="140" />
        <di:waypoint x="1200" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
