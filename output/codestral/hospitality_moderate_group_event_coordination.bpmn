        <di:waypoint x="1250" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ParallelJoinToBreakDownSetup-id-0026_di" bpmnElement="SequenceFlow-ParallelJoinToBreakDownSetup-id-0026">
