        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToTestAVEquipment-id-0021_di" bpmnElement="SequenceFlow-SplitToTestAVEquipment-id-0021">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToDeliverFood-id-0022_di" bpmnElement="SequenceFlow-SplitToDeliverFood-id-0022">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="350" />
        <di:waypoint x="1075" y="350" />
      </bpmndi:BPMNEdge>
