        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PrepareFoodToParallelSplit-id-0019_di" bpmnElement="SequenceFlow-PrepareFoodToParallelSplit-id-0019">
