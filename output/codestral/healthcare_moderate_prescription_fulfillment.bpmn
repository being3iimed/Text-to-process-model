<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Prescription-Process-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Prescription-Process-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ProcessBegins-id-0001" name="Process Begins">
      <bpmn:outgoing>SequenceFlow-StartToDoctorPrescribes-id-0016</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-DoctorPrescribesMedication-id-0002" name="Doctor Prescribes Medication">
      <bpmn:incoming>SequenceFlow-StartToDoctorPrescribes-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DoctorToSendPrescription-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-SendPrescriptionElectronically-id-0003" name="Send Prescription Electronically">
      <bpmn:incoming>SequenceFlow-DoctorToSendPrescription-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToCheckInsurance-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-PharmacyTechnicianChecksInsurance-id-0004" name="Pharmacy Technician Checks Insurance">
      <bpmn:incoming>SequenceFlow-SendToCheckInsurance-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckToGateway-id-0019</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PriorAuthorizationRequired-id-0005" name="Prior Authorization Required?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckToGateway-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToContactInsurance-id-0020</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToFillPrescription-id-0021</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ContactInsuranceCompany-id-0006" name="Contact Insurance Company">
      <bpmn:incoming>SequenceFlow-GatewayToContactInsurance-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ContactToInsuranceGateway-id-0022</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InsuranceApproves-id-0007" name="Insurance Approves?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ContactToInsuranceGateway-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InsuranceGatewayToFill-id-0023</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-InsuranceGatewayToDenial-id-0024</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-FillPrescription-id-0008" name="Fill Prescription">
      <bpmn:incoming>SequenceFlow-GatewayToFillPrescription-id-0021</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-InsuranceGatewayToFill-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FillToNotify-id-0025</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-NotifyPatientToPickUp-id-0009" name="Notify Patient to Pick Up">
      <bpmn:incoming>SequenceFlow-FillToNotify-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyToPickUp-id-0026</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-PatientPicksUpPrescription-id-0010" name="Patient Picks Up Prescription">
      <bpmn:incoming>SequenceFlow-NotifyToPickUp-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PickUpToEnd-id-0027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-NotifyPatientAndDoctorOfDenial-id-0011" name="Notify Patient and Doctor of Denial">
      <bpmn:incoming>SequenceFlow-InsuranceGatewayToDenial-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DenialToAppealGateway-id-0028</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="InclusiveGateway-AppealOrAlternative-id-0012" name="Appeal or Alternative?">
      <bpmn:incoming>SequenceFlow-DenialToAppealGateway-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AppealGatewayToAppeal-id-0029</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AppealGatewayToAlternative-id-0030</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="UserTask-PatientAppealsDenial-id-0013" name="Patient Appeals Denial">
      <bpmn:incoming>SequenceFlow-AppealGatewayToAppeal-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AppealToEnd-id-0031</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DoctorPrescribesAlternative-id-0014" name="Doctor Prescribes Alternative">
      <bpmn:incoming>SequenceFlow-AppealGatewayToAlternative-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AlternativeToEnd-id-0032</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0015" name="Process Complete">
      <bpmn:incoming>SequenceFlow-PickUpToEnd-id-0027</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AppealToEnd-id-0031</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AlternativeToEnd-id-0032</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDoctorPrescribes-id-0016" sourceRef="StartEvent-ProcessBegins-id-0001" targetRef="UserTask-DoctorPrescribesMedication-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DoctorToSendPrescription-id-0017" sourceRef="UserTask-DoctorPrescribesMedication-id-0002" targetRef="ServiceTask-SendPrescriptionElectronically-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToCheckInsurance-id-0018" sourceRef="ServiceTask-SendPrescriptionElectronically-id-0003" targetRef="UserTask-PharmacyTechnicianChecksInsurance-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckToGateway-id-0019" sourceRef="UserTask-PharmacyTechnicianChecksInsurance-id-0004" targetRef="ExclusiveGateway-PriorAuthorizationRequired-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToContactInsurance-id-0020" name="Prior Authorization Required" sourceRef="ExclusiveGateway-PriorAuthorizationRequired-id-0005" targetRef="ServiceTask-ContactInsuranceCompany-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToFillPrescription-id-0021" name="Prior Authorization Not Required" sourceRef="ExclusiveGateway-PriorAuthorizationRequired-id-0005" targetRef="UserTask-FillPrescription-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ContactToInsuranceGateway-id-0022" sourceRef="ServiceTask-ContactInsuranceCompany-id-0006" targetRef="ExclusiveGateway-InsuranceApproves-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-InsuranceGatewayToFill-id-0023" name="Insurance Approves" sourceRef="ExclusiveGateway-InsuranceApproves-id-0007" targetRef="UserTask-FillPrescription-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-InsuranceGatewayToDenial-id-0024" name="Insurance Denies" sourceRef="ExclusiveGateway-InsuranceApproves-id-0007" targetRef="UserTask-NotifyPatientAndDoctorOfDenial-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-FillToNotify-id-0025" sourceRef="UserTask-FillPrescription-id-0008" targetRef="ServiceTask-NotifyPatientToPickUp-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyToPickUp-id-0026" sourceRef="ServiceTask-NotifyPatientToPickUp-id-0009" targetRef="UserTask-PatientPicksUpPrescription-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-PickUpToEnd-id-0027" sourceRef="UserTask-PatientPicksUpPrescription-id-0010" targetRef="EndEvent-ProcessComplete-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-DenialToAppealGateway-id-0028" sourceRef="UserTask-NotifyPatientAndDoctorOfDenial-id-0011" targetRef="InclusiveGateway-AppealOrAlternative-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-AppealGatewayToAppeal-id-0029" name="Patient Appeals Denial" sourceRef="InclusiveGateway-AppealOrAlternative-id-0012" targetRef="UserTask-PatientAppealsDenial-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-AppealGatewayToAlternative-id-0030" name="Doctor Prescribes Alternative" sourceRef="InclusiveGateway-AppealOrAlternative-id-0012" targetRef="UserTask-DoctorPrescribesAlternative-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-AppealToEnd-id-0031" sourceRef="UserTask-PatientAppealsDenial-id-0013" targetRef="EndEvent-ProcessComplete-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-AlternativeToEnd-id-0032" sourceRef="UserTask-DoctorPrescribesAlternative-id-0014" targetRef="EndEvent-ProcessComplete-id-0015" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Prescription-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Prescription-Process-id-0001" bpmnElement="Prescription-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProcessBegins-id-0001_di" bpmnElement="StartEvent-ProcessBegins-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DoctorPrescribesMedication-id-0002_di" bpmnElement="UserTask-DoctorPrescribesMedication-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SendPrescriptionElectronically-id-0003_di" bpmnElement="ServiceTask-SendPrescriptionElectronically-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-PharmacyTechnicianChecksInsurance-id-0004_di" bpmnElement="UserTask-PharmacyTechnicianChecksInsurance-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PriorAuthorizationRequired-id-0005_di" bpmnElement="ExclusiveGateway-PriorAuthorizationRequired-id-0005" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ContactInsuranceCompany-id-0006_di" bpmnElement="ServiceTask-ContactInsuranceCompany-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-InsuranceApproves-id-0007_di" bpmnElement="ExclusiveGateway-InsuranceApproves-id-0007" isMarkerVisible="true">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-FillPrescription-id-0008_di" bpmnElement="UserTask-FillPrescription-id-0008">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-NotifyPatientToPickUp-id-0009_di" bpmnElement="ServiceTask-NotifyPatientToPickUp-id-0009">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-PatientPicksUpPrescription-id-0010_di" bpmnElement="UserTask-PatientPicksUpPrescription-id-0010">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessComplete-id-0015_di" bpmnElement="EndEvent-ProcessComplete-id-0015">
        <dc:Bounds x="1857" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-NotifyPatientAndDoctorOfDenial-id-0011_di" bpmnElement="UserTask-NotifyPatientAndDoctorOfDenial-id-0011">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InclusiveGateway-AppealOrAlternative-id-0012_di" bpmnElement="InclusiveGateway-AppealOrAlternative-id-0012">
        <dc:Bounds x="1550" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-PatientAppealsDenial-id-0013_di" bpmnElement="UserTask-PatientAppealsDenial-id-0013">
        <dc:Bounds x="1675" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DoctorPrescribesAlternative-id-0014_di" bpmnElement="UserTask-DoctorPrescribesAlternative-id-0014">
        <dc:Bounds x="1675" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToDoctorPrescribes-id-0016_di" bpmnElement="SequenceFlow-StartToDoctorPrescribes-id-0016">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DoctorToSendPrescription-id-0017_di" bpmnElement="SequenceFlow-DoctorToSendPrescription-id-0017">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendToCheckInsurance-id-0018_di" bpmnElement="SequenceFlow-SendToCheckInsurance-id-0018">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckToGateway-id-0019_di" bpmnElement="SequenceFlow-CheckToGateway-id-0019">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToContactInsurance-id-0020_di" bpmnElement="SequenceFlow-GatewayToContactInsurance-id-0020">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToFillPrescription-id-0021_di" bpmnElement="SequenceFlow-GatewayToFillPrescription-id-0021">
        <di:waypoint x="675" y="95" />
        <di:waypoint x="675" y="140" />
        <di:waypoint x="1125" y="140" />
        <di:waypoint x="1125" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ContactToInsuranceGateway-id-0022_di" bpmnElement="SequenceFlow-ContactToInsuranceGateway-id-0022">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="950" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InsuranceGatewayToFill-id-0023_di" bpmnElement="SequenceFlow-InsuranceGatewayToFill-id-0023">
        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InsuranceGatewayToDenial-id-0024_di" bpmnElement="SequenceFlow-InsuranceGatewayToDenial-id-0024">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FillToNotify-id-0025_di" bpmnElement="SequenceFlow-FillToNotify-id-0025">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-NotifyToPickUp-id-0026_di" bpmnElement="SequenceFlow-NotifyToPickUp-id-0026">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PickUpToEnd-id-0027_di" bpmnElement="SequenceFlow-PickUpToEnd-id-0027">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1857" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DenialToAppealGateway-id-0028_di" bpmnElement="SequenceFlow-DenialToAppealGateway-id-0028">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1550" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AppealGatewayToAppeal-id-0029_di" bpmnElement="SequenceFlow-AppealGatewayToAppeal-id-0029">
        <di:waypoint x="1600" y="210" />
        <di:waypoint x="1675" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AppealGatewayToAlternative-id-0030_di" bpmnElement="SequenceFlow-AppealGatewayToAlternative-id-0030">
        <di:waypoint x="1575" y="235" />
        <di:waypoint x="1575" y="350" />
        <di:waypoint x="1675" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AppealToEnd-id-0031_di" bpmnElement="SequenceFlow-AppealToEnd-id-0031">
        <di:waypoint x="1775" y="210" />
        <di:waypoint x="1875" y="210" />
        <di:waypoint x="1875" y="88" />
      </bpmndi:BPMNEdge>
