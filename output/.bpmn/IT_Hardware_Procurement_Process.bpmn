<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="hardware-request-process-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="HardwareRequestProcess-id-0001" name="Hardware Request Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-HardwareRequestProcessStarts-id-0001" name="Hardware Request Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToSubmitRequest-id-0015</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-DepartmentSubmitsHardwareRequest-id-0002" name="Department submits hardware request">
      <bpmn:incoming>SequenceFlow-StartToSubmitRequest-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubmitToGateway-id-0016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RequestNecessaryAndWithinBudget-id-0003" name="Request Necessary and Within Budget?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SubmitToGateway-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToCreateRequisition-id-0017</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToReject-id-0026</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-CreatePurchaseRequisition-id-0004" name="Create purchase requisition">
      <bpmn:incoming>SequenceFlow-GatewayToCreateRequisition-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateToGatherQuotes-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GatherQuotesFromVendors-id-0005" name="Gather quotes from vendors">
      <bpmn:incoming>SequenceFlow-CreateToGatherQuotes-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatherToSelectVendor-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-SelectVendorAndApproveOrder-id-0006" name="Select vendor and approve order">
      <bpmn:incoming>SequenceFlow-GatherToSelectVendor-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToPlaceOrder-id-0020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-PlaceOrderWithSelectedVendor-id-0007" name="Place order with selected vendor">
      <bpmn:incoming>SequenceFlow-SelectToPlaceOrder-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PlaceToReceiveEquipment-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveEquipmentDelivery-id-0008" name="Receive equipment delivery">
      <bpmn:incoming>SequenceFlow-PlaceToReceiveEquipment-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToScheduleInstallation-id-0022</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="ServiceTask-ScheduleInstallation-id-0009" name="Schedule installation">
      <bpmn:incoming>SequenceFlow-ReceiveToScheduleInstallation-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ScheduleToTestEquipment-id-0023</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PerformEquipmentTesting-id-0010" name="Perform equipment testing">
      <bpmn:incoming>SequenceFlow-ScheduleToTestEquipment-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TestToRegisterAssets-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-RegisterAssetsInInventory-id-0011" name="Register assets in inventory">
      <bpmn:incoming>SequenceFlow-TestToRegisterAssets-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RegisterToComplete-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-HardwareProcessComplete-id-0012" name="Hardware Process Complete">
      <bpmn:incoming>SequenceFlow-RegisterToComplete-id-0025</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-SendRequestRejectionNotice-id-0013" name="Send request rejection notice">
      <bpmn:incoming>SequenceFlow-GatewayToReject-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RejectToEnd-id-0027</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-HardwareRequestRejected-id-0014" name="Hardware Request Rejected">
      <bpmn:incoming>SequenceFlow-RejectToEnd-id-0027</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSubmitRequest-id-0015" sourceRef="StartEvent-HardwareRequestProcessStarts-id-0001" targetRef="UserTask-DepartmentSubmitsHardwareRequest-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SubmitToGateway-id-0016" sourceRef="UserTask-DepartmentSubmitsHardwareRequest-id-0002" targetRef="ExclusiveGateway-RequestNecessaryAndWithinBudget-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToCreateRequisition-id-0017" name="request_necessary AND within_budget" sourceRef="ExclusiveGateway-RequestNecessaryAndWithinBudget-id-0003" targetRef="ServiceTask-CreatePurchaseRequisition-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateToGatherQuotes-id-0018" sourceRef="ServiceTask-CreatePurchaseRequisition-id-0004" targetRef="ServiceTask-GatherQuotesFromVendors-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-GatherToSelectVendor-id-0019" sourceRef="ServiceTask-GatherQuotesFromVendors-id-0005" targetRef="UserTask-SelectVendorAndApproveOrder-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToPlaceOrder-id-0020" sourceRef="UserTask-SelectVendorAndApproveOrder-id-0006" targetRef="ServiceTask-PlaceOrderWithSelectedVendor-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-PlaceToReceiveEquipment-id-0021" sourceRef="ServiceTask-PlaceOrderWithSelectedVendor-id-0007" targetRef="ReceiveTask-ReceiveEquipmentDelivery-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveToScheduleInstallation-id-0022" sourceRef="ReceiveTask-ReceiveEquipmentDelivery-id-0008" targetRef="ServiceTask-ScheduleInstallation-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-ScheduleToTestEquipment-id-0023" sourceRef="ServiceTask-ScheduleInstallation-id-0009" targetRef="ServiceTask-PerformEquipmentTesting-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-TestToRegisterAssets-id-0024" sourceRef="ServiceTask-PerformEquipmentTesting-id-0010" targetRef="ServiceTask-RegisterAssetsInInventory-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-RegisterToComplete-id-0025" sourceRef="ServiceTask-RegisterAssetsInInventory-id-0011" targetRef="EndEvent-HardwareProcessComplete-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToReject-id-0026" sourceRef="ExclusiveGateway-RequestNecessaryAndWithinBudget-id-0003" targetRef="SendTask-SendRequestRejectionNotice-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-RejectToEnd-id-0027" sourceRef="SendTask-SendRequestRejectionNotice-id-0013" targetRef="EndEvent-HardwareRequestRejected-id-0014" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HardwareRequestProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_HardwareRequestProcess-id-0001" bpmnElement="HardwareRequestProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-HardwareRequestProcessStarts-id-0001_di" bpmnElement="StartEvent-HardwareRequestProcessStarts-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DepartmentSubmitsHardwareRequest-id-0002_di" bpmnElement="UserTask-DepartmentSubmitsHardwareRequest-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-RequestNecessaryAndWithinBudget-id-0003_di" bpmnElement="ExclusiveGateway-RequestNecessaryAndWithinBudget-id-0003" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CreatePurchaseRequisition-id-0004_di" bpmnElement="ServiceTask-CreatePurchaseRequisition-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GatherQuotesFromVendors-id-0005_di" bpmnElement="ServiceTask-GatherQuotesFromVendors-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SelectVendorAndApproveOrder-id-0006_di" bpmnElement="UserTask-SelectVendorAndApproveOrder-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PlaceOrderWithSelectedVendor-id-0007_di" bpmnElement="ServiceTask-PlaceOrderWithSelectedVendor-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveEquipmentDelivery-id-0008_di" bpmnElement="ReceiveTask-ReceiveEquipmentDelivery-id-0008">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ScheduleInstallation-id-0009_di" bpmnElement="ServiceTask-ScheduleInstallation-id-0009">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PerformEquipmentTesting-id-0010_di" bpmnElement="ServiceTask-PerformEquipmentTesting-id-0010">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RegisterAssetsInInventory-id-0011_di" bpmnElement="ServiceTask-RegisterAssetsInInventory-id-0011">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-HardwareProcessComplete-id-0012_di" bpmnElement="EndEvent-HardwareProcessComplete-id-0012">
        <dc:Bounds x="1707" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendRequestRejectionNotice-id-0013_di" bpmnElement="SendTask-SendRequestRejectionNotice-id-0013">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-HardwareRequestRejected-id-0014_di" bpmnElement="EndEvent-HardwareRequestRejected-id-0014">
        <dc:Bounds x="657" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSubmitRequest-id-0015_di" bpmnElement="SequenceFlow-StartToSubmitRequest-id-0015">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SubmitToGateway-id-0016_di" bpmnElement="SequenceFlow-SubmitToGateway-id-0016">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToCreateRequisition-id-0017_di" bpmnElement="SequenceFlow-GatewayToCreateRequisition-id-0017">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToReject-id-0026_di" bpmnElement="SequenceFlow-GatewayToReject-id-0026">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="210" />
        <di:waypoint x="475" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CreateToGatherQuotes-id-0018_di" bpmnElement="SequenceFlow-CreateToGatherQuotes-id-0018">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatherToSelectVendor-id-0019_di" bpmnElement="SequenceFlow-GatherToSelectVendor-id-0019">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectToPlaceOrder-id-0020_di" bpmnElement="SequenceFlow-SelectToPlaceOrder-id-0020">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PlaceToReceiveEquipment-id-0021_di" bpmnElement="SequenceFlow-PlaceToReceiveEquipment-id-0021">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveToScheduleInstallation-id-0022_di" bpmnElement="SequenceFlow-ReceiveToScheduleInstallation-id-0022">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ScheduleToTestEquipment-id-0023_di" bpmnElement="SequenceFlow-ScheduleToTestEquipment-id-0023">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TestToRegisterAssets-id-0024_di" bpmnElement="SequenceFlow-TestToRegisterAssets-id-0024">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1525" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RegisterToComplete-id-0025_di" bpmnElement="SequenceFlow-RegisterToComplete-id-0025">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1707" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RejectToEnd-id-0027_di" bpmnElement="SequenceFlow-RejectToEnd-id-0027">
        <di:waypoint x="575" y="210" />
        <di:waypoint x="657" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
