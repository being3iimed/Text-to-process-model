<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="exit-interview-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="ExitInterviewProcess-id-0001">
    <bpmn:startEvent id="StartEvent-ProcessInitiated-id-0001" name="Exit Interview Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToInterview-id-0009</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CompleteInterview-id-0002" name="Employee Completes Exit Interview">
      <bpmn:incoming>SequenceFlow-StartToInterview-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InterviewToAnonymize-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="ScriptTask-AnonymizeResponses-id-0003" name="Anonymize interview responses">
      <bpmn:incoming>SequenceFlow-InterviewToAnonymize-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnonymizeToAnalyze-id-0011</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="ServiceTask-AnalyzeResponses-id-0004" name="Analyze responses for patterns and trends">
      <bpmn:incoming>SequenceFlow-AnonymizeToAnalyze-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeToGenerate-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GenerateInsights-id-0005" name="Generate retention strategy insights">
      <bpmn:incoming>SequenceFlow-AnalyzeToGenerate-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateToCreate-id-0013</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CreateReport-id-0006" name="Create actionable report highlighting key areas">
      <bpmn:incoming>SequenceFlow-GenerateToCreate-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateToReview-id-0014</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ReviewReport-id-0007" name="Leadership reviews report and develops recommendations">
      <bpmn:incoming>SequenceFlow-CreateToReview-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToEnd-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0008" name="Process Complete">
      <bpmn:incoming>SequenceFlow-ReviewToEnd-id-0015</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToInterview-id-0009" sourceRef="StartEvent-ProcessInitiated-id-0001" targetRef="UserTask-CompleteInterview-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-InterviewToAnonymize-id-0010" sourceRef="UserTask-CompleteInterview-id-0002" targetRef="ScriptTask-AnonymizeResponses-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-AnonymizeToAnalyze-id-0011" sourceRef="ScriptTask-AnonymizeResponses-id-0003" targetRef="ServiceTask-AnalyzeResponses-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToGenerate-id-0012" sourceRef="ServiceTask-AnalyzeResponses-id-0004" targetRef="ServiceTask-GenerateInsights-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateToCreate-id-0013" sourceRef="ServiceTask-GenerateInsights-id-0005" targetRef="ServiceTask-CreateReport-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateToReview-id-0014" sourceRef="ServiceTask-CreateReport-id-0006" targetRef="UserTask-ReviewReport-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToEnd-id-0015" sourceRef="UserTask-ReviewReport-id-0007" targetRef="EndEvent-ProcessComplete-id-0008" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ExitInterviewProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_ExitInterviewProcess-id-0001" bpmnElement="ExitInterviewProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProcessInitiated-id-0001_di" bpmnElement="StartEvent-ProcessInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CompleteInterview-id-0002_di" bpmnElement="UserTask-CompleteInterview-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScriptTask-AnonymizeResponses-id-0003_di" bpmnElement="ScriptTask-AnonymizeResponses-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AnalyzeResponses-id-0004_di" bpmnElement="ServiceTask-AnalyzeResponses-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateInsights-id-0005_di" bpmnElement="ServiceTask-GenerateInsights-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CreateReport-id-0006_di" bpmnElement="ServiceTask-CreateReport-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewReport-id-0007_di" bpmnElement="UserTask-ReviewReport-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessComplete-id-0008_di" bpmnElement="EndEvent-ProcessComplete-id-0008">
        <dc:Bounds x="1107" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToInterview-id-0009_di" bpmnElement="SequenceFlow-StartToInterview-id-0009">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InterviewToAnonymize-id-0010_di" bpmnElement="SequenceFlow-InterviewToAnonymize-id-0010">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnonymizeToAnalyze-id-0011_di" bpmnElement="SequenceFlow-AnonymizeToAnalyze-id-0011">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalyzeToGenerate-id-0012_di" bpmnElement="SequenceFlow-AnalyzeToGenerate-id-0012">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GenerateToCreate-id-0013_di" bpmnElement="SequenceFlow-GenerateToCreate-id-0013">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CreateToReview-id-0014_di" bpmnElement="SequenceFlow-CreateToReview-id-0014">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToEnd-id-0015_di" bpmnElement="SequenceFlow-ReviewToEnd-id-0015">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1107" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
