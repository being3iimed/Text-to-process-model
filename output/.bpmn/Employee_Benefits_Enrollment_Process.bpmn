<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Benefits-Enrollment-Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Benefits-Enrollment-Process-id-0001" name="Benefits Enrollment Process">
    <bpmn:startEvent id="StartEvent-OpenEnrollmentBegins-id-0001" name="Open Enrollment Begins">
      <bpmn:outgoing>SequenceFlow-StartToReviewBenefits-id-0008</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-EmployeeReviewsBenefits-id-0002" name="Employee Reviews Benefits">
      <bpmn:incoming>SequenceFlow-StartToReviewBenefits-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToSubmitChoices-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-EmployeeSubmitsChoices-id-0003" name="Employee Submits Choices">
      <bpmn:incoming>SequenceFlow-ReviewToSubmitChoices-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubmitToVerify-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-HRVerifiesSelections-id-0004" name="HR Verifies Selections">
      <bpmn:incoming>SequenceFlow-SubmitToVerify-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToUpdatePayroll-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-HRUpdatesPayrollRecords-id-0005" name="HR Updates Payroll Records">
      <bpmn:incoming>SequenceFlow-VerifyToUpdatePayroll-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToSendConfirmation-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendConfirmationLetter-id-0006" name="Send: Confirmation Letter">
      <bpmn:incoming>SequenceFlow-UpdateToSendConfirmation-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToEnd-id-0013</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-BenefitsEffective-id-0007" name="Benefits Effective">
      <bpmn:incoming>SequenceFlow-SendToEnd-id-0013</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToReviewBenefits-id-0008" sourceRef="StartEvent-OpenEnrollmentBegins-id-0001" targetRef="UserTask-EmployeeReviewsBenefits-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToSubmitChoices-id-0009" sourceRef="UserTask-EmployeeReviewsBenefits-id-0002" targetRef="UserTask-EmployeeSubmitsChoices-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-SubmitToVerify-id-0010" sourceRef="UserTask-EmployeeSubmitsChoices-id-0003" targetRef="ServiceTask-HRVerifiesSelections-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyToUpdatePayroll-id-0011" sourceRef="ServiceTask-HRVerifiesSelections-id-0004" targetRef="ServiceTask-HRUpdatesPayrollRecords-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToSendConfirmation-id-0012" sourceRef="ServiceTask-HRUpdatesPayrollRecords-id-0005" targetRef="SendTask-SendConfirmationLetter-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToEnd-id-0013" sourceRef="SendTask-SendConfirmationLetter-id-0006" targetRef="EndEvent-BenefitsEffective-id-0007" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Benefits-Enrollment-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Benefits-Enrollment-Process-id-0001" bpmnElement="Benefits-Enrollment-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-OpenEnrollmentBegins-id-0001_di" bpmnElement="StartEvent-OpenEnrollmentBegins-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EmployeeReviewsBenefits-id-0002_di" bpmnElement="UserTask-EmployeeReviewsBenefits-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EmployeeSubmitsChoices-id-0003_di" bpmnElement="UserTask-EmployeeSubmitsChoices-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-HRVerifiesSelections-id-0004_di" bpmnElement="ServiceTask-HRVerifiesSelections-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-HRUpdatesPayrollRecords-id-0005_di" bpmnElement="ServiceTask-HRUpdatesPayrollRecords-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendConfirmationLetter-id-0006_di" bpmnElement="SendTask-SendConfirmationLetter-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-BenefitsEffective-id-0007_di" bpmnElement="EndEvent-BenefitsEffective-id-0007">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToReviewBenefits-id-0008_di" bpmnElement="SequenceFlow-StartToReviewBenefits-id-0008">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToSubmitChoices-id-0009_di" bpmnElement="SequenceFlow-ReviewToSubmitChoices-id-0009">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SubmitToVerify-id-0010_di" bpmnElement="SequenceFlow-SubmitToVerify-id-0010">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-VerifyToUpdatePayroll-id-0011_di" bpmnElement="SequenceFlow-VerifyToUpdatePayroll-id-0011">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UpdateToSendConfirmation-id-0012_di" bpmnElement="SequenceFlow-UpdateToSendConfirmation-id-0012">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendToEnd-id-0013_di" bpmnElement="SequenceFlow-SendToEnd-id-0013">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
