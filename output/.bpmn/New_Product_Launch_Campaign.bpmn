        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LaunchDayToPostLaunch-id-0016_di" bpmnElement="SequenceFlow-LaunchDayToPostLaunch-id-0016">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PostLaunchToEnd-id-0017_di" bpmnElement="SequenceFlow-PostLaunchToEnd-id-0017">
