<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ProductLaunchProcess-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="ProductLaunchProcess-id-0001" name="Product Launch Process">
    <bpmn:startEvent id="StartEvent-ProductLaunchProcessBegins-id-0001" name="Product Launch Process Begins">
      <bpmn:outgoing>SequenceFlow-StartToIdentify-id-0010</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-IdentifyTargetAudiences-id-0002" name="Identify target audiences and competitive positioning">
      <bpmn:incoming>SequenceFlow-StartToIdentify-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdentifyToAnalyze-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AnalyzeMarketTrends-id-0003" name="Analyze market trends and customer needs">
      <bpmn:incoming>SequenceFlow-IdentifyToAnalyze-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeToCreativeDevelopment-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess-DevelopCreativeAssets-id-0004" name="Develop Creative Assets">
      <bpmn:incoming>SequenceFlow-AnalyzeToCreativeDevelopment-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreativeDevelopmentToTimeline-id-0013</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-CreativeDevelopmentStarts-id-0001" name="Creative Development Starts">
        <bpmn:outgoing>SequenceFlow-StartToSplit-id-0007</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway-Split-id-0001" name="Parallel Execution" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-StartToSplit-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToAdvertisements-id-0008</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToSocialMedia-id-0009</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToPressReleases-id-0010</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="ServiceTask-CreateAdvertisements-id-0002" name="Create advertisements">
        <bpmn:incoming>SequenceFlow-SplitToAdvertisements-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AdvertisementsToJoin-id-0011</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-DevelopSocialMediaPosts-id-0003" name="Develop social media posts">
        <bpmn:incoming>SequenceFlow-SplitToSocialMedia-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SocialMediaToJoin-id-0012</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-PreparePressReleases-id-0004" name="Prepare press releases">
        <bpmn:incoming>SequenceFlow-SplitToPressReleases-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PressReleasesToJoin-id-0013</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway-Join-id-0005" name="Synchronize Branches" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-AdvertisementsToJoin-id-0011</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SocialMediaToJoin-id-0012</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-PressReleasesToJoin-id-0013</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToEnd-id-0014</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndEvent-CreativeAssetsReady-id-0006" name="Creative Assets Ready">
        <bpmn:incoming>SequenceFlow-JoinToEnd-id-0014</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0007" sourceRef="StartEvent-CreativeDevelopmentStarts-id-0001" targetRef="ParallelGateway-Split-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToAdvertisements-id-0008" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-CreateAdvertisements-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToSocialMedia-id-0009" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-DevelopSocialMediaPosts-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToPressReleases-id-0010" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-PreparePressReleases-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-AdvertisementsToJoin-id-0011" sourceRef="ServiceTask-CreateAdvertisements-id-0002" targetRef="ParallelGateway-Join-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-SocialMediaToJoin-id-0012" sourceRef="ServiceTask-DevelopSocialMediaPosts-id-0003" targetRef="ParallelGateway-Join-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-PressReleasesToJoin-id-0013" sourceRef="ServiceTask-PreparePressReleases-id-0004" targetRef="ParallelGateway-Join-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToEnd-id-0014" sourceRef="ParallelGateway-Join-id-0005" targetRef="EndEvent-CreativeAssetsReady-id-0006" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-CreateLaunchTimeline-id-0005" name="Create Launch Timeline">
      <bpmn:incoming>SequenceFlow-CreativeDevelopmentToTimeline-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TimelineToPreLaunch-id-0014</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-TimelineCreationStarts-id-0001" name="Timeline Creation Starts">
        <bpmn:outgoing>SequenceFlow-StartToSplit-id-0007</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-CoordinateWithSalesTeam-id-0002" name="Coordinate with sales team">
        <bpmn:incoming>SequenceFlow-SplitToSalesTeam-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SalesTeamToJoin-id-0011</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-AlignWithPRDepartment-id-0003" name="Align with PR department">
        <bpmn:incoming>SequenceFlow-SplitToPRDepartment-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PRDepartmentToJoin-id-0012</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-ScheduleDistributionLogistics-id-0004" name="Schedule distribution logistics">
        <bpmn:incoming>SequenceFlow-SplitToLogistics-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-LogisticsToJoin-id-0013</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-LaunchTimelineReady-id-0006" name="Launch Timeline Ready">
        <bpmn:incoming>SequenceFlow-JoinToEnd-id-0014</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-SplitToSalesTeam-id-0008" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-CoordinateWithSalesTeam-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToPRDepartment-id-0009" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-AlignWithPRDepartment-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToLogistics-id-0010" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-ScheduleDistributionLogistics-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-SalesTeamToJoin-id-0011" sourceRef="ServiceTask-CoordinateWithSalesTeam-id-0002" targetRef="ParallelGateway-Join-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-PRDepartmentToJoin-id-0012" sourceRef="ServiceTask-AlignWithPRDepartment-id-0003" targetRef="ParallelGateway-Join-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-LogisticsToJoin-id-0013" sourceRef="ServiceTask-ScheduleDistributionLogistics-id-0004" targetRef="ParallelGateway-Join-id-0005" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-GeneratePreLaunchBuzz-id-0006" name="Generate Pre-Launch Buzz">
      <bpmn:incoming>SequenceFlow-TimelineToPreLaunch-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PreLaunchToLaunchDay-id-0015</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-PreLaunchBegins-id-0001" name="Pre-Launch Begins">
        <bpmn:outgoing>SequenceFlow-StartToSplit-id-0006</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-CreateProductTeasers-id-0002" name="Create and distribute product teasers">
        <bpmn:incoming>SequenceFlow-SplitToTeasers-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TeasersToJoin-id-0009</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-EstablishInfluencerPartnerships-id-0003" name="Establish influencer partnerships">
        <bpmn:incoming>SequenceFlow-SplitToInfluencers-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-InfluencersToJoin-id-0010</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway-Join-id-0004" name="Synchronize Branches" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-TeasersToJoin-id-0009</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-InfluencersToJoin-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToEnd-id-0011</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndEvent-PreLaunchActivitiesComplete-id-0005" name="Pre-Launch Activities Complete">
        <bpmn:incoming>SequenceFlow-JoinToEnd-id-0011</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0006" sourceRef="StartEvent-PreLaunchBegins-id-0001" targetRef="ParallelGateway-Split-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToTeasers-id-0007" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-CreateProductTeasers-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToInfluencers-id-0008" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-EstablishInfluencerPartnerships-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-TeasersToJoin-id-0009" sourceRef="ServiceTask-CreateProductTeasers-id-0002" targetRef="ParallelGateway-Join-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-InfluencersToJoin-id-0010" sourceRef="ServiceTask-EstablishInfluencerPartnerships-id-0003" targetRef="ParallelGateway-Join-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToEnd-id-0011" sourceRef="ParallelGateway-Join-id-0004" targetRef="EndEvent-PreLaunchActivitiesComplete-id-0005" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-ExecuteLaunchCampaigns-id-0007" name="Execute Launch Campaigns">
      <bpmn:incoming>SequenceFlow-PreLaunchToLaunchDay-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LaunchDayToPostLaunch-id-0016</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-LaunchDayBegins-id-0001" name="Launch Day Begins">
        <bpmn:outgoing>SequenceFlow-StartToSplit-id-0008</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-ActivateMarketingChannels-id-0002" name="Activate all marketing channels">
        <bpmn:incoming>SequenceFlow-SplitToMarketingChannels-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MarketingChannelsToJoin-id-0013</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-MonitorWebsiteTraffic-id-0003" name="Monitor website traffic">
        <bpmn:incoming>SequenceFlow-SplitToWebsiteTraffic-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-WebsiteTrafficToJoin-id-0014</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-TrackSalesPerformance-id-0004" name="Track sales performance">
        <bpmn:incoming>SequenceFlow-SplitToSalesPerformance-id-0011</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SalesPerformanceToJoin-id-0015</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-MeasureSocialMediaEngagement-id-0005" name="Measure social media engagement">
        <bpmn:incoming>SequenceFlow-SplitToSocialMediaEngagement-id-0012</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SocialMediaEngagementToJoin-id-0016</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway-Join-id-0006" name="Synchronize Branches" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-MarketingChannelsToJoin-id-0013</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-WebsiteTrafficToJoin-id-0014</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SalesPerformanceToJoin-id-0015</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SocialMediaEngagementToJoin-id-0016</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToEnd-id-0017</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndEvent-LaunchDayActivitiesComplete-id-0007" name="Launch Day Activities Complete">
        <bpmn:incoming>SequenceFlow-JoinToEnd-id-0017</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0008" sourceRef="StartEvent-LaunchDayBegins-id-0001" targetRef="ParallelGateway-Split-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToMarketingChannels-id-0009" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-ActivateMarketingChannels-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToWebsiteTraffic-id-0010" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-MonitorWebsiteTraffic-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToSalesPerformance-id-0011" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-TrackSalesPerformance-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToSocialMediaEngagement-id-0012" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-MeasureSocialMediaEngagement-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-MarketingChannelsToJoin-id-0013" sourceRef="ServiceTask-ActivateMarketingChannels-id-0002" targetRef="ParallelGateway-Join-id-0006" />
      <bpmn:sequenceFlow id="SequenceFlow-WebsiteTrafficToJoin-id-0014" sourceRef="ServiceTask-MonitorWebsiteTraffic-id-0003" targetRef="ParallelGateway-Join-id-0006" />
      <bpmn:sequenceFlow id="SequenceFlow-SalesPerformanceToJoin-id-0015" sourceRef="ServiceTask-TrackSalesPerformance-id-0004" targetRef="ParallelGateway-Join-id-0006" />
      <bpmn:sequenceFlow id="SequenceFlow-SocialMediaEngagementToJoin-id-0016" sourceRef="ServiceTask-MeasureSocialMediaEngagement-id-0005" targetRef="ParallelGateway-Join-id-0006" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToEnd-id-0017" sourceRef="ParallelGateway-Join-id-0006" targetRef="EndEvent-LaunchDayActivitiesComplete-id-0007" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-AnalyzeAndAdjust-id-0008" name="Analyze and Adjust">
      <bpmn:incoming>SequenceFlow-LaunchDayToPostLaunch-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PostLaunchToEnd-id-0017</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-PostLaunchAnalysisBegins-id-0001" name="Post-Launch Analysis Begins">
        <bpmn:outgoing>SequenceFlow-StartToCollectMetrics-id-0007</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-CollectPerformanceMetrics-id-0002" name="Collect performance metrics">
        <bpmn:incoming>SequenceFlow-StartToCollectMetrics-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CollectToIdentify-id-0008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-IdentifySuccessfulStrategies-id-0003" name="Identify successful strategies">
        <bpmn:incoming>SequenceFlow-CollectToIdentify-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-IdentifyToDetermine-id-0009</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-DetermineAreasForImprovement-id-0004" name="Determine areas for improvement">
        <bpmn:incoming>SequenceFlow-IdentifyToDetermine-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-DetermineToUpdate-id-0010</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-UpdateMarketingStrategies-id-0005" name="Update marketing strategies accordingly">
        <bpmn:incoming>SequenceFlow-DetermineToUpdate-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-UpdateToEnd-id-0011</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-PostLaunchAdjustmentsComplete-id-0006" name="Post-Launch Adjustments Complete">
        <bpmn:incoming>SequenceFlow-UpdateToEnd-id-0011</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToCollectMetrics-id-0007" sourceRef="StartEvent-PostLaunchAnalysisBegins-id-0001" targetRef="ServiceTask-CollectPerformanceMetrics-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-CollectToIdentify-id-0008" sourceRef="ServiceTask-CollectPerformanceMetrics-id-0002" targetRef="ServiceTask-IdentifySuccessfulStrategies-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-IdentifyToDetermine-id-0009" sourceRef="ServiceTask-IdentifySuccessfulStrategies-id-0003" targetRef="ServiceTask-DetermineAreasForImprovement-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-DetermineToUpdate-id-0010" sourceRef="ServiceTask-DetermineAreasForImprovement-id-0004" targetRef="ServiceTask-UpdateMarketingStrategies-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-UpdateToEnd-id-0011" sourceRef="ServiceTask-UpdateMarketingStrategies-id-0005" targetRef="EndEvent-PostLaunchAdjustmentsComplete-id-0006" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent-ProductLaunchProcessComplete-id-0009" name="Product Launch Process Complete">
      <bpmn:incoming>SequenceFlow-PostLaunchToEnd-id-0017</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToIdentify-id-0010" sourceRef="StartEvent-ProductLaunchProcessBegins-id-0001" targetRef="ServiceTask-IdentifyTargetAudiences-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-IdentifyToAnalyze-id-0011" sourceRef="ServiceTask-IdentifyTargetAudiences-id-0002" targetRef="ServiceTask-AnalyzeMarketTrends-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToCreativeDevelopment-id-0012" sourceRef="ServiceTask-AnalyzeMarketTrends-id-0003" targetRef="SubProcess-DevelopCreativeAssets-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-CreativeDevelopmentToTimeline-id-0013" sourceRef="SubProcess-DevelopCreativeAssets-id-0004" targetRef="SubProcess-CreateLaunchTimeline-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-TimelineToPreLaunch-id-0014" sourceRef="SubProcess-CreateLaunchTimeline-id-0005" targetRef="SubProcess-GeneratePreLaunchBuzz-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-PreLaunchToLaunchDay-id-0015" sourceRef="SubProcess-GeneratePreLaunchBuzz-id-0006" targetRef="SubProcess-ExecuteLaunchCampaigns-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-LaunchDayToPostLaunch-id-0016" sourceRef="SubProcess-ExecuteLaunchCampaigns-id-0007" targetRef="SubProcess-AnalyzeAndAdjust-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-PostLaunchToEnd-id-0017" sourceRef="SubProcess-AnalyzeAndAdjust-id-0008" targetRef="EndEvent-ProductLaunchProcessComplete-id-0009" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ProductLaunchProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_ProductLaunchProcess-id-0001" bpmnElement="ProductLaunchProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProductLaunchProcessBegins-id-0001_di" bpmnElement="StartEvent-ProductLaunchProcessBegins-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
