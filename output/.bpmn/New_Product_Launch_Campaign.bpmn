      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToIdentify-id-0010_di" bpmnElement="SequenceFlow-StartToIdentify-id-0010">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-IdentifyToAnalyze-id-0011_di" bpmnElement="SequenceFlow-IdentifyToAnalyze-id-0011">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalyzeToCreativeDevelopment-id-0012_di" bpmnElement="SequenceFlow-AnalyzeToCreativeDevelopment-id-0012">
