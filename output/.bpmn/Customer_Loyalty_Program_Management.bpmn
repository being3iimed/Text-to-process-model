<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="LoyaltyProgram-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="LoyaltyProgram-Process-id-0001" name="Loyalty Program Management">
    <bpmn:startEvent id="StartEvent-LoyaltyProgramDesign-id-0001" name="Loyalty Program Design">
      <bpmn:outgoing>SequenceFlow-StartToDefine-id-0024</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-DefineProgramRules-id-0002" name="Define program rules (points system, tiers, perks)">
      <bpmn:incoming>SequenceFlow-StartToDefine-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DefineToApprove-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ApproveProgramDesign-id-0003" name="Approve program design">
      <bpmn:incoming>SequenceFlow-DefineToApprove-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApproveToGateway-id-0026</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AutomaticEnrollment-id-0004" name="Automatic Enrollment?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ApproveToGateway-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToAutoEnroll-id-0027</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToManualEnroll-id-0028</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-AutomaticallyEnroll-id-0005" name="Automatically enroll eligible customers">
      <bpmn:incoming>SequenceFlow-GatewayToAutoEnroll-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AutoEnrollToEnd-id-0029</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ManuallyEnroll-id-0006" name="Manually enroll customers">
      <bpmn:incoming>SequenceFlow-GatewayToManualEnroll-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ManualEnrollToEnd-id-0030</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProgramActivated-id-0007" name="Program Activated">
      <bpmn:incoming>SequenceFlow-AutoEnrollToEnd-id-0029</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ManualEnrollToEnd-id-0030</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent-CustomerTransaction-id-0008" name="Customer Transaction">
      <bpmn:outgoing>SequenceFlow-StartToTrack-id-0031</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-TrackTransaction-id-0009" name="Track transaction and calculate points">
      <bpmn:incoming>SequenceFlow-StartToTrack-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrackToUpdate-id-0032</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-UpdateLoyaltyBalance-id-0010" name="Update customer loyalty balance in real-time">
      <bpmn:incoming>SequenceFlow-TrackToUpdate-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToEnd-id-0033</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-PointsUpdated-id-0011" name="Points Updated">
      <bpmn:incoming>SequenceFlow-UpdateToEnd-id-0033</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent-RewardRedemption-id-0012" name="Reward Redemption">
      <bpmn:outgoing>SequenceFlow-StartToValidate-id-0034</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-ValidateEligibility-id-0013" name="Validate customer eligibility for reward">
      <bpmn:incoming>SequenceFlow-StartToValidate-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidateToGateway-id-0035</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ValidateEligibility-id-0014" name="Eligible for Reward?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ValidateToGateway-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToProcess-id-0036</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToSend-id-0037</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ProcessReward-id-0015" name="Process reward fulfillment">
      <bpmn:incoming>SequenceFlow-GatewayToProcess-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProcessToEnd-id-0038</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-RewardDelivered-id-0016" name="Reward Delivered">
      <bpmn:incoming>SequenceFlow-ProcessToEnd-id-0038</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-SendRejection-id-0017" name="Send: rejection notification">
      <bpmn:incoming>SequenceFlow-GatewayToSend-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToEnd-id-0039</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-RedemptionFailed-id-0018" name="Redemption Failed">
      <bpmn:incoming>SequenceFlow-SendToEnd-id-0039</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent-MonthlyProgramReview-id-0019" name="Monthly Program Review">
      <bpmn:outgoing>SequenceFlow-StartToGenerate-id-0040</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-GenerateReports-id-0020" name="Generate engagement and effectiveness reports">
      <bpmn:incoming>SequenceFlow-StartToGenerate-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateToAnalyze-id-0041</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-AnalyzeReports-id-0021" name="Analyze reports and identify improvement opportunities">
      <bpmn:incoming>SequenceFlow-GenerateToAnalyze-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeToAdjust-id-0042</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-AdjustProgramRules-id-0022" name="Adjust program rules as needed">
      <bpmn:incoming>SequenceFlow-AnalyzeToAdjust-id-0042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdjustToEnd-id-0043</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-ProgramUpdated-id-0023" name="Program Updated">
      <bpmn:incoming>SequenceFlow-AdjustToEnd-id-0043</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDefine-id-0024" sourceRef="StartEvent-LoyaltyProgramDesign-id-0001" targetRef="ServiceTask-DefineProgramRules-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DefineToApprove-id-0025" sourceRef="ServiceTask-DefineProgramRules-id-0002" targetRef="UserTask-ApproveProgramDesign-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ApproveToGateway-id-0026" sourceRef="UserTask-ApproveProgramDesign-id-0003" targetRef="ExclusiveGateway-AutomaticEnrollment-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToAutoEnroll-id-0027" name="automatic_enrollment" sourceRef="ExclusiveGateway-AutomaticEnrollment-id-0004" targetRef="ServiceTask-AutomaticallyEnroll-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToManualEnroll-id-0028" sourceRef="ExclusiveGateway-AutomaticEnrollment-id-0004" targetRef="UserTask-ManuallyEnroll-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-AutoEnrollToEnd-id-0029" sourceRef="ServiceTask-AutomaticallyEnroll-id-0005" targetRef="EndEvent-ProgramActivated-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-ManualEnrollToEnd-id-0030" sourceRef="UserTask-ManuallyEnroll-id-0006" targetRef="EndEvent-ProgramActivated-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-StartToTrack-id-0031" sourceRef="StartEvent-CustomerTransaction-id-0008" targetRef="ServiceTask-TrackTransaction-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-TrackToUpdate-id-0032" sourceRef="ServiceTask-TrackTransaction-id-0009" targetRef="ServiceTask-UpdateLoyaltyBalance-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToEnd-id-0033" sourceRef="ServiceTask-UpdateLoyaltyBalance-id-0010" targetRef="EndEvent-PointsUpdated-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-StartToValidate-id-0034" sourceRef="StartEvent-RewardRedemption-id-0012" targetRef="ServiceTask-ValidateEligibility-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidateToGateway-id-0035" sourceRef="ServiceTask-ValidateEligibility-id-0013" targetRef="ExclusiveGateway-ValidateEligibility-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToProcess-id-0036" name="eligible" sourceRef="ExclusiveGateway-ValidateEligibility-id-0014" targetRef="ServiceTask-ProcessReward-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToSend-id-0037" sourceRef="ExclusiveGateway-ValidateEligibility-id-0014" targetRef="SendTask-SendRejection-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-ProcessToEnd-id-0038" sourceRef="ServiceTask-ProcessReward-id-0015" targetRef="EndEvent-RewardDelivered-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToEnd-id-0039" sourceRef="SendTask-SendRejection-id-0017" targetRef="EndEvent-RedemptionFailed-id-0018" />
    <bpmn:sequenceFlow id="SequenceFlow-StartToGenerate-id-0040" sourceRef="StartEvent-MonthlyProgramReview-id-0019" targetRef="ServiceTask-GenerateReports-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateToAnalyze-id-0041" sourceRef="ServiceTask-GenerateReports-id-0020" targetRef="UserTask-AnalyzeReports-id-0021" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToAdjust-id-0042" sourceRef="UserTask-AnalyzeReports-id-0021" targetRef="ServiceTask-AdjustProgramRules-id-0022" />
    <bpmn:sequenceFlow id="SequenceFlow-AdjustToEnd-id-0043" sourceRef="ServiceTask-AdjustProgramRules-id-0022" targetRef="EndEvent-ProgramUpdated-id-0023" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_LoyaltyProgram-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_LoyaltyProgram-Process-id-0001" bpmnElement="LoyaltyProgram-Process-id-0001">
