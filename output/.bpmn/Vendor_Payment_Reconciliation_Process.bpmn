<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions-invoice-processing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Process-InvoiceProcessing-id-0001">
    <bpmn:startEvent id="StartEvent-ProcessInitiated-id-0001" name="Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToMatch-id-0011</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-MatchInvoice-id-0002" name="Match Invoice to Purchase Order and Receipt">
      <bpmn:incoming>SequenceFlow-StartToMatch-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MatchToGateway-id-0012</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InvoiceMatch-id-0003" name="Invoice Matches?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-MatchToGateway-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToAuthorize-id-0013</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToInvestigate-id-0014</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-InvestigateDiscrepancies-id-0004" name="Investigate and Resolve Discrepancies">
      <bpmn:incoming>SequenceFlow-GatewayToInvestigate-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InvestigateToAuthorize-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AuthorizePayment-id-0005" name="Authorize Payment">
      <bpmn:incoming>SequenceFlow-GatewayToAuthorize-id-0013</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-InvestigateToAuthorize-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AuthorizeToProcess-id-0016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ProcessPayment-id-0006" name="Process Payment via Bank Transfer or Check">
      <bpmn:incoming>SequenceFlow-AuthorizeToProcess-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProcessToSend-id-0017</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-PaymentNotification-id-0007" name="Send: Payment Notification to Vendor">
      <bpmn:incoming>SequenceFlow-ProcessToSend-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToUpdate-id-0018</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-UpdateRecords-id-0008" name="Update Financial Records">
      <bpmn:incoming>SequenceFlow-SendToUpdate-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToGenerate-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GenerateReport-id-0009" name="Generate Reconciliation Report">
      <bpmn:incoming>SequenceFlow-UpdateToGenerate-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateToEnd-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0010" name="Process Complete">
      <bpmn:incoming>SequenceFlow-GenerateToEnd-id-0020</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToMatch-id-0011" sourceRef="StartEvent-ProcessInitiated-id-0001" targetRef="UserTask-MatchInvoice-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-MatchToGateway-id-0012" sourceRef="UserTask-MatchInvoice-id-0002" targetRef="ExclusiveGateway-InvoiceMatch-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToAuthorize-id-0013" name="invoice_matches_purchase_order_and_receipt" sourceRef="ExclusiveGateway-InvoiceMatch-id-0003" targetRef="UserTask-AuthorizePayment-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToInvestigate-id-0014" sourceRef="ExclusiveGateway-InvoiceMatch-id-0003" targetRef="UserTask-InvestigateDiscrepancies-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-InvestigateToAuthorize-id-0015" sourceRef="UserTask-InvestigateDiscrepancies-id-0004" targetRef="UserTask-AuthorizePayment-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-AuthorizeToProcess-id-0016" sourceRef="UserTask-AuthorizePayment-id-0005" targetRef="ServiceTask-ProcessPayment-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-ProcessToSend-id-0017" sourceRef="ServiceTask-ProcessPayment-id-0006" targetRef="SendTask-PaymentNotification-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToUpdate-id-0018" sourceRef="SendTask-PaymentNotification-id-0007" targetRef="ServiceTask-UpdateRecords-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToGenerate-id-0019" sourceRef="ServiceTask-UpdateRecords-id-0008" targetRef="ServiceTask-GenerateReport-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateToEnd-id-0020" sourceRef="ServiceTask-GenerateReport-id-0009" targetRef="EndEvent-ProcessComplete-id-0010" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process-InvoiceProcessing-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Process-InvoiceProcessing-id-0001" bpmnElement="Process-InvoiceProcessing-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProcessInitiated-id-0001_di" bpmnElement="StartEvent-ProcessInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-MatchInvoice-id-0002_di" bpmnElement="UserTask-MatchInvoice-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-InvoiceMatch-id-0003_di" bpmnElement="ExclusiveGateway-InvoiceMatch-id-0003" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AuthorizePayment-id-0005_di" bpmnElement="UserTask-AuthorizePayment-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcessPayment-id-0006_di" bpmnElement="ServiceTask-ProcessPayment-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-PaymentNotification-id-0007_di" bpmnElement="SendTask-PaymentNotification-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-UpdateRecords-id-0008_di" bpmnElement="ServiceTask-UpdateRecords-id-0008">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateReport-id-0009_di" bpmnElement="ServiceTask-GenerateReport-id-0009">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessComplete-id-0010_di" bpmnElement="EndEvent-ProcessComplete-id-0010">
        <dc:Bounds x="1407" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-InvestigateDiscrepancies-id-0004_di" bpmnElement="UserTask-InvestigateDiscrepancies-id-0004">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToMatch-id-0011_di" bpmnElement="SequenceFlow-StartToMatch-id-0011">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MatchToGateway-id-0012_di" bpmnElement="SequenceFlow-MatchToGateway-id-0012">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToAuthorize-id-0013_di" bpmnElement="SequenceFlow-GatewayToAuthorize-id-0013">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToInvestigate-id-0014_di" bpmnElement="SequenceFlow-GatewayToInvestigate-id-0014">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="210" />
        <di:waypoint x="475" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AuthorizeToProcess-id-0016_di" bpmnElement="SequenceFlow-AuthorizeToProcess-id-0016">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProcessToSend-id-0017_di" bpmnElement="SequenceFlow-ProcessToSend-id-0017">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendToUpdate-id-0018_di" bpmnElement="SequenceFlow-SendToUpdate-id-0018">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UpdateToGenerate-id-0019_di" bpmnElement="SequenceFlow-UpdateToGenerate-id-0019">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GenerateToEnd-id-0020_di" bpmnElement="SequenceFlow-GenerateToEnd-id-0020">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1407" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InvestigateToAuthorize-id-0015_di" bpmnElement="SequenceFlow-InvestigateToAuthorize-id-0015">
        <di:waypoint x="575" y="210" />
        <di:waypoint x="675" y="210" />
        <di:waypoint x="675" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
