<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="grievance-process-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Grievance-Process-id-0001" name="Grievance Process">
    <bpmn:startEvent id="StartEvent-GrievanceProcessInitiated-id-0001" name="Grievance Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToEmployeeRaises-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-EmployeeRaisesGrievance-id-0002" name="Employee raises grievance">
      <bpmn:incoming>SequenceFlow-StartToEmployeeRaises-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployeeRaisesToHRSchedules-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-HRSchedulesMeeting-id-0003" name="HR schedules meeting">
      <bpmn:incoming>SequenceFlow-EmployeeRaisesToHRSchedules-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HRSchedulesToInvestigate-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-InvestigateGrievance-id-0004" name="Investigate grievance">
      <bpmn:incoming>SequenceFlow-HRSchedulesToInvestigate-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InvestigateToPropose-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ProposeSolutions-id-0005" name="Propose solutions">
      <bpmn:incoming>SequenceFlow-InvestigateToPropose-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProposeToAgree-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AgreeOnSolutions-id-0006" name="Agree on solutions">
      <bpmn:incoming>SequenceFlow-ProposeToAgree-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AgreeToFollowUp-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-FollowUpOnResolution-id-0007" name="Follow up on resolution">
      <bpmn:incoming>SequenceFlow-AgreeToFollowUp-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FollowUpToDocument-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DocumentAndCloseCase-id-0008" name="Document and close case">
      <bpmn:incoming>SequenceFlow-FollowUpToDocument-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentToEnd-id-0008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-GrievanceProcessComplete-id-0009" name="Grievance Process Complete">
      <bpmn:incoming>SequenceFlow-DocumentToEnd-id-0008</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToEmployeeRaises-id-0001" sourceRef="StartEvent-GrievanceProcessInitiated-id-0001" targetRef="UserTask-EmployeeRaisesGrievance-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployeeRaisesToHRSchedules-id-0002" sourceRef="UserTask-EmployeeRaisesGrievance-id-0002" targetRef="UserTask-HRSchedulesMeeting-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-HRSchedulesToInvestigate-id-0003" sourceRef="UserTask-HRSchedulesMeeting-id-0003" targetRef="UserTask-InvestigateGrievance-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-InvestigateToPropose-id-0004" sourceRef="UserTask-InvestigateGrievance-id-0004" targetRef="UserTask-ProposeSolutions-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ProposeToAgree-id-0005" sourceRef="UserTask-ProposeSolutions-id-0005" targetRef="UserTask-AgreeOnSolutions-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-AgreeToFollowUp-id-0006" sourceRef="UserTask-AgreeOnSolutions-id-0006" targetRef="UserTask-FollowUpOnResolution-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-FollowUpToDocument-id-0007" sourceRef="UserTask-FollowUpOnResolution-id-0007" targetRef="UserTask-DocumentAndCloseCase-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-DocumentToEnd-id-0008" sourceRef="UserTask-DocumentAndCloseCase-id-0008" targetRef="EndEvent-GrievanceProcessComplete-id-0009" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Grievance-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Grievance-Process-id-0001" bpmnElement="Grievance-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-GrievanceProcessInitiated-id-0001_di" bpmnElement="StartEvent-GrievanceProcessInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EmployeeRaisesGrievance-id-0002_di" bpmnElement="UserTask-EmployeeRaisesGrievance-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-HRSchedulesMeeting-id-0003_di" bpmnElement="UserTask-HRSchedulesMeeting-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-InvestigateGrievance-id-0004_di" bpmnElement="UserTask-InvestigateGrievance-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ProposeSolutions-id-0005_di" bpmnElement="UserTask-ProposeSolutions-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AgreeOnSolutions-id-0006_di" bpmnElement="UserTask-AgreeOnSolutions-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-FollowUpOnResolution-id-0007_di" bpmnElement="UserTask-FollowUpOnResolution-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DocumentAndCloseCase-id-0008_di" bpmnElement="UserTask-DocumentAndCloseCase-id-0008">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-GrievanceProcessComplete-id-0009_di" bpmnElement="EndEvent-GrievanceProcessComplete-id-0009">
        <dc:Bounds x="1257" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToEmployeeRaises-id-0001_di" bpmnElement="SequenceFlow-StartToEmployeeRaises-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EmployeeRaisesToHRSchedules-id-0002_di" bpmnElement="SequenceFlow-EmployeeRaisesToHRSchedules-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-HRSchedulesToInvestigate-id-0003_di" bpmnElement="SequenceFlow-HRSchedulesToInvestigate-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InvestigateToPropose-id-0004_di" bpmnElement="SequenceFlow-InvestigateToPropose-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProposeToAgree-id-0005_di" bpmnElement="SequenceFlow-ProposeToAgree-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AgreeToFollowUp-id-0006_di" bpmnElement="SequenceFlow-AgreeToFollowUp-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FollowUpToDocument-id-0007_di" bpmnElement="SequenceFlow-FollowUpToDocument-id-0007">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DocumentToEnd-id-0008_di" bpmnElement="SequenceFlow-DocumentToEnd-id-0008">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1257" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
