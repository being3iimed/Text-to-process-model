<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="contract-renewal-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="ContractRenewalProcess-id-0001">
    <bpmn:startEvent id="StartEvent-ProcessStarts-id-0001" name="Contract Renewal Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToSplit-id-0020</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0001" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StartToSplit-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToReviewTerms-id-0021</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToAssessPerformance-id-0022</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-ReviewContractTerms-id-0002" name="Procurement Team Reviews Current Contract Terms">
      <bpmn:incoming>SequenceFlow-SplitToReviewTerms-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewTermsToJoin-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AssessSupplierPerformance-id-0003" name="Procurement Team Assesses Supplier Performance">
      <bpmn:incoming>SequenceFlow-SplitToAssessPerformance-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssessPerformanceToJoin-id-0024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0004" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ReviewTermsToJoin-id-0023</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AssessPerformanceToJoin-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToMarketResearch-id-0025</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-ConductMarketResearch-id-0005" name="Conduct Market Research on Alternative Suppliers">
      <bpmn:incoming>SequenceFlow-JoinToMarketResearch-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MarketResearchToNegotiate-id-0026</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-NegotiateWithSupplier-id-0006" name="Negotiate with Existing Supplier">
      <bpmn:incoming>SequenceFlow-MarketResearchToNegotiate-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NegotiateToGateway-id-0027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AgreementReached-id-0007" name="Agreement Reached?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-NegotiateToGateway-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToDraft-id-0028</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToFailed-id-0029</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-DraftNewContract-id-0008" name="Draft New Contract">
      <bpmn:incoming>SequenceFlow-GatewayToDraft-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DraftToSplit2-id-0030</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Split2-id-0009" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-DraftToSplit2-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Split2ToLegalReview-id-0031</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-Split2ToStakeholderReview-id-0032</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-LegalReview-id-0010" name="Legal Team Reviews Contract">
      <bpmn:incoming>SequenceFlow-Split2ToLegalReview-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LegalReviewToJoin2-id-0033</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-StakeholderReview-id-0011" name="Other Stakeholders Review Contract">
      <bpmn:incoming>SequenceFlow-Split2ToStakeholderReview-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StakeholderReviewToJoin2-id-0034</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Join2-id-0012" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-LegalReviewToJoin2-id-0033</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-StakeholderReviewToJoin2-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Join2ToSign-id-0035</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-SignContract-id-0013" name="Sign Contract">
      <bpmn:incoming>SequenceFlow-Join2ToSign-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SignToSplit3-id-0036</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Split3-id-0014" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SignToSplit3-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Split3ToStore-id-0037</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-Split3ToSend-id-0038</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-StoreContract-id-0015" name="Store Updated Contract in Database">
      <bpmn:incoming>SequenceFlow-Split3ToStore-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StoreToJoin3-id-0039</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendContract-id-0016" name="Send: Contract to Relevant Stakeholders">
      <bpmn:incoming>SequenceFlow-Split3ToSend-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToJoin3-id-0040</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="ParallelGateway-Join3-id-0017" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-StoreToJoin3-id-0039</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SendToJoin3-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Join3ToComplete-id-0041</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0018" name="Contract Renewal Complete">
      <bpmn:incoming>SequenceFlow-Join3ToComplete-id-0041</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-ProcessFailed-id-0019" name="Contract Renewal Failed">
      <bpmn:incoming>SequenceFlow-GatewayToFailed-id-0029</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0020" sourceRef="StartEvent-ProcessStarts-id-0001" targetRef="ParallelGateway-Split-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToReviewTerms-id-0021" sourceRef="ParallelGateway-Split-id-0001" targetRef="UserTask-ReviewContractTerms-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToAssessPerformance-id-0022" sourceRef="ParallelGateway-Split-id-0001" targetRef="UserTask-AssessSupplierPerformance-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewTermsToJoin-id-0023" sourceRef="UserTask-ReviewContractTerms-id-0002" targetRef="ParallelGateway-Join-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-AssessPerformanceToJoin-id-0024" sourceRef="UserTask-AssessSupplierPerformance-id-0003" targetRef="ParallelGateway-Join-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToMarketResearch-id-0025" sourceRef="ParallelGateway-Join-id-0004" targetRef="ServiceTask-ConductMarketResearch-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-MarketResearchToNegotiate-id-0026" sourceRef="ServiceTask-ConductMarketResearch-id-0005" targetRef="UserTask-NegotiateWithSupplier-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-NegotiateToGateway-id-0027" sourceRef="UserTask-NegotiateWithSupplier-id-0006" targetRef="ExclusiveGateway-AgreementReached-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToDraft-id-0028" name="agreement_reached" sourceRef="ExclusiveGateway-AgreementReached-id-0007" targetRef="ServiceTask-DraftNewContract-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToFailed-id-0029" sourceRef="ExclusiveGateway-AgreementReached-id-0007" targetRef="EndEvent-ProcessFailed-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-DraftToSplit2-id-0030" sourceRef="ServiceTask-DraftNewContract-id-0008" targetRef="ParallelGateway-Split2-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-Split2ToLegalReview-id-0031" sourceRef="ParallelGateway-Split2-id-0009" targetRef="UserTask-LegalReview-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-Split2ToStakeholderReview-id-0032" sourceRef="ParallelGateway-Split2-id-0009" targetRef="UserTask-StakeholderReview-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-LegalReviewToJoin2-id-0033" sourceRef="UserTask-LegalReview-id-0010" targetRef="ParallelGateway-Join2-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-StakeholderReviewToJoin2-id-0034" sourceRef="UserTask-StakeholderReview-id-0011" targetRef="ParallelGateway-Join2-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-Join2ToSign-id-0035" sourceRef="ParallelGateway-Join2-id-0012" targetRef="UserTask-SignContract-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-SignToSplit3-id-0036" sourceRef="UserTask-SignContract-id-0013" targetRef="ParallelGateway-Split3-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-Split3ToStore-id-0037" sourceRef="ParallelGateway-Split3-id-0014" targetRef="ServiceTask-StoreContract-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-Split3ToSend-id-0038" sourceRef="ParallelGateway-Split3-id-0014" targetRef="SendTask-SendContract-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-StoreToJoin3-id-0039" sourceRef="ServiceTask-StoreContract-id-0015" targetRef="ParallelGateway-Join3-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToJoin3-id-0040" sourceRef="SendTask-SendContract-id-0016" targetRef="ParallelGateway-Join3-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-Join3ToComplete-id-0041" sourceRef="ParallelGateway-Join3-id-0017" targetRef="EndEvent-ProcessComplete-id-0018" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ContractRenewalProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_ContractRenewalProcess-id-0001" bpmnElement="ContractRenewalProcess-id-0001">
