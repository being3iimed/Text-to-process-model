<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Vendor-Onboarding-Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Vendor-Onboarding-Process-id-0001" name="Vendor Onboarding Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-VendorOnboardingProcessStarts-id-0001" name="Vendor Onboarding Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToCollect-id-0016</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CollectVendorDocumentation-id-0002" name="Collect Vendor Documentation">
      <bpmn:incoming>SequenceFlow-StartToCollect-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CollectToEnter-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-EnterVendorInformation-id-0003" name="Enter Vendor Information">
      <bpmn:incoming>SequenceFlow-CollectToEnter-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnterToCheck-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PerformComplianceChecks-id-0004" name="Perform Compliance Checks">
      <bpmn:incoming>SequenceFlow-EnterToCheck-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckToGateway-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ComplianceChecksPassed-id-0005" name="Compliance Checks Passed?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckToGateway-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToAssign-id-0020</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToSend-id-0029</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-AssignVendorID-id-0006" name="Assign Vendor ID">
      <bpmn:incoming>SequenceFlow-GatewayToAssign-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignToParallelSplit-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0007" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AssignToParallelSplit-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ParallelSplitToPayment-id-0022</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ParallelSplitToLogistics-id-0023</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-IntegrateIntoPaymentSystem-id-0008" name="Integrate into Payment System">
      <bpmn:incoming>SequenceFlow-ParallelSplitToPayment-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PaymentToParallelJoin-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-IntegrateIntoLogisticsSystem-id-0009" name="Integrate into Logistics System">
      <bpmn:incoming>SequenceFlow-ParallelSplitToLogistics-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LogisticsToParallelJoin-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0010" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-PaymentToParallelJoin-id-0024</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-LogisticsToParallelJoin-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ParallelJoinToTraining-id-0026</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-ConductTrainingSessions-id-0011" name="Conduct Training Sessions">
      <bpmn:incoming>SequenceFlow-ParallelJoinToTraining-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainingToUpdate-id-0027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-UpdateVendorStatus-id-0012" name="Update Vendor Status">
      <bpmn:incoming>SequenceFlow-TrainingToUpdate-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToEnd-id-0028</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-VendorFullyOnboarded-id-0013" name="Vendor Fully Onboarded">
      <bpmn:incoming>SequenceFlow-UpdateToEnd-id-0028</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-SendComplianceFailureNotification-id-0014" name="Send: compliance failure notification">
      <bpmn:incoming>SequenceFlow-GatewayToSend-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToEnd-id-0030</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-VendorOnboardingFailed-id-0015" name="Vendor Onboarding Failed">
      <bpmn:incoming>SequenceFlow-SendToEnd-id-0030</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCollect-id-0016" sourceRef="StartEvent-VendorOnboardingProcessStarts-id-0001" targetRef="UserTask-CollectVendorDocumentation-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CollectToEnter-id-0017" sourceRef="UserTask-CollectVendorDocumentation-id-0002" targetRef="ServiceTask-EnterVendorInformation-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-EnterToCheck-id-0018" sourceRef="ServiceTask-EnterVendorInformation-id-0003" targetRef="ServiceTask-PerformComplianceChecks-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckToGateway-id-0019" sourceRef="ServiceTask-PerformComplianceChecks-id-0004" targetRef="ExclusiveGateway-ComplianceChecksPassed-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToAssign-id-0020" name="Yes" sourceRef="ExclusiveGateway-ComplianceChecksPassed-id-0005" targetRef="ServiceTask-AssignVendorID-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-AssignToParallelSplit-id-0021" sourceRef="ServiceTask-AssignVendorID-id-0006" targetRef="ParallelGateway-Split-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelSplitToPayment-id-0022" sourceRef="ParallelGateway-Split-id-0007" targetRef="ServiceTask-IntegrateIntoPaymentSystem-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelSplitToLogistics-id-0023" sourceRef="ParallelGateway-Split-id-0007" targetRef="ServiceTask-IntegrateIntoLogisticsSystem-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-PaymentToParallelJoin-id-0024" sourceRef="ServiceTask-IntegrateIntoPaymentSystem-id-0008" targetRef="ParallelGateway-Join-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-LogisticsToParallelJoin-id-0025" sourceRef="ServiceTask-IntegrateIntoLogisticsSystem-id-0009" targetRef="ParallelGateway-Join-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelJoinToTraining-id-0026" sourceRef="ParallelGateway-Join-id-0010" targetRef="UserTask-ConductTrainingSessions-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-TrainingToUpdate-id-0027" sourceRef="UserTask-ConductTrainingSessions-id-0011" targetRef="ServiceTask-UpdateVendorStatus-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToEnd-id-0028" sourceRef="ServiceTask-UpdateVendorStatus-id-0012" targetRef="EndEvent-VendorFullyOnboarded-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToSend-id-0029" name="No" sourceRef="ExclusiveGateway-ComplianceChecksPassed-id-0005" targetRef="SendTask-SendComplianceFailureNotification-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToEnd-id-0030" sourceRef="SendTask-SendComplianceFailureNotification-id-0014" targetRef="EndEvent-VendorOnboardingFailed-id-0015" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Vendor-Onboarding-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Vendor-Onboarding-Process-id-0001" bpmnElement="Vendor-Onboarding-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-VendorOnboardingProcessStarts-id-0001_di" bpmnElement="StartEvent-VendorOnboardingProcessStarts-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CollectVendorDocumentation-id-0002_di" bpmnElement="UserTask-CollectVendorDocumentation-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-EnterVendorInformation-id-0003_di" bpmnElement="ServiceTask-EnterVendorInformation-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PerformComplianceChecks-id-0004_di" bpmnElement="ServiceTask-PerformComplianceChecks-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ComplianceChecksPassed-id-0005_di" bpmnElement="ExclusiveGateway-ComplianceChecksPassed-id-0005" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AssignVendorID-id-0006_di" bpmnElement="ServiceTask-AssignVendorID-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Split-id-0007_di" bpmnElement="ParallelGateway-Split-id-0007">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-IntegrateIntoPaymentSystem-id-0008_di" bpmnElement="ServiceTask-IntegrateIntoPaymentSystem-id-0008">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Join-id-0010_di" bpmnElement="ParallelGateway-Join-id-0010">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ConductTrainingSessions-id-0011_di" bpmnElement="UserTask-ConductTrainingSessions-id-0011">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-UpdateVendorStatus-id-0012_di" bpmnElement="ServiceTask-UpdateVendorStatus-id-0012">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-VendorFullyOnboarded-id-0013_di" bpmnElement="EndEvent-VendorFullyOnboarded-id-0013">
        <dc:Bounds x="1707" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendComplianceFailureNotification-id-0014_di" bpmnElement="SendTask-SendComplianceFailureNotification-id-0014">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-VendorOnboardingFailed-id-0015_di" bpmnElement="EndEvent-VendorOnboardingFailed-id-0015">
        <dc:Bounds x="957" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-IntegrateIntoLogisticsSystem-id-0009_di" bpmnElement="ServiceTask-IntegrateIntoLogisticsSystem-id-0009">
        <dc:Bounds x="1225" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCollect-id-0016_di" bpmnElement="SequenceFlow-StartToCollect-id-0016">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CollectToEnter-id-0017_di" bpmnElement="SequenceFlow-CollectToEnter-id-0017">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EnterToCheck-id-0018_di" bpmnElement="SequenceFlow-EnterToCheck-id-0018">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckToGateway-id-0019_di" bpmnElement="SequenceFlow-CheckToGateway-id-0019">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToAssign-id-0020_di" bpmnElement="SequenceFlow-GatewayToAssign-id-0020">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToSend-id-0029_di" bpmnElement="SequenceFlow-GatewayToSend-id-0029">
        <di:waypoint x="675" y="95" />
        <di:waypoint x="675" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssignToParallelSplit-id-0021_di" bpmnElement="SequenceFlow-AssignToParallelSplit-id-0021">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="950" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ParallelSplitToPayment-id-0022_di" bpmnElement="SequenceFlow-ParallelSplitToPayment-id-0022">
        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ParallelSplitToLogistics-id-0023_di" bpmnElement="SequenceFlow-ParallelSplitToLogistics-id-0023">
        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1050" y="70" />
        <di:waypoint x="1050" y="140" />
        <di:waypoint x="1200" y="140" />
        <di:waypoint x="1200" y="210" />
        <di:waypoint x="1225" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PaymentToParallelJoin-id-0024_di" bpmnElement="SequenceFlow-PaymentToParallelJoin-id-0024">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1250" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ParallelJoinToTraining-id-0026_di" bpmnElement="SequenceFlow-ParallelJoinToTraining-id-0026">
        <di:waypoint x="1300" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TrainingToUpdate-id-0027_di" bpmnElement="SequenceFlow-TrainingToUpdate-id-0027">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1525" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UpdateToEnd-id-0028_di" bpmnElement="SequenceFlow-UpdateToEnd-id-0028">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1707" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendToEnd-id-0030_di" bpmnElement="SequenceFlow-SendToEnd-id-0030">
        <di:waypoint x="875" y="210" />
        <di:waypoint x="957" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LogisticsToParallelJoin-id-0025_di" bpmnElement="SequenceFlow-LogisticsToParallelJoin-id-0025">
        <di:waypoint x="1275" y="170" />
        <di:waypoint x="1275" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
