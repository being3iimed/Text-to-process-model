  <bpmn:process id="ReturnProcess-id-0001" name="Return Process">
    <bpmn:startEvent id="StartEvent-ReturnProcessInitiated-id-0001" name="Return Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToVerify-id-0026</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-VerifyReturnReason-id-0002" name="Customer Service Team Verifies Return Reason">
      <bpmn:incoming>SequenceFlow-StartToVerify-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToSplit-id-0027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0003" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-VerifyToSplit-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToCheckPolicy-id-0028</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToVerifyEligibility-id-0029</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-CheckReturnPolicy-id-0004" name="Check Return Policy">
      <bpmn:incoming>SequenceFlow-SplitToCheckPolicy-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckPolicyToJoin-id-0030</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-VerifyProductEligibility-id-0005" name="Verify Product Eligibility">
      <bpmn:incoming>SequenceFlow-SplitToVerifyEligibility-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyEligibilityToJoin-id-0031</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0006" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-CheckPolicyToJoin-id-0030</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-VerifyEligibilityToJoin-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToExclusive-id-0032</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="ExclusiveGateway-EligibleForReturn-id-0007" name="Eligible for Return?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-JoinToExclusive-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExclusiveYesToIssue-id-0033</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ExclusiveNoToSend2-id-0050</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-IssueReturnAuthorization-id-0008" name="Issue Return Authorization">
      <bpmn:incoming>SequenceFlow-ExclusiveYesToIssue-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IssueToSend-id-0034</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendReturnAuthorization-id-0009" name="Send: Return Authorization to Customer">
      <bpmn:incoming>SequenceFlow-IssueToSend-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToReceive-id-0035</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveReturnedProduct-id-0010" name="Receive: Returned Product">
      <bpmn:incoming>SequenceFlow-SendToReceive-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToLog-id-0036</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="ServiceTask-LogReturnedProduct-id-0011" name="Log Returned Product">
      <bpmn:incoming>SequenceFlow-ReceiveToLog-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LogToInspect-id-0037</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-QualityControlInspection-id-0012" name="Quality Control Inspects Returned Product">
      <bpmn:incoming>SequenceFlow-LogToInspect-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InspectToExclusive-id-0038</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ProductMeetsCriteria-id-0013" name="Product Meets Return Criteria?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-InspectToExclusive-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExclusiveYesToProcess-id-0039</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ExclusiveNoToSend-id-0047</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ProcessRefund-id-0014" name="Process Refund">
      <bpmn:incoming>SequenceFlow-ExclusiveYesToProcess-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProcessToSend-id-0040</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendRefundConfirmation-id-0015" name="Send: Refund Confirmation to Customer">
      <bpmn:incoming>SequenceFlow-ProcessToSend-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToSplit2-id-0041</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="ParallelGateway-Split2-id-0016" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SendToSplit2-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Split2ToRestock-id-0042</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-Split2ToUpdate-id-0043</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-RestockProduct-id-0017" name="Restock Returned Product">
      <bpmn:incoming>SequenceFlow-Split2ToRestock-id-0042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RestockToJoin2-id-0044</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-UpdateInventory-id-0018" name="Update Inventory System">
      <bpmn:incoming>SequenceFlow-Split2ToUpdate-id-0043</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToJoin2-id-0045</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Join2-id-0019" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-RestockToJoin2-id-0044</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-UpdateToJoin2-id-0045</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Join2ToEnd-id-0046</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="SendTask-SendRejectionNotice-id-0020" name="Send: Rejection Notice to Customer">
      <bpmn:incoming>SequenceFlow-ExclusiveNoToSend-id-0047</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToHandle-id-0048</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-HandleNonReturnable-id-0021" name="Handle Non-Returnable Product">
      <bpmn:incoming>SequenceFlow-SendToHandle-id-0048</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HandleToEnd-id-0049</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendReturnRejection-id-0022" name="Send: Return Rejection Notice to Customer">
      <bpmn:incoming>SequenceFlow-ExclusiveNoToSend2-id-0050</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Send2ToEnd-id-0051</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ReturnProcessComplete-id-0023" name="Return Process Complete">
      <bpmn:incoming>SequenceFlow-Join2ToEnd-id-0046</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-ReturnProcessComplete2-id-0024" name="Return Process Complete">
      <bpmn:incoming>SequenceFlow-HandleToEnd-id-0049</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-ReturnProcessComplete3-id-0025" name="Return Process Complete">
      <bpmn:incoming>SequenceFlow-Send2ToEnd-id-0051</bpmn:incoming>
    </bpmn:endEvent>
