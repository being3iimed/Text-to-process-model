<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Employee-Resignation-Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Employee-Resignation-Process-id-0001" name="Employee Resignation Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-EmployeeResignationProcessInitiated-id-0001" name="Employee Resignation Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToSplit-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0001" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StartToSplit-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToManagerTask-id-0002</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToEmployeeTask-id-0003</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-ManagerSchedulesExitInterview-id-0002" name="Manager schedules exit interview">
      <bpmn:incoming>SequenceFlow-SplitToManagerTask-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ManagerTaskToJoin-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-EmployeeBeginsDocumentingResponsibilities-id-0003" name="Employee begins documenting responsibilities">
      <bpmn:incoming>SequenceFlow-SplitToEmployeeTask-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployeeTaskToJoin-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0004" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ManagerTaskToJoin-id-0004</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-EmployeeTaskToJoin-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToChecklistTask-id-0006</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-EmployeeCompletesKnowledgeTransferChecklist-id-0005" name="Employee completes knowledge transfer checklist">
      <bpmn:incoming>SequenceFlow-JoinToChecklistTask-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ChecklistToGateway-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-SuccessorAvailable-id-0006" name="Successor Available?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ChecklistToGateway-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToSuccessorTask-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToInclusiveSplit-id-0010</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-EmployeeSharesCriticalKnowledgeWithSuccessor-id-0007" name="Employee shares critical knowledge with successor">
      <bpmn:incoming>SequenceFlow-GatewayToSuccessorTask-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SuccessorTaskToVerify-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-VerifyKnowledgeTransferCompletion-id-0008" name="Verify knowledge transfer completion">
      <bpmn:incoming>SequenceFlow-SuccessorTaskToVerify-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToAdminTask-id-0016</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="InclusiveGateway-KnowledgeTransferOptions-id-0009" name="Knowledge Transfer Options">
      <bpmn:incoming>SequenceFlow-GatewayToInclusiveSplit-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InclusiveSplitToVideoTask-id-0011</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-InclusiveSplitToGuideTask-id-0012</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="UserTask-EmployeeRecordsVideoTutorials-id-0010" name="Employee records video tutorials">
      <bpmn:incoming>SequenceFlow-InclusiveSplitToVideoTask-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VideoTaskToJoin-id-0013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-EmployeeWritesDetailedGuides-id-0011" name="Employee writes detailed guides">
      <bpmn:incoming>SequenceFlow-InclusiveSplitToGuideTask-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GuideTaskToJoin-id-0014</bpmn:outgoing>
