      <bpmn:incoming>SequenceFlow-GuideTaskToJoin-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InclusiveJoinToVerify-id-0015</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-VerifyKnowledgeTransferCompletion2-id-0013" name="Verify knowledge transfer completion">
      <bpmn:incoming>SequenceFlow-InclusiveJoinToVerify-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Verify2ToAdminTask-id-0017</bpmn:outgoing>
