    <bpmn:sequenceFlow id="SequenceFlow-ChecklistToGateway-id-0007" sourceRef="UserTask-EmployeeCompletesKnowledgeTransferChecklist-id-0005" targetRef="ExclusiveGateway-SuccessorAvailable-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToSuccessorTask-id-0008" name="successor_available" sourceRef="ExclusiveGateway-SuccessorAvailable-id-0006" targetRef="UserTask-EmployeeSharesCriticalKnowledgeWithSuccessor-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-SuccessorTaskToVerify-id-0009" sourceRef="UserTask-EmployeeSharesCriticalKnowledgeWithSuccessor-id-0007" targetRef="ServiceTask-VerifyKnowledgeTransferCompletion-id-0008" />
