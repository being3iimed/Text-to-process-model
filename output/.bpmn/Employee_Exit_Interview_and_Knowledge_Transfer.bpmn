    <bpmn:sequenceFlow id="SequenceFlow-InclusiveSplitToVideoTask-id-0011" name="video_tutorials_needed" sourceRef="InclusiveGateway-KnowledgeTransferOptions-id-0009" targetRef="UserTask-EmployeeRecordsVideoTutorials-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-InclusiveSplitToGuideTask-id-0012" name="detailed_guides_needed" sourceRef="InclusiveGateway-KnowledgeTransferOptions-id-0009" targetRef="UserTask-EmployeeWritesDetailedGuides-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-VideoTaskToJoin-id-0013" sourceRef="UserTask-EmployeeRecordsVideoTutorials-id-0010" targetRef="InclusiveGateway-KnowledgeTransferJoin-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-GuideTaskToJoin-id-0014" sourceRef="UserTask-EmployeeWritesDetailedGuides-id-0011" targetRef="InclusiveGateway-KnowledgeTransferJoin-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-InclusiveJoinToVerify-id-0015" sourceRef="InclusiveGateway-KnowledgeTransferJoin-id-0012" targetRef="ServiceTask-VerifyKnowledgeTransferCompletion2-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyToAdminTask-id-0016" sourceRef="ServiceTask-VerifyKnowledgeTransferCompletion-id-0008" targetRef="ServiceTask-AdministrativeProcessingForFinalDay-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-Verify2ToAdminTask-id-0017" sourceRef="ServiceTask-VerifyKnowledgeTransferCompletion2-id-0013" targetRef="ServiceTask-AdministrativeProcessingForFinalDay-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-AdminTaskToEnd-id-0018" sourceRef="ServiceTask-AdministrativeProcessingForFinalDay-id-0014" targetRef="EndEvent-EmployeeExitProcessComplete-id-0015" />
