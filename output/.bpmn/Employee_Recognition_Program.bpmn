<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Recognition-Process-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Recognition-Process-id-0001" name="Employee Recognition Process">
    <bpmn:startEvent id="StartEvent-RecognitionProcessInitiated-id-0001" name="Recognition Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToNominate-id-0009</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ManagerNominatesEmployee-id-0002" name="Manager Nominates Employee">
      <bpmn:incoming>SequenceFlow-StartToNominate-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NominateToEvaluate-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-EvaluateNominees-id-0003" name="Evaluate Nominees">
      <bpmn:incoming>SequenceFlow-NominateToEvaluate-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EvaluateToAnnounce-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AnnounceWinners-id-0004" name="Announce Winners">
      <bpmn:incoming>SequenceFlow-EvaluateToAnnounce-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnnounceToCelebrate-id-0012</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CelebrateAchievements-id-0005" name="Celebrate Achievements">
      <bpmn:incoming>SequenceFlow-AnnounceToCelebrate-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CelebrateToAward-id-0013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AwardCertificatesBonusesIncentives-id-0006" name="Award Certificates, Bonuses, or Incentives">
      <bpmn:incoming>SequenceFlow-CelebrateToAward-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AwardToFeedback-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CollectFeedbackForProgramImprovement-id-0007" name="Collect Feedback for Program Improvement">
      <bpmn:incoming>SequenceFlow-AwardToFeedback-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeedbackToEnd-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-RecognitionProcessComplete-id-0008" name="Recognition Process Complete">
      <bpmn:incoming>SequenceFlow-FeedbackToEnd-id-0015</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToNominate-id-0009" sourceRef="StartEvent-RecognitionProcessInitiated-id-0001" targetRef="UserTask-ManagerNominatesEmployee-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-NominateToEvaluate-id-0010" sourceRef="UserTask-ManagerNominatesEmployee-id-0002" targetRef="UserTask-EvaluateNominees-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-EvaluateToAnnounce-id-0011" sourceRef="UserTask-EvaluateNominees-id-0003" targetRef="UserTask-AnnounceWinners-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-AnnounceToCelebrate-id-0012" sourceRef="UserTask-AnnounceWinners-id-0004" targetRef="UserTask-CelebrateAchievements-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-CelebrateToAward-id-0013" sourceRef="UserTask-CelebrateAchievements-id-0005" targetRef="UserTask-AwardCertificatesBonusesIncentives-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-AwardToFeedback-id-0014" sourceRef="UserTask-AwardCertificatesBonusesIncentives-id-0006" targetRef="UserTask-CollectFeedbackForProgramImprovement-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-FeedbackToEnd-id-0015" sourceRef="UserTask-CollectFeedbackForProgramImprovement-id-0007" targetRef="EndEvent-RecognitionProcessComplete-id-0008" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Recognition-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Recognition-Process-id-0001" bpmnElement="Recognition-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-RecognitionProcessInitiated-id-0001_di" bpmnElement="StartEvent-RecognitionProcessInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ManagerNominatesEmployee-id-0002_di" bpmnElement="UserTask-ManagerNominatesEmployee-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EvaluateNominees-id-0003_di" bpmnElement="UserTask-EvaluateNominees-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AnnounceWinners-id-0004_di" bpmnElement="UserTask-AnnounceWinners-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CelebrateAchievements-id-0005_di" bpmnElement="UserTask-CelebrateAchievements-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AwardCertificatesBonusesIncentives-id-0006_di" bpmnElement="UserTask-AwardCertificatesBonusesIncentives-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CollectFeedbackForProgramImprovement-id-0007_di" bpmnElement="UserTask-CollectFeedbackForProgramImprovement-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RecognitionProcessComplete-id-0008_di" bpmnElement="EndEvent-RecognitionProcessComplete-id-0008">
        <dc:Bounds x="1107" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToNominate-id-0009_di" bpmnElement="SequenceFlow-StartToNominate-id-0009">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-NominateToEvaluate-id-0010_di" bpmnElement="SequenceFlow-NominateToEvaluate-id-0010">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EvaluateToAnnounce-id-0011_di" bpmnElement="SequenceFlow-EvaluateToAnnounce-id-0011">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnnounceToCelebrate-id-0012_di" bpmnElement="SequenceFlow-AnnounceToCelebrate-id-0012">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CelebrateToAward-id-0013_di" bpmnElement="SequenceFlow-CelebrateToAward-id-0013">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AwardToFeedback-id-0014_di" bpmnElement="SequenceFlow-AwardToFeedback-id-0014">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FeedbackToEnd-id-0015_di" bpmnElement="SequenceFlow-FeedbackToEnd-id-0015">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1107" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
