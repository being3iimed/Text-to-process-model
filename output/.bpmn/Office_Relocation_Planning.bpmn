<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="office-relocation-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="OfficeRelocationProcess-id-0001" name="Office Relocation Process">
    <bpmn:startEvent id="StartEvent-OfficeRelocationProcessBegins-id-0001" name="Office Relocation Process Begins">
      <bpmn:outgoing>SequenceFlow-StartToSelect-id-0022</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-SelectNewOfficeLocation-id-0002" name="Select new office location based on space requirements and proximity to clients">
      <bpmn:incoming>SequenceFlow-StartToSelect-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToFormCommittee-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-FormRelocationCommittee-id-0003" name="Form relocation committee to oversee logistics">
      <bpmn:incoming>SequenceFlow-SelectToFormCommittee-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FormCommitteeToSplit-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0004" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-FormCommitteeToSplit-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToFurnitureMovers-id-0025</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToITSetup-id-0026</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToCommunication-id-0027</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-AssignFurnitureMovers-id-0005" name="Assign furniture movers">
      <bpmn:incoming>SequenceFlow-SplitToFurnitureMovers-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FurnitureMoversToJoin-id-0028</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AssignITSetupTeam-id-0006" name="Assign IT setup team">
      <bpmn:incoming>SequenceFlow-SplitToITSetup-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ITSetupToJoin-id-0029</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AssignCommunicationTeam-id-0007" name="Assign communication team">
      <bpmn:incoming>SequenceFlow-SplitToCommunication-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CommunicationToJoin-id-0030</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0008" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-FurnitureMoversToJoin-id-0028</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ITSetupToJoin-id-0029</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CommunicationToJoin-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToCreateTimeline-id-0031</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-CreateRelocationTimeline-id-0009" name="Create detailed relocation timeline">
      <bpmn:incoming>SequenceFlow-JoinToCreateTimeline-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateTimelineToAssignTasks-id-0032</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AssignTasksToTeams-id-0010" name="Assign tasks to various teams">
      <bpmn:incoming>SequenceFlow-CreateTimelineToAssignTasks-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignTasksToNotify-id-0033</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-NotifyEmployeesOfMovingDay-id-0011" name="Notify all employees of moving day">
      <bpmn:incoming>SequenceFlow-AssignTasksToNotify-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyToPrepareOffice-id-0034</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PrepareOfficeForPause-id-0012" name="Prepare office for temporary pause">
      <bpmn:incoming>SequenceFlow-NotifyToPrepareOffice-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareOfficeToPause-id-0035</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PauseOperations-id-0013" name="Pause operations temporarily">
      <bpmn:incoming>SequenceFlow-PrepareOfficeToPause-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PauseToTransport-id-0036</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TransportEquipment-id-0014" name="Transport equipment and documents">
      <bpmn:incoming>SequenceFlow-PauseToTransport-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TransportToUnpack-id-0037</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-UnpackAndSetupFurniture-id-0015" name="Unpack and set up furniture">
      <bpmn:incoming>SequenceFlow-TransportToUnpack-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UnpackToSetupIT-id-0038</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-SetupITSystems-id-0016" name="Set up IT systems and networks">
      <bpmn:incoming>SequenceFlow-UnpackToSetupIT-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SetupITToTest-id-0039</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TestSystems-id-0017" name="Test all systems for functionality">
      <bpmn:incoming>SequenceFlow-SetupITToTest-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TestToVerify-id-0040</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-VerifyItemsUnpacked-id-0018" name="Verify all items are unpacked">
      <bpmn:incoming>SequenceFlow-TestToVerify-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToEnsureOperational-id-0041</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-EnsureSystemsOperational-id-0019" name="Ensure systems are operational">
      <bpmn:incoming>SequenceFlow-VerifyToEnsureOperational-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnsureOperationalToNotifyResume-id-0042</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-NotifyEmployeesToResume-id-0020" name="Notify employees to resume work">
      <bpmn:incoming>SequenceFlow-EnsureOperationalToNotifyResume-id-0042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyResumeToEnd-id-0043</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-OfficeRelocationComplete-id-0021" name="Office Relocation Complete">
      <bpmn:incoming>SequenceFlow-NotifyResumeToEnd-id-0043</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSelect-id-0022" sourceRef="StartEvent-OfficeRelocationProcessBegins-id-0001" targetRef="UserTask-SelectNewOfficeLocation-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToFormCommittee-id-0023" sourceRef="UserTask-SelectNewOfficeLocation-id-0002" targetRef="ServiceTask-FormRelocationCommittee-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-FormCommitteeToSplit-id-0024" sourceRef="ServiceTask-FormRelocationCommittee-id-0003" targetRef="ParallelGateway-Split-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToFurnitureMovers-id-0025" sourceRef="ParallelGateway-Split-id-0004" targetRef="ServiceTask-AssignFurnitureMovers-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToITSetup-id-0026" sourceRef="ParallelGateway-Split-id-0004" targetRef="ServiceTask-AssignITSetupTeam-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToCommunication-id-0027" sourceRef="ParallelGateway-Split-id-0004" targetRef="ServiceTask-AssignCommunicationTeam-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-FurnitureMoversToJoin-id-0028" sourceRef="ServiceTask-AssignFurnitureMovers-id-0005" targetRef="ParallelGateway-Join-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ITSetupToJoin-id-0029" sourceRef="ServiceTask-AssignITSetupTeam-id-0006" targetRef="ParallelGateway-Join-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-CommunicationToJoin-id-0030" sourceRef="ServiceTask-AssignCommunicationTeam-id-0007" targetRef="ParallelGateway-Join-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToCreateTimeline-id-0031" sourceRef="ParallelGateway-Join-id-0008" targetRef="ServiceTask-CreateRelocationTimeline-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateTimelineToAssignTasks-id-0032" sourceRef="ServiceTask-CreateRelocationTimeline-id-0009" targetRef="ServiceTask-AssignTasksToTeams-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-AssignTasksToNotify-id-0033" sourceRef="ServiceTask-AssignTasksToTeams-id-0010" targetRef="ServiceTask-NotifyEmployeesOfMovingDay-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyToPrepareOffice-id-0034" sourceRef="ServiceTask-NotifyEmployeesOfMovingDay-id-0011" targetRef="ServiceTask-PrepareOfficeForPause-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareOfficeToPause-id-0035" sourceRef="ServiceTask-PrepareOfficeForPause-id-0012" targetRef="ServiceTask-PauseOperations-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-PauseToTransport-id-0036" sourceRef="ServiceTask-PauseOperations-id-0013" targetRef="ServiceTask-TransportEquipment-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-TransportToUnpack-id-0037" sourceRef="ServiceTask-TransportEquipment-id-0014" targetRef="ServiceTask-UnpackAndSetupFurniture-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-UnpackToSetupIT-id-0038" sourceRef="ServiceTask-UnpackAndSetupFurniture-id-0015" targetRef="ServiceTask-SetupITSystems-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-SetupITToTest-id-0039" sourceRef="ServiceTask-SetupITSystems-id-0016" targetRef="ServiceTask-TestSystems-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-TestToVerify-id-0040" sourceRef="ServiceTask-TestSystems-id-0017" targetRef="ServiceTask-VerifyItemsUnpacked-id-0018" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyToEnsureOperational-id-0041" sourceRef="ServiceTask-VerifyItemsUnpacked-id-0018" targetRef="ServiceTask-EnsureSystemsOperational-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-EnsureOperationalToNotifyResume-id-0042" sourceRef="ServiceTask-EnsureSystemsOperational-id-0019" targetRef="ServiceTask-NotifyEmployeesToResume-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyResumeToEnd-id-0043" sourceRef="ServiceTask-NotifyEmployeesToResume-id-0020" targetRef="EndEvent-OfficeRelocationComplete-id-0021" />
  </bpmn:process>
