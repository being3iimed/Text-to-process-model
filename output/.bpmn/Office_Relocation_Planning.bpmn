        <dc:Bounds x="2757" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AssignITSetupTeam-id-0006_di" bpmnElement="ServiceTask-AssignITSetupTeam-id-0006">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AssignCommunicationTeam-id-0007_di" bpmnElement="ServiceTask-AssignCommunicationTeam-id-0007">
        <dc:Bounds x="625" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
