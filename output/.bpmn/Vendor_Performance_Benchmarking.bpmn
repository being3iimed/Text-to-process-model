<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="supplier-evaluation-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="SupplierEvaluationProcess-id-0001" name="Quarterly Supplier Evaluation Process">
    <bpmn:startEvent id="StartEvent-ProcessStarts-id-0001" name="Quarterly Supplier Evaluation Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToSplit-id-0019</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0002" name="Parallel Data Collection" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StartToSplit-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToDeliveryTime-id-0020</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToQualityData-id-0021</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToCostData-id-0022</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-CollectDeliveryTime-id-0003" name="Collect delivery time data">
      <bpmn:incoming>SequenceFlow-SplitToDeliveryTime-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeliveryTimeToJoin-id-0023</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CollectQualityData-id-0004" name="Collect quality data">
      <bpmn:incoming>SequenceFlow-SplitToQualityData-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-QualityDataToJoin-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CollectCostData-id-0005" name="Collect cost data">
      <bpmn:incoming>SequenceFlow-SplitToCostData-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CostDataToJoin-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0006" name="Synchronize Data Collection" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-DeliveryTimeToJoin-id-0023</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-QualityDataToJoin-id-0024</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CostDataToJoin-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToBenchmark-id-0026</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-BenchmarkStandards-id-0007" name="Benchmark against industry standards">
      <bpmn:incoming>SequenceFlow-JoinToBenchmark-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BenchmarkToEvaluation-id-0027</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PerformanceEvaluation-id-0008" name="Evaluate Supplier Performance" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-BenchmarkToEvaluation-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Underperforms-id-0028</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-TopPerformer-id-0029</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-Default-id-0030</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-DevelopImprovementPlan-id-0009" name="Develop improvement plan">
      <bpmn:incoming>SequenceFlow-Underperforms-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PlanToCommunicate-id-0031</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CommunicatePlan-id-0010" name="Communicate plan to supplier">
      <bpmn:incoming>SequenceFlow-PlanToCommunicate-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CommunicateToReceive-id-0032</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-PlanAcceptance-id-0011" name="Receive: supplier confirmation of plan acceptance">
      <bpmn:incoming>SequenceFlow-CommunicateToReceive-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UnderperformsToEnd-id-0034</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="UserTask-NegotiateContract-id-0012" name="Negotiate better contract terms">
      <bpmn:incoming>SequenceFlow-TopPerformer-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NegotiateToReceive-id-0033</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="ReceiveTask-SignedContract-id-0013" name="Receive: signed contract">
      <bpmn:incoming>SequenceFlow-NegotiateToReceive-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TopPerformerToEnd-id-0035</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="ServiceTask-ConfirmContract-id-0014" name="Confirm current contract status">
      <bpmn:incoming>SequenceFlow-Default-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DefaultToEnd-id-0036</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-QuarterlyComplete-id-0015" name="Quarterly Evaluation Complete">
      <bpmn:incoming>SequenceFlow-UnderperformsToEnd-id-0034</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-TopPerformerToEnd-id-0035</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DefaultToEnd-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EndToUpdate-id-0037</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-UpdateRankings-id-0016" name="Update supplier rankings">
      <bpmn:incoming>SequenceFlow-EndToUpdate-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToRecommendations-id-0038</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DevelopRecommendations-id-0017" name="Develop strategic recommendations">
      <bpmn:incoming>SequenceFlow-UpdateToRecommendations-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RecommendationsToFinalEnd-id-0039</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-ProcessEnds-id-0018" name="Process Ends">
      <bpmn:incoming>SequenceFlow-RecommendationsToFinalEnd-id-0039</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0019" sourceRef="StartEvent-ProcessStarts-id-0001" targetRef="ParallelGateway-Split-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToDeliveryTime-id-0020" sourceRef="ParallelGateway-Split-id-0002" targetRef="ServiceTask-CollectDeliveryTime-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToQualityData-id-0021" sourceRef="ParallelGateway-Split-id-0002" targetRef="ServiceTask-CollectQualityData-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToCostData-id-0022" sourceRef="ParallelGateway-Split-id-0002" targetRef="ServiceTask-CollectCostData-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-DeliveryTimeToJoin-id-0023" sourceRef="ServiceTask-CollectDeliveryTime-id-0003" targetRef="ParallelGateway-Join-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-QualityDataToJoin-id-0024" sourceRef="ServiceTask-CollectQualityData-id-0004" targetRef="ParallelGateway-Join-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-CostDataToJoin-id-0025" sourceRef="ServiceTask-CollectCostData-id-0005" targetRef="ParallelGateway-Join-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToBenchmark-id-0026" sourceRef="ParallelGateway-Join-id-0006" targetRef="ServiceTask-BenchmarkStandards-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-BenchmarkToEvaluation-id-0027" sourceRef="ServiceTask-BenchmarkStandards-id-0007" targetRef="ExclusiveGateway-PerformanceEvaluation-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-Underperforms-id-0028" name="supplier_underperforms" sourceRef="ExclusiveGateway-PerformanceEvaluation-id-0008" targetRef="UserTask-DevelopImprovementPlan-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-TopPerformer-id-0029" name="supplier_top_performer" sourceRef="ExclusiveGateway-PerformanceEvaluation-id-0008" targetRef="UserTask-NegotiateContract-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-Default-id-0030" sourceRef="ExclusiveGateway-PerformanceEvaluation-id-0008" targetRef="ServiceTask-ConfirmContract-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-PlanToCommunicate-id-0031" sourceRef="UserTask-DevelopImprovementPlan-id-0009" targetRef="ServiceTask-CommunicatePlan-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-CommunicateToReceive-id-0032" sourceRef="ServiceTask-CommunicatePlan-id-0010" targetRef="ReceiveTask-PlanAcceptance-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-NegotiateToReceive-id-0033" sourceRef="UserTask-NegotiateContract-id-0012" targetRef="ReceiveTask-SignedContract-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-UnderperformsToEnd-id-0034" sourceRef="ReceiveTask-PlanAcceptance-id-0011" targetRef="EndEvent-QuarterlyComplete-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-TopPerformerToEnd-id-0035" sourceRef="ReceiveTask-SignedContract-id-0013" targetRef="EndEvent-QuarterlyComplete-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-DefaultToEnd-id-0036" sourceRef="ServiceTask-ConfirmContract-id-0014" targetRef="EndEvent-QuarterlyComplete-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-EndToUpdate-id-0037" sourceRef="EndEvent-QuarterlyComplete-id-0015" targetRef="ServiceTask-UpdateRankings-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToRecommendations-id-0038" sourceRef="ServiceTask-UpdateRankings-id-0016" targetRef="ServiceTask-DevelopRecommendations-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-RecommendationsToFinalEnd-id-0039" sourceRef="ServiceTask-DevelopRecommendations-id-0017" targetRef="EndEvent-ProcessEnds-id-0018" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SupplierEvaluationProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SupplierEvaluationProcess-id-0001" bpmnElement="SupplierEvaluationProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProcessStarts-id-0001_di" bpmnElement="StartEvent-ProcessStarts-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Split-id-0002_di" bpmnElement="ParallelGateway-Split-id-0002">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CollectDeliveryTime-id-0003_di" bpmnElement="ServiceTask-CollectDeliveryTime-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Join-id-0006_di" bpmnElement="ParallelGateway-Join-id-0006">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-BenchmarkStandards-id-0007_di" bpmnElement="ServiceTask-BenchmarkStandards-id-0007">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PerformanceEvaluation-id-0008_di" bpmnElement="ExclusiveGateway-PerformanceEvaluation-id-0008" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DevelopImprovementPlan-id-0009_di" bpmnElement="UserTask-DevelopImprovementPlan-id-0009">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CommunicatePlan-id-0010_di" bpmnElement="ServiceTask-CommunicatePlan-id-0010">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-PlanAcceptance-id-0011_di" bpmnElement="ReceiveTask-PlanAcceptance-id-0011">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-QuarterlyComplete-id-0015_di" bpmnElement="EndEvent-QuarterlyComplete-id-0015">
        <dc:Bounds x="1407" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-UpdateRankings-id-0016_di" bpmnElement="ServiceTask-UpdateRankings-id-0016">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DevelopRecommendations-id-0017_di" bpmnElement="ServiceTask-DevelopRecommendations-id-0017">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessEnds-id-0018_di" bpmnElement="EndEvent-ProcessEnds-id-0018">
        <dc:Bounds x="1857" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CollectQualityData-id-0004_di" bpmnElement="ServiceTask-CollectQualityData-id-0004">
        <dc:Bounds x="325" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-NegotiateContract-id-0012_di" bpmnElement="UserTask-NegotiateContract-id-0012">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-SignedContract-id-0013_di" bpmnElement="ReceiveTask-SignedContract-id-0013">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CollectCostData-id-0005_di" bpmnElement="ServiceTask-CollectCostData-id-0005">
        <dc:Bounds x="325" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ConfirmContract-id-0014_di" bpmnElement="ServiceTask-ConfirmContract-id-0014">
        <dc:Bounds x="925" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSplit-id-0019_di" bpmnElement="SequenceFlow-StartToSplit-id-0019">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="200" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToDeliveryTime-id-0020_di" bpmnElement="SequenceFlow-SplitToDeliveryTime-id-0020">
        <di:waypoint x="250" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToQualityData-id-0021_di" bpmnElement="SequenceFlow-SplitToQualityData-id-0021">
        <di:waypoint x="225" y="95" />
        <di:waypoint x="225" y="210" />
        <di:waypoint x="325" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToCostData-id-0022_di" bpmnElement="SequenceFlow-SplitToCostData-id-0022">
        <di:waypoint x="225" y="95" />
        <di:waypoint x="225" y="350" />
        <di:waypoint x="325" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DeliveryTimeToJoin-id-0023_di" bpmnElement="SequenceFlow-DeliveryTimeToJoin-id-0023">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-JoinToBenchmark-id-0026_di" bpmnElement="SequenceFlow-JoinToBenchmark-id-0026">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BenchmarkToEvaluation-id-0027_di" bpmnElement="SequenceFlow-BenchmarkToEvaluation-id-0027">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-Underperforms-id-0028_di" bpmnElement="SequenceFlow-Underperforms-id-0028">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TopPerformer-id-0029_di" bpmnElement="SequenceFlow-TopPerformer-id-0029">
        <di:waypoint x="825" y="95" />
        <di:waypoint x="825" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-Default-id-0030_di" bpmnElement="SequenceFlow-Default-id-0030">
        <di:waypoint x="825" y="95" />
        <di:waypoint x="825" y="350" />
        <di:waypoint x="925" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PlanToCommunicate-id-0031_di" bpmnElement="SequenceFlow-PlanToCommunicate-id-0031">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CommunicateToReceive-id-0032_di" bpmnElement="SequenceFlow-CommunicateToReceive-id-0032">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UnderperformsToEnd-id-0034_di" bpmnElement="SequenceFlow-UnderperformsToEnd-id-0034">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1407" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EndToUpdate-id-0037_di" bpmnElement="SequenceFlow-EndToUpdate-id-0037">
        <di:waypoint x="1443" y="70" />
        <di:waypoint x="1525" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UpdateToRecommendations-id-0038_di" bpmnElement="SequenceFlow-UpdateToRecommendations-id-0038">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1675" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RecommendationsToFinalEnd-id-0039_di" bpmnElement="SequenceFlow-RecommendationsToFinalEnd-id-0039">
        <di:waypoint x="1775" y="70" />
        <di:waypoint x="1857" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-QualityDataToJoin-id-0024_di" bpmnElement="SequenceFlow-QualityDataToJoin-id-0024">
        <di:waypoint x="425" y="210" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="525" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-NegotiateToReceive-id-0033_di" bpmnElement="SequenceFlow-NegotiateToReceive-id-0033">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TopPerformerToEnd-id-0035_di" bpmnElement="SequenceFlow-TopPerformerToEnd-id-0035">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1425" y="210" />
        <di:waypoint x="1425" y="88" />
