<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Process-InsufficientStock-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-InsufficientStockDetected-id-0001" name="Insufficient Stock Detected">
      <bpmn:outgoing>SequenceFlow-StartToCalculate-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-CalculateDeliveryTimeDifference-id-0002" name="Calculate Delivery Time Difference">
      <bpmn:incoming>SequenceFlow-StartToCalculate-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateToGateway-id-0002</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DeliveryTimeDifference-id-0003" name="Delivery Time Difference" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CalculateToGateway-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToDelay-id-0003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToCheckAlternative-id-0004</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-DelayProductionSlightly-id-0004" name="Delay Production Slightly">
      <bpmn:incoming>SequenceFlow-GatewayToDelay-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DelayToArrive-id-0005</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ComponentsArriveInTime-id-0005" name="Components Arrive in Time">
      <bpmn:incoming>SequenceFlow-DelayToArrive-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ArriveToEnd-id-0006</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-CheckForAlternativeComponent-id-0006" name="Check for Alternative Component">
      <bpmn:incoming>SequenceFlow-GatewayToCheckAlternative-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckAlternativeToGateway-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AlternativeComponentAvailable-id-0007" name="Alternative Component Available" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckAlternativeToGateway-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToNotifyProduction-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToApproveExpedite-id-0009</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-NotifyProductionOfAlternativeComponent-id-0008" name="Notify Production of Alternative Component">
      <bpmn:incoming>SequenceFlow-GatewayToNotifyProduction-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyProductionToLogCost-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ApproveExpedite-id-0009" name="Approve Expedite">
      <bpmn:incoming>SequenceFlow-GatewayToApproveExpedite-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApproveExpediteToGateway-id-0013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ExpediteApproved-id-0010" name="Expedite Approved" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ApproveExpediteToGateway-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToRequestExpedite-id-0014</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToEscalate-id-0015</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-RequestExpediteFromSupplier-id-0011" name="Request Expedite from Supplier">
      <bpmn:incoming>SequenceFlow-GatewayToRequestExpedite-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RequestExpediteToNotifyDependent-id-0016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-NotifyDependentProductionLines-id-0012" name="Notify Dependent Production Lines">
      <bpmn:incoming>SequenceFlow-RequestExpediteToNotifyDependent-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyDependentToGateway-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ExpediteSuccessful-id-0013" name="Expedite Successful" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-NotifyDependentToGateway-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToComponentsArrive-id-0018</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToEscalate2-id-0019</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ComponentsArriveFromSupplier-id-0014" name="Components Arrive from Supplier">
      <bpmn:incoming>SequenceFlow-GatewayToComponentsArrive-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ComponentsArriveToLogCost-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-EscalateToProcurementManager-id-0015" name="Escalate to Procurement Manager">
      <bpmn:incoming>SequenceFlow-GatewayToEscalate-id-0015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-GatewayToEscalate2-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EscalateToFindBackup-id-0021</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-FindBackupSupplier-id-0016" name="Find Backup Supplier">
      <bpmn:incoming>SequenceFlow-EscalateToFindBackup-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FindBackupToConfirmDelivery-id-0022</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConfirmBackupSupplierDelivery-id-0017" name="Confirm Backup Supplier Delivery">
      <bpmn:incoming>SequenceFlow-FindBackupToConfirmDelivery-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConfirmDeliveryToCreatePO-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CreatePurchaseOrder-id-0018" name="Create Purchase Order">
      <bpmn:incoming>SequenceFlow-ConfirmDeliveryToCreatePO-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreatePOToReceiveComponent-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ReceiveComponentFromBackupSupplier-id-0019" name="Receive Component from Backup Supplier">
      <bpmn:incoming>SequenceFlow-CreatePOToReceiveComponent-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveComponentToLogCost-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-LogCostVariance-id-0020" name="Log Cost Variance">
      <bpmn:incoming>SequenceFlow-NotifyProductionToLogCost-id-0010</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ComponentsArriveToLogCost-id-0020</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReceiveComponentToLogCost-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LogCostToUpdateMetrics-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-UpdateSupplierPerformanceMetrics-id-0021" name="Update Supplier Performance Metrics">
      <bpmn:incoming>SequenceFlow-LogCostToUpdateMetrics-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateMetricsToEnd-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-ProductionLineResumes-id-0022" name="Production Line Resumes">
      <bpmn:incoming>SequenceFlow-ArriveToEnd-id-0006</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-UpdateMetricsToEnd-id-0012</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCalculate-id-0001" sourceRef="StartEvent-InsufficientStockDetected-id-0001" targetRef="ServiceTask-CalculateDeliveryTimeDifference-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateToGateway-id-0002" sourceRef="ServiceTask-CalculateDeliveryTimeDifference-id-0002" targetRef="ExclusiveGateway-DeliveryTimeDifference-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToDelay-id-0003" name="delivery_time_difference &#60;= 24 hours" sourceRef="ExclusiveGateway-DeliveryTimeDifference-id-0003" targetRef="ServiceTask-DelayProductionSlightly-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToCheckAlternative-id-0004" name="delivery_time_difference &#62; 24 hours" sourceRef="ExclusiveGateway-DeliveryTimeDifference-id-0003" targetRef="UserTask-CheckForAlternativeComponent-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-DelayToArrive-id-0005" sourceRef="ServiceTask-DelayProductionSlightly-id-0004" targetRef="ServiceTask-ComponentsArriveInTime-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ArriveToEnd-id-0006" sourceRef="ServiceTask-ComponentsArriveInTime-id-0005" targetRef="EndEvent-ProductionLineResumes-id-0022" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckAlternativeToGateway-id-0007" sourceRef="UserTask-CheckForAlternativeComponent-id-0006" targetRef="ExclusiveGateway-AlternativeComponentAvailable-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToNotifyProduction-id-0008" name="alternative_component_available" sourceRef="ExclusiveGateway-AlternativeComponentAvailable-id-0007" targetRef="UserTask-NotifyProductionOfAlternativeComponent-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToApproveExpedite-id-0009" name="no alternative_component_available" sourceRef="ExclusiveGateway-AlternativeComponentAvailable-id-0007" targetRef="UserTask-ApproveExpedite-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyProductionToLogCost-id-0010" sourceRef="UserTask-NotifyProductionOfAlternativeComponent-id-0008" targetRef="ServiceTask-LogCostVariance-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-LogCostToUpdateMetrics-id-0011" sourceRef="ServiceTask-LogCostVariance-id-0020" targetRef="ServiceTask-UpdateSupplierPerformanceMetrics-id-0021" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateMetricsToEnd-id-0012" sourceRef="ServiceTask-UpdateSupplierPerformanceMetrics-id-0021" targetRef="EndEvent-ProductionLineResumes-id-0022" />
    <bpmn:sequenceFlow id="SequenceFlow-ApproveExpediteToGateway-id-0013" sourceRef="UserTask-ApproveExpedite-id-0009" targetRef="ExclusiveGateway-ExpediteApproved-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToRequestExpedite-id-0014" name="expedite_approved" sourceRef="ExclusiveGateway-ExpediteApproved-id-0010" targetRef="UserTask-RequestExpediteFromSupplier-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToEscalate-id-0015" name="expedite_not_approved" sourceRef="ExclusiveGateway-ExpediteApproved-id-0010" targetRef="UserTask-EscalateToProcurementManager-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-RequestExpediteToNotifyDependent-id-0016" sourceRef="UserTask-RequestExpediteFromSupplier-id-0011" targetRef="UserTask-NotifyDependentProductionLines-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyDependentToGateway-id-0017" sourceRef="UserTask-NotifyDependentProductionLines-id-0012" targetRef="ExclusiveGateway-ExpediteSuccessful-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToComponentsArrive-id-0018" name="expedite_successful" sourceRef="ExclusiveGateway-ExpediteSuccessful-id-0013" targetRef="ServiceTask-ComponentsArriveFromSupplier-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToEscalate2-id-0019" name="expedite_failed" sourceRef="ExclusiveGateway-ExpediteSuccessful-id-0013" targetRef="UserTask-EscalateToProcurementManager-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-ComponentsArriveToLogCost-id-0020" sourceRef="ServiceTask-ComponentsArriveFromSupplier-id-0014" targetRef="ServiceTask-LogCostVariance-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-EscalateToFindBackup-id-0021" sourceRef="UserTask-EscalateToProcurementManager-id-0015" targetRef="UserTask-FindBackupSupplier-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-FindBackupToConfirmDelivery-id-0022" sourceRef="UserTask-FindBackupSupplier-id-0016" targetRef="UserTask-ConfirmBackupSupplierDelivery-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-ConfirmDeliveryToCreatePO-id-0023" sourceRef="UserTask-ConfirmBackupSupplierDelivery-id-0017" targetRef="ServiceTask-CreatePurchaseOrder-id-0018" />
    <bpmn:sequenceFlow id="SequenceFlow-CreatePOToReceiveComponent-id-0024" sourceRef="ServiceTask-CreatePurchaseOrder-id-0018" targetRef="ServiceTask-ReceiveComponentFromBackupSupplier-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveComponentToLogCost-id-0025" sourceRef="ServiceTask-ReceiveComponentFromBackupSupplier-id-0019" targetRef="ServiceTask-LogCostVariance-id-0020" />
  </bpmn:process>
