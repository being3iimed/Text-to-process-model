<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="campaign-management-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Campaign-Management-Process-id-0001" name="Campaign Management Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CampaignInitiation-id-0001" name="Campaign Initiation">
      <bpmn:outgoing>SequenceFlow-StartToDefine-id-0013</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-DefineCampaignObjectives-id-0002" name="Define Campaign Objectives">
      <bpmn:incoming>SequenceFlow-StartToDefine-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DefineToGateway-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CampaignTypeDecision-id-0003" name="Campaign Type Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-DefineToGateway-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToBrandAwareness-id-0015</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToTrafficDrive-id-0016</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToGeneral-id-0017</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-DesignBrandAwarenessContent-id-0004" name="Design Brand Awareness Content">
      <bpmn:incoming>SequenceFlow-GatewayToBrandAwareness-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BrandAwarenessToSchedule-id-0018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DesignTrafficDrivingContent-id-0005" name="Design Traffic-Driving Content">
      <bpmn:incoming>SequenceFlow-GatewayToTrafficDrive-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrafficDriveToSchedule-id-0019</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DesignGeneralContent-id-0006" name="Design General Content">
      <bpmn:incoming>SequenceFlow-GatewayToGeneral-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GeneralToSchedule-id-0020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ScheduleContent-id-0007" name="Schedule Content">
      <bpmn:incoming>SequenceFlow-BrandAwarenessToSchedule-id-0018</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-TrafficDriveToSchedule-id-0019</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-GeneralToSchedule-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ScheduleToMonitor-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-MonitorEngagement-id-0008" name="Monitor Engagement">
      <bpmn:incoming>SequenceFlow-ScheduleToMonitor-id-0021</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AdjustToMonitor-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MonitorToReview-id-0022</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PerformanceReview-id-0009" name="Performance Review" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-MonitorToReview-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToAdjust-id-0023</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ReviewToReport-id-0025</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-AdjustCampaign-id-0010" name="Adjust Campaign">
      <bpmn:incoming>SequenceFlow-ReviewToAdjust-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdjustToMonitor-id-0024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-GenerateFinalReport-id-0011" name="Generate Final Report">
      <bpmn:incoming>SequenceFlow-ReviewToReport-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReportToEnd-id-0026</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-CampaignCompletion-id-0012" name="Campaign Completion">
      <bpmn:incoming>SequenceFlow-ReportToEnd-id-0026</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDefine-id-0013" sourceRef="StartEvent-CampaignInitiation-id-0001" targetRef="UserTask-DefineCampaignObjectives-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DefineToGateway-id-0014" sourceRef="UserTask-DefineCampaignObjectives-id-0002" targetRef="ExclusiveGateway-CampaignTypeDecision-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToBrandAwareness-id-0015" name="campaign_type == &#39;brand_awareness&#39;" sourceRef="ExclusiveGateway-CampaignTypeDecision-id-0003" targetRef="UserTask-DesignBrandAwarenessContent-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToTrafficDrive-id-0016" name="campaign_type == &#39;traffic_drive&#39;" sourceRef="ExclusiveGateway-CampaignTypeDecision-id-0003" targetRef="UserTask-DesignTrafficDrivingContent-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToGeneral-id-0017" sourceRef="ExclusiveGateway-CampaignTypeDecision-id-0003" targetRef="UserTask-DesignGeneralContent-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-BrandAwarenessToSchedule-id-0018" sourceRef="UserTask-DesignBrandAwarenessContent-id-0004" targetRef="ServiceTask-ScheduleContent-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-TrafficDriveToSchedule-id-0019" sourceRef="UserTask-DesignTrafficDrivingContent-id-0005" targetRef="ServiceTask-ScheduleContent-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-GeneralToSchedule-id-0020" sourceRef="UserTask-DesignGeneralContent-id-0006" targetRef="ServiceTask-ScheduleContent-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-ScheduleToMonitor-id-0021" sourceRef="ServiceTask-ScheduleContent-id-0007" targetRef="ServiceTask-MonitorEngagement-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-MonitorToReview-id-0022" sourceRef="ServiceTask-MonitorEngagement-id-0008" targetRef="ExclusiveGateway-PerformanceReview-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToAdjust-id-0023" name="engagement_metrics &#60; target" sourceRef="ExclusiveGateway-PerformanceReview-id-0009" targetRef="UserTask-AdjustCampaign-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-AdjustToMonitor-id-0024" sourceRef="UserTask-AdjustCampaign-id-0010" targetRef="ServiceTask-MonitorEngagement-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToReport-id-0025" sourceRef="ExclusiveGateway-PerformanceReview-id-0009" targetRef="ServiceTask-GenerateFinalReport-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-ReportToEnd-id-0026" sourceRef="ServiceTask-GenerateFinalReport-id-0011" targetRef="EndEvent-CampaignCompletion-id-0012" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Campaign-Management-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Campaign-Management-Process-id-0001" bpmnElement="Campaign-Management-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-CampaignInitiation-id-0001_di" bpmnElement="StartEvent-CampaignInitiation-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DefineCampaignObjectives-id-0002_di" bpmnElement="UserTask-DefineCampaignObjectives-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-CampaignTypeDecision-id-0003_di" bpmnElement="ExclusiveGateway-CampaignTypeDecision-id-0003" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DesignBrandAwarenessContent-id-0004_di" bpmnElement="UserTask-DesignBrandAwarenessContent-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ScheduleContent-id-0007_di" bpmnElement="ServiceTask-ScheduleContent-id-0007">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-MonitorEngagement-id-0008_di" bpmnElement="ServiceTask-MonitorEngagement-id-0008">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PerformanceReview-id-0009_di" bpmnElement="ExclusiveGateway-PerformanceReview-id-0009" isMarkerVisible="true">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AdjustCampaign-id-0010_di" bpmnElement="UserTask-AdjustCampaign-id-0010">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DesignTrafficDrivingContent-id-0005_di" bpmnElement="UserTask-DesignTrafficDrivingContent-id-0005">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateFinalReport-id-0011_di" bpmnElement="ServiceTask-GenerateFinalReport-id-0011">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-CampaignCompletion-id-0012_di" bpmnElement="EndEvent-CampaignCompletion-id-0012">
        <dc:Bounds x="1257" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DesignGeneralContent-id-0006_di" bpmnElement="UserTask-DesignGeneralContent-id-0006">
        <dc:Bounds x="475" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToDefine-id-0013_di" bpmnElement="SequenceFlow-StartToDefine-id-0013">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DefineToGateway-id-0014_di" bpmnElement="SequenceFlow-DefineToGateway-id-0014">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToBrandAwareness-id-0015_di" bpmnElement="SequenceFlow-GatewayToBrandAwareness-id-0015">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToTrafficDrive-id-0016_di" bpmnElement="SequenceFlow-GatewayToTrafficDrive-id-0016">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="210" />
        <di:waypoint x="475" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToGeneral-id-0017_di" bpmnElement="SequenceFlow-GatewayToGeneral-id-0017">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="350" />
        <di:waypoint x="475" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BrandAwarenessToSchedule-id-0018_di" bpmnElement="SequenceFlow-BrandAwarenessToSchedule-id-0018">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ScheduleToMonitor-id-0021_di" bpmnElement="SequenceFlow-ScheduleToMonitor-id-0021">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MonitorToReview-id-0022_di" bpmnElement="SequenceFlow-MonitorToReview-id-0022">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="950" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToAdjust-id-0023_di" bpmnElement="SequenceFlow-ReviewToAdjust-id-0023">
        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToReport-id-0025_di" bpmnElement="SequenceFlow-ReviewToReport-id-0025">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AdjustToMonitor-id-0024_di" bpmnElement="SequenceFlow-AdjustToMonitor-id-0024">
        <di:waypoint x="1125" y="110" />
        <di:waypoint x="1125" y="140" />
        <di:waypoint x="825" y="140" />
        <di:waypoint x="825" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TrafficDriveToSchedule-id-0019_di" bpmnElement="SequenceFlow-TrafficDriveToSchedule-id-0019">
        <di:waypoint x="575" y="210" />
        <di:waypoint x="675" y="210" />
        <di:waypoint x="675" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReportToEnd-id-0026_di" bpmnElement="SequenceFlow-ReportToEnd-id-0026">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1257" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GeneralToSchedule-id-0020_di" bpmnElement="SequenceFlow-GeneralToSchedule-id-0020">
        <di:waypoint x="575" y="350" />
        <di:waypoint x="675" y="350" />
        <di:waypoint x="675" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
