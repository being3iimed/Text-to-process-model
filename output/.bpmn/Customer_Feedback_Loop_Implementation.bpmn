<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="feedback-collection-process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Feedback-Collection-Process-id-0001" name="Feedback Collection Process">
    <bpmn:startEvent id="StartEvent-FeedbackCollectionProcessStarts-id-0001" name="Feedback Collection Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToCollect-id-0014</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-CollectFeedback-id-0002" name="Collect feedback through surveys or focus groups">
      <bpmn:incoming>SequenceFlow-StartToCollect-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CollectToAnalyze-id-0015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AnalyzeFeedback-id-0003" name="Analyze feedback to identify trends and pain points">
      <bpmn:incoming>SequenceFlow-CollectToAnalyze-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeToCreate-id-0016</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-CreateActionPlans-id-0004" name="Create action plans to address recurring issues">
      <bpmn:incoming>SequenceFlow-AnalyzeToCreate-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateToImplement-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ImplementChanges-id-0005" name="Implement changes based on action plans">
      <bpmn:incoming>SequenceFlow-CreateToImplement-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ImplementToSend-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendNotification-id-0006" name="Send notification to customers about improvements">
      <bpmn:incoming>SequenceFlow-ImplementToSend-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToReMeasure-id-0019</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-ReMeasureSatisfaction-id-0007" name="Re-measure satisfaction levels to gauge impact of changes">
      <bpmn:incoming>SequenceFlow-SendToReMeasure-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReMeasureToGateway-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-FeedbackImprovement-id-0008" name="Feedback Improvement Assessment" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReMeasureToGateway-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToImprovement-id-0021</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToStable-id-0022</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToReEvaluate-id-0023</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-ProcessCompleteWithImprovement-id-0009" name="Process Complete with Improvement">
      <bpmn:incoming>SequenceFlow-GatewayToImprovement-id-0021</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-ProcessCompleteWithStableFeedback-id-0010" name="Process Complete with Stable Feedback">
      <bpmn:incoming>SequenceFlow-GatewayToStable-id-0022</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-ReEvaluateFeedback-id-0011" name="Re-evaluate feedback and adjust action plans">
      <bpmn:incoming>SequenceFlow-GatewayToReEvaluate-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReEvaluateToSendUpdate-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendUpdate-id-0012" name="Send update to customers about ongoing improvements">
      <bpmn:incoming>SequenceFlow-ReEvaluateToSendUpdate-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendUpdateToMonitoring-id-0025</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ProcessCompleteWithOngoingMonitoring-id-0013" name="Process Complete with Ongoing Monitoring">
      <bpmn:incoming>SequenceFlow-SendUpdateToMonitoring-id-0025</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCollect-id-0014" sourceRef="StartEvent-FeedbackCollectionProcessStarts-id-0001" targetRef="ServiceTask-CollectFeedback-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CollectToAnalyze-id-0015" sourceRef="ServiceTask-CollectFeedback-id-0002" targetRef="ServiceTask-AnalyzeFeedback-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToCreate-id-0016" sourceRef="ServiceTask-AnalyzeFeedback-id-0003" targetRef="UserTask-CreateActionPlans-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateToImplement-id-0017" sourceRef="UserTask-CreateActionPlans-id-0004" targetRef="ServiceTask-ImplementChanges-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ImplementToSend-id-0018" sourceRef="ServiceTask-ImplementChanges-id-0005" targetRef="SendTask-SendNotification-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToReMeasure-id-0019" sourceRef="SendTask-SendNotification-id-0006" targetRef="ServiceTask-ReMeasureSatisfaction-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-ReMeasureToGateway-id-0020" sourceRef="ServiceTask-ReMeasureSatisfaction-id-0007" targetRef="ExclusiveGateway-FeedbackImprovement-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToImprovement-id-0021" name="feedback shows significant improvement" sourceRef="ExclusiveGateway-FeedbackImprovement-id-0008" targetRef="EndEvent-ProcessCompleteWithImprovement-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToStable-id-0022" name="feedback stabilizes" sourceRef="ExclusiveGateway-FeedbackImprovement-id-0008" targetRef="EndEvent-ProcessCompleteWithStableFeedback-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToReEvaluate-id-0023" sourceRef="ExclusiveGateway-FeedbackImprovement-id-0008" targetRef="ServiceTask-ReEvaluateFeedback-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-ReEvaluateToSendUpdate-id-0024" sourceRef="ServiceTask-ReEvaluateFeedback-id-0011" targetRef="SendTask-SendUpdate-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-SendUpdateToMonitoring-id-0025" sourceRef="SendTask-SendUpdate-id-0012" targetRef="EndEvent-ProcessCompleteWithOngoingMonitoring-id-0013" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Feedback-Collection-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Feedback-Collection-Process-id-0001" bpmnElement="Feedback-Collection-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-FeedbackCollectionProcessStarts-id-0001_di" bpmnElement="StartEvent-FeedbackCollectionProcessStarts-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CollectFeedback-id-0002_di" bpmnElement="ServiceTask-CollectFeedback-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AnalyzeFeedback-id-0003_di" bpmnElement="ServiceTask-AnalyzeFeedback-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CreateActionPlans-id-0004_di" bpmnElement="UserTask-CreateActionPlans-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ImplementChanges-id-0005_di" bpmnElement="ServiceTask-ImplementChanges-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendNotification-id-0006_di" bpmnElement="SendTask-SendNotification-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ReMeasureSatisfaction-id-0007_di" bpmnElement="ServiceTask-ReMeasureSatisfaction-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-FeedbackImprovement-id-0008_di" bpmnElement="ExclusiveGateway-FeedbackImprovement-id-0008" isMarkerVisible="true">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessCompleteWithImprovement-id-0009_di" bpmnElement="EndEvent-ProcessCompleteWithImprovement-id-0009">
        <dc:Bounds x="1257" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessCompleteWithStableFeedback-id-0010_di" bpmnElement="EndEvent-ProcessCompleteWithStableFeedback-id-0010">
        <dc:Bounds x="1257" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ReEvaluateFeedback-id-0011_di" bpmnElement="ServiceTask-ReEvaluateFeedback-id-0011">
        <dc:Bounds x="1225" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendUpdate-id-0012_di" bpmnElement="SendTask-SendUpdate-id-0012">
        <dc:Bounds x="1375" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessCompleteWithOngoingMonitoring-id-0013_di" bpmnElement="EndEvent-ProcessCompleteWithOngoingMonitoring-id-0013">
        <dc:Bounds x="1557" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCollect-id-0014_di" bpmnElement="SequenceFlow-StartToCollect-id-0014">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CollectToAnalyze-id-0015_di" bpmnElement="SequenceFlow-CollectToAnalyze-id-0015">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalyzeToCreate-id-0016_di" bpmnElement="SequenceFlow-AnalyzeToCreate-id-0016">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CreateToImplement-id-0017_di" bpmnElement="SequenceFlow-CreateToImplement-id-0017">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ImplementToSend-id-0018_di" bpmnElement="SequenceFlow-ImplementToSend-id-0018">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendToReMeasure-id-0019_di" bpmnElement="SequenceFlow-SendToReMeasure-id-0019">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReMeasureToGateway-id-0020_di" bpmnElement="SequenceFlow-ReMeasureToGateway-id-0020">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToImprovement-id-0021_di" bpmnElement="SequenceFlow-GatewayToImprovement-id-0021">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1257" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToStable-id-0022_di" bpmnElement="SequenceFlow-GatewayToStable-id-0022">
        <di:waypoint x="1125" y="95" />
        <di:waypoint x="1125" y="210" />
        <di:waypoint x="1257" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToReEvaluate-id-0023_di" bpmnElement="SequenceFlow-GatewayToReEvaluate-id-0023">
        <di:waypoint x="1125" y="95" />
        <di:waypoint x="1125" y="350" />
        <di:waypoint x="1225" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReEvaluateToSendUpdate-id-0024_di" bpmnElement="SequenceFlow-ReEvaluateToSendUpdate-id-0024">
        <di:waypoint x="1325" y="350" />
        <di:waypoint x="1375" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendUpdateToMonitoring-id-0025_di" bpmnElement="SequenceFlow-SendUpdateToMonitoring-id-0025">
        <di:waypoint x="1475" y="350" />
        <di:waypoint x="1557" y="350" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
