<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="FacilityInspectionProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="FacilityInspectionProcess-id-0001" name="Facility Inspection Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-InspectionInitiated-id-0001" name="Inspection Initiated">
      <bpmn:outgoing>SequenceFlow-StartToIdentifyHazards-id-0012</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-IdentifyHazards-id-0002" name="Identify Hazards">
      <bpmn:incoming>SequenceFlow-StartToIdentifyHazards-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdentifyToRecommend-id-0013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-RecommendCorrectiveActions-id-0003" name="Recommend Corrective Actions">
      <bpmn:incoming>SequenceFlow-IdentifyToRecommend-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RecommendToDocument-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DocumentFindings-id-0004" name="Document Findings">
      <bpmn:incoming>SequenceFlow-RecommendToDocument-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentToReview-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ReviewFindings-id-0005" name="Review Findings">
      <bpmn:incoming>SequenceFlow-DocumentToReview-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToImplement-id-0016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ImplementCorrectiveActions-id-0006" name="Implement Corrective Actions">
      <bpmn:incoming>SequenceFlow-ReviewToImplement-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ImplementToVerify-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-VerifyCompliance-id-0007" name="Verify Compliance">
      <bpmn:incoming>SequenceFlow-ImplementToVerify-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToGateway-id-0018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ComplianceCheck-id-0008" name="Compliance Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-VerifyToGateway-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToCompliance-id-0019</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToAssess-id-0020</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-FullComplianceAchieved-id-0009" name="Full Compliance Achieved">
      <bpmn:incoming>SequenceFlow-GatewayToCompliance-id-0019</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-AssessComplianceStatus-id-0010" name="Assess Compliance Status">
      <bpmn:incoming>SequenceFlow-GatewayToAssess-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssessToPenalties-id-0021</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-PenaltiesApplied-id-0011" name="Penalties Applied">
      <bpmn:incoming>SequenceFlow-AssessToPenalties-id-0021</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToIdentifyHazards-id-0012" sourceRef="StartEvent-InspectionInitiated-id-0001" targetRef="UserTask-IdentifyHazards-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-IdentifyToRecommend-id-0013" sourceRef="UserTask-IdentifyHazards-id-0002" targetRef="UserTask-RecommendCorrectiveActions-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-RecommendToDocument-id-0014" sourceRef="UserTask-RecommendCorrectiveActions-id-0003" targetRef="UserTask-DocumentFindings-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-DocumentToReview-id-0015" sourceRef="UserTask-DocumentFindings-id-0004" targetRef="UserTask-ReviewFindings-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToImplement-id-0016" sourceRef="UserTask-ReviewFindings-id-0005" targetRef="UserTask-ImplementCorrectiveActions-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-ImplementToVerify-id-0017" sourceRef="UserTask-ImplementCorrectiveActions-id-0006" targetRef="UserTask-VerifyCompliance-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyToGateway-id-0018" sourceRef="UserTask-VerifyCompliance-id-0007" targetRef="ExclusiveGateway-ComplianceCheck-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToCompliance-id-0019" name="Full Compliance Achieved" sourceRef="ExclusiveGateway-ComplianceCheck-id-0008" targetRef="EndEvent-FullComplianceAchieved-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToAssess-id-0020" name="Non-Compliance Detected" sourceRef="ExclusiveGateway-ComplianceCheck-id-0008" targetRef="UserTask-AssessComplianceStatus-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-AssessToPenalties-id-0021" sourceRef="UserTask-AssessComplianceStatus-id-0010" targetRef="EndEvent-PenaltiesApplied-id-0011" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_FacilityInspectionProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_FacilityInspectionProcess-id-0001" bpmnElement="FacilityInspectionProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-InspectionInitiated-id-0001_di" bpmnElement="StartEvent-InspectionInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-IdentifyHazards-id-0002_di" bpmnElement="UserTask-IdentifyHazards-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-RecommendCorrectiveActions-id-0003_di" bpmnElement="UserTask-RecommendCorrectiveActions-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DocumentFindings-id-0004_di" bpmnElement="UserTask-DocumentFindings-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewFindings-id-0005_di" bpmnElement="UserTask-ReviewFindings-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ImplementCorrectiveActions-id-0006_di" bpmnElement="UserTask-ImplementCorrectiveActions-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-VerifyCompliance-id-0007_di" bpmnElement="UserTask-VerifyCompliance-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ComplianceCheck-id-0008_di" bpmnElement="ExclusiveGateway-ComplianceCheck-id-0008" isMarkerVisible="true">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-FullComplianceAchieved-id-0009_di" bpmnElement="EndEvent-FullComplianceAchieved-id-0009">
        <dc:Bounds x="1257" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AssessComplianceStatus-id-0010_di" bpmnElement="UserTask-AssessComplianceStatus-id-0010">
        <dc:Bounds x="1225" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PenaltiesApplied-id-0011_di" bpmnElement="EndEvent-PenaltiesApplied-id-0011">
        <dc:Bounds x="1407" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToIdentifyHazards-id-0012_di" bpmnElement="SequenceFlow-StartToIdentifyHazards-id-0012">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-IdentifyToRecommend-id-0013_di" bpmnElement="SequenceFlow-IdentifyToRecommend-id-0013">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RecommendToDocument-id-0014_di" bpmnElement="SequenceFlow-RecommendToDocument-id-0014">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DocumentToReview-id-0015_di" bpmnElement="SequenceFlow-DocumentToReview-id-0015">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToImplement-id-0016_di" bpmnElement="SequenceFlow-ReviewToImplement-id-0016">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ImplementToVerify-id-0017_di" bpmnElement="SequenceFlow-ImplementToVerify-id-0017">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-VerifyToGateway-id-0018_di" bpmnElement="SequenceFlow-VerifyToGateway-id-0018">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToCompliance-id-0019_di" bpmnElement="SequenceFlow-GatewayToCompliance-id-0019">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1257" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToAssess-id-0020_di" bpmnElement="SequenceFlow-GatewayToAssess-id-0020">
        <di:waypoint x="1125" y="95" />
        <di:waypoint x="1125" y="210" />
        <di:waypoint x="1225" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssessToPenalties-id-0021_di" bpmnElement="SequenceFlow-AssessToPenalties-id-0021">
        <di:waypoint x="1325" y="210" />
        <di:waypoint x="1407" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
