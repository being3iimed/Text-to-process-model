<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="competency-mapping-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Competency-Mapping-Process-id-0001" name="Competency Mapping Process">
    <bpmn:startEvent id="StartEvent-ProcessStarts-id-0001" name="Competency Mapping Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToAnalyze-id-0009</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-AnalyzeSkills-id-0002" name="Analyze current skills and future requirements">
      <bpmn:incoming>SequenceFlow-StartToAnalyze-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeToIdentify-id-0010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-IdentifyGaps-id-0003" name="Identify skill gaps">
      <bpmn:incoming>SequenceFlow-AnalyzeToIdentify-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdentifyToTraining-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess-TrainingDesign-id-0004" name="Training Program Design">
      <bpmn:incoming>SequenceFlow-IdentifyToTraining-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainingToParticipation-id-0012</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-TrainingDesignBegins-id-0001" name="Training Design Begins">
        <bpmn:outgoing>SequenceFlow-StartToObjectives-id-0006</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-CreateObjectives-id-0002" name="Create learning objectives">
        <bpmn:incoming>SequenceFlow-StartToObjectives-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ObjectivesToContent-id-0007</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-DevelopContent-id-0003" name="Develop training content">
        <bpmn:incoming>SequenceFlow-ObjectivesToContent-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ContentToScheduling-id-0008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-ScheduleSessions-id-0004" name="Schedule training sessions">
        <bpmn:incoming>SequenceFlow-ContentToScheduling-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SchedulingToEnd-id-0009</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-TrainingDesigned-id-0005" name="Training Programs Designed">
        <bpmn:incoming>SequenceFlow-SchedulingToEnd-id-0009</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToObjectives-id-0006" sourceRef="StartEvent-TrainingDesignBegins-id-0001" targetRef="ServiceTask-CreateObjectives-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-ObjectivesToContent-id-0007" sourceRef="ServiceTask-CreateObjectives-id-0002" targetRef="ServiceTask-DevelopContent-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-ContentToScheduling-id-0008" sourceRef="ServiceTask-DevelopContent-id-0003" targetRef="ServiceTask-ScheduleSessions-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-SchedulingToEnd-id-0009" sourceRef="ServiceTask-ScheduleSessions-id-0004" targetRef="EndEvent-TrainingDesigned-id-0005" />
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask-EmployeeParticipation-id-0005" name="Employees participate in upskilling initiatives">
      <bpmn:incoming>SequenceFlow-TrainingToParticipation-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ParticipationToAssessment-id-0013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SubProcess-ProgressAssessment-id-0006" name="Progress Assessment">
      <bpmn:incoming>SequenceFlow-ParticipationToAssessment-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssessmentToUpdate-id-0014</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-AssessmentBegins-id-0001" name="Assessment Begins">
        <bpmn:outgoing>SequenceFlow-StartToAssessments-id-0006</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-ConductAssessments-id-0002" name="Conduct skill assessments">
        <bpmn:incoming>SequenceFlow-StartToAssessments-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AssessmentsToAnalysis-id-0007</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-AnalyzeResults-id-0003" name="Analyze assessment results">
        <bpmn:incoming>SequenceFlow-AssessmentsToAnalysis-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AnalysisToFeedback-id-0008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-ProvideFeedback-id-0004" name="Provide feedback to employees">
        <bpmn:incoming>SequenceFlow-AnalysisToFeedback-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-FeedbackToEnd-id-0009</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-AssessmentComplete-id-0005" name="Assessment Complete">
        <bpmn:incoming>SequenceFlow-FeedbackToEnd-id-0009</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToAssessments-id-0006" sourceRef="StartEvent-AssessmentBegins-id-0001" targetRef="ServiceTask-ConductAssessments-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-AssessmentsToAnalysis-id-0007" sourceRef="ServiceTask-ConductAssessments-id-0002" targetRef="ServiceTask-AnalyzeResults-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-AnalysisToFeedback-id-0008" sourceRef="ServiceTask-AnalyzeResults-id-0003" targetRef="ServiceTask-ProvideFeedback-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-FeedbackToEnd-id-0009" sourceRef="ServiceTask-ProvideFeedback-id-0004" targetRef="EndEvent-AssessmentComplete-id-0005" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="ServiceTask-UpdateFrameworks-id-0007" name="Update competency frameworks based on assessment results">
      <bpmn:incoming>SequenceFlow-AssessmentToUpdate-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToEnd-id-0015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0008" name="Competency Mapping Process Complete">
      <bpmn:incoming>SequenceFlow-UpdateToEnd-id-0015</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToAnalyze-id-0009" sourceRef="StartEvent-ProcessStarts-id-0001" targetRef="ServiceTask-AnalyzeSkills-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToIdentify-id-0010" sourceRef="ServiceTask-AnalyzeSkills-id-0002" targetRef="ServiceTask-IdentifyGaps-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-IdentifyToTraining-id-0011" sourceRef="ServiceTask-IdentifyGaps-id-0003" targetRef="SubProcess-TrainingDesign-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-TrainingToParticipation-id-0012" sourceRef="SubProcess-TrainingDesign-id-0004" targetRef="UserTask-EmployeeParticipation-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ParticipationToAssessment-id-0013" sourceRef="UserTask-EmployeeParticipation-id-0005" targetRef="SubProcess-ProgressAssessment-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-AssessmentToUpdate-id-0014" sourceRef="SubProcess-ProgressAssessment-id-0006" targetRef="ServiceTask-UpdateFrameworks-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToEnd-id-0015" sourceRef="ServiceTask-UpdateFrameworks-id-0007" targetRef="EndEvent-ProcessComplete-id-0008" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Competency-Mapping-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Competency-Mapping-Process-id-0001" bpmnElement="Competency-Mapping-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProcessStarts-id-0001_di" bpmnElement="StartEvent-ProcessStarts-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AnalyzeSkills-id-0002_di" bpmnElement="ServiceTask-AnalyzeSkills-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-IdentifyGaps-id-0003_di" bpmnElement="ServiceTask-IdentifyGaps-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-TrainingDesign-id-0004_di" bpmnElement="SubProcess-TrainingDesign-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EmployeeParticipation-id-0005_di" bpmnElement="UserTask-EmployeeParticipation-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-ProgressAssessment-id-0006_di" bpmnElement="SubProcess-ProgressAssessment-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-UpdateFrameworks-id-0007_di" bpmnElement="ServiceTask-UpdateFrameworks-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessComplete-id-0008_di" bpmnElement="EndEvent-ProcessComplete-id-0008">
        <dc:Bounds x="1107" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToAnalyze-id-0009_di" bpmnElement="SequenceFlow-StartToAnalyze-id-0009">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalyzeToIdentify-id-0010_di" bpmnElement="SequenceFlow-AnalyzeToIdentify-id-0010">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-IdentifyToTraining-id-0011_di" bpmnElement="SequenceFlow-IdentifyToTraining-id-0011">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TrainingToParticipation-id-0012_di" bpmnElement="SequenceFlow-TrainingToParticipation-id-0012">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ParticipationToAssessment-id-0013_di" bpmnElement="SequenceFlow-ParticipationToAssessment-id-0013">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssessmentToUpdate-id-0014_di" bpmnElement="SequenceFlow-AssessmentToUpdate-id-0014">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UpdateToEnd-id-0015_di" bpmnElement="SequenceFlow-UpdateToEnd-id-0015">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1107" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-ProgressAssessment-id-0006">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-ProgressAssessment-id-0006" bpmnElement="SubProcess-ProgressAssessment-id-0006">
      <bpmndi:BPMNShape id="StartEvent-AssessmentBegins-id-0001_di" bpmnElement="StartEvent-AssessmentBegins-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ConductAssessments-id-0002_di" bpmnElement="ServiceTask-ConductAssessments-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AnalyzeResults-id-0003_di" bpmnElement="ServiceTask-AnalyzeResults-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProvideFeedback-id-0004_di" bpmnElement="ServiceTask-ProvideFeedback-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-AssessmentComplete-id-0005_di" bpmnElement="EndEvent-AssessmentComplete-id-0005">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToAssessments-id-0006_di" bpmnElement="SequenceFlow-StartToAssessments-id-0006">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssessmentsToAnalysis-id-0007_di" bpmnElement="SequenceFlow-AssessmentsToAnalysis-id-0007">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalysisToFeedback-id-0008_di" bpmnElement="SequenceFlow-AnalysisToFeedback-id-0008">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FeedbackToEnd-id-0009_di" bpmnElement="SequenceFlow-FeedbackToEnd-id-0009">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-TrainingDesign-id-0004">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-TrainingDesign-id-0004" bpmnElement="SubProcess-TrainingDesign-id-0004">
      <bpmndi:BPMNShape id="StartEvent-TrainingDesignBegins-id-0001_di" bpmnElement="StartEvent-TrainingDesignBegins-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CreateObjectives-id-0002_di" bpmnElement="ServiceTask-CreateObjectives-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DevelopContent-id-0003_di" bpmnElement="ServiceTask-DevelopContent-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ScheduleSessions-id-0004_di" bpmnElement="ServiceTask-ScheduleSessions-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-TrainingDesigned-id-0005_di" bpmnElement="EndEvent-TrainingDesigned-id-0005">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToObjectives-id-0006_di" bpmnElement="SequenceFlow-StartToObjectives-id-0006">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ObjectivesToContent-id-0007_di" bpmnElement="SequenceFlow-ObjectivesToContent-id-0007">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ContentToScheduling-id-0008_di" bpmnElement="SequenceFlow-ContentToScheduling-id-0008">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SchedulingToEnd-id-0009_di" bpmnElement="SequenceFlow-SchedulingToEnd-id-0009">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
