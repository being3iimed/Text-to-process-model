<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="RecallProcess-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="RecallProcess-id-0001" name="Product Recall Process">
    <bpmn:startEvent id="StartEvent-DefectSafetyIssueIdentified-id-0001" name="Defect/Safety Issue Identified">
      <bpmn:outgoing>SequenceFlow-StartToInvestigate-id-0017</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-InvestigateIssue-id-0002" name="Investigate Issue">
      <bpmn:incoming>SequenceFlow-StartToInvestigate-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InvestigateToDraft-id-0018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-DraftRecallNotice-id-0003" name="Draft Recall Notice">
      <bpmn:incoming>SequenceFlow-InvestigateToDraft-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DraftToSplit-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0004" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-DraftToSplit-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToSendNotice-id-0020</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToPrepareReturns-id-0021</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="SendTask-SendRecallNotice-id-0005" name="Send: Recall Notice">
      <bpmn:incoming>SequenceFlow-SplitToSendNotice-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendNoticeToJoin-id-0022</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-PrepareReturnCenters-id-0006" name="Prepare Return Centers">
      <bpmn:incoming>SequenceFlow-SplitToPrepareReturns-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareReturnsToJoin-id-0023</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0007" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-SendNoticeToJoin-id-0022</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PrepareReturnsToJoin-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToReceive-id-0024</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:receiveTask id="ReceiveTask-ReceiveReturnedProducts-id-0008" name="Receive: Returned Products">
      <bpmn:incoming>SequenceFlow-JoinToReceive-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToInspect-id-0025</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="UserTask-InspectReturnedProducts-id-0009" name="Inspect Returned Products">
      <bpmn:incoming>SequenceFlow-ReceiveToInspect-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InspectToGateway-id-0026</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ProductRepairable-id-0010" name="Product Repairable?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-InspectToGateway-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToRepair-id-0027</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToShip-id-0028</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToRefund-id-0029</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-RepairProduct-id-0011" name="Repair Product">
      <bpmn:incoming>SequenceFlow-GatewayToRepair-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RepairToAnalyze-id-0030</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ShipReplacement-id-0012" name="Ship Replacement">
      <bpmn:incoming>SequenceFlow-GatewayToShip-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ShipToAnalyze-id-0031</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ProcessRefund-id-0013" name="Process Refund">
      <bpmn:incoming>SequenceFlow-GatewayToRefund-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RefundToAnalyze-id-0032</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-AnalyzeRootCauses-id-0014" name="Analyze Root Causes">
      <bpmn:incoming>SequenceFlow-RepairToAnalyze-id-0030</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ShipToAnalyze-id-0031</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-RefundToAnalyze-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeToImplement-id-0033</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ImplementPreventiveMeasures-id-0015" name="Implement Preventive Measures">
      <bpmn:incoming>SequenceFlow-AnalyzeToImplement-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ImplementToEnd-id-0034</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-RecallProcessComplete-id-0016" name="Recall Process Complete">
      <bpmn:incoming>SequenceFlow-ImplementToEnd-id-0034</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToInvestigate-id-0017" sourceRef="StartEvent-DefectSafetyIssueIdentified-id-0001" targetRef="UserTask-InvestigateIssue-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-InvestigateToDraft-id-0018" sourceRef="UserTask-InvestigateIssue-id-0002" targetRef="ServiceTask-DraftRecallNotice-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-DraftToSplit-id-0019" sourceRef="ServiceTask-DraftRecallNotice-id-0003" targetRef="ParallelGateway-Split-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToSendNotice-id-0020" sourceRef="ParallelGateway-Split-id-0004" targetRef="SendTask-SendRecallNotice-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToPrepareReturns-id-0021" sourceRef="ParallelGateway-Split-id-0004" targetRef="ServiceTask-PrepareReturnCenters-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SendNoticeToJoin-id-0022" sourceRef="SendTask-SendRecallNotice-id-0005" targetRef="ParallelGateway-Join-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareReturnsToJoin-id-0023" sourceRef="ServiceTask-PrepareReturnCenters-id-0006" targetRef="ParallelGateway-Join-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToReceive-id-0024" sourceRef="ParallelGateway-Join-id-0007" targetRef="ReceiveTask-ReceiveReturnedProducts-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveToInspect-id-0025" sourceRef="ReceiveTask-ReceiveReturnedProducts-id-0008" targetRef="UserTask-InspectReturnedProducts-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-InspectToGateway-id-0026" sourceRef="UserTask-InspectReturnedProducts-id-0009" targetRef="ExclusiveGateway-ProductRepairable-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToRepair-id-0027" name="product_repairable" sourceRef="ExclusiveGateway-ProductRepairable-id-0010" targetRef="ServiceTask-RepairProduct-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToShip-id-0028" name="product_replaceable" sourceRef="ExclusiveGateway-ProductRepairable-id-0010" targetRef="ServiceTask-ShipReplacement-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToRefund-id-0029" sourceRef="ExclusiveGateway-ProductRepairable-id-0010" targetRef="ServiceTask-ProcessRefund-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-RepairToAnalyze-id-0030" sourceRef="ServiceTask-RepairProduct-id-0011" targetRef="UserTask-AnalyzeRootCauses-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-ShipToAnalyze-id-0031" sourceRef="ServiceTask-ShipReplacement-id-0012" targetRef="UserTask-AnalyzeRootCauses-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-RefundToAnalyze-id-0032" sourceRef="ServiceTask-ProcessRefund-id-0013" targetRef="UserTask-AnalyzeRootCauses-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToImplement-id-0033" sourceRef="UserTask-AnalyzeRootCauses-id-0014" targetRef="ServiceTask-ImplementPreventiveMeasures-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-ImplementToEnd-id-0034" sourceRef="ServiceTask-ImplementPreventiveMeasures-id-0015" targetRef="EndEvent-RecallProcessComplete-id-0016" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_RecallProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_RecallProcess-id-0001" bpmnElement="RecallProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-DefectSafetyIssueIdentified-id-0001_di" bpmnElement="StartEvent-DefectSafetyIssueIdentified-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-InvestigateIssue-id-0002_di" bpmnElement="UserTask-InvestigateIssue-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DraftRecallNotice-id-0003_di" bpmnElement="ServiceTask-DraftRecallNotice-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Split-id-0004_di" bpmnElement="ParallelGateway-Split-id-0004">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendRecallNotice-id-0005_di" bpmnElement="SendTask-SendRecallNotice-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Join-id-0007_di" bpmnElement="ParallelGateway-Join-id-0007">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveReturnedProducts-id-0008_di" bpmnElement="ReceiveTask-ReceiveReturnedProducts-id-0008">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-InspectReturnedProducts-id-0009_di" bpmnElement="UserTask-InspectReturnedProducts-id-0009">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ProductRepairable-id-0010_di" bpmnElement="ExclusiveGateway-ProductRepairable-id-0010" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RepairProduct-id-0011_di" bpmnElement="ServiceTask-RepairProduct-id-0011">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AnalyzeRootCauses-id-0014_di" bpmnElement="UserTask-AnalyzeRootCauses-id-0014">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ImplementPreventiveMeasures-id-0015_di" bpmnElement="ServiceTask-ImplementPreventiveMeasures-id-0015">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RecallProcessComplete-id-0016_di" bpmnElement="EndEvent-RecallProcessComplete-id-0016">
        <dc:Bounds x="1857" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PrepareReturnCenters-id-0006_di" bpmnElement="ServiceTask-PrepareReturnCenters-id-0006">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ShipReplacement-id-0012_di" bpmnElement="ServiceTask-ShipReplacement-id-0012">
        <dc:Bounds x="1375" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcessRefund-id-0013_di" bpmnElement="ServiceTask-ProcessRefund-id-0013">
        <dc:Bounds x="1375" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToInvestigate-id-0017_di" bpmnElement="SequenceFlow-StartToInvestigate-id-0017">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InvestigateToDraft-id-0018_di" bpmnElement="SequenceFlow-InvestigateToDraft-id-0018">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DraftToSplit-id-0019_di" bpmnElement="SequenceFlow-DraftToSplit-id-0019">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToSendNotice-id-0020_di" bpmnElement="SequenceFlow-SplitToSendNotice-id-0020">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToPrepareReturns-id-0021_di" bpmnElement="SequenceFlow-SplitToPrepareReturns-id-0021">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendNoticeToJoin-id-0022_di" bpmnElement="SequenceFlow-SendNoticeToJoin-id-0022">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-JoinToReceive-id-0024_di" bpmnElement="SequenceFlow-JoinToReceive-id-0024">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveToInspect-id-0025_di" bpmnElement="SequenceFlow-ReceiveToInspect-id-0025">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InspectToGateway-id-0026_di" bpmnElement="SequenceFlow-InspectToGateway-id-0026">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1250" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToRepair-id-0027_di" bpmnElement="SequenceFlow-GatewayToRepair-id-0027">
        <di:waypoint x="1300" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToShip-id-0028_di" bpmnElement="SequenceFlow-GatewayToShip-id-0028">
        <di:waypoint x="1275" y="95" />
        <di:waypoint x="1275" y="210" />
        <di:waypoint x="1375" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToRefund-id-0029_di" bpmnElement="SequenceFlow-GatewayToRefund-id-0029">
        <di:waypoint x="1275" y="95" />
        <di:waypoint x="1275" y="350" />
        <di:waypoint x="1375" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RepairToAnalyze-id-0030_di" bpmnElement="SequenceFlow-RepairToAnalyze-id-0030">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1525" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalyzeToImplement-id-0033_di" bpmnElement="SequenceFlow-AnalyzeToImplement-id-0033">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1675" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ImplementToEnd-id-0034_di" bpmnElement="SequenceFlow-ImplementToEnd-id-0034">
        <di:waypoint x="1775" y="70" />
        <di:waypoint x="1857" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PrepareReturnsToJoin-id-0023_di" bpmnElement="SequenceFlow-PrepareReturnsToJoin-id-0023">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="825" y="210" />
        <di:waypoint x="825" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ShipToAnalyze-id-0031_di" bpmnElement="SequenceFlow-ShipToAnalyze-id-0031">
        <di:waypoint x="1475" y="210" />
        <di:waypoint x="1575" y="210" />
        <di:waypoint x="1575" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RefundToAnalyze-id-0032_di" bpmnElement="SequenceFlow-RefundToAnalyze-id-0032">
        <di:waypoint x="1475" y="350" />
        <di:waypoint x="1575" y="350" />
        <di:waypoint x="1575" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
