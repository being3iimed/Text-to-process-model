<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="empty-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Employee-Skill-Development-Process-id-0001">
    <bpmn:startEvent id="StartEvent-ProcessInitiated-id-0001" name="Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToIdentify-id-0013</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-IdentifySkillGaps-id-0002" name="Identify Skill Gaps">
      <bpmn:incoming>SequenceFlow-StartToIdentify-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdentifyToDevelop-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-DevelopTrainingPlan-id-0003" name="Develop Training Plan">
      <bpmn:incoming>SequenceFlow-IdentifyToDevelop-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DevelopToEnroll-id-0015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-EnrollEmployees-id-0004" name="Enroll Employees">
      <bpmn:incoming>SequenceFlow-DevelopToEnroll-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnrollToTrack-id-0016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-TrackAttendanceAndProgress-id-0005" name="Track Attendance and Progress">
      <bpmn:incoming>SequenceFlow-EnrollToTrack-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrackToAdminister-id-0017</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AdministerAssessments-id-0006" name="Administer Assessments">
      <bpmn:incoming>SequenceFlow-TrackToAdminister-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdministerToGateway-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AssessmentResults-id-0007" name="Assessment Results Indicate Skill Gaps?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AdministerToGateway-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToAdditionalTraining-id-0019</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToCollectFeedback-id-0020</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-RecommendAdditionalTraining-id-0008" name="Recommend Additional Training">
      <bpmn:incoming>SequenceFlow-GatewayToAdditionalTraining-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdditionalTrainingToUpdate-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-CollectFeedback-id-0009" name="Collect Feedback">
      <bpmn:incoming>SequenceFlow-GatewayToCollectFeedback-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CollectFeedbackToUpdate-id-0022</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-UpdateSkillRecords-id-0010" name="Update Skill Records">
      <bpmn:incoming>SequenceFlow-AdditionalTrainingToUpdate-id-0021</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CollectFeedbackToUpdate-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToRecommend-id-0023</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-RecommendFutureTraining-id-0011" name="Recommend Future Training">
      <bpmn:incoming>SequenceFlow-UpdateToRecommend-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RecommendToEnd-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0012" name="Process Complete">
      <bpmn:incoming>SequenceFlow-RecommendToEnd-id-0024</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToIdentify-id-0013" sourceRef="StartEvent-ProcessInitiated-id-0001" targetRef="UserTask-IdentifySkillGaps-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-IdentifyToDevelop-id-0014" sourceRef="UserTask-IdentifySkillGaps-id-0002" targetRef="ServiceTask-DevelopTrainingPlan-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-DevelopToEnroll-id-0015" sourceRef="ServiceTask-DevelopTrainingPlan-id-0003" targetRef="UserTask-EnrollEmployees-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-EnrollToTrack-id-0016" sourceRef="UserTask-EnrollEmployees-id-0004" targetRef="ServiceTask-TrackAttendanceAndProgress-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-TrackToAdminister-id-0017" sourceRef="ServiceTask-TrackAttendanceAndProgress-id-0005" targetRef="ServiceTask-AdministerAssessments-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-AdministerToGateway-id-0018" sourceRef="ServiceTask-AdministerAssessments-id-0006" targetRef="ExclusiveGateway-AssessmentResults-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToAdditionalTraining-id-0019" name="assessment_results_indicate_skill_gaps" sourceRef="ExclusiveGateway-AssessmentResults-id-0007" targetRef="ServiceTask-RecommendAdditionalTraining-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToCollectFeedback-id-0020" sourceRef="ExclusiveGateway-AssessmentResults-id-0007" targetRef="UserTask-CollectFeedback-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-AdditionalTrainingToUpdate-id-0021" sourceRef="ServiceTask-RecommendAdditionalTraining-id-0008" targetRef="ServiceTask-UpdateSkillRecords-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-CollectFeedbackToUpdate-id-0022" sourceRef="UserTask-CollectFeedback-id-0009" targetRef="ServiceTask-UpdateSkillRecords-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToRecommend-id-0023" sourceRef="ServiceTask-UpdateSkillRecords-id-0010" targetRef="ServiceTask-RecommendFutureTraining-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-RecommendToEnd-id-0024" sourceRef="ServiceTask-RecommendFutureTraining-id-0011" targetRef="EndEvent-ProcessComplete-id-0012" />
  </bpmn:process>
