      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-AssessmentResults-id-0007_di" bpmnElement="ExclusiveGateway-AssessmentResults-id-0007" isMarkerVisible="true">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RecommendAdditionalTraining-id-0008_di" bpmnElement="ServiceTask-RecommendAdditionalTraining-id-0008">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
