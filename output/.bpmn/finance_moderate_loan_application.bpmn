<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="LoanApplicationProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="LoanApplicationProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-LoanApplicationSubmitted-id-0001" name="Loan Application Submitted">
      <bpmn:outgoing>SequenceFlow-StartToSubmit-id-0017</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-SubmitLoanApplication-id-0002" name="Submit Loan Application">
      <bpmn:incoming>SequenceFlow-StartToSubmit-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubmitToValidate-id-0018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-PerformInitialValidation-id-0003" name="Perform Initial Validation">
      <bpmn:incoming>SequenceFlow-SubmitToValidate-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidateToGateway-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ValidationResult-id-0004" name="Validation Result" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ValidateToGateway-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidationFails-id-0020</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ValidationPasses-id-0021</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-SendValidationFailureNotification-id-0005" name="Send: Validation Failure Notification">
      <bpmn:incoming>SequenceFlow-ValidationFails-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidationFailToEnd-id-0022</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-LoanOfficerReview-id-0006" name="Loan Officer Review">
      <bpmn:incoming>SequenceFlow-ValidationPasses-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToRequestDocs-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-RequestAdditionalDocumentation-id-0007" name="Request Additional Documentation">
      <bpmn:incoming>SequenceFlow-ReviewToRequestDocs-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RequestDocsToRiskAssessment-id-0024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-RunRiskAssessment-id-0008" name="Run Risk Assessment">
      <bpmn:incoming>SequenceFlow-RequestDocsToRiskAssessment-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RiskAssessmentToGateway-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RiskAssessmentResult-id-0009" name="Risk Assessment Result" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-RiskAssessmentToGateway-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RiskApproved-id-0026</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-RiskRejected-id-0027</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-GenerateLoanTerms-id-0010" name="Generate Loan Terms">
      <bpmn:incoming>SequenceFlow-RiskApproved-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateTermsToAccept-id-0028</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-AcceptLoanTerms-id-0011" name="Accept Loan Terms">
      <bpmn:incoming>SequenceFlow-GenerateTermsToAccept-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AcceptTermsToGateway-id-0029</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-TermsAcceptanceResult-id-0012" name="Terms Acceptance Result" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AcceptTermsToGateway-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TermsAccepted-id-0030</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-TermsRejected-id-0031</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-FundLoan-id-0013" name="Fund Loan">
      <bpmn:incoming>SequenceFlow-TermsAccepted-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FundLoanToEnd-id-0032</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendLoanRejectionNotification-id-0014" name="Send: Loan Rejection Notification">
      <bpmn:incoming>SequenceFlow-RiskRejected-id-0027</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-TermsRejected-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RejectionToEnd-id-0033</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask-SendLoanApprovalNotification-id-0015" name="Send: Loan Approval Notification" />
    <bpmn:endEvent id="EndEvent-LoanProcessComplete-id-0016" name="Loan Process Complete">
      <bpmn:incoming>SequenceFlow-ValidationFailToEnd-id-0022</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-FundLoanToEnd-id-0032</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-RejectionToEnd-id-0033</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSubmit-id-0017" sourceRef="StartEvent-LoanApplicationSubmitted-id-0001" targetRef="UserTask-SubmitLoanApplication-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SubmitToValidate-id-0018" sourceRef="UserTask-SubmitLoanApplication-id-0002" targetRef="ServiceTask-PerformInitialValidation-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidateToGateway-id-0019" sourceRef="ServiceTask-PerformInitialValidation-id-0003" targetRef="ExclusiveGateway-ValidationResult-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidationFails-id-0020" name="validation_fails" sourceRef="ExclusiveGateway-ValidationResult-id-0004" targetRef="SendTask-SendValidationFailureNotification-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidationPasses-id-0021" name="validation_passes" sourceRef="ExclusiveGateway-ValidationResult-id-0004" targetRef="UserTask-LoanOfficerReview-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidationFailToEnd-id-0022" sourceRef="SendTask-SendValidationFailureNotification-id-0005" targetRef="EndEvent-LoanProcessComplete-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToRequestDocs-id-0023" sourceRef="UserTask-LoanOfficerReview-id-0006" targetRef="UserTask-RequestAdditionalDocumentation-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-RequestDocsToRiskAssessment-id-0024" sourceRef="UserTask-RequestAdditionalDocumentation-id-0007" targetRef="ServiceTask-RunRiskAssessment-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-RiskAssessmentToGateway-id-0025" sourceRef="ServiceTask-RunRiskAssessment-id-0008" targetRef="ExclusiveGateway-RiskAssessmentResult-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-RiskApproved-id-0026" name="approved" sourceRef="ExclusiveGateway-RiskAssessmentResult-id-0009" targetRef="ServiceTask-GenerateLoanTerms-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-RiskRejected-id-0027" name="rejected" sourceRef="ExclusiveGateway-RiskAssessmentResult-id-0009" targetRef="SendTask-SendLoanRejectionNotification-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateTermsToAccept-id-0028" sourceRef="ServiceTask-GenerateLoanTerms-id-0010" targetRef="UserTask-AcceptLoanTerms-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-AcceptTermsToGateway-id-0029" sourceRef="UserTask-AcceptLoanTerms-id-0011" targetRef="ExclusiveGateway-TermsAcceptanceResult-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-TermsAccepted-id-0030" name="accepted" sourceRef="ExclusiveGateway-TermsAcceptanceResult-id-0012" targetRef="ServiceTask-FundLoan-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-TermsRejected-id-0031" name="rejected" sourceRef="ExclusiveGateway-TermsAcceptanceResult-id-0012" targetRef="SendTask-SendLoanRejectionNotification-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-FundLoanToEnd-id-0032" sourceRef="ServiceTask-FundLoan-id-0013" targetRef="EndEvent-LoanProcessComplete-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-RejectionToEnd-id-0033" sourceRef="SendTask-SendLoanRejectionNotification-id-0014" targetRef="EndEvent-LoanProcessComplete-id-0016" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_LoanApplicationProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_LoanApplicationProcess-id-0001" bpmnElement="LoanApplicationProcess-id-0001">
