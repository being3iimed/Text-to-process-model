<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="ticket-categorization-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Ticket-Categorization-Process-id-0001">
    <bpmn:startEvent id="StartEvent-TicketReceived-id-0001" name="Ticket Received">
      <bpmn:outgoing>SequenceFlow-StartToCategorize-id-0015</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-CategorizeTicket-id-0002" name="Categorize ticket by urgency and complexity">
      <bpmn:incoming>SequenceFlow-StartToCategorize-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CategorizeToGateway-id-0016</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-TicketPriority-id-0003" name="Ticket Priority Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CategorizeToGateway-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToSeniorResolve-id-0017</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToSeniorReview-id-0018</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToJuniorResolve-id-0019</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-SeniorResolve-id-0004" name="Senior agent reviews and resolves ticket">
      <bpmn:incoming>SequenceFlow-GatewayToSeniorResolve-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SeniorResolveToResolved-id-0020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SeniorReview-id-0005" name="Senior agent reviews ticket">
      <bpmn:incoming>SequenceFlow-GatewayToSeniorReview-id-0018</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-BoundaryToEscalateSenior-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SeniorReviewToResolved-id-0021</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-JuniorResolve-id-0006" name="Junior agent resolves ticket">
      <bpmn:incoming>SequenceFlow-GatewayToJuniorResolve-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JuniorResolveToResolved-id-0022</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer4Hour-SeniorResolve-id-0007" name="4 Hour Timeout" attachedToRef="UserTask-SeniorResolve-id-0004">
      <bpmn:outgoing>SequenceFlow-BoundaryToEscalateManager-id-0023</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer4Hour-SeniorResolve-id-0007_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer2Hour-SeniorReview-id-0008" name="2 Hour Timeout" attachedToRef="UserTask-SeniorReview-id-0005">
      <bpmn:outgoing>SequenceFlow-BoundaryToEscalateManager-id-0025</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer2Hour-SeniorReview-id-0008_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer1Hour-JuniorResolve-id-0009" name="1 Hour Timeout" attachedToRef="UserTask-JuniorResolve-id-0006">
      <bpmn:outgoing>SequenceFlow-BoundaryToEscalateSenior-id-0026</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer1Hour-JuniorResolve-id-0009_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-EscalateManager-id-0010" name="Send: escalation to manager">
      <bpmn:incoming>SequenceFlow-BoundaryToEscalateManager-id-0023</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-BoundaryToEscalateManager-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EscalateToResolved-id-0024</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-TicketResolved-id-0011" name="Ticket Resolved">
      <bpmn:incoming>SequenceFlow-SeniorResolveToResolved-id-0020</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SeniorReviewToResolved-id-0021</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-JuniorResolveToResolved-id-0022</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-EscalateToResolved-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ResolvedToUpdateStatus-id-0027</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-UpdateStatus-id-0012" name="Update ticket status to closed">
      <bpmn:incoming>SequenceFlow-ResolvedToUpdateStatus-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToFeedback-id-0028</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-CustomerFeedback-id-0013" name="Receive: customer satisfaction confirmation">
      <bpmn:incoming>SequenceFlow-UpdateToFeedback-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeedbackToComplete-id-0029</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0014" name="Process Complete">
      <bpmn:incoming>SequenceFlow-FeedbackToComplete-id-0029</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCategorize-id-0015" sourceRef="StartEvent-TicketReceived-id-0001" targetRef="ServiceTask-CategorizeTicket-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CategorizeToGateway-id-0016" sourceRef="ServiceTask-CategorizeTicket-id-0002" targetRef="ExclusiveGateway-TicketPriority-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToSeniorResolve-id-0017" name="ticket_urgency == &#34;high&#34; AND ticket_complexity == &#34;high&#34;" sourceRef="ExclusiveGateway-TicketPriority-id-0003" targetRef="UserTask-SeniorResolve-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToSeniorReview-id-0018" name="ticket_urgency == &#34;high&#34; OR ticket_complexity == &#34;high&#34;" sourceRef="ExclusiveGateway-TicketPriority-id-0003" targetRef="UserTask-SeniorReview-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToJuniorResolve-id-0019" sourceRef="ExclusiveGateway-TicketPriority-id-0003" targetRef="UserTask-JuniorResolve-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SeniorResolveToResolved-id-0020" sourceRef="UserTask-SeniorResolve-id-0004" targetRef="EndEvent-TicketResolved-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-SeniorReviewToResolved-id-0021" sourceRef="UserTask-SeniorReview-id-0005" targetRef="EndEvent-TicketResolved-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-JuniorResolveToResolved-id-0022" sourceRef="UserTask-JuniorResolve-id-0006" targetRef="EndEvent-TicketResolved-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToEscalateManager-id-0023" sourceRef="BoundaryEvent-Timer4Hour-SeniorResolve-id-0007" targetRef="SendTask-EscalateManager-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-EscalateToResolved-id-0024" sourceRef="SendTask-EscalateManager-id-0010" targetRef="EndEvent-TicketResolved-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToEscalateManager-id-0025" sourceRef="BoundaryEvent-Timer2Hour-SeniorReview-id-0008" targetRef="SendTask-EscalateManager-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToEscalateSenior-id-0026" sourceRef="BoundaryEvent-Timer1Hour-JuniorResolve-id-0009" targetRef="UserTask-SeniorReview-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ResolvedToUpdateStatus-id-0027" sourceRef="EndEvent-TicketResolved-id-0011" targetRef="ServiceTask-UpdateStatus-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToFeedback-id-0028" sourceRef="ServiceTask-UpdateStatus-id-0012" targetRef="ReceiveTask-CustomerFeedback-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-FeedbackToComplete-id-0029" sourceRef="ReceiveTask-CustomerFeedback-id-0013" targetRef="EndEvent-ProcessComplete-id-0014" />
  </bpmn:process>
</bpmn:definitions>
