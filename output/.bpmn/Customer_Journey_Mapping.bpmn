<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Customer-Experience-Improvement-Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Customer-Experience-Improvement-Process-id-0001">
    <bpmn:startEvent id="StartEvent-CustomerExperienceImprovementProcess-id-0001" name="Customer Experience Improvement Process">
      <bpmn:outgoing>SequenceFlow-StartToDocument-id-0025</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-DocumentCustomerTouchpoints-id-0002" name="Document customer touchpoints">
      <bpmn:incoming>SequenceFlow-StartToDocument-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentToIdentify-id-0026</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-IdentifyPainPoints-id-0003" name="Identify pain points and opportunities">
      <bpmn:incoming>SequenceFlow-DocumentToIdentify-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdentifyToCollaboration-id-0027</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess-CrossFunctionalCollaboration-id-0004" name="Cross-functional Collaboration">
      <bpmn:incoming>SequenceFlow-IdentifyToCollaboration-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CollaborationToUpdate-id-0028</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-CollaborationStart-id-0005" name="Collaboration Start">
        <bpmn:outgoing>SequenceFlow-StartToSplit-id-0013</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway-Split-id-0006" name="Parallel Execution" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-StartToSplit-id-0013</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToGather-id-0014</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToAnalyze-id-0015</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToReview-id-0016</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="ServiceTask-GatherFeedback-id-0007" name="Gather feedback from customer service">
        <bpmn:incoming>SequenceFlow-SplitToGather-id-0014</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GatherToJoin-id-0017</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-AnalyzeData-id-0008" name="Analyze data from marketing">
        <bpmn:incoming>SequenceFlow-SplitToAnalyze-id-0015</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AnalyzeToJoin-id-0018</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-ReviewInsights-id-0009" name="Review insights from operations">
        <bpmn:incoming>SequenceFlow-SplitToReview-id-0016</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReviewToJoin-id-0019</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway-Join-id-0010" name="Synchronize Branches" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-GatherToJoin-id-0017</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-AnalyzeToJoin-id-0018</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ReviewToJoin-id-0019</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToDevelop-id-0020</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="ServiceTask-DevelopImprovementPlan-id-0011" name="Develop improvement plan">
        <bpmn:incoming>SequenceFlow-JoinToDevelop-id-0020</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-DevelopToEnd-id-0021</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-CollaborationComplete-id-0012" name="Collaboration Complete">
        <bpmn:incoming>SequenceFlow-DevelopToEnd-id-0021</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0013" sourceRef="StartEvent-CollaborationStart-id-0005" targetRef="ParallelGateway-Split-id-0006" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToGather-id-0014" sourceRef="ParallelGateway-Split-id-0006" targetRef="ServiceTask-GatherFeedback-id-0007" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToAnalyze-id-0015" sourceRef="ParallelGateway-Split-id-0006" targetRef="ServiceTask-AnalyzeData-id-0008" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToReview-id-0016" sourceRef="ParallelGateway-Split-id-0006" targetRef="ServiceTask-ReviewInsights-id-0009" />
      <bpmn:sequenceFlow id="SequenceFlow-GatherToJoin-id-0017" sourceRef="ServiceTask-GatherFeedback-id-0007" targetRef="ParallelGateway-Join-id-0010" />
      <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToJoin-id-0018" sourceRef="ServiceTask-AnalyzeData-id-0008" targetRef="ParallelGateway-Join-id-0010" />
      <bpmn:sequenceFlow id="SequenceFlow-ReviewToJoin-id-0019" sourceRef="ServiceTask-ReviewInsights-id-0009" targetRef="ParallelGateway-Join-id-0010" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToDevelop-id-0020" sourceRef="ParallelGateway-Join-id-0010" targetRef="ServiceTask-DevelopImprovementPlan-id-0011" />
      <bpmn:sequenceFlow id="SequenceFlow-DevelopToEnd-id-0021" sourceRef="ServiceTask-DevelopImprovementPlan-id-0011" targetRef="EndEvent-CollaborationComplete-id-0012" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="ServiceTask-UpdateCustomerExperienceMaps-id-0022" name="Update customer experience maps">
      <bpmn:incoming>SequenceFlow-CollaborationToUpdate-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToMeasure-id-0029</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="ScriptTask-MeasureImprovements-id-0023" name="measure improvements">
      <bpmn:incoming>SequenceFlow-UpdateToMeasure-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MeasureToEnd-id-0030</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="EndEvent-ExperienceEnhancementsMeasured-id-0024" name="Experience Enhancements Measured">
      <bpmn:incoming>SequenceFlow-MeasureToEnd-id-0030</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDocument-id-0025" sourceRef="StartEvent-CustomerExperienceImprovementProcess-id-0001" targetRef="ServiceTask-DocumentCustomerTouchpoints-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DocumentToIdentify-id-0026" sourceRef="ServiceTask-DocumentCustomerTouchpoints-id-0002" targetRef="ServiceTask-IdentifyPainPoints-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-IdentifyToCollaboration-id-0027" sourceRef="ServiceTask-IdentifyPainPoints-id-0003" targetRef="SubProcess-CrossFunctionalCollaboration-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-CollaborationToUpdate-id-0028" sourceRef="SubProcess-CrossFunctionalCollaboration-id-0004" targetRef="ServiceTask-UpdateCustomerExperienceMaps-id-0022" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToMeasure-id-0029" sourceRef="ServiceTask-UpdateCustomerExperienceMaps-id-0022" targetRef="ScriptTask-MeasureImprovements-id-0023" />
    <bpmn:sequenceFlow id="SequenceFlow-MeasureToEnd-id-0030" sourceRef="ScriptTask-MeasureImprovements-id-0023" targetRef="EndEvent-ExperienceEnhancementsMeasured-id-0024" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Customer-Experience-Improvement-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Customer-Experience-Improvement-Process-id-0001" bpmnElement="Customer-Experience-Improvement-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-CustomerExperienceImprovementProcess-id-0001_di" bpmnElement="StartEvent-CustomerExperienceImprovementProcess-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DocumentCustomerTouchpoints-id-0002_di" bpmnElement="ServiceTask-DocumentCustomerTouchpoints-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-IdentifyPainPoints-id-0003_di" bpmnElement="ServiceTask-IdentifyPainPoints-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-CrossFunctionalCollaboration-id-0004_di" bpmnElement="SubProcess-CrossFunctionalCollaboration-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-UpdateCustomerExperienceMaps-id-0022_di" bpmnElement="ServiceTask-UpdateCustomerExperienceMaps-id-0022">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScriptTask-MeasureImprovements-id-0023_di" bpmnElement="ScriptTask-MeasureImprovements-id-0023">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ExperienceEnhancementsMeasured-id-0024_di" bpmnElement="EndEvent-ExperienceEnhancementsMeasured-id-0024">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToDocument-id-0025_di" bpmnElement="SequenceFlow-StartToDocument-id-0025">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DocumentToIdentify-id-0026_di" bpmnElement="SequenceFlow-DocumentToIdentify-id-0026">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-IdentifyToCollaboration-id-0027_di" bpmnElement="SequenceFlow-IdentifyToCollaboration-id-0027">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CollaborationToUpdate-id-0028_di" bpmnElement="SequenceFlow-CollaborationToUpdate-id-0028">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UpdateToMeasure-id-0029_di" bpmnElement="SequenceFlow-UpdateToMeasure-id-0029">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MeasureToEnd-id-0030_di" bpmnElement="SequenceFlow-MeasureToEnd-id-0030">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-CrossFunctionalCollaboration-id-0004">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-CrossFunctionalCollaboration-id-0004" bpmnElement="SubProcess-CrossFunctionalCollaboration-id-0004">
      <bpmndi:BPMNShape id="StartEvent-CollaborationStart-id-0005_di" bpmnElement="StartEvent-CollaborationStart-id-0005">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Split-id-0006_di" bpmnElement="ParallelGateway-Split-id-0006">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GatherFeedback-id-0007_di" bpmnElement="ServiceTask-GatherFeedback-id-0007">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Join-id-0010_di" bpmnElement="ParallelGateway-Join-id-0010">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DevelopImprovementPlan-id-0011_di" bpmnElement="ServiceTask-DevelopImprovementPlan-id-0011">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-CollaborationComplete-id-0012_di" bpmnElement="EndEvent-CollaborationComplete-id-0012">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AnalyzeData-id-0008_di" bpmnElement="ServiceTask-AnalyzeData-id-0008">
        <dc:Bounds x="325" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ReviewInsights-id-0009_di" bpmnElement="ServiceTask-ReviewInsights-id-0009">
        <dc:Bounds x="325" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSplit-id-0013_di" bpmnElement="SequenceFlow-StartToSplit-id-0013">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="200" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToGather-id-0014_di" bpmnElement="SequenceFlow-SplitToGather-id-0014">
        <di:waypoint x="250" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToAnalyze-id-0015_di" bpmnElement="SequenceFlow-SplitToAnalyze-id-0015">
        <di:waypoint x="225" y="95" />
        <di:waypoint x="225" y="210" />
        <di:waypoint x="325" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToReview-id-0016_di" bpmnElement="SequenceFlow-SplitToReview-id-0016">
        <di:waypoint x="225" y="95" />
        <di:waypoint x="225" y="350" />
        <di:waypoint x="325" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatherToJoin-id-0017_di" bpmnElement="SequenceFlow-GatherToJoin-id-0017">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-JoinToDevelop-id-0020_di" bpmnElement="SequenceFlow-JoinToDevelop-id-0020">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DevelopToEnd-id-0021_di" bpmnElement="SequenceFlow-DevelopToEnd-id-0021">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="807" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalyzeToJoin-id-0018_di" bpmnElement="SequenceFlow-AnalyzeToJoin-id-0018">
        <di:waypoint x="425" y="210" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="525" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToJoin-id-0019_di" bpmnElement="SequenceFlow-ReviewToJoin-id-0019">
        <di:waypoint x="425" y="350" />
        <di:waypoint x="525" y="350" />
        <di:waypoint x="525" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
