<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="remote-work-policy-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="RemoteWorkPolicyProcess-id-0001" name="Remote Work Policy Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ProcessStarts-id-0001" name="Remote Work Policy Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToSplit-id-0023</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-DefineCriteriaSplit-id-0002" name="Define Criteria Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StartToSplit-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToEligibility-id-0024</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToTools-id-0025</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToExpectations-id-0026</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-DefineEligibilityCriteria-id-0003" name="Stakeholders define eligibility criteria">
      <bpmn:incoming>SequenceFlow-SplitToEligibility-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EligibilityToJoin-id-0027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DefineRequiredTools-id-0004" name="Stakeholders define required tools">
      <bpmn:incoming>SequenceFlow-SplitToTools-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ToolsToJoin-id-0028</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DefineExpectations-id-0005" name="Stakeholders define expectations">
      <bpmn:incoming>SequenceFlow-SplitToExpectations-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExpectationsToJoin-id-0029</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-DefineCriteriaJoin-id-0006" name="Define Criteria Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-EligibilityToJoin-id-0027</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ToolsToJoin-id-0028</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ExpectationsToJoin-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToDraft-id-0030</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-DraftPolicy-id-0007" name="Draft initial policy document">
      <bpmn:incoming>SequenceFlow-JoinToDraft-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DraftToReview-id-0031</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ReviewDraft-id-0008" name="Policy team reviews draft">
      <bpmn:incoming>SequenceFlow-DraftToReview-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToFeedback-id-0032</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="ReceiveTask-EmployeeFeedback-id-0009" name="Receive: employee feedback">
      <bpmn:incoming>SequenceFlow-ReviewToFeedback-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeedbackToScript-id-0033</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:scriptTask id="ScriptTask-IncorporateFeedback-id-0010" name="Computation: incorporate feedback into final policy">
      <bpmn:incoming>SequenceFlow-FeedbackToScript-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ScriptToFinalize-id-0034</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="UserTask-FinalizePolicy-id-0011" name="Finalize policy document">
      <bpmn:incoming>SequenceFlow-ScriptToFinalize-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FinalizeToPrepareSplit-id-0035</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-PrepareMaterialsSplit-id-0012" name="Prepare Materials Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-FinalizeToPrepareSplit-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareSplitToManagers-id-0036</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PrepareSplitToStaff-id-0037</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-PrepareManagerMaterials-id-0013" name="Prepare training materials for managers">
      <bpmn:incoming>SequenceFlow-PrepareSplitToManagers-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ManagersToPrepareJoin-id-0038</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PrepareStaffMaterials-id-0014" name="Prepare training materials for staff">
      <bpmn:incoming>SequenceFlow-PrepareSplitToStaff-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StaffToPrepareJoin-id-0039</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-PrepareMaterialsJoin-id-0015" name="Prepare Materials Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ManagersToPrepareJoin-id-0038</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-StaffToPrepareJoin-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareJoinToTrainSplit-id-0040</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="ParallelGateway-TrainSplit-id-0016" name="Train Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-PrepareJoinToTrainSplit-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainSplitToManagers-id-0041</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-TrainSplitToStaff-id-0042</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-TrainManagers-id-0017" name="Train managers on remote work policies">
      <bpmn:incoming>SequenceFlow-TrainSplitToManagers-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ManagersToTrainJoin-id-0043</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-TrainStaff-id-0018" name="Train staff on remote work policies">
      <bpmn:incoming>SequenceFlow-TrainSplitToStaff-id-0042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StaffToTrainJoin-id-0044</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-TrainJoin-id-0019" name="Train Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ManagersToTrainJoin-id-0043</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-StaffToTrainJoin-id-0044</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainJoinToRollOut-id-0045</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-RollOutPolicy-id-0020" name="Roll out remote work policy">
      <bpmn:incoming>SequenceFlow-TrainJoinToRollOut-id-0045</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RollOutToTrack-id-0046</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TrackPolicy-id-0021" name="Track policy adoption and effectiveness">
      <bpmn:incoming>SequenceFlow-RollOutToTrack-id-0046</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrackToEnd-id-0047</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0022" name="Remote Work Policy Process Complete">
      <bpmn:incoming>SequenceFlow-TrackToEnd-id-0047</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0023" sourceRef="StartEvent-ProcessStarts-id-0001" targetRef="ParallelGateway-DefineCriteriaSplit-id-0002" />
