    <bpmn:sequenceFlow id="SequenceFlow-FeedbackToScript-id-0033" sourceRef="ReceiveTask-EmployeeFeedback-id-0009" targetRef="ScriptTask-IncorporateFeedback-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-ScriptToFinalize-id-0034" sourceRef="ScriptTask-IncorporateFeedback-id-0010" targetRef="UserTask-FinalizePolicy-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-FinalizeToPrepareSplit-id-0035" sourceRef="UserTask-FinalizePolicy-id-0011" targetRef="ParallelGateway-PrepareMaterialsSplit-id-0012" />
