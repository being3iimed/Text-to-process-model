        <di:waypoint x="1375" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendToArchive-id-0027_di" bpmnElement="SequenceFlow-SendToArchive-id-0027">
        <di:waypoint x="1475" y="210" />
        <di:waypoint x="1525" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ArchiveToEnd-id-0028_di" bpmnElement="SequenceFlow-ArchiveToEnd-id-0028">
