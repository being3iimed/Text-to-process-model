        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ResolveToCheck-id-0019_di" bpmnElement="SequenceFlow-ResolveToCheck-id-0019">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-Check2ToGateway2-id-0020_di" bpmnElement="SequenceFlow-Check2ToGateway2-id-0020">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="950" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-Gateway2ToDeny-id-0021_di" bpmnElement="SequenceFlow-Gateway2ToDeny-id-0021">
        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-Gateway2ToDeactivate-id-0023_di" bpmnElement="SequenceFlow-Gateway2ToDeactivate-id-0023">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DenyToEnd-id-0022_di" bpmnElement="SequenceFlow-DenyToEnd-id-0022">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1257" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DeactivateToTransfer-id-0025_di" bpmnElement="SequenceFlow-DeactivateToTransfer-id-0025">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1225" y="210" />
      </bpmndi:BPMNEdge>
