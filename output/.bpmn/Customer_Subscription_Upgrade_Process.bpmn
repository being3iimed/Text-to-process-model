<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="subscription-upgrade-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="SubscriptionUpgradeProcess-id-0001" name="Subscription Upgrade Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-SubscriptionUpgradeProcessStarts-id-0001" name="Subscription Upgrade Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToCustomerSubmits-id-0008</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CustomerSubmitsUpgradeRequest-id-0002" name="Customer submits upgrade request">
      <bpmn:incoming>SequenceFlow-StartToCustomerSubmits-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerSubmitsToCalculateCost-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CalculateCostDifferenceAndProrateCharges-id-0003" name="Calculate cost difference and prorate charges">
      <bpmn:incoming>SequenceFlow-CustomerSubmitsToCalculateCost-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateCostToProcessPayment-id-0010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ProcessPayment-id-0004" name="Process payment">
      <bpmn:incoming>SequenceFlow-CalculateCostToProcessPayment-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProcessPaymentToGrantAccess-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GrantAccessToUpgradedFeatures-id-0005" name="Grant access to upgraded features">
      <bpmn:incoming>SequenceFlow-ProcessPaymentToGrantAccess-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GrantAccessToSendConfirmation-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendUpgradeConfirmationToCustomer-id-0006" name="Send: upgrade confirmation to customer">
      <bpmn:incoming>SequenceFlow-GrantAccessToSendConfirmation-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendConfirmationToEnd-id-0013</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-SubscriptionUpgradeProcessComplete-id-0007" name="Subscription Upgrade Process Complete">
      <bpmn:incoming>SequenceFlow-SendConfirmationToEnd-id-0013</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCustomerSubmits-id-0008" sourceRef="StartEvent-SubscriptionUpgradeProcessStarts-id-0001" targetRef="UserTask-CustomerSubmitsUpgradeRequest-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerSubmitsToCalculateCost-id-0009" sourceRef="UserTask-CustomerSubmitsUpgradeRequest-id-0002" targetRef="ServiceTask-CalculateCostDifferenceAndProrateCharges-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateCostToProcessPayment-id-0010" sourceRef="ServiceTask-CalculateCostDifferenceAndProrateCharges-id-0003" targetRef="ServiceTask-ProcessPayment-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-ProcessPaymentToGrantAccess-id-0011" sourceRef="ServiceTask-ProcessPayment-id-0004" targetRef="ServiceTask-GrantAccessToUpgradedFeatures-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-GrantAccessToSendConfirmation-id-0012" sourceRef="ServiceTask-GrantAccessToUpgradedFeatures-id-0005" targetRef="SendTask-SendUpgradeConfirmationToCustomer-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SendConfirmationToEnd-id-0013" sourceRef="SendTask-SendUpgradeConfirmationToCustomer-id-0006" targetRef="EndEvent-SubscriptionUpgradeProcessComplete-id-0007" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubscriptionUpgradeProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubscriptionUpgradeProcess-id-0001" bpmnElement="SubscriptionUpgradeProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-SubscriptionUpgradeProcessStarts-id-0001_di" bpmnElement="StartEvent-SubscriptionUpgradeProcessStarts-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CustomerSubmitsUpgradeRequest-id-0002_di" bpmnElement="UserTask-CustomerSubmitsUpgradeRequest-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CalculateCostDifferenceAndProrateCharges-id-0003_di" bpmnElement="ServiceTask-CalculateCostDifferenceAndProrateCharges-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcessPayment-id-0004_di" bpmnElement="ServiceTask-ProcessPayment-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GrantAccessToUpgradedFeatures-id-0005_di" bpmnElement="ServiceTask-GrantAccessToUpgradedFeatures-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendUpgradeConfirmationToCustomer-id-0006_di" bpmnElement="SendTask-SendUpgradeConfirmationToCustomer-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-SubscriptionUpgradeProcessComplete-id-0007_di" bpmnElement="EndEvent-SubscriptionUpgradeProcessComplete-id-0007">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCustomerSubmits-id-0008_di" bpmnElement="SequenceFlow-StartToCustomerSubmits-id-0008">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CustomerSubmitsToCalculateCost-id-0009_di" bpmnElement="SequenceFlow-CustomerSubmitsToCalculateCost-id-0009">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CalculateCostToProcessPayment-id-0010_di" bpmnElement="SequenceFlow-CalculateCostToProcessPayment-id-0010">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProcessPaymentToGrantAccess-id-0011_di" bpmnElement="SequenceFlow-ProcessPaymentToGrantAccess-id-0011">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GrantAccessToSendConfirmation-id-0012_di" bpmnElement="SequenceFlow-GrantAccessToSendConfirmation-id-0012">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendConfirmationToEnd-id-0013_di" bpmnElement="SequenceFlow-SendConfirmationToEnd-id-0013">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
