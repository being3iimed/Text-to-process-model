<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Packaging-Redesign-Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Packaging-Redesign-Process-id-0001">
    <bpmn:startEvent id="StartEvent-PackagingRedesignProcessStarts-id-0001" name="Packaging Redesign Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToAnalyze-id-0013</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-AnalyzeMarketTrends-id-0002" name="Analyze market trends and customer preferences">
      <bpmn:incoming>SequenceFlow-StartToAnalyze-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeToDesign-id-0014</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-DesignersCreatePackagingMockups-id-0003" name="Designers create packaging mockups">
      <bpmn:incoming>SequenceFlow-AnalyzeToDesign-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DesignToPrototype-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-PrototypePackaging-id-0004" name="Prototype packaging for durability and aesthetics testing">
      <bpmn:incoming>SequenceFlow-DesignToPrototype-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrototypeToReceive-id-0016</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveFeedbackFromTesting-id-0005" name="Receive: feedback from testing">
      <bpmn:incoming>SequenceFlow-PrototypeToReceive-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToGateway-id-0017</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-FeedbackIndicatesRedesignNeeded-id-0006" name="Feedback indicates redesign needed?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReceiveToGateway-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToRefine-id-0018</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToProduce-id-0023</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-RefinePackagingDesignBasedOnFeedback-id-0007" name="Refine packaging design based on feedback">
      <bpmn:incoming>SequenceFlow-GatewayToRefine-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RefineToPrototypeRevised-id-0019</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-PrototypeRevisedPackaging-id-0008" name="Prototype revised packaging">
      <bpmn:incoming>SequenceFlow-RefineToPrototypeRevised-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrototypeRevisedToReceiveFinal-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveFinalFeedbackApproval-id-0009" name="Receive: final feedback approval">
      <bpmn:incoming>SequenceFlow-PrototypeRevisedToReceiveFinal-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveFinalToProduceFinal-id-0021</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="ServiceTask-ProduceFinalPackagingVersions-id-0010" name="Produce final packaging versions">
      <bpmn:incoming>SequenceFlow-ReceiveFinalToProduceFinal-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProduceFinalToEnd-id-0022</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ProducePackagingVersions-id-0011" name="Produce packaging versions">
      <bpmn:incoming>SequenceFlow-GatewayToProduce-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProduceToEnd-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-PackagingRedesignCompleteAndDistributed-id-0012" name="Packaging Redesign Complete and Distributed">
      <bpmn:incoming>SequenceFlow-ProduceFinalToEnd-id-0022</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ProduceToEnd-id-0024</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToAnalyze-id-0013" sourceRef="StartEvent-PackagingRedesignProcessStarts-id-0001" targetRef="ServiceTask-AnalyzeMarketTrends-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToDesign-id-0014" sourceRef="ServiceTask-AnalyzeMarketTrends-id-0002" targetRef="UserTask-DesignersCreatePackagingMockups-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-DesignToPrototype-id-0015" sourceRef="UserTask-DesignersCreatePackagingMockups-id-0003" targetRef="ServiceTask-PrototypePackaging-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-PrototypeToReceive-id-0016" sourceRef="ServiceTask-PrototypePackaging-id-0004" targetRef="ReceiveTask-ReceiveFeedbackFromTesting-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveToGateway-id-0017" sourceRef="ReceiveTask-ReceiveFeedbackFromTesting-id-0005" targetRef="ExclusiveGateway-FeedbackIndicatesRedesignNeeded-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToRefine-id-0018" name="Yes" sourceRef="ExclusiveGateway-FeedbackIndicatesRedesignNeeded-id-0006" targetRef="UserTask-RefinePackagingDesignBasedOnFeedback-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-RefineToPrototypeRevised-id-0019" sourceRef="UserTask-RefinePackagingDesignBasedOnFeedback-id-0007" targetRef="ServiceTask-PrototypeRevisedPackaging-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-PrototypeRevisedToReceiveFinal-id-0020" sourceRef="ServiceTask-PrototypeRevisedPackaging-id-0008" targetRef="ReceiveTask-ReceiveFinalFeedbackApproval-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveFinalToProduceFinal-id-0021" sourceRef="ReceiveTask-ReceiveFinalFeedbackApproval-id-0009" targetRef="ServiceTask-ProduceFinalPackagingVersions-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-ProduceFinalToEnd-id-0022" sourceRef="ServiceTask-ProduceFinalPackagingVersions-id-0010" targetRef="EndEvent-PackagingRedesignCompleteAndDistributed-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToProduce-id-0023" name="No" sourceRef="ExclusiveGateway-FeedbackIndicatesRedesignNeeded-id-0006" targetRef="ServiceTask-ProducePackagingVersions-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-ProduceToEnd-id-0024" sourceRef="ServiceTask-ProducePackagingVersions-id-0011" targetRef="EndEvent-PackagingRedesignCompleteAndDistributed-id-0012" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Packaging-Redesign-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Packaging-Redesign-Process-id-0001" bpmnElement="Packaging-Redesign-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-PackagingRedesignProcessStarts-id-0001_di" bpmnElement="StartEvent-PackagingRedesignProcessStarts-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AnalyzeMarketTrends-id-0002_di" bpmnElement="ServiceTask-AnalyzeMarketTrends-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DesignersCreatePackagingMockups-id-0003_di" bpmnElement="UserTask-DesignersCreatePackagingMockups-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PrototypePackaging-id-0004_di" bpmnElement="ServiceTask-PrototypePackaging-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveFeedbackFromTesting-id-0005_di" bpmnElement="ReceiveTask-ReceiveFeedbackFromTesting-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-FeedbackIndicatesRedesignNeeded-id-0006_di" bpmnElement="ExclusiveGateway-FeedbackIndicatesRedesignNeeded-id-0006" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-RefinePackagingDesignBasedOnFeedback-id-0007_di" bpmnElement="UserTask-RefinePackagingDesignBasedOnFeedback-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PrototypeRevisedPackaging-id-0008_di" bpmnElement="ServiceTask-PrototypeRevisedPackaging-id-0008">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveFinalFeedbackApproval-id-0009_di" bpmnElement="ReceiveTask-ReceiveFinalFeedbackApproval-id-0009">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProduceFinalPackagingVersions-id-0010_di" bpmnElement="ServiceTask-ProduceFinalPackagingVersions-id-0010">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PackagingRedesignCompleteAndDistributed-id-0012_di" bpmnElement="EndEvent-PackagingRedesignCompleteAndDistributed-id-0012">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProducePackagingVersions-id-0011_di" bpmnElement="ServiceTask-ProducePackagingVersions-id-0011">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToAnalyze-id-0013_di" bpmnElement="SequenceFlow-StartToAnalyze-id-0013">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalyzeToDesign-id-0014_di" bpmnElement="SequenceFlow-AnalyzeToDesign-id-0014">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DesignToPrototype-id-0015_di" bpmnElement="SequenceFlow-DesignToPrototype-id-0015">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PrototypeToReceive-id-0016_di" bpmnElement="SequenceFlow-PrototypeToReceive-id-0016">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveToGateway-id-0017_di" bpmnElement="SequenceFlow-ReceiveToGateway-id-0017">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToRefine-id-0018_di" bpmnElement="SequenceFlow-GatewayToRefine-id-0018">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToProduce-id-0023_di" bpmnElement="SequenceFlow-GatewayToProduce-id-0023">
        <di:waypoint x="825" y="95" />
        <di:waypoint x="825" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RefineToPrototypeRevised-id-0019_di" bpmnElement="SequenceFlow-RefineToPrototypeRevised-id-0019">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PrototypeRevisedToReceiveFinal-id-0020_di" bpmnElement="SequenceFlow-PrototypeRevisedToReceiveFinal-id-0020">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveFinalToProduceFinal-id-0021_di" bpmnElement="SequenceFlow-ReceiveFinalToProduceFinal-id-0021">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProduceFinalToEnd-id-0022_di" bpmnElement="SequenceFlow-ProduceFinalToEnd-id-0022">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1557" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProduceToEnd-id-0024_di" bpmnElement="SequenceFlow-ProduceToEnd-id-0024">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1575" y="210" />
        <di:waypoint x="1575" y="88" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
