<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="referral-process-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Referral-Process-id-0001" name="Referral Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ReferralProcessInitiated-id-0001" name="Referral Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToCustomerShares-id-0016</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CustomerSharesReferralCode-id-0002" name="Customer Shares Referral Code">
      <bpmn:incoming>SequenceFlow-StartToCustomerShares-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerSharesToReceive-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="ReceiveTask-ReferredPartyAction-id-0003" name="Receive Referred Party Action">
      <bpmn:incoming>SequenceFlow-CustomerSharesToReceive-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToGateway-id-0018</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ReferredPartyEligibility-id-0004" name="Referred Party Eligibility" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReceiveToGateway-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToCalculate-id-0019</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToNotification-id-0027</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-CalculateRewardAmount-id-0005" name="Calculate Reward Amount">
      <bpmn:incoming>SequenceFlow-GatewayToCalculate-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateToParallelSplit-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0006" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CalculateToParallelSplit-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ParallelSplitToNotificationReferrer-id-0021</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ParallelSplitToNotificationReferred-id-0022</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="SendTask-NotificationToReferrer-id-0007" name="Send Notification to Referrer">
      <bpmn:incoming>SequenceFlow-ParallelSplitToNotificationReferrer-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotificationReferrerToParallelJoin-id-0023</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask-NotificationToReferredParty-id-0008" name="Send Notification to Referred Party">
      <bpmn:incoming>SequenceFlow-ParallelSplitToNotificationReferred-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotificationReferredToParallelJoin-id-0024</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0009" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-NotificationReferrerToParallelJoin-id-0023</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NotificationReferredToParallelJoin-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ParallelJoinToRedeem-id-0025</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-ReferrerRedeemsReward-id-0010" name="Referrer Redeems Reward">
      <bpmn:incoming>SequenceFlow-ParallelJoinToRedeem-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RedeemToEnd-id-0026</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-RewardRedeemed-id-0011" name="Reward Redeemed">
      <bpmn:incoming>SequenceFlow-RedeemToEnd-id-0026</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-NotificationToReferrerEligibility-id-0012" name="Send Notification to Referrer (eligibility not met)">
      <bpmn:incoming>SequenceFlow-GatewayToNotification-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotificationToEnd-id-0028</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-RewardNotEarned-id-0013" name="Reward Not Earned">
      <bpmn:incoming>SequenceFlow-NotificationToEnd-id-0028</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer30Day-id-0014" name="30 Day Timeout" attachedToRef="UserTask-ReferrerRedeemsReward-id-0010">
      <bpmn:outgoing>SequenceFlow-BoundaryToEnd-id-0029</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer30Day-id-0014_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent-RewardExpired-id-0015" name="Reward Expired">
      <bpmn:incoming>SequenceFlow-BoundaryToEnd-id-0029</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCustomerShares-id-0016" sourceRef="StartEvent-ReferralProcessInitiated-id-0001" targetRef="UserTask-CustomerSharesReferralCode-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerSharesToReceive-id-0017" sourceRef="UserTask-CustomerSharesReferralCode-id-0002" targetRef="ReceiveTask-ReferredPartyAction-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveToGateway-id-0018" sourceRef="ReceiveTask-ReferredPartyAction-id-0003" targetRef="ExclusiveGateway-ReferredPartyEligibility-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToCalculate-id-0019" name="referred_party_meets_eligibility" sourceRef="ExclusiveGateway-ReferredPartyEligibility-id-0004" targetRef="ServiceTask-CalculateRewardAmount-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateToParallelSplit-id-0020" sourceRef="ServiceTask-CalculateRewardAmount-id-0005" targetRef="ParallelGateway-Split-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelSplitToNotificationReferrer-id-0021" sourceRef="ParallelGateway-Split-id-0006" targetRef="SendTask-NotificationToReferrer-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelSplitToNotificationReferred-id-0022" sourceRef="ParallelGateway-Split-id-0006" targetRef="SendTask-NotificationToReferredParty-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-NotificationReferrerToParallelJoin-id-0023" sourceRef="SendTask-NotificationToReferrer-id-0007" targetRef="ParallelGateway-Join-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-NotificationReferredToParallelJoin-id-0024" sourceRef="SendTask-NotificationToReferredParty-id-0008" targetRef="ParallelGateway-Join-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelJoinToRedeem-id-0025" sourceRef="ParallelGateway-Join-id-0009" targetRef="UserTask-ReferrerRedeemsReward-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-RedeemToEnd-id-0026" sourceRef="UserTask-ReferrerRedeemsReward-id-0010" targetRef="EndEvent-RewardRedeemed-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToNotification-id-0027" sourceRef="ExclusiveGateway-ReferredPartyEligibility-id-0004" targetRef="SendTask-NotificationToReferrerEligibility-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-NotificationToEnd-id-0028" sourceRef="SendTask-NotificationToReferrerEligibility-id-0012" targetRef="EndEvent-RewardNotEarned-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToEnd-id-0029" sourceRef="BoundaryEvent-Timer30Day-id-0014" targetRef="EndEvent-RewardExpired-id-0015" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Referral-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Referral-Process-id-0001" bpmnElement="Referral-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ReferralProcessInitiated-id-0001_di" bpmnElement="StartEvent-ReferralProcessInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CustomerSharesReferralCode-id-0002_di" bpmnElement="UserTask-CustomerSharesReferralCode-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReferredPartyAction-id-0003_di" bpmnElement="ReceiveTask-ReferredPartyAction-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ReferredPartyEligibility-id-0004_di" bpmnElement="ExclusiveGateway-ReferredPartyEligibility-id-0004" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CalculateRewardAmount-id-0005_di" bpmnElement="ServiceTask-CalculateRewardAmount-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Split-id-0006_di" bpmnElement="ParallelGateway-Split-id-0006">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-NotificationToReferrer-id-0007_di" bpmnElement="SendTask-NotificationToReferrer-id-0007">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Join-id-0009_di" bpmnElement="ParallelGateway-Join-id-0009">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReferrerRedeemsReward-id-0010_di" bpmnElement="UserTask-ReferrerRedeemsReward-id-0010">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-Timer30Day-id-0014_di" bpmnElement="BoundaryEvent-Timer30Day-id-0014">
        <dc:Bounds x="1257" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RewardRedeemed-id-0011_di" bpmnElement="EndEvent-RewardRedeemed-id-0011">
        <dc:Bounds x="1407" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-NotificationToReferrerEligibility-id-0012_di" bpmnElement="SendTask-NotificationToReferrerEligibility-id-0012">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RewardNotEarned-id-0013_di" bpmnElement="EndEvent-RewardNotEarned-id-0013">
        <dc:Bounds x="807" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-NotificationToReferredParty-id-0008_di" bpmnElement="SendTask-NotificationToReferredParty-id-0008">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RewardExpired-id-0015_di" bpmnElement="EndEvent-RewardExpired-id-0015">
        <dc:Bounds x="1557" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCustomerShares-id-0016_di" bpmnElement="SequenceFlow-StartToCustomerShares-id-0016">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CustomerSharesToReceive-id-0017_di" bpmnElement="SequenceFlow-CustomerSharesToReceive-id-0017">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveToGateway-id-0018_di" bpmnElement="SequenceFlow-ReceiveToGateway-id-0018">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToCalculate-id-0019_di" bpmnElement="SequenceFlow-GatewayToCalculate-id-0019">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToNotification-id-0027_di" bpmnElement="SequenceFlow-GatewayToNotification-id-0027">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CalculateToParallelSplit-id-0020_di" bpmnElement="SequenceFlow-CalculateToParallelSplit-id-0020">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ParallelSplitToNotificationReferrer-id-0021_di" bpmnElement="SequenceFlow-ParallelSplitToNotificationReferrer-id-0021">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ParallelSplitToNotificationReferred-id-0022_di" bpmnElement="SequenceFlow-ParallelSplitToNotificationReferred-id-0022">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="900" y="70" />
        <di:waypoint x="900" y="140" />
        <di:waypoint x="1050" y="140" />
        <di:waypoint x="1050" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-NotificationReferrerToParallelJoin-id-0023_di" bpmnElement="SequenceFlow-NotificationReferrerToParallelJoin-id-0023">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ParallelJoinToRedeem-id-0025_di" bpmnElement="SequenceFlow-ParallelJoinToRedeem-id-0025">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RedeemToEnd-id-0026_di" bpmnElement="SequenceFlow-RedeemToEnd-id-0026">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1407" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BoundaryToEnd-id-0029_di" bpmnElement="SequenceFlow-BoundaryToEnd-id-0029">
        <di:waypoint x="1275" y="128" />
        <di:waypoint x="1275" y="210" />
        <di:waypoint x="1557" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-NotificationToEnd-id-0028_di" bpmnElement="SequenceFlow-NotificationToEnd-id-0028">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="807" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-NotificationReferredToParallelJoin-id-0024_di" bpmnElement="SequenceFlow-NotificationReferredToParallelJoin-id-0024">
        <di:waypoint x="1125" y="170" />
        <di:waypoint x="1125" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
