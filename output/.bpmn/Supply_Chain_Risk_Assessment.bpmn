<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="risk-management-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="RiskManagementProcess-id-0001" name="Risk Identification Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-RiskIdentificationProcessStarts-id-0001" name="Risk Identification Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToGather-id-0008</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-GatherRiskData-id-0002" name="Gather risk data from internal and external sources">
      <bpmn:incoming>SequenceFlow-StartToGather-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatherToCalculate-id-0009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="ScriptTask-CalculateRiskScores-id-0003" name="Calculate risk scores">
      <bpmn:incoming>SequenceFlow-GatherToCalculate-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateToDevelop-id-0010</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="UserTask-DevelopMitigationStrategies-id-0004" name="Develop mitigation strategies for high-risk items">
      <bpmn:incoming>SequenceFlow-CalculateToDevelop-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DevelopToImplement-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ImplementMitigationStrategies-id-0005" name="Implement mitigation strategies">
      <bpmn:incoming>SequenceFlow-DevelopToImplement-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ImplementToMonitoring-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-SetUpMonitoring-id-0006" name="Set up regular monitoring for risk management">
      <bpmn:incoming>SequenceFlow-ImplementToMonitoring-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MonitoringToEnd-id-0013</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-RiskManagementPlanComplete-id-0007" name="Risk Management Plan Complete">
      <bpmn:incoming>SequenceFlow-MonitoringToEnd-id-0013</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToGather-id-0008" sourceRef="StartEvent-RiskIdentificationProcessStarts-id-0001" targetRef="ServiceTask-GatherRiskData-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-GatherToCalculate-id-0009" sourceRef="ServiceTask-GatherRiskData-id-0002" targetRef="ScriptTask-CalculateRiskScores-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateToDevelop-id-0010" sourceRef="ScriptTask-CalculateRiskScores-id-0003" targetRef="UserTask-DevelopMitigationStrategies-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-DevelopToImplement-id-0011" sourceRef="UserTask-DevelopMitigationStrategies-id-0004" targetRef="ServiceTask-ImplementMitigationStrategies-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ImplementToMonitoring-id-0012" sourceRef="ServiceTask-ImplementMitigationStrategies-id-0005" targetRef="ServiceTask-SetUpMonitoring-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-MonitoringToEnd-id-0013" sourceRef="ServiceTask-SetUpMonitoring-id-0006" targetRef="EndEvent-RiskManagementPlanComplete-id-0007" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_RiskManagementProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_RiskManagementProcess-id-0001" bpmnElement="RiskManagementProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-RiskIdentificationProcessStarts-id-0001_di" bpmnElement="StartEvent-RiskIdentificationProcessStarts-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GatherRiskData-id-0002_di" bpmnElement="ServiceTask-GatherRiskData-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScriptTask-CalculateRiskScores-id-0003_di" bpmnElement="ScriptTask-CalculateRiskScores-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DevelopMitigationStrategies-id-0004_di" bpmnElement="UserTask-DevelopMitigationStrategies-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ImplementMitigationStrategies-id-0005_di" bpmnElement="ServiceTask-ImplementMitigationStrategies-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SetUpMonitoring-id-0006_di" bpmnElement="ServiceTask-SetUpMonitoring-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RiskManagementPlanComplete-id-0007_di" bpmnElement="EndEvent-RiskManagementPlanComplete-id-0007">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToGather-id-0008_di" bpmnElement="SequenceFlow-StartToGather-id-0008">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatherToCalculate-id-0009_di" bpmnElement="SequenceFlow-GatherToCalculate-id-0009">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CalculateToDevelop-id-0010_di" bpmnElement="SequenceFlow-CalculateToDevelop-id-0010">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DevelopToImplement-id-0011_di" bpmnElement="SequenceFlow-DevelopToImplement-id-0011">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ImplementToMonitoring-id-0012_di" bpmnElement="SequenceFlow-ImplementToMonitoring-id-0012">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MonitoringToEnd-id-0013_di" bpmnElement="SequenceFlow-MonitoringToEnd-id-0013">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
