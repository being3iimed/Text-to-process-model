<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Tax-Filing-Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Tax-Filing-Process-id-0001" name="Tax Filing Process">
    <bpmn:startEvent id="StartEvent-FiscalYearBegins-id-0001" name="Fiscal year begins">
      <bpmn:outgoing>SequenceFlow-StartToCalendar-id-0018</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-SetUpTaxCalendar-id-0002" name="Set up tax calendar">
      <bpmn:incoming>SequenceFlow-StartToCalendar-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalendarToCategorize-id-0019</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CategorizeTransactions-id-0003" name="Categorize and record financial transactions">
      <bpmn:incoming>SequenceFlow-CalendarToCategorize-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CategorizeToReconcile-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ReconcileAccounts-id-0004" name="Reconcile accounts">
      <bpmn:incoming>SequenceFlow-CategorizeToReconcile-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReconcileToReview-id-0021</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ReviewDeductions-id-0005" name="Review deductions">
      <bpmn:incoming>SequenceFlow-ReconcileToReview-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToPrepare-id-0022</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-PrepareDocuments-id-0006" name="Prepare necessary documents">
      <bpmn:incoming>SequenceFlow-ReviewToPrepare-id-0022</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReminderToPrepare-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareToSubmit-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer1Month-PrepareDocuments-id-0007" name="1 Month Before Deadline" cancelActivity="false" attachedToRef="UserTask-PrepareDocuments-id-0006">
      <bpmn:outgoing>SequenceFlow-BoundaryToReminder-id-0031</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer1Month-PrepareDocuments-id-0007_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-SendReminder-id-0008" name="Send reminder to accountant">
      <bpmn:incoming>SequenceFlow-BoundaryToReminder-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReminderToPrepare-id-0032</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-SubmitReturns-id-0009" name="Submit tax returns electronically">
      <bpmn:incoming>SequenceFlow-PrepareToSubmit-id-0023</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ResubmitToSubmit-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubmitToSave-id-0024</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Error-SubmitReturns-id-0010" name="Submission Failed" attachedToRef="ServiceTask-SubmitReturns-id-0009">
      <bpmn:outgoing>SequenceFlow-BoundaryToResubmit-id-0033</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BoundaryEvent-Error-SubmitReturns-id-0010_EventDef" errorRef="SUBMISSION_ERROR" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask-ResubmitReturns-id-0011" name="Resubmit tax returns">
      <bpmn:incoming>SequenceFlow-BoundaryToResubmit-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ResubmitToSubmit-id-0034</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-SaveReceipts-id-0012" name="Save confirmation receipts">
      <bpmn:incoming>SequenceFlow-SubmitToSave-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SaveToGateway-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AuditOrInquiry-id-0013" name="Audit or inquiry?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SaveToGateway-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToDocumentation-id-0026</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToEnd-id-0027</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ProvideDocumentation-id-0014" name="Provide additional documentation">
      <bpmn:incoming>SequenceFlow-GatewayToDocumentation-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentationToEnd-id-0028</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ComplianceFulfilled-id-0015" name="All compliance obligations fulfilled">
      <bpmn:incoming>SequenceFlow-GatewayToEnd-id-0027</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DocumentationToEnd-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EndToLessons-id-0029</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-IncorporateLessons-id-0016" name="Incorporate lessons learned">
      <bpmn:incoming>SequenceFlow-EndToLessons-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LessonsToComplete-id-0030</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0017" name="Process complete">
      <bpmn:incoming>SequenceFlow-LessonsToComplete-id-0030</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCalendar-id-0018" sourceRef="StartEvent-FiscalYearBegins-id-0001" targetRef="UserTask-SetUpTaxCalendar-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CalendarToCategorize-id-0019" sourceRef="UserTask-SetUpTaxCalendar-id-0002" targetRef="ServiceTask-CategorizeTransactions-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CategorizeToReconcile-id-0020" sourceRef="ServiceTask-CategorizeTransactions-id-0003" targetRef="UserTask-ReconcileAccounts-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-ReconcileToReview-id-0021" sourceRef="UserTask-ReconcileAccounts-id-0004" targetRef="UserTask-ReviewDeductions-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToPrepare-id-0022" sourceRef="UserTask-ReviewDeductions-id-0005" targetRef="UserTask-PrepareDocuments-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareToSubmit-id-0023" sourceRef="UserTask-PrepareDocuments-id-0006" targetRef="ServiceTask-SubmitReturns-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-SubmitToSave-id-0024" sourceRef="ServiceTask-SubmitReturns-id-0009" targetRef="ServiceTask-SaveReceipts-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-SaveToGateway-id-0025" sourceRef="ServiceTask-SaveReceipts-id-0012" targetRef="ExclusiveGateway-AuditOrInquiry-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToDocumentation-id-0026" name="audit_or_inquiry_occurs" sourceRef="ExclusiveGateway-AuditOrInquiry-id-0013" targetRef="UserTask-ProvideDocumentation-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToEnd-id-0027" sourceRef="ExclusiveGateway-AuditOrInquiry-id-0013" targetRef="EndEvent-ComplianceFulfilled-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-DocumentationToEnd-id-0028" sourceRef="UserTask-ProvideDocumentation-id-0014" targetRef="EndEvent-ComplianceFulfilled-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-EndToLessons-id-0029" sourceRef="EndEvent-ComplianceFulfilled-id-0015" targetRef="UserTask-IncorporateLessons-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-LessonsToComplete-id-0030" sourceRef="UserTask-IncorporateLessons-id-0016" targetRef="EndEvent-ProcessComplete-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToReminder-id-0031" sourceRef="BoundaryEvent-Timer1Month-PrepareDocuments-id-0007" targetRef="SendTask-SendReminder-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ReminderToPrepare-id-0032" sourceRef="SendTask-SendReminder-id-0008" targetRef="UserTask-PrepareDocuments-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToResubmit-id-0033" sourceRef="BoundaryEvent-Error-SubmitReturns-id-0010" targetRef="UserTask-ResubmitReturns-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-ResubmitToSubmit-id-0034" sourceRef="UserTask-ResubmitReturns-id-0011" targetRef="ServiceTask-SubmitReturns-id-0009" />
  </bpmn:process>
  <bpmn:error id="SUBMISSION_ERROR" name="SUBMISSION_ERROR" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Tax-Filing-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Tax-Filing-Process-id-0001" bpmnElement="Tax-Filing-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-FiscalYearBegins-id-0001_di" bpmnElement="StartEvent-FiscalYearBegins-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SetUpTaxCalendar-id-0002_di" bpmnElement="UserTask-SetUpTaxCalendar-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CategorizeTransactions-id-0003_di" bpmnElement="ServiceTask-CategorizeTransactions-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReconcileAccounts-id-0004_di" bpmnElement="UserTask-ReconcileAccounts-id-0004">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewDeductions-id-0005_di" bpmnElement="UserTask-ReviewDeductions-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-PrepareDocuments-id-0006_di" bpmnElement="UserTask-PrepareDocuments-id-0006">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-Timer1Month-PrepareDocuments-id-0007_di" bpmnElement="BoundaryEvent-Timer1Month-PrepareDocuments-id-0007">
        <dc:Bounds x="807" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SubmitReturns-id-0009_di" bpmnElement="ServiceTask-SubmitReturns-id-0009">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-Error-SubmitReturns-id-0010_di" bpmnElement="BoundaryEvent-Error-SubmitReturns-id-0010">
        <dc:Bounds x="957" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SaveReceipts-id-0012_di" bpmnElement="ServiceTask-SaveReceipts-id-0012">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-AuditOrInquiry-id-0013_di" bpmnElement="ExclusiveGateway-AuditOrInquiry-id-0013" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ProvideDocumentation-id-0014_di" bpmnElement="UserTask-ProvideDocumentation-id-0014">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ComplianceFulfilled-id-0015_di" bpmnElement="EndEvent-ComplianceFulfilled-id-0015">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-IncorporateLessons-id-0016_di" bpmnElement="UserTask-IncorporateLessons-id-0016">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessComplete-id-0017_di" bpmnElement="EndEvent-ProcessComplete-id-0017">
        <dc:Bounds x="1857" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ResubmitReturns-id-0011_di" bpmnElement="UserTask-ResubmitReturns-id-0011">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendReminder-id-0008_di" bpmnElement="SendTask-SendReminder-id-0008">
        <dc:Bounds x="925" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCalendar-id-0018_di" bpmnElement="SequenceFlow-StartToCalendar-id-0018">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CalendarToCategorize-id-0019_di" bpmnElement="SequenceFlow-CalendarToCategorize-id-0019">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CategorizeToReconcile-id-0020_di" bpmnElement="SequenceFlow-CategorizeToReconcile-id-0020">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReconcileToReview-id-0021_di" bpmnElement="SequenceFlow-ReconcileToReview-id-0021">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToPrepare-id-0022_di" bpmnElement="SequenceFlow-ReviewToPrepare-id-0022">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PrepareToSubmit-id-0023_di" bpmnElement="SequenceFlow-PrepareToSubmit-id-0023">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BoundaryToReminder-id-0031_di" bpmnElement="SequenceFlow-BoundaryToReminder-id-0031">
        <di:waypoint x="825" y="128" />
        <di:waypoint x="825" y="350" />
        <di:waypoint x="925" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SubmitToSave-id-0024_di" bpmnElement="SequenceFlow-SubmitToSave-id-0024">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BoundaryToResubmit-id-0033_di" bpmnElement="SequenceFlow-BoundaryToResubmit-id-0033">
        <di:waypoint x="975" y="128" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SaveToGateway-id-0025_di" bpmnElement="SequenceFlow-SaveToGateway-id-0025">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1250" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToDocumentation-id-0026_di" bpmnElement="SequenceFlow-GatewayToDocumentation-id-0026">
        <di:waypoint x="1300" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToEnd-id-0027_di" bpmnElement="SequenceFlow-GatewayToEnd-id-0027">
        <di:waypoint x="1275" y="95" />
        <di:waypoint x="1275" y="140" />
        <di:waypoint x="1575" y="140" />
        <di:waypoint x="1575" y="88" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DocumentationToEnd-id-0028_di" bpmnElement="SequenceFlow-DocumentationToEnd-id-0028">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1557" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EndToLessons-id-0029_di" bpmnElement="SequenceFlow-EndToLessons-id-0029">
        <di:waypoint x="1593" y="70" />
        <di:waypoint x="1675" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LessonsToComplete-id-0030_di" bpmnElement="SequenceFlow-LessonsToComplete-id-0030">
        <di:waypoint x="1775" y="70" />
        <di:waypoint x="1857" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ResubmitToSubmit-id-0034_di" bpmnElement="SequenceFlow-ResubmitToSubmit-id-0034">
        <di:waypoint x="1125" y="250" />
        <di:waypoint x="1125" y="280" />
        <di:waypoint x="975" y="280" />
        <di:waypoint x="975" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReminderToPrepare-id-0032_di" bpmnElement="SequenceFlow-ReminderToPrepare-id-0032">
