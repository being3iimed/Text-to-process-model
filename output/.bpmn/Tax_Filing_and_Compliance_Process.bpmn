        <di:waypoint x="975" y="420" />
        <di:waypoint x="825" y="420" />
        <di:waypoint x="825" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
