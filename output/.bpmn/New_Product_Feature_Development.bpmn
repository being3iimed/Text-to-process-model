<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="empty-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="FeatureDevelopmentProcess-id-0001">
    <bpmn:startEvent id="StartEvent-ProcessInitiated-id-0001" name="Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToSplit-id-0033</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0001" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StartToSplit-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToGatherFeedback-id-0034</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToMarketResearch-id-0035</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-GatherUserFeedback-id-0002" name="Gather User Feedback">
      <bpmn:incoming>SequenceFlow-SplitToGatherFeedback-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatherToJoin-id-0036</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConductMarketResearch-id-0003" name="Conduct Market Research">
      <bpmn:incoming>SequenceFlow-SplitToMarketResearch-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ResearchToJoin-id-0037</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0004" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-GatherToJoin-id-0036</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ResearchToJoin-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToAnalyze-id-0038</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:scriptTask id="ScriptTask-AnalyzeData-id-0005" name="Analyze Feedback and Research Data">
      <bpmn:incoming>SequenceFlow-JoinToAnalyze-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeToFeasibility-id-0039</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-FeasibilityCheck-id-0006" name="Feasibility Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AnalyzeToFeasibility-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeasibilityToProposal-id-0040</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-FeasibilityToRefine-id-0064</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-CreateFeatureProposal-id-0007" name="Create Feature Proposal">
      <bpmn:incoming>SequenceFlow-FeasibilityToProposal-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProposalToReview-id-0041</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ReviewProposal-id-0008" name="Review Proposal by Product Team">
      <bpmn:incoming>SequenceFlow-ProposalToReview-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToApproval-id-0042</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ProposalApproval-id-0009" name="Proposal Approved?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToApproval-id-0042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalToAllocate-id-0043</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ApprovalToReEvaluate-id-0062</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-AllocateResources-id-0010" name="Allocate Resources for Development">
      <bpmn:incoming>SequenceFlow-ApprovalToAllocate-id-0043</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AllocateToCreate-id-0044</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-CreatePrototype-id-0011" name="Development Team Creates Prototype">
      <bpmn:incoming>SequenceFlow-AllocateToCreate-id-0044</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateToTesting-id-0045</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConductUsabilityTesting-id-0012" name="Conduct Usability Testing">
      <bpmn:incoming>SequenceFlow-CreateToTesting-id-0045</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TestingToReceive-id-0046</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="ReceiveTask-TesterFeedback-id-0013" name="Receive Tester Feedback">
      <bpmn:incoming>SequenceFlow-TestingToReceive-id-0046</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToAnalyzeFeedback-id-0047</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:scriptTask id="ScriptTask-AnalyzeTesterFeedback-id-0014" name="Analyze Tester Feedback">
      <bpmn:incoming>SequenceFlow-ReceiveToAnalyzeFeedback-id-0047</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeFeedbackToGateway-id-0048</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-FeedbackAnalysis-id-0015" name="Feedback Positive?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AnalyzeFeedbackToGateway-id-0048</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeedbackToIntegrate-id-0049</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-FeedbackToIterate-id-0060</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-IntegrateFeature-id-0016" name="Integrate Feature into Product">
      <bpmn:incoming>SequenceFlow-FeedbackToIntegrate-id-0049</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IntegrateToSend-id-0050</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-FeatureLaunchNotification-id-0017" name="Send Feature Launch Notification">
      <bpmn:incoming>SequenceFlow-IntegrateToSend-id-0050</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToTimer-id-0051</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="StartEvent-30DaysAfterLaunch-id-0018" name="30 Days After Launch">
      <bpmn:incoming>SequenceFlow-SendToTimer-id-0051</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TimerToCollectMetrics-id-0052</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-CollectUsageMetrics-id-0019" name="Collect Usage Metrics">
      <bpmn:incoming>SequenceFlow-TimerToCollectMetrics-id-0052</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CollectToAnalyzeMetrics-id-0053</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="ScriptTask-AnalyzeUsageMetrics-id-0020" name="Analyze Usage Metrics">
      <bpmn:incoming>SequenceFlow-CollectToAnalyzeMetrics-id-0053</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeMetricsToGateway-id-0054</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-MetricsAnalysis-id-0021" name="Metrics Successful?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AnalyzeMetricsToGateway-id-0054</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MetricsToUpdate-id-0055</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-MetricsToIdentify-id-0058</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-UpdateDocumentation-id-0022" name="Update Product Documentation">
      <bpmn:incoming>SequenceFlow-MetricsToUpdate-id-0055</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToPlan-id-0056</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-PlanFutureEnhancements-id-0023" name="Plan Future Enhancements">
      <bpmn:incoming>SequenceFlow-UpdateToPlan-id-0056</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PlanToEnd-id-0057</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0024" name="Process Complete">
      <bpmn:incoming>SequenceFlow-PlanToEnd-id-0057</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-IdentifyImprovementAreas-id-0025" name="Identify Improvement Areas">
      <bpmn:incoming>SequenceFlow-MetricsToIdentify-id-0058</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdentifyToEnd-id-0059</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessCompleteWithImprovements-id-0026" name="Process Complete with Improvements">
      <bpmn:incoming>SequenceFlow-IdentifyToEnd-id-0059</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-IteratePrototype-id-0027" name="Iterate on Prototype">
      <bpmn:incoming>SequenceFlow-FeedbackToIterate-id-0060</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IterateToEnd-id-0061</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessContinuesWithIteration-id-0028" name="Process Continues with Iteration">
      <bpmn:incoming>SequenceFlow-IterateToEnd-id-0061</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-ReEvaluateProposal-id-0029" name="Re-evaluate Proposal">
      <bpmn:incoming>SequenceFlow-ApprovalToReEvaluate-id-0062</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReEvaluateToEnd-id-0063</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessContinuesWithReEvaluation-id-0030" name="Process Continues with Re-evaluation">
      <bpmn:incoming>SequenceFlow-ReEvaluateToEnd-id-0063</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-RefineFeatureIdeas-id-0031" name="Refine Feature Ideas">
      <bpmn:incoming>SequenceFlow-FeasibilityToRefine-id-0064</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RefineToEnd-id-0065</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessContinuesWithRefinement-id-0032" name="Process Continues with Refinement">
      <bpmn:incoming>SequenceFlow-RefineToEnd-id-0065</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0033" sourceRef="StartEvent-ProcessInitiated-id-0001" targetRef="ParallelGateway-Split-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToGatherFeedback-id-0034" sourceRef="ParallelGateway-Split-id-0001" targetRef="UserTask-GatherUserFeedback-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToMarketResearch-id-0035" sourceRef="ParallelGateway-Split-id-0001" targetRef="UserTask-ConductMarketResearch-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-GatherToJoin-id-0036" sourceRef="UserTask-GatherUserFeedback-id-0002" targetRef="ParallelGateway-Join-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-ResearchToJoin-id-0037" sourceRef="UserTask-ConductMarketResearch-id-0003" targetRef="ParallelGateway-Join-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToAnalyze-id-0038" sourceRef="ParallelGateway-Join-id-0004" targetRef="ScriptTask-AnalyzeData-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToFeasibility-id-0039" sourceRef="ScriptTask-AnalyzeData-id-0005" targetRef="ExclusiveGateway-FeasibilityCheck-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-FeasibilityToProposal-id-0040" name="feasibility AND cost_effective AND high_impact" sourceRef="ExclusiveGateway-FeasibilityCheck-id-0006" targetRef="ServiceTask-CreateFeatureProposal-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-ProposalToReview-id-0041" sourceRef="ServiceTask-CreateFeatureProposal-id-0007" targetRef="UserTask-ReviewProposal-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToApproval-id-0042" sourceRef="UserTask-ReviewProposal-id-0008" targetRef="ExclusiveGateway-ProposalApproval-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalToAllocate-id-0043" name="approved" sourceRef="ExclusiveGateway-ProposalApproval-id-0009" targetRef="ServiceTask-AllocateResources-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-AllocateToCreate-id-0044" sourceRef="ServiceTask-AllocateResources-id-0010" targetRef="UserTask-CreatePrototype-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateToTesting-id-0045" sourceRef="UserTask-CreatePrototype-id-0011" targetRef="UserTask-ConductUsabilityTesting-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-TestingToReceive-id-0046" sourceRef="UserTask-ConductUsabilityTesting-id-0012" targetRef="ReceiveTask-TesterFeedback-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveToAnalyzeFeedback-id-0047" sourceRef="ReceiveTask-TesterFeedback-id-0013" targetRef="ScriptTask-AnalyzeTesterFeedback-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeFeedbackToGateway-id-0048" sourceRef="ScriptTask-AnalyzeTesterFeedback-id-0014" targetRef="ExclusiveGateway-FeedbackAnalysis-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-FeedbackToIntegrate-id-0049" name="feedback_positive" sourceRef="ExclusiveGateway-FeedbackAnalysis-id-0015" targetRef="ServiceTask-IntegrateFeature-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-IntegrateToSend-id-0050" sourceRef="ServiceTask-IntegrateFeature-id-0016" targetRef="SendTask-FeatureLaunchNotification-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToTimer-id-0051" sourceRef="SendTask-FeatureLaunchNotification-id-0017" targetRef="StartEvent-30DaysAfterLaunch-id-0018" />
    <bpmn:sequenceFlow id="SequenceFlow-TimerToCollectMetrics-id-0052" sourceRef="StartEvent-30DaysAfterLaunch-id-0018" targetRef="ServiceTask-CollectUsageMetrics-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-CollectToAnalyzeMetrics-id-0053" sourceRef="ServiceTask-CollectUsageMetrics-id-0019" targetRef="ScriptTask-AnalyzeUsageMetrics-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeMetricsToGateway-id-0054" sourceRef="ScriptTask-AnalyzeUsageMetrics-id-0020" targetRef="ExclusiveGateway-MetricsAnalysis-id-0021" />
    <bpmn:sequenceFlow id="SequenceFlow-MetricsToUpdate-id-0055" name="successful" sourceRef="ExclusiveGateway-MetricsAnalysis-id-0021" targetRef="ServiceTask-UpdateDocumentation-id-0022" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToPlan-id-0056" sourceRef="ServiceTask-UpdateDocumentation-id-0022" targetRef="UserTask-PlanFutureEnhancements-id-0023" />
    <bpmn:sequenceFlow id="SequenceFlow-PlanToEnd-id-0057" sourceRef="UserTask-PlanFutureEnhancements-id-0023" targetRef="EndEvent-ProcessComplete-id-0024" />
    <bpmn:sequenceFlow id="SequenceFlow-MetricsToIdentify-id-0058" name="not successful" sourceRef="ExclusiveGateway-MetricsAnalysis-id-0021" targetRef="UserTask-IdentifyImprovementAreas-id-0025" />
    <bpmn:sequenceFlow id="SequenceFlow-IdentifyToEnd-id-0059" sourceRef="UserTask-IdentifyImprovementAreas-id-0025" targetRef="EndEvent-ProcessCompleteWithImprovements-id-0026" />
    <bpmn:sequenceFlow id="SequenceFlow-FeedbackToIterate-id-0060" name="not feedback_positive" sourceRef="ExclusiveGateway-FeedbackAnalysis-id-0015" targetRef="UserTask-IteratePrototype-id-0027" />
    <bpmn:sequenceFlow id="SequenceFlow-IterateToEnd-id-0061" sourceRef="UserTask-IteratePrototype-id-0027" targetRef="EndEvent-ProcessContinuesWithIteration-id-0028" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalToReEvaluate-id-0062" name="not approved" sourceRef="ExclusiveGateway-ProposalApproval-id-0009" targetRef="UserTask-ReEvaluateProposal-id-0029" />
    <bpmn:sequenceFlow id="SequenceFlow-ReEvaluateToEnd-id-0063" sourceRef="UserTask-ReEvaluateProposal-id-0029" targetRef="EndEvent-ProcessContinuesWithReEvaluation-id-0030" />
    <bpmn:sequenceFlow id="SequenceFlow-FeasibilityToRefine-id-0064" name="not (feasibility AND cost_effective AND high_impact)" sourceRef="ExclusiveGateway-FeasibilityCheck-id-0006" targetRef="UserTask-RefineFeatureIdeas-id-0031" />
    <bpmn:sequenceFlow id="SequenceFlow-RefineToEnd-id-0065" sourceRef="UserTask-RefineFeatureIdeas-id-0031" targetRef="EndEvent-ProcessContinuesWithRefinement-id-0032" />
  </bpmn:process>
