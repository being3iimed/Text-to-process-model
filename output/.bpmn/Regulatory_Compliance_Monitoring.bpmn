<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Compliance-Process-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Compliance-Process-id-0001" name="Compliance Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ProcessInitiated-id-0001" name="Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToMonitor-id-0014</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-MonitorLawChanges-id-0002" name="Monitor Law Changes">
      <bpmn:incoming>SequenceFlow-StartToMonitor-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MonitorToUpdate-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-UpdatePolicies-id-0003" name="Update Policies">
      <bpmn:incoming>SequenceFlow-MonitorToUpdate-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToSplit-id-0016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0004" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-UpdateToSplit-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToTraining-id-0017</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToAudits-id-0018</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-ConductTrainingSessions-id-0005" name="Conduct Training Sessions">
      <bpmn:incoming>SequenceFlow-SplitToTraining-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainingToJoin-id-0019</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-PerformAudits-id-0006" name="Perform Audits">
      <bpmn:incoming>SequenceFlow-SplitToAudits-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AuditsToJoin-id-0020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0007" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-TrainingToJoin-id-0019</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AuditsToJoin-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToXOR-id-0021</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ComplianceVerified-id-0008" name="Compliance Verified?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-JoinToXOR-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-XORToCertification-id-0022</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-XORToCorrectiveActions-id-0024</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-IssueComplianceCertification-id-0009" name="Issue Compliance Certification">
      <bpmn:incoming>SequenceFlow-XORToCertification-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CertificationToEnd-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ComplianceCertificationIssued-id-0010" name="Compliance Certification Issued">
      <bpmn:incoming>SequenceFlow-CertificationToEnd-id-0023</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-TakeCorrectiveActions-id-0011" name="Take Corrective Actions">
      <bpmn:incoming>SequenceFlow-XORToCorrectiveActions-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CorrectiveActionsToRemediation-id-0025</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DevelopRemediationPlans-id-0012" name="Develop Remediation Plans">
      <bpmn:incoming>SequenceFlow-CorrectiveActionsToRemediation-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RemediationToEnd-id-0026</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-RemediationPlansDeveloped-id-0013" name="Remediation Plans Developed">
      <bpmn:incoming>SequenceFlow-RemediationToEnd-id-0026</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToMonitor-id-0014" sourceRef="StartEvent-ProcessInitiated-id-0001" targetRef="UserTask-MonitorLawChanges-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-MonitorToUpdate-id-0015" sourceRef="UserTask-MonitorLawChanges-id-0002" targetRef="UserTask-UpdatePolicies-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToSplit-id-0016" sourceRef="UserTask-UpdatePolicies-id-0003" targetRef="ParallelGateway-Split-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToTraining-id-0017" sourceRef="ParallelGateway-Split-id-0004" targetRef="UserTask-ConductTrainingSessions-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToAudits-id-0018" sourceRef="ParallelGateway-Split-id-0004" targetRef="UserTask-PerformAudits-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-TrainingToJoin-id-0019" sourceRef="UserTask-ConductTrainingSessions-id-0005" targetRef="ParallelGateway-Join-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-AuditsToJoin-id-0020" sourceRef="UserTask-PerformAudits-id-0006" targetRef="ParallelGateway-Join-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToXOR-id-0021" sourceRef="ParallelGateway-Join-id-0007" targetRef="ExclusiveGateway-ComplianceVerified-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-XORToCertification-id-0022" name="compliance_verified" sourceRef="ExclusiveGateway-ComplianceVerified-id-0008" targetRef="UserTask-IssueComplianceCertification-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-CertificationToEnd-id-0023" sourceRef="UserTask-IssueComplianceCertification-id-0009" targetRef="EndEvent-ComplianceCertificationIssued-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-XORToCorrectiveActions-id-0024" sourceRef="ExclusiveGateway-ComplianceVerified-id-0008" targetRef="UserTask-TakeCorrectiveActions-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-CorrectiveActionsToRemediation-id-0025" sourceRef="UserTask-TakeCorrectiveActions-id-0011" targetRef="UserTask-DevelopRemediationPlans-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-RemediationToEnd-id-0026" sourceRef="UserTask-DevelopRemediationPlans-id-0012" targetRef="EndEvent-RemediationPlansDeveloped-id-0013" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Compliance-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Compliance-Process-id-0001" bpmnElement="Compliance-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProcessInitiated-id-0001_di" bpmnElement="StartEvent-ProcessInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-MonitorLawChanges-id-0002_di" bpmnElement="UserTask-MonitorLawChanges-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-UpdatePolicies-id-0003_di" bpmnElement="UserTask-UpdatePolicies-id-0003">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Split-id-0004_di" bpmnElement="ParallelGateway-Split-id-0004">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ConductTrainingSessions-id-0005_di" bpmnElement="UserTask-ConductTrainingSessions-id-0005">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Join-id-0007_di" bpmnElement="ParallelGateway-Join-id-0007">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ComplianceVerified-id-0008_di" bpmnElement="ExclusiveGateway-ComplianceVerified-id-0008" isMarkerVisible="true">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-IssueComplianceCertification-id-0009_di" bpmnElement="UserTask-IssueComplianceCertification-id-0009">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ComplianceCertificationIssued-id-0010_di" bpmnElement="EndEvent-ComplianceCertificationIssued-id-0010">
        <dc:Bounds x="1257" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-PerformAudits-id-0006_di" bpmnElement="UserTask-PerformAudits-id-0006">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-TakeCorrectiveActions-id-0011_di" bpmnElement="UserTask-TakeCorrectiveActions-id-0011">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DevelopRemediationPlans-id-0012_di" bpmnElement="UserTask-DevelopRemediationPlans-id-0012">
        <dc:Bounds x="1225" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RemediationPlansDeveloped-id-0013_di" bpmnElement="EndEvent-RemediationPlansDeveloped-id-0013">
        <dc:Bounds x="1407" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToMonitor-id-0014_di" bpmnElement="SequenceFlow-StartToMonitor-id-0014">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MonitorToUpdate-id-0015_di" bpmnElement="SequenceFlow-MonitorToUpdate-id-0015">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-UpdateToSplit-id-0016_di" bpmnElement="SequenceFlow-UpdateToSplit-id-0016">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToTraining-id-0017_di" bpmnElement="SequenceFlow-SplitToTraining-id-0017">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToAudits-id-0018_di" bpmnElement="SequenceFlow-SplitToAudits-id-0018">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TrainingToJoin-id-0019_di" bpmnElement="SequenceFlow-TrainingToJoin-id-0019">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-JoinToXOR-id-0021_di" bpmnElement="SequenceFlow-JoinToXOR-id-0021">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="950" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-XORToCertification-id-0022_di" bpmnElement="SequenceFlow-XORToCertification-id-0022">
        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-XORToCorrectiveActions-id-0024_di" bpmnElement="SequenceFlow-XORToCorrectiveActions-id-0024">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CertificationToEnd-id-0023_di" bpmnElement="SequenceFlow-CertificationToEnd-id-0023">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1257" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AuditsToJoin-id-0020_di" bpmnElement="SequenceFlow-AuditsToJoin-id-0020">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="825" y="210" />
        <di:waypoint x="825" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CorrectiveActionsToRemediation-id-0025_di" bpmnElement="SequenceFlow-CorrectiveActionsToRemediation-id-0025">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1225" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RemediationToEnd-id-0026_di" bpmnElement="SequenceFlow-RemediationToEnd-id-0026">
        <di:waypoint x="1325" y="210" />
        <di:waypoint x="1407" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
