    <bpmn:sequenceFlow id="SequenceFlow-ReviewAppraiserToGateway-id-0034" sourceRef="UserTask-ReviewAppraiserReport-id-0010" targetRef="ExclusiveGateway-RepairCostCheck-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToIssueApproval-id-0035" name="repair_cost &#60;= policy_limit" sourceRef="ExclusiveGateway-RepairCostCheck-id-0011" targetRef="UserTask-IssueApproval-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToNotifyExcessCost-id-0036" name="repair_cost &#62; policy_limit" sourceRef="ExclusiveGateway-RepairCostCheck-id-0011" targetRef="UserTask-NotifyInsuredOfExcessCost-id-0023" />
    <bpmn:sequenceFlow id="SequenceFlow-IssueApprovalToNotifyInsured-id-0037" sourceRef="UserTask-IssueApproval-id-0012" targetRef="UserTask-NotifyInsured-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyInsuredToSelectShop-id-0038" sourceRef="UserTask-NotifyInsured-id-0013" targetRef="UserTask-SelectRepairShop-id-0014" />
