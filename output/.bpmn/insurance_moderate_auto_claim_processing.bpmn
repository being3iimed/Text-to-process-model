    <bpmn:sequenceFlow id="SequenceFlow-ReviewToValidate-id-0029" sourceRef="UserTask-ReviewDocumentation-id-0005" targetRef="UserTask-ValidateCoverage-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidateToForward-id-0030" sourceRef="UserTask-ValidateCoverage-id-0006" targetRef="UserTask-ForwardToAppraiser-id-0007" />
