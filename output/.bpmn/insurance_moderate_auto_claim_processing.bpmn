  <bpmn:process id="CarInsuranceClaimProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ClaimReceived-id-0001" name="Claim Received">
      <bpmn:outgoing>SequenceFlow-StartToAssign-id-0025</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-AssignClaimAgent-id-0002" name="Assign Claim Agent">
      <bpmn:incoming>SequenceFlow-StartToAssign-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignToContact-id-0026</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ContactClaimant-id-0003" name="Contact Claimant">
      <bpmn:incoming>SequenceFlow-AssignToContact-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ContactToRequest-id-0027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-RequestDocumentation-id-0004" name="Request Documentation">
      <bpmn:incoming>SequenceFlow-ContactToRequest-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RequestToReview-id-0028</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ReviewDocumentation-id-0005" name="Review Documentation">
      <bpmn:incoming>SequenceFlow-RequestToReview-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToValidate-id-0029</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ValidateCoverage-id-0006" name="Validate Coverage">
      <bpmn:incoming>SequenceFlow-ReviewToValidate-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidateToForward-id-0030</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ForwardToAppraiser-id-0007" name="Forward to Appraiser">
      <bpmn:incoming>SequenceFlow-ValidateToForward-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ForwardToInspect-id-0031</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-InspectVehicle-id-0008" name="Inspect Vehicle">
      <bpmn:incoming>SequenceFlow-ForwardToInspect-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InspectToEstimate-id-0032</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-EstimateRepairCosts-id-0009" name="Estimate Repair Costs">
      <bpmn:incoming>SequenceFlow-InspectToEstimate-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EstimateToReviewAppraiser-id-0033</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ReviewAppraiserReport-id-0010" name="Review Appraiser Report">
      <bpmn:incoming>SequenceFlow-EstimateToReviewAppraiser-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewAppraiserToGateway-id-0034</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RepairCostCheck-id-0011" name="Repair Cost Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewAppraiserToGateway-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToIssueApproval-id-0035</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToNotifyExcessCost-id-0036</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-IssueApproval-id-0012" name="Issue Approval">
      <bpmn:incoming>SequenceFlow-GatewayToIssueApproval-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IssueApprovalToNotifyInsured-id-0037</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-NotifyInsured-id-0013" name="Notify Insured">
      <bpmn:incoming>SequenceFlow-IssueApprovalToNotifyInsured-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyInsuredToSelectShop-id-0038</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectRepairShop-id-0014" name="Select Repair Shop">
      <bpmn:incoming>SequenceFlow-NotifyInsuredToSelectShop-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectShopToSendAuthorization-id-0039</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SendAuthorization-id-0015" name="Send Authorization">
      <bpmn:incoming>SequenceFlow-SelectShopToSendAuthorization-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendAuthorizationToCompleteRepairs-id-0040</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CompleteRepairs-id-0016" name="Complete Repairs">
      <bpmn:incoming>SequenceFlow-SendAuthorizationToCompleteRepairs-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CompleteRepairsToInvoiceInsurer-id-0041</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-InvoiceInsurer-id-0017" name="Invoice Insurer">
      <bpmn:incoming>SequenceFlow-CompleteRepairsToInvoiceInsurer-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InvoiceInsurerToVerifyInvoice-id-0042</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-VerifyInvoice-id-0018" name="Verify Invoice">
      <bpmn:incoming>SequenceFlow-InvoiceInsurerToVerifyInvoice-id-0042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyInvoiceToGateway-id-0043</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InvoiceVariationCheck-id-0019" name="Invoice Variation Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-VerifyInvoiceToGateway-id-0043</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToPayInvoice-id-0044</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToNotifyDiscrepancy-id-0045</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-PayInvoice-id-0020" name="Pay Invoice">
      <bpmn:incoming>SequenceFlow-GatewayToPayInvoice-id-0044</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PayInvoiceToNotifyCompletion-id-0046</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-NotifyInsuredOfInvoiceDiscrepancy-id-0021" name="Notify Insured of Invoice Discrepancy">
      <bpmn:incoming>SequenceFlow-GatewayToNotifyDiscrepancy-id-0045</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyDiscrepancyToNotifyCompletion-id-0047</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-NotifyCompletion-id-0022" name="Notify Completion">
      <bpmn:incoming>SequenceFlow-PayInvoiceToNotifyCompletion-id-0046</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NotifyDiscrepancyToNotifyCompletion-id-0047</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyCompletionToEnd-id-0048</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-NotifyInsuredOfExcessCost-id-0023" name="Notify Insured of Excess Cost">
      <bpmn:incoming>SequenceFlow-GatewayToNotifyExcessCost-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyExcessCostToEnd-id-0049</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ClaimProcessed-id-0024" name="Claim Processed">
      <bpmn:incoming>SequenceFlow-NotifyCompletionToEnd-id-0048</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NotifyExcessCostToEnd-id-0049</bpmn:incoming>
    </bpmn:endEvent>
