    <bpmn:sequenceFlow id="SequenceFlow-VerifyInvoiceToGateway-id-0043" sourceRef="UserTask-VerifyInvoice-id-0018" targetRef="ExclusiveGateway-InvoiceVariationCheck-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToPayInvoice-id-0044" name="invoice_variation_reasonable" sourceRef="ExclusiveGateway-InvoiceVariationCheck-id-0019" targetRef="UserTask-PayInvoice-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToNotifyDiscrepancy-id-0045" name="invoice_variation_not_reasonable" sourceRef="ExclusiveGateway-InvoiceVariationCheck-id-0019" targetRef="UserTask-NotifyInsuredOfInvoiceDiscrepancy-id-0021" />
    <bpmn:sequenceFlow id="SequenceFlow-PayInvoiceToNotifyCompletion-id-0046" sourceRef="UserTask-PayInvoice-id-0020" targetRef="UserTask-NotifyCompletion-id-0022" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyDiscrepancyToNotifyCompletion-id-0047" sourceRef="UserTask-NotifyInsuredOfInvoiceDiscrepancy-id-0021" targetRef="UserTask-NotifyCompletion-id-0022" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyCompletionToEnd-id-0048" sourceRef="UserTask-NotifyCompletion-id-0022" targetRef="EndEvent-ClaimProcessed-id-0024" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyExcessCostToEnd-id-0049" sourceRef="UserTask-NotifyInsuredOfExcessCost-id-0023" targetRef="EndEvent-ClaimProcessed-id-0024" />
