<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Graduation-Process-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Graduation-Process-id-0001" name="Graduation Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-GraduationCheckRequested-id-0001" name="Graduation Check Requested">
      <bpmn:outgoing>SequenceFlow-StartToSubmitRequest-id-0023</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-StudentSubmitsGraduationRequest-id-0002" name="Student submits graduation request">
      <bpmn:incoming>SequenceFlow-StartToSubmitRequest-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubmitToAudit-id-0024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-SystemAuditsDegreeRequirements-id-0003" name="System audits degree requirements">
      <bpmn:incoming>SequenceFlow-SubmitToAudit-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AuditToGateway-id-0025</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RequirementsMet-id-0004" name="Requirements Met?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AuditToGateway-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RequirementsMetToChecks-id-0026</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-RequirementsNotMetToReport-id-0027</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-SystemChecksDisciplinaryHolds-id-0005" name="System checks disciplinary holds, library fees, and visa status">
      <bpmn:incoming>SequenceFlow-RequirementsMetToChecks-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ChecksToAdditionalGateway-id-0028</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AdditionalRequirementsMet-id-0006" name="Additional Requirements Met?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ChecksToAdditionalGateway-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdditionalRequirementsMetToVerification-id-0029</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AdditionalRequirementsNotMetToReport-id-0030</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-SystemVerifiesMajorCourses-id-0007" name="System verifies completion of all major courses">
      <bpmn:incoming>SequenceFlow-AdditionalRequirementsMetToVerification-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyMajorToVerifyGeneral-id-0031</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-SystemVerifiesGeneralEducation-id-0008" name="System verifies completion of all general education requirements">
      <bpmn:incoming>SequenceFlow-VerifyMajorToVerifyGeneral-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyGeneralToFinalGateway-id-0032</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AllRequirementsMet-id-0009" name="All Requirements Met?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-VerifyGeneralToFinalGateway-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AllRequirementsMetToApproval-id-0033</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AllRequirementsNotMetToReport-id-0034</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-GraduationApproved-id-0010" name="Graduation approved">
      <bpmn:incoming>SequenceFlow-AllRequirementsMetToApproval-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalToDiploma-id-0035</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DiplomaPrepared-id-0011" name="Diploma prepared">
      <bpmn:incoming>SequenceFlow-ApprovalToDiploma-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DiplomaToCapAndGown-id-0036</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CapAndGownOrderPlaced-id-0012" name="Cap-and-gown order placed">
      <bpmn:incoming>SequenceFlow-DiplomaToCapAndGown-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CapAndGownToCeremonySlot-id-0037</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GraduationCeremonySlotAssigned-id-0013" name="Graduation ceremony slot assigned">
      <bpmn:incoming>SequenceFlow-CapAndGownToCeremonySlot-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CeremonySlotToAttendCeremony-id-0038</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-StudentAttendsGraduationCeremony-id-0014" name="Student attends graduation ceremony">
      <bpmn:incoming>SequenceFlow-CeremonySlotToAttendCeremony-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AttendCeremonyToVerifyAttendance-id-0039</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-AttendanceVerified-id-0015" name="Attendance verified">
      <bpmn:incoming>SequenceFlow-AttendCeremonyToVerifyAttendance-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyAttendanceToConferDegree-id-0040</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DegreeConferred-id-0016" name="Degree conferred">
      <bpmn:incoming>SequenceFlow-VerifyAttendanceToConferDegree-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConferDegreeToIssueTranscript-id-0041</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TranscriptIssued-id-0017" name="Transcript issued">
      <bpmn:incoming>SequenceFlow-ConferDegreeToIssueTranscript-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IssueTranscriptToComplete-id-0042</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-GraduationComplete-id-0018" name="Graduation Complete">
      <bpmn:incoming>SequenceFlow-IssueTranscriptToComplete-id-0042</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-GenerateDetailedReport-id-0019" name="Generate detailed report of missing requirements">
      <bpmn:incoming>SequenceFlow-RequirementsNotMetToReport-id-0027</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AdditionalRequirementsNotMetToReport-id-0030</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AllRequirementsNotMetToReport-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReportToCompleteRequirements-id-0043</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-StudentCompletesMissingRequirements-id-0020" name="Student completes missing requirements by deadline">
      <bpmn:incoming>SequenceFlow-ReportToCompleteRequirements-id-0043</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CompleteRequirementsToReEvaluate-id-0044</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ReEvaluateGraduationRequirements-id-0021" name="Re-evaluate graduation requirements">
      <bpmn:incoming>SequenceFlow-CompleteRequirementsToReEvaluate-id-0044</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReEvaluateToNotMet-id-0045</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-GraduationRequirementsNotMet-id-0022" name="Graduation Requirements Not Met">
      <bpmn:incoming>SequenceFlow-ReEvaluateToNotMet-id-0045</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSubmitRequest-id-0023" sourceRef="StartEvent-GraduationCheckRequested-id-0001" targetRef="UserTask-StudentSubmitsGraduationRequest-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SubmitToAudit-id-0024" sourceRef="UserTask-StudentSubmitsGraduationRequest-id-0002" targetRef="ServiceTask-SystemAuditsDegreeRequirements-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-AuditToGateway-id-0025" sourceRef="ServiceTask-SystemAuditsDegreeRequirements-id-0003" targetRef="ExclusiveGateway-RequirementsMet-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-RequirementsMetToChecks-id-0026" name="all_courses_completed AND all_credits_earned &#62;= 120 AND cumulative_GPA &#62;= 2.0 AND major_GPA &#62;= minimum_major_GPA" sourceRef="ExclusiveGateway-RequirementsMet-id-0004" targetRef="ServiceTask-SystemChecksDisciplinaryHolds-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-RequirementsNotMetToReport-id-0027" sourceRef="ExclusiveGateway-RequirementsMet-id-0004" targetRef="ServiceTask-GenerateDetailedReport-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-ChecksToAdditionalGateway-id-0028" sourceRef="ServiceTask-SystemChecksDisciplinaryHolds-id-0005" targetRef="ExclusiveGateway-AdditionalRequirementsMet-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-AdditionalRequirementsMetToVerification-id-0029" name="no_disciplinary_holds AND library_fees_paid AND visa_status_current" sourceRef="ExclusiveGateway-AdditionalRequirementsMet-id-0006" targetRef="ServiceTask-SystemVerifiesMajorCourses-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-AdditionalRequirementsNotMetToReport-id-0030" sourceRef="ExclusiveGateway-AdditionalRequirementsMet-id-0006" targetRef="ServiceTask-GenerateDetailedReport-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyMajorToVerifyGeneral-id-0031" sourceRef="ServiceTask-SystemVerifiesMajorCourses-id-0007" targetRef="ServiceTask-SystemVerifiesGeneralEducation-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyGeneralToFinalGateway-id-0032" sourceRef="ServiceTask-SystemVerifiesGeneralEducation-id-0008" targetRef="ExclusiveGateway-AllRequirementsMet-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-AllRequirementsMetToApproval-id-0033" name="all_major_courses_completed AND all_general_education_requirements_completed" sourceRef="ExclusiveGateway-AllRequirementsMet-id-0009" targetRef="ServiceTask-GraduationApproved-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-AllRequirementsNotMetToReport-id-0034" sourceRef="ExclusiveGateway-AllRequirementsMet-id-0009" targetRef="ServiceTask-GenerateDetailedReport-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalToDiploma-id-0035" sourceRef="ServiceTask-GraduationApproved-id-0010" targetRef="ServiceTask-DiplomaPrepared-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-DiplomaToCapAndGown-id-0036" sourceRef="ServiceTask-DiplomaPrepared-id-0011" targetRef="ServiceTask-CapAndGownOrderPlaced-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-CapAndGownToCeremonySlot-id-0037" sourceRef="ServiceTask-CapAndGownOrderPlaced-id-0012" targetRef="ServiceTask-GraduationCeremonySlotAssigned-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-CeremonySlotToAttendCeremony-id-0038" sourceRef="ServiceTask-GraduationCeremonySlotAssigned-id-0013" targetRef="UserTask-StudentAttendsGraduationCeremony-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-AttendCeremonyToVerifyAttendance-id-0039" sourceRef="UserTask-StudentAttendsGraduationCeremony-id-0014" targetRef="ServiceTask-AttendanceVerified-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyAttendanceToConferDegree-id-0040" sourceRef="ServiceTask-AttendanceVerified-id-0015" targetRef="ServiceTask-DegreeConferred-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-ConferDegreeToIssueTranscript-id-0041" sourceRef="ServiceTask-DegreeConferred-id-0016" targetRef="ServiceTask-TranscriptIssued-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-IssueTranscriptToComplete-id-0042" sourceRef="ServiceTask-TranscriptIssued-id-0017" targetRef="EndEvent-GraduationComplete-id-0018" />
    <bpmn:sequenceFlow id="SequenceFlow-ReportToCompleteRequirements-id-0043" sourceRef="ServiceTask-GenerateDetailedReport-id-0019" targetRef="UserTask-StudentCompletesMissingRequirements-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-CompleteRequirementsToReEvaluate-id-0044" sourceRef="UserTask-StudentCompletesMissingRequirements-id-0020" targetRef="ServiceTask-ReEvaluateGraduationRequirements-id-0021" />
    <bpmn:sequenceFlow id="SequenceFlow-ReEvaluateToNotMet-id-0045" sourceRef="ServiceTask-ReEvaluateGraduationRequirements-id-0021" targetRef="EndEvent-GraduationRequirementsNotMet-id-0022" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Graduation-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Graduation-Process-id-0001" bpmnElement="Graduation-Process-id-0001">
