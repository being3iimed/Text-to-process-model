      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-StudentAttendsGraduationCeremony-id-0014_di" bpmnElement="UserTask-StudentAttendsGraduationCeremony-id-0014">
        <dc:Bounds x="1975" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AttendanceVerified-id-0015_di" bpmnElement="ServiceTask-AttendanceVerified-id-0015">
        <dc:Bounds x="2125" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DegreeConferred-id-0016_di" bpmnElement="ServiceTask-DegreeConferred-id-0016">
        <dc:Bounds x="2275" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TranscriptIssued-id-0017_di" bpmnElement="ServiceTask-TranscriptIssued-id-0017">
        <dc:Bounds x="2425" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-GraduationComplete-id-0018_di" bpmnElement="EndEvent-GraduationComplete-id-0018">
