      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateDetailedReport-id-0019_di" bpmnElement="ServiceTask-GenerateDetailedReport-id-0019">
        <dc:Bounds x="1375" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-StudentCompletesMissingRequirements-id-0020_di" bpmnElement="UserTask-StudentCompletesMissingRequirements-id-0020">
        <dc:Bounds x="1525" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ReEvaluateGraduationRequirements-id-0021_di" bpmnElement="ServiceTask-ReEvaluateGraduationRequirements-id-0021">
        <dc:Bounds x="1675" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-GraduationRequirementsNotMet-id-0022_di" bpmnElement="EndEvent-GraduationRequirementsNotMet-id-0022">
        <dc:Bounds x="1857" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
