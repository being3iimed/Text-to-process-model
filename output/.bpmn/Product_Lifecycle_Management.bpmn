<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ProductLifecycleProcess-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="ProductLifecycleProcess-id-0001" name="Product Lifecycle Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ProductLifecycleProcessStarts-id-0001" name="Product Lifecycle Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToDevelopment-id-0018</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess-ProductDevelopment-id-0001" name="Product Development">
      <bpmn:incoming>SequenceFlow-StartToDevelopment-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DevelopmentToApproval-id-0019</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-DevelopmentPhaseBegins-id-0001" name="Development Phase Begins">
        <bpmn:outgoing>SequenceFlow-StartToMarketResearch-id-0009</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-MarketResearchAndConceptualization-id-0002" name="Market Research and Conceptualization">
        <bpmn:incoming>SequenceFlow-StartToMarketResearch-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MarketResearchToAnalyze-id-0010</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="ServiceTask-AnalyzeMarketDemandAndTrends-id-0003" name="Analyze market demand and trends">
        <bpmn:incoming>SequenceFlow-MarketResearchToAnalyze-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AnalyzeToDefineSpecifications-id-0011</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="UserTask-DefineProductSpecifications-id-0004" name="Define product specifications">
        <bpmn:incoming>SequenceFlow-AnalyzeToDefineSpecifications-id-0011</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-DefineSpecificationsToCreateDesign-id-0012</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="ServiceTask-CreateInitialDesignDocuments-id-0005" name="Create initial design documents">
        <bpmn:incoming>SequenceFlow-DefineSpecificationsToCreateDesign-id-0012</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CreateDesignToDevelopPrototypes-id-0013</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-DevelopPrototypes-id-0006" name="Develop prototypes">
        <bpmn:incoming>SequenceFlow-CreateDesignToDevelopPrototypes-id-0013</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-DevelopPrototypesToQualityTesting-id-0014</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-ConductQualityTesting-id-0007" name="Conduct quality testing">
        <bpmn:incoming>SequenceFlow-DevelopPrototypesToQualityTesting-id-0014</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-QualityTestingToEnd-id-0015</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-DevelopmentPhaseComplete-id-0008" name="Development Phase Complete">
        <bpmn:incoming>SequenceFlow-QualityTestingToEnd-id-0015</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToMarketResearch-id-0009" sourceRef="StartEvent-DevelopmentPhaseBegins-id-0001" targetRef="UserTask-MarketResearchAndConceptualization-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-MarketResearchToAnalyze-id-0010" sourceRef="UserTask-MarketResearchAndConceptualization-id-0002" targetRef="ServiceTask-AnalyzeMarketDemandAndTrends-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToDefineSpecifications-id-0011" sourceRef="ServiceTask-AnalyzeMarketDemandAndTrends-id-0003" targetRef="UserTask-DefineProductSpecifications-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-DefineSpecificationsToCreateDesign-id-0012" sourceRef="UserTask-DefineProductSpecifications-id-0004" targetRef="ServiceTask-CreateInitialDesignDocuments-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-CreateDesignToDevelopPrototypes-id-0013" sourceRef="ServiceTask-CreateInitialDesignDocuments-id-0005" targetRef="ServiceTask-DevelopPrototypes-id-0006" />
      <bpmn:sequenceFlow id="SequenceFlow-DevelopPrototypesToQualityTesting-id-0014" sourceRef="ServiceTask-DevelopPrototypes-id-0006" targetRef="ServiceTask-ConductQualityTesting-id-0007" />
      <bpmn:sequenceFlow id="SequenceFlow-QualityTestingToEnd-id-0015" sourceRef="ServiceTask-ConductQualityTesting-id-0007" targetRef="EndEvent-DevelopmentPhaseComplete-id-0008" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-ProductApproval-id-0002" name="Product Approval">
      <bpmn:incoming>SequenceFlow-DevelopmentToApproval-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalToProduction-id-0020</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-ApprovalPhaseBegins-id-0001" name="Approval Phase Begins">
        <bpmn:outgoing>SequenceFlow-StartToReview-id-0008</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-ReviewProductDesignAndSpecifications-id-0002" name="Review product design and specifications">
        <bpmn:incoming>SequenceFlow-StartToReview-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReviewToGateway-id-0009</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-DesignMeetsStandards-id-0003" name="Design Meets Standards?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-ReviewToGateway-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GatewayToApprove-id-0010</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToSendFeedback-id-0012</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-ApproveProductForProduction-id-0004" name="Approve product for production">
        <bpmn:incoming>SequenceFlow-GatewayToApprove-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ApproveToEnd-id-0011</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-ProductApproved-id-0005" name="Product Approved">
        <bpmn:incoming>SequenceFlow-ApproveToEnd-id-0011</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sendTask id="SendTask-SendFeedbackToDevelopmentTeam-id-0006" name="Send feedback to development team">
        <bpmn:incoming>SequenceFlow-GatewayToSendFeedback-id-0012</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SendFeedbackToEnd-id-0013</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="EndEvent-ProductRejected-id-0007" name="Product Rejected">
        <bpmn:incoming>SequenceFlow-SendFeedbackToEnd-id-0013</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToReview-id-0008" sourceRef="StartEvent-ApprovalPhaseBegins-id-0001" targetRef="UserTask-ReviewProductDesignAndSpecifications-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-ReviewToGateway-id-0009" sourceRef="UserTask-ReviewProductDesignAndSpecifications-id-0002" targetRef="ExclusiveGateway-DesignMeetsStandards-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToApprove-id-0010" name="design_meets_standards" sourceRef="ExclusiveGateway-DesignMeetsStandards-id-0003" targetRef="ServiceTask-ApproveProductForProduction-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-ApproveToEnd-id-0011" sourceRef="ServiceTask-ApproveProductForProduction-id-0004" targetRef="EndEvent-ProductApproved-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToSendFeedback-id-0012" sourceRef="ExclusiveGateway-DesignMeetsStandards-id-0003" targetRef="SendTask-SendFeedbackToDevelopmentTeam-id-0006" />
      <bpmn:sequenceFlow id="SequenceFlow-SendFeedbackToEnd-id-0013" sourceRef="SendTask-SendFeedbackToDevelopmentTeam-id-0006" targetRef="EndEvent-ProductRejected-id-0007" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-ProductionAndDistribution-id-0003" name="Production and Distribution">
      <bpmn:incoming>SequenceFlow-ApprovalToProduction-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProductionToMarketing-id-0021</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-ProductionPhaseBegins-id-0001" name="Production Phase Begins">
        <bpmn:outgoing>SequenceFlow-StartToSetUp-id-0007</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-SetUpProductionLine-id-0002" name="Set up production line">
        <bpmn:incoming>SequenceFlow-StartToSetUp-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SetUpToManufacture-id-0008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-ManufactureProducts-id-0003" name="Manufacture products">
        <bpmn:incoming>SequenceFlow-SetUpToManufacture-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ManufactureToPackage-id-0009</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-PackageAndPrepareForDistribution-id-0004" name="Package and prepare for distribution">
        <bpmn:incoming>SequenceFlow-ManufactureToPackage-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PackageToDistribute-id-0010</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-DistributeToRetailersAndChannels-id-0005" name="Distribute to retailers and channels">
        <bpmn:incoming>SequenceFlow-PackageToDistribute-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-DistributeToEnd-id-0011</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-ProductionPhaseComplete-id-0006" name="Production Phase Complete">
        <bpmn:incoming>SequenceFlow-DistributeToEnd-id-0011</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToSetUp-id-0007" sourceRef="StartEvent-ProductionPhaseBegins-id-0001" targetRef="ServiceTask-SetUpProductionLine-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SetUpToManufacture-id-0008" sourceRef="ServiceTask-SetUpProductionLine-id-0002" targetRef="ServiceTask-ManufactureProducts-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-ManufactureToPackage-id-0009" sourceRef="ServiceTask-ManufactureProducts-id-0003" targetRef="ServiceTask-PackageAndPrepareForDistribution-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-PackageToDistribute-id-0010" sourceRef="ServiceTask-PackageAndPrepareForDistribution-id-0004" targetRef="ServiceTask-DistributeToRetailersAndChannels-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-DistributeToEnd-id-0011" sourceRef="ServiceTask-DistributeToRetailersAndChannels-id-0005" targetRef="EndEvent-ProductionPhaseComplete-id-0006" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-SalesAndMarketing-id-0004" name="Sales and Marketing">
      <bpmn:incoming>SequenceFlow-ProductionToMarketing-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MarketingToLifecycleManagement-id-0022</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-MarketingPhaseBegins-id-0001" name="Marketing Phase Begins">
        <bpmn:outgoing>SequenceFlow-StartToDevelopStrategy-id-0007</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-DevelopMarketingStrategy-id-0002" name="Develop marketing strategy">
        <bpmn:incoming>SequenceFlow-StartToDevelopStrategy-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-DevelopStrategyToLaunch-id-0008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-LaunchPromotionalCampaigns-id-0003" name="Launch promotional campaigns">
        <bpmn:incoming>SequenceFlow-DevelopStrategyToLaunch-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-LaunchToMonitor-id-0009</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-MonitorSalesPerformance-id-0004" name="Monitor sales performance">
        <bpmn:incoming>SequenceFlow-LaunchToMonitor-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MonitorToCollectFeedback-id-0010</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-CollectCustomerFeedback-id-0005" name="Collect customer feedback">
        <bpmn:incoming>SequenceFlow-MonitorToCollectFeedback-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CollectFeedbackToEnd-id-0011</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-MarketingPhaseComplete-id-0006" name="Marketing Phase Complete">
        <bpmn:incoming>SequenceFlow-CollectFeedbackToEnd-id-0011</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToDevelopStrategy-id-0007" sourceRef="StartEvent-MarketingPhaseBegins-id-0001" targetRef="ServiceTask-DevelopMarketingStrategy-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-DevelopStrategyToLaunch-id-0008" sourceRef="ServiceTask-DevelopMarketingStrategy-id-0002" targetRef="ServiceTask-LaunchPromotionalCampaigns-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-LaunchToMonitor-id-0009" sourceRef="ServiceTask-LaunchPromotionalCampaigns-id-0003" targetRef="ServiceTask-MonitorSalesPerformance-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-MonitorToCollectFeedback-id-0010" sourceRef="ServiceTask-MonitorSalesPerformance-id-0004" targetRef="ServiceTask-CollectCustomerFeedback-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-CollectFeedbackToEnd-id-0011" sourceRef="ServiceTask-CollectCustomerFeedback-id-0005" targetRef="EndEvent-MarketingPhaseComplete-id-0006" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-ProductLifecycleManagement-id-0005" name="Product Lifecycle Management">
      <bpmn:incoming>SequenceFlow-MarketingToLifecycleManagement-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LifecycleManagementToEnd-id-0023</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-LifecycleManagementBegins-id-0001" name="Lifecycle Management Begins">
        <bpmn:outgoing>SequenceFlow-StartToTrack-id-0009</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-TrackProductPerformanceAndMarketTrends-id-0002" name="Track product performance and market trends">
        <bpmn:incoming>SequenceFlow-StartToTrack-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TrackToGateway-id-0010</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:inclusiveGateway id="InclusiveGateway-ProductLifecycleDecisions-id-0003" name="Product Lifecycle Decisions">
        <bpmn:incoming>SequenceFlow-TrackToGateway-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GatewayToUpdate-id-0011</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToReplace-id-0012</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToPhaseOut-id-0013</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-DevelopAndImplementProductUpdates-id-0004" name="Develop and implement product updates">
        <bpmn:incoming>SequenceFlow-GatewayToUpdate-id-0011</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-UpdateToMerge-id-0014</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-DevelopAndLaunchReplacementProduct-id-0005" name="Develop and launch replacement product">
        <bpmn:incoming>SequenceFlow-GatewayToReplace-id-0012</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReplaceToMerge-id-0015</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-PhaseOutProductAndArchiveRecords-id-0006" name="Phase out product and archive records">
        <bpmn:incoming>SequenceFlow-GatewayToPhaseOut-id-0013</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PhaseOutToMerge-id-0016</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:inclusiveGateway id="InclusiveGateway-MergeLifecyclePaths-id-0007" name="Merge Lifecycle Paths">
        <bpmn:incoming>SequenceFlow-UpdateToMerge-id-0014</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ReplaceToMerge-id-0015</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-PhaseOutToMerge-id-0016</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MergeToEnd-id-0017</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:endEvent id="EndEvent-LifecycleManagementComplete-id-0008" name="Lifecycle Management Complete">
        <bpmn:incoming>SequenceFlow-MergeToEnd-id-0017</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToTrack-id-0009" sourceRef="StartEvent-LifecycleManagementBegins-id-0001" targetRef="ServiceTask-TrackProductPerformanceAndMarketTrends-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-TrackToGateway-id-0010" sourceRef="ServiceTask-TrackProductPerformanceAndMarketTrends-id-0002" targetRef="InclusiveGateway-ProductLifecycleDecisions-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToUpdate-id-0011" name="product_needs_update" sourceRef="InclusiveGateway-ProductLifecycleDecisions-id-0003" targetRef="ServiceTask-DevelopAndImplementProductUpdates-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToReplace-id-0012" name="product_needs_replacement" sourceRef="InclusiveGateway-ProductLifecycleDecisions-id-0003" targetRef="ServiceTask-DevelopAndLaunchReplacementProduct-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToPhaseOut-id-0013" name="product_discontinued" sourceRef="InclusiveGateway-ProductLifecycleDecisions-id-0003" targetRef="ServiceTask-PhaseOutProductAndArchiveRecords-id-0006" />
      <bpmn:sequenceFlow id="SequenceFlow-UpdateToMerge-id-0014" sourceRef="ServiceTask-DevelopAndImplementProductUpdates-id-0004" targetRef="InclusiveGateway-MergeLifecyclePaths-id-0007" />
      <bpmn:sequenceFlow id="SequenceFlow-ReplaceToMerge-id-0015" sourceRef="ServiceTask-DevelopAndLaunchReplacementProduct-id-0005" targetRef="InclusiveGateway-MergeLifecyclePaths-id-0007" />
      <bpmn:sequenceFlow id="SequenceFlow-PhaseOutToMerge-id-0016" sourceRef="ServiceTask-PhaseOutProductAndArchiveRecords-id-0006" targetRef="InclusiveGateway-MergeLifecyclePaths-id-0007" />
      <bpmn:sequenceFlow id="SequenceFlow-MergeToEnd-id-0017" sourceRef="InclusiveGateway-MergeLifecyclePaths-id-0007" targetRef="EndEvent-LifecycleManagementComplete-id-0008" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent-ProductLifecycleProcessEnds-id-0006" name="Product Lifecycle Process Ends">
      <bpmn:incoming>SequenceFlow-LifecycleManagementToEnd-id-0023</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDevelopment-id-0018" sourceRef="StartEvent-ProductLifecycleProcessStarts-id-0001" targetRef="SubProcess-ProductDevelopment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DevelopmentToApproval-id-0019" sourceRef="SubProcess-ProductDevelopment-id-0001" targetRef="SubProcess-ProductApproval-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalToProduction-id-0020" sourceRef="SubProcess-ProductApproval-id-0002" targetRef="SubProcess-ProductionAndDistribution-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ProductionToMarketing-id-0021" sourceRef="SubProcess-ProductionAndDistribution-id-0003" targetRef="SubProcess-SalesAndMarketing-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-MarketingToLifecycleManagement-id-0022" sourceRef="SubProcess-SalesAndMarketing-id-0004" targetRef="SubProcess-ProductLifecycleManagement-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-LifecycleManagementToEnd-id-0023" sourceRef="SubProcess-ProductLifecycleManagement-id-0005" targetRef="EndEvent-ProductLifecycleProcessEnds-id-0006" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ProductLifecycleProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_ProductLifecycleProcess-id-0001" bpmnElement="ProductLifecycleProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ProductLifecycleProcessStarts-id-0001_di" bpmnElement="StartEvent-ProductLifecycleProcessStarts-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-ProductDevelopment-id-0001_di" bpmnElement="SubProcess-ProductDevelopment-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-ProductApproval-id-0002_di" bpmnElement="SubProcess-ProductApproval-id-0002">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-ProductionAndDistribution-id-0003_di" bpmnElement="SubProcess-ProductionAndDistribution-id-0003">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-SalesAndMarketing-id-0004_di" bpmnElement="SubProcess-SalesAndMarketing-id-0004">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-ProductLifecycleManagement-id-0005_di" bpmnElement="SubProcess-ProductLifecycleManagement-id-0005">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProductLifecycleProcessEnds-id-0006_di" bpmnElement="EndEvent-ProductLifecycleProcessEnds-id-0006">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToDevelopment-id-0018_di" bpmnElement="SequenceFlow-StartToDevelopment-id-0018">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DevelopmentToApproval-id-0019_di" bpmnElement="SequenceFlow-DevelopmentToApproval-id-0019">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ApprovalToProduction-id-0020_di" bpmnElement="SequenceFlow-ApprovalToProduction-id-0020">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProductionToMarketing-id-0021_di" bpmnElement="SequenceFlow-ProductionToMarketing-id-0021">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MarketingToLifecycleManagement-id-0022_di" bpmnElement="SequenceFlow-MarketingToLifecycleManagement-id-0022">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LifecycleManagementToEnd-id-0023_di" bpmnElement="SequenceFlow-LifecycleManagementToEnd-id-0023">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-ProductLifecycleManagement-id-0005">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-ProductLifecycleManagement-id-0005" bpmnElement="SubProcess-ProductLifecycleManagement-id-0005">
      <bpmndi:BPMNShape id="StartEvent-LifecycleManagementBegins-id-0001_di" bpmnElement="StartEvent-LifecycleManagementBegins-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TrackProductPerformanceAndMarketTrends-id-0002_di" bpmnElement="ServiceTask-TrackProductPerformanceAndMarketTrends-id-0002">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InclusiveGateway-ProductLifecycleDecisions-id-0003_di" bpmnElement="InclusiveGateway-ProductLifecycleDecisions-id-0003">
