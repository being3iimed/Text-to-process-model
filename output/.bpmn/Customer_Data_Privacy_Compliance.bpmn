  <bpmn:process id="PrivacyPolicyReviewProcess-id-0001">
    <bpmn:startEvent id="StartEvent-ProcessStarts-id-0001" name="Privacy Policy Review Process Starts">
      <bpmn:outgoing>SequenceFlow-StartToSplit-id-0027</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0002" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StartToSplit-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToRetrievePolicy-id-0028</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToRetrieveRegulations-id-0029</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-RetrievePolicy-id-0003" name="Retrieve latest privacy policy">
      <bpmn:incoming>SequenceFlow-SplitToRetrievePolicy-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RetrievePolicyToJoin-id-0030</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-RetrieveRegulations-id-0004" name="Retrieve applicable regulations (e.g., GDPR)">
      <bpmn:incoming>SequenceFlow-SplitToRetrieveRegulations-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RetrieveRegulationsToJoin-id-0031</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0005" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-RetrievePolicyToJoin-id-0030</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-RetrieveRegulationsToJoin-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToCompare-id-0032</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-ComparePolicy-id-0006" name="Compare policy against regulations">
      <bpmn:incoming>SequenceFlow-JoinToCompare-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CompareToGateway-id-0033</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PolicyCompliant-id-0007" name="Policy Compliant?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CompareToGateway-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToCompliant-id-0034</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToNonCompliant-id-0036</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-FlagCompliant-id-0008" name="Flag compliant areas">
      <bpmn:incoming>SequenceFlow-GatewayToCompliant-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CompliantToEnd-id-0035</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-PolicyCompliant-id-0009" name="Policy Compliant - Process Complete">
      <bpmn:incoming>SequenceFlow-CompliantToEnd-id-0035</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-FlagNonCompliant-id-0010" name="Flag non-compliant areas">
      <bpmn:incoming>SequenceFlow-GatewayToNonCompliant-id-0036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NonCompliantToIdentify-id-0037</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-IdentifyRemediation-id-0011" name="Identify remediation actions">
      <bpmn:incoming>SequenceFlow-NonCompliantToIdentify-id-0037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdentifyToDocument-id-0038</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-DocumentRemediation-id-0012" name="Document remediation plan">
      <bpmn:incoming>SequenceFlow-IdentifyToDocument-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentToSplit2-id-0039</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Split2-id-0013" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-DocumentToSplit2-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Split2ToSchedule-id-0040</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-Split2ToPrepare-id-0041</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-ScheduleAudit-id-0014" name="Schedule system audit">
      <bpmn:incoming>SequenceFlow-Split2ToSchedule-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ScheduleToJoin2-id-0042</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-PrepareTraining-id-0015" name="Prepare employee training materials">
      <bpmn:incoming>SequenceFlow-Split2ToPrepare-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareToJoin2-id-0043</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Join2-id-0016" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ScheduleToJoin2-id-0042</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PrepareToJoin2-id-0043</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Join2ToConduct-id-0044</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-ConductAudit-id-0017" name="Conduct system audit">
      <bpmn:incoming>SequenceFlow-Join2ToConduct-id-0044</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConductToGateway2-id-0045</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AuditPassed-id-0018" name="Audit Passed?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ConductToGateway2-id-0045</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Gateway2ToUpdate-id-0046</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-Gateway2ToDocument-id-0050</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-UpdatePolicy-id-0019" name="Update policy to address findings">
      <bpmn:incoming>SequenceFlow-Gateway2ToUpdate-id-0046</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToTraining-id-0047</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ConductTraining-id-0020" name="Conduct employee training">
      <bpmn:incoming>SequenceFlow-UpdateToTraining-id-0047</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainingToCertification-id-0048</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-IssueCertification-id-0021" name="Issue certification">
      <bpmn:incoming>SequenceFlow-TrainingToCertification-id-0048</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CertificationToEnd-id-0049</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-PolicyCertified-id-0022" name="Policy Certified - Process Complete">
      <bpmn:incoming>SequenceFlow-CertificationToEnd-id-0049</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-DocumentFindings-id-0023" name="Document audit findings">
      <bpmn:incoming>SequenceFlow-Gateway2ToDocument-id-0050</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentToUpdate-id-0051</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-UpdateRemediation-id-0024" name="Update remediation plan">
      <bpmn:incoming>SequenceFlow-DocumentToUpdate-id-0051</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToSchedule-id-0052</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ScheduleFollowUp-id-0025" name="Schedule follow-up audit">
      <bpmn:incoming>SequenceFlow-UpdateToSchedule-id-0052</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ScheduleToEnd-id-0053</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-PolicyNonCompliant-id-0026" name="Policy Non-Compliant - Ongoing Monitoring">
      <bpmn:incoming>SequenceFlow-ScheduleToEnd-id-0053</bpmn:incoming>
    </bpmn:endEvent>
