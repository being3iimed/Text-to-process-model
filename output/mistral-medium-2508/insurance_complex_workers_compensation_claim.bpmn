<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WorkersCompensationClaimDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="WorkersCompensationClaimProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-WorkplaceInjuryOccurs-id-0001" name="Workplace Injury Occurs">
      <bpmn:outgoing>SequenceFlow-StartToReportInjury-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ReportInjuryToEmployer-id-0001" name="Report Injury to Employer">
      <bpmn:incoming>SequenceFlow-StartToReportInjury-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReportToEmployerSubmit-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-EmployerSubmitsInjuryReport-id-0001" name="Employer Submits Injury Report to Insurer">
      <bpmn:incoming>SequenceFlow-ReportToEmployerSubmit-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployerSubmitToAdjusterContact-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer24Hour-EmployerSubmission-id-0001" name="24 Hour SLA Violation" attachedToRef="ServiceTask-EmployerSubmitsInjuryReport-id-0001">
      <bpmn:outgoing>SequenceFlow-EmployerSubmitToSLAHandler-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer24Hour-EmployerSubmission-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-SendSLAViolationNotice-id-0001" name="Send: SLA Violation Notice to Employer">
      <bpmn:incoming>SequenceFlow-EmployerSubmitToSLAHandler-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SLAHandlerToClose-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-AdjusterContactsInjuredWorker-id-0001" name="Adjuster Contacts Injured Worker">
      <bpmn:incoming>SequenceFlow-EmployerSubmitToAdjusterContact-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdjusterContactToDetermineWorkRelated-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AdjusterDeterminesWorkRelatedInjury-id-0001" name="Adjuster Determines Work-Related Injury">
      <bpmn:incoming>SequenceFlow-AdjusterContactToDetermineWorkRelated-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DetermineWorkRelatedToGateway-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InjuryWorkRelated-id-0001" name="Injury Work-Related?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-DetermineWorkRelatedToGateway-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WorkRelatedToBenefits-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-NotWorkRelatedToDenial-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-SendNonCoveredInjuryNotice-id-0001" name="Send: Non-Covered Injury Notice">
      <bpmn:incoming>SequenceFlow-NotWorkRelatedToDenial-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DenialToClose-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-AdjusterDeterminesApplicableBenefits-id-0001" name="Adjuster Determines Applicable Benefits">
      <bpmn:incoming>SequenceFlow-WorkRelatedToBenefits-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BenefitsToBenefitsGateway-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-BenefitsApplicable-id-0001" name="Benefits Applicable?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-BenefitsToBenefitsGateway-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BenefitsApplicableToVerify-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-BenefitsNotApplicableToDenial-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-SendBenefitsDenialNotice-id-0001" name="Send: Benefits Denial Notice">
      <bpmn:incoming>SequenceFlow-BenefitsNotApplicableToDenial-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BenefitsDenialToClose-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-VerifyWageAndEmploymentHistory-id-0001" name="Verify Worker&#39;s Wage and Employment History">
      <bpmn:incoming>SequenceFlow-BenefitsApplicableToVerify-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToMedicalSubprocess-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess-MedicalTreatmentManagement-id-0001" name="Medical Treatment Management">
      <bpmn:incoming>SequenceFlow-VerifyToMedicalSubprocess-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MedicalToRTWSubprocess-id-0001</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-TreatmentManagementBegins-id-0001" name="Treatment Management Begins">
        <bpmn:outgoing>SequenceFlow-TreatmentStartToSplit-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway-TreatmentSplit-id-0001" name="Parallel Treatment Tasks" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-TreatmentStartToSplit-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToAuthorize-id-0001</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToReview-id-0001</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="UserTask-AuthorizeMedicalTreatment-id-0001" name="Authorize Medical Treatment">
        <bpmn:incoming>SequenceFlow-SplitToAuthorize-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AuthorizeToJoin-id-0001</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="UserTask-ReviewMedicalReports-id-0001" name="Review Medical Reports">
        <bpmn:incoming>SequenceFlow-SplitToReview-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReviewToDispute-id-0001</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="ParallelGateway-TreatmentJoin-id-0001" name="Synchronize Treatment Tasks" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-AuthorizeToJoin-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ReviewToDispute-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToDisputeCheck-id-0001</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:exclusiveGateway id="ExclusiveGateway-DisputeSeverity-id-0001" name="Dispute About Injury Severity?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-JoinToDisputeCheck-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-DisputeToIME-id-0001</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-NoDisputeToEnd-id-0001</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UserTask-OrderIndependentMedicalExamination-id-0001" name="Order Independent Medical Examination (IME)">
        <bpmn:incoming>SequenceFlow-DisputeToIME-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-IMEToOpinion-id-0001</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="UserTask-IMEPhysicianProvidesSecondOpinion-id-0001" name="IME Physician Provides Second Opinion">
        <bpmn:incoming>SequenceFlow-IMEToOpinion-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-OpinionToJoin-id-0001</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-IMEJoin-id-0001" name="IME Path Join" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-NoDisputeToEnd-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-OpinionToJoin-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-IMEJoinToEnd-id-0001</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent-TreatmentManagementComplete-id-0001" name="Treatment Management Complete">
        <bpmn:incoming>SequenceFlow-IMEJoinToEnd-id-0001</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-TreatmentStartToSplit-id-0001" sourceRef="StartEvent-TreatmentManagementBegins-id-0001" targetRef="ParallelGateway-TreatmentSplit-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToAuthorize-id-0001" sourceRef="ParallelGateway-TreatmentSplit-id-0001" targetRef="UserTask-AuthorizeMedicalTreatment-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToReview-id-0001" sourceRef="ParallelGateway-TreatmentSplit-id-0001" targetRef="UserTask-ReviewMedicalReports-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-AuthorizeToJoin-id-0001" sourceRef="UserTask-AuthorizeMedicalTreatment-id-0001" targetRef="ParallelGateway-TreatmentJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReviewToDispute-id-0001" sourceRef="UserTask-ReviewMedicalReports-id-0001" targetRef="ParallelGateway-TreatmentJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToDisputeCheck-id-0001" sourceRef="ParallelGateway-TreatmentJoin-id-0001" targetRef="ExclusiveGateway-DisputeSeverity-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-DisputeToIME-id-0001" name="dispute_about_injury_severity" sourceRef="ExclusiveGateway-DisputeSeverity-id-0001" targetRef="UserTask-OrderIndependentMedicalExamination-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-NoDisputeToEnd-id-0001" sourceRef="ExclusiveGateway-DisputeSeverity-id-0001" targetRef="ExclusiveGateway-IMEJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-IMEToOpinion-id-0001" sourceRef="UserTask-OrderIndependentMedicalExamination-id-0001" targetRef="UserTask-IMEPhysicianProvidesSecondOpinion-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-OpinionToJoin-id-0001" sourceRef="UserTask-IMEPhysicianProvidesSecondOpinion-id-0001" targetRef="ExclusiveGateway-IMEJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-IMEJoinToEnd-id-0001" sourceRef="ExclusiveGateway-IMEJoin-id-0001" targetRef="EndEvent-TreatmentManagementComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-ReturnToWorkCoordination-id-0001" name="Return-to-Work Coordination">
      <bpmn:incoming>SequenceFlow-MedicalToRTWSubprocess-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RTWToDisabilityAward-id-0001</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-RTWCoordinationBegins-id-0001" name="RTW Coordination Begins">
        <bpmn:outgoing>SequenceFlow-RTWStartToMonitor-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-MonitorReturnToWorkStatus-id-0001" name="Monitor Return-to-Work Status">
        <bpmn:incoming>SequenceFlow-RTWStartToMonitor-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MonitorToCanReturn-id-0001</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-WorkerCanReturn-id-0001" name="Worker Can Return?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-MonitorToCanReturn-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CanReturnToPlacement-id-0001</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-CannotReturnToJoin-id-0001</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UserTask-CoordinateJobPlacement-id-0001" name="Coordinate Job Placement with Employer">
        <bpmn:incoming>SequenceFlow-CanReturnToPlacement-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PlacementToJoin-id-0001</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-RTWJoin-id-0001" name="RTW Path Join" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-CannotReturnToJoin-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-PlacementToJoin-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToReport-id-0001</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-SubmitStatusReportToStateBoard-id-0001" name="Submit Status Report to State Board">
        <bpmn:incoming>SequenceFlow-JoinToReport-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReportToEnd-id-0001</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-RTWCoordinationComplete-id-0001" name="RTW Coordination Complete">
        <bpmn:incoming>SequenceFlow-ReportToEnd-id-0001</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-RTWStartToMonitor-id-0001" sourceRef="StartEvent-RTWCoordinationBegins-id-0001" targetRef="UserTask-MonitorReturnToWorkStatus-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-MonitorToCanReturn-id-0001" sourceRef="UserTask-MonitorReturnToWorkStatus-id-0001" targetRef="ExclusiveGateway-WorkerCanReturn-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CanReturnToPlacement-id-0001" name="worker_can_return" sourceRef="ExclusiveGateway-WorkerCanReturn-id-0001" targetRef="UserTask-CoordinateJobPlacement-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CannotReturnToJoin-id-0001" sourceRef="ExclusiveGateway-WorkerCanReturn-id-0001" targetRef="ExclusiveGateway-RTWJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PlacementToJoin-id-0001" sourceRef="UserTask-CoordinateJobPlacement-id-0001" targetRef="ExclusiveGateway-RTWJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToReport-id-0001" sourceRef="ExclusiveGateway-RTWJoin-id-0001" targetRef="ServiceTask-SubmitStatusReportToStateBoard-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReportToEnd-id-0001" sourceRef="ServiceTask-SubmitStatusReportToStateBoard-id-0001" targetRef="EndEvent-RTWCoordinationComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask-CalculatePermanentDisabilityAward-id-0001" name="Calculate Permanent Disability Award">
      <bpmn:incoming>SequenceFlow-RTWToDisabilityAward-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DisabilityAwardToClose-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CloseClaimFile-id-0001" name="Close Claim File">
      <bpmn:incoming>SequenceFlow-SLAHandlerToClose-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DenialToClose-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-BenefitsDenialToClose-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DisabilityAwardToClose-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CloseToEnd-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-ClaimFileClosed-id-0001" name="Claim File Closed">
      <bpmn:incoming>SequenceFlow-CloseToEnd-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToReportInjury-id-0001" sourceRef="StartEvent-WorkplaceInjuryOccurs-id-0001" targetRef="UserTask-ReportInjuryToEmployer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReportToEmployerSubmit-id-0001" sourceRef="UserTask-ReportInjuryToEmployer-id-0001" targetRef="ServiceTask-EmployerSubmitsInjuryReport-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployerSubmitToSLAHandler-id-0001" sourceRef="BoundaryEvent-Timer24Hour-EmployerSubmission-id-0001" targetRef="SendTask-SendSLAViolationNotice-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SLAHandlerToClose-id-0001" sourceRef="SendTask-SendSLAViolationNotice-id-0001" targetRef="ServiceTask-CloseClaimFile-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployerSubmitToAdjusterContact-id-0001" sourceRef="ServiceTask-EmployerSubmitsInjuryReport-id-0001" targetRef="UserTask-AdjusterContactsInjuredWorker-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AdjusterContactToDetermineWorkRelated-id-0001" sourceRef="UserTask-AdjusterContactsInjuredWorker-id-0001" targetRef="UserTask-AdjusterDeterminesWorkRelatedInjury-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DetermineWorkRelatedToGateway-id-0001" sourceRef="UserTask-AdjusterDeterminesWorkRelatedInjury-id-0001" targetRef="ExclusiveGateway-InjuryWorkRelated-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WorkRelatedToBenefits-id-0001" name="injury_is_work_related" sourceRef="ExclusiveGateway-InjuryWorkRelated-id-0001" targetRef="UserTask-AdjusterDeterminesApplicableBenefits-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NotWorkRelatedToDenial-id-0001" sourceRef="ExclusiveGateway-InjuryWorkRelated-id-0001" targetRef="SendTask-SendNonCoveredInjuryNotice-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DenialToClose-id-0001" sourceRef="SendTask-SendNonCoveredInjuryNotice-id-0001" targetRef="ServiceTask-CloseClaimFile-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BenefitsToBenefitsGateway-id-0001" sourceRef="UserTask-AdjusterDeterminesApplicableBenefits-id-0001" targetRef="ExclusiveGateway-BenefitsApplicable-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BenefitsApplicableToVerify-id-0001" name="medical_coverage_applies OR disability_applies" sourceRef="ExclusiveGateway-BenefitsApplicable-id-0001" targetRef="ServiceTask-VerifyWageAndEmploymentHistory-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BenefitsNotApplicableToDenial-id-0001" sourceRef="ExclusiveGateway-BenefitsApplicable-id-0001" targetRef="SendTask-SendBenefitsDenialNotice-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BenefitsDenialToClose-id-0001" sourceRef="SendTask-SendBenefitsDenialNotice-id-0001" targetRef="ServiceTask-CloseClaimFile-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyToMedicalSubprocess-id-0001" sourceRef="ServiceTask-VerifyWageAndEmploymentHistory-id-0001" targetRef="SubProcess-MedicalTreatmentManagement-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MedicalToRTWSubprocess-id-0001" sourceRef="SubProcess-MedicalTreatmentManagement-id-0001" targetRef="SubProcess-ReturnToWorkCoordination-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RTWToDisabilityAward-id-0001" sourceRef="SubProcess-ReturnToWorkCoordination-id-0001" targetRef="UserTask-CalculatePermanentDisabilityAward-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DisabilityAwardToClose-id-0001" sourceRef="UserTask-CalculatePermanentDisabilityAward-id-0001" targetRef="ServiceTask-CloseClaimFile-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CloseToEnd-id-0001" sourceRef="ServiceTask-CloseClaimFile-id-0001" targetRef="EndEvent-ClaimFileClosed-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_WorkersCompensationClaimProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_WorkersCompensationClaimProcess" bpmnElement="WorkersCompensationClaimProcess">
      <bpmndi:BPMNShape id="StartEvent-WorkplaceInjuryOccurs-id-0001_di" bpmnElement="StartEvent-WorkplaceInjuryOccurs-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReportInjuryToEmployer-id-0001_di" bpmnElement="UserTask-ReportInjuryToEmployer-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-EmployerSubmitsInjuryReport-id-0001_di" bpmnElement="ServiceTask-EmployerSubmitsInjuryReport-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-Timer24Hour-EmployerSubmission-id-0001_di" bpmnElement="BoundaryEvent-Timer24Hour-EmployerSubmission-id-0001">
        <dc:Bounds x="357" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AdjusterContactsInjuredWorker-id-0001_di" bpmnElement="UserTask-AdjusterContactsInjuredWorker-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AdjusterDeterminesWorkRelatedInjury-id-0001_di" bpmnElement="UserTask-AdjusterDeterminesWorkRelatedInjury-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-InjuryWorkRelated-id-0001_di" bpmnElement="ExclusiveGateway-InjuryWorkRelated-id-0001" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AdjusterDeterminesApplicableBenefits-id-0001_di" bpmnElement="UserTask-AdjusterDeterminesApplicableBenefits-id-0001">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-BenefitsApplicable-id-0001_di" bpmnElement="ExclusiveGateway-BenefitsApplicable-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-VerifyWageAndEmploymentHistory-id-0001_di" bpmnElement="ServiceTask-VerifyWageAndEmploymentHistory-id-0001">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-MedicalTreatmentManagement-id-0001_di" bpmnElement="SubProcess-MedicalTreatmentManagement-id-0001">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-ReturnToWorkCoordination-id-0001_di" bpmnElement="SubProcess-ReturnToWorkCoordination-id-0001">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CalculatePermanentDisabilityAward-id-0001_di" bpmnElement="UserTask-CalculatePermanentDisabilityAward-id-0001">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CloseClaimFile-id-0001_di" bpmnElement="ServiceTask-CloseClaimFile-id-0001">
        <dc:Bounds x="1825" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ClaimFileClosed-id-0001_di" bpmnElement="EndEvent-ClaimFileClosed-id-0001">
        <dc:Bounds x="2007" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendSLAViolationNotice-id-0001_di" bpmnElement="SendTask-SendSLAViolationNotice-id-0001">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendNonCoveredInjuryNotice-id-0001_di" bpmnElement="SendTask-SendNonCoveredInjuryNotice-id-0001">
