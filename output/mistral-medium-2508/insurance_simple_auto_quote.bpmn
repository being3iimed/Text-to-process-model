<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="quote-process-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="QuoteProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-QuoteProcessInitiated-id-0001" name="Quote Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToEnterInfo-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-EnterVehicleInformation-id-0001" name="Enter Vehicle Information">
      <bpmn:incoming>SequenceFlow-StartToEnterInfo-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnterInfoToQuery-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-QueryRiskDatabase-id-0001" name="Query Risk Database">
      <bpmn:incoming>SequenceFlow-EnterInfoToQuery-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-QueryToCalculate-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="ScriptTask-CalculatePremium-id-0001" name="Calculate Premium">
      <bpmn:incoming>SequenceFlow-QueryToCalculate-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateToReview-id-0004</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="UserTask-ReviewQuote-id-0001" name="Review Quote">
      <bpmn:incoming>SequenceFlow-CalculateToReview-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToGateway-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-QuoteDecision-id-0001" name="Quote Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToGateway-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToPurchase-id-0006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToSave-id-0008</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-PurchasePolicy-id-0001" name="Purchase Policy">
      <bpmn:incoming>SequenceFlow-GatewayToPurchase-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PurchaseToComplete-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-QuotePurchased-id-0001" name="Quote Purchased">
      <bpmn:incoming>SequenceFlow-PurchaseToComplete-id-0007</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-SaveQuote-id-0001" name="Save Quote">
      <bpmn:incoming>SequenceFlow-GatewayToSave-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SaveToSaved-id-0009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-QuoteSaved-id-0002" name="Quote Saved">
      <bpmn:incoming>SequenceFlow-SaveToSaved-id-0009</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToEnterInfo-id-0001" sourceRef="StartEvent-QuoteProcessInitiated-id-0001" targetRef="UserTask-EnterVehicleInformation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EnterInfoToQuery-id-0002" sourceRef="UserTask-EnterVehicleInformation-id-0001" targetRef="ServiceTask-QueryRiskDatabase-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-QueryToCalculate-id-0003" sourceRef="ServiceTask-QueryRiskDatabase-id-0001" targetRef="ScriptTask-CalculatePremium-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateToReview-id-0004" sourceRef="ScriptTask-CalculatePremium-id-0001" targetRef="UserTask-ReviewQuote-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToGateway-id-0005" sourceRef="UserTask-ReviewQuote-id-0001" targetRef="ExclusiveGateway-QuoteDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToPurchase-id-0006" name="purchase_selected" sourceRef="ExclusiveGateway-QuoteDecision-id-0001" targetRef="UserTask-PurchasePolicy-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PurchaseToComplete-id-0007" sourceRef="UserTask-PurchasePolicy-id-0001" targetRef="EndEvent-QuotePurchased-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToSave-id-0008" name="save_selected" sourceRef="ExclusiveGateway-QuoteDecision-id-0001" targetRef="ServiceTask-SaveQuote-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SaveToSaved-id-0009" sourceRef="ServiceTask-SaveQuote-id-0001" targetRef="EndEvent-QuoteSaved-id-0002" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_QuoteProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_QuoteProcess-id-0001" bpmnElement="QuoteProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-QuoteProcessInitiated-id-0001_di" bpmnElement="StartEvent-QuoteProcessInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EnterVehicleInformation-id-0001_di" bpmnElement="UserTask-EnterVehicleInformation-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-QueryRiskDatabase-id-0001_di" bpmnElement="ServiceTask-QueryRiskDatabase-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScriptTask-CalculatePremium-id-0001_di" bpmnElement="ScriptTask-CalculatePremium-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewQuote-id-0001_di" bpmnElement="UserTask-ReviewQuote-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-QuoteDecision-id-0001_di" bpmnElement="ExclusiveGateway-QuoteDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-PurchasePolicy-id-0001_di" bpmnElement="UserTask-PurchasePolicy-id-0001">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-QuotePurchased-id-0001_di" bpmnElement="EndEvent-QuotePurchased-id-0001">
        <dc:Bounds x="1107" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SaveQuote-id-0001_di" bpmnElement="ServiceTask-SaveQuote-id-0001">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-QuoteSaved-id-0002_di" bpmnElement="EndEvent-QuoteSaved-id-0002">
        <dc:Bounds x="1107" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToEnterInfo-id-0001_di" bpmnElement="SequenceFlow-StartToEnterInfo-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EnterInfoToQuery-id-0002_di" bpmnElement="SequenceFlow-EnterInfoToQuery-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-QueryToCalculate-id-0003_di" bpmnElement="SequenceFlow-QueryToCalculate-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CalculateToReview-id-0004_di" bpmnElement="SequenceFlow-CalculateToReview-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToGateway-id-0005_di" bpmnElement="SequenceFlow-ReviewToGateway-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToPurchase-id-0006_di" bpmnElement="SequenceFlow-GatewayToPurchase-id-0006">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToSave-id-0008_di" bpmnElement="SequenceFlow-GatewayToSave-id-0008">
        <di:waypoint x="825" y="95" />
        <di:waypoint x="825" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PurchaseToComplete-id-0007_di" bpmnElement="SequenceFlow-PurchaseToComplete-id-0007">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1107" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SaveToSaved-id-0009_di" bpmnElement="SequenceFlow-SaveToSaved-id-0009">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1107" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
