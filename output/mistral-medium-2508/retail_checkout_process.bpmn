<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="checkout-process-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="CheckoutProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CheckoutProcessInitiated-id-0001" name="Checkout Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToAddItems-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-AddItemsToCart-id-0001" name="Add Items to Cart">
      <bpmn:incoming>SequenceFlow-StartToAddItems-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AddItemsToValidate-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ValidateInventory-id-0001" name="Validate Inventory">
      <bpmn:incoming>SequenceFlow-AddItemsToValidate-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidateToProcessPayment-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ProcessPayment-id-0001" name="Process Payment">
      <bpmn:incoming>SequenceFlow-ValidateToProcessPayment-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProcessPaymentToGateway-id-0004</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PaymentSuccess-id-0001" name="Payment Success?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ProcessPaymentToGateway-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToSuccess-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToFailure-id-0007</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-SendOrderConfirmation-id-0001" name="Send: order confirmation">
      <bpmn:incoming>SequenceFlow-GatewayToSuccess-id-0005</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Gateway2ToSuccess-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SuccessToEnd-id-0006</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-OrderCompleted-id-0001" name="Order Completed">
      <bpmn:incoming>SequenceFlow-SuccessToEnd-id-0006</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-SendPaymentFailureNotice-id-0001" name="Send: payment failure notice">
      <bpmn:incoming>SequenceFlow-GatewayToFailure-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FailureToRetry-id-0008</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-CustomerRetryPayment-id-0001" name="Customer Retry Payment">
      <bpmn:incoming>SequenceFlow-FailureToRetry-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RetryToProcessPayment-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ProcessPayment-id-0002" name="Process Payment">
      <bpmn:incoming>SequenceFlow-RetryToProcessPayment-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProcessPaymentToGateway2-id-0010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PaymentSuccess-id-0002" name="Payment Success?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ProcessPaymentToGateway2-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Gateway2ToSuccess-id-0011</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-Gateway2ToFailure-id-0012</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-PaymentFailed-id-0001" name="Payment Failed">
      <bpmn:incoming>SequenceFlow-Gateway2ToFailure-id-0012</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToAddItems-id-0001" sourceRef="StartEvent-CheckoutProcessInitiated-id-0001" targetRef="UserTask-AddItemsToCart-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AddItemsToValidate-id-0002" sourceRef="UserTask-AddItemsToCart-id-0001" targetRef="ServiceTask-ValidateInventory-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidateToProcessPayment-id-0003" sourceRef="ServiceTask-ValidateInventory-id-0001" targetRef="ServiceTask-ProcessPayment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProcessPaymentToGateway-id-0004" sourceRef="ServiceTask-ProcessPayment-id-0001" targetRef="ExclusiveGateway-PaymentSuccess-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToSuccess-id-0005" name="payment_success == true" sourceRef="ExclusiveGateway-PaymentSuccess-id-0001" targetRef="SendTask-SendOrderConfirmation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SuccessToEnd-id-0006" sourceRef="SendTask-SendOrderConfirmation-id-0001" targetRef="EndEvent-OrderCompleted-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToFailure-id-0007" name="payment_success == false" sourceRef="ExclusiveGateway-PaymentSuccess-id-0001" targetRef="SendTask-SendPaymentFailureNotice-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FailureToRetry-id-0008" sourceRef="SendTask-SendPaymentFailureNotice-id-0001" targetRef="UserTask-CustomerRetryPayment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RetryToProcessPayment-id-0009" sourceRef="UserTask-CustomerRetryPayment-id-0001" targetRef="ServiceTask-ProcessPayment-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ProcessPaymentToGateway2-id-0010" sourceRef="ServiceTask-ProcessPayment-id-0002" targetRef="ExclusiveGateway-PaymentSuccess-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Gateway2ToSuccess-id-0011" name="payment_success == true" sourceRef="ExclusiveGateway-PaymentSuccess-id-0002" targetRef="SendTask-SendOrderConfirmation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-Gateway2ToFailure-id-0012" name="payment_success == false" sourceRef="ExclusiveGateway-PaymentSuccess-id-0002" targetRef="EndEvent-PaymentFailed-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CheckoutProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_CheckoutProcess" bpmnElement="CheckoutProcess">
      <bpmndi:BPMNShape id="StartEvent-CheckoutProcessInitiated-id-0001_di" bpmnElement="StartEvent-CheckoutProcessInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AddItemsToCart-id-0001_di" bpmnElement="UserTask-AddItemsToCart-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ValidateInventory-id-0001_di" bpmnElement="ServiceTask-ValidateInventory-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcessPayment-id-0001_di" bpmnElement="ServiceTask-ProcessPayment-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PaymentSuccess-id-0001_di" bpmnElement="ExclusiveGateway-PaymentSuccess-id-0001" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendOrderConfirmation-id-0001_di" bpmnElement="SendTask-SendOrderConfirmation-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-OrderCompleted-id-0001_di" bpmnElement="EndEvent-OrderCompleted-id-0001">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendPaymentFailureNotice-id-0001_di" bpmnElement="SendTask-SendPaymentFailureNotice-id-0001">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CustomerRetryPayment-id-0001_di" bpmnElement="UserTask-CustomerRetryPayment-id-0001">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcessPayment-id-0002_di" bpmnElement="ServiceTask-ProcessPayment-id-0002">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PaymentSuccess-id-0002_di" bpmnElement="ExclusiveGateway-PaymentSuccess-id-0002" isMarkerVisible="true">
        <dc:Bounds x="1250" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PaymentFailed-id-0001_di" bpmnElement="EndEvent-PaymentFailed-id-0001">
        <dc:Bounds x="1407" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToAddItems-id-0001_di" bpmnElement="SequenceFlow-StartToAddItems-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AddItemsToValidate-id-0002_di" bpmnElement="SequenceFlow-AddItemsToValidate-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ValidateToProcessPayment-id-0003_di" bpmnElement="SequenceFlow-ValidateToProcessPayment-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProcessPaymentToGateway-id-0004_di" bpmnElement="SequenceFlow-ProcessPaymentToGateway-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToSuccess-id-0005_di" bpmnElement="SequenceFlow-GatewayToSuccess-id-0005">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToFailure-id-0007_di" bpmnElement="SequenceFlow-GatewayToFailure-id-0007">
        <di:waypoint x="675" y="95" />
        <di:waypoint x="675" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SuccessToEnd-id-0006_di" bpmnElement="SequenceFlow-SuccessToEnd-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FailureToRetry-id-0008_di" bpmnElement="SequenceFlow-FailureToRetry-id-0008">
        <di:waypoint x="875" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RetryToProcessPayment-id-0009_di" bpmnElement="SequenceFlow-RetryToProcessPayment-id-0009">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProcessPaymentToGateway2-id-0010_di" bpmnElement="SequenceFlow-ProcessPaymentToGateway2-id-0010">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1250" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-Gateway2ToSuccess-id-0011_di" bpmnElement="SequenceFlow-Gateway2ToSuccess-id-0011">
        <di:waypoint x="1275" y="235" />
        <di:waypoint x="1275" y="280" />
        <di:waypoint x="825" y="280" />
        <di:waypoint x="825" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-Gateway2ToFailure-id-0012_di" bpmnElement="SequenceFlow-Gateway2ToFailure-id-0012">
        <di:waypoint x="1300" y="210" />
        <di:waypoint x="1407" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
