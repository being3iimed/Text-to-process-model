<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="LoanApplicationProcess-Definitions-id-0001" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="LoanApplicationProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-LoanApplicationSubmitted-id-0001" name="Loan Application Submitted">
      <bpmn:outgoing>SequenceFlow-StartToInitialValidation-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-PerformInitialValidation-id-0001" name="Perform Initial Validation">
      <bpmn:incoming>SequenceFlow-StartToInitialValidation-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InitialValidationToGateway-id-0002</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InitialValidation-id-0001" name="Initial Validation Result?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-InitialValidationToGateway-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidationPassedToReview-id-0003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ValidationFailedToNotice-id-0004</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-ValidationFailureNotice-id-0001" name="Send: validation failure notice">
      <bpmn:incoming>SequenceFlow-ValidationFailedToNotice-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FailureNoticeToRejected-id-0005</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ApplicationRejected-id-0001" name="Application Rejected">
      <bpmn:incoming>SequenceFlow-FailureNoticeToRejected-id-0005</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-LoanOfficerReview-id-0001" name="Loan Officer Review">
      <bpmn:incoming>SequenceFlow-ValidationPassedToReview-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToDocumentsGateway-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DocumentsRequired-id-0001" name="Documents Required?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToDocumentsGateway-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentsRequiredToRequest-id-0007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-NoDocumentsToAssessment-id-0008</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-RequestAdditionalDocuments-id-0001" name="Send: request for additional documents">
      <bpmn:incoming>SequenceFlow-DocumentsRequiredToRequest-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RequestToReceiveDocuments-id-0009</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-AdditionalDocuments-id-0001" name="Receive: additional documents">
      <bpmn:incoming>SequenceFlow-RequestToReceiveDocuments-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveDocumentsToAssessment-id-0010</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="ServiceTask-RunRiskAssessment-id-0001" name="Run Risk Assessment">
      <bpmn:incoming>SequenceFlow-NoDocumentsToAssessment-id-0008</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReceiveDocumentsToAssessment-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssessmentToRiskGateway-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RiskAssessment-id-0001" name="Risk Assessment Result?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AssessmentToRiskGateway-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RiskApprovedToTerms-id-0012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-RiskRejectedToNotice-id-0013</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-LoanTermsForAcceptance-id-0001" name="Send: loan terms for acceptance">
      <bpmn:incoming>SequenceFlow-RiskApprovedToTerms-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TermsToCustomerAcceptance-id-0014</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-CustomerAcceptance-id-0001" name="Receive: customer acceptance">
      <bpmn:incoming>SequenceFlow-TermsToCustomerAcceptance-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerAcceptanceToDecision-id-0015</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CustomerDecision-id-0001" name="Customer Decision?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CustomerAcceptanceToDecision-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerAcceptedToFund-id-0016</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CustomerDeclinedToEnd-id-0017</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-FundAndDisburseLoan-id-0001" name="Fund and Disburse Loan">
      <bpmn:incoming>SequenceFlow-CustomerAcceptedToFund-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FundToFundedEnd-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-LoanFunded-id-0001" name="Loan Funded">
      <bpmn:incoming>SequenceFlow-FundToFundedEnd-id-0018</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-RejectionNotice-id-0001" name="Send: rejection notice with reason">
      <bpmn:incoming>SequenceFlow-RiskRejectedToNotice-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RejectionNoticeToRejectedEnd-id-0019</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ApplicationRejectedAfterReview-id-0001" name="Application Rejected After Review">
      <bpmn:incoming>SequenceFlow-RejectionNoticeToRejectedEnd-id-0019</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-LoanDeclinedByCustomer-id-0001" name="Loan Declined by Customer">
      <bpmn:incoming>SequenceFlow-CustomerDeclinedToEnd-id-0017</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToInitialValidation-id-0001" sourceRef="StartEvent-LoanApplicationSubmitted-id-0001" targetRef="ServiceTask-PerformInitialValidation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InitialValidationToGateway-id-0002" sourceRef="ServiceTask-PerformInitialValidation-id-0001" targetRef="ExclusiveGateway-InitialValidation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidationPassedToReview-id-0003" name="validation_passed" sourceRef="ExclusiveGateway-InitialValidation-id-0001" targetRef="UserTask-LoanOfficerReview-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidationFailedToNotice-id-0004" sourceRef="ExclusiveGateway-InitialValidation-id-0001" targetRef="SendTask-ValidationFailureNotice-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FailureNoticeToRejected-id-0005" sourceRef="SendTask-ValidationFailureNotice-id-0001" targetRef="EndEvent-ApplicationRejected-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToDocumentsGateway-id-0006" sourceRef="UserTask-LoanOfficerReview-id-0001" targetRef="ExclusiveGateway-DocumentsRequired-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DocumentsRequiredToRequest-id-0007" name="documents_required" sourceRef="ExclusiveGateway-DocumentsRequired-id-0001" targetRef="SendTask-RequestAdditionalDocuments-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NoDocumentsToAssessment-id-0008" sourceRef="ExclusiveGateway-DocumentsRequired-id-0001" targetRef="ServiceTask-RunRiskAssessment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RequestToReceiveDocuments-id-0009" sourceRef="SendTask-RequestAdditionalDocuments-id-0001" targetRef="ReceiveTask-AdditionalDocuments-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveDocumentsToAssessment-id-0010" sourceRef="ReceiveTask-AdditionalDocuments-id-0001" targetRef="ServiceTask-RunRiskAssessment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AssessmentToRiskGateway-id-0011" sourceRef="ServiceTask-RunRiskAssessment-id-0001" targetRef="ExclusiveGateway-RiskAssessment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RiskApprovedToTerms-id-0012" name="risk_approved" sourceRef="ExclusiveGateway-RiskAssessment-id-0001" targetRef="SendTask-LoanTermsForAcceptance-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RiskRejectedToNotice-id-0013" sourceRef="ExclusiveGateway-RiskAssessment-id-0001" targetRef="SendTask-RejectionNotice-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TermsToCustomerAcceptance-id-0014" sourceRef="SendTask-LoanTermsForAcceptance-id-0001" targetRef="ReceiveTask-CustomerAcceptance-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerAcceptanceToDecision-id-0015" sourceRef="ReceiveTask-CustomerAcceptance-id-0001" targetRef="ExclusiveGateway-CustomerDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerAcceptedToFund-id-0016" name="customer_accepted" sourceRef="ExclusiveGateway-CustomerDecision-id-0001" targetRef="ServiceTask-FundAndDisburseLoan-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerDeclinedToEnd-id-0017" sourceRef="ExclusiveGateway-CustomerDecision-id-0001" targetRef="EndEvent-LoanDeclinedByCustomer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FundToFundedEnd-id-0018" sourceRef="ServiceTask-FundAndDisburseLoan-id-0001" targetRef="EndEvent-LoanFunded-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RejectionNoticeToRejectedEnd-id-0019" sourceRef="SendTask-RejectionNotice-id-0001" targetRef="EndEvent-ApplicationRejectedAfterReview-id-0001" />
  </bpmn:process>
