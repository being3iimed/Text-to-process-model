<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="GradeAppealProcess-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="GradeAppealProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-GradePosted-id-0001" name="Grade posted">
      <bpmn:outgoing>SequenceFlow-StartToTimerStart-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent-AppealWindowStart-id-0002" name="Appeal window opens">
      <bpmn:incoming>SequenceFlow-StartToTimerStart-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TimerToReceiveTask-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="ReceiveTask-SubmitAppealForm-id-0001" name="Student submits grade appeal form">
      <bpmn:incoming>SequenceFlow-TimerToReceiveTask-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToProfessorReview-id-0001</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryEvent-AppealDeadline-id-0001" name="10 Day Appeal Deadline" attachedToRef="ReceiveTask-SubmitAppealForm-id-0001">
      <bpmn:outgoing>SequenceFlow-BoundaryToEnd-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-AppealDeadline-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent-AppealDeadlineMissed-id-0001" name="Appeal deadline missed">
      <bpmn:incoming>SequenceFlow-BoundaryToEnd-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-ProfessorReviewsAppeal-id-0001" name="Professor reviews appeal">
      <bpmn:incoming>SequenceFlow-ReceiveToProfessorReview-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProfessorToGateway-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-GradeDecision-id-0001" name="Grade Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ProfessorToGateway-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GradeConfirmed-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GradeAdjusted-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ProfessorResponds-id-0001" name="Professor responds to student">
      <bpmn:incoming>SequenceFlow-GradeConfirmed-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NotifyToProfessorResponse-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProfessorResponseToStudent-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-GradeConfirmed-id-0001" name="Appeal process complete - grade confirmed">
      <bpmn:outgoing>SequenceFlow-GradeConfirmedToConverge-id-0001</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-AdjustGrade-id-0001" name="Professor adjusts grade in system">
      <bpmn:incoming>SequenceFlow-GradeAdjusted-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdjustToNotify-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-NotifyRegistrar-id-0001" name="Notify registrar of grade change">
      <bpmn:incoming>SequenceFlow-AdjustToNotify-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyToProfessorResponse-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-StudentReviewsResponse-id-0001" name="Student reviews professor&#39;s response">
      <bpmn:incoming>SequenceFlow-ProfessorResponseToStudent-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StudentToDecision-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-StudentDecision-id-0001" name="Student Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StudentToDecision-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StudentAccepts-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-StudentEscalates-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-ResolutionAccepted-id-0001" name="Appeal process complete - resolution accepted">
      <bpmn:incoming>SequenceFlow-StudentAccepts-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ResolutionAcceptedToConverge-id-0001</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-ChairReviews-id-0001" name="Chair reviews escalated appeal">
      <bpmn:incoming>SequenceFlow-StudentEscalates-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ChairReviewToDetermination-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ChairDetermination-id-0001" name="Chair makes final determination">
      <bpmn:incoming>SequenceFlow-ChairReviewToDetermination-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeterminationToUpdate-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-UpdateRegistrarFinal-id-0001" name="Update registrar system with final grade">
      <bpmn:incoming>SequenceFlow-DeterminationToUpdate-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateToSend-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-FinalOutcome-id-0001" name="Send: final outcome to student">
      <bpmn:incoming>SequenceFlow-UpdateToSend-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToEnd-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ChairDecision-id-0001" name="Appeal process complete - chair decision">
      <bpmn:incoming>SequenceFlow-SendToEnd-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ChairDecisionToConverge-id-0001</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ConvergePaths-id-0001" name="Converge All Paths" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-GradeConfirmedToConverge-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ResolutionAcceptedToConverge-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ChairDecisionToConverge-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConvergeToFinalEnd-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-AppealComplete-id-0001" name="Appeal process complete">
      <bpmn:incoming>SequenceFlow-ConvergeToFinalEnd-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToTimerStart-id-0001" sourceRef="StartEvent-GradePosted-id-0001" targetRef="StartEvent-AppealWindowStart-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-TimerToReceiveTask-id-0001" sourceRef="StartEvent-AppealWindowStart-id-0002" targetRef="ReceiveTask-SubmitAppealForm-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToEnd-id-0001" sourceRef="BoundaryEvent-AppealDeadline-id-0001" targetRef="EndEvent-AppealDeadlineMissed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveToProfessorReview-id-0001" sourceRef="ReceiveTask-SubmitAppealForm-id-0001" targetRef="UserTask-ProfessorReviewsAppeal-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProfessorToGateway-id-0001" sourceRef="UserTask-ProfessorReviewsAppeal-id-0001" targetRef="ExclusiveGateway-GradeDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GradeConfirmed-id-0001" name="grade_confirmed" sourceRef="ExclusiveGateway-GradeDecision-id-0001" targetRef="UserTask-ProfessorResponds-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GradeAdjusted-id-0001" name="grade_adjusted" sourceRef="ExclusiveGateway-GradeDecision-id-0001" targetRef="ServiceTask-AdjustGrade-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AdjustToNotify-id-0001" sourceRef="ServiceTask-AdjustGrade-id-0001" targetRef="ServiceTask-NotifyRegistrar-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyToProfessorResponse-id-0001" sourceRef="ServiceTask-NotifyRegistrar-id-0001" targetRef="UserTask-ProfessorResponds-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProfessorResponseToStudent-id-0001" sourceRef="UserTask-ProfessorResponds-id-0001" targetRef="UserTask-StudentReviewsResponse-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StudentToDecision-id-0001" sourceRef="UserTask-StudentReviewsResponse-id-0001" targetRef="ExclusiveGateway-StudentDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StudentAccepts-id-0001" name="student_accepts" sourceRef="ExclusiveGateway-StudentDecision-id-0001" targetRef="EndEvent-ResolutionAccepted-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StudentEscalates-id-0001" name="student_escalates" sourceRef="ExclusiveGateway-StudentDecision-id-0001" targetRef="UserTask-ChairReviews-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ChairReviewToDetermination-id-0001" sourceRef="UserTask-ChairReviews-id-0001" targetRef="UserTask-ChairDetermination-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DeterminationToUpdate-id-0001" sourceRef="UserTask-ChairDetermination-id-0001" targetRef="ServiceTask-UpdateRegistrarFinal-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateToSend-id-0001" sourceRef="ServiceTask-UpdateRegistrarFinal-id-0001" targetRef="SendTask-FinalOutcome-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToEnd-id-0001" sourceRef="SendTask-FinalOutcome-id-0001" targetRef="EndEvent-ChairDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GradeConfirmedToConverge-id-0001" sourceRef="EndEvent-GradeConfirmed-id-0001" targetRef="ExclusiveGateway-ConvergePaths-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ResolutionAcceptedToConverge-id-0001" sourceRef="EndEvent-ResolutionAccepted-id-0001" targetRef="ExclusiveGateway-ConvergePaths-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ChairDecisionToConverge-id-0001" sourceRef="EndEvent-ChairDecision-id-0001" targetRef="ExclusiveGateway-ConvergePaths-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ConvergeToFinalEnd-id-0001" sourceRef="ExclusiveGateway-ConvergePaths-id-0001" targetRef="EndEvent-AppealComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_GradeAppealProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_GradeAppealProcess-id-0001" bpmnElement="GradeAppealProcess-id-0001">
