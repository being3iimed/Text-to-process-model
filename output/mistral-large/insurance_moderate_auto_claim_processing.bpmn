<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="claims-processing-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="ClaimsProcessing-Process-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ClaimFiled-id-0001" name="Claim Filed">
      <bpmn:outgoing>SequenceFlow-StartToAssignAgent-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-AssignClaimAgent-id-0001" name="Assign Claim Agent">
      <bpmn:incoming>SequenceFlow-StartToAssignAgent-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignAgentToContactClaimant-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ContactClaimantForDetails-id-0002" name="Contact Claimant for Details">
      <bpmn:incoming>SequenceFlow-AssignAgentToContactClaimant-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ContactClaimantToRequestDocs-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-RequestDocumentation-id-0003" name="Request Documentation">
      <bpmn:incoming>SequenceFlow-ContactClaimantToRequestDocs-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RequestDocsToReceiveDocs-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveDocumentation-id-0001" name="Receive Documentation">
      <bpmn:incoming>SequenceFlow-RequestDocsToReceiveDocs-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveDocsToDocCompleteCheck-id-0005</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DocumentationComplete-id-0001" name="Documentation Complete?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReceiveDocsToDocCompleteCheck-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocCompleteToReviewCoverage-id-0006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DocIncompleteToReject-id-0007</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ReviewDocumentationForCoverage-id-0004" name="Review Documentation for Coverage">
      <bpmn:incoming>SequenceFlow-DocCompleteToReviewCoverage-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewCoverageToCoverageCheck-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ReviewCoverageToDocCompleteMerge-id-0030</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CoverageValid-id-0002" name="Coverage Valid?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewCoverageToCoverageCheck-id-0008</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DocCompleteMergeToCoverageCheck-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CoverageValidToForwardAppraiser-id-0009</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CoverageInvalidToReject-id-0010</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ForwardClaimToAppraiser-id-0005" name="Forward Claim to Appraiser">
      <bpmn:incoming>SequenceFlow-CoverageValidToForwardAppraiser-id-0009</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CoverageValidMergeToForwardAppraiser-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ForwardAppraiserToAppraiserInspects-id-0011</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ForwardAppraiserToCoverageValidMerge-id-0031</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ClaimRejected-id-0001" name="Claim Rejected">
      <bpmn:incoming>SequenceFlow-DocIncompleteToReject-id-0007</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CoverageInvalidToReject-id-0010</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-AppraiserInspectsVehicle-id-0006" name="Appraiser Inspects Vehicle">
      <bpmn:incoming>SequenceFlow-ForwardAppraiserToAppraiserInspects-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AppraiserInspectsToReceiveReport-id-0012</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveAppraiserReport-id-0002" name="Receive Appraiser Report">
      <bpmn:incoming>SequenceFlow-AppraiserInspectsToReceiveReport-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveReportToAdjusterReview-id-0013</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="UserTask-AdjusterReviewsAppraisal-id-0007" name="Adjuster Reviews Appraisal">
      <bpmn:incoming>SequenceFlow-ReceiveReportToAdjusterReview-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdjusterReviewToCostCheck-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RepairCostWithinLimit-id-0003" name="Repair Cost Within Limit?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AdjusterReviewToCostCheck-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CostWithinLimitToSelectShop-id-0015</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CostExceedsLimitToNotifyExcess-id-0016</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-InsuredSelectsRepairShop-id-0008" name="Insured Selects Repair Shop">
      <bpmn:incoming>SequenceFlow-CostWithinLimitToSelectShop-id-0015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-RepairCostMergeToSelectShop-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectShopToSendAuthorization-id-0017</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SelectShopToRepairCostMerge-id-0032</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-SendAuthorizationToShop-id-0001" name="Send Authorization to Shop">
      <bpmn:incoming>SequenceFlow-SelectShopToSendAuthorization-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendAuthorizationToReceiveInvoice-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveInvoice-id-0003" name="Receive Invoice">
      <bpmn:incoming>SequenceFlow-SendAuthorizationToReceiveInvoice-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveInvoiceToVerifyInvoice-id-0019</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="UserTask-VerifyInvoiceAgainstEstimate-id-0009" name="Verify Invoice Against Estimate">
      <bpmn:incoming>SequenceFlow-ReceiveInvoiceToVerifyInvoice-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyInvoiceToInvoiceValidCheck-id-0020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InvoiceValid-id-0004" name="Invoice Valid?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-VerifyInvoiceToInvoiceValidCheck-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InvoiceValidToPayInvoice-id-0021</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-InvoiceInvalidToPayInvoice-id-0022</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-PayInvoice-id-0002" name="Pay Invoice">
      <bpmn:incoming>SequenceFlow-InvoiceValidToPayInvoice-id-0021</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-InvoiceInvalidToPayInvoice-id-0022</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-InvoiceValidMergeToPayInvoice-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PayInvoiceToNotifyCompletion-id-0023</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PayInvoiceToInvoiceValidMerge-id-0033</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-NotifyInsuredOfCompletion-id-0010" name="Notify Insured of Completion">
      <bpmn:incoming>SequenceFlow-PayInvoiceToNotifyCompletion-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyCompletionToClaimClosed-id-0024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ClaimClosed-id-0002" name="Claim Closed">
      <bpmn:incoming>SequenceFlow-NotifyCompletionToClaimClosed-id-0024</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NotifyExcessToClaimClosed-id-0025</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-NotifyInsuredOfExcessCost-id-0011" name="Notify Insured of Excess Cost">
      <bpmn:incoming>SequenceFlow-CostExceedsLimitToNotifyExcess-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyExcessToClaimClosed-id-0025</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DocumentationComplete-Merge-id-0005" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ReviewCoverageToDocCompleteMerge-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocCompleteMergeToCoverageCheck-id-0026</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CoverageValid-Merge-id-0006" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ForwardAppraiserToCoverageValidMerge-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CoverageValidMergeToForwardAppraiser-id-0027</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RepairCostWithinLimit-Merge-id-0007" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-SelectShopToRepairCostMerge-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RepairCostMergeToSelectShop-id-0028</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InvoiceValid-Merge-id-0008" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-PayInvoiceToInvoiceValidMerge-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InvoiceValidMergeToPayInvoice-id-0029</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow-StartToAssignAgent-id-0001" sourceRef="StartEvent-ClaimFiled-id-0001" targetRef="UserTask-AssignClaimAgent-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AssignAgentToContactClaimant-id-0002" sourceRef="UserTask-AssignClaimAgent-id-0001" targetRef="UserTask-ContactClaimantForDetails-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ContactClaimantToRequestDocs-id-0003" sourceRef="UserTask-ContactClaimantForDetails-id-0002" targetRef="UserTask-RequestDocumentation-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-RequestDocsToReceiveDocs-id-0004" sourceRef="UserTask-RequestDocumentation-id-0003" targetRef="ReceiveTask-ReceiveDocumentation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveDocsToDocCompleteCheck-id-0005" sourceRef="ReceiveTask-ReceiveDocumentation-id-0001" targetRef="ExclusiveGateway-DocumentationComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DocCompleteToReviewCoverage-id-0006" name="documentation_complete" sourceRef="ExclusiveGateway-DocumentationComplete-id-0001" targetRef="UserTask-ReviewDocumentationForCoverage-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-DocIncompleteToReject-id-0007" name="!documentation_complete" sourceRef="ExclusiveGateway-DocumentationComplete-id-0001" targetRef="EndEvent-ClaimRejected-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewCoverageToCoverageCheck-id-0008" sourceRef="UserTask-ReviewDocumentationForCoverage-id-0004" targetRef="ExclusiveGateway-CoverageValid-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CoverageValidToForwardAppraiser-id-0009" name="accident_during_policy_period AND policy_covers_damage_type" sourceRef="ExclusiveGateway-CoverageValid-id-0002" targetRef="UserTask-ForwardClaimToAppraiser-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-CoverageInvalidToReject-id-0010" name="!accident_during_policy_period OR !policy_covers_damage_type" sourceRef="ExclusiveGateway-CoverageValid-id-0002" targetRef="EndEvent-ClaimRejected-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ForwardAppraiserToAppraiserInspects-id-0011" sourceRef="UserTask-ForwardClaimToAppraiser-id-0005" targetRef="UserTask-AppraiserInspectsVehicle-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-AppraiserInspectsToReceiveReport-id-0012" sourceRef="UserTask-AppraiserInspectsVehicle-id-0006" targetRef="ReceiveTask-ReceiveAppraiserReport-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveReportToAdjusterReview-id-0013" sourceRef="ReceiveTask-ReceiveAppraiserReport-id-0002" targetRef="UserTask-AdjusterReviewsAppraisal-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-AdjusterReviewToCostCheck-id-0014" sourceRef="UserTask-AdjusterReviewsAppraisal-id-0007" targetRef="ExclusiveGateway-RepairCostWithinLimit-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CostWithinLimitToSelectShop-id-0015" name="repair_cost &#60;= policy_limit" sourceRef="ExclusiveGateway-RepairCostWithinLimit-id-0003" targetRef="UserTask-InsuredSelectsRepairShop-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-CostExceedsLimitToNotifyExcess-id-0016" name="repair_cost &#62; policy_limit" sourceRef="ExclusiveGateway-RepairCostWithinLimit-id-0003" targetRef="UserTask-NotifyInsuredOfExcessCost-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectShopToSendAuthorization-id-0017" sourceRef="UserTask-InsuredSelectsRepairShop-id-0008" targetRef="ServiceTask-SendAuthorizationToShop-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendAuthorizationToReceiveInvoice-id-0018" sourceRef="ServiceTask-SendAuthorizationToShop-id-0001" targetRef="ReceiveTask-ReceiveInvoice-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveInvoiceToVerifyInvoice-id-0019" sourceRef="ReceiveTask-ReceiveInvoice-id-0003" targetRef="UserTask-VerifyInvoiceAgainstEstimate-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyInvoiceToInvoiceValidCheck-id-0020" sourceRef="UserTask-VerifyInvoiceAgainstEstimate-id-0009" targetRef="ExclusiveGateway-InvoiceValid-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-InvoiceValidToPayInvoice-id-0021" name="invoice_matches_estimate OR variation_is_reasonable" sourceRef="ExclusiveGateway-InvoiceValid-id-0004" targetRef="ServiceTask-PayInvoice-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-InvoiceInvalidToPayInvoice-id-0022" name="!invoice_matches_estimate AND !variation_is_reasonable" sourceRef="ExclusiveGateway-InvoiceValid-id-0004" targetRef="ServiceTask-PayInvoice-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-PayInvoiceToNotifyCompletion-id-0023" sourceRef="ServiceTask-PayInvoice-id-0002" targetRef="UserTask-NotifyInsuredOfCompletion-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyCompletionToClaimClosed-id-0024" sourceRef="UserTask-NotifyInsuredOfCompletion-id-0010" targetRef="EndEvent-ClaimClosed-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyExcessToClaimClosed-id-0025" sourceRef="UserTask-NotifyInsuredOfExcessCost-id-0011" targetRef="EndEvent-ClaimClosed-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DocCompleteMergeToCoverageCheck-id-0026" sourceRef="ExclusiveGateway-DocumentationComplete-Merge-id-0005" targetRef="ExclusiveGateway-CoverageValid-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CoverageValidMergeToForwardAppraiser-id-0027" sourceRef="ExclusiveGateway-CoverageValid-Merge-id-0006" targetRef="UserTask-ForwardClaimToAppraiser-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-RepairCostMergeToSelectShop-id-0028" sourceRef="ExclusiveGateway-RepairCostWithinLimit-Merge-id-0007" targetRef="UserTask-InsuredSelectsRepairShop-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-InvoiceValidMergeToPayInvoice-id-0029" sourceRef="ExclusiveGateway-InvoiceValid-Merge-id-0008" targetRef="ServiceTask-PayInvoice-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewCoverageToDocCompleteMerge-id-0030" sourceRef="UserTask-ReviewDocumentationForCoverage-id-0004" targetRef="ExclusiveGateway-DocumentationComplete-Merge-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ForwardAppraiserToCoverageValidMerge-id-0031" sourceRef="UserTask-ForwardClaimToAppraiser-id-0005" targetRef="ExclusiveGateway-CoverageValid-Merge-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectShopToRepairCostMerge-id-0032" sourceRef="UserTask-InsuredSelectsRepairShop-id-0008" targetRef="ExclusiveGateway-RepairCostWithinLimit-Merge-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-PayInvoiceToInvoiceValidMerge-id-0033" sourceRef="ServiceTask-PayInvoice-id-0002" targetRef="ExclusiveGateway-InvoiceValid-Merge-id-0008" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ClaimsProcessing-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_ClaimsProcessing-Process-id-0001" bpmnElement="ClaimsProcessing-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-ClaimFiled-id-0001_di" bpmnElement="StartEvent-ClaimFiled-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AssignClaimAgent-id-0001_di" bpmnElement="UserTask-AssignClaimAgent-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ContactClaimantForDetails-id-0002_di" bpmnElement="UserTask-ContactClaimantForDetails-id-0002">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-RequestDocumentation-id-0003_di" bpmnElement="UserTask-RequestDocumentation-id-0003">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveDocumentation-id-0001_di" bpmnElement="ReceiveTask-ReceiveDocumentation-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-DocumentationComplete-id-0001_di" bpmnElement="ExclusiveGateway-DocumentationComplete-id-0001" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewDocumentationForCoverage-id-0004_di" bpmnElement="UserTask-ReviewDocumentationForCoverage-id-0004">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-CoverageValid-id-0002_di" bpmnElement="ExclusiveGateway-CoverageValid-id-0002" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ForwardClaimToAppraiser-id-0005_di" bpmnElement="UserTask-ForwardClaimToAppraiser-id-0005">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AppraiserInspectsVehicle-id-0006_di" bpmnElement="UserTask-AppraiserInspectsVehicle-id-0006">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveAppraiserReport-id-0002_di" bpmnElement="ReceiveTask-ReceiveAppraiserReport-id-0002">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AdjusterReviewsAppraisal-id-0007_di" bpmnElement="UserTask-AdjusterReviewsAppraisal-id-0007">
        <dc:Bounds x="1825" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-RepairCostWithinLimit-id-0003_di" bpmnElement="ExclusiveGateway-RepairCostWithinLimit-id-0003" isMarkerVisible="true">
        <dc:Bounds x="2000" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-InsuredSelectsRepairShop-id-0008_di" bpmnElement="UserTask-InsuredSelectsRepairShop-id-0008">
        <dc:Bounds x="2125" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SendAuthorizationToShop-id-0001_di" bpmnElement="ServiceTask-SendAuthorizationToShop-id-0001">
        <dc:Bounds x="2275" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveInvoice-id-0003_di" bpmnElement="ReceiveTask-ReceiveInvoice-id-0003">
        <dc:Bounds x="2425" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-VerifyInvoiceAgainstEstimate-id-0009_di" bpmnElement="UserTask-VerifyInvoiceAgainstEstimate-id-0009">
        <dc:Bounds x="2575" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-InvoiceValid-id-0004_di" bpmnElement="ExclusiveGateway-InvoiceValid-id-0004" isMarkerVisible="true">
        <dc:Bounds x="2750" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PayInvoice-id-0002_di" bpmnElement="ServiceTask-PayInvoice-id-0002">
        <dc:Bounds x="2875" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-NotifyInsuredOfCompletion-id-0010_di" bpmnElement="UserTask-NotifyInsuredOfCompletion-id-0010">
        <dc:Bounds x="3025" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ClaimClosed-id-0002_di" bpmnElement="EndEvent-ClaimClosed-id-0002">
        <dc:Bounds x="3207" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-DocumentationComplete-Merge-id-0005_di" bpmnElement="ExclusiveGateway-DocumentationComplete-Merge-id-0005" isMarkerVisible="true">
        <dc:Bounds x="1100" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ClaimRejected-id-0001_di" bpmnElement="EndEvent-ClaimRejected-id-0001">
        <dc:Bounds x="1407" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-CoverageValid-Merge-id-0006_di" bpmnElement="ExclusiveGateway-CoverageValid-Merge-id-0006" isMarkerVisible="true">
        <dc:Bounds x="1550" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-NotifyInsuredOfExcessCost-id-0011_di" bpmnElement="UserTask-NotifyInsuredOfExcessCost-id-0011">
        <dc:Bounds x="2125" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-RepairCostWithinLimit-Merge-id-0007_di" bpmnElement="ExclusiveGateway-RepairCostWithinLimit-Merge-id-0007" isMarkerVisible="true">
        <dc:Bounds x="2300" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-InvoiceValid-Merge-id-0008_di" bpmnElement="ExclusiveGateway-InvoiceValid-Merge-id-0008" isMarkerVisible="true">
        <dc:Bounds x="3050" y="185" width="50" height="50" />
