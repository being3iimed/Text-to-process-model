{
  "$type": "bpmn:Definitions",
  "id": "Definitions_CustomChainsawProduction",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "BPMN Modeler",
  "exporterVersion": "1.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Process_CustomChainsawProduction",
      "name": "Custom Chainsaw Production",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-OrderReceived-id-0001",
          "name": "Custom Chainsaw Order Received"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CollectRequirements-id-0001",
          "name": "Collect Customer Requirements"
        },
        {
          "$type": "bpmn:SubProcess",
          "id": "SubProcess-ParallelPartsOrdering-id-0001",
          "name": "Parallel Parts Ordering",
          "flowElements": [
            {
              "$type": "bpmn:StartEvent",
              "id": "StartEvent-OrderingInitiated-id-0001",
              "name": "Ordering Initiated"
            },
            {
              "$type": "bpmn:ParallelGateway",
              "id": "ParallelGateway-Split-id-0001",
              "name": "Parallel Ordering",
              "gatewayDirection": "Diverging"
            },
            {
              "$type": "bpmn:ServiceTask",
              "id": "ServiceTask-OrderSupplierA-id-0001",
              "name": "Order Parts from Supplier A"
            },
            {
              "$type": "bpmn:ServiceTask",
              "id": "ServiceTask-OrderSupplierB-id-0002",
              "name": "Order Parts from Supplier B"
            },
            {
              "$type": "bpmn:ServiceTask",
              "id": "ServiceTask-OrderSupplierC-id-0003",
              "name": "Order Parts from Supplier C"
            },
            {
              "$type": "bpmn:ParallelGateway",
              "id": "ParallelGateway-Join-id-0002",
              "name": "Synchronize Orders",
              "gatewayDirection": "Converging"
            },
            {
              "$type": "bpmn:EndEvent",
              "id": "EndEvent-PartsOrdered-id-0001",
              "name": "All Parts Ordered"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-StartToSplit-id-0001",
              "sourceRef": "StartEvent-OrderingInitiated-id-0001",
              "targetRef": "ParallelGateway-Split-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SplitToSupplierA-id-0002",
              "sourceRef": "ParallelGateway-Split-id-0001",
              "targetRef": "ServiceTask-OrderSupplierA-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SplitToSupplierB-id-0003",
              "sourceRef": "ParallelGateway-Split-id-0001",
              "targetRef": "ServiceTask-OrderSupplierB-id-0002"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SplitToSupplierC-id-0004",
              "sourceRef": "ParallelGateway-Split-id-0001",
              "targetRef": "ServiceTask-OrderSupplierC-id-0003"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SupplierAToJoin-id-0005",
              "sourceRef": "ServiceTask-OrderSupplierA-id-0001",
              "targetRef": "ParallelGateway-Join-id-0002"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SupplierBToJoin-id-0006",
              "sourceRef": "ServiceTask-OrderSupplierB-id-0002",
              "targetRef": "ParallelGateway-Join-id-0002"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SupplierCToJoin-id-0007",
              "sourceRef": "ServiceTask-OrderSupplierC-id-0003",
              "targetRef": "ParallelGateway-Join-id-0002"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-JoinToEnd-id-0008",
              "sourceRef": "ParallelGateway-Join-id-0002",
              "targetRef": "EndEvent-PartsOrdered-id-0001"
            }
          ]
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-InspectParts-id-0002",
          "name": "Inspect Received Parts"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-AssembleChainsaw-id-0003",
          "name": "Assemble Chainsaw"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-ProductionUpdate-id-0001",
          "name": "Send: Production Update to Customer"
        },
        {
          "$type": "bpmn:SubProcess",
          "id": "SubProcess-CustomerApproval-id-0001",
          "name": "Customer Approval Cycle",
          "flowElements": [
            {
              "$type": "bpmn:StartEvent",
              "id": "StartEvent-ApprovalStarted-id-0001",
              "name": "Approval Process Started"
            },
            {
              "$type": "bpmn:SendTask",
              "id": "SendTask-SendSample-id-0001",
              "name": "Send: First Chainsaw for Approval"
            },
            {
              "$type": "bpmn:ReceiveTask",
              "id": "ReceiveTask-CustomerApproval-id-0001",
              "name": "Receive: Customer Approval"
            },
            {
              "$type": "bpmn:ExclusiveGateway",
              "id": "ExclusiveGateway-ApprovalDecision-id-0001",
              "name": "Approval Decision",
              "gatewayDirection": "Diverging"
            },
            {
              "$type": "bpmn:ServiceTask",
              "id": "ServiceTask-ProduceBatch-id-0001",
              "name": "Produce Remaining Chainsaws"
            },
            {
              "$type": "bpmn:EndEvent",
              "id": "EndEvent-BatchComplete-id-0001",
              "name": "Batch Production Complete"
            },
            {
              "$type": "bpmn:EndEvent",
              "id": "EndEvent-OrderCancelled-id-0002",
              "name": "Order Cancelled"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-StartToSendSample-id-0001",
              "sourceRef": "StartEvent-ApprovalStarted-id-0001",
              "targetRef": "SendTask-SendSample-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-SendToReceive-id-0002",
              "sourceRef": "SendTask-SendSample-id-0001",
              "targetRef": "ReceiveTask-CustomerApproval-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-ReceiveToGateway-id-0003",
              "sourceRef": "ReceiveTask-CustomerApproval-id-0001",
              "targetRef": "ExclusiveGateway-ApprovalDecision-id-0001"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-GatewayToProduce-id-0004",
              "name": "customer_approved == true",
              "sourceRef": "ExclusiveGateway-ApprovalDecision-id-0001",
              "targetRef": "ServiceTask-ProduceBatch-id-0001",
              "isDefault": false
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-GatewayToCancel-id-0005",
              "name": "customer_approved == false (default)",
              "sourceRef": "ExclusiveGateway-ApprovalDecision-id-0001",
              "targetRef": "EndEvent-OrderCancelled-id-0002",
              "isDefault": true
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-ProduceToEnd-id-0006",
              "sourceRef": "ServiceTask-ProduceBatch-id-0001",
              "targetRef": "EndEvent-BatchComplete-id-0001"
            }
          ]
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-OrderFulfilled-id-0001",
          "name": "Order Fulfilled"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToCollectReq-id-0001",
          "sourceRef": "StartEvent-OrderReceived-id-0001",
          "targetRef": "UserTask-CollectRequirements-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CollectToOrdering-id-0002",
          "sourceRef": "UserTask-CollectRequirements-id-0001",
          "targetRef": "SubProcess-ParallelPartsOrdering-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-OrderingToInspect-id-0003",
          "sourceRef": "SubProcess-ParallelPartsOrdering-id-0001",
          "targetRef": "UserTask-InspectParts-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-InspectToAssemble-id-0004",
          "sourceRef": "UserTask-InspectParts-id-0002",
          "targetRef": "UserTask-AssembleChainsaw-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AssembleToUpdate-id-0005",
          "sourceRef": "UserTask-AssembleChainsaw-id-0003",
          "targetRef": "SendTask-ProductionUpdate-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-UpdateToApproval-id-0006",
          "sourceRef": "SendTask-ProductionUpdate-id-0001",
          "targetRef": "SubProcess-CustomerApproval-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ApprovalToFulfilled-id-0007",
          "sourceRef": "SubProcess-CustomerApproval-id-0001",
          "targetRef": "EndEvent-OrderFulfilled-id-0001"
        }
      ]
    }
  ]
}