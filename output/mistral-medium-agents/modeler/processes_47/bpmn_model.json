{
  "$type": "bpmn:Definitions",
  "id": "CourseRegistrationDefinitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "BPMN Modeler",
  "exporterVersion": "1.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "CourseRegistrationProcess",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-StartCourseRegistration-id-0001",
          "name": "Start Course Registration"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-SelectCourse-id-0001",
          "name": "Select Course"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CheckCourseSlots-id-0001",
          "name": "Check Course Slots"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-SlotsAvailable-id-0001",
          "name": "Slots Available?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-NoSlots-id-0001",
          "name": "Registration Rejected: No Slots"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CheckExistingAccount-id-0001",
          "name": "Check Existing Account"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-AccountExists-id-0001",
          "name": "Account Exists?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-LogIntoAccount-id-0001",
          "name": "Log Into Account"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CheckUniversityEligibility-id-0001",
          "name": "Check University Eligibility"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-UniversityEligible-id-0001",
          "name": "University Eligible?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-Ineligible-id-0001",
          "name": "Registration Rejected: Ineligible"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-RegisterAccount-id-0001",
          "name": "Register Account"
        },
        {
          "$type": "bpmn:ReceiveTask",
          "id": "ReceiveTask-AccountActivation-id-0001",
          "name": "Receive: Account Activation"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-LogIntoAccountAfterActivation-id-0001",
          "name": "Log Into Account"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-AccountExists-id-0002",
          "name": "Account Exists?",
          "gatewayDirection": "Converging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-OptInTweetToFriends-id-0001",
          "name": "Opt-In: Tweet to Friends"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-TweetDecision-id-0001",
          "name": "Tweet Decision",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CompleteCourseRegistration-id-0001",
          "name": "Complete Course Registration"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-ProvidePaymentInformation-id-0001",
          "name": "Provide Payment Information"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-GenerateCourseTicket-id-0001",
          "name": "Generate Course Ticket"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-CourseTicketIssued-id-0001",
          "name": "Course Ticket Issued"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-TweetDecision-id-0002",
          "name": "Tweet Decision",
          "gatewayDirection": "Converging"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToSelectCourse-id-0001",
          "sourceRef": "StartEvent-StartCourseRegistration-id-0001",
          "targetRef": "UserTask-SelectCourse-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SelectCourseToCheckSlots-id-0001",
          "sourceRef": "UserTask-SelectCourse-id-0001",
          "targetRef": "ServiceTask-CheckCourseSlots-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CheckSlotsToSlotsAvailable-id-0001",
          "sourceRef": "ServiceTask-CheckCourseSlots-id-0001",
          "targetRef": "ExclusiveGateway-SlotsAvailable-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SlotsAvailableToNoSlots-id-0001",
          "sourceRef": "ExclusiveGateway-SlotsAvailable-id-0001",
          "targetRef": "EndEvent-NoSlots-id-0001",
          "name": "slots_available == false",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SlotsAvailableToCheckAccount-id-0001",
          "sourceRef": "ExclusiveGateway-SlotsAvailable-id-0001",
          "targetRef": "ServiceTask-CheckExistingAccount-id-0001",
          "name": "slots_available == true",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CheckAccountToAccountExists-id-0001",
          "sourceRef": "ServiceTask-CheckExistingAccount-id-0001",
          "targetRef": "ExclusiveGateway-AccountExists-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AccountExistsToLogin-id-0001",
          "sourceRef": "ExclusiveGateway-AccountExists-id-0001",
          "targetRef": "UserTask-LogIntoAccount-id-0001",
          "name": "account_exists == true",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AccountExistsToCheckEligibility-id-0001",
          "sourceRef": "ExclusiveGateway-AccountExists-id-0001",
          "targetRef": "ServiceTask-CheckUniversityEligibility-id-0001",
          "name": "account_exists == false",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CheckEligibilityToEligible-id-0001",
          "sourceRef": "ServiceTask-CheckUniversityEligibility-id-0001",
          "targetRef": "ExclusiveGateway-UniversityEligible-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-EligibleToRegisterAccount-id-0001",
          "sourceRef": "ExclusiveGateway-UniversityEligible-id-0001",
          "targetRef": "UserTask-RegisterAccount-id-0001",
          "name": "university_eligible == true",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-EligibleToIneligible-id-0001",
          "sourceRef": "ExclusiveGateway-UniversityEligible-id-0001",
          "targetRef": "EndEvent-Ineligible-id-0001",
          "name": "university_eligible == false",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-RegisterAccountToActivation-id-0001",
          "sourceRef": "UserTask-RegisterAccount-id-0001",
          "targetRef": "ReceiveTask-AccountActivation-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ActivationToLogin-id-0001",
          "sourceRef": "ReceiveTask-AccountActivation-id-0001",
          "targetRef": "UserTask-LogIntoAccountAfterActivation-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-LoginToAccountExistsConverge-id-0001",
          "sourceRef": "UserTask-LogIntoAccount-id-0001",
          "targetRef": "ExclusiveGateway-AccountExists-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-LoginAfterActivationToAccountExistsConverge-id-0001",
          "sourceRef": "UserTask-LogIntoAccountAfterActivation-id-0001",
          "targetRef": "ExclusiveGateway-AccountExists-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AccountExistsConvergeToTweet-id-0001",
          "sourceRef": "ExclusiveGateway-AccountExists-id-0002",
          "targetRef": "UserTask-OptInTweetToFriends-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-TweetToTweetDecision-id-0001",
          "sourceRef": "UserTask-OptInTweetToFriends-id-0001",
          "targetRef": "ExclusiveGateway-TweetDecision-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-TweetDecisionToCompleteRegistration-id-0001",
          "sourceRef": "ExclusiveGateway-TweetDecision-id-0001",
          "targetRef": "ServiceTask-CompleteCourseRegistration-id-0001",
          "name": "tweet == true",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-TweetDecisionToCompleteRegistration-id-0002",
          "sourceRef": "ExclusiveGateway-TweetDecision-id-0001",
          "targetRef": "ServiceTask-CompleteCourseRegistration-id-0001",
          "name": "tweet == false",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CompleteRegistrationToPayment-id-0001",
          "sourceRef": "ServiceTask-CompleteCourseRegistration-id-0001",
          "targetRef": "UserTask-ProvidePaymentInformation-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-PaymentToGenerateTicket-id-0001",
          "sourceRef": "UserTask-ProvidePaymentInformation-id-0001",
          "targetRef": "ServiceTask-GenerateCourseTicket-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GenerateTicketToEnd-id-0001",
          "sourceRef": "ServiceTask-GenerateCourseTicket-id-0001",
          "targetRef": "EndEvent-CourseTicketIssued-id-0001"
        }
      ]
    }
  ]
}