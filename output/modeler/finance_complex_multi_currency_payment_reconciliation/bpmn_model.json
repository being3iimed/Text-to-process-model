{
  "$type": "bpmn:Definitions",
  "id": "PaymentProcessing-definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "PaymentProcessing-Process-id-0001",
      "name": "Payment Processing",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-ProcessBegins-id-0001",
          "name": "Process Begins"
        },
        {
          "$type": "bpmn:ReceiveTask",
          "id": "ReceiveTask-ReceiveDailyPayments-id-0002",
          "name": "Receive: daily payments"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ConvertToBaseCurrency-id-0003",
          "name": "Convert to base currency"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-MatchToInvoices-id-0004",
          "name": "Match to outstanding invoices"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-PaymentMatch-id-0005",
          "name": "Payment Match",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-RecordCompletePayment-id-0006",
          "name": "Record complete payment"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-MarkPartiallyPaid-id-0007",
          "name": "Mark invoice as partially paid"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-RecordOverpayment-id-0008",
          "name": "Record overpayment as credit"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-HoldUnmatched-id-0009",
          "name": "Hold payment as unmatched"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-AccountingInvestigates-id-0010",
          "name": "Accounting team investigates"
        },
        {
          "$type": "bpmn:ParallelGateway",
          "id": "ParallelGateway-Split-id-0011",
          "name": "Parallel Execution",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-UpdateAgingReport-id-0012",
          "name": "Update accounts receivable aging report"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-TriggerFollowUp-id-0013",
          "name": "Trigger automatic follow-up for overdue invoices"
        },
        {
          "$type": "bpmn:ParallelGateway",
          "id": "ParallelGateway-Join-id-0014",
          "name": "Synchronize Branches",
          "gatewayDirection": "Converging"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProcessComplete-id-0015",
          "name": "Process Complete"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToReceive-id-0016",
          "sourceRef": "StartEvent-ProcessBegins-id-0001",
          "targetRef": "ReceiveTask-ReceiveDailyPayments-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReceiveToConvert-id-0017",
          "sourceRef": "ReceiveTask-ReceiveDailyPayments-id-0002",
          "targetRef": "ServiceTask-ConvertToBaseCurrency-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ConvertToMatch-id-0018",
          "sourceRef": "ServiceTask-ConvertToBaseCurrency-id-0003",
          "targetRef": "ServiceTask-MatchToInvoices-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-MatchToGateway-id-0019",
          "sourceRef": "ServiceTask-MatchToInvoices-id-0004",
          "targetRef": "ExclusiveGateway-PaymentMatch-id-0005"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToComplete-id-0020",
          "name": "payment matches invoice exactly",
          "sourceRef": "ExclusiveGateway-PaymentMatch-id-0005",
          "targetRef": "ServiceTask-RecordCompletePayment-id-0006",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToPartial-id-0021",
          "name": "payment less than invoice",
          "sourceRef": "ExclusiveGateway-PaymentMatch-id-0005",
          "targetRef": "ServiceTask-MarkPartiallyPaid-id-0007",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToOverpayment-id-0022",
          "name": "payment more than invoice",
          "sourceRef": "ExclusiveGateway-PaymentMatch-id-0005",
          "targetRef": "ServiceTask-RecordOverpayment-id-0008",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToUnmatched-id-0023",
          "name": "no matching invoice",
          "sourceRef": "ExclusiveGateway-PaymentMatch-id-0005",
          "targetRef": "ServiceTask-HoldUnmatched-id-0009",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-UnmatchedToInvestigate-id-0024",
          "sourceRef": "ServiceTask-HoldUnmatched-id-0009",
          "targetRef": "UserTask-AccountingInvestigates-id-0010"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CompleteToParallel-id-0025",
          "sourceRef": "ServiceTask-RecordCompletePayment-id-0006",
          "targetRef": "ParallelGateway-Split-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-PartialToParallel-id-0026",
          "sourceRef": "ServiceTask-MarkPartiallyPaid-id-0007",
          "targetRef": "ParallelGateway-Split-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-OverpaymentToParallel-id-0027",
          "sourceRef": "ServiceTask-RecordOverpayment-id-0008",
          "targetRef": "ParallelGateway-Split-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-InvestigateToParallel-id-0028",
          "sourceRef": "UserTask-AccountingInvestigates-id-0010",
          "targetRef": "ParallelGateway-Split-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ParallelToUpdate-id-0029",
          "sourceRef": "ParallelGateway-Split-id-0011",
          "targetRef": "ServiceTask-UpdateAgingReport-id-0012"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ParallelToTrigger-id-0030",
          "sourceRef": "ParallelGateway-Split-id-0011",
          "targetRef": "ServiceTask-TriggerFollowUp-id-0013"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-UpdateToJoin-id-0031",
          "sourceRef": "ServiceTask-UpdateAgingReport-id-0012",
          "targetRef": "ParallelGateway-Join-id-0014"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-TriggerToJoin-id-0032",
          "sourceRef": "ServiceTask-TriggerFollowUp-id-0013",
          "targetRef": "ParallelGateway-Join-id-0014"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-JoinToEnd-id-0033",
          "sourceRef": "ParallelGateway-Join-id-0014",
          "targetRef": "EndEvent-ProcessComplete-id-0015"
        }
      ]
    }
  ]
}