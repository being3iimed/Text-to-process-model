{
  "$type": "bpmn:Definitions",
  "id": "ticket-categorization-definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Ticket-Categorization-Process-id-0001",
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-TicketReceived-id-0001",
          "name": "Ticket Received"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CategorizeTicket-id-0002",
          "name": "Categorize ticket by urgency and complexity"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-TicketPriority-id-0003",
          "name": "Ticket Priority Check",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-SeniorResolve-id-0004",
          "name": "Senior agent reviews and resolves ticket"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-SeniorReview-id-0005",
          "name": "Senior agent reviews ticket"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-JuniorResolve-id-0006",
          "name": "Junior agent resolves ticket"
        },
        {
          "$type": "bpmn:BoundaryEvent",
          "id": "BoundaryEvent-Timer4Hour-SeniorResolve-id-0007",
          "name": "4 Hour Timeout",
          "attachedToRef": "UserTask-SeniorResolve-id-0004",
          "cancelActivity": true,
          "eventDefinitions": [
            {
              "$type": "bpmn:TimerEventDefinition",
              "timeDuration": "PT4H"
            }
          ]
        },
        {
          "$type": "bpmn:BoundaryEvent",
          "id": "BoundaryEvent-Timer2Hour-SeniorReview-id-0008",
          "name": "2 Hour Timeout",
          "attachedToRef": "UserTask-SeniorReview-id-0005",
          "cancelActivity": true,
          "eventDefinitions": [
            {
              "$type": "bpmn:TimerEventDefinition",
              "timeDuration": "PT2H"
            }
          ]
        },
        {
          "$type": "bpmn:BoundaryEvent",
          "id": "BoundaryEvent-Timer1Hour-JuniorResolve-id-0009",
          "name": "1 Hour Timeout",
          "attachedToRef": "UserTask-JuniorResolve-id-0006",
          "cancelActivity": true,
          "eventDefinitions": [
            {
              "$type": "bpmn:TimerEventDefinition",
              "timeDuration": "PT1H"
            }
          ]
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-EscalateManager-id-0010",
          "name": "Send: escalation to manager"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-TicketResolved-id-0011",
          "name": "Ticket Resolved"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-UpdateStatus-id-0012",
          "name": "Update ticket status to closed"
        },
        {
          "$type": "bpmn:ReceiveTask",
          "id": "ReceiveTask-CustomerFeedback-id-0013",
          "name": "Receive: customer satisfaction confirmation"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProcessComplete-id-0014",
          "name": "Process Complete"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToCategorize-id-0015",
          "sourceRef": "StartEvent-TicketReceived-id-0001",
          "targetRef": "ServiceTask-CategorizeTicket-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CategorizeToGateway-id-0016",
          "sourceRef": "ServiceTask-CategorizeTicket-id-0002",
          "targetRef": "ExclusiveGateway-TicketPriority-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToSeniorResolve-id-0017",
          "name": "ticket_urgency == \"high\" AND ticket_complexity == \"high\"",
          "sourceRef": "ExclusiveGateway-TicketPriority-id-0003",
          "targetRef": "UserTask-SeniorResolve-id-0004",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToSeniorReview-id-0018",
          "name": "ticket_urgency == \"high\" OR ticket_complexity == \"high\"",
          "sourceRef": "ExclusiveGateway-TicketPriority-id-0003",
          "targetRef": "UserTask-SeniorReview-id-0005",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToJuniorResolve-id-0019",
          "name": "",
          "sourceRef": "ExclusiveGateway-TicketPriority-id-0003",
          "targetRef": "UserTask-JuniorResolve-id-0006",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SeniorResolveToResolved-id-0020",
          "sourceRef": "UserTask-SeniorResolve-id-0004",
          "targetRef": "EndEvent-TicketResolved-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SeniorReviewToResolved-id-0021",
          "sourceRef": "UserTask-SeniorReview-id-0005",
          "targetRef": "EndEvent-TicketResolved-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-JuniorResolveToResolved-id-0022",
          "sourceRef": "UserTask-JuniorResolve-id-0006",
          "targetRef": "EndEvent-TicketResolved-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-BoundaryToEscalateManager-id-0023",
          "sourceRef": "BoundaryEvent-Timer4Hour-SeniorResolve-id-0007",
          "targetRef": "SendTask-EscalateManager-id-0010"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-EscalateToResolved-id-0024",
          "sourceRef": "SendTask-EscalateManager-id-0010",
          "targetRef": "EndEvent-TicketResolved-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-BoundaryToEscalateManager-id-0025",
          "sourceRef": "BoundaryEvent-Timer2Hour-SeniorReview-id-0008",
          "targetRef": "SendTask-EscalateManager-id-0010"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-BoundaryToEscalateSenior-id-0026",
          "sourceRef": "BoundaryEvent-Timer1Hour-JuniorResolve-id-0009",
          "targetRef": "UserTask-SeniorReview-id-0005"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ResolvedToUpdateStatus-id-0027",
          "sourceRef": "EndEvent-TicketResolved-id-0011",
          "targetRef": "ServiceTask-UpdateStatus-id-0012"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-UpdateToFeedback-id-0028",
          "sourceRef": "ServiceTask-UpdateStatus-id-0012",
          "targetRef": "ReceiveTask-CustomerFeedback-id-0013"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-FeedbackToComplete-id-0029",
          "sourceRef": "ReceiveTask-CustomerFeedback-id-0013",
          "targetRef": "EndEvent-ProcessComplete-id-0014"
        }
      ]
    }
  ]
}