{
  "$type": "bpmn:Definitions",
  "id": "Facility-Maintenance-Process",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Facility-Maintenance-Process-id-0001",
      "name": "Facility Maintenance Process",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-FacilityMaintenanceProcessStarts-id-0001",
          "name": "Facility Maintenance Process Starts"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-IdentifyMaintenanceNeeds-id-0002",
          "name": "Identify maintenance needs through routine inspections"
        },
        {
          "$type": "bpmn:ScriptTask",
          "id": "ScriptTask-PrioritizeTasks-id-0003",
          "name": "Computation: prioritize tasks based on urgency and resource availability"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CreateWorkOrders-id-0004",
          "name": "Create work orders and assign to technicians"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-TechniciansCompleteWork-id-0005",
          "name": "Technicians complete work according to standards"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-VerifyIssueResolution-id-0006",
          "name": "Verify issue resolution through inspections"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-UpdateMaintenanceRecords-id-0007",
          "name": "Update maintenance records in facility management system"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-MaintenanceCycleComplete-id-0008",
          "name": "Maintenance Cycle Complete"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToIdentify-id-0009",
          "sourceRef": "StartEvent-FacilityMaintenanceProcessStarts-id-0001",
          "targetRef": "ServiceTask-IdentifyMaintenanceNeeds-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-IdentifyToPrioritize-id-0010",
          "sourceRef": "ServiceTask-IdentifyMaintenanceNeeds-id-0002",
          "targetRef": "ScriptTask-PrioritizeTasks-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-PrioritizeToCreate-id-0011",
          "sourceRef": "ScriptTask-PrioritizeTasks-id-0003",
          "targetRef": "ServiceTask-CreateWorkOrders-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CreateToTechnicians-id-0012",
          "sourceRef": "ServiceTask-CreateWorkOrders-id-0004",
          "targetRef": "ServiceTask-TechniciansCompleteWork-id-0005"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-TechniciansToVerify-id-0013",
          "sourceRef": "ServiceTask-TechniciansCompleteWork-id-0005",
          "targetRef": "ServiceTask-VerifyIssueResolution-id-0006"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-VerifyToUpdate-id-0014",
          "sourceRef": "ServiceTask-VerifyIssueResolution-id-0006",
          "targetRef": "ServiceTask-UpdateMaintenanceRecords-id-0007"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-UpdateToEnd-id-0015",
          "sourceRef": "ServiceTask-UpdateMaintenanceRecords-id-0007",
          "targetRef": "EndEvent-MaintenanceCycleComplete-id-0008"
        }
      ]
    }
  ]
