{
  "$type": "bpmn:Definitions",
  "id": "Production-Process-Definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Production-Process-id-0001",
      "name": "Production Process",
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-ProcessBegins-id-0001",
          "name": "Process Begins"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-ProductionManagerCreatesWorkOrder-id-0002",
          "name": "Production Manager Creates Work Order"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-PullBillOfMaterials-id-0003",
          "name": "Pull Bill of Materials (BOM)"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ReserveRawMaterials-id-0004",
          "name": "Reserve Raw Materials from Inventory"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-ScheduleProductionLine-id-0005",
          "name": "Schedule Production Line"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ManufactureComponents-id-0006",
          "name": "Manufacture Components According to Specifications"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-PerformQualityCheck-id-0007",
          "name": "Perform Quality Check"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-QualityCheckResult-id-0008",
          "name": "Quality Check Result",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-MoveProductToFinishedGoods-id-0009",
          "name": "Move Product to Finished Goods"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ScrapDefectiveProduct-id-0010",
          "name": "Scrap Defective Product"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-LogWaste-id-0011",
          "name": "Log Waste"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProcessComplete-id-0012",
          "name": "Process Complete"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToCreateWorkOrder-id-0013",
          "sourceRef": "StartEvent-ProcessBegins-id-0001",
          "targetRef": "UserTask-ProductionManagerCreatesWorkOrder-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CreateWorkOrderToPullBOM-id-0014",
          "sourceRef": "UserTask-ProductionManagerCreatesWorkOrder-id-0002",
          "targetRef": "ServiceTask-PullBillOfMaterials-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-PullBOMToReserveMaterials-id-0015",
          "sourceRef": "ServiceTask-PullBillOfMaterials-id-0003",
          "targetRef": "ServiceTask-ReserveRawMaterials-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReserveMaterialsToScheduleLine-id-0016",
          "sourceRef": "ServiceTask-ReserveRawMaterials-id-0004",
          "targetRef": "UserTask-ScheduleProductionLine-id-0005"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ScheduleLineToManufacture-id-0017",
          "sourceRef": "UserTask-ScheduleProductionLine-id-0005",
          "targetRef": "ServiceTask-ManufactureComponents-id-0006"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ManufactureToQualityCheck-id-0018",
          "sourceRef": "ServiceTask-ManufactureComponents-id-0006",
          "targetRef": "UserTask-PerformQualityCheck-id-0007"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-QualityCheckToGateway-id-0019",
          "sourceRef": "UserTask-PerformQualityCheck-id-0007",
          "targetRef": "ExclusiveGateway-QualityCheckResult-id-0008"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToMoveProduct-id-0020",
          "name": "quality_check_passes",
          "sourceRef": "ExclusiveGateway-QualityCheckResult-id-0008",
          "targetRef": "ServiceTask-MoveProductToFinishedGoods-id-0009",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-MoveProductToEnd-id-0021",
          "sourceRef": "ServiceTask-MoveProductToFinishedGoods-id-0009",
          "targetRef": "EndEvent-ProcessComplete-id-0012"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToScrapProduct-id-0022",
          "name": "",
          "sourceRef": "ExclusiveGateway-QualityCheckResult-id-0008",
          "targetRef": "ServiceTask-ScrapDefectiveProduct-id-0010",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ScrapProductToLogWaste-id-0023",
          "sourceRef": "ServiceTask-ScrapDefectiveProduct-id-0010",
          "targetRef": "ServiceTask-LogWaste-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-LogWasteToEnd-id-0024",
          "sourceRef": "ServiceTask-LogWaste-id-0011",
          "targetRef": "EndEvent-ProcessComplete-id-0012"
        }
      ],
      "isExecutable": true
    }
  ]
}