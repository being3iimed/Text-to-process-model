{
  "$type": "bpmn:Definitions",
  "id": "ReturnProcess-definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "ReturnProcess-id-0001",
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-ProcessBegins-id-0001",
          "name": "Process Begins"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CustomerInitiatesReturn-id-0002",
          "name": "Customer initiates return request"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ValidateReturnEligibility-id-0003",
          "name": "Validate return eligibility"
        },
        {
          "$type": "bpmn:BoundaryEvent",
          "id": "BoundaryEvent-Timer30Days-ValidateReturnEligibility-id-0004",
          "name": "30 Day Timeout",
          "attachedToRef": "ServiceTask-ValidateReturnEligibility-id-0003",
          "cancelActivity": true,
          "eventDefinitions": [
            {
              "$type": "bpmn:TimerEventDefinition",
              "timeDuration": "P30D"
            }
          ]
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-EligibilityCheck-id-0005",
          "name": "Eligibility Check",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendReturnShippingLabel-id-0006",
          "name": "Send: return shipping label"
        },
        {
          "$type": "bpmn:ReceiveTask",
          "id": "ReceiveTask-WarehouseReceivesPackage-id-0007",
          "name": "Warehouse receives package"
        },
        {
          "$type": "bpmn:SubProcess",
          "id": "SubProcess-ReturnVerification-id-0008",
          "name": "Return Verification",
          "flowElements": [
            {
              "$type": "bpmn:StartEvent",
              "id": "StartEvent-VerificationStart-id-0009",
              "name": "Verification Start"
            },
            {
              "$type": "bpmn:UserTask",
              "id": "UserTask-VerifyItemCondition-id-0010",
              "name": "Verify item condition"
            },
            {
              "$type": "bpmn:ExclusiveGateway",
              "id": "ExclusiveGateway-ConditionCheck-id-0011",
              "name": "Condition Check",
              "gatewayDirection": "Diverging"
            },
            {
              "$type": "bpmn:ServiceTask",
              "id": "ServiceTask-ProcessRefund-id-0012",
              "name": "Process refund"
            },
            {
              "$type": "bpmn:BoundaryEvent",
              "id": "BoundaryEvent-Error-ProcessRefund-id-0013",
              "name": "Refund Processing Failure",
              "attachedToRef": "ServiceTask-ProcessRefund-id-0012",
              "cancelActivity": true,
              "eventDefinitions": [
                {
                  "$type": "bpmn:ErrorEventDefinition",
                  "errorRef": "REFUND_PROCESSING_ERROR"
                }
              ]
            },
            {
              "$type": "bpmn:UserTask",
              "id": "UserTask-ManualRefundProcessing-id-0014",
              "name": "Manual refund processing"
            },
            {
              "$type": "bpmn:EndEvent",
              "id": "EndEvent-RefundProcessed-id-0015",
              "name": "Refund Processed"
            },
            {
              "$type": "bpmn:SendTask",
              "id": "SendTask-SendReturnDenialNotice-id-0016",
              "name": "Send: return denial notice"
            },
            {
              "$type": "bpmn:EndEvent",
              "id": "EndEvent-ReturnDenied-id-0017",
              "name": "Return Denied"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-VerificationStartToVerify-id-0018",
              "sourceRef": "StartEvent-VerificationStart-id-0009",
              "targetRef": "UserTask-VerifyItemCondition-id-0010"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-VerifyToConditionCheck-id-0019",
              "sourceRef": "UserTask-VerifyItemCondition-id-0010",
              "targetRef": "ExclusiveGateway-ConditionCheck-id-0011"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-ConditionCheckToProcessRefund-id-0020",
              "name": "acceptable",
              "sourceRef": "ExclusiveGateway-ConditionCheck-id-0011",
              "targetRef": "ServiceTask-ProcessRefund-id-0012",
              "isDefault": false
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-ProcessRefundToRefundProcessed-id-0021",
              "sourceRef": "ServiceTask-ProcessRefund-id-0012",
              "targetRef": "EndEvent-RefundProcessed-id-0015"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-ErrorToManualRefund-id-0022",
              "sourceRef": "BoundaryEvent-Error-ProcessRefund-id-0013",
              "targetRef": "UserTask-ManualRefundProcessing-id-0014"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-ManualRefundToRefundProcessed-id-0023",
              "sourceRef": "UserTask-ManualRefundProcessing-id-0014",
              "targetRef": "EndEvent-RefundProcessed-id-0015"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-ConditionCheckToDenialNotice-id-0024",
              "name": "damaged",
              "sourceRef": "ExclusiveGateway-ConditionCheck-id-0011",
              "targetRef": "SendTask-SendReturnDenialNotice-id-0016",
              "isDefault": true
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "SequenceFlow-DenialNoticeToReturnDenied-id-0025",
              "sourceRef": "SendTask-SendReturnDenialNotice-id-0016",
              "targetRef": "EndEvent-ReturnDenied-id-0017"
            }
          ]
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendRefundConfirmation-id-0026",
          "name": "Send: refund confirmation email"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendReturnDenialNotice-id-0027",
          "name": "Send: return denial notice"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProcessComplete-id-0028",
          "name": "Process Complete"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ProcessBeginsToCustomerInitiates-id-0029",
          "sourceRef": "StartEvent-ProcessBegins-id-0001",
          "targetRef": "UserTask-CustomerInitiatesReturn-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CustomerInitiatesToValidate-id-0030",
          "sourceRef": "UserTask-CustomerInitiatesReturn-id-0002",
          "targetRef": "ServiceTask-ValidateReturnEligibility-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ValidateToEligibilityCheck-id-0031",
          "sourceRef": "ServiceTask-ValidateReturnEligibility-id-0003",
          "targetRef": "ExclusiveGateway-EligibilityCheck-id-0005"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-TimerToExpirationNotice-id-0032",
          "sourceRef": "BoundaryEvent-Timer30Days-ValidateReturnEligibility-id-0004",
          "targetRef": "SendTask-SendReturnShippingLabel-id-0006"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-EligibilityCheckToShippingLabel-id-0033",
          "name": "eligible",
          "sourceRef": "ExclusiveGateway-EligibilityCheck-id-0005",
          "targetRef": "SendTask-SendReturnShippingLabel-id-0006",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ShippingLabelToWarehouseReceives-id-0034",
          "sourceRef": "SendTask-SendReturnShippingLabel-id-0006",
          "targetRef": "ReceiveTask-WarehouseReceivesPackage-id-0007"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-WarehouseReceivesToVerification-id-0035",
          "sourceRef": "ReceiveTask-WarehouseReceivesPackage-id-0007",
          "targetRef": "SubProcess-ReturnVerification-id-0008"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-VerificationToRefundConfirmation-id-0036",
          "sourceRef": "SubProcess-ReturnVerification-id-0008",
          "targetRef": "SendTask-SendRefundConfirmation-id-0026"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-RefundConfirmationToProcessComplete-id-0037",
          "sourceRef": "SendTask-SendRefundConfirmation-id-0026",
          "targetRef": "EndEvent-ProcessComplete-id-0028"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-EligibilityCheckToDenialNotice-id-0038",
          "name": "not eligible",
          "sourceRef": "ExclusiveGateway-EligibilityCheck-id-0005",
          "targetRef": "SendTask-SendReturnDenialNotice-id-0027",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-DenialNoticeToProcessComplete-id-0039",
          "sourceRef": "SendTask-SendReturnDenialNotice-id-0027",
          "targetRef": "EndEvent-ProcessComplete-id-0028"
        }
      ],
      "isExecutable": true
    }
  ]
}