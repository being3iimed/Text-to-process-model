{
  "$type": "bpmn:Definitions",
  "id": "credit-application-definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "CreditApplicationProcess-id-0001",
      "name": "Credit Application Process",
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-CreditApplicationProcessStarts-id-0001",
          "name": "Credit Application Process Starts"
        },
        {
          "$type": "bpmn:ParallelGateway",
          "id": "ParallelGateway-Split-id-0001",
          "name": "Parallel Execution",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CustomerSubmitsFinancialInformation-id-0002",
          "name": "Customer submits financial information"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-SystemCollectsFinancialData-id-0003",
          "name": "System collects financial data"
        },
        {
          "$type": "bpmn:ParallelGateway",
          "id": "ParallelGateway-Join-id-0004",
          "name": "Synchronize Branches",
          "gatewayDirection": "Converging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-SystemVerifiesFinancialInformation-id-0005",
          "name": "System verifies financial information"
        },
        {
          "$type": "bpmn:ScriptTask",
          "id": "ScriptTask-ComputationCalculateCreditScore-id-0006",
          "name": "Computation: calculate credit score using income, debt, and credit history"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-CreditScoreCheck-id-0007",
          "name": "Credit Score Check",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-SystemApprovesCreditApplication-id-0008",
          "name": "System approves credit application"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendApprovalNotificationToCustomer-id-0009",
          "name": "Send: approval notification to customer"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CustomerReviewsAndSignsContract-id-0010",
          "name": "Customer reviews and signs contract"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-SystemActivatesCreditLimit-id-0011",
          "name": "System activates credit limit"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-CreditFacilityActivated-id-0012",
          "name": "Credit Facility Activated"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendRejectionNotificationToCustomer-id-0013",
          "name": "Send: rejection notification to customer"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-CreditApplicationRejected-id-0014",
          "name": "Credit Application Rejected"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToSplit-id-0015",
          "sourceRef": "StartEvent-CreditApplicationProcessStarts-id-0001",
          "targetRef": "ParallelGateway-Split-id-0001"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SplitToCustomerSubmits-id-0016",
          "sourceRef": "ParallelGateway-Split-id-0001",
          "targetRef": "UserTask-CustomerSubmitsFinancialInformation-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SplitToSystemCollects-id-0017",
          "sourceRef": "ParallelGateway-Split-id-0001",
          "targetRef": "ServiceTask-SystemCollectsFinancialData-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CustomerSubmitsToJoin-id-0018",
          "sourceRef": "UserTask-CustomerSubmitsFinancialInformation-id-0002",
          "targetRef": "ParallelGateway-Join-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SystemCollectsToJoin-id-0019",
          "sourceRef": "ServiceTask-SystemCollectsFinancialData-id-0003",
          "targetRef": "ParallelGateway-Join-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-JoinToVerify-id-0020",
          "sourceRef": "ParallelGateway-Join-id-0004",
          "targetRef": "ServiceTask-SystemVerifiesFinancialInformation-id-0005"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-VerifyToCalculate-id-0021",
          "sourceRef": "ServiceTask-SystemVerifiesFinancialInformation-id-0005",
          "targetRef": "ScriptTask-ComputationCalculateCreditScore-id-0006"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CalculateToGateway-id-0022",
          "sourceRef": "ScriptTask-ComputationCalculateCreditScore-id-0006",
          "targetRef": "ExclusiveGateway-CreditScoreCheck-id-0007"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToApproved-id-0023",
          "name": "credit_score >= approval_threshold",
          "sourceRef": "ExclusiveGateway-CreditScoreCheck-id-0007",
          "targetRef": "ServiceTask-SystemApprovesCreditApplication-id-0008",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ApprovedToSendNotification-id-0024",
          "sourceRef": "ServiceTask-SystemApprovesCreditApplication-id-0008",
          "targetRef": "SendTask-SendApprovalNotificationToCustomer-id-0009"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SendNotificationToReview-id-0025",
          "sourceRef": "SendTask-SendApprovalNotificationToCustomer-id-0009",
          "targetRef": "UserTask-CustomerReviewsAndSignsContract-id-0010"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReviewToActivate-id-0026",
          "sourceRef": "UserTask-CustomerReviewsAndSignsContract-id-0010",
          "targetRef": "ServiceTask-SystemActivatesCreditLimit-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ActivateToEnd-id-0027",
          "sourceRef": "ServiceTask-SystemActivatesCreditLimit-id-0011",
          "targetRef": "EndEvent-CreditFacilityActivated-id-0012"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToRejected-id-0028",
          "name": "",
          "sourceRef": "ExclusiveGateway-CreditScoreCheck-id-0007",
          "targetRef": "SendTask-SendRejectionNotificationToCustomer-id-0013",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-RejectedToEnd-id-0029",
          "sourceRef": "SendTask-SendRejectionNotificationToCustomer-id-0013",
          "targetRef": "EndEvent-CreditApplicationRejected-id-0014"
        }
      ]
    }
  ]
}