{
  "$type": "bpmn:Definitions",
  "id": "referral-process-definitions",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Referral-Process-id-0001",
      "name": "Referral Process",
      "isExecutable": true,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-ReferralProcessInitiated-id-0001",
          "name": "Referral Process Initiated"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CustomerSharesReferralCode-id-0002",
          "name": "Customer Shares Referral Code"
        },
        {
          "$type": "bpmn:ReceiveTask",
          "id": "ReceiveTask-ReferredPartyAction-id-0003",
          "name": "Receive Referred Party Action"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-ReferredPartyEligibility-id-0004",
          "name": "Referred Party Eligibility",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CalculateRewardAmount-id-0005",
          "name": "Calculate Reward Amount"
        },
        {
          "$type": "bpmn:ParallelGateway",
          "id": "ParallelGateway-Split-id-0006",
          "name": "Parallel Execution",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-NotificationToReferrer-id-0007",
          "name": "Send Notification to Referrer"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-NotificationToReferredParty-id-0008",
          "name": "Send Notification to Referred Party"
        },
        {
          "$type": "bpmn:ParallelGateway",
          "id": "ParallelGateway-Join-id-0009",
          "name": "Synchronize Branches",
          "gatewayDirection": "Converging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-ReferrerRedeemsReward-id-0010",
          "name": "Referrer Redeems Reward"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-RewardRedeemed-id-0011",
          "name": "Reward Redeemed"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-NotificationToReferrerEligibility-id-0012",
          "name": "Send Notification to Referrer (eligibility not met)"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-RewardNotEarned-id-0013",
          "name": "Reward Not Earned"
        },
        {
          "$type": "bpmn:BoundaryEvent",
          "id": "BoundaryEvent-Timer30Day-id-0014",
          "name": "30 Day Timeout",
          "attachedToRef": "UserTask-ReferrerRedeemsReward-id-0010",
          "cancelActivity": true,
          "eventDefinitions": [
            {
              "$type": "bpmn:TimerEventDefinition",
              "timeDuration": "P30D"
            }
          ]
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-RewardExpired-id-0015",
          "name": "Reward Expired"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToCustomerShares-id-0016",
          "sourceRef": "StartEvent-ReferralProcessInitiated-id-0001",
          "targetRef": "UserTask-CustomerSharesReferralCode-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CustomerSharesToReceive-id-0017",
          "sourceRef": "UserTask-CustomerSharesReferralCode-id-0002",
          "targetRef": "ReceiveTask-ReferredPartyAction-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReceiveToGateway-id-0018",
          "sourceRef": "ReceiveTask-ReferredPartyAction-id-0003",
          "targetRef": "ExclusiveGateway-ReferredPartyEligibility-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToCalculate-id-0019",
          "name": "referred_party_meets_eligibility",
          "sourceRef": "ExclusiveGateway-ReferredPartyEligibility-id-0004",
          "targetRef": "ServiceTask-CalculateRewardAmount-id-0005",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CalculateToParallelSplit-id-0020",
          "sourceRef": "ServiceTask-CalculateRewardAmount-id-0005",
          "targetRef": "ParallelGateway-Split-id-0006"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ParallelSplitToNotificationReferrer-id-0021",
          "sourceRef": "ParallelGateway-Split-id-0006",
          "targetRef": "SendTask-NotificationToReferrer-id-0007"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ParallelSplitToNotificationReferred-id-0022",
          "sourceRef": "ParallelGateway-Split-id-0006",
          "targetRef": "SendTask-NotificationToReferredParty-id-0008"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-NotificationReferrerToParallelJoin-id-0023",
          "sourceRef": "SendTask-NotificationToReferrer-id-0007",
          "targetRef": "ParallelGateway-Join-id-0009"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-NotificationReferredToParallelJoin-id-0024",
          "sourceRef": "SendTask-NotificationToReferredParty-id-0008",
          "targetRef": "ParallelGateway-Join-id-0009"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ParallelJoinToRedeem-id-0025",
          "sourceRef": "ParallelGateway-Join-id-0009",
          "targetRef": "UserTask-ReferrerRedeemsReward-id-0010"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-RedeemToEnd-id-0026",
          "sourceRef": "UserTask-ReferrerRedeemsReward-id-0010",
          "targetRef": "EndEvent-RewardRedeemed-id-0011"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToNotification-id-0027",
          "name": "",
          "sourceRef": "ExclusiveGateway-ReferredPartyEligibility-id-0004",
          "targetRef": "SendTask-NotificationToReferrerEligibility-id-0012",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-NotificationToEnd-id-0028",
          "sourceRef": "SendTask-NotificationToReferrerEligibility-id-0012",
          "targetRef": "EndEvent-RewardNotEarned-id-0013"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-BoundaryToEnd-id-0029",
          "sourceRef": "BoundaryEvent-Timer30Day-id-0014",
          "targetRef": "EndEvent-RewardExpired-id-0015"
        }
      ]
    }
  ]
}