{
  "$type": "bpmn:Definitions",
  "id": "feedback-collection-process",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Feedback-Collection-Process-id-0001",
      "name": "Feedback Collection Process",
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-FeedbackCollectionProcessStarts-id-0001",
          "name": "Feedback Collection Process Starts"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-CollectFeedback-id-0002",
          "name": "Collect feedback through surveys or focus groups"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-AnalyzeFeedback-id-0003",
          "name": "Analyze feedback to identify trends and pain points"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CreateActionPlans-id-0004",
          "name": "Create action plans to address recurring issues"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ImplementChanges-id-0005",
          "name": "Implement changes based on action plans"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendNotification-id-0006",
          "name": "Send notification to customers about improvements"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ReMeasureSatisfaction-id-0007",
          "name": "Re-measure satisfaction levels to gauge impact of changes"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-FeedbackImprovement-id-0008",
          "name": "Feedback Improvement Assessment",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProcessCompleteWithImprovement-id-0009",
          "name": "Process Complete with Improvement"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProcessCompleteWithStableFeedback-id-0010",
          "name": "Process Complete with Stable Feedback"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ReEvaluateFeedback-id-0011",
          "name": "Re-evaluate feedback and adjust action plans"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendUpdate-id-0012",
          "name": "Send update to customers about ongoing improvements"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProcessCompleteWithOngoingMonitoring-id-0013",
          "name": "Process Complete with Ongoing Monitoring"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToCollect-id-0014",
          "sourceRef": "StartEvent-FeedbackCollectionProcessStarts-id-0001",
          "targetRef": "ServiceTask-CollectFeedback-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CollectToAnalyze-id-0015",
          "sourceRef": "ServiceTask-CollectFeedback-id-0002",
          "targetRef": "ServiceTask-AnalyzeFeedback-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AnalyzeToCreate-id-0016",
          "sourceRef": "ServiceTask-AnalyzeFeedback-id-0003",
          "targetRef": "UserTask-CreateActionPlans-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CreateToImplement-id-0017",
          "sourceRef": "UserTask-CreateActionPlans-id-0004",
          "targetRef": "ServiceTask-ImplementChanges-id-0005"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ImplementToSend-id-0018",
          "sourceRef": "ServiceTask-ImplementChanges-id-0005",
          "targetRef": "SendTask-SendNotification-id-0006"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SendToReMeasure-id-0019",
          "sourceRef": "SendTask-SendNotification-id-0006",
          "targetRef": "ServiceTask-ReMeasureSatisfaction-id-0007"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReMeasureToGateway-id-0020",
          "sourceRef": "ServiceTask-ReMeasureSatisfaction-id-0007",
          "targetRef": "ExclusiveGateway-FeedbackImprovement-id-0008"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToImprovement-id-0021",
          "sourceRef": "ExclusiveGateway-FeedbackImprovement-id-0008",
          "targetRef": "EndEvent-ProcessCompleteWithImprovement-id-0009",
          "name": "feedback shows significant improvement",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToStable-id-0022",
          "sourceRef": "ExclusiveGateway-FeedbackImprovement-id-0008",
          "targetRef": "EndEvent-ProcessCompleteWithStableFeedback-id-0010",
          "name": "feedback stabilizes",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToReEvaluate-id-0023",
          "sourceRef": "ExclusiveGateway-FeedbackImprovement-id-0008",
          "targetRef": "ServiceTask-ReEvaluateFeedback-id-0011",
          "name": "",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReEvaluateToSendUpdate-id-0024",
          "sourceRef": "ServiceTask-ReEvaluateFeedback-id-0011",
          "targetRef": "SendTask-SendUpdate-id-0012"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SendUpdateToMonitoring-id-0025",
          "sourceRef": "SendTask-SendUpdate-id-0012",
          "targetRef": "EndEvent-ProcessCompleteWithOngoingMonitoring-id-0013"
        }
      ]
    }
  ]
}