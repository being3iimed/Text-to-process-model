          "id": "SequenceFlow-MatchToGateway-id-0012",
          "sourceRef": "UserTask-MatchInvoice-id-0002",
          "targetRef": "ExclusiveGateway-InvoiceMatch-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToAuthorize-id-0013",
          "name": "invoice_matches_purchase_order_and_receipt",
