          "targetRef": "UserTask-AuthorizePayment-id-0005",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToInvestigate-id-0014",
          "name": "",
          "sourceRef": "ExclusiveGateway-InvoiceMatch-id-0003",
          "targetRef": "UserTask-InvestigateDiscrepancies-id-0004",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-InvestigateToAuthorize-id-0015",
          "sourceRef": "UserTask-InvestigateDiscrepancies-id-0004",
          "targetRef": "UserTask-AuthorizePayment-id-0005"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-AuthorizeToProcess-id-0016",
          "sourceRef": "UserTask-AuthorizePayment-id-0005",
          "targetRef": "ServiceTask-ProcessPayment-id-0006"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ProcessToSend-id-0017",
          "sourceRef": "ServiceTask-ProcessPayment-id-0006",
          "targetRef": "SendTask-PaymentNotification-id-0007"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SendToUpdate-id-0018",
          "sourceRef": "SendTask-PaymentNotification-id-0007",
          "targetRef": "ServiceTask-UpdateRecords-id-0008"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-UpdateToGenerate-id-0019",
          "sourceRef": "ServiceTask-UpdateRecords-id-0008",
          "targetRef": "ServiceTask-GenerateReport-id-0009"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GenerateToEnd-id-0020",
          "sourceRef": "ServiceTask-GenerateReport-id-0009",
          "targetRef": "EndEvent-ProcessComplete-id-0010"
        }
