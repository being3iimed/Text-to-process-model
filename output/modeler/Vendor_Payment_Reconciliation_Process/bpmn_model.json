{
  "$type": "bpmn:Definitions",
  "id": "definitions-invoice-processing",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Process-InvoiceProcessing-id-0001",
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-ProcessInitiated-id-0001",
          "name": "Process Initiated"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-MatchInvoice-id-0002",
          "name": "Match Invoice to Purchase Order and Receipt"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-InvoiceMatch-id-0003",
          "name": "Invoice Matches?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-InvestigateDiscrepancies-id-0004",
          "name": "Investigate and Resolve Discrepancies"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-AuthorizePayment-id-0005",
          "name": "Authorize Payment"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-ProcessPayment-id-0006",
          "name": "Process Payment via Bank Transfer or Check"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-PaymentNotification-id-0007",
          "name": "Send: Payment Notification to Vendor"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-UpdateRecords-id-0008",
          "name": "Update Financial Records"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-GenerateReport-id-0009",
          "name": "Generate Reconciliation Report"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProcessComplete-id-0010",
          "name": "Process Complete"
        },
        {
          "$type": "bpmn:SequenceFlow",
