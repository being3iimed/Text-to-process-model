{
  "$type": "bpmn:Definitions",
  "id": "MedicalAppointmentProcess",
  "targetNamespace": "http://bpmn.io/schema/bpmn",
  "exporter": "bpmn-js (https://demo.bpmn.io)",
  "exporterVersion": "18.0.0",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "MedicalAppointmentProcess-id-0001",
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "StartEvent-ProcessBegins-id-0001",
          "name": "Process Begins"
        },
        {
          "$type": "bpmn:ReceiveTask",
          "id": "ReceiveTask-ReceivePatientCall-id-0002",
          "name": "Receive: patient call"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-CheckTimeSlots-id-0003",
          "name": "Check available time slots"
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-SlotsAvailable-id-0004",
          "name": "Slots Available?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:ServiceTask",
          "id": "ServiceTask-BookAppointment-id-0005",
          "name": "Book appointment"
        },
        {
          "$type": "bpmn:SendTask",
          "id": "SendTask-SendConfirmation-id-0006",
          "name": "Send: appointment confirmation"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-PlaceOnWaitlist-id-0007",
          "name": "Place patient on waitlist"
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "EndEvent-ProcessComplete-id-0008",
          "name": "Process Complete"
        },
        {
          "$type": "bpmn:MessageStartEvent",
          "id": "MessageStartEvent-CancellationNotification-id-0009",
          "name": "Cancellation Notification",
          "eventDefinitions": [
            {
              "$type": "bpmn:MessageEventDefinition",
              "name": "CancellationNotification"
            }
          ]
        },
        {
          "$type": "bpmn:ExclusiveGateway",
          "id": "ExclusiveGateway-PatientOnWaitlist-id-0010",
          "name": "Patient on Waitlist?",
          "gatewayDirection": "Diverging"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-NotifyCancellation-id-0011",
          "name": "Notify patient of cancellation"
        },
        {
          "$type": "bpmn:UserTask",
          "id": "UserTask-OfferAppointment-id-0012",
          "name": "Offer appointment to waitlisted patient"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-StartToReceive-id-0013",
          "sourceRef": "StartEvent-ProcessBegins-id-0001",
          "targetRef": "ReceiveTask-ReceivePatientCall-id-0002"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-ReceiveToCheck-id-0014",
          "sourceRef": "ReceiveTask-ReceivePatientCall-id-0002",
          "targetRef": "UserTask-CheckTimeSlots-id-0003"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-CheckToGateway-id-0015",
          "sourceRef": "UserTask-CheckTimeSlots-id-0003",
          "targetRef": "ExclusiveGateway-SlotsAvailable-id-0004"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToBook-id-0016",
          "name": "slots available",
          "sourceRef": "ExclusiveGateway-SlotsAvailable-id-0004",
          "targetRef": "ServiceTask-BookAppointment-id-0005",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToWaitlist-id-0017",
          "name": "slots unavailable",
          "sourceRef": "ExclusiveGateway-SlotsAvailable-id-0004",
          "targetRef": "UserTask-PlaceOnWaitlist-id-0007",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-BookToSend-id-0018",
          "sourceRef": "ServiceTask-BookAppointment-id-0005",
          "targetRef": "SendTask-SendConfirmation-id-0006"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-SendToEnd-id-0019",
          "sourceRef": "SendTask-SendConfirmation-id-0006",
          "targetRef": "EndEvent-ProcessComplete-id-0008"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-WaitlistToEnd-id-0020",
          "sourceRef": "UserTask-PlaceOnWaitlist-id-0007",
          "targetRef": "EndEvent-ProcessComplete-id-0008"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-MessageToGateway-id-0021",
          "sourceRef": "MessageStartEvent-CancellationNotification-id-0009",
          "targetRef": "ExclusiveGateway-PatientOnWaitlist-id-0010"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToNotify-id-0022",
          "name": "patient on waitlist",
          "sourceRef": "ExclusiveGateway-PatientOnWaitlist-id-0010",
          "targetRef": "UserTask-NotifyCancellation-id-0011",
          "isDefault": false
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-GatewayToEnd-id-0023",
          "name": "",
          "sourceRef": "ExclusiveGateway-PatientOnWaitlist-id-0010",
          "targetRef": "EndEvent-ProcessComplete-id-0008",
          "isDefault": true
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-NotifyToOffer-id-0024",
          "sourceRef": "UserTask-NotifyCancellation-id-0011",
          "targetRef": "UserTask-OfferAppointment-id-0012"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "SequenceFlow-OfferToEnd-id-0025",
          "sourceRef": "UserTask-OfferAppointment-id-0012",
          "targetRef": "EndEvent-ProcessComplete-id-0008"
        }
      ],
      "isExecutable": true
    }
  ]
}