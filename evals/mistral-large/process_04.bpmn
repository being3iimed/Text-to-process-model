<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="MarketingCampaignExecution" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process-MarketingCampaignExecution-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CampaignPlanningInitiated-id-0001" name="Campaign Planning Initiated">
      <bpmn:outgoing>SequenceFlow-StartToDefineObjectives-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-DefineCampaignObjectives-id-0001" name="Define Campaign Objectives">
      <bpmn:incoming>SequenceFlow-StartToDefineObjectives-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DefineToCreateContent-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CreateContentAndDesignVisuals-id-0002" name="Create Content and Design Visuals">
      <bpmn:incoming>SequenceFlow-DefineToCreateContent-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateToSelectChannels-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectPromotionChannels-id-0003" name="Select Promotion Channels">
      <bpmn:incoming>SequenceFlow-CreateToSelectChannels-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToLaunch-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-LaunchCampaign-id-0001" name="Launch Campaign">
      <bpmn:incoming>SequenceFlow-SelectToLaunch-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LaunchToTrack-id-0005</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TrackPerformanceMetrics-id-0002" name="Track Performance Metrics">
      <bpmn:incoming>SequenceFlow-LaunchToTrack-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrackToCollectLeads-id-0006</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CollectLeadsInCRM-id-0003" name="Collect Leads in CRM">
      <bpmn:incoming>SequenceFlow-TrackToCollectLeads-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CollectToSalesFollowUp-id-0007</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-SalesFollowUp-id-0004" name="Sales Follow-Up">
      <bpmn:incoming>SequenceFlow-CollectToSalesFollowUp-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SalesToTimerTrigger-id-0008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent-CampaignEndDate-id-0002" name="Campaign End Date">
      <bpmn:incoming>SequenceFlow-SalesToTimerTrigger-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TimerToAnalyze-id-0009</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-AnalyzeCampaignPerformance-id-0004" name="Analyze Campaign Performance">
      <bpmn:incoming>SequenceFlow-TimerToAnalyze-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnalyzeToEnd-id-0010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-CampaignAnalysisComplete-id-0001" name="Campaign Analysis Complete">
      <bpmn:incoming>SequenceFlow-AnalyzeToEnd-id-0010</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDefineObjectives-id-0001" sourceRef="StartEvent-CampaignPlanningInitiated-id-0001" targetRef="UserTask-DefineCampaignObjectives-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DefineToCreateContent-id-0002" sourceRef="UserTask-DefineCampaignObjectives-id-0001" targetRef="UserTask-CreateContentAndDesignVisuals-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateToSelectChannels-id-0003" sourceRef="UserTask-CreateContentAndDesignVisuals-id-0002" targetRef="UserTask-SelectPromotionChannels-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToLaunch-id-0004" sourceRef="UserTask-SelectPromotionChannels-id-0003" targetRef="ServiceTask-LaunchCampaign-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-LaunchToTrack-id-0005" sourceRef="ServiceTask-LaunchCampaign-id-0001" targetRef="ServiceTask-TrackPerformanceMetrics-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-TrackToCollectLeads-id-0006" sourceRef="ServiceTask-TrackPerformanceMetrics-id-0002" targetRef="ServiceTask-CollectLeadsInCRM-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CollectToSalesFollowUp-id-0007" sourceRef="ServiceTask-CollectLeadsInCRM-id-0003" targetRef="UserTask-SalesFollowUp-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-SalesToTimerTrigger-id-0008" sourceRef="UserTask-SalesFollowUp-id-0004" targetRef="StartEvent-CampaignEndDate-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-TimerToAnalyze-id-0009" sourceRef="StartEvent-CampaignEndDate-id-0002" targetRef="ServiceTask-AnalyzeCampaignPerformance-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-AnalyzeToEnd-id-0010" sourceRef="ServiceTask-AnalyzeCampaignPerformance-id-0004" targetRef="EndEvent-CampaignAnalysisComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process-MarketingCampaignExecution-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Process-MarketingCampaignExecution-id-0001" bpmnElement="Process-MarketingCampaignExecution-id-0001">
      <bpmndi:BPMNShape id="StartEvent-CampaignPlanningInitiated-id-0001_di" bpmnElement="StartEvent-CampaignPlanningInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DefineCampaignObjectives-id-0001_di" bpmnElement="UserTask-DefineCampaignObjectives-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CreateContentAndDesignVisuals-id-0002_di" bpmnElement="UserTask-CreateContentAndDesignVisuals-id-0002">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SelectPromotionChannels-id-0003_di" bpmnElement="UserTask-SelectPromotionChannels-id-0003">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-LaunchCampaign-id-0001_di" bpmnElement="ServiceTask-LaunchCampaign-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TrackPerformanceMetrics-id-0002_di" bpmnElement="ServiceTask-TrackPerformanceMetrics-id-0002">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CollectLeadsInCRM-id-0003_di" bpmnElement="ServiceTask-CollectLeadsInCRM-id-0003">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SalesFollowUp-id-0004_di" bpmnElement="UserTask-SalesFollowUp-id-0004">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent-CampaignEndDate-id-0002_di" bpmnElement="StartEvent-CampaignEndDate-id-0002">
        <dc:Bounds x="1257" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-AnalyzeCampaignPerformance-id-0004_di" bpmnElement="ServiceTask-AnalyzeCampaignPerformance-id-0004">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-CampaignAnalysisComplete-id-0001_di" bpmnElement="EndEvent-CampaignAnalysisComplete-id-0001">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToDefineObjectives-id-0001_di" bpmnElement="SequenceFlow-StartToDefineObjectives-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DefineToCreateContent-id-0002_di" bpmnElement="SequenceFlow-DefineToCreateContent-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CreateToSelectChannels-id-0003_di" bpmnElement="SequenceFlow-CreateToSelectChannels-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectToLaunch-id-0004_di" bpmnElement="SequenceFlow-SelectToLaunch-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LaunchToTrack-id-0005_di" bpmnElement="SequenceFlow-LaunchToTrack-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TrackToCollectLeads-id-0006_di" bpmnElement="SequenceFlow-TrackToCollectLeads-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CollectToSalesFollowUp-id-0007_di" bpmnElement="SequenceFlow-CollectToSalesFollowUp-id-0007">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SalesToTimerTrigger-id-0008_di" bpmnElement="SequenceFlow-SalesToTimerTrigger-id-0008">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1257" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TimerToAnalyze-id-0009_di" bpmnElement="SequenceFlow-TimerToAnalyze-id-0009">
        <di:waypoint x="1293" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AnalyzeToEnd-id-0010_di" bpmnElement="SequenceFlow-AnalyzeToEnd-id-0010">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1557" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
