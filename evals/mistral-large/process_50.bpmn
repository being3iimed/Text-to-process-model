<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="claims-processing-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="ClaimsProcessing" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ClaimRegistered-id-0001" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow-StartToExamine-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ExamineClaim-id-0001" name="Examine Claim">
      <bpmn:incoming>SequenceFlow-StartToExamine-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExamineToWrite-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-WriteSettlementRecommendation-id-0002" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow-ExamineToWrite-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WriteToReview-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ReviewRecommendation-id-0003" name="Review Recommendation">
      <bpmn:incoming>SequenceFlow-WriteToReview-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToGateway-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RecommendationStatus-id-0001" name="Recommendation Status?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToGateway-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToApproved-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToRevise-id-0006</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-RecommendationApproved-id-0001" name="Recommendation Approved">
      <bpmn:incoming>SequenceFlow-GatewayToApproved-id-0005</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-ReviseRecommendation-id-0004" name="Revise Recommendation">
      <bpmn:incoming>SequenceFlow-GatewayToRevise-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviseToReviewSecond-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ReviewRecommendationSecond-id-0005" name="Review Recommendation">
      <bpmn:incoming>SequenceFlow-ReviseToReviewSecond-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewSecondToGatewaySecond-id-0008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RecommendationStatusSecond-id-0002" name="Recommendation Status (2nd)?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewSecondToGatewaySecond-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewaySecondToApproved-id-0009</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewaySecondToManager-id-0010</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-FinalDecisionByManager-id-0006" name="Final Decision by Manager">
      <bpmn:incoming>SequenceFlow-GatewaySecondToManager-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ManagerToApproved-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-RecommendationApprovedSecond-id-0002" name="Recommendation Approved">
      <bpmn:incoming>SequenceFlow-GatewaySecondToApproved-id-0009</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ManagerToApproved-id-0011</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToExamine-id-0001" sourceRef="StartEvent-ClaimRegistered-id-0001" targetRef="UserTask-ExamineClaim-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ExamineToWrite-id-0002" sourceRef="UserTask-ExamineClaim-id-0001" targetRef="UserTask-WriteSettlementRecommendation-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-WriteToReview-id-0003" sourceRef="UserTask-WriteSettlementRecommendation-id-0002" targetRef="UserTask-ReviewRecommendation-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToGateway-id-0004" sourceRef="UserTask-ReviewRecommendation-id-0003" targetRef="ExclusiveGateway-RecommendationStatus-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToApproved-id-0005" name="recommendation == OK" sourceRef="ExclusiveGateway-RecommendationStatus-id-0001" targetRef="EndEvent-RecommendationApproved-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToRevise-id-0006" name="recommendation == Not OK" sourceRef="ExclusiveGateway-RecommendationStatus-id-0001" targetRef="UserTask-ReviseRecommendation-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviseToReviewSecond-id-0007" sourceRef="UserTask-ReviseRecommendation-id-0004" targetRef="UserTask-ReviewRecommendationSecond-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewSecondToGatewaySecond-id-0008" sourceRef="UserTask-ReviewRecommendationSecond-id-0005" targetRef="ExclusiveGateway-RecommendationStatusSecond-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewaySecondToApproved-id-0009" name="recommendation == OK" sourceRef="ExclusiveGateway-RecommendationStatusSecond-id-0002" targetRef="EndEvent-RecommendationApprovedSecond-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewaySecondToManager-id-0010" name="recommendation == Not OK" sourceRef="ExclusiveGateway-RecommendationStatusSecond-id-0002" targetRef="UserTask-FinalDecisionByManager-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-ManagerToApproved-id-0011" sourceRef="UserTask-FinalDecisionByManager-id-0006" targetRef="EndEvent-RecommendationApprovedSecond-id-0002" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ClaimsProcessing">
    <bpmndi:BPMNPlane id="BPMNPlane_ClaimsProcessing" bpmnElement="ClaimsProcessing">
      <bpmndi:BPMNShape id="StartEvent-ClaimRegistered-id-0001_di" bpmnElement="StartEvent-ClaimRegistered-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ExamineClaim-id-0001_di" bpmnElement="UserTask-ExamineClaim-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-WriteSettlementRecommendation-id-0002_di" bpmnElement="UserTask-WriteSettlementRecommendation-id-0002">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewRecommendation-id-0003_di" bpmnElement="UserTask-ReviewRecommendation-id-0003">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-RecommendationStatus-id-0001_di" bpmnElement="ExclusiveGateway-RecommendationStatus-id-0001" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RecommendationApproved-id-0001_di" bpmnElement="EndEvent-RecommendationApproved-id-0001">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviseRecommendation-id-0004_di" bpmnElement="UserTask-ReviseRecommendation-id-0004">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewRecommendationSecond-id-0005_di" bpmnElement="UserTask-ReviewRecommendationSecond-id-0005">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-RecommendationStatusSecond-id-0002_di" bpmnElement="ExclusiveGateway-RecommendationStatusSecond-id-0002" isMarkerVisible="true">
        <dc:Bounds x="1100" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RecommendationApprovedSecond-id-0002_di" bpmnElement="EndEvent-RecommendationApprovedSecond-id-0002">
        <dc:Bounds x="1407" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-FinalDecisionByManager-id-0006_di" bpmnElement="UserTask-FinalDecisionByManager-id-0006">
        <dc:Bounds x="1225" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToExamine-id-0001_di" bpmnElement="SequenceFlow-StartToExamine-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ExamineToWrite-id-0002_di" bpmnElement="SequenceFlow-ExamineToWrite-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-WriteToReview-id-0003_di" bpmnElement="SequenceFlow-WriteToReview-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToGateway-id-0004_di" bpmnElement="SequenceFlow-ReviewToGateway-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToApproved-id-0005_di" bpmnElement="SequenceFlow-GatewayToApproved-id-0005">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="807" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToRevise-id-0006_di" bpmnElement="SequenceFlow-GatewayToRevise-id-0006">
        <di:waypoint x="675" y="95" />
        <di:waypoint x="675" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviseToReviewSecond-id-0007_di" bpmnElement="SequenceFlow-ReviseToReviewSecond-id-0007">
        <di:waypoint x="875" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewSecondToGatewaySecond-id-0008_di" bpmnElement="SequenceFlow-ReviewSecondToGatewaySecond-id-0008">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1100" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewaySecondToApproved-id-0009_di" bpmnElement="SequenceFlow-GatewaySecondToApproved-id-0009">
        <di:waypoint x="1150" y="210" />
        <di:waypoint x="1407" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewaySecondToManager-id-0010_di" bpmnElement="SequenceFlow-GatewaySecondToManager-id-0010">
        <di:waypoint x="1125" y="235" />
        <di:waypoint x="1125" y="350" />
        <di:waypoint x="1225" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ManagerToApproved-id-0011_di" bpmnElement="SequenceFlow-ManagerToApproved-id-0011">
        <di:waypoint x="1325" y="350" />
        <di:waypoint x="1425" y="350" />
        <di:waypoint x="1425" y="228" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
