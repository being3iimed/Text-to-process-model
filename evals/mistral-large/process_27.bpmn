<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WorkAccidentReportingProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process-WorkAccidentReporting-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-WorkAccidentOccurs-id-0001" name="Work Accident Occurs">
      <bpmn:outgoing>SequenceFlow-StartToWorkRelatedCheck-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway-WorkRelatedCheck-id-0001" name="Work-Related Accident?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StartToWorkRelatedCheck-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WorkRelatedToReport-id-0002</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-WorkRelatedFalseToDocument-id-0019</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ReportAccidentToEmployer-id-0001" name="Report Accident to Employer">
      <bpmn:incoming>SequenceFlow-WorkRelatedToReport-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReportToDetourCheck-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DetourCheck-id-0002" name="Detour/Special Circumstance?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReportToDetourCheck-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DetourCheckToApproval-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DetourCheckToLog-id-0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ManagerApprovesDoctorVisit-id-0001" name="Manager Approves Doctor Visit">
      <bpmn:incoming>SequenceFlow-DetourCheckToApproval-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalToLog-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-LogAccidentInSystem-id-0001" name="Log Accident in System">
      <bpmn:incoming>SequenceFlow-DetourCheckToLog-id-0005</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ApprovalToLog-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LogToGenerateForm-id-0007</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-GenerateInsuranceForm-id-0001" name="Generate Insurance Form">
      <bpmn:incoming>SequenceFlow-LogToGenerateForm-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateFormToSeverity-id-0008</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-SeverityAssessment-id-0003" name="Severity Assessment" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-GenerateFormToSeverity-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SeverityToSevereSubprocess-id-0009</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SeverityToSubmitReport-id-0010</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess-HandleSevereAccident-id-0001" name="Handle Severe Accident">
      <bpmn:incoming>SequenceFlow-SeverityToSevereSubprocess-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubprocessToInsuredCheck-id-0011</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-SevereAccidentHandled-id-0001" name="Severe Accident Handled">
        <bpmn:outgoing>SequenceFlow-SubStartToSplit-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway-Split-id-0001" name="Parallel Actions" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-SubStartToSplit-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToNotifyLabour-id-0002</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToUrgentReport-id-0003</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToConfirmEmployee-id-0004</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sendTask id="SendTask-NotifyLabourInspectorate-id-0001" name="Send: Notification to Labour Inspectorate">
        <bpmn:incoming>SequenceFlow-SplitToNotifyLabour-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-NotifyLabourToJoin-id-0005</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="SendTask-UrgentReportToInsurance-id-0001" name="Send: Urgent Report to Insurance">
        <bpmn:incoming>SequenceFlow-SplitToUrgentReport-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-UrgentReportToJoin-id-0006</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="SendTask-ConfirmToEmployee-id-0001" name="Send: Confirmation to Employee">
        <bpmn:incoming>SequenceFlow-SplitToConfirmEmployee-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ConfirmToJoin-id-0007</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:parallelGateway id="ParallelGateway-Join-id-0001" name="Synchronize Actions" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-NotifyLabourToJoin-id-0005</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-UrgentReportToJoin-id-0006</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ConfirmToJoin-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToSubEnd-id-0008</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndEvent-SevereAccidentProcessed-id-0001" name="Severe Accident Processed">
        <bpmn:incoming>SequenceFlow-JoinToSubEnd-id-0008</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-SubStartToSplit-id-0001" sourceRef="StartEvent-SevereAccidentHandled-id-0001" targetRef="ParallelGateway-Split-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToNotifyLabour-id-0002" sourceRef="ParallelGateway-Split-id-0001" targetRef="SendTask-NotifyLabourInspectorate-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToUrgentReport-id-0003" sourceRef="ParallelGateway-Split-id-0001" targetRef="SendTask-UrgentReportToInsurance-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToConfirmEmployee-id-0004" sourceRef="ParallelGateway-Split-id-0001" targetRef="SendTask-ConfirmToEmployee-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-NotifyLabourToJoin-id-0005" sourceRef="SendTask-NotifyLabourInspectorate-id-0001" targetRef="ParallelGateway-Join-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-UrgentReportToJoin-id-0006" sourceRef="SendTask-UrgentReportToInsurance-id-0001" targetRef="ParallelGateway-Join-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ConfirmToJoin-id-0007" sourceRef="SendTask-ConfirmToEmployee-id-0001" targetRef="ParallelGateway-Join-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToSubEnd-id-0008" sourceRef="ParallelGateway-Join-id-0001" targetRef="EndEvent-SevereAccidentProcessed-id-0001" />
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask-SubmitAccidentReportToInsurance-id-0001" name="Submit Accident Report to Insurance">
      <bpmn:incoming>SequenceFlow-SeverityToSubmitReport-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubmitReportToInsuredCheck-id-0012</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InsuredGroupCheck-id-0004" name="Insured Group Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SubprocessToInsuredCheck-id-0011</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SubmitReportToInsuredCheck-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InsuredCheckToSchool-id-0013</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-InsuredCheckToSelfEmployed-id-0014</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-InsuredCheckToDeadline-id-0015</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-SchoolReportsAccident-id-0001" name="School/University Reports Accident">
      <bpmn:incoming>SequenceFlow-InsuredCheckToSchool-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SchoolToDeadline-id-0016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelfEmployedSubmitsReport-id-0001" name="Self-Employed Submits Own Report">
      <bpmn:incoming>SequenceFlow-InsuredCheckToSelfEmployed-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelfEmployedToDeadline-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-ReportingDeadline-id-0001" name="5-Day Reporting Deadline">
      <bpmn:incoming>SequenceFlow-InsuredCheckToDeadline-id-0015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SchoolToDeadline-id-0016</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SelfEmployedToDeadline-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeadlineToEnd-id-0018</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent-AccidentReportedToInsurance-id-0001" name="Accident Reported to Insurance">
      <bpmn:incoming>SequenceFlow-DeadlineToEnd-id-0018</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-DocumentNonWorkAccident-id-0001" name="Document Non-Work Accident">
      <bpmn:incoming>SequenceFlow-WorkRelatedFalseToDocument-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentToTerminate-id-0020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcessTerminated-id-0001" name="Process Terminated">
      <bpmn:incoming>SequenceFlow-DocumentToTerminate-id-0020</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToWorkRelatedCheck-id-0001" sourceRef="StartEvent-WorkAccidentOccurs-id-0001" targetRef="ExclusiveGateway-WorkRelatedCheck-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WorkRelatedToReport-id-0002" name="work_related = true" sourceRef="ExclusiveGateway-WorkRelatedCheck-id-0001" targetRef="UserTask-ReportAccidentToEmployer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReportToDetourCheck-id-0003" sourceRef="UserTask-ReportAccidentToEmployer-id-0001" targetRef="ExclusiveGateway-DetourCheck-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DetourCheckToApproval-id-0004" name="detour OR special_circumstance = true" sourceRef="ExclusiveGateway-DetourCheck-id-0002" targetRef="UserTask-ManagerApprovesDoctorVisit-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DetourCheckToLog-id-0005" sourceRef="ExclusiveGateway-DetourCheck-id-0002" targetRef="ServiceTask-LogAccidentInSystem-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalToLog-id-0006" sourceRef="UserTask-ManagerApprovesDoctorVisit-id-0001" targetRef="ServiceTask-LogAccidentInSystem-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-LogToGenerateForm-id-0007" sourceRef="ServiceTask-LogAccidentInSystem-id-0001" targetRef="ServiceTask-GenerateInsuranceForm-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateFormToSeverity-id-0008" sourceRef="ServiceTask-GenerateInsuranceForm-id-0001" targetRef="ExclusiveGateway-SeverityAssessment-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-SeverityToSevereSubprocess-id-0009" name="fatality OR serious_injury = true" sourceRef="ExclusiveGateway-SeverityAssessment-id-0003" targetRef="SubProcess-HandleSevereAccident-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SeverityToSubmitReport-id-0010" name="minor_injury = true" sourceRef="ExclusiveGateway-SeverityAssessment-id-0003" targetRef="UserTask-SubmitAccidentReportToInsurance-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubprocessToInsuredCheck-id-0011" sourceRef="SubProcess-HandleSevereAccident-id-0001" targetRef="ExclusiveGateway-InsuredGroupCheck-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-SubmitReportToInsuredCheck-id-0012" sourceRef="UserTask-SubmitAccidentReportToInsurance-id-0001" targetRef="ExclusiveGateway-InsuredGroupCheck-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-InsuredCheckToSchool-id-0013" name="insured_is_student = true" sourceRef="ExclusiveGateway-InsuredGroupCheck-id-0004" targetRef="UserTask-SchoolReportsAccident-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InsuredCheckToSelfEmployed-id-0014" name="insured_is_self_employed = true" sourceRef="ExclusiveGateway-InsuredGroupCheck-id-0004" targetRef="UserTask-SelfEmployedSubmitsReport-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InsuredCheckToDeadline-id-0015" sourceRef="ExclusiveGateway-InsuredGroupCheck-id-0004" targetRef="IntermediateCatchEvent-ReportingDeadline-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SchoolToDeadline-id-0016" sourceRef="UserTask-SchoolReportsAccident-id-0001" targetRef="IntermediateCatchEvent-ReportingDeadline-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelfEmployedToDeadline-id-0017" sourceRef="UserTask-SelfEmployedSubmitsReport-id-0001" targetRef="IntermediateCatchEvent-ReportingDeadline-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DeadlineToEnd-id-0018" sourceRef="IntermediateCatchEvent-ReportingDeadline-id-0001" targetRef="EndEvent-AccidentReportedToInsurance-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WorkRelatedFalseToDocument-id-0019" name="work_related = false" sourceRef="ExclusiveGateway-WorkRelatedCheck-id-0001" targetRef="UserTask-DocumentNonWorkAccident-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DocumentToTerminate-id-0020" sourceRef="UserTask-DocumentNonWorkAccident-id-0001" targetRef="EndEvent-ProcessTerminated-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process-WorkAccidentReporting-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Process-WorkAccidentReporting-id-0001" bpmnElement="Process-WorkAccidentReporting-id-0001">
