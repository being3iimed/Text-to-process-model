        <dc:Bounds x="1825" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-LANPartyComplete-id-0001_di" bpmnElement="EndEvent-LANPartyComplete-id-0001">
