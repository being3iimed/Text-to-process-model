      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PreparationSplitToCheckGames-id-0001_di" bpmnElement="SequenceFlow-PreparationSplitToCheckGames-id-0001">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
