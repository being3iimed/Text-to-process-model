        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendDateConfirmationReminder-id-0001_di" bpmnElement="SendTask-SendDateConfirmationReminder-id-0001">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
