        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-NotEnoughConfirmationsToNewDate-id-0001_di" bpmnElement="SequenceFlow-NotEnoughConfirmationsToNewDate-id-0001">
        <di:waypoint x="1000" y="70" />
