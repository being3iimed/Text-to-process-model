        <di:waypoint x="425" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BoundaryGamePreferencesToReminder-id-0001_di" bpmnElement="SequenceFlow-BoundaryGamePreferencesToReminder-id-0001">
        <di:waypoint x="375" y="128" />
