<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="LAN-Party-Planning-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0.0">
  <bpmn:process id="LAN-Party-Planning-Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-LANPartyPlanningBegins-id-0001" name="LAN Party Planning Begins">
      <bpmn:outgoing>SequenceFlow-StartToSendInvitations-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="SendTask-SendInvitations-id-0001" name="Send: invitations to 10 friends">
      <bpmn:incoming>SequenceFlow-StartToSendInvitations-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendInvitationsToReceiveGamePreferences-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveGamePreferences-id-0001" name="Receive: game preferences">
      <bpmn:incoming>SequenceFlow-SendInvitationsToReceiveGamePreferences-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GamePreferencesToAppointDate-id-0001</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer72H-GamePreferences-id-0001" name="72 Hour Timeout for Game Preferences" attachedToRef="ReceiveTask-ReceiveGamePreferences-id-0001">
      <bpmn:outgoing>SequenceFlow-BoundaryGamePreferencesToReminder-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer72H-GamePreferences-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT72H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-SendGamePreferencesReminder-id-0001" name="Send: reminder for game preferences">
      <bpmn:incoming>SequenceFlow-BoundaryGamePreferencesToReminder-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReminderToAppointDate-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-AppointPotentialDate-id-0001" name="Appoint potential date">
      <bpmn:incoming>SequenceFlow-GamePreferencesToAppointDate-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReminderToAppointDate-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AppointDateToReceiveConfirmations-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveDateConfirmations-id-0001" name="Receive: date confirmations">
      <bpmn:incoming>SequenceFlow-AppointDateToReceiveConfirmations-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReminderToDateConfirmationCheck-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NewDateToReceiveConfirmations-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DateConfirmationsToCheck-id-0001</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer48H-DateConfirmations-id-0001" name="48 Hour Timeout for Date Confirmations" attachedToRef="ReceiveTask-ReceiveDateConfirmations-id-0001">
      <bpmn:outgoing>SequenceFlow-BoundaryDateConfirmationsToReminder-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer48H-DateConfirmations-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-SendDateConfirmationReminder-id-0001" name="Send: reminder for date confirmation">
      <bpmn:incoming>SequenceFlow-BoundaryDateConfirmationsToReminder-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReminderToDateConfirmationCheck-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DateConfirmationCheck-id-0001" name="Enough confirmations?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-DateConfirmationsToCheck-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnoughConfirmationsToPreparation-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-NotEnoughConfirmationsToNewDate-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ParallelGateway-PreparationSplit-id-0001" name="Parallel Preparation" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-EnoughConfirmationsToPreparation-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PreparationSplitToCheckGames-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PreparationSplitToCalculateBeer-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-CheckGameAvailability-id-0001" name="Check game availability">
      <bpmn:incoming>SequenceFlow-PreparationSplitToCheckGames-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckGamesToGameAvailabilityCheck-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-GameAvailabilityCheck-id-0001" name="All games available?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckGamesToGameAvailabilityCheck-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AllGamesAvailableToJoin-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-MissingGamesToDownload-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-DownloadMissingGames-id-0001" name="Download missing games">
      <bpmn:incoming>SequenceFlow-MissingGamesToDownload-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DownloadGamesToJoin-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-CalculateBeerRequirements-id-0001" name="Calculate beer requirements">
      <bpmn:incoming>SequenceFlow-PreparationSplitToCalculateBeer-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateBeerToBeerCheck-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-BeerInventoryCheck-id-0001" name="Enough beer?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CalculateBeerToBeerCheck-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnoughBeerToJoin-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-NeedMoreBeerToPurchase-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-PurchaseMissingBeer-id-0001" name="Purchase missing beer">
      <bpmn:incoming>SequenceFlow-NeedMoreBeerToPurchase-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PurchaseBeerToJoin-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-PreparationJoin-id-0001" name="Preparation Complete" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-AllGamesAvailableToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DownloadGamesToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-EnoughBeerToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PurchaseBeerToJoin-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PreparationJoinToEnjoyParty-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-EnjoyLANParty-id-0001" name="Enjoy LAN party">
      <bpmn:incoming>SequenceFlow-PreparationJoinToEnjoyParty-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnjoyPartyToComplete-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-LANPartyComplete-id-0001" name="LAN Party Complete">
      <bpmn:incoming>SequenceFlow-EnjoyPartyToComplete-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-AppointNewPotentialDate-id-0001" name="Appoint new potential date">
      <bpmn:incoming>SequenceFlow-NotEnoughConfirmationsToNewDate-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NewDateToReceiveConfirmations-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-NotEnoughConfirmationsToCancelled-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-LANPartyCancelled-id-0001" name="LAN Party Cancelled">
      <bpmn:incoming>SequenceFlow-NotEnoughConfirmationsToCancelled-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSendInvitations-id-0001" sourceRef="StartEvent-LANPartyPlanningBegins-id-0001" targetRef="SendTask-SendInvitations-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendInvitationsToReceiveGamePreferences-id-0001" sourceRef="SendTask-SendInvitations-id-0001" targetRef="ReceiveTask-ReceiveGamePreferences-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GamePreferencesToAppointDate-id-0001" sourceRef="ReceiveTask-ReceiveGamePreferences-id-0001" targetRef="UserTask-AppointPotentialDate-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryGamePreferencesToReminder-id-0001" sourceRef="BoundaryEvent-Timer72H-GamePreferences-id-0001" targetRef="SendTask-SendGamePreferencesReminder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReminderToAppointDate-id-0001" sourceRef="SendTask-SendGamePreferencesReminder-id-0001" targetRef="UserTask-AppointPotentialDate-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AppointDateToReceiveConfirmations-id-0001" sourceRef="UserTask-AppointPotentialDate-id-0001" targetRef="ReceiveTask-ReceiveDateConfirmations-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryDateConfirmationsToReminder-id-0001" sourceRef="BoundaryEvent-Timer48H-DateConfirmations-id-0001" targetRef="SendTask-SendDateConfirmationReminder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReminderToDateConfirmationCheck-id-0001" sourceRef="SendTask-SendDateConfirmationReminder-id-0001" targetRef="ReceiveTask-ReceiveDateConfirmations-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DateConfirmationsToCheck-id-0001" sourceRef="ReceiveTask-ReceiveDateConfirmations-id-0001" targetRef="ExclusiveGateway-DateConfirmationCheck-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EnoughConfirmationsToPreparation-id-0001" name="confirmations &#62;= 8" sourceRef="ExclusiveGateway-DateConfirmationCheck-id-0001" targetRef="ParallelGateway-PreparationSplit-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NotEnoughConfirmationsToNewDate-id-0001" name="confirmations &#60; 8" sourceRef="ExclusiveGateway-DateConfirmationCheck-id-0001" targetRef="UserTask-AppointNewPotentialDate-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PreparationSplitToCheckGames-id-0001" sourceRef="ParallelGateway-PreparationSplit-id-0001" targetRef="ServiceTask-CheckGameAvailability-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PreparationSplitToCalculateBeer-id-0001" sourceRef="ParallelGateway-PreparationSplit-id-0001" targetRef="UserTask-CalculateBeerRequirements-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckGamesToGameAvailabilityCheck-id-0001" sourceRef="ServiceTask-CheckGameAvailability-id-0001" targetRef="ExclusiveGateway-GameAvailabilityCheck-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AllGamesAvailableToJoin-id-0001" name="all_games_available" sourceRef="ExclusiveGateway-GameAvailabilityCheck-id-0001" targetRef="ParallelGateway-PreparationJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MissingGamesToDownload-id-0001" name="!all_games_available" sourceRef="ExclusiveGateway-GameAvailabilityCheck-id-0001" targetRef="ServiceTask-DownloadMissingGames-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DownloadGamesToJoin-id-0001" sourceRef="ServiceTask-DownloadMissingGames-id-0001" targetRef="ParallelGateway-PreparationJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateBeerToBeerCheck-id-0001" sourceRef="UserTask-CalculateBeerRequirements-id-0001" targetRef="ExclusiveGateway-BeerInventoryCheck-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EnoughBeerToJoin-id-0001" name="enough_beer" sourceRef="ExclusiveGateway-BeerInventoryCheck-id-0001" targetRef="ParallelGateway-PreparationJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NeedMoreBeerToPurchase-id-0001" name="!enough_beer" sourceRef="ExclusiveGateway-BeerInventoryCheck-id-0001" targetRef="ServiceTask-PurchaseMissingBeer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PurchaseBeerToJoin-id-0001" sourceRef="ServiceTask-PurchaseMissingBeer-id-0001" targetRef="ParallelGateway-PreparationJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PreparationJoinToEnjoyParty-id-0001" sourceRef="ParallelGateway-PreparationJoin-id-0001" targetRef="UserTask-EnjoyLANParty-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EnjoyPartyToComplete-id-0001" sourceRef="UserTask-EnjoyLANParty-id-0001" targetRef="EndEvent-LANPartyComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NewDateToReceiveConfirmations-id-0001" sourceRef="UserTask-AppointNewPotentialDate-id-0001" targetRef="ReceiveTask-ReceiveDateConfirmations-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NotEnoughConfirmationsToCancelled-id-0001" sourceRef="UserTask-AppointNewPotentialDate-id-0001" targetRef="EndEvent-LANPartyCancelled-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_LAN-Party-Planning-Process">
    <bpmndi:BPMNPlane id="BPMNPlane_LAN-Party-Planning-Process" bpmnElement="LAN-Party-Planning-Process">
