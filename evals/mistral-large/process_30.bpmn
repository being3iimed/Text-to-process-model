        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1400" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AllGamesAvailableToJoin-id-0001_di" bpmnElement="SequenceFlow-AllGamesAvailableToJoin-id-0001">
        <di:waypoint x="1425" y="95" />
        <di:waypoint x="1425" y="140" />
        <di:waypoint x="1725" y="140" />
        <di:waypoint x="1725" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MissingGamesToDownload-id-0001_di" bpmnElement="SequenceFlow-MissingGamesToDownload-id-0001">
        <di:waypoint x="1450" y="70" />
        <di:waypoint x="1525" y="70" />
