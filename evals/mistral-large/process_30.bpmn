      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSendInvitations-id-0001_di" bpmnElement="SequenceFlow-StartToSendInvitations-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendInvitationsToReceiveGamePreferences-id-0001_di" bpmnElement="SequenceFlow-SendInvitationsToReceiveGamePreferences-id-0001">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
