<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_EmployeeDevelopmentProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler (https://bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Process_EmployeeDevelopmentProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-EmployeeDevelopmentProcessInitiated-id-0001" name="Employee Development Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToIdentifyNeeds-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-IdentifyDevelopmentNeeds-id-0001" name="Identify Development Needs">
      <bpmn:incoming>SequenceFlow-StartToIdentifyNeeds-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdentifyNeedsToCreatePlan-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CreatePersonalDevelopmentPlan-id-0002" name="Create Personal Development Plan">
      <bpmn:incoming>SequenceFlow-IdentifyNeedsToCreatePlan-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreatePlanToGateway-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DevelopmentPlanOptions-id-0001" name="Development Plan Options" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CreatePlanToGateway-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToTraining-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToMentorship-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToResponsibilities-id-0006</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-EnrollInTrainingPrograms-id-0001" name="Enroll in Training Programs">
      <bpmn:incoming>SequenceFlow-GatewayToTraining-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainingToSkillEnhancement-id-0007</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-AssignMentor-id-0001" name="Assign Mentor">
      <bpmn:incoming>SequenceFlow-GatewayToMentorship-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MentorshipToSkillEnhancement-id-0008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AssignAdditionalResponsibilities-id-0001" name="Assign Additional Responsibilities">
      <bpmn:incoming>SequenceFlow-GatewayToResponsibilities-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ResponsibilitiesToSkillEnhancement-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-WorkOnSkillEnhancement-id-0001" name="Work on Skill Enhancement">
      <bpmn:incoming>SequenceFlow-TrainingToSkillEnhancement-id-0007</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-MentorshipToSkillEnhancement-id-0008</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ResponsibilitiesToSkillEnhancement-id-0009</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AdditionalFeedbackToSkillEnhancement-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SkillEnhancementToFeedback-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ProvideFeedbackAndEvaluation-id-0001" name="Provide Feedback and Evaluation">
      <bpmn:incoming>SequenceFlow-SkillEnhancementToFeedback-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeedbackToMilestonesGateway-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-MilestonesReached-id-0001" name="Milestones Reached?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-FeedbackToMilestonesGateway-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MilestonesToPromotionConsideration-id-0012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-MilestonesToAdditionalFeedback-id-0013</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ConsiderForPromotion-id-0001" name="Consider for Promotion">
      <bpmn:incoming>SequenceFlow-MilestonesToPromotionConsideration-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PromotionConsiderationToReview-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConductFormalPerformanceReview-id-0001" name="Conduct Formal Performance Review">
      <bpmn:incoming>SequenceFlow-PromotionConsiderationToReview-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToPromotionGateway-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PromotionApproved-id-0001" name="Promotion Approved?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToPromotionGateway-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PromotionApprovedToFinalize-id-0016</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PromotionNotApprovedToFeedback-id-0017</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-FinalizePromotion-id-0001" name="Finalize Promotion">
      <bpmn:incoming>SequenceFlow-PromotionApprovedToFinalize-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FinalizeToParallelSplit-id-0018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-ParallelUpdates-id-0001" name="Parallel Updates" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-FinalizeToParallelSplit-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ParallelSplitToAdjustCompensation-id-0019</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ParallelSplitToUpdateRole-id-0020</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-AdjustCompensation-id-0001" name="Adjust Compensation">
      <bpmn:incoming>SequenceFlow-ParallelSplitToAdjustCompensation-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdjustCompensationToJoin-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-UpdateRoleInHRSystem-id-0001" name="Update Role in HR System">
      <bpmn:incoming>SequenceFlow-ParallelSplitToUpdateRole-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdateRoleToJoin-id-0022</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-ParallelUpdatesJoin-id-0002" name="Parallel Updates Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-AdjustCompensationToJoin-id-0021</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-UpdateRoleToJoin-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ParallelJoinToEnd-id-0023</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent-EmployeePromotedAndTransitioned-id-0001" name="Employee Promoted and Transitioned">
      <bpmn:incoming>SequenceFlow-ParallelJoinToEnd-id-0023</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-ProvideAdditionalFeedback-id-0001" name="Provide Additional Feedback">
      <bpmn:incoming>SequenceFlow-MilestonesToAdditionalFeedback-id-0013</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PromotionNotApprovedToFeedback-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdditionalFeedbackToSkillEnhancement-id-0024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow-StartToIdentifyNeeds-id-0001" sourceRef="StartEvent-EmployeeDevelopmentProcessInitiated-id-0001" targetRef="UserTask-IdentifyDevelopmentNeeds-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-IdentifyNeedsToCreatePlan-id-0002" sourceRef="UserTask-IdentifyDevelopmentNeeds-id-0001" targetRef="UserTask-CreatePersonalDevelopmentPlan-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CreatePlanToGateway-id-0003" sourceRef="UserTask-CreatePersonalDevelopmentPlan-id-0002" targetRef="ExclusiveGateway-DevelopmentPlanOptions-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToTraining-id-0004" name="development_plan_includes_training" sourceRef="ExclusiveGateway-DevelopmentPlanOptions-id-0001" targetRef="ServiceTask-EnrollInTrainingPrograms-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToMentorship-id-0005" name="development_plan_includes_mentorship" sourceRef="ExclusiveGateway-DevelopmentPlanOptions-id-0001" targetRef="UserTask-AssignMentor-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToResponsibilities-id-0006" name="development_plan_includes_responsibilities" sourceRef="ExclusiveGateway-DevelopmentPlanOptions-id-0001" targetRef="UserTask-AssignAdditionalResponsibilities-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TrainingToSkillEnhancement-id-0007" sourceRef="ServiceTask-EnrollInTrainingPrograms-id-0001" targetRef="UserTask-WorkOnSkillEnhancement-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MentorshipToSkillEnhancement-id-0008" sourceRef="UserTask-AssignMentor-id-0001" targetRef="UserTask-WorkOnSkillEnhancement-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ResponsibilitiesToSkillEnhancement-id-0009" sourceRef="UserTask-AssignAdditionalResponsibilities-id-0001" targetRef="UserTask-WorkOnSkillEnhancement-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SkillEnhancementToFeedback-id-0010" sourceRef="UserTask-WorkOnSkillEnhancement-id-0001" targetRef="UserTask-ProvideFeedbackAndEvaluation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FeedbackToMilestonesGateway-id-0011" sourceRef="UserTask-ProvideFeedbackAndEvaluation-id-0001" targetRef="ExclusiveGateway-MilestonesReached-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MilestonesToPromotionConsideration-id-0012" name="milestones_reached" sourceRef="ExclusiveGateway-MilestonesReached-id-0001" targetRef="UserTask-ConsiderForPromotion-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MilestonesToAdditionalFeedback-id-0013" sourceRef="ExclusiveGateway-MilestonesReached-id-0001" targetRef="UserTask-ProvideAdditionalFeedback-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PromotionConsiderationToReview-id-0014" sourceRef="UserTask-ConsiderForPromotion-id-0001" targetRef="UserTask-ConductFormalPerformanceReview-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToPromotionGateway-id-0015" sourceRef="UserTask-ConductFormalPerformanceReview-id-0001" targetRef="ExclusiveGateway-PromotionApproved-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PromotionApprovedToFinalize-id-0016" name="promotion_approved" sourceRef="ExclusiveGateway-PromotionApproved-id-0001" targetRef="UserTask-FinalizePromotion-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PromotionNotApprovedToFeedback-id-0017" sourceRef="ExclusiveGateway-PromotionApproved-id-0001" targetRef="UserTask-ProvideAdditionalFeedback-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FinalizeToParallelSplit-id-0018" sourceRef="UserTask-FinalizePromotion-id-0001" targetRef="ParallelGateway-ParallelUpdates-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelSplitToAdjustCompensation-id-0019" sourceRef="ParallelGateway-ParallelUpdates-id-0001" targetRef="ServiceTask-AdjustCompensation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelSplitToUpdateRole-id-0020" sourceRef="ParallelGateway-ParallelUpdates-id-0001" targetRef="ServiceTask-UpdateRoleInHRSystem-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AdjustCompensationToJoin-id-0021" sourceRef="ServiceTask-AdjustCompensation-id-0001" targetRef="ParallelGateway-ParallelUpdatesJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdateRoleToJoin-id-0022" sourceRef="ServiceTask-UpdateRoleInHRSystem-id-0001" targetRef="ParallelGateway-ParallelUpdatesJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelJoinToEnd-id-0023" sourceRef="ParallelGateway-ParallelUpdatesJoin-id-0002" targetRef="EndEvent-EmployeePromotedAndTransitioned-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AdditionalFeedbackToSkillEnhancement-id-0024" sourceRef="UserTask-ProvideAdditionalFeedback-id-0001" targetRef="UserTask-WorkOnSkillEnhancement-id-0001" />
  </bpmn:process>
