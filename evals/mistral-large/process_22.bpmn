        <di:waypoint x="1300" y="210" />
        <di:waypoint x="1425" y="210" />
        <di:waypoint x="1425" y="88" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DisagreementInvalidToForward-id-0001_di" bpmnElement="SequenceFlow-DisagreementInvalidToForward-id-0001">
        <di:waypoint x="1275" y="235" />
