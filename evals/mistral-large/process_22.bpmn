      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SubrogationPossibleToSendRequest-id-0001_di" bpmnElement="SequenceFlow-SubrogationPossibleToSendRequest-id-0001">
        <di:waypoint x="400" y="70" />
