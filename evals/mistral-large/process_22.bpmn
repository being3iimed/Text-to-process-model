      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SubrogationNotPossibleToEnd-id-0001_di" bpmnElement="SequenceFlow-SubrogationNotPossibleToEnd-id-0001">
        <di:waypoint x="375" y="95" />
