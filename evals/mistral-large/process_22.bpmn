<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions-SubrogationProcess-id-0001" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler (https://bpmn.io)" exporterVersion="1.0">
  <bpmn:process id="Process-Subrogation-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-SubrogationCaseInitiated-id-0001" name="Subrogation Case Initiated">
      <bpmn:outgoing>SequenceFlow-StartToCheckSubrogation-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CheckSubrogationPossibility-id-0001" name="Check Subrogation Possibility">
      <bpmn:incoming>SequenceFlow-StartToCheckSubrogation-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckToSubrogationPossible-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-SubrogationPossible-id-0001" name="Subrogation Possible?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckToSubrogationPossible-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubrogationPossibleToSendRequest-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SubrogationNotPossibleToEnd-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-SendPaymentRequest-id-0001" name="Send Payment Request">
      <bpmn:incoming>SequenceFlow-SubrogationPossibleToSendRequest-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendRequestToCreateReminder-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CreateReminder-id-0001" name="Create Reminder">
      <bpmn:incoming>SequenceFlow-SendRequestToCreateReminder-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreateReminderToReceiveMoney-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveMoneyOrDisagreement-id-0001" name="Receive: Money or Disagreement">
      <bpmn:incoming>SequenceFlow-CreateReminderToReceiveMoney-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveMoneyToMoneyOrDisagreement-id-0001</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer14Day-ReceiveMoneyOrDisagreement-id-0001" name="14 Day Deadline Reached" attachedToRef="ReceiveTask-ReceiveMoneyOrDisagreement-id-0001">
      <bpmn:outgoing>SequenceFlow-BoundaryToForwardToAgency-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer14Day-ReceiveMoneyOrDisagreement-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-ForwardToCollectionAgency-id-0001" name="Send: Forward to Collection Agency">
      <bpmn:incoming>SequenceFlow-BoundaryToForwardToAgency-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DisagreementInvalidToForward-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ForwardToAgencyToEnd-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-CaseClosed-id-0001" name="Case Closed">
      <bpmn:incoming>SequenceFlow-SubrogationNotPossibleToEnd-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ForwardToAgencyToEnd-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-MakeBookingToEnd-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DisagreementValidToEnd-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway-MoneyOrDisagreement-id-0001" name="Money or Disagreement?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReceiveMoneyToMoneyOrDisagreement-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MoneyReceivedToMakeBooking-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DisagreementReceivedToReview-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-MakeBooking-id-0001" name="Make Booking">
      <bpmn:incoming>SequenceFlow-MoneyReceivedToMakeBooking-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MakeBookingToEnd-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ReviewInsurantDisagreement-id-0001" name="Review Insurant&#39;s Disagreement">
      <bpmn:incoming>SequenceFlow-DisagreementReceivedToReview-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToDisagreementValid-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DisagreementValid-id-0001" name="Disagreement Valid?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToDisagreementValid-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DisagreementValidToEnd-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DisagreementInvalidToForward-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCheckSubrogation-id-0001" sourceRef="StartEvent-SubrogationCaseInitiated-id-0001" targetRef="UserTask-CheckSubrogationPossibility-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckToSubrogationPossible-id-0001" sourceRef="UserTask-CheckSubrogationPossibility-id-0001" targetRef="ExclusiveGateway-SubrogationPossible-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubrogationPossibleToSendRequest-id-0001" name="subrogation_possible" sourceRef="ExclusiveGateway-SubrogationPossible-id-0001" targetRef="ServiceTask-SendPaymentRequest-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubrogationNotPossibleToEnd-id-0001" sourceRef="ExclusiveGateway-SubrogationPossible-id-0001" targetRef="EndEvent-CaseClosed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendRequestToCreateReminder-id-0001" sourceRef="ServiceTask-SendPaymentRequest-id-0001" targetRef="ServiceTask-CreateReminder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CreateReminderToReceiveMoney-id-0001" sourceRef="ServiceTask-CreateReminder-id-0001" targetRef="ReceiveTask-ReceiveMoneyOrDisagreement-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveMoneyToMoneyOrDisagreement-id-0001" sourceRef="ReceiveTask-ReceiveMoneyOrDisagreement-id-0001" targetRef="ExclusiveGateway-MoneyOrDisagreement-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToForwardToAgency-id-0001" sourceRef="BoundaryEvent-Timer14Day-ReceiveMoneyOrDisagreement-id-0001" targetRef="SendTask-ForwardToCollectionAgency-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ForwardToAgencyToEnd-id-0001" sourceRef="SendTask-ForwardToCollectionAgency-id-0001" targetRef="EndEvent-CaseClosed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MoneyReceivedToMakeBooking-id-0001" name="money_received" sourceRef="ExclusiveGateway-MoneyOrDisagreement-id-0001" targetRef="ServiceTask-MakeBooking-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DisagreementReceivedToReview-id-0001" name="disagreement_received" sourceRef="ExclusiveGateway-MoneyOrDisagreement-id-0001" targetRef="UserTask-ReviewInsurantDisagreement-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MakeBookingToEnd-id-0001" sourceRef="ServiceTask-MakeBooking-id-0001" targetRef="EndEvent-CaseClosed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToDisagreementValid-id-0001" sourceRef="UserTask-ReviewInsurantDisagreement-id-0001" targetRef="ExclusiveGateway-DisagreementValid-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DisagreementValidToEnd-id-0001" name="disagreement_valid" sourceRef="ExclusiveGateway-DisagreementValid-id-0001" targetRef="EndEvent-CaseClosed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DisagreementInvalidToForward-id-0001" sourceRef="ExclusiveGateway-DisagreementValid-id-0001" targetRef="SendTask-ForwardToCollectionAgency-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process-Subrogation-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Process-Subrogation-id-0001" bpmnElement="Process-Subrogation-id-0001">
      <bpmndi:BPMNShape id="StartEvent-SubrogationCaseInitiated-id-0001_di" bpmnElement="StartEvent-SubrogationCaseInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CheckSubrogationPossibility-id-0001_di" bpmnElement="UserTask-CheckSubrogationPossibility-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-SubrogationPossible-id-0001_di" bpmnElement="ExclusiveGateway-SubrogationPossible-id-0001" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-SendPaymentRequest-id-0001_di" bpmnElement="ServiceTask-SendPaymentRequest-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CreateReminder-id-0001_di" bpmnElement="ServiceTask-CreateReminder-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveMoneyOrDisagreement-id-0001_di" bpmnElement="ReceiveTask-ReceiveMoneyOrDisagreement-id-0001">
