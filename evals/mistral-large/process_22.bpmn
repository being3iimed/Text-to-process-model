      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendRequestToCreateReminder-id-0001_di" bpmnElement="SequenceFlow-SendRequestToCreateReminder-id-0001">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CreateReminderToReceiveMoney-id-0001_di" bpmnElement="SequenceFlow-CreateReminderToReceiveMoney-id-0001">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveMoneyToMoneyOrDisagreement-id-0001_di" bpmnElement="SequenceFlow-ReceiveMoneyToMoneyOrDisagreement-id-0001">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="950" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BoundaryToForwardToAgency-id-0001_di" bpmnElement="SequenceFlow-BoundaryToForwardToAgency-id-0001">
        <di:waypoint x="825" y="128" />
