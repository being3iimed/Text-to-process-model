      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-Timer14Day-ReceiveMoneyOrDisagreement-id-0001_di" bpmnElement="BoundaryEvent-Timer14Day-ReceiveMoneyOrDisagreement-id-0001">
        <dc:Bounds x="807" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-MoneyOrDisagreement-id-0001_di" bpmnElement="ExclusiveGateway-MoneyOrDisagreement-id-0001" isMarkerVisible="true">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-MakeBooking-id-0001_di" bpmnElement="ServiceTask-MakeBooking-id-0001">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-CaseClosed-id-0001_di" bpmnElement="EndEvent-CaseClosed-id-0001">
        <dc:Bounds x="1407" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-ForwardToCollectionAgency-id-0001_di" bpmnElement="SendTask-ForwardToCollectionAgency-id-0001">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewInsurantDisagreement-id-0001_di" bpmnElement="UserTask-ReviewInsurantDisagreement-id-0001">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-DisagreementValid-id-0001_di" bpmnElement="ExclusiveGateway-DisagreementValid-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1250" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCheckSubrogation-id-0001_di" bpmnElement="SequenceFlow-StartToCheckSubrogation-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
