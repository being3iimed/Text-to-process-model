<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BudgetPlanningProcess-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler (https://bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="BudgetPlanningProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-BudgetPlanningInitiated-id-0001" name="Budget Planning Initiated">
      <bpmn:outgoing>SequenceFlow-StartToDraft-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-DraftBudgetPlan-id-0001" name="Draft Budget Plan">
      <bpmn:incoming>SequenceFlow-StartToDraft-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DraftToStrategic-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-StrategicAlignmentReview-id-0001" name="Strategic Alignment Review">
      <bpmn:incoming>SequenceFlow-DraftToStrategic-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StrategicToFinance-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-FinanceDepartmentReview-id-0001" name="Finance Department Review">
      <bpmn:incoming>SequenceFlow-StrategicToFinance-id-0003</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-StakeholderToFinance-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FinanceToGateway-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-FinanceFeedback-id-0001" name="Finance Feedback Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-FinanceToGateway-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToAllocate-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToAdjust-id-0007</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-AllocateBudget-id-0001" name="Allocate Budget">
      <bpmn:incoming>SequenceFlow-GatewayToAllocate-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AllocateToEnd-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-BudgetAllocated-id-0001" name="Budget Allocated and Implementation Begins">
      <bpmn:incoming>SequenceFlow-AllocateToEnd-id-0006</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-AdjustBudgetPlan-id-0001" name="Adjust Budget Plan">
      <bpmn:incoming>SequenceFlow-GatewayToAdjust-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdjustToDocument-id-0008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-DocumentAdjustments-id-0001" name="Document Adjustments">
      <bpmn:incoming>SequenceFlow-AdjustToDocument-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentToStakeholder-id-0009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-StakeholderApproval-id-0001" name="Stakeholder Approval">
      <bpmn:incoming>SequenceFlow-DocumentToStakeholder-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StakeholderToFinance-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDraft-id-0001" sourceRef="StartEvent-BudgetPlanningInitiated-id-0001" targetRef="UserTask-DraftBudgetPlan-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DraftToStrategic-id-0002" sourceRef="UserTask-DraftBudgetPlan-id-0001" targetRef="UserTask-StrategicAlignmentReview-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StrategicToFinance-id-0003" sourceRef="UserTask-StrategicAlignmentReview-id-0001" targetRef="UserTask-FinanceDepartmentReview-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FinanceToGateway-id-0004" sourceRef="UserTask-FinanceDepartmentReview-id-0001" targetRef="ExclusiveGateway-FinanceFeedback-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToAllocate-id-0005" name="feedback == &#34;approved&#34;" sourceRef="ExclusiveGateway-FinanceFeedback-id-0001" targetRef="UserTask-AllocateBudget-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AllocateToEnd-id-0006" sourceRef="UserTask-AllocateBudget-id-0001" targetRef="EndEvent-BudgetAllocated-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToAdjust-id-0007" name="feedback == &#34;needs_adjustment&#34;" sourceRef="ExclusiveGateway-FinanceFeedback-id-0001" targetRef="UserTask-AdjustBudgetPlan-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AdjustToDocument-id-0008" sourceRef="UserTask-AdjustBudgetPlan-id-0001" targetRef="ServiceTask-DocumentAdjustments-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DocumentToStakeholder-id-0009" sourceRef="ServiceTask-DocumentAdjustments-id-0001" targetRef="UserTask-StakeholderApproval-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StakeholderToFinance-id-0010" sourceRef="UserTask-StakeholderApproval-id-0001" targetRef="UserTask-FinanceDepartmentReview-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BudgetPlanningProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_BudgetPlanningProcess-id-0001" bpmnElement="BudgetPlanningProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-BudgetPlanningInitiated-id-0001_di" bpmnElement="StartEvent-BudgetPlanningInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DraftBudgetPlan-id-0001_di" bpmnElement="UserTask-DraftBudgetPlan-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-StrategicAlignmentReview-id-0001_di" bpmnElement="UserTask-StrategicAlignmentReview-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-FinanceDepartmentReview-id-0001_di" bpmnElement="UserTask-FinanceDepartmentReview-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-FinanceFeedback-id-0001_di" bpmnElement="ExclusiveGateway-FinanceFeedback-id-0001" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AllocateBudget-id-0001_di" bpmnElement="UserTask-AllocateBudget-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-BudgetAllocated-id-0001_di" bpmnElement="EndEvent-BudgetAllocated-id-0001">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AdjustBudgetPlan-id-0001_di" bpmnElement="UserTask-AdjustBudgetPlan-id-0001">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DocumentAdjustments-id-0001_di" bpmnElement="ServiceTask-DocumentAdjustments-id-0001">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-StakeholderApproval-id-0001_di" bpmnElement="UserTask-StakeholderApproval-id-0001">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToDraft-id-0001_di" bpmnElement="SequenceFlow-StartToDraft-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DraftToStrategic-id-0002_di" bpmnElement="SequenceFlow-DraftToStrategic-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-StrategicToFinance-id-0003_di" bpmnElement="SequenceFlow-StrategicToFinance-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FinanceToGateway-id-0004_di" bpmnElement="SequenceFlow-FinanceToGateway-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToAllocate-id-0005_di" bpmnElement="SequenceFlow-GatewayToAllocate-id-0005">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToAdjust-id-0007_di" bpmnElement="SequenceFlow-GatewayToAdjust-id-0007">
        <di:waypoint x="675" y="95" />
        <di:waypoint x="675" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AllocateToEnd-id-0006_di" bpmnElement="SequenceFlow-AllocateToEnd-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AdjustToDocument-id-0008_di" bpmnElement="SequenceFlow-AdjustToDocument-id-0008">
        <di:waypoint x="875" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DocumentToStakeholder-id-0009_di" bpmnElement="SequenceFlow-DocumentToStakeholder-id-0009">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-StakeholderToFinance-id-0010_di" bpmnElement="SequenceFlow-StakeholderToFinance-id-0010">
        <di:waypoint x="1125" y="250" />
        <di:waypoint x="1125" y="280" />
        <di:waypoint x="525" y="280" />
        <di:waypoint x="525" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
