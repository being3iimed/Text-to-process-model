<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ProductDevelopmentProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process_ProductDevelopment" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ProductDevelopmentInitiated-id-0001" name="Product Development Initiated">
      <bpmn:outgoing>SequenceFlow-StartToIdentifyIdea-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-IdentifyProductIdea-id-0001" name="Identify Product Idea">
      <bpmn:incoming>SequenceFlow-StartToIdentifyIdea-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdeaToResearch-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ConductInitialResearch-id-0001" name="Conduct Initial Research">
      <bpmn:incoming>SequenceFlow-IdeaToResearch-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ResearchToDraft-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-DraftDesignConcepts-id-0001" name="Draft Design Concepts">
      <bpmn:incoming>SequenceFlow-ResearchToDraft-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DraftToSelect-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectPromisingDesign-id-0001" name="Select Promising Design">
      <bpmn:incoming>SequenceFlow-DraftToSelect-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToBuild-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-BuildPrototype-id-0001" name="Build Prototype">
      <bpmn:incoming>SequenceFlow-SelectToBuild-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BuildToTest-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TestPrototype-id-0001" name="Test Prototype">
      <bpmn:incoming>SequenceFlow-BuildToTest-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TestToCollectFeedback-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-CollectFeedback-id-0001" name="Collect Feedback">
      <bpmn:incoming>SequenceFlow-TestToCollectFeedback-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CollectToFeedbackDecision-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-FeedbackDecision-id-0001" name="Feedback Requires Refinement?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CollectToFeedbackDecision-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeedbackDecisionToRefine-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-FeedbackDecisionToMerge-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-RefinePrototype-id-0001" name="Refine Prototype">
      <bpmn:incoming>SequenceFlow-FeedbackDecisionToRefine-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RefineToRetest-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-TestPrototype-id-0002" name="Test Prototype (Retest)">
      <bpmn:incoming>SequenceFlow-RefineToRetest-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RetestToReCollect-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-CollectFeedback-id-0002" name="Collect Feedback (Re-collect)">
      <bpmn:incoming>SequenceFlow-RetestToReCollect-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReCollectToMerge-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-FeedbackDecisionMerge-id-0001" name="Merge Feedback Paths" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-FeedbackDecisionToMerge-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReCollectToMerge-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MergeToFinalDecision-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-FinalDecision-id-0001" name="Final Decision">
      <bpmn:incoming>SequenceFlow-MergeToFinalDecision-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FinalDecisionToApprovalDecision-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PrototypeApproval-id-0001" name="Prototype Approved?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-FinalDecisionToApprovalDecision-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalDecisionToApproved-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ApprovalDecisionToDiscarded-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-PrototypeApproved-id-0001" name="Prototype Approved for Development">
      <bpmn:incoming>SequenceFlow-ApprovalDecisionToApproved-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-PrototypeDiscarded-id-0001" name="Prototype Discarded">
      <bpmn:incoming>SequenceFlow-ApprovalDecisionToDiscarded-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToIdentifyIdea-id-0001" sourceRef="StartEvent-ProductDevelopmentInitiated-id-0001" targetRef="UserTask-IdentifyProductIdea-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-IdeaToResearch-id-0001" sourceRef="UserTask-IdentifyProductIdea-id-0001" targetRef="ServiceTask-ConductInitialResearch-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ResearchToDraft-id-0001" sourceRef="ServiceTask-ConductInitialResearch-id-0001" targetRef="UserTask-DraftDesignConcepts-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DraftToSelect-id-0001" sourceRef="UserTask-DraftDesignConcepts-id-0001" targetRef="UserTask-SelectPromisingDesign-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToBuild-id-0001" sourceRef="UserTask-SelectPromisingDesign-id-0001" targetRef="ServiceTask-BuildPrototype-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BuildToTest-id-0001" sourceRef="ServiceTask-BuildPrototype-id-0001" targetRef="ServiceTask-TestPrototype-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TestToCollectFeedback-id-0001" sourceRef="ServiceTask-TestPrototype-id-0001" targetRef="UserTask-CollectFeedback-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CollectToFeedbackDecision-id-0001" sourceRef="UserTask-CollectFeedback-id-0001" targetRef="ExclusiveGateway-FeedbackDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FeedbackDecisionToRefine-id-0001" name="feedback_requires_refinement" sourceRef="ExclusiveGateway-FeedbackDecision-id-0001" targetRef="UserTask-RefinePrototype-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FeedbackDecisionToMerge-id-0001" sourceRef="ExclusiveGateway-FeedbackDecision-id-0001" targetRef="ExclusiveGateway-FeedbackDecisionMerge-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RefineToRetest-id-0001" sourceRef="UserTask-RefinePrototype-id-0001" targetRef="ServiceTask-TestPrototype-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-RetestToReCollect-id-0001" sourceRef="ServiceTask-TestPrototype-id-0002" targetRef="UserTask-CollectFeedback-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ReCollectToMerge-id-0001" sourceRef="UserTask-CollectFeedback-id-0002" targetRef="ExclusiveGateway-FeedbackDecisionMerge-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MergeToFinalDecision-id-0001" sourceRef="ExclusiveGateway-FeedbackDecisionMerge-id-0001" targetRef="UserTask-FinalDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FinalDecisionToApprovalDecision-id-0001" sourceRef="UserTask-FinalDecision-id-0001" targetRef="ExclusiveGateway-PrototypeApproval-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalDecisionToApproved-id-0001" name="prototype_approved" sourceRef="ExclusiveGateway-PrototypeApproval-id-0001" targetRef="EndEvent-PrototypeApproved-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalDecisionToDiscarded-id-0001" sourceRef="ExclusiveGateway-PrototypeApproval-id-0001" targetRef="EndEvent-PrototypeDiscarded-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_ProductDevelopment">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_ProductDevelopment" bpmnElement="Process_ProductDevelopment">
      <bpmndi:BPMNShape id="StartEvent-ProductDevelopmentInitiated-id-0001_di" bpmnElement="StartEvent-ProductDevelopmentInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-IdentifyProductIdea-id-0001_di" bpmnElement="UserTask-IdentifyProductIdea-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ConductInitialResearch-id-0001_di" bpmnElement="ServiceTask-ConductInitialResearch-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DraftDesignConcepts-id-0001_di" bpmnElement="UserTask-DraftDesignConcepts-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SelectPromisingDesign-id-0001_di" bpmnElement="UserTask-SelectPromisingDesign-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-BuildPrototype-id-0001_di" bpmnElement="ServiceTask-BuildPrototype-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TestPrototype-id-0001_di" bpmnElement="ServiceTask-TestPrototype-id-0001">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CollectFeedback-id-0001_di" bpmnElement="UserTask-CollectFeedback-id-0001">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-FeedbackDecision-id-0001_di" bpmnElement="ExclusiveGateway-FeedbackDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-RefinePrototype-id-0001_di" bpmnElement="UserTask-RefinePrototype-id-0001">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TestPrototype-id-0002_di" bpmnElement="ServiceTask-TestPrototype-id-0002">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CollectFeedback-id-0002_di" bpmnElement="UserTask-CollectFeedback-id-0002">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-FeedbackDecisionMerge-id-0001_di" bpmnElement="ExclusiveGateway-FeedbackDecisionMerge-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1850" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-FinalDecision-id-0001_di" bpmnElement="UserTask-FinalDecision-id-0001">
        <dc:Bounds x="1975" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PrototypeApproval-id-0001_di" bpmnElement="ExclusiveGateway-PrototypeApproval-id-0001" isMarkerVisible="true">
        <dc:Bounds x="2150" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PrototypeApproved-id-0001_di" bpmnElement="EndEvent-PrototypeApproved-id-0001">
        <dc:Bounds x="2307" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PrototypeDiscarded-id-0001_di" bpmnElement="EndEvent-PrototypeDiscarded-id-0001">
        <dc:Bounds x="2307" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToIdentifyIdea-id-0001_di" bpmnElement="SequenceFlow-StartToIdentifyIdea-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-IdeaToResearch-id-0001_di" bpmnElement="SequenceFlow-IdeaToResearch-id-0001">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ResearchToDraft-id-0001_di" bpmnElement="SequenceFlow-ResearchToDraft-id-0001">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DraftToSelect-id-0001_di" bpmnElement="SequenceFlow-DraftToSelect-id-0001">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectToBuild-id-0001_di" bpmnElement="SequenceFlow-SelectToBuild-id-0001">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BuildToTest-id-0001_di" bpmnElement="SequenceFlow-BuildToTest-id-0001">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TestToCollectFeedback-id-0001_di" bpmnElement="SequenceFlow-TestToCollectFeedback-id-0001">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CollectToFeedbackDecision-id-0001_di" bpmnElement="SequenceFlow-CollectToFeedbackDecision-id-0001">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1250" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FeedbackDecisionToRefine-id-0001_di" bpmnElement="SequenceFlow-FeedbackDecisionToRefine-id-0001">
        <di:waypoint x="1300" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FeedbackDecisionToMerge-id-0001_di" bpmnElement="SequenceFlow-FeedbackDecisionToMerge-id-0001">
        <di:waypoint x="1275" y="95" />
        <di:waypoint x="1275" y="140" />
        <di:waypoint x="1875" y="140" />
        <di:waypoint x="1875" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RefineToRetest-id-0001_di" bpmnElement="SequenceFlow-RefineToRetest-id-0001">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1525" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RetestToReCollect-id-0001_di" bpmnElement="SequenceFlow-RetestToReCollect-id-0001">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1675" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReCollectToMerge-id-0001_di" bpmnElement="SequenceFlow-ReCollectToMerge-id-0001">
        <di:waypoint x="1775" y="70" />
        <di:waypoint x="1850" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MergeToFinalDecision-id-0001_di" bpmnElement="SequenceFlow-MergeToFinalDecision-id-0001">
        <di:waypoint x="1900" y="70" />
        <di:waypoint x="1975" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FinalDecisionToApprovalDecision-id-0001_di" bpmnElement="SequenceFlow-FinalDecisionToApprovalDecision-id-0001">
        <di:waypoint x="2075" y="70" />
        <di:waypoint x="2150" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ApprovalDecisionToApproved-id-0001_di" bpmnElement="SequenceFlow-ApprovalDecisionToApproved-id-0001">
        <di:waypoint x="2200" y="70" />
        <di:waypoint x="2307" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ApprovalDecisionToDiscarded-id-0001_di" bpmnElement="SequenceFlow-ApprovalDecisionToDiscarded-id-0001">
        <di:waypoint x="2175" y="95" />
        <di:waypoint x="2175" y="210" />
        <di:waypoint x="2307" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
