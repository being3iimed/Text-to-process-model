<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="RestaurantOrderProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="RestaurantOrderProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-GuestEntersRestaurant-id-0001" name="Guest Enters Restaurant">
      <bpmn:outgoing>SequenceFlow-StartToGuestChoosesDish-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-GuestChoosesDish-id-0001" name="Guest Chooses Dish">
      <bpmn:incoming>SequenceFlow-StartToGuestChoosesDish-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GuestChoosesDishToGuestPlacesOrder-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-GuestPlacesOrder-id-0002" name="Guest Places Order">
      <bpmn:incoming>SequenceFlow-GuestChoosesDishToGuestPlacesOrder-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GuestPlacesOrderToEmployeeEntersOrder-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-EmployeeEntersOrderInPOS-id-0001" name="Employee Enters Order in POS">
      <bpmn:incoming>SequenceFlow-GuestPlacesOrderToEmployeeEntersOrder-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployeeEntersOrderToEmployeeCollectsPayment-id-0004</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-EmployeeCollectsPayment-id-0002" name="Employee Collects Payment">
      <bpmn:incoming>SequenceFlow-EmployeeEntersOrderToEmployeeCollectsPayment-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployeeCollectsPaymentToEmployeeSetsUpBuzzer-id-0005</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-EmployeeSetsUpBuzzer-id-0003" name="Employee Sets Up Buzzer">
      <bpmn:incoming>SequenceFlow-EmployeeCollectsPaymentToEmployeeSetsUpBuzzer-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployeeSetsUpBuzzerToEmployeeInformsChef-id-0006</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-EmployeeInformsChef-id-0004" name="Employee Informs Chef">
      <bpmn:incoming>SequenceFlow-EmployeeSetsUpBuzzerToEmployeeInformsChef-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployeeInformsChefToChefPreparesMeal-id-0007</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ChefPreparesMeal-id-0001" name="Chef Prepares Meal">
      <bpmn:incoming>SequenceFlow-EmployeeInformsChefToChefPreparesMeal-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ChefPreparesMealToChefPlacesMealInHatch-id-0008</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ChefPlacesMealInHatch-id-0002" name="Chef Places Meal in Hatch">
      <bpmn:incoming>SequenceFlow-ChefPreparesMealToChefPlacesMealInHatch-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ChefPlacesMealInHatchToChefNotifiesEmployee-id-0009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ChefNotifiesEmployee-id-0003" name="Chef Notifies Employee">
      <bpmn:incoming>SequenceFlow-ChefPlacesMealInHatchToChefNotifiesEmployee-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ChefNotifiesEmployeeToEmployeeTriggersBuzzer-id-0010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-EmployeeTriggersBuzzer-id-0005" name="Employee Triggers Buzzer">
      <bpmn:incoming>SequenceFlow-ChefNotifiesEmployeeToEmployeeTriggersBuzzer-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployeeTriggersBuzzerToWait5Minutes-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-Wait5Minutes-id-0001" name="Wait 5 Minutes">
      <bpmn:incoming>SequenceFlow-EmployeeTriggersBuzzerToWait5Minutes-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Wait5MinutesToEmployeeCallsGuest-id-0012</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="SendTask-EmployeeCallsGuest-id-0001" name="Employee Calls Guest">
      <bpmn:incoming>SequenceFlow-Wait5MinutesToEmployeeCallsGuest-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployeeCallsGuestToGuestCollectsMeal-id-0013</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask-GuestCollectsMeal-id-0003" name="Guest Collects Meal">
      <bpmn:incoming>SequenceFlow-EmployeeCallsGuestToGuestCollectsMeal-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GuestCollectsMealToEmployeeHandsOverMeal-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-EmployeeHandsOverMeal-id-0006" name="Employee Hands Over Meal">
      <bpmn:incoming>SequenceFlow-GuestCollectsMealToEmployeeHandsOverMeal-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EmployeeHandsOverMealToEnd-id-0015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-MealHandedOver-id-0001" name="Meal Handed Over">
      <bpmn:incoming>SequenceFlow-EmployeeHandsOverMealToEnd-id-0015</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToGuestChoosesDish-id-0001" sourceRef="StartEvent-GuestEntersRestaurant-id-0001" targetRef="UserTask-GuestChoosesDish-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GuestChoosesDishToGuestPlacesOrder-id-0002" sourceRef="UserTask-GuestChoosesDish-id-0001" targetRef="UserTask-GuestPlacesOrder-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-GuestPlacesOrderToEmployeeEntersOrder-id-0003" sourceRef="UserTask-GuestPlacesOrder-id-0002" targetRef="ServiceTask-EmployeeEntersOrderInPOS-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployeeEntersOrderToEmployeeCollectsPayment-id-0004" sourceRef="ServiceTask-EmployeeEntersOrderInPOS-id-0001" targetRef="ServiceTask-EmployeeCollectsPayment-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployeeCollectsPaymentToEmployeeSetsUpBuzzer-id-0005" sourceRef="ServiceTask-EmployeeCollectsPayment-id-0002" targetRef="ServiceTask-EmployeeSetsUpBuzzer-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployeeSetsUpBuzzerToEmployeeInformsChef-id-0006" sourceRef="ServiceTask-EmployeeSetsUpBuzzer-id-0003" targetRef="ServiceTask-EmployeeInformsChef-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployeeInformsChefToChefPreparesMeal-id-0007" sourceRef="ServiceTask-EmployeeInformsChef-id-0004" targetRef="ServiceTask-ChefPreparesMeal-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ChefPreparesMealToChefPlacesMealInHatch-id-0008" sourceRef="ServiceTask-ChefPreparesMeal-id-0001" targetRef="ServiceTask-ChefPlacesMealInHatch-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ChefPlacesMealInHatchToChefNotifiesEmployee-id-0009" sourceRef="ServiceTask-ChefPlacesMealInHatch-id-0002" targetRef="ServiceTask-ChefNotifiesEmployee-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ChefNotifiesEmployeeToEmployeeTriggersBuzzer-id-0010" sourceRef="ServiceTask-ChefNotifiesEmployee-id-0003" targetRef="ServiceTask-EmployeeTriggersBuzzer-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployeeTriggersBuzzerToWait5Minutes-id-0011" sourceRef="ServiceTask-EmployeeTriggersBuzzer-id-0005" targetRef="IntermediateCatchEvent-Wait5Minutes-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-Wait5MinutesToEmployeeCallsGuest-id-0012" sourceRef="IntermediateCatchEvent-Wait5Minutes-id-0001" targetRef="SendTask-EmployeeCallsGuest-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployeeCallsGuestToGuestCollectsMeal-id-0013" sourceRef="SendTask-EmployeeCallsGuest-id-0001" targetRef="UserTask-GuestCollectsMeal-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-GuestCollectsMealToEmployeeHandsOverMeal-id-0014" sourceRef="UserTask-GuestCollectsMeal-id-0003" targetRef="ServiceTask-EmployeeHandsOverMeal-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-EmployeeHandsOverMealToEnd-id-0015" sourceRef="ServiceTask-EmployeeHandsOverMeal-id-0006" targetRef="EndEvent-MealHandedOver-id-0001" />
  </bpmn:process>
