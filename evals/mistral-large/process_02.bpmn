<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="hiring-process-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler (https://bpmn.io)" exporterVersion="1.0">
  <bpmn:process id="HiringProcess-id-0001" name="Hiring Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-HiringNeedIdentified-id-0001" name="Hiring need identified">
      <bpmn:outgoing>SequenceFlow-StartToHRCreatesJobDescription-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-HRCreatesJobDescription-id-0001" name="HR creates job description">
      <bpmn:incoming>SequenceFlow-StartToHRCreatesJobDescription-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HRCreatesJobDescriptionToPostJob-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-PostJobOnJobBoards-id-0001" name="Post job on job boards">
      <bpmn:incoming>SequenceFlow-HRCreatesJobDescriptionToPostJob-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PostJobToScreenResumes-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ScreenResumes-id-0001" name="Screen resumes">
      <bpmn:incoming>SequenceFlow-PostJobToScreenResumes-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ScreenResumesToQualifiedCandidates-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-QualifiedCandidates-id-0001" name="Qualified candidates?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ScreenResumesToQualifiedCandidates-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-QualifiedCandidatesToConductPhoneInterviews-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-QualifiedCandidatesToSendRejectionNotice-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ConductPhoneInterviews-id-0001" name="Conduct phone interviews">
      <bpmn:incoming>SequenceFlow-QualifiedCandidatesToConductPhoneInterviews-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConductPhoneInterviewsToProceedToInterview-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ProceedToInterview-id-0001" name="Proceed to interview?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ConductPhoneInterviewsToProceedToInterview-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProceedToInterviewToScheduleInterviews-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ProceedToInterviewToSendRejectionNotice-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ScheduleInterviews-id-0001" name="Schedule in-person/virtual interviews">
      <bpmn:incoming>SequenceFlow-ProceedToInterviewToScheduleInterviews-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ScheduleInterviewsToInterviewType-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InterviewType-id-0001" name="Interview type?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ScheduleInterviewsToInterviewType-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InterviewTypeToConductInPersonInterview-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-InterviewTypeToConductVirtualInterview-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ConductInPersonInterview-id-0001" name="Conduct in-person interview">
      <bpmn:incoming>SequenceFlow-InterviewTypeToConductInPersonInterview-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConductInPersonInterviewToInterviewTypeMerge-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConductVirtualInterview-id-0001" name="Conduct virtual interview">
      <bpmn:incoming>SequenceFlow-InterviewTypeToConductVirtualInterview-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConductVirtualInterviewToInterviewTypeMerge-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InterviewTypeMerge-id-0001" name="Interview type merge" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ConductInPersonInterviewToInterviewTypeMerge-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ConductVirtualInterviewToInterviewTypeMerge-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InterviewTypeMergeToSelectFinalCandidate-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-SelectFinalCandidate-id-0001" name="Select final candidate">
      <bpmn:incoming>SequenceFlow-InterviewTypeMergeToSelectFinalCandidate-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-QualifiedCandidatesMergeToSelectFinalCandidate-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectFinalCandidateToExtendOffer-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ExtendOffer-id-0001" name="Extend offer">
      <bpmn:incoming>SequenceFlow-SelectFinalCandidateToExtendOffer-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExtendOfferToSalaryNegotiation-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SalaryNegotiation-id-0001" name="Salary negotiation">
      <bpmn:incoming>SequenceFlow-ExtendOfferToSalaryNegotiation-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SalaryNegotiationToCompleteOnboarding-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CompleteOnboardingPaperwork-id-0001" name="Complete onboarding paperwork">
      <bpmn:incoming>SequenceFlow-SalaryNegotiationToCompleteOnboarding-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CompleteOnboardingToConductOrientation-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConductOrientation-id-0001" name="Conduct orientation">
      <bpmn:incoming>SequenceFlow-CompleteOnboardingToConductOrientation-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConductOrientationToProvideTraining-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ProvideTraining-id-0001" name="Provide training">
      <bpmn:incoming>SequenceFlow-ConductOrientationToProvideTraining-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProvideTrainingToNewHireFullyIntegrated-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-NewHireFullyIntegrated-id-0001" name="New hire fully integrated">
      <bpmn:incoming>SequenceFlow-ProvideTrainingToNewHireFullyIntegrated-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask-SendRejectionNotice-id-0001" name="Send: rejection notice">
      <bpmn:incoming>SequenceFlow-QualifiedCandidatesToSendRejectionNotice-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ProceedToInterviewToSendRejectionNotice-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendRejectionNoticeToProcessTerminated-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ProcessTerminated-id-0001" name="Process terminated">
      <bpmn:incoming>SequenceFlow-SendRejectionNoticeToProcessTerminated-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ProceedToInterviewMerge-id-0001" name="Proceed to interview merge" gatewayDirection="Converging">
      <bpmn:outgoing>SequenceFlow-ProceedToInterviewMergeToQualifiedCandidatesMerge-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ExclusiveGateway-QualifiedCandidatesMerge-id-0001" name="Qualified candidates merge" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ProceedToInterviewMergeToQualifiedCandidatesMerge-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-QualifiedCandidatesMergeToSelectFinalCandidate-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow-StartToHRCreatesJobDescription-id-0001" sourceRef="StartEvent-HiringNeedIdentified-id-0001" targetRef="UserTask-HRCreatesJobDescription-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-HRCreatesJobDescriptionToPostJob-id-0001" sourceRef="UserTask-HRCreatesJobDescription-id-0001" targetRef="ServiceTask-PostJobOnJobBoards-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PostJobToScreenResumes-id-0001" sourceRef="ServiceTask-PostJobOnJobBoards-id-0001" targetRef="UserTask-ScreenResumes-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ScreenResumesToQualifiedCandidates-id-0001" sourceRef="UserTask-ScreenResumes-id-0001" targetRef="ExclusiveGateway-QualifiedCandidates-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-QualifiedCandidatesToConductPhoneInterviews-id-0001" name="qualified_candidates" sourceRef="ExclusiveGateway-QualifiedCandidates-id-0001" targetRef="UserTask-ConductPhoneInterviews-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-QualifiedCandidatesToSendRejectionNotice-id-0001" sourceRef="ExclusiveGateway-QualifiedCandidates-id-0001" targetRef="SendTask-SendRejectionNotice-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ConductPhoneInterviewsToProceedToInterview-id-0001" sourceRef="UserTask-ConductPhoneInterviews-id-0001" targetRef="ExclusiveGateway-ProceedToInterview-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProceedToInterviewToScheduleInterviews-id-0001" name="proceed_to_interview" sourceRef="ExclusiveGateway-ProceedToInterview-id-0001" targetRef="UserTask-ScheduleInterviews-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProceedToInterviewToSendRejectionNotice-id-0001" sourceRef="ExclusiveGateway-ProceedToInterview-id-0001" targetRef="SendTask-SendRejectionNotice-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ScheduleInterviewsToInterviewType-id-0001" sourceRef="UserTask-ScheduleInterviews-id-0001" targetRef="ExclusiveGateway-InterviewType-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InterviewTypeToConductInPersonInterview-id-0001" name="in_person_preferred" sourceRef="ExclusiveGateway-InterviewType-id-0001" targetRef="UserTask-ConductInPersonInterview-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InterviewTypeToConductVirtualInterview-id-0001" sourceRef="ExclusiveGateway-InterviewType-id-0001" targetRef="UserTask-ConductVirtualInterview-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ConductInPersonInterviewToInterviewTypeMerge-id-0001" sourceRef="UserTask-ConductInPersonInterview-id-0001" targetRef="ExclusiveGateway-InterviewTypeMerge-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ConductVirtualInterviewToInterviewTypeMerge-id-0001" sourceRef="UserTask-ConductVirtualInterview-id-0001" targetRef="ExclusiveGateway-InterviewTypeMerge-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InterviewTypeMergeToSelectFinalCandidate-id-0001" sourceRef="ExclusiveGateway-InterviewTypeMerge-id-0001" targetRef="UserTask-SelectFinalCandidate-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectFinalCandidateToExtendOffer-id-0001" sourceRef="UserTask-SelectFinalCandidate-id-0001" targetRef="UserTask-ExtendOffer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ExtendOfferToSalaryNegotiation-id-0001" sourceRef="UserTask-ExtendOffer-id-0001" targetRef="UserTask-SalaryNegotiation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SalaryNegotiationToCompleteOnboarding-id-0001" sourceRef="UserTask-SalaryNegotiation-id-0001" targetRef="UserTask-CompleteOnboardingPaperwork-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CompleteOnboardingToConductOrientation-id-0001" sourceRef="UserTask-CompleteOnboardingPaperwork-id-0001" targetRef="UserTask-ConductOrientation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ConductOrientationToProvideTraining-id-0001" sourceRef="UserTask-ConductOrientation-id-0001" targetRef="UserTask-ProvideTraining-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProvideTrainingToNewHireFullyIntegrated-id-0001" sourceRef="UserTask-ProvideTraining-id-0001" targetRef="EndEvent-NewHireFullyIntegrated-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendRejectionNoticeToProcessTerminated-id-0001" sourceRef="SendTask-SendRejectionNotice-id-0001" targetRef="EndEvent-ProcessTerminated-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProceedToInterviewMergeToQualifiedCandidatesMerge-id-0001" sourceRef="ExclusiveGateway-ProceedToInterviewMerge-id-0001" targetRef="ExclusiveGateway-QualifiedCandidatesMerge-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-QualifiedCandidatesMergeToSelectFinalCandidate-id-0001" sourceRef="ExclusiveGateway-QualifiedCandidatesMerge-id-0001" targetRef="UserTask-SelectFinalCandidate-id-0001" />
  </bpmn:process>
