<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="InternshipProcessDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="InternshipProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-InternshipApplicationStarted-id-0001" name="Internship Application Started">
      <bpmn:outgoing>SequenceFlow-StartToSubmit-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-SubmitInternshipPreferences-id-0001" name="Submit Internship Preferences">
      <bpmn:incoming>SequenceFlow-StartToSubmit-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubmitToGenerate-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-GenerateInternshipOffers-id-0001" name="Generate Internship Offers">
      <bpmn:incoming>SequenceFlow-SubmitToGenerate-id-0002</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-WaitForOffersToGenerate-id-0021</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-WaitForNextOfferToGenerate-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateToOfferReceived-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-OfferReceived-id-0001" name="Offer Received?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-GenerateToOfferReceived-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OfferReceivedToReview-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-OfferReceivedToWait-id-0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ReviewOffer-id-0001" name="Review Offer">
      <bpmn:incoming>SequenceFlow-OfferReceivedToReview-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToUserDecision-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-UserDecision-id-0001" name="User Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToUserDecision-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UserDecisionToAccept-id-0007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-UserDecisionToReject-id-0008</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-AcceptOffer-id-0001" name="Accept Offer">
      <bpmn:incoming>SequenceFlow-UserDecisionToAccept-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AcceptToInvalidate-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-InvalidateOtherOffers-id-0001" name="Invalidate Other Offers">
      <bpmn:incoming>SequenceFlow-AcceptToInvalidate-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InvalidateToSplit-id-0010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-PostAcceptanceSplit-id-0001" name="Post-Acceptance Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-InvalidateToSplit-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToStatusUpdates-id-0011</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToTimer-id-0012</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="SubProcess-StatusUpdateCycle-id-0001" name="Status Update Cycle">
      <bpmn:incoming>SequenceFlow-SplitToStatusUpdates-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StatusUpdatesToJoin-id-0013</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-StatusUpdatesBegin-id-0001" name="Status Updates Begin">
        <bpmn:outgoing>SequenceFlow-StartToWrite-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-WriteWeeklyStatusUpdate-id-0001" name="Write Weekly Status Update">
        <bpmn:incoming>SequenceFlow-StartToWrite-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-WriteToGenerate-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="ServiceTask-GenerateCompanyStatusUpdate-id-0001" name="Generate Company Status Update">
        <bpmn:incoming>SequenceFlow-WriteToGenerate-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GenerateToStore-id-0003</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-StoreUpdates-id-0001" name="Store Updates">
        <bpmn:incoming>SequenceFlow-GenerateToStore-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-StoreToEnd-id-0004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-AllUpdatesComplete-id-0001" name="All Updates Complete">
        <bpmn:incoming>SequenceFlow-StoreToEnd-id-0004</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToWrite-id-0001" sourceRef="StartEvent-StatusUpdatesBegin-id-0001" targetRef="UserTask-WriteWeeklyStatusUpdate-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-WriteToGenerate-id-0002" sourceRef="UserTask-WriteWeeklyStatusUpdate-id-0001" targetRef="ServiceTask-GenerateCompanyStatusUpdate-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GenerateToStore-id-0003" sourceRef="ServiceTask-GenerateCompanyStatusUpdate-id-0001" targetRef="ServiceTask-StoreUpdates-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-StoreToEnd-id-0004" sourceRef="ServiceTask-StoreUpdates-id-0001" targetRef="EndEvent-AllUpdatesComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-InternshipTimer-id-0001" name="30-Day Internship Timer">
      <bpmn:incoming>SequenceFlow-SplitToTimer-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TimerToAutoComplete-id-0014</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-TimerToJoin-id-0015</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent-InternshipAutoCompleted-id-0001" name="Internship Auto-Completed">
      <bpmn:incoming>SequenceFlow-TimerToAutoComplete-id-0014</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="ParallelGateway-PostAcceptanceJoin-id-0001" name="Post-Acceptance Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-StatusUpdatesToJoin-id-0013</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-TimerToJoin-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToRecommendations-id-0016</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-JoinToInternshipComplete-id-0019</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-SelectFriendsToRecommend-id-0001" name="Select Friends to Recommend">
      <bpmn:incoming>SequenceFlow-JoinToRecommendations-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RecommendationsToSend-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="SendTask-SendRecommendationTweets-id-0001" name="Send: Recommendation Tweets">
      <bpmn:incoming>SequenceFlow-RecommendationsToSend-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendToRecommendationsEnd-id-0018</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-RecommendationsSent-id-0001" name="Recommendations Sent">
      <bpmn:incoming>SequenceFlow-SendToRecommendationsEnd-id-0018</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-InternshipCompleted-id-0001" name="Internship Completed">
      <bpmn:incoming>SequenceFlow-JoinToInternshipComplete-id-0019</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-LogRejection-id-0001" name="Log Rejection">
      <bpmn:incoming>SequenceFlow-UserDecisionToReject-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LogRejectionToWait-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-WaitForOffers-id-0001" name="Wait for Offers">
      <bpmn:incoming>SequenceFlow-OfferReceivedToWait-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WaitForOffersToGenerate-id-0021</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-WaitForNextOffer-id-0001" name="Wait for Next Offer">
      <bpmn:incoming>SequenceFlow-LogRejectionToWait-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WaitForNextOfferToGenerate-id-0022</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSubmit-id-0001" sourceRef="StartEvent-InternshipApplicationStarted-id-0001" targetRef="UserTask-SubmitInternshipPreferences-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubmitToGenerate-id-0002" sourceRef="UserTask-SubmitInternshipPreferences-id-0001" targetRef="ServiceTask-GenerateInternshipOffers-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateToOfferReceived-id-0003" sourceRef="ServiceTask-GenerateInternshipOffers-id-0001" targetRef="ExclusiveGateway-OfferReceived-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-OfferReceivedToReview-id-0004" name="offer_received == true" sourceRef="ExclusiveGateway-OfferReceived-id-0001" targetRef="UserTask-ReviewOffer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-OfferReceivedToWait-id-0005" name="no_offers_yet" sourceRef="ExclusiveGateway-OfferReceived-id-0001" targetRef="IntermediateCatchEvent-WaitForOffers-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToUserDecision-id-0006" sourceRef="UserTask-ReviewOffer-id-0001" targetRef="ExclusiveGateway-UserDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-UserDecisionToAccept-id-0007" name="user_accepts" sourceRef="ExclusiveGateway-UserDecision-id-0001" targetRef="UserTask-AcceptOffer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-UserDecisionToReject-id-0008" name="user_rejects" sourceRef="ExclusiveGateway-UserDecision-id-0001" targetRef="ServiceTask-LogRejection-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AcceptToInvalidate-id-0009" sourceRef="UserTask-AcceptOffer-id-0001" targetRef="ServiceTask-InvalidateOtherOffers-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InvalidateToSplit-id-0010" sourceRef="ServiceTask-InvalidateOtherOffers-id-0001" targetRef="ParallelGateway-PostAcceptanceSplit-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToStatusUpdates-id-0011" sourceRef="ParallelGateway-PostAcceptanceSplit-id-0001" targetRef="SubProcess-StatusUpdateCycle-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToTimer-id-0012" sourceRef="ParallelGateway-PostAcceptanceSplit-id-0001" targetRef="IntermediateCatchEvent-InternshipTimer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StatusUpdatesToJoin-id-0013" sourceRef="SubProcess-StatusUpdateCycle-id-0001" targetRef="ParallelGateway-PostAcceptanceJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TimerToAutoComplete-id-0014" sourceRef="IntermediateCatchEvent-InternshipTimer-id-0001" targetRef="EndEvent-InternshipAutoCompleted-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TimerToJoin-id-0015" sourceRef="IntermediateCatchEvent-InternshipTimer-id-0001" targetRef="ParallelGateway-PostAcceptanceJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToRecommendations-id-0016" sourceRef="ParallelGateway-PostAcceptanceJoin-id-0001" targetRef="UserTask-SelectFriendsToRecommend-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RecommendationsToSend-id-0017" sourceRef="UserTask-SelectFriendsToRecommend-id-0001" targetRef="SendTask-SendRecommendationTweets-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendToRecommendationsEnd-id-0018" sourceRef="SendTask-SendRecommendationTweets-id-0001" targetRef="EndEvent-RecommendationsSent-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToInternshipComplete-id-0019" sourceRef="ParallelGateway-PostAcceptanceJoin-id-0001" targetRef="EndEvent-InternshipCompleted-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-LogRejectionToWait-id-0020" sourceRef="ServiceTask-LogRejection-id-0001" targetRef="IntermediateCatchEvent-WaitForNextOffer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WaitForOffersToGenerate-id-0021" sourceRef="IntermediateCatchEvent-WaitForOffers-id-0001" targetRef="ServiceTask-GenerateInternshipOffers-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WaitForNextOfferToGenerate-id-0022" sourceRef="IntermediateCatchEvent-WaitForNextOffer-id-0001" targetRef="ServiceTask-GenerateInternshipOffers-id-0001" />
  </bpmn:process>
