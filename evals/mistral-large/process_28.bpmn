        <dc:Bounds x="1707" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-InternshipCompleted-id-0001_di" bpmnElement="EndEvent-InternshipCompleted-id-0001">
