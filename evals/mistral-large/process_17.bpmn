<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ecommerce-order-fulfillment-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler (https://bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="ECommerceOrderFulfillmentProcess-id-0001" name="E-Commerce Order Fulfillment" isExecutable="true">
    <bpmn:startEvent id="StartEvent-OrderPlaced-id-0001" name="Order Placed">
      <bpmn:outgoing>SequenceFlow-StartToRecord-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-RecordOrderDetails-id-0001" name="Record Order Details">
      <bpmn:incoming>SequenceFlow-StartToRecord-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RecordToPayment-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ProcessPayment-id-0001" name="Process Payment">
      <bpmn:incoming>SequenceFlow-RecordToPayment-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PaymentToGateway-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PaymentStatus-id-0001" name="Payment Successful?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-PaymentToGateway-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PaymentFailed-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PaymentSuccess-id-0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-PaymentFailureNotification-id-0001" name="Send: payment failure notification">
      <bpmn:incoming>SequenceFlow-PaymentFailed-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FailureNotifyToEnd-id-0027</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-PaymentFailed-id-0001" name="Payment Failed">
      <bpmn:incoming>SequenceFlow-FailureNotifyToEnd-id-0027</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask-CheckStockAvailability-id-0001" name="Check Stock Availability">
      <bpmn:incoming>SequenceFlow-PaymentSuccess-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StockToGateway-id-0006</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-StockStatus-id-0001" name="Items In Stock?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StockToGateway-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InStock-id-0007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-BackOrder-id-0008</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-BackOrderNotification-id-0001" name="Send: back-order notification">
      <bpmn:incoming>SequenceFlow-BackOrder-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BackOrderNotifyToReceive-id-0009</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-BackOrderItems-id-0001" name="Receive: back-order items">
      <bpmn:incoming>SequenceFlow-BackOrderNotifyToReceive-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BackOrderToPrep-id-0010</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:subProcess id="SubProcess-FulfillmentPreparation-id-0001" name="Fulfillment Preparation">
      <bpmn:incoming>SequenceFlow-InStock-id-0007</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-BackOrderToPrep-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepToShippingDocs-id-0011</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-PreparationStart-id-0001" name="Preparation Start">
        <bpmn:outgoing>SequenceFlow-SubStartToPick-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-PickItemsFromWarehouse-id-0001" name="Pick Items from Warehouse">
        <bpmn:incoming>SequenceFlow-SubStartToPick-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PickToQC-id-0002</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-PerformQualityControl-id-0001" name="Perform Quality Control">
        <bpmn:incoming>SequenceFlow-PickToQC-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-QCToGiftWrapCheck-id-0003</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-GiftWrap-id-0001" name="Gift Wrap Requested?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-QCToGiftWrapCheck-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GiftWrapYes-id-0004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GiftWrapNo-id-0005</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-AddGiftWrapping-id-0001" name="Add Gift Wrapping">
        <bpmn:incoming>SequenceFlow-GiftWrapYes-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-WrapToPackage-id-0006</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-PackageItems-id-0001" name="Package Items">
        <bpmn:incoming>SequenceFlow-GiftWrapNo-id-0005</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-WrapToPackage-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PackageToEnd-id-0007</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-PreparationComplete-id-0001" name="Preparation Complete">
        <bpmn:incoming>SequenceFlow-PackageToEnd-id-0007</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-SubStartToPick-id-0001" sourceRef="StartEvent-PreparationStart-id-0001" targetRef="ServiceTask-PickItemsFromWarehouse-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PickToQC-id-0002" sourceRef="ServiceTask-PickItemsFromWarehouse-id-0001" targetRef="ServiceTask-PerformQualityControl-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-QCToGiftWrapCheck-id-0003" sourceRef="ServiceTask-PerformQualityControl-id-0001" targetRef="ExclusiveGateway-GiftWrap-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GiftWrapYes-id-0004" name="gift_wrap_requested" sourceRef="ExclusiveGateway-GiftWrap-id-0001" targetRef="ServiceTask-AddGiftWrapping-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GiftWrapNo-id-0005" sourceRef="ExclusiveGateway-GiftWrap-id-0001" targetRef="ServiceTask-PackageItems-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-WrapToPackage-id-0006" sourceRef="ServiceTask-AddGiftWrapping-id-0001" targetRef="ServiceTask-PackageItems-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PackageToEnd-id-0007" sourceRef="ServiceTask-PackageItems-id-0001" targetRef="EndEvent-PreparationComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="ParallelGateway-ShippingDocs-id-0001" name="Prepare Shipping Documents" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-PrepToShippingDocs-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ShippingDocsToDocsTask-id-0012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ShippingDocsToIntlCheck-id-0013</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-PrepareShippingDocuments-id-0001" name="Prepare Shipping Documents">
      <bpmn:incoming>SequenceFlow-ShippingDocsToDocsTask-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocsToJoin-id-0014</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InternationalOrder-id-0001" name="International Order?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ShippingDocsToIntlCheck-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IntlCheckToCustoms-id-0015</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-IntlCheckToJoin-id-0016</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-PrepareCustomsDocumentation-id-0001" name="Prepare Customs Documentation">
      <bpmn:incoming>SequenceFlow-IntlCheckToCustoms-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomsToJoin-id-0017</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-ShippingDocsJoin-id-0002" name="Shipping Docs Complete" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-DocsToJoin-id-0014</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-IntlCheckToJoin-id-0016</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CustomsToJoin-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToDispatch-id-0018</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-DispatchOrder-id-0001" name="Dispatch Order">
      <bpmn:incoming>SequenceFlow-JoinToDispatch-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DispatchToConfirmation-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-ShippingConfirmation-id-0001" name="Send: shipping confirmation">
      <bpmn:incoming>SequenceFlow-DispatchToConfirmation-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConfirmationToInventory-id-0020</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-UpdateInventoryLevels-id-0001" name="Update Inventory Levels">
      <bpmn:incoming>SequenceFlow-ConfirmationToInventory-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InventoryToFeedback-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-FeedbackRequest-id-0001" name="Send: feedback request">
      <bpmn:incoming>SequenceFlow-InventoryToFeedback-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeedbackToDelivery-id-0022</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-DeliveryConfirmation-id-0001" name="Receive: delivery confirmation">
      <bpmn:incoming>SequenceFlow-FeedbackToDelivery-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeliveryToIssuesCheck-id-0023</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-IssuesReported-id-0001" name="Customer Reports Issues?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-DeliveryToIssuesCheck-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IssuesYes-id-0024</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-IssuesNo-id-0025</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess-ReturnsProcess-id-0001" name="Returns Process">
      <bpmn:incoming>SequenceFlow-IssuesYes-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReturnsToEnd-id-0026</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-ReturnInitiated-id-0001" name="Return Initiated">
        <bpmn:outgoing>SequenceFlow-ReturnStartToLabel-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="SendTask-ReturnShippingLabel-id-0001" name="Send: return shipping label">
        <bpmn:incoming>SequenceFlow-ReturnStartToLabel-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-LabelToReceive-id-0002</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask-ReturnedItems-id-0001" name="Receive: returned items">
        <bpmn:incoming>SequenceFlow-LabelToReceive-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReceiveToInspect-id-0003</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:serviceTask id="ServiceTask-InspectReturnedItems-id-0001" name="Inspect Returned Items">
        <bpmn:incoming>SequenceFlow-ReceiveToInspect-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-InspectToDecision-id-0004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-RefundOrReplace-id-0001" name="Refund or Replace?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-InspectToDecision-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RefundPath-id-0005</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-ReplacePath-id-0006</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-ProcessRefund-id-0001" name="Process Refund">
        <bpmn:incoming>SequenceFlow-RefundPath-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RefundToEnd-id-0007</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-ProcessReplacement-id-0001" name="Process Replacement">
        <bpmn:incoming>SequenceFlow-ReplacePath-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReplaceToEnd-id-0008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-ReturnsProcessComplete-id-0001" name="Returns Process Complete">
        <bpmn:incoming>SequenceFlow-RefundToEnd-id-0007</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ReplaceToEnd-id-0008</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-ReturnStartToLabel-id-0001" sourceRef="StartEvent-ReturnInitiated-id-0001" targetRef="SendTask-ReturnShippingLabel-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-LabelToReceive-id-0002" sourceRef="SendTask-ReturnShippingLabel-id-0001" targetRef="ReceiveTask-ReturnedItems-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReceiveToInspect-id-0003" sourceRef="ReceiveTask-ReturnedItems-id-0001" targetRef="ServiceTask-InspectReturnedItems-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-InspectToDecision-id-0004" sourceRef="ServiceTask-InspectReturnedItems-id-0001" targetRef="ExclusiveGateway-RefundOrReplace-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-RefundPath-id-0005" name="refund_approved" sourceRef="ExclusiveGateway-RefundOrReplace-id-0001" targetRef="ServiceTask-ProcessRefund-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReplacePath-id-0006" sourceRef="ExclusiveGateway-RefundOrReplace-id-0001" targetRef="ServiceTask-ProcessReplacement-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-RefundToEnd-id-0007" sourceRef="ServiceTask-ProcessRefund-id-0001" targetRef="EndEvent-ReturnsProcessComplete-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReplaceToEnd-id-0008" sourceRef="ServiceTask-ProcessReplacement-id-0001" targetRef="EndEvent-ReturnsProcessComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent-OrderFulfillmentComplete-id-0001" name="Order Fulfillment Complete">
      <bpmn:incoming>SequenceFlow-IssuesNo-id-0025</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReturnsToEnd-id-0026</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToRecord-id-0001" sourceRef="StartEvent-OrderPlaced-id-0001" targetRef="UserTask-RecordOrderDetails-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RecordToPayment-id-0002" sourceRef="UserTask-RecordOrderDetails-id-0001" targetRef="ServiceTask-ProcessPayment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PaymentToGateway-id-0003" sourceRef="ServiceTask-ProcessPayment-id-0001" targetRef="ExclusiveGateway-PaymentStatus-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PaymentFailed-id-0004" sourceRef="ExclusiveGateway-PaymentStatus-id-0001" targetRef="SendTask-PaymentFailureNotification-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PaymentSuccess-id-0005" name="payment_successful" sourceRef="ExclusiveGateway-PaymentStatus-id-0001" targetRef="ServiceTask-CheckStockAvailability-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StockToGateway-id-0006" sourceRef="ServiceTask-CheckStockAvailability-id-0001" targetRef="ExclusiveGateway-StockStatus-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InStock-id-0007" name="items_in_stock" sourceRef="ExclusiveGateway-StockStatus-id-0001" targetRef="SubProcess-FulfillmentPreparation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BackOrder-id-0008" sourceRef="ExclusiveGateway-StockStatus-id-0001" targetRef="SendTask-BackOrderNotification-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BackOrderNotifyToReceive-id-0009" sourceRef="SendTask-BackOrderNotification-id-0001" targetRef="ReceiveTask-BackOrderItems-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BackOrderToPrep-id-0010" sourceRef="ReceiveTask-BackOrderItems-id-0001" targetRef="SubProcess-FulfillmentPreparation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepToShippingDocs-id-0011" sourceRef="SubProcess-FulfillmentPreparation-id-0001" targetRef="ParallelGateway-ShippingDocs-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ShippingDocsToDocsTask-id-0012" sourceRef="ParallelGateway-ShippingDocs-id-0001" targetRef="ServiceTask-PrepareShippingDocuments-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ShippingDocsToIntlCheck-id-0013" sourceRef="ParallelGateway-ShippingDocs-id-0001" targetRef="ExclusiveGateway-InternationalOrder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DocsToJoin-id-0014" sourceRef="ServiceTask-PrepareShippingDocuments-id-0001" targetRef="ParallelGateway-ShippingDocsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-IntlCheckToCustoms-id-0015" name="international_order" sourceRef="ExclusiveGateway-InternationalOrder-id-0001" targetRef="ServiceTask-PrepareCustomsDocumentation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-IntlCheckToJoin-id-0016" sourceRef="ExclusiveGateway-InternationalOrder-id-0001" targetRef="ParallelGateway-ShippingDocsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomsToJoin-id-0017" sourceRef="ServiceTask-PrepareCustomsDocumentation-id-0001" targetRef="ParallelGateway-ShippingDocsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToDispatch-id-0018" sourceRef="ParallelGateway-ShippingDocsJoin-id-0002" targetRef="ServiceTask-DispatchOrder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DispatchToConfirmation-id-0019" sourceRef="ServiceTask-DispatchOrder-id-0001" targetRef="SendTask-ShippingConfirmation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ConfirmationToInventory-id-0020" sourceRef="SendTask-ShippingConfirmation-id-0001" targetRef="ServiceTask-UpdateInventoryLevels-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InventoryToFeedback-id-0021" sourceRef="ServiceTask-UpdateInventoryLevels-id-0001" targetRef="SendTask-FeedbackRequest-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FeedbackToDelivery-id-0022" sourceRef="SendTask-FeedbackRequest-id-0001" targetRef="ReceiveTask-DeliveryConfirmation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DeliveryToIssuesCheck-id-0023" sourceRef="ReceiveTask-DeliveryConfirmation-id-0001" targetRef="ExclusiveGateway-IssuesReported-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-IssuesYes-id-0024" name="customer_reports_issues" sourceRef="ExclusiveGateway-IssuesReported-id-0001" targetRef="SubProcess-ReturnsProcess-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-IssuesNo-id-0025" sourceRef="ExclusiveGateway-IssuesReported-id-0001" targetRef="EndEvent-OrderFulfillmentComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReturnsToEnd-id-0026" sourceRef="SubProcess-ReturnsProcess-id-0001" targetRef="EndEvent-OrderFulfillmentComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FailureNotifyToEnd-id-0027" sourceRef="SendTask-PaymentFailureNotification-id-0001" targetRef="EndEvent-PaymentFailed-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ECommerceOrderFulfillmentProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_ECommerceOrderFulfillmentProcess-id-0001" bpmnElement="ECommerceOrderFulfillmentProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-OrderPlaced-id-0001_di" bpmnElement="StartEvent-OrderPlaced-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-RecordOrderDetails-id-0001_di" bpmnElement="UserTask-RecordOrderDetails-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcessPayment-id-0001_di" bpmnElement="ServiceTask-ProcessPayment-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PaymentStatus-id-0001_di" bpmnElement="ExclusiveGateway-PaymentStatus-id-0001" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-PaymentFailureNotification-id-0001_di" bpmnElement="SendTask-PaymentFailureNotification-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PaymentFailed-id-0001_di" bpmnElement="EndEvent-PaymentFailed-id-0001">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CheckStockAvailability-id-0001_di" bpmnElement="ServiceTask-CheckStockAvailability-id-0001">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-StockStatus-id-0001_di" bpmnElement="ExclusiveGateway-StockStatus-id-0001" isMarkerVisible="true">
        <dc:Bounds x="800" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-FulfillmentPreparation-id-0001_di" bpmnElement="SubProcess-FulfillmentPreparation-id-0001">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-ShippingDocs-id-0001_di" bpmnElement="ParallelGateway-ShippingDocs-id-0001">
        <dc:Bounds x="1100" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PrepareShippingDocuments-id-0001_di" bpmnElement="ServiceTask-PrepareShippingDocuments-id-0001">
        <dc:Bounds x="1225" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-ShippingDocsJoin-id-0002_di" bpmnElement="ParallelGateway-ShippingDocsJoin-id-0002">
        <dc:Bounds x="1550" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-DispatchOrder-id-0001_di" bpmnElement="ServiceTask-DispatchOrder-id-0001">
        <dc:Bounds x="1675" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-ShippingConfirmation-id-0001_di" bpmnElement="SendTask-ShippingConfirmation-id-0001">
        <dc:Bounds x="1825" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-UpdateInventoryLevels-id-0001_di" bpmnElement="ServiceTask-UpdateInventoryLevels-id-0001">
