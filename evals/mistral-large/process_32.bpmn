<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="FarmingBotProcess-Definitions-id-0001" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="FarmingBotProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-StartFarmingBotSetup-id-0001" name="Start Farming Bot Setup">
      <bpmn:outgoing>SequenceFlow-StartToSelectResources-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-SelectResources-id-0001" name="Select Resources">
      <bpmn:incoming>SequenceFlow-StartToSelectResources-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToResolveDependencies-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ResolveDependencies-id-0001" name="Resolve Dependencies">
      <bpmn:incoming>SequenceFlow-SelectToResolveDependencies-id-0002</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-UpdatePreferencesToResolveDependencies-id-0034</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PreferenceUpdateToResolveDependencies-id-0035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ResolveToDeployBotsSplit-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-DeployBotsSplit-id-0001" name="Deploy Bots" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ResolveToDeployBotsSplit-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource1-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource2-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource3-id-0006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource4-id-0007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource5-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource6-id-0009</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource7-id-0010</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource8-id-0011</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource9-id-0012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DeployBotsSplitToResource10-id-0013</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource1-id-0001" name="Deploy Bot to Resource 1">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource1-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource1ToDeployBotsJoin-id-0014</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource2-id-0002" name="Deploy Bot to Resource 2">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource2-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource2ToDeployBotsJoin-id-0015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource3-id-0003" name="Deploy Bot to Resource 3">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource3-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource3ToDeployBotsJoin-id-0016</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource4-id-0004" name="Deploy Bot to Resource 4">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource4-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource4ToDeployBotsJoin-id-0017</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource5-id-0005" name="Deploy Bot to Resource 5">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource5-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource5ToDeployBotsJoin-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource6-id-0006" name="Deploy Bot to Resource 6">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource6-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource6ToDeployBotsJoin-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource7-id-0007" name="Deploy Bot to Resource 7">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource7-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource7ToDeployBotsJoin-id-0020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource8-id-0008" name="Deploy Bot to Resource 8">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource8-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource8ToDeployBotsJoin-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource9-id-0009" name="Deploy Bot to Resource 9">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource9-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource9ToDeployBotsJoin-id-0022</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-DeployBotToResource10-id-0010" name="Deploy Bot to Resource 10">
      <bpmn:incoming>SequenceFlow-DeployBotsSplitToResource10-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Resource10ToDeployBotsJoin-id-0023</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-DeployBotsJoin-id-0002" name="Synchronize Bots" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-Resource1ToDeployBotsJoin-id-0014</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Resource2ToDeployBotsJoin-id-0015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Resource3ToDeployBotsJoin-id-0016</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Resource4ToDeployBotsJoin-id-0017</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Resource5ToDeployBotsJoin-id-0018</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Resource6ToDeployBotsJoin-id-0019</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Resource7ToDeployBotsJoin-id-0020</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Resource8ToDeployBotsJoin-id-0021</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Resource9ToDeployBotsJoin-id-0022</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Resource10ToDeployBotsJoin-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeployBotsJoinToDisasterCheck-id-0024</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-DisasterCheckTimer-id-0001" name="Disaster Check Timer">
      <bpmn:incoming>SequenceFlow-DeployBotsJoinToDisasterCheck-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DisasterCheckToCheckDisasters-id-0025</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ServiceTask-CheckForDisasters-id-0001" name="Check for Disasters">
      <bpmn:incoming>SequenceFlow-DisasterCheckToCheckDisasters-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckDisastersToDisasterDetected-id-0026</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DisasterDetected-id-0001" name="Disaster Detected?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckDisastersToDisasterDetected-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DisasterDetectedToRecovery-id-0027</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DisasterDetectedToCheckMilestones-id-0028</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess-DisasterRecovery-id-0001" name="Disaster Recovery">
      <bpmn:incoming>SequenceFlow-DisasterDetectedToRecovery-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RecoveryToCheckMilestones-id-0029</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-RecoveryStarted-id-0001" name="Recovery Started">
        <bpmn:outgoing>SequenceFlow-RecoveryStartToAssess-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-AssessDamage-id-0001" name="Assess Damage">
        <bpmn:incoming>SequenceFlow-RecoveryStartToAssess-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AssessToDisasterType-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-DisasterType-id-0001" name="Disaster Type" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-AssessToDisasterType-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-DisasterTypeToRepair-id-0003</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-DisasterTypeToWater-id-0004</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-RepairTools-id-0001" name="Repair Tools">
        <bpmn:incoming>SequenceFlow-DisasterTypeToRepair-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RepairToRecoveryEnd-id-0005</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-FindWaterSource-id-0001" name="Find Water Source">
        <bpmn:incoming>SequenceFlow-DisasterTypeToWater-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-WaterToRecoveryEnd-id-0006</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-RecoveryComplete-id-0001" name="Recovery Complete">
        <bpmn:incoming>SequenceFlow-RepairToRecoveryEnd-id-0005</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-WaterToRecoveryEnd-id-0006</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-RecoveryStartToAssess-id-0001" sourceRef="StartEvent-RecoveryStarted-id-0001" targetRef="UserTask-AssessDamage-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-AssessToDisasterType-id-0002" sourceRef="UserTask-AssessDamage-id-0001" targetRef="ExclusiveGateway-DisasterType-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-DisasterTypeToRepair-id-0003" name="disaster == &#34;storm&#34;" sourceRef="ExclusiveGateway-DisasterType-id-0001" targetRef="ServiceTask-RepairTools-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-DisasterTypeToWater-id-0004" name="disaster == &#34;drought&#34;" sourceRef="ExclusiveGateway-DisasterType-id-0001" targetRef="ServiceTask-FindWaterSource-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-RepairToRecoveryEnd-id-0005" sourceRef="ServiceTask-RepairTools-id-0001" targetRef="EndEvent-RecoveryComplete-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-WaterToRecoveryEnd-id-0006" sourceRef="ServiceTask-FindWaterSource-id-0001" targetRef="EndEvent-RecoveryComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:scriptTask id="ScriptTask-CheckMilestones-id-0001" name="Check Milestones">
      <bpmn:incoming>SequenceFlow-DisasterDetectedToCheckMilestones-id-0028</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-RecoveryToCheckMilestones-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckMilestonesToMilestoneReached-id-0030</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-MilestoneReached-id-0001" name="Milestone Reached?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckMilestonesToMilestoneReached-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MilestoneReachedToNotification-id-0031</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-MilestoneReachedToUpdatePreferences-id-0032</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess-MilestoneNotification-id-0001" name="Milestone Notification">
      <bpmn:incoming>SequenceFlow-MilestoneReachedToNotification-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotificationToUpdatePreferences-id-0033</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-NotificationTriggered-id-0001" name="Notification Triggered">
        <bpmn:outgoing>SequenceFlow-NotificationToSend-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="SendTask-MilestoneNotification-id-0001" name="Send Milestone Notification">
        <bpmn:incoming>SequenceFlow-NotificationToSend-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SendToSelectFriends-id-0002</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="UserTask-SelectFriendsToBragSend-id-0001" name="Select Friends to Brag/Send">
        <bpmn:incoming>SequenceFlow-SendToSelectFriends-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SelectToBragOrSend-id-0003</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-BragOrSend-id-0001" name="Brag or Send?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-SelectToBragOrSend-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BragOrSendToBrag-id-0004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-BragOrSendToSend-id-0005</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SendTask-BraggingMessage-id-0001" name="Send Bragging Message">
        <bpmn:incoming>SequenceFlow-BragOrSendToBrag-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BragToNotificationEnd-id-0006</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="SendTask-SendResources-id-0001" name="Send Resources">
        <bpmn:incoming>SequenceFlow-BragOrSendToSend-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SendToNotificationEnd-id-0007</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="EndEvent-NotificationComplete-id-0001" name="Notification Complete">
        <bpmn:incoming>SequenceFlow-BragToNotificationEnd-id-0006</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SendToNotificationEnd-id-0007</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-NotificationToSend-id-0001" sourceRef="StartEvent-NotificationTriggered-id-0001" targetRef="SendTask-MilestoneNotification-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SendToSelectFriends-id-0002" sourceRef="SendTask-MilestoneNotification-id-0001" targetRef="UserTask-SelectFriendsToBragSend-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SelectToBragOrSend-id-0003" sourceRef="UserTask-SelectFriendsToBragSend-id-0001" targetRef="ExclusiveGateway-BragOrSend-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BragOrSendToBrag-id-0004" name="action == &#34;brag&#34;" sourceRef="ExclusiveGateway-BragOrSend-id-0001" targetRef="SendTask-BraggingMessage-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BragOrSendToSend-id-0005" name="action == &#34;send&#34;" sourceRef="ExclusiveGateway-BragOrSend-id-0001" targetRef="SendTask-SendResources-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BragToNotificationEnd-id-0006" sourceRef="SendTask-BraggingMessage-id-0001" targetRef="EndEvent-NotificationComplete-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SendToNotificationEnd-id-0007" sourceRef="SendTask-SendResources-id-0001" targetRef="EndEvent-NotificationComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask-UpdatePreferences-id-0001" name="Update Preferences">
      <bpmn:incoming>SequenceFlow-MilestoneReachedToUpdatePreferences-id-0032</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NotificationToUpdatePreferences-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-UpdatePreferencesToResolveDependencies-id-0034</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-UpdatePreferencesToFarmingComplete-id-0036</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-FarmingComplete-id-0001" name="Farming Complete">
      <bpmn:incoming>SequenceFlow-UpdatePreferencesToFarmingComplete-id-0036</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BoundaryEvent-PreferenceUpdateSignal-id-0001" name="Preference Update Signal" attachedToRef="ServiceTask-ResolveDependencies-id-0001">
      <bpmn:outgoing>SequenceFlow-PreferenceUpdateToResolveDependencies-id-0035</bpmn:outgoing>
      <bpmn:signalEventDefinition id="BoundaryEvent-PreferenceUpdateSignal-id-0001_EventDef" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSelectResources-id-0001" sourceRef="StartEvent-StartFarmingBotSetup-id-0001" targetRef="UserTask-SelectResources-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToResolveDependencies-id-0002" sourceRef="UserTask-SelectResources-id-0001" targetRef="ServiceTask-ResolveDependencies-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ResolveToDeployBotsSplit-id-0003" sourceRef="ServiceTask-ResolveDependencies-id-0001" targetRef="ParallelGateway-DeployBotsSplit-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource1-id-0004" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource1-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource2-id-0005" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource2-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource3-id-0006" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource3-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource4-id-0007" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource4-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource5-id-0008" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource5-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource6-id-0009" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource6-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource7-id-0010" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource7-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource8-id-0011" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource8-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource9-id-0012" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource9-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsSplitToResource10-id-0013" sourceRef="ParallelGateway-DeployBotsSplit-id-0001" targetRef="ServiceTask-DeployBotToResource10-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource1ToDeployBotsJoin-id-0014" sourceRef="ServiceTask-DeployBotToResource1-id-0001" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource2ToDeployBotsJoin-id-0015" sourceRef="ServiceTask-DeployBotToResource2-id-0002" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource3ToDeployBotsJoin-id-0016" sourceRef="ServiceTask-DeployBotToResource3-id-0003" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource4ToDeployBotsJoin-id-0017" sourceRef="ServiceTask-DeployBotToResource4-id-0004" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource5ToDeployBotsJoin-id-0018" sourceRef="ServiceTask-DeployBotToResource5-id-0005" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource6ToDeployBotsJoin-id-0019" sourceRef="ServiceTask-DeployBotToResource6-id-0006" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource7ToDeployBotsJoin-id-0020" sourceRef="ServiceTask-DeployBotToResource7-id-0007" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource8ToDeployBotsJoin-id-0021" sourceRef="ServiceTask-DeployBotToResource8-id-0008" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource9ToDeployBotsJoin-id-0022" sourceRef="ServiceTask-DeployBotToResource9-id-0009" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Resource10ToDeployBotsJoin-id-0023" sourceRef="ServiceTask-DeployBotToResource10-id-0010" targetRef="ParallelGateway-DeployBotsJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployBotsJoinToDisasterCheck-id-0024" sourceRef="ParallelGateway-DeployBotsJoin-id-0002" targetRef="IntermediateCatchEvent-DisasterCheckTimer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DisasterCheckToCheckDisasters-id-0025" sourceRef="IntermediateCatchEvent-DisasterCheckTimer-id-0001" targetRef="ServiceTask-CheckForDisasters-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckDisastersToDisasterDetected-id-0026" sourceRef="ServiceTask-CheckForDisasters-id-0001" targetRef="ExclusiveGateway-DisasterDetected-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DisasterDetectedToRecovery-id-0027" name="disaster_detected == true" sourceRef="ExclusiveGateway-DisasterDetected-id-0001" targetRef="SubProcess-DisasterRecovery-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DisasterDetectedToCheckMilestones-id-0028" sourceRef="ExclusiveGateway-DisasterDetected-id-0001" targetRef="ScriptTask-CheckMilestones-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RecoveryToCheckMilestones-id-0029" sourceRef="SubProcess-DisasterRecovery-id-0001" targetRef="ScriptTask-CheckMilestones-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckMilestonesToMilestoneReached-id-0030" sourceRef="ScriptTask-CheckMilestones-id-0001" targetRef="ExclusiveGateway-MilestoneReached-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MilestoneReachedToNotification-id-0031" name="milestone_reached == true" sourceRef="ExclusiveGateway-MilestoneReached-id-0001" targetRef="SubProcess-MilestoneNotification-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MilestoneReachedToUpdatePreferences-id-0032" sourceRef="ExclusiveGateway-MilestoneReached-id-0001" targetRef="UserTask-UpdatePreferences-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NotificationToUpdatePreferences-id-0033" sourceRef="SubProcess-MilestoneNotification-id-0001" targetRef="UserTask-UpdatePreferences-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-UpdatePreferencesToResolveDependencies-id-0034" sourceRef="UserTask-UpdatePreferences-id-0001" targetRef="ServiceTask-ResolveDependencies-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PreferenceUpdateToResolveDependencies-id-0035" sourceRef="BoundaryEvent-PreferenceUpdateSignal-id-0001" targetRef="ServiceTask-ResolveDependencies-id-0001" />
