        <dc:Bounds x="1825" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-OfferITSupport-id-0001_di" bpmnElement="ServiceTask-OfferITSupport-id-0001">
        <dc:Bounds x="1975" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-SolutionDeployed-id-0001_di" bpmnElement="EndEvent-SolutionDeployed-id-0001">
        <dc:Bounds x="2157" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ManualProcurement-id-0001_di" bpmnElement="UserTask-ManualProcurement-id-0001">
        <dc:Bounds x="1075" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSubmitRequest-id-0001_di" bpmnElement="SequenceFlow-StartToSubmitRequest-id-0001">
        <di:waypoint x="93" y="70" />
