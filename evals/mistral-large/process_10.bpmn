        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcureToolsLicenses-id-0001_di" bpmnElement="ServiceTask-ProcureToolsLicenses-id-0001">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-Error-ProcureToolsLicenses-id-0001_di" bpmnElement="BoundaryEvent-Error-ProcureToolsLicenses-id-0001">
        <dc:Bounds x="957" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-InstallSolution-id-0001_di" bpmnElement="ServiceTask-InstallSolution-id-0001">
        <dc:Bounds x="1225" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TestInControlledEnvironment-id-0001_di" bpmnElement="ServiceTask-TestInControlledEnvironment-id-0001">
        <dc:Bounds x="1375" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RollOutToDepartment-id-0001_di" bpmnElement="ServiceTask-RollOutToDepartment-id-0001">
        <dc:Bounds x="1525" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-TrainingDecision-id-0001_di" bpmnElement="ExclusiveGateway-TrainingDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1700" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
