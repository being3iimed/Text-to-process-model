<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="LuxuryAirplaneCustomization-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="LuxuryAirplaneCustomization-Process-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CustomizationProcessInitiated-id-0001" name="Customization Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToReceiveSpecs-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ReceiveCustomerSpecifications-id-0001" name="Receive Customer Specifications">
      <bpmn:incoming>SequenceFlow-StartToReceiveSpecs-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveSpecsToValidate-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ValidateSpecifications-id-0002" name="Validate Specifications">
      <bpmn:incoming>SequenceFlow-ReceiveSpecsToValidate-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidateToFeasibilityCheck-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-SpecificationsFeasible-id-0001" name="Specifications Feasible?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ValidateToFeasibilityCheck-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeasibilityNoToRejection-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-FeasibilityYesToManufacturing-id-0006</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-FeasibilityRejectionToCustomer-id-0001" name="Send: Feasibility Rejection to Customer">
      <bpmn:incoming>SequenceFlow-FeasibilityNoToRejection-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RejectionToEnd-id-0005</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-CustomizationRejected-id-0001" name="Customization Rejected">
      <bpmn:incoming>SequenceFlow-RejectionToEnd-id-0005</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess-ManufacturingCoordination-id-0001" name="Manufacturing Coordination">
      <bpmn:incoming>SequenceFlow-FeasibilityYesToManufacturing-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ManufacturingToComponentReception-id-0007</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-ManufacturingRequestsInitiated-id-0001" name="Manufacturing Requests Initiated">
        <bpmn:outgoing>SequenceFlow-StartToSplit-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway-SplitManufacturingRequests-id-0001" name="Split Manufacturing Requests" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-StartToSplit-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToRussianBar-id-0002</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToIrishBar-id-0003</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToItalianSeats-id-0004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToGermanToilets-id-0005</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sendTask id="SendTask-BarRequirementsToRussianTeam-id-0001" name="Send: Bar Requirements to Russian Team">
        <bpmn:incoming>SequenceFlow-SplitToRussianBar-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RussianBarToJoin-id-0006</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="SendTask-BarRequirementsToIrishTeam-id-0002" name="Send: Bar Requirements to Irish Team">
        <bpmn:incoming>SequenceFlow-SplitToIrishBar-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-IrishBarToJoin-id-0007</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="SendTask-SeatRequirementsToItalianTeam-id-0003" name="Send: Seat Requirements to Italian Team">
        <bpmn:incoming>SequenceFlow-SplitToItalianSeats-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ItalianSeatsToJoin-id-0008</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="SendTask-ToiletRequirementsToGermanTeam-id-0004" name="Send: Toilet Requirements to German Team">
        <bpmn:incoming>SequenceFlow-SplitToGermanToilets-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GermanToiletsToJoin-id-0009</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:parallelGateway id="ParallelGateway-JoinManufacturingRequests-id-0001" name="Join Manufacturing Requests" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-RussianBarToJoin-id-0006</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-IrishBarToJoin-id-0007</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ItalianSeatsToJoin-id-0008</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-GermanToiletsToJoin-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToEnd-id-0010</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndEvent-AllManufacturingRequestsSent-id-0001" name="All Manufacturing Requests Sent">
        <bpmn:incoming>SequenceFlow-JoinToEnd-id-0010</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0001" sourceRef="StartEvent-ManufacturingRequestsInitiated-id-0001" targetRef="ParallelGateway-SplitManufacturingRequests-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToRussianBar-id-0002" sourceRef="ParallelGateway-SplitManufacturingRequests-id-0001" targetRef="SendTask-BarRequirementsToRussianTeam-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToIrishBar-id-0003" sourceRef="ParallelGateway-SplitManufacturingRequests-id-0001" targetRef="SendTask-BarRequirementsToIrishTeam-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToItalianSeats-id-0004" sourceRef="ParallelGateway-SplitManufacturingRequests-id-0001" targetRef="SendTask-SeatRequirementsToItalianTeam-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToGermanToilets-id-0005" sourceRef="ParallelGateway-SplitManufacturingRequests-id-0001" targetRef="SendTask-ToiletRequirementsToGermanTeam-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-RussianBarToJoin-id-0006" sourceRef="SendTask-BarRequirementsToRussianTeam-id-0001" targetRef="ParallelGateway-JoinManufacturingRequests-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-IrishBarToJoin-id-0007" sourceRef="SendTask-BarRequirementsToIrishTeam-id-0002" targetRef="ParallelGateway-JoinManufacturingRequests-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ItalianSeatsToJoin-id-0008" sourceRef="SendTask-SeatRequirementsToItalianTeam-id-0003" targetRef="ParallelGateway-JoinManufacturingRequests-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GermanToiletsToJoin-id-0009" sourceRef="SendTask-ToiletRequirementsToGermanTeam-id-0004" targetRef="ParallelGateway-JoinManufacturingRequests-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToEnd-id-0010" sourceRef="ParallelGateway-JoinManufacturingRequests-id-0001" targetRef="EndEvent-AllManufacturingRequestsSent-id-0001" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-ComponentReception-id-0001" name="Component Reception">
      <bpmn:incoming>SequenceFlow-ManufacturingToComponentReception-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ComponentsToAssembly-id-0008</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-WaitingForComponents-id-0001" name="Waiting for Components">
        <bpmn:outgoing>SequenceFlow-StartToSplitReception-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway-SplitComponentReception-id-0001" name="Split Component Reception" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-StartToSplitReception-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToVodkaBar-id-0002</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToWhiskeyBar-id-0003</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToSeats-id-0004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToToilets-id-0005</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:receiveTask id="ReceiveTask-VodkaBarFromRussianTeam-id-0001" name="Receive: Vodka Bar from Russian Team">
        <bpmn:incoming>SequenceFlow-SplitToVodkaBar-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-VodkaBarToJoin-id-0006</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:receiveTask id="ReceiveTask-WhiskeyBarFromIrishTeam-id-0002" name="Receive: Whiskey Bar from Irish Team">
        <bpmn:incoming>SequenceFlow-SplitToWhiskeyBar-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-WhiskeyBarToJoin-id-0007</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:receiveTask id="ReceiveTask-SeatsFromItalianTeam-id-0003" name="Receive: Seats from Italian Team">
        <bpmn:incoming>SequenceFlow-SplitToSeats-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SeatsToJoin-id-0008</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:receiveTask id="ReceiveTask-ToiletsFromGermanTeam-id-0004" name="Receive: Toilets from German Team">
        <bpmn:incoming>SequenceFlow-SplitToToilets-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ToiletsToJoin-id-0009</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:parallelGateway id="ParallelGateway-JoinComponentReception-id-0001" name="Join Component Reception" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-VodkaBarToJoin-id-0006</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-WhiskeyBarToJoin-id-0007</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SeatsToJoin-id-0008</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ToiletsToJoin-id-0009</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-FollowupToJoin-id-0012</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-IrishFollowupToJoin-id-0014</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ItalianFollowupToJoin-id-0016</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-GermanFollowupToJoin-id-0018</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToEndReception-id-0010</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndEvent-AllComponentsReceived-id-0001" name="All Components Received">
        <bpmn:incoming>SequenceFlow-JoinToEndReception-id-0010</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="BoundaryEvent-Timer14Day-VodkaBar-id-0001" name="14 Day SLA Timeout" attachedToRef="ReceiveTask-VodkaBarFromRussianTeam-id-0001">
        <bpmn:outgoing>SequenceFlow-VodkaBarTimeoutToFollowup-id-0011</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-Timer14Day-VodkaBar-id-0001_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="SendTask-UrgentFollowupToRussianTeam-id-0001" name="Send: Urgent Follow-up to Russian Team">
        <bpmn:incoming>SequenceFlow-VodkaBarTimeoutToFollowup-id-0011</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-FollowupToJoin-id-0012</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:boundaryEvent id="BoundaryEvent-Timer10Day-WhiskeyBar-id-0002" name="10 Day SLA Timeout" attachedToRef="ReceiveTask-WhiskeyBarFromIrishTeam-id-0002">
        <bpmn:outgoing>SequenceFlow-WhiskeyBarTimeoutToFollowup-id-0013</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-Timer10Day-WhiskeyBar-id-0002_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="SendTask-UrgentFollowupToIrishTeam-id-0002" name="Send: Urgent Follow-up to Irish Team">
        <bpmn:incoming>SequenceFlow-WhiskeyBarTimeoutToFollowup-id-0013</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-IrishFollowupToJoin-id-0014</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:boundaryEvent id="BoundaryEvent-Timer7Day-Seats-id-0003" name="7 Day SLA Timeout" attachedToRef="ReceiveTask-SeatsFromItalianTeam-id-0003">
        <bpmn:outgoing>SequenceFlow-SeatsTimeoutToFollowup-id-0015</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-Timer7Day-Seats-id-0003_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="SendTask-UrgentFollowupToItalianTeam-id-0003" name="Send: Urgent Follow-up to Italian Team">
        <bpmn:incoming>SequenceFlow-SeatsTimeoutToFollowup-id-0015</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ItalianFollowupToJoin-id-0016</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:boundaryEvent id="BoundaryEvent-Timer5Day-Toilets-id-0004" name="5 Day SLA Timeout" attachedToRef="ReceiveTask-ToiletsFromGermanTeam-id-0004">
        <bpmn:outgoing>SequenceFlow-ToiletsTimeoutToFollowup-id-0017</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-Timer5Day-Toilets-id-0004_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="SendTask-UrgentFollowupToGermanTeam-id-0004" name="Send: Urgent Follow-up to German Team">
        <bpmn:incoming>SequenceFlow-ToiletsTimeoutToFollowup-id-0017</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GermanFollowupToJoin-id-0018</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="SequenceFlow-StartToSplitReception-id-0001" sourceRef="StartEvent-WaitingForComponents-id-0001" targetRef="ParallelGateway-SplitComponentReception-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToVodkaBar-id-0002" sourceRef="ParallelGateway-SplitComponentReception-id-0001" targetRef="ReceiveTask-VodkaBarFromRussianTeam-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToWhiskeyBar-id-0003" sourceRef="ParallelGateway-SplitComponentReception-id-0001" targetRef="ReceiveTask-WhiskeyBarFromIrishTeam-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToSeats-id-0004" sourceRef="ParallelGateway-SplitComponentReception-id-0001" targetRef="ReceiveTask-SeatsFromItalianTeam-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToToilets-id-0005" sourceRef="ParallelGateway-SplitComponentReception-id-0001" targetRef="ReceiveTask-ToiletsFromGermanTeam-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-VodkaBarToJoin-id-0006" sourceRef="ReceiveTask-VodkaBarFromRussianTeam-id-0001" targetRef="ParallelGateway-JoinComponentReception-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-WhiskeyBarToJoin-id-0007" sourceRef="ReceiveTask-WhiskeyBarFromIrishTeam-id-0002" targetRef="ParallelGateway-JoinComponentReception-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SeatsToJoin-id-0008" sourceRef="ReceiveTask-SeatsFromItalianTeam-id-0003" targetRef="ParallelGateway-JoinComponentReception-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ToiletsToJoin-id-0009" sourceRef="ReceiveTask-ToiletsFromGermanTeam-id-0004" targetRef="ParallelGateway-JoinComponentReception-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToEndReception-id-0010" sourceRef="ParallelGateway-JoinComponentReception-id-0001" targetRef="EndEvent-AllComponentsReceived-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-VodkaBarTimeoutToFollowup-id-0011" sourceRef="BoundaryEvent-Timer14Day-VodkaBar-id-0001" targetRef="SendTask-UrgentFollowupToRussianTeam-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-FollowupToJoin-id-0012" sourceRef="SendTask-UrgentFollowupToRussianTeam-id-0001" targetRef="ParallelGateway-JoinComponentReception-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-WhiskeyBarTimeoutToFollowup-id-0013" sourceRef="BoundaryEvent-Timer10Day-WhiskeyBar-id-0002" targetRef="SendTask-UrgentFollowupToIrishTeam-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-IrishFollowupToJoin-id-0014" sourceRef="SendTask-UrgentFollowupToIrishTeam-id-0002" targetRef="ParallelGateway-JoinComponentReception-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SeatsTimeoutToFollowup-id-0015" sourceRef="BoundaryEvent-Timer7Day-Seats-id-0003" targetRef="SendTask-UrgentFollowupToItalianTeam-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-ItalianFollowupToJoin-id-0016" sourceRef="SendTask-UrgentFollowupToItalianTeam-id-0003" targetRef="ParallelGateway-JoinComponentReception-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ToiletsTimeoutToFollowup-id-0017" sourceRef="BoundaryEvent-Timer5Day-Toilets-id-0004" targetRef="SendTask-UrgentFollowupToGermanTeam-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-GermanFollowupToJoin-id-0018" sourceRef="SendTask-UrgentFollowupToGermanTeam-id-0004" targetRef="ParallelGateway-JoinComponentReception-id-0001" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="ServiceTask-AssembleInterior-id-0001" name="Assemble Interior">
      <bpmn:incoming>SequenceFlow-ComponentsToAssembly-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssemblyToTestFlight-id-0009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ConductTestFlight-id-0002" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow-AssemblyToTestFlight-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TestFlightToProtocol-id-0010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="ScriptTask-GenerateTestProtocol-id-0001" name="Computation: Generate Test Protocol">
      <bpmn:incoming>SequenceFlow-TestFlightToProtocol-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProtocolToSplitDistribution-id-0011</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:parallelGateway id="ParallelGateway-SplitProtocolDistribution-id-0001" name="Split Protocol Distribution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ProtocolToSplitDistribution-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToCustomerProtocol-id-0012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToInternalProtocol-id-0013</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="SendTask-TestProtocolToCustomer-id-0001" name="Send: Test Protocol to Customer">
      <bpmn:incoming>SequenceFlow-SplitToCustomerProtocol-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerProtocolToJoin-id-0014</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask-TestProtocolToInternalRecords-id-0002" name="Send: Test Protocol to Internal Records">
      <bpmn:incoming>SequenceFlow-SplitToInternalProtocol-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InternalProtocolToJoin-id-0015</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="ParallelGateway-JoinProtocolDistribution-id-0001" name="Join Protocol Distribution" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-CustomerProtocolToJoin-id-0014</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-InternalProtocolToJoin-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToCustomerConfirmation-id-0016</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:receiveTask id="ReceiveTask-CustomerConfirmation-id-0001" name="Receive: Customer Confirmation">
      <bpmn:incoming>SequenceFlow-JoinToCustomerConfirmation-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerConfirmationToApproval-id-0019</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer7Day-CustomerConfirmation-id-0001" name="7 Day Confirmation Timeout" attachedToRef="ReceiveTask-CustomerConfirmation-id-0001">
      <bpmn:outgoing>SequenceFlow-CustomerConfirmationTimeoutToReminder-id-0017</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer7Day-CustomerConfirmation-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-DeliveryReminderToCustomer-id-0001" name="Send: Delivery Reminder to Customer">
      <bpmn:incoming>SequenceFlow-CustomerConfirmationTimeoutToReminder-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReminderToApprovalCheck-id-0018</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CustomerApproval-id-0001" name="Customer Approval?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReminderToApprovalCheck-id-0018</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CustomerConfirmationToApproval-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalYesToDelivery-id-0020</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ApprovalNoToRejection-id-0022</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-DeliverAirplane-id-0001" name="Deliver Airplane">
      <bpmn:incoming>SequenceFlow-ApprovalYesToDelivery-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeliveryToEnd-id-0021</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-AirplaneDelivered-id-0001" name="Airplane Delivered">
      <bpmn:incoming>SequenceFlow-DeliveryToEnd-id-0021</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-HandleCustomerRejection-id-0001" name="Handle Customer Rejection">
      <bpmn:incoming>SequenceFlow-ApprovalNoToRejection-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RejectionToEnd-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-DeliveryCancelled-id-0001" name="Delivery Cancelled">
      <bpmn:incoming>SequenceFlow-RejectionToEnd-id-0023</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToReceiveSpecs-id-0001" sourceRef="StartEvent-CustomizationProcessInitiated-id-0001" targetRef="UserTask-ReceiveCustomerSpecifications-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveSpecsToValidate-id-0002" sourceRef="UserTask-ReceiveCustomerSpecifications-id-0001" targetRef="ServiceTask-ValidateSpecifications-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidateToFeasibilityCheck-id-0003" sourceRef="ServiceTask-ValidateSpecifications-id-0002" targetRef="ExclusiveGateway-SpecificationsFeasible-id-0001" />
