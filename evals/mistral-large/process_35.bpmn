    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-PartOrdering-id-0001" bpmnElement="SubProcess-PartOrdering-id-0001">
      <bpmndi:BPMNShape id="StartEvent-OrderingStarted-id-0001_di" bpmnElement="StartEvent-OrderingStarted-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Split-id-0001_di" bpmnElement="ParallelGateway-Split-id-0001">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-OrderPartsSupplierA-id-0001_di" bpmnElement="ServiceTask-OrderPartsSupplierA-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
