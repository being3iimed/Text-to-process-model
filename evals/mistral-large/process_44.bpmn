<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="FastFoodOrderProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="FastFoodOrderProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-OrderReceived-id-0001" name="Order Received">
      <bpmn:outgoing>SequenceFlow-OrderReceivedToReceiveOrder-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ReceiveOrder-id-0001" name="Receive Order">
      <bpmn:incoming>SequenceFlow-OrderReceivedToReceiveOrder-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveOrderToAskMenuOrBurger-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AskMenuOrBurger-id-0002" name="Ask: Menu or Burger Only?">
      <bpmn:incoming>SequenceFlow-ReceiveOrderToAskMenuOrBurger-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AskMenuOrBurgerToGateway-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-MenuOrBurger-id-0001" name="Menu or Burger?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AskMenuOrBurgerToGateway-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MenuPathToSubProcess-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-BurgerPathToPrepareBurger-id-0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess-PrepareMenuComponents-id-0001" name="Prepare Menu Components">
      <bpmn:incoming>SequenceFlow-MenuPathToSubProcess-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubProcessToPrepareBurger-id-0006</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-MenuPrepStart-id-0001" name="Menu Prep Start">
        <bpmn:outgoing>SequenceFlow-MenuPrepStartToSplit-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway-SplitMenuPrep-id-0001" name="Split Menu Preparation" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-MenuPrepStartToSplit-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToPrepareDrink-id-0002</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToAskFriesOrWedges-id-0003</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="ServiceTask-PrepareDrink-id-0001" name="Prepare Drink">
        <bpmn:incoming>SequenceFlow-SplitToPrepareDrink-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PrepareDrinkToJoin-id-0007</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="UserTask-AskFriesOrWedges-id-0001" name="Ask: Fries or Wedges?">
        <bpmn:incoming>SequenceFlow-SplitToAskFriesOrWedges-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AskToFriesOrWedgesGateway-id-0004</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-FriesOrWedges-id-0001" name="Fries or Wedges?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-AskToFriesOrWedgesGateway-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-FriesOrWedgesToFries-id-0005</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-FriesOrWedgesToWedges-id-0006</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-PrepareFries-id-0001" name="Prepare Fries">
        <bpmn:incoming>SequenceFlow-FriesOrWedgesToFries-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PrepareFriesToJoin-id-0008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-PrepareWedges-id-0001" name="Prepare Wedges">
        <bpmn:incoming>SequenceFlow-FriesOrWedgesToWedges-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PrepareWedgesToJoin-id-0009</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway-JoinMenuPrep-id-0001" name="Join Menu Preparation" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-PrepareDrinkToJoin-id-0007</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-PrepareFriesToJoin-id-0008</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-PrepareWedgesToJoin-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToMenuReady-id-0010</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndEvent-MenuComponentsReady-id-0001" name="Menu Components Ready">
        <bpmn:incoming>SequenceFlow-JoinToMenuReady-id-0010</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-MenuPrepStartToSplit-id-0001" sourceRef="StartEvent-MenuPrepStart-id-0001" targetRef="ParallelGateway-SplitMenuPrep-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToPrepareDrink-id-0002" sourceRef="ParallelGateway-SplitMenuPrep-id-0001" targetRef="ServiceTask-PrepareDrink-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToAskFriesOrWedges-id-0003" sourceRef="ParallelGateway-SplitMenuPrep-id-0001" targetRef="UserTask-AskFriesOrWedges-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-AskToFriesOrWedgesGateway-id-0004" sourceRef="UserTask-AskFriesOrWedges-id-0001" targetRef="ExclusiveGateway-FriesOrWedges-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-FriesOrWedgesToFries-id-0005" name="customer_wants_fries" sourceRef="ExclusiveGateway-FriesOrWedges-id-0001" targetRef="ServiceTask-PrepareFries-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-FriesOrWedgesToWedges-id-0006" name="!customer_wants_fries" sourceRef="ExclusiveGateway-FriesOrWedges-id-0001" targetRef="ServiceTask-PrepareWedges-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PrepareDrinkToJoin-id-0007" sourceRef="ServiceTask-PrepareDrink-id-0001" targetRef="ParallelGateway-JoinMenuPrep-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PrepareFriesToJoin-id-0008" sourceRef="ServiceTask-PrepareFries-id-0001" targetRef="ParallelGateway-JoinMenuPrep-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PrepareWedgesToJoin-id-0009" sourceRef="ServiceTask-PrepareWedges-id-0001" targetRef="ParallelGateway-JoinMenuPrep-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToMenuReady-id-0010" sourceRef="ParallelGateway-JoinMenuPrep-id-0001" targetRef="EndEvent-MenuComponentsReady-id-0001" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="ServiceTask-PrepareBurger-MenuPath-id-0001" name="Prepare Burger">
      <bpmn:incoming>SequenceFlow-SubProcessToPrepareBurger-id-0006</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-StatusUpdateToPrepareBurger-MenuPath-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareBurgerToDelivery-MenuPath-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PrepareBurger-BurgerPath-id-0001" name="Prepare Burger">
      <bpmn:incoming>SequenceFlow-BurgerPathToPrepareBurger-id-0005</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-StatusUpdateToPrepareBurger-BurgerPath-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareBurgerToDelivery-BurgerPath-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent-StatusUpdateTimer-MenuPath-id-0001" name="30 Second Status Update" cancelActivity="false" attachedToRef="ServiceTask-PrepareBurger-MenuPath-id-0001">
      <bpmn:outgoing>SequenceFlow-BoundaryToStatusUpdate-MenuPath-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-StatusUpdateTimer-MenuPath-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent-StatusUpdateTimer-BurgerPath-id-0001" name="30 Second Status Update" cancelActivity="false" attachedToRef="ServiceTask-PrepareBurger-BurgerPath-id-0001">
      <bpmn:outgoing>SequenceFlow-BoundaryToStatusUpdate-BurgerPath-id-0001</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-StatusUpdateTimer-BurgerPath-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-StatusUpdate-MenuPath-id-0001" name="Send: Status Update">
      <bpmn:incoming>SequenceFlow-BoundaryToStatusUpdate-MenuPath-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StatusUpdateToPrepareBurger-MenuPath-id-0002</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask-StatusUpdate-BurgerPath-id-0001" name="Send: Status Update">
      <bpmn:incoming>SequenceFlow-BoundaryToStatusUpdate-BurgerPath-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StatusUpdateToPrepareBurger-BurgerPath-id-0002</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-DeliverViaConveyorBelt-id-0001" name="Deliver via Conveyor Belt">
      <bpmn:incoming>SequenceFlow-PrepareBurgerToDelivery-MenuPath-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PrepareBurgerToDelivery-BurgerPath-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeliveryToOrderDelivered-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-OrderDelivered-id-0001" name="Order Delivered">
      <bpmn:incoming>SequenceFlow-DeliveryToOrderDelivered-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-OrderReceivedToReceiveOrder-id-0001" sourceRef="StartEvent-OrderReceived-id-0001" targetRef="UserTask-ReceiveOrder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveOrderToAskMenuOrBurger-id-0002" sourceRef="UserTask-ReceiveOrder-id-0001" targetRef="UserTask-AskMenuOrBurger-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-AskMenuOrBurgerToGateway-id-0003" sourceRef="UserTask-AskMenuOrBurger-id-0002" targetRef="ExclusiveGateway-MenuOrBurger-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MenuPathToSubProcess-id-0004" name="customer_wants_menu" sourceRef="ExclusiveGateway-MenuOrBurger-id-0001" targetRef="SubProcess-PrepareMenuComponents-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BurgerPathToPrepareBurger-id-0005" name="!customer_wants_menu" sourceRef="ExclusiveGateway-MenuOrBurger-id-0001" targetRef="ServiceTask-PrepareBurger-BurgerPath-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubProcessToPrepareBurger-id-0006" sourceRef="SubProcess-PrepareMenuComponents-id-0001" targetRef="ServiceTask-PrepareBurger-MenuPath-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToStatusUpdate-MenuPath-id-0001" sourceRef="BoundaryEvent-StatusUpdateTimer-MenuPath-id-0001" targetRef="SendTask-StatusUpdate-MenuPath-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StatusUpdateToPrepareBurger-MenuPath-id-0002" sourceRef="SendTask-StatusUpdate-MenuPath-id-0001" targetRef="ServiceTask-PrepareBurger-MenuPath-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToStatusUpdate-BurgerPath-id-0001" sourceRef="BoundaryEvent-StatusUpdateTimer-BurgerPath-id-0001" targetRef="SendTask-StatusUpdate-BurgerPath-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-StatusUpdateToPrepareBurger-BurgerPath-id-0002" sourceRef="SendTask-StatusUpdate-BurgerPath-id-0001" targetRef="ServiceTask-PrepareBurger-BurgerPath-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareBurgerToDelivery-MenuPath-id-0001" sourceRef="ServiceTask-PrepareBurger-MenuPath-id-0001" targetRef="ServiceTask-DeliverViaConveyorBelt-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareBurgerToDelivery-BurgerPath-id-0001" sourceRef="ServiceTask-PrepareBurger-BurgerPath-id-0001" targetRef="ServiceTask-DeliverViaConveyorBelt-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DeliveryToOrderDelivered-id-0001" sourceRef="ServiceTask-DeliverViaConveyorBelt-id-0001" targetRef="EndEvent-OrderDelivered-id-0001" />
  </bpmn:process>
