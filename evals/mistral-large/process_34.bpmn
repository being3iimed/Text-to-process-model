        <di:waypoint x="843" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReorderToAddParts-id-0010_di" bpmnElement="SequenceFlow-ReorderToAddParts-id-0010">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AddPartsToReady-id-0011_di" bpmnElement="SequenceFlow-AddPartsToReady-id-0011">
        <di:waypoint x="1125" y="250" />
        <di:waypoint x="1125" y="280" />
        <di:waypoint x="825" y="280" />
        <di:waypoint x="825" y="88" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
