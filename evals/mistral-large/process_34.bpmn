<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="LegoMachineBuildingProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="LegoMachineBuildingProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-StartLegoMachineProject-id-0001" name="Start Lego Machine Project">
      <bpmn:outgoing>SequenceFlow-StartToDesign-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-DevelopBasicMachineDesign-id-0001" name="Develop basic machine design">
      <bpmn:incoming>SequenceFlow-StartToDesign-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DesignToOrder-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-OrderLegoBrickSets-id-0001" name="Order Lego brick sets">
      <bpmn:incoming>SequenceFlow-DesignToOrder-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OrderToGiveSets-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-GiveSetsToChildrenForSorting-id-0001" name="Give sets to children for sorting">
      <bpmn:incoming>SequenceFlow-OrderToGiveSets-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GiveSetsToSort-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SortPartsIntoContainers-id-0001" name="Sort parts into containers">
      <bpmn:incoming>SequenceFlow-GiveSetsToSort-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SortToSubcomponentSplit-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SubProcess-SubcomponentLifecycle-id-0001" name="Subcomponent Lifecycle">
      <bpmn:incoming>SequenceFlow-SubcomponentSplitToLifecycle-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LifecycleToJoin-id-0007</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-BeginSubcomponent-id-0001" name="Begin Subcomponent">
        <bpmn:outgoing>SequenceFlow-BeginToBuild-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-BuildSubcomponent-id-0001" name="Build subcomponent">
        <bpmn:incoming>SequenceFlow-BeginToBuild-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-RedesignToBuild-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BuildToTest-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="ServiceTask-TestSubcomponent-id-0001" name="Test subcomponent">
        <bpmn:incoming>SequenceFlow-BuildToTest-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TestToGateway-id-0003</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-TestResult-id-0001" name="Test Result?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-TestToGateway-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TestPassToReady-id-0004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-TestFailToRedesign-id-0005</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UserTask-RedesignSubcomponent-id-0001" name="Redesign subcomponent">
        <bpmn:incoming>SequenceFlow-TestFailToRedesign-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RedesignToBuild-id-0006</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EndEvent-SubcomponentReady-id-0001" name="Subcomponent Ready">
        <bpmn:incoming>SequenceFlow-ReadyToContainerCheck-id-0007</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-AddPartsToReady-id-0011</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="ExclusiveGateway-ContainerCheck-id-0001" name="Container Empty?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-TestPassToReady-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReadyToContainerCheck-id-0007</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-ContainerEmptyToWait-id-0008</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-PartReorderDelay-id-0001" name="Wait for parts">
        <bpmn:incoming>SequenceFlow-ContainerEmptyToWait-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-WaitToReorder-id-0009</bpmn:outgoing>
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="ServiceTask-ReorderIndividualParts-id-0001" name="Reorder individual parts">
        <bpmn:incoming>SequenceFlow-WaitToReorder-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReorderToAddParts-id-0010</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="UserTask-AddNewPartsToContainer-id-0001" name="Add new parts to container">
        <bpmn:incoming>SequenceFlow-ReorderToAddParts-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AddPartsToReady-id-0011</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="SequenceFlow-BeginToBuild-id-0001" sourceRef="StartEvent-BeginSubcomponent-id-0001" targetRef="UserTask-BuildSubcomponent-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BuildToTest-id-0002" sourceRef="UserTask-BuildSubcomponent-id-0001" targetRef="ServiceTask-TestSubcomponent-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TestToGateway-id-0003" sourceRef="ServiceTask-TestSubcomponent-id-0001" targetRef="ExclusiveGateway-TestResult-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TestPassToReady-id-0004" name="test_successful" sourceRef="ExclusiveGateway-TestResult-id-0001" targetRef="ExclusiveGateway-ContainerCheck-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TestFailToRedesign-id-0005" name="test_failed" sourceRef="ExclusiveGateway-TestResult-id-0001" targetRef="UserTask-RedesignSubcomponent-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-RedesignToBuild-id-0006" sourceRef="UserTask-RedesignSubcomponent-id-0001" targetRef="UserTask-BuildSubcomponent-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReadyToContainerCheck-id-0007" name="container_not_empty" sourceRef="ExclusiveGateway-ContainerCheck-id-0001" targetRef="EndEvent-SubcomponentReady-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ContainerEmptyToWait-id-0008" name="container_empty" sourceRef="ExclusiveGateway-ContainerCheck-id-0001" targetRef="IntermediateCatchEvent-PartReorderDelay-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-WaitToReorder-id-0009" sourceRef="IntermediateCatchEvent-PartReorderDelay-id-0001" targetRef="ServiceTask-ReorderIndividualParts-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReorderToAddParts-id-0010" sourceRef="ServiceTask-ReorderIndividualParts-id-0001" targetRef="UserTask-AddNewPartsToContainer-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-AddPartsToReady-id-0011" sourceRef="UserTask-AddNewPartsToContainer-id-0001" targetRef="EndEvent-SubcomponentReady-id-0001" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="ParallelGateway-SubcomponentSplit-id-0001" name="Parallel Subcomponent Building" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SortToSubcomponentSplit-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubcomponentSplitToLifecycle-id-0006</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="ParallelGateway-SubcomponentJoin-id-0001" name="Synchronize Subcomponents" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-LifecycleToJoin-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToAssembly-id-0008</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-AssembleFinalMachine-id-0001" name="Assemble final machine">
      <bpmn:incoming>SequenceFlow-JoinToAssembly-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssemblyToComplete-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-MachineAssemblyComplete-id-0001" name="Machine Assembly Complete">
      <bpmn:incoming>SequenceFlow-AssemblyToComplete-id-0009</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDesign-id-0001" sourceRef="StartEvent-StartLegoMachineProject-id-0001" targetRef="UserTask-DevelopBasicMachineDesign-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DesignToOrder-id-0002" sourceRef="UserTask-DevelopBasicMachineDesign-id-0001" targetRef="ServiceTask-OrderLegoBrickSets-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-OrderToGiveSets-id-0003" sourceRef="ServiceTask-OrderLegoBrickSets-id-0001" targetRef="UserTask-GiveSetsToChildrenForSorting-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GiveSetsToSort-id-0004" sourceRef="UserTask-GiveSetsToChildrenForSorting-id-0001" targetRef="UserTask-SortPartsIntoContainers-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SortToSubcomponentSplit-id-0005" sourceRef="UserTask-SortPartsIntoContainers-id-0001" targetRef="ParallelGateway-SubcomponentSplit-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubcomponentSplitToLifecycle-id-0006" sourceRef="ParallelGateway-SubcomponentSplit-id-0001" targetRef="SubProcess-SubcomponentLifecycle-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-LifecycleToJoin-id-0007" sourceRef="SubProcess-SubcomponentLifecycle-id-0001" targetRef="ParallelGateway-SubcomponentJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToAssembly-id-0008" sourceRef="ParallelGateway-SubcomponentJoin-id-0001" targetRef="UserTask-AssembleFinalMachine-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AssemblyToComplete-id-0009" sourceRef="UserTask-AssembleFinalMachine-id-0001" targetRef="EndEvent-MachineAssemblyComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_LegoMachineBuildingProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_LegoMachineBuildingProcess-id-0001" bpmnElement="LegoMachineBuildingProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-StartLegoMachineProject-id-0001_di" bpmnElement="StartEvent-StartLegoMachineProject-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DevelopBasicMachineDesign-id-0001_di" bpmnElement="UserTask-DevelopBasicMachineDesign-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-OrderLegoBrickSets-id-0001_di" bpmnElement="ServiceTask-OrderLegoBrickSets-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-GiveSetsToChildrenForSorting-id-0001_di" bpmnElement="UserTask-GiveSetsToChildrenForSorting-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SortPartsIntoContainers-id-0001_di" bpmnElement="UserTask-SortPartsIntoContainers-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-SubcomponentSplit-id-0001_di" bpmnElement="ParallelGateway-SubcomponentSplit-id-0001">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-SubcomponentLifecycle-id-0001_di" bpmnElement="SubProcess-SubcomponentLifecycle-id-0001">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-SubcomponentJoin-id-0001_di" bpmnElement="ParallelGateway-SubcomponentJoin-id-0001">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AssembleFinalMachine-id-0001_di" bpmnElement="UserTask-AssembleFinalMachine-id-0001">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-MachineAssemblyComplete-id-0001_di" bpmnElement="EndEvent-MachineAssemblyComplete-id-0001">
        <dc:Bounds x="1407" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToDesign-id-0001_di" bpmnElement="SequenceFlow-StartToDesign-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DesignToOrder-id-0002_di" bpmnElement="SequenceFlow-DesignToOrder-id-0002">
        <di:waypoint x="275" y="70" />
