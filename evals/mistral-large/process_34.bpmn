      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-OrderToGiveSets-id-0003_di" bpmnElement="SequenceFlow-OrderToGiveSets-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GiveSetsToSort-id-0004_di" bpmnElement="SequenceFlow-GiveSetsToSort-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SortToSubcomponentSplit-id-0005_di" bpmnElement="SequenceFlow-SortToSubcomponentSplit-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SubcomponentSplitToLifecycle-id-0006_di" bpmnElement="SequenceFlow-SubcomponentSplitToLifecycle-id-0006">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LifecycleToJoin-id-0007_di" bpmnElement="SequenceFlow-LifecycleToJoin-id-0007">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-JoinToAssembly-id-0008_di" bpmnElement="SequenceFlow-JoinToAssembly-id-0008">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssemblyToComplete-id-0009_di" bpmnElement="SequenceFlow-AssemblyToComplete-id-0009">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1407" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-SubcomponentLifecycle-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-SubcomponentLifecycle-id-0001" bpmnElement="SubProcess-SubcomponentLifecycle-id-0001">
      <bpmndi:BPMNShape id="StartEvent-BeginSubcomponent-id-0001_di" bpmnElement="StartEvent-BeginSubcomponent-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-BuildSubcomponent-id-0001_di" bpmnElement="UserTask-BuildSubcomponent-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TestSubcomponent-id-0001_di" bpmnElement="ServiceTask-TestSubcomponent-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-TestResult-id-0001_di" bpmnElement="ExclusiveGateway-TestResult-id-0001" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ContainerCheck-id-0001_di" bpmnElement="ExclusiveGateway-ContainerCheck-id-0001" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-SubcomponentReady-id-0001_di" bpmnElement="EndEvent-SubcomponentReady-id-0001">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-RedesignSubcomponent-id-0001_di" bpmnElement="UserTask-RedesignSubcomponent-id-0001">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent-PartReorderDelay-id-0001_di" bpmnElement="IntermediateCatchEvent-PartReorderDelay-id-0001">
        <dc:Bounds x="807" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ReorderIndividualParts-id-0001_di" bpmnElement="ServiceTask-ReorderIndividualParts-id-0001">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AddNewPartsToContainer-id-0001_di" bpmnElement="UserTask-AddNewPartsToContainer-id-0001">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-BeginToBuild-id-0001_di" bpmnElement="SequenceFlow-BeginToBuild-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BuildToTest-id-0002_di" bpmnElement="SequenceFlow-BuildToTest-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TestToGateway-id-0003_di" bpmnElement="SequenceFlow-TestToGateway-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TestPassToReady-id-0004_di" bpmnElement="SequenceFlow-TestPassToReady-id-0004">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TestFailToRedesign-id-0005_di" bpmnElement="SequenceFlow-TestFailToRedesign-id-0005">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReadyToContainerCheck-id-0007_di" bpmnElement="SequenceFlow-ReadyToContainerCheck-id-0007">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="807" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ContainerEmptyToWait-id-0008_di" bpmnElement="SequenceFlow-ContainerEmptyToWait-id-0008">
