        <di:waypoint x="807" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RedesignToBuild-id-0006_di" bpmnElement="SequenceFlow-RedesignToBuild-id-0006">
