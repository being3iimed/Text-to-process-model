<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="MaternityLeaveProcess-Definitions-id-0001" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="MaternityLeaveProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-MaternityLeaveInitiated-id-0001" name="Maternity leave planning initiated">
      <bpmn:outgoing>SequenceFlow-StartToFetchModels-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-FetchLeaveModels-id-0001" name="Fetch available leave models">
      <bpmn:incoming>SequenceFlow-StartToFetchModels-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FetchToReview-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ReviewModels-id-0001" name="Review maternity leave models">
      <bpmn:incoming>SequenceFlow-FetchToReview-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToSelect-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectModel-id-0001" name="Select preferred model">
      <bpmn:incoming>SequenceFlow-ReviewToSelect-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToProvideDetails-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ProvideDetails-id-0001" name="Provide personal details">
      <bpmn:incoming>SequenceFlow-SelectToProvideDetails-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProvideToValidate-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ValidateEligibility-id-0001" name="Validate eligibility">
      <bpmn:incoming>SequenceFlow-ProvideToValidate-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ValidateToNotification-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess-NotificationProcess-id-0001" name="Notification Process">
      <bpmn:incoming>SequenceFlow-ValidateToNotification-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotificationToLeavePeriod-id-0001</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-NotificationStart-id-0001" name="Notification process start">
        <bpmn:outgoing>SequenceFlow-NotificationStartToSplit-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway-NotificationSplit-id-0001" name="Parallel Notification" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-NotificationStartToSplit-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToSSNotification-id-0001</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToCompanyNotification-id-0001</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sendTask id="SendTask-SocialSecurityNotification-id-0001" name="Send: Social Security notification">
        <bpmn:incoming>SequenceFlow-SplitToSSNotification-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SSNotificationToReceive-id-0001</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="SendTask-CompanyNotification-id-0001" name="Send: Company notification">
        <bpmn:incoming>SequenceFlow-SplitToCompanyNotification-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CompanyNotificationToReceive-id-0001</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask-CompanyConfirmation-id-0001" name="Receive: Company confirmation">
        <bpmn:incoming>SequenceFlow-CompanyNotificationToReceive-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CompanyReceiveToJoin-id-0001</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:receiveTask id="ReceiveTask-SocialSecurityConfirmation-id-0001" name="Receive: Social Security confirmation">
        <bpmn:incoming>SequenceFlow-SSNotificationToReceive-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SSReceiveToJoin-id-0001</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="BoundaryEvent-CompanyTimeout-id-0001" name="5 Business Day Timeout" attachedToRef="ReceiveTask-CompanyConfirmation-id-0001">
        <bpmn:outgoing>SequenceFlow-CompanyTimeoutToFollowup-id-0001</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-CompanyTimeout-id-0001_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="BoundaryEvent-SocialSecurityTimeout-id-0001" name="7 Business Day Timeout" attachedToRef="ReceiveTask-SocialSecurityConfirmation-id-0001">
        <bpmn:outgoing>SequenceFlow-SSTimeoutToFollowup-id-0001</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-SocialSecurityTimeout-id-0001_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="SendTask-CompanyFollowup-id-0001" name="Send: Company follow-up reminder">
        <bpmn:incoming>SequenceFlow-CompanyTimeoutToFollowup-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CompanyFollowupToJoin-id-0001</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="SendTask-SocialSecurityFollowup-id-0001" name="Send: Social Security follow-up reminder">
        <bpmn:incoming>SequenceFlow-SSTimeoutToFollowup-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SSFollowupToJoin-id-0001</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:parallelGateway id="ParallelGateway-NotificationJoin-id-0001" name="Notification Complete" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-CompanyFollowupToJoin-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SSFollowupToJoin-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-CompanyReceiveToJoin-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SSReceiveToJoin-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-NotificationJoinToEnd-id-0001</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndEvent-NotificationsConfirmed-id-0001" name="All notifications confirmed">
        <bpmn:incoming>SequenceFlow-NotificationJoinToEnd-id-0001</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-NotificationStartToSplit-id-0001" sourceRef="StartEvent-NotificationStart-id-0001" targetRef="ParallelGateway-NotificationSplit-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToSSNotification-id-0001" sourceRef="ParallelGateway-NotificationSplit-id-0001" targetRef="SendTask-SocialSecurityNotification-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToCompanyNotification-id-0001" sourceRef="ParallelGateway-NotificationSplit-id-0001" targetRef="SendTask-CompanyNotification-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SSNotificationToReceive-id-0001" sourceRef="SendTask-SocialSecurityNotification-id-0001" targetRef="ReceiveTask-SocialSecurityConfirmation-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CompanyNotificationToReceive-id-0001" sourceRef="SendTask-CompanyNotification-id-0001" targetRef="ReceiveTask-CompanyConfirmation-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CompanyTimeoutToFollowup-id-0001" sourceRef="BoundaryEvent-CompanyTimeout-id-0001" targetRef="SendTask-CompanyFollowup-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SSTimeoutToFollowup-id-0001" sourceRef="BoundaryEvent-SocialSecurityTimeout-id-0001" targetRef="SendTask-SocialSecurityFollowup-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CompanyFollowupToJoin-id-0001" sourceRef="SendTask-CompanyFollowup-id-0001" targetRef="ParallelGateway-NotificationJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SSFollowupToJoin-id-0001" sourceRef="SendTask-SocialSecurityFollowup-id-0001" targetRef="ParallelGateway-NotificationJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CompanyReceiveToJoin-id-0001" sourceRef="ReceiveTask-CompanyConfirmation-id-0001" targetRef="ParallelGateway-NotificationJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SSReceiveToJoin-id-0001" sourceRef="ReceiveTask-SocialSecurityConfirmation-id-0001" targetRef="ParallelGateway-NotificationJoin-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-NotificationJoinToEnd-id-0001" sourceRef="ParallelGateway-NotificationJoin-id-0001" targetRef="EndEvent-NotificationsConfirmed-id-0001" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-LeavePeriod-id-0001" name="Leave Period">
      <bpmn:incoming>SequenceFlow-NotificationToLeavePeriod-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LeavePeriodToExtension-id-0001</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UserTask-ConfirmExtension-id-0001" name="Confirm extension decision">
      <bpmn:incoming>SequenceFlow-LeavePeriodToExtension-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExtensionToGateway-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ExtensionDecision-id-0001" name="Extension Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ExtensionToGateway-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToExtensionProcess-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToLeaveEnd-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-ProcessExtension-id-0001" name="Process extension paperwork">
      <bpmn:incoming>SequenceFlow-GatewayToExtensionProcess-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExtensionProcessToPeriod-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-ExtensionPeriod-id-0001" name="Extension Period">
      <bpmn:incoming>SequenceFlow-ExtensionProcessToPeriod-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExtensionPeriodToEnd-id-0001</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent-LeaveCompleted-id-0001" name="Leave period completed">
      <bpmn:incoming>SequenceFlow-GatewayToLeaveEnd-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-ExtensionCompleted-id-0001" name="Extension period completed">
      <bpmn:incoming>SequenceFlow-ExtensionPeriodToEnd-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToFetchModels-id-0001" sourceRef="StartEvent-MaternityLeaveInitiated-id-0001" targetRef="ServiceTask-FetchLeaveModels-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FetchToReview-id-0001" sourceRef="ServiceTask-FetchLeaveModels-id-0001" targetRef="UserTask-ReviewModels-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToSelect-id-0001" sourceRef="UserTask-ReviewModels-id-0001" targetRef="UserTask-SelectModel-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToProvideDetails-id-0001" sourceRef="UserTask-SelectModel-id-0001" targetRef="UserTask-ProvideDetails-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProvideToValidate-id-0001" sourceRef="UserTask-ProvideDetails-id-0001" targetRef="ServiceTask-ValidateEligibility-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ValidateToNotification-id-0001" sourceRef="ServiceTask-ValidateEligibility-id-0001" targetRef="SubProcess-NotificationProcess-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NotificationToLeavePeriod-id-0001" sourceRef="SubProcess-NotificationProcess-id-0001" targetRef="IntermediateCatchEvent-LeavePeriod-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-LeavePeriodToExtension-id-0001" sourceRef="IntermediateCatchEvent-LeavePeriod-id-0001" targetRef="UserTask-ConfirmExtension-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ExtensionToGateway-id-0001" sourceRef="UserTask-ConfirmExtension-id-0001" targetRef="ExclusiveGateway-ExtensionDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToExtensionProcess-id-0001" name="extend_leave = true" sourceRef="ExclusiveGateway-ExtensionDecision-id-0001" targetRef="ServiceTask-ProcessExtension-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToLeaveEnd-id-0001" name="extend_leave = false" sourceRef="ExclusiveGateway-ExtensionDecision-id-0001" targetRef="EndEvent-LeaveCompleted-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ExtensionProcessToPeriod-id-0001" sourceRef="ServiceTask-ProcessExtension-id-0001" targetRef="IntermediateCatchEvent-ExtensionPeriod-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ExtensionPeriodToEnd-id-0001" sourceRef="IntermediateCatchEvent-ExtensionPeriod-id-0001" targetRef="EndEvent-ExtensionCompleted-id-0001" />
  </bpmn:process>
