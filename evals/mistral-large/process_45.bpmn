<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="shopping-process-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="ShoppingProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-StartShoppingProcess-id-0001" name="Start Shopping Process">
      <bpmn:outgoing>SequenceFlow-StartToLogin-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-EnterLoginCredentials-id-0001" name="Enter Login Credentials">
      <bpmn:incoming>SequenceFlow-StartToLogin-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LoginToCheck-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CheckCredentials-id-0001" name="Check Credentials">
      <bpmn:incoming>SequenceFlow-LoginToCheck-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckToGateway-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CredentialsValid-id-0001" name="Credentials Valid?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckToGateway-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToLoginFailed-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToProductSelection-id-0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-LoginFailed-id-0001" name="Login Failed">
      <bpmn:incoming>SequenceFlow-GatewayToLoginFailed-id-0004</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess-ProductSelection-id-0001" name="Product Selection">
      <bpmn:incoming>SequenceFlow-GatewayToProductSelection-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProductSelectionToPrepare-id-0006</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-BeginProductSelection-id-0001" name="Begin Product Selection">
        <bpmn:outgoing>SequenceFlow-SubProcessStartToSelect-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-SelectProduct-id-0001" name="Select Product">
        <bpmn:incoming>SequenceFlow-SubProcessStartToSelect-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-GatewayToSelect-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SelectToAdd-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="ServiceTask-AddToCart-id-0001" name="Add to Cart">
        <bpmn:incoming>SequenceFlow-SelectToAdd-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AddToSave-id-0003</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-SaveProduct-id-0001" name="Save Product">
        <bpmn:incoming>SequenceFlow-AddToSave-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SaveToCheck-id-0004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="ScriptTask-CheckAllProductsSelected-id-0001" name="Computation: check if all products selected">
        <bpmn:incoming>SequenceFlow-SaveToCheck-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-CheckToGateway-id-0005</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-AllProductsSelected-id-0001" name="All Products Selected?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-CheckToGateway-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GatewayToComplete-id-0006</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToSelect-id-0007</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent-ProductSelectionComplete-id-0001" name="Product Selection Complete">
        <bpmn:incoming>SequenceFlow-GatewayToComplete-id-0006</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-SubProcessStartToSelect-id-0001" sourceRef="StartEvent-BeginProductSelection-id-0001" targetRef="UserTask-SelectProduct-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SelectToAdd-id-0002" sourceRef="UserTask-SelectProduct-id-0001" targetRef="ServiceTask-AddToCart-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-AddToSave-id-0003" sourceRef="ServiceTask-AddToCart-id-0001" targetRef="ServiceTask-SaveProduct-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SaveToCheck-id-0004" sourceRef="ServiceTask-SaveProduct-id-0001" targetRef="ScriptTask-CheckAllProductsSelected-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-CheckToGateway-id-0005" sourceRef="ScriptTask-CheckAllProductsSelected-id-0001" targetRef="ExclusiveGateway-AllProductsSelected-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToComplete-id-0006" name="all_products_selected" sourceRef="ExclusiveGateway-AllProductsSelected-id-0001" targetRef="EndEvent-ProductSelectionComplete-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToSelect-id-0007" sourceRef="ExclusiveGateway-AllProductsSelected-id-0001" targetRef="UserTask-SelectProduct-id-0001" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="ParallelGateway-PreparePaymentShipment-id-0001" name="Prepare Payment and Shipment" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ProductSelectionToPrepare-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareToPayment-id-0007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PrepareToShipment-id-0008</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-PreparePayment-id-0001" name="Prepare Payment">
      <bpmn:incoming>SequenceFlow-PrepareToPayment-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PaymentToPaymentSubprocess-id-0009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PrepareShipment-id-0001" name="Prepare Shipment">
      <bpmn:incoming>SequenceFlow-PrepareToShipment-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ShipmentToAddress-id-0010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess-PaymentProcessing-id-0001" name="Payment Processing">
      <bpmn:incoming>SequenceFlow-PaymentToPaymentSubprocess-id-0009</bpmn:incoming>
      <bpmn:startEvent id="StartEvent-PaymentInitiated-id-0001" name="Payment Initiated">
        <bpmn:outgoing>SequenceFlow-PaymentStartToEnterData-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-EnterPaymentData-id-0001" name="Enter Payment Data">
        <bpmn:incoming>SequenceFlow-PaymentStartToEnterData-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-EnterDataToReceive-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:receiveTask id="ReceiveTask-BankPaymentConfirmation-id-0001" name="Receive: bank payment confirmation">
        <bpmn:incoming>SequenceFlow-EnterDataToReceive-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReceiveToPaymentEnd-id-0004</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="BoundaryEvent-Timer5Min-PaymentConfirmation-id-0001" name="5 Minute Timeout" attachedToRef="ReceiveTask-BankPaymentConfirmation-id-0001">
        <bpmn:outgoing>SequenceFlow-BoundaryToNotification-id-0003</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-Timer5Min-PaymentConfirmation-id-0001_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="SendTask-PaymentTimeoutNotification-id-0001" name="Send: payment timeout notification">
        <bpmn:incoming>SequenceFlow-BoundaryToNotification-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-NotificationToPaymentEnd-id-0005</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="EndEvent-PaymentConfirmed-id-0001" name="Payment Confirmed">
        <bpmn:incoming>SequenceFlow-ReceiveToPaymentEnd-id-0004</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-NotificationToPaymentEnd-id-0005</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-PaymentStartToEnterData-id-0001" sourceRef="StartEvent-PaymentInitiated-id-0001" targetRef="UserTask-EnterPaymentData-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-EnterDataToReceive-id-0002" sourceRef="UserTask-EnterPaymentData-id-0001" targetRef="ReceiveTask-BankPaymentConfirmation-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BoundaryToNotification-id-0003" sourceRef="BoundaryEvent-Timer5Min-PaymentConfirmation-id-0001" targetRef="SendTask-PaymentTimeoutNotification-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReceiveToPaymentEnd-id-0004" sourceRef="ReceiveTask-BankPaymentConfirmation-id-0001" targetRef="EndEvent-PaymentConfirmed-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-NotificationToPaymentEnd-id-0005" sourceRef="SendTask-PaymentTimeoutNotification-id-0001" targetRef="EndEvent-PaymentConfirmed-id-0001" />
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask-EnterShippingAddress-id-0001" name="Enter Shipping Address">
      <bpmn:incoming>SequenceFlow-ShipmentToAddress-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AddressToBillingGateway-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-BillingAddressNeeded-id-0001" name="Billing Address Needed?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AddressToBillingGateway-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BillingGatewayToBillingAddress-id-0012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-BillingGatewayToFinalize-id-0013</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-EnterBillingAddress-id-0001" name="Enter Billing Address">
      <bpmn:incoming>SequenceFlow-BillingGatewayToBillingAddress-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BillingAddressToFinalize-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-FinalizeOrder-id-0001" name="Finalize Order">
      <bpmn:incoming>SequenceFlow-BillingGatewayToFinalize-id-0013</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-BillingAddressToFinalize-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FinalizeToOrderComplete-id-0015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-OrderComplete-id-0001" name="Order Complete">
      <bpmn:incoming>SequenceFlow-FinalizeToOrderComplete-id-0015</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToLogin-id-0001" sourceRef="StartEvent-StartShoppingProcess-id-0001" targetRef="UserTask-EnterLoginCredentials-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-LoginToCheck-id-0002" sourceRef="UserTask-EnterLoginCredentials-id-0001" targetRef="ServiceTask-CheckCredentials-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckToGateway-id-0003" sourceRef="ServiceTask-CheckCredentials-id-0001" targetRef="ExclusiveGateway-CredentialsValid-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToLoginFailed-id-0004" sourceRef="ExclusiveGateway-CredentialsValid-id-0001" targetRef="EndEvent-LoginFailed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToProductSelection-id-0005" name="credentials_valid" sourceRef="ExclusiveGateway-CredentialsValid-id-0001" targetRef="SubProcess-ProductSelection-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProductSelectionToPrepare-id-0006" sourceRef="SubProcess-ProductSelection-id-0001" targetRef="ParallelGateway-PreparePaymentShipment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareToPayment-id-0007" sourceRef="ParallelGateway-PreparePaymentShipment-id-0001" targetRef="ServiceTask-PreparePayment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareToShipment-id-0008" sourceRef="ParallelGateway-PreparePaymentShipment-id-0001" targetRef="ServiceTask-PrepareShipment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PaymentToPaymentSubprocess-id-0009" sourceRef="ServiceTask-PreparePayment-id-0001" targetRef="SubProcess-PaymentProcessing-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ShipmentToAddress-id-0010" sourceRef="ServiceTask-PrepareShipment-id-0001" targetRef="UserTask-EnterShippingAddress-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AddressToBillingGateway-id-0011" sourceRef="UserTask-EnterShippingAddress-id-0001" targetRef="ExclusiveGateway-BillingAddressNeeded-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BillingGatewayToBillingAddress-id-0012" name="shipping_address != billing_address" sourceRef="ExclusiveGateway-BillingAddressNeeded-id-0001" targetRef="UserTask-EnterBillingAddress-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BillingGatewayToFinalize-id-0013" sourceRef="ExclusiveGateway-BillingAddressNeeded-id-0001" targetRef="ServiceTask-FinalizeOrder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BillingAddressToFinalize-id-0014" sourceRef="UserTask-EnterBillingAddress-id-0001" targetRef="ServiceTask-FinalizeOrder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FinalizeToOrderComplete-id-0015" sourceRef="ServiceTask-FinalizeOrder-id-0001" targetRef="EndEvent-OrderComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ShoppingProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_ShoppingProcess-id-0001" bpmnElement="ShoppingProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-StartShoppingProcess-id-0001_di" bpmnElement="StartEvent-StartShoppingProcess-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EnterLoginCredentials-id-0001_di" bpmnElement="UserTask-EnterLoginCredentials-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CheckCredentials-id-0001_di" bpmnElement="ServiceTask-CheckCredentials-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-CredentialsValid-id-0001_di" bpmnElement="ExclusiveGateway-CredentialsValid-id-0001" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-LoginFailed-id-0001_di" bpmnElement="EndEvent-LoginFailed-id-0001">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-ProductSelection-id-0001_di" bpmnElement="SubProcess-ProductSelection-id-0001">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-PreparePaymentShipment-id-0001_di" bpmnElement="ParallelGateway-PreparePaymentShipment-id-0001">
        <dc:Bounds x="800" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PreparePayment-id-0001_di" bpmnElement="ServiceTask-PreparePayment-id-0001">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-PaymentProcessing-id-0001_di" bpmnElement="SubProcess-PaymentProcessing-id-0001">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PrepareShipment-id-0001_di" bpmnElement="ServiceTask-PrepareShipment-id-0001">
        <dc:Bounds x="925" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EnterShippingAddress-id-0001_di" bpmnElement="UserTask-EnterShippingAddress-id-0001">
        <dc:Bounds x="1075" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-BillingAddressNeeded-id-0001_di" bpmnElement="ExclusiveGateway-BillingAddressNeeded-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1250" y="325" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EnterBillingAddress-id-0001_di" bpmnElement="UserTask-EnterBillingAddress-id-0001">
        <dc:Bounds x="1375" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-FinalizeOrder-id-0001_di" bpmnElement="ServiceTask-FinalizeOrder-id-0001">
        <dc:Bounds x="1525" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-OrderComplete-id-0001_di" bpmnElement="EndEvent-OrderComplete-id-0001">
        <dc:Bounds x="1707" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToLogin-id-0001_di" bpmnElement="SequenceFlow-StartToLogin-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LoginToCheck-id-0002_di" bpmnElement="SequenceFlow-LoginToCheck-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckToGateway-id-0003_di" bpmnElement="SequenceFlow-CheckToGateway-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToLoginFailed-id-0004_di" bpmnElement="SequenceFlow-GatewayToLoginFailed-id-0004">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToProductSelection-id-0005_di" bpmnElement="SequenceFlow-GatewayToProductSelection-id-0005">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProductSelectionToPrepare-id-0006_di" bpmnElement="SequenceFlow-ProductSelectionToPrepare-id-0006">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="800" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PrepareToPayment-id-0007_di" bpmnElement="SequenceFlow-PrepareToPayment-id-0007">
        <di:waypoint x="850" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PrepareToShipment-id-0008_di" bpmnElement="SequenceFlow-PrepareToShipment-id-0008">
        <di:waypoint x="825" y="235" />
        <di:waypoint x="825" y="350" />
        <di:waypoint x="925" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PaymentToPaymentSubprocess-id-0009_di" bpmnElement="SequenceFlow-PaymentToPaymentSubprocess-id-0009">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ShipmentToAddress-id-0010_di" bpmnElement="SequenceFlow-ShipmentToAddress-id-0010">
        <di:waypoint x="1025" y="350" />
        <di:waypoint x="1075" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AddressToBillingGateway-id-0011_di" bpmnElement="SequenceFlow-AddressToBillingGateway-id-0011">
        <di:waypoint x="1175" y="350" />
        <di:waypoint x="1250" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BillingGatewayToBillingAddress-id-0012_di" bpmnElement="SequenceFlow-BillingGatewayToBillingAddress-id-0012">
        <di:waypoint x="1300" y="350" />
        <di:waypoint x="1375" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BillingGatewayToFinalize-id-0013_di" bpmnElement="SequenceFlow-BillingGatewayToFinalize-id-0013">
        <di:waypoint x="1275" y="375" />
        <di:waypoint x="1275" y="420" />
        <di:waypoint x="1575" y="420" />
        <di:waypoint x="1575" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BillingAddressToFinalize-id-0014_di" bpmnElement="SequenceFlow-BillingAddressToFinalize-id-0014">
        <di:waypoint x="1475" y="350" />
        <di:waypoint x="1525" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FinalizeToOrderComplete-id-0015_di" bpmnElement="SequenceFlow-FinalizeToOrderComplete-id-0015">
        <di:waypoint x="1625" y="350" />
        <di:waypoint x="1707" y="350" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-PaymentProcessing-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-PaymentProcessing-id-0001" bpmnElement="SubProcess-PaymentProcessing-id-0001">
      <bpmndi:BPMNShape id="StartEvent-PaymentInitiated-id-0001_di" bpmnElement="StartEvent-PaymentInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EnterPaymentData-id-0001_di" bpmnElement="UserTask-EnterPaymentData-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-BankPaymentConfirmation-id-0001_di" bpmnElement="ReceiveTask-BankPaymentConfirmation-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-Timer5Min-PaymentConfirmation-id-0001_di" bpmnElement="BoundaryEvent-Timer5Min-PaymentConfirmation-id-0001">
        <dc:Bounds x="357" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PaymentConfirmed-id-0001_di" bpmnElement="EndEvent-PaymentConfirmed-id-0001">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-PaymentTimeoutNotification-id-0001_di" bpmnElement="SendTask-PaymentTimeoutNotification-id-0001">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
