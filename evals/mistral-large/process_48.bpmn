<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ViennaNightRunProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0.0">
  <bpmn:process id="ViennaNightRunProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-StartViennaNightRun-id-0001" name="Start Vienna Night Run Participation">
      <bpmn:outgoing>SequenceFlow-StartToSelectBlock-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-SelectStartingBlock-id-0001" name="Select Starting Block">
      <bpmn:incoming>SequenceFlow-StartToSelectBlock-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectBlockToMeasureTime-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-Measure5kmTime-id-0001" name="Measure 5km Time">
      <bpmn:incoming>SequenceFlow-SelectBlockToMeasureTime-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MeasureTimeToQualification-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-QualificationCheck-id-0001" name="Qualification Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-MeasureTimeToQualification-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-QualifiedToGetNumber-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-NeedTrainingToTrain-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-GetStartingNumber-id-0001" name="Get Starting Number">
      <bpmn:incoming>SequenceFlow-QualifiedToGetNumber-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-MeasureAgainToGetNumber-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GetNumberToCheckWorkday-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-TrainUntilGoal-id-0001" name="Train Until Goal Achieved">
      <bpmn:incoming>SequenceFlow-NeedTrainingToTrain-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainToMeasureAgain-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-Measure5kmTimeAfterTraining-id-0002" name="Measure 5km Time (After Training)">
      <bpmn:incoming>SequenceFlow-TrainToMeasureAgain-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MeasureAgainToGetNumber-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-CheckWorkdayEndTime-id-0001" name="Check Workday End Time">
      <bpmn:incoming>SequenceFlow-GetNumberToCheckWorkday-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckWorkdayToCalculate-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="ScriptTask-CalculateTimeDifference-id-0001" name="Calculate Time Difference between Work End and Start Time">
      <bpmn:incoming>SequenceFlow-CheckWorkdayToCalculate-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CalculateToTravelDecision-id-0001</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-TravelDecision-id-0001" name="Travel Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CalculateToTravelDecision-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TravelFromHome-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-TravelFromWork-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-DecideTravelRouteFromHome-id-0001" name="Decide Travel Route: From Home">
      <bpmn:incoming>SequenceFlow-TravelFromHome-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HomeRouteToRun-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DecideTravelRouteFromWork-id-0001" name="Decide Travel Route: From Work">
      <bpmn:incoming>SequenceFlow-TravelFromWork-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WorkRouteToRun-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-RunAndDrink-id-0001" name="Run and Drink Simultaneously">
      <bpmn:incoming>SequenceFlow-HomeRouteToRun-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-WorkRouteToRun-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RunToReceiveTime-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ReceiveFinalTime-id-0001" name="Receive Final Running Time">
      <bpmn:incoming>SequenceFlow-RunToReceiveTime-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveTimeToEnd-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-FinalTimeReceived-id-0001" name="Final Time Received">
      <bpmn:incoming>SequenceFlow-ReceiveTimeToEnd-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSelectBlock-id-0001" sourceRef="StartEvent-StartViennaNightRun-id-0001" targetRef="UserTask-SelectStartingBlock-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectBlockToMeasureTime-id-0001" sourceRef="UserTask-SelectStartingBlock-id-0001" targetRef="ServiceTask-Measure5kmTime-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MeasureTimeToQualification-id-0001" sourceRef="ServiceTask-Measure5kmTime-id-0001" targetRef="ExclusiveGateway-QualificationCheck-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-QualifiedToGetNumber-id-0001" name="measured_time ≤ PT25M" sourceRef="ExclusiveGateway-QualificationCheck-id-0001" targetRef="ServiceTask-GetStartingNumber-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NeedTrainingToTrain-id-0001" name="measured_time &#62; PT25M" sourceRef="ExclusiveGateway-QualificationCheck-id-0001" targetRef="UserTask-TrainUntilGoal-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TrainToMeasureAgain-id-0001" sourceRef="UserTask-TrainUntilGoal-id-0001" targetRef="ServiceTask-Measure5kmTimeAfterTraining-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-MeasureAgainToGetNumber-id-0001" sourceRef="ServiceTask-Measure5kmTimeAfterTraining-id-0002" targetRef="ServiceTask-GetStartingNumber-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GetNumberToCheckWorkday-id-0001" sourceRef="ServiceTask-GetStartingNumber-id-0001" targetRef="UserTask-CheckWorkdayEndTime-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckWorkdayToCalculate-id-0001" sourceRef="UserTask-CheckWorkdayEndTime-id-0001" targetRef="ScriptTask-CalculateTimeDifference-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CalculateToTravelDecision-id-0001" sourceRef="ScriptTask-CalculateTimeDifference-id-0001" targetRef="ExclusiveGateway-TravelDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TravelFromHome-id-0001" name="time_difference &#62; PT1H" sourceRef="ExclusiveGateway-TravelDecision-id-0001" targetRef="UserTask-DecideTravelRouteFromHome-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TravelFromWork-id-0001" name="time_difference ≤ PT1H" sourceRef="ExclusiveGateway-TravelDecision-id-0001" targetRef="UserTask-DecideTravelRouteFromWork-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-HomeRouteToRun-id-0001" sourceRef="UserTask-DecideTravelRouteFromHome-id-0001" targetRef="ServiceTask-RunAndDrink-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WorkRouteToRun-id-0001" sourceRef="UserTask-DecideTravelRouteFromWork-id-0001" targetRef="ServiceTask-RunAndDrink-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RunToReceiveTime-id-0001" sourceRef="ServiceTask-RunAndDrink-id-0001" targetRef="ServiceTask-ReceiveFinalTime-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveTimeToEnd-id-0001" sourceRef="ServiceTask-ReceiveFinalTime-id-0001" targetRef="EndEvent-FinalTimeReceived-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ViennaNightRunProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_ViennaNightRunProcess-id-0001" bpmnElement="ViennaNightRunProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-StartViennaNightRun-id-0001_di" bpmnElement="StartEvent-StartViennaNightRun-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SelectStartingBlock-id-0001_di" bpmnElement="UserTask-SelectStartingBlock-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-Measure5kmTime-id-0001_di" bpmnElement="ServiceTask-Measure5kmTime-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-QualificationCheck-id-0001_di" bpmnElement="ExclusiveGateway-QualificationCheck-id-0001" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GetStartingNumber-id-0001_di" bpmnElement="ServiceTask-GetStartingNumber-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CheckWorkdayEndTime-id-0001_di" bpmnElement="UserTask-CheckWorkdayEndTime-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScriptTask-CalculateTimeDifference-id-0001_di" bpmnElement="ScriptTask-CalculateTimeDifference-id-0001">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-TravelDecision-id-0001_di" bpmnElement="ExclusiveGateway-TravelDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DecideTravelRouteFromHome-id-0001_di" bpmnElement="UserTask-DecideTravelRouteFromHome-id-0001">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RunAndDrink-id-0001_di" bpmnElement="ServiceTask-RunAndDrink-id-0001">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ReceiveFinalTime-id-0001_di" bpmnElement="ServiceTask-ReceiveFinalTime-id-0001">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-FinalTimeReceived-id-0001_di" bpmnElement="EndEvent-FinalTimeReceived-id-0001">
        <dc:Bounds x="1707" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-TrainUntilGoal-id-0001_di" bpmnElement="UserTask-TrainUntilGoal-id-0001">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-Measure5kmTimeAfterTraining-id-0002_di" bpmnElement="ServiceTask-Measure5kmTimeAfterTraining-id-0002">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DecideTravelRouteFromWork-id-0001_di" bpmnElement="UserTask-DecideTravelRouteFromWork-id-0001">
        <dc:Bounds x="1375" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSelectBlock-id-0001_di" bpmnElement="SequenceFlow-StartToSelectBlock-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectBlockToMeasureTime-id-0001_di" bpmnElement="SequenceFlow-SelectBlockToMeasureTime-id-0001">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MeasureTimeToQualification-id-0001_di" bpmnElement="SequenceFlow-MeasureTimeToQualification-id-0001">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-QualifiedToGetNumber-id-0001_di" bpmnElement="SequenceFlow-QualifiedToGetNumber-id-0001">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-NeedTrainingToTrain-id-0001_di" bpmnElement="SequenceFlow-NeedTrainingToTrain-id-0001">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GetNumberToCheckWorkday-id-0001_di" bpmnElement="SequenceFlow-GetNumberToCheckWorkday-id-0001">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckWorkdayToCalculate-id-0001_di" bpmnElement="SequenceFlow-CheckWorkdayToCalculate-id-0001">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CalculateToTravelDecision-id-0001_di" bpmnElement="SequenceFlow-CalculateToTravelDecision-id-0001">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TravelFromHome-id-0001_di" bpmnElement="SequenceFlow-TravelFromHome-id-0001">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TravelFromWork-id-0001_di" bpmnElement="SequenceFlow-TravelFromWork-id-0001">
        <di:waypoint x="1125" y="95" />
        <di:waypoint x="1125" y="210" />
        <di:waypoint x="1375" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-HomeRouteToRun-id-0001_di" bpmnElement="SequenceFlow-HomeRouteToRun-id-0001">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RunToReceiveTime-id-0001_di" bpmnElement="SequenceFlow-RunToReceiveTime-id-0001">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1525" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveTimeToEnd-id-0001_di" bpmnElement="SequenceFlow-ReceiveTimeToEnd-id-0001">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1707" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TrainToMeasureAgain-id-0001_di" bpmnElement="SequenceFlow-TrainToMeasureAgain-id-0001">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MeasureAgainToGetNumber-id-0001_di" bpmnElement="SequenceFlow-MeasureAgainToGetNumber-id-0001">
        <di:waypoint x="825" y="250" />
        <di:waypoint x="825" y="280" />
        <di:waypoint x="675" y="280" />
        <di:waypoint x="675" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-WorkRouteToRun-id-0001_di" bpmnElement="SequenceFlow-WorkRouteToRun-id-0001">
        <di:waypoint x="1425" y="170" />
        <di:waypoint x="1425" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
