<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CentralVenousCatheterization" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler (https://bpmn.io)" exporterVersion="2.0.0">
  <bpmn:process id="Process_CentralVenousCatheterization" isExecutable="true">
    <bpmn:startEvent id="StartEvent-BeginProcedure-id-0001" name="Begin Central Venous Catheterization">
      <bpmn:outgoing>SequenceFlow-StartToPrepare-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-PrepareImplements-id-0001" name="Prepare implements">
      <bpmn:incoming>SequenceFlow-StartToPrepare-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareToWash-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-WashHands-id-0002" name="Wash hands and wear sterile clothes">
      <bpmn:incoming>SequenceFlow-PrepareToWash-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WashToClean-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CleanPunctureArea-id-0003" name="Clean puncture area">
      <bpmn:incoming>SequenceFlow-WashToClean-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CleanToDrape-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DrapePunctureZone-id-0004" name="Drape puncture zone">
      <bpmn:incoming>SequenceFlow-CleanToDrape-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DrapeToConfigure-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConfigureUltrasound-id-0005" name="Configure ultrasound">
      <bpmn:incoming>SequenceFlow-DrapeToConfigure-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConfigureToApplyGel-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ApplyGelToProbe-id-0006" name="Apply gel to probe">
      <bpmn:incoming>SequenceFlow-ConfigureToApplyGel-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApplyGelToCover-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CoverProbe-id-0007" name="Cover probe and apply sterile gel">
      <bpmn:incoming>SequenceFlow-ApplyGelToCover-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CoverToPosition-id-0008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-PositionProbeAndPatient-id-0008" name="Position probe and patient">
      <bpmn:incoming>SequenceFlow-CoverToPosition-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PositionToVeinIdentification-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-VeinIdentification-id-0001" name="Vein Identification Method" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-PositionToVeinIdentification-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VeinIdentificationToAnatomy-id-0010</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-VeinIdentificationToDoppler-id-0011</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-VeinIdentificationToCompression-id-0012</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-IdentifyVeinAnatomy-id-0009" name="Identify vein via anatomy">
      <bpmn:incoming>SequenceFlow-VeinIdentificationToAnatomy-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnatomyToAnesthetize-id-0013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-IdentifyVeinDoppler-id-0010" name="Identify vein via Doppler">
      <bpmn:incoming>SequenceFlow-VeinIdentificationToDoppler-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DopplerToAnesthetize-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-IdentifyVeinCompression-id-0011" name="Identify vein via compression">
      <bpmn:incoming>SequenceFlow-VeinIdentificationToCompression-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CompressionToAnesthetize-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AnesthetizePatient-id-0012" name="Anesthetize patient">
      <bpmn:incoming>SequenceFlow-AnatomyToAnesthetize-id-0013</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DopplerToAnesthetize-id-0014</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CompressionToAnesthetize-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnesthetizeToPuncture-id-0016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-PunctureVein-id-0013" name="Puncture vein">
      <bpmn:incoming>SequenceFlow-AnesthetizeToPuncture-id-0016</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-BloodReturnIncorrectToPuncture-id-0020</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-WirePositionBadToPuncture-id-0030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PunctureToBloodReturn-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CheckBloodReturn-id-0014" name="Check blood return">
      <bpmn:incoming>SequenceFlow-PunctureToBloodReturn-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BloodReturnToCheck-id-0018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-BloodReturn-id-0002" name="Blood Return Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-BloodReturnToCheck-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BloodReturnCorrectToDrop-id-0019</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-BloodReturnIncorrectToPuncture-id-0020</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-DropProbe-id-0015" name="Drop probe and remove syringe">
      <bpmn:incoming>SequenceFlow-BloodReturnCorrectToDrop-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DropToInstall-id-0021</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-InstallGuidewire-id-0016" name="Install guidewire">
      <bpmn:incoming>SequenceFlow-DropToInstall-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InstallToRemoveTrocar-id-0022</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-RemoveTrocar-id-0017" name="Remove trocar">
      <bpmn:incoming>SequenceFlow-InstallToRemoveTrocar-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RemoveTrocarToWireCheck-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="InclusiveGateway-WireCheck-id-0001" name="Wire Position Check">
      <bpmn:incoming>SequenceFlow-RemoveTrocarToWireCheck-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WireCheckToLongAxis-id-0024</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-WireCheckToShortAxis-id-0025</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="UserTask-CheckWireLongAxis-id-0018" name="Check wire in long axis">
      <bpmn:incoming>SequenceFlow-WireCheckToLongAxis-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LongAxisToVerify-id-0026</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CheckWireShortAxis-id-0019" name="Check wire in short axis">
      <bpmn:incoming>SequenceFlow-WireCheckToShortAxis-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ShortAxisToVerify-id-0027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-VerifyWirePosition-id-0020" name="Verify wire position">
      <bpmn:incoming>SequenceFlow-LongAxisToVerify-id-0026</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ShortAxisToVerify-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToWirePositionCheck-id-0028</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-WirePosition-id-0003" name="Wire Position Verification" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-VerifyToWirePositionCheck-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WirePositionGoodToWiden-id-0029</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-WirePositionBadToPuncture-id-0030</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-WidenPathway-id-0021" name="Widen pathway">
      <bpmn:incoming>SequenceFlow-WirePositionGoodToWiden-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WidenToAdvance-id-0031</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AdvanceCatheter-id-0022" name="Advance catheter">
      <bpmn:incoming>SequenceFlow-WidenToAdvance-id-0031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdvanceToRemoveGuidewire-id-0032</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-RemoveGuidewire-id-0023" name="Remove guidewire">
      <bpmn:incoming>SequenceFlow-AdvanceToRemoveGuidewire-id-0032</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RemoveGuidewireToVerifyFlow-id-0033</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-VerifyFlow-id-0024" name="Verify flow and reflow">
      <bpmn:incoming>SequenceFlow-RemoveGuidewireToVerifyFlow-id-0033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyFlowToCheckPosition-id-0034</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CheckCatheterPosition-id-0025" name="Check catheter position">
      <bpmn:incoming>SequenceFlow-VerifyFlowToCheckPosition-id-0034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckPositionToEnd-id-0035</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcedureComplete-id-0001" name="Procedure Complete">
      <bpmn:incoming>SequenceFlow-CheckPositionToEnd-id-0035</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToPrepare-id-0001" sourceRef="StartEvent-BeginProcedure-id-0001" targetRef="UserTask-PrepareImplements-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareToWash-id-0002" sourceRef="UserTask-PrepareImplements-id-0001" targetRef="UserTask-WashHands-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-WashToClean-id-0003" sourceRef="UserTask-WashHands-id-0002" targetRef="UserTask-CleanPunctureArea-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CleanToDrape-id-0004" sourceRef="UserTask-CleanPunctureArea-id-0003" targetRef="UserTask-DrapePunctureZone-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-DrapeToConfigure-id-0005" sourceRef="UserTask-DrapePunctureZone-id-0004" targetRef="UserTask-ConfigureUltrasound-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ConfigureToApplyGel-id-0006" sourceRef="UserTask-ConfigureUltrasound-id-0005" targetRef="UserTask-ApplyGelToProbe-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-ApplyGelToCover-id-0007" sourceRef="UserTask-ApplyGelToProbe-id-0006" targetRef="UserTask-CoverProbe-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-CoverToPosition-id-0008" sourceRef="UserTask-CoverProbe-id-0007" targetRef="UserTask-PositionProbeAndPatient-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-PositionToVeinIdentification-id-0009" sourceRef="UserTask-PositionProbeAndPatient-id-0008" targetRef="ExclusiveGateway-VeinIdentification-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-VeinIdentificationToAnatomy-id-0010" name="use_anatomic_identification" sourceRef="ExclusiveGateway-VeinIdentification-id-0001" targetRef="UserTask-IdentifyVeinAnatomy-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-VeinIdentificationToDoppler-id-0011" name="use_doppler_identification" sourceRef="ExclusiveGateway-VeinIdentification-id-0001" targetRef="UserTask-IdentifyVeinDoppler-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-VeinIdentificationToCompression-id-0012" sourceRef="ExclusiveGateway-VeinIdentification-id-0001" targetRef="UserTask-IdentifyVeinCompression-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-AnatomyToAnesthetize-id-0013" sourceRef="UserTask-IdentifyVeinAnatomy-id-0009" targetRef="UserTask-AnesthetizePatient-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-DopplerToAnesthetize-id-0014" sourceRef="UserTask-IdentifyVeinDoppler-id-0010" targetRef="UserTask-AnesthetizePatient-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-CompressionToAnesthetize-id-0015" sourceRef="UserTask-IdentifyVeinCompression-id-0011" targetRef="UserTask-AnesthetizePatient-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-AnesthetizeToPuncture-id-0016" sourceRef="UserTask-AnesthetizePatient-id-0012" targetRef="UserTask-PunctureVein-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-PunctureToBloodReturn-id-0017" sourceRef="UserTask-PunctureVein-id-0013" targetRef="UserTask-CheckBloodReturn-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-BloodReturnToCheck-id-0018" sourceRef="UserTask-CheckBloodReturn-id-0014" targetRef="ExclusiveGateway-BloodReturn-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-BloodReturnCorrectToDrop-id-0019" name="blood_return_correct" sourceRef="ExclusiveGateway-BloodReturn-id-0002" targetRef="UserTask-DropProbe-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-BloodReturnIncorrectToPuncture-id-0020" sourceRef="ExclusiveGateway-BloodReturn-id-0002" targetRef="UserTask-PunctureVein-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-DropToInstall-id-0021" sourceRef="UserTask-DropProbe-id-0015" targetRef="UserTask-InstallGuidewire-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-InstallToRemoveTrocar-id-0022" sourceRef="UserTask-InstallGuidewire-id-0016" targetRef="UserTask-RemoveTrocar-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-RemoveTrocarToWireCheck-id-0023" sourceRef="UserTask-RemoveTrocar-id-0017" targetRef="InclusiveGateway-WireCheck-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WireCheckToLongAxis-id-0024" name="check_long_axis" sourceRef="InclusiveGateway-WireCheck-id-0001" targetRef="UserTask-CheckWireLongAxis-id-0018" />
    <bpmn:sequenceFlow id="SequenceFlow-WireCheckToShortAxis-id-0025" name="check_short_axis" sourceRef="InclusiveGateway-WireCheck-id-0001" targetRef="UserTask-CheckWireShortAxis-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-LongAxisToVerify-id-0026" sourceRef="UserTask-CheckWireLongAxis-id-0018" targetRef="UserTask-VerifyWirePosition-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-ShortAxisToVerify-id-0027" sourceRef="UserTask-CheckWireShortAxis-id-0019" targetRef="UserTask-VerifyWirePosition-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyToWirePositionCheck-id-0028" sourceRef="UserTask-VerifyWirePosition-id-0020" targetRef="ExclusiveGateway-WirePosition-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-WirePositionGoodToWiden-id-0029" name="wire_in_good_position" sourceRef="ExclusiveGateway-WirePosition-id-0003" targetRef="UserTask-WidenPathway-id-0021" />
    <bpmn:sequenceFlow id="SequenceFlow-WirePositionBadToPuncture-id-0030" sourceRef="ExclusiveGateway-WirePosition-id-0003" targetRef="UserTask-PunctureVein-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-WidenToAdvance-id-0031" sourceRef="UserTask-WidenPathway-id-0021" targetRef="UserTask-AdvanceCatheter-id-0022" />
    <bpmn:sequenceFlow id="SequenceFlow-AdvanceToRemoveGuidewire-id-0032" sourceRef="UserTask-AdvanceCatheter-id-0022" targetRef="UserTask-RemoveGuidewire-id-0023" />
    <bpmn:sequenceFlow id="SequenceFlow-RemoveGuidewireToVerifyFlow-id-0033" sourceRef="UserTask-RemoveGuidewire-id-0023" targetRef="UserTask-VerifyFlow-id-0024" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyFlowToCheckPosition-id-0034" sourceRef="UserTask-VerifyFlow-id-0024" targetRef="UserTask-CheckCatheterPosition-id-0025" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckPositionToEnd-id-0035" sourceRef="UserTask-CheckCatheterPosition-id-0025" targetRef="EndEvent-ProcedureComplete-id-0001" />
  </bpmn:process>
