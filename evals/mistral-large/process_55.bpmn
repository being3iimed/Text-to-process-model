        <dc:Bounds x="3475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-RemoveGuidewire-id-0023_di" bpmnElement="UserTask-RemoveGuidewire-id-0023">
        <dc:Bounds x="3625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-VerifyFlow-id-0024_di" bpmnElement="UserTask-VerifyFlow-id-0024">
        <dc:Bounds x="3775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CheckCatheterPosition-id-0025_di" bpmnElement="UserTask-CheckCatheterPosition-id-0025">
