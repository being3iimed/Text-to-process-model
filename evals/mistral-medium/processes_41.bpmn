        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckAnswersToAdditionalQuestions-id-0009_di" bpmnElement="SequenceFlow-CheckAnswersToAdditionalQuestions-id-0009">
