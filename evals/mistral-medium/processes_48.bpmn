        <di:waypoint x="1000" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TravelGatewayToWork-id-0008_di" bpmnElement="SequenceFlow-TravelGatewayToWork-id-0008">
        <di:waypoint x="975" y="95" />
        <di:waypoint x="975" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-HomeToParallelSplit-id-0009_di" bpmnElement="SequenceFlow-HomeToParallelSplit-id-0009">
