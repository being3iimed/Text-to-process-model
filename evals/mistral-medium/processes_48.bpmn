      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-Qualified-id-0001_di" bpmnElement="EndEvent-Qualified-id-0001">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CollectTrainingData-id-0003_di" bpmnElement="ServiceTask-CollectTrainingData-id-0003">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent-ContinueTraining-id-0001_di" bpmnElement="IntermediateCatchEvent-ContinueTraining-id-0001">
        <dc:Bounds x="807" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-TrainingStartToMeasure-id-0001_di" bpmnElement="SequenceFlow-TrainingStartToMeasure-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MeasureToCheck-id-0002_di" bpmnElement="SequenceFlow-MeasureToCheck-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckToGateway-id-0003_di" bpmnElement="SequenceFlow-CheckToGateway-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToQualified-id-0004_di" bpmnElement="SequenceFlow-GatewayToQualified-id-0004">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToCollect-id-0005_di" bpmnElement="SequenceFlow-GatewayToCollect-id-0005">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CollectToContinue-id-0006_di" bpmnElement="SequenceFlow-CollectToContinue-id-0006">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="807" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ContinueToMeasure-id-0007_di" bpmnElement="SequenceFlow-ContinueToMeasure-id-0007">
        <di:waypoint x="825" y="228" />
