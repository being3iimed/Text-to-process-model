      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateStartingNumber-id-0001_di" bpmnElement="ServiceTask-GenerateStartingNumber-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CalculateTravelTime-id-0002_di" bpmnElement="ServiceTask-CalculateTravelTime-id-0002">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-TravelTimeCheck-id-0002_di" bpmnElement="ExclusiveGateway-TravelTimeCheck-id-0002" isMarkerVisible="true">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-TravelFromHome-id-0003_di" bpmnElement="UserTask-TravelFromHome-id-0003">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-RunDrinkSplit-id-0001_di" bpmnElement="ParallelGateway-RunDrinkSplit-id-0001">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-Run5kmRoute-id-0005_di" bpmnElement="UserTask-Run5kmRoute-id-0005">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-RunDrinkJoin-id-0002_di" bpmnElement="ParallelGateway-RunDrinkJoin-id-0002">
        <dc:Bounds x="1550" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RecordFinalTime-id-0003_di" bpmnElement="ServiceTask-RecordFinalTime-id-0003">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-FinalTimeRecorded-id-0001_di" bpmnElement="EndEvent-FinalTimeRecorded-id-0001">
        <dc:Bounds x="1857" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-TravelFromWork-id-0004_di" bpmnElement="UserTask-TravelFromWork-id-0004">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DrinkDuringRun-id-0006_di" bpmnElement="UserTask-DrinkDuringRun-id-0006">
        <dc:Bounds x="1375" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSelectBlock-id-0001_di" bpmnElement="SequenceFlow-StartToSelectBlock-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectToEnterSchedule-id-0002_di" bpmnElement="SequenceFlow-SelectToEnterSchedule-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EnterToTraining-id-0003_di" bpmnElement="SequenceFlow-EnterToTraining-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TrainingToGenerate-id-0004_di" bpmnElement="SequenceFlow-TrainingToGenerate-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
