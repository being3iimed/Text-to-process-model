        <di:waypoint x="1575" y="210" />
        <di:waypoint x="1575" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-TrainingCycle-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-TrainingCycle-id-0001" bpmnElement="SubProcess-TrainingCycle-id-0001">
      <bpmndi:BPMNShape id="StartEvent-BeginTraining-id-0001_di" bpmnElement="StartEvent-BeginTraining-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-Measure5kmTime-id-0001_di" bpmnElement="ServiceTask-Measure5kmTime-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CheckTimeGoal-id-0002_di" bpmnElement="ServiceTask-CheckTimeGoal-id-0002">
