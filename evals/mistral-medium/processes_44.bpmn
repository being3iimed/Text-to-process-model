      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MenuAskToGateway-id-0003_di" bpmnElement="SequenceFlow-MenuAskToGateway-id-0003">
        <di:waypoint x="425" y="70" />
