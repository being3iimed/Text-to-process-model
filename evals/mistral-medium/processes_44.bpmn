      <bpmndi:BPMNShape id="StartEvent-SideDishPrepStart-id-0001_di" bpmnElement="StartEvent-SideDishPrepStart-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AskFriesOrWedges-id-0001_di" bpmnElement="UserTask-AskFriesOrWedges-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-SideDecision-id-0001_di" bpmnElement="ExclusiveGateway-SideDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PrepareFries-id-0001_di" bpmnElement="ServiceTask-PrepareFries-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-SideDishReady-id-0001_di" bpmnElement="EndEvent-SideDishReady-id-0001">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PrepareWedges-id-0001_di" bpmnElement="ServiceTask-PrepareWedges-id-0001">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-SideStartToAsk-id-0001_di" bpmnElement="SequenceFlow-SideStartToAsk-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AskToSideGateway-id-0002_di" bpmnElement="SequenceFlow-AskToSideGateway-id-0002">
