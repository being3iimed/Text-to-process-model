      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MenuGatewayToDrink-id-0004_di" bpmnElement="SequenceFlow-MenuGatewayToDrink-id-0004">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MenuGatewayToBurger-id-0005_di" bpmnElement="SequenceFlow-MenuGatewayToBurger-id-0005">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="140" />
        <di:waypoint x="975" y="140" />
        <di:waypoint x="975" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DrinkToSideSubprocess-id-0006_di" bpmnElement="SequenceFlow-DrinkToSideSubprocess-id-0006">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SideSubprocessToBurger-id-0007_di" bpmnElement="SequenceFlow-SideSubprocessToBurger-id-0007">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
