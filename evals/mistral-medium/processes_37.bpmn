  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-OrderParts-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-OrderParts-id-0001" bpmnElement="SubProcess-OrderParts-id-0001">
      <bpmndi:BPMNShape id="StartEvent-OrderingStarted-id-0001_di" bpmnElement="StartEvent-OrderingStarted-id-0001">
