    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-ManageStockAndReorders-id-0001" bpmnElement="SubProcess-ManageStockAndReorders-id-0001">
      <bpmndi:BPMNShape id="StartEvent-StockManagementStarted-id-0001_di" bpmnElement="StartEvent-StockManagementStarted-id-0001">
