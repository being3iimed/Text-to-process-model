      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReportingToDirectorate-id-0013_di" bpmnElement="SequenceFlow-ReportingToDirectorate-id-0013">
        <di:waypoint x="1125" y="95" />
        <di:waypoint x="1125" y="140" />
        <di:waypoint x="1425" y="140" />
        <di:waypoint x="1425" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReportingToLogOnly-id-0014_di" bpmnElement="SequenceFlow-ReportingToLogOnly-id-0014">
        <di:waypoint x="1125" y="95" />
        <di:waypoint x="1125" y="350" />
        <di:waypoint x="1225" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-LabourInspectorateToGenerate-id-0015_di" bpmnElement="SequenceFlow-LabourInspectorateToGenerate-id-0015">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GenerateToInsuranceProvider-id-0016_di" bpmnElement="SequenceFlow-GenerateToInsuranceProvider-id-0016">
        <di:waypoint x="1475" y="70" />
