      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssessToReportingGateway-id-0008_di" bpmnElement="SequenceFlow-AssessToReportingGateway-id-0008">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReportingToLabourInspectorate-id-0011_di" bpmnElement="SequenceFlow-ReportingToLabourInspectorate-id-0011">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReportingToInsurance-id-0012_di" bpmnElement="SequenceFlow-ReportingToInsurance-id-0012">
