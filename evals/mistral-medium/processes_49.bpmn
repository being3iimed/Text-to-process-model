        <dc:Bounds x="657" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RepairSoftware-id-0005_di" bpmnElement="ServiceTask-RepairSoftware-id-0005">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TestSoftwareFunctionality-id-0006_di" bpmnElement="ServiceTask-TestSoftwareFunctionality-id-0006">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-SoftwareTestResult-id-0001_di" bpmnElement="ExclusiveGateway-SoftwareTestResult-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1100" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-RepairSoftwareRepeat-id-0007_di" bpmnElement="ServiceTask-RepairSoftwareRepeat-id-0007">
        <dc:Bounds x="1225" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TestSoftwareFunctionalityRepeat-id-0008_di" bpmnElement="ServiceTask-TestSoftwareFunctionalityRepeat-id-0008">
        <dc:Bounds x="1375" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCheckDefect-id-0001_di" bpmnElement="SequenceFlow-StartToCheckDefect-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckDefectToCustomerDecision-id-0002_di" bpmnElement="SequenceFlow-CheckDefectToCustomerDecision-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
