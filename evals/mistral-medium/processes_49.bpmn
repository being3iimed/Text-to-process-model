<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ComputerRepairProcess-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="ComputerRepairProcess-id-0001" name="Computer Repair Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CustomerBringsDefectiveComputer-id-0001" name="Customer Brings Defective Computer">
      <bpmn:outgoing>SequenceFlow-StartToCheckDefect-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-CheckDefectAndCalculateRepairCost-id-0001" name="Check Defect and Calculate Repair Cost">
      <bpmn:incoming>SequenceFlow-StartToCheckDefect-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckDefectToCustomerDecision-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CustomerAcceptsRejectsCost-id-0002" name="Customer Accepts/Rejects Cost">
      <bpmn:incoming>SequenceFlow-CheckDefectToCustomerDecision-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerDecisionToCostGateway-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CostDecision-id-0001" name="Cost Acceptable?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CustomerDecisionToCostGateway-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CostAcceptedToParallelRepair-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CostRejectedToEnd-id-0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ParallelGateway-ParallelRepairActivities-id-0001" name="Parallel Repair Activities" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CostAcceptedToParallelRepair-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ParallelToHardwareRepair-id-0006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ParallelToSoftwareRepair-id-0013</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-RepairHardware-id-0001" name="Repair Hardware">
      <bpmn:incoming>SequenceFlow-ParallelToHardwareRepair-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HardwareRepairToTest-id-0007</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TestHardwareFunctionality-id-0002" name="Test Hardware Functionality">
      <bpmn:incoming>SequenceFlow-HardwareRepairToTest-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HardwareTestToGateway-id-0008</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-HardwareTestResult-id-0001" name="Hardware Test Passed?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-HardwareTestToGateway-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HardwareTestPassedToEnd-id-0009</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-HardwareTestFailedToRepairRepeat-id-0010</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-RepairHardwareRepeat-id-0003" name="Repair Hardware (Repeat)">
      <bpmn:incoming>SequenceFlow-HardwareTestFailedToRepairRepeat-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HardwareRepairRepeatToTestRepeat-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TestHardwareFunctionalityRepeat-id-0004" name="Test Hardware Functionality (Repeat)">
      <bpmn:incoming>SequenceFlow-HardwareRepairRepeatToTestRepeat-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HardwareTestRepeatToEnd-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-RepairSoftware-id-0005" name="Repair Software">
      <bpmn:incoming>SequenceFlow-ParallelToSoftwareRepair-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SoftwareRepairToTest-id-0014</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TestSoftwareFunctionality-id-0006" name="Test Software Functionality">
      <bpmn:incoming>SequenceFlow-SoftwareRepairToTest-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SoftwareTestToGateway-id-0015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-SoftwareTestResult-id-0001" name="Software Test Passed?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SoftwareTestToGateway-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SoftwareTestPassedToEnd-id-0016</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SoftwareTestFailedToRepairRepeat-id-0017</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-RepairSoftwareRepeat-id-0007" name="Repair Software (Repeat)">
      <bpmn:incoming>SequenceFlow-SoftwareTestFailedToRepairRepeat-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SoftwareRepairRepeatToTestRepeat-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TestSoftwareFunctionalityRepeat-id-0008" name="Test Software Functionality (Repeat)">
      <bpmn:incoming>SequenceFlow-SoftwareRepairRepeatToTestRepeat-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SoftwareTestRepeatToEnd-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-RepairComplete-id-0001" name="Repair Complete">
      <bpmn:incoming>SequenceFlow-HardwareTestPassedToEnd-id-0009</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-HardwareTestRepeatToEnd-id-0012</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SoftwareTestPassedToEnd-id-0016</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SoftwareTestRepeatToEnd-id-0019</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-CustomerDeclinesRepair-id-0002" name="Customer Declines Repair">
      <bpmn:incoming>SequenceFlow-CostRejectedToEnd-id-0005</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCheckDefect-id-0001" sourceRef="StartEvent-CustomerBringsDefectiveComputer-id-0001" targetRef="UserTask-CheckDefectAndCalculateRepairCost-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckDefectToCustomerDecision-id-0002" sourceRef="UserTask-CheckDefectAndCalculateRepairCost-id-0001" targetRef="UserTask-CustomerAcceptsRejectsCost-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerDecisionToCostGateway-id-0003" sourceRef="UserTask-CustomerAcceptsRejectsCost-id-0002" targetRef="ExclusiveGateway-CostDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CostAcceptedToParallelRepair-id-0004" name="cost_acceptable == true" sourceRef="ExclusiveGateway-CostDecision-id-0001" targetRef="ParallelGateway-ParallelRepairActivities-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CostRejectedToEnd-id-0005" sourceRef="ExclusiveGateway-CostDecision-id-0001" targetRef="EndEvent-CustomerDeclinesRepair-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelToHardwareRepair-id-0006" sourceRef="ParallelGateway-ParallelRepairActivities-id-0001" targetRef="ServiceTask-RepairHardware-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-HardwareRepairToTest-id-0007" sourceRef="ServiceTask-RepairHardware-id-0001" targetRef="ServiceTask-TestHardwareFunctionality-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-HardwareTestToGateway-id-0008" sourceRef="ServiceTask-TestHardwareFunctionality-id-0002" targetRef="ExclusiveGateway-HardwareTestResult-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-HardwareTestPassedToEnd-id-0009" name="test_passed == true" sourceRef="ExclusiveGateway-HardwareTestResult-id-0001" targetRef="EndEvent-RepairComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-HardwareTestFailedToRepairRepeat-id-0010" name="test_passed == false" sourceRef="ExclusiveGateway-HardwareTestResult-id-0001" targetRef="ServiceTask-RepairHardwareRepeat-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-HardwareRepairRepeatToTestRepeat-id-0011" sourceRef="ServiceTask-RepairHardwareRepeat-id-0003" targetRef="ServiceTask-TestHardwareFunctionalityRepeat-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-HardwareTestRepeatToEnd-id-0012" sourceRef="ServiceTask-TestHardwareFunctionalityRepeat-id-0004" targetRef="EndEvent-RepairComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ParallelToSoftwareRepair-id-0013" sourceRef="ParallelGateway-ParallelRepairActivities-id-0001" targetRef="ServiceTask-RepairSoftware-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-SoftwareRepairToTest-id-0014" sourceRef="ServiceTask-RepairSoftware-id-0005" targetRef="ServiceTask-TestSoftwareFunctionality-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SoftwareTestToGateway-id-0015" sourceRef="ServiceTask-TestSoftwareFunctionality-id-0006" targetRef="ExclusiveGateway-SoftwareTestResult-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SoftwareTestPassedToEnd-id-0016" name="test_passed == true" sourceRef="ExclusiveGateway-SoftwareTestResult-id-0001" targetRef="EndEvent-RepairComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SoftwareTestFailedToRepairRepeat-id-0017" name="test_passed == false" sourceRef="ExclusiveGateway-SoftwareTestResult-id-0001" targetRef="ServiceTask-RepairSoftwareRepeat-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-SoftwareRepairRepeatToTestRepeat-id-0018" sourceRef="ServiceTask-RepairSoftwareRepeat-id-0007" targetRef="ServiceTask-TestSoftwareFunctionalityRepeat-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-SoftwareTestRepeatToEnd-id-0019" sourceRef="ServiceTask-TestSoftwareFunctionalityRepeat-id-0008" targetRef="EndEvent-RepairComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ComputerRepairProcess-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_ComputerRepairProcess-id-0001" bpmnElement="ComputerRepairProcess-id-0001">
      <bpmndi:BPMNShape id="StartEvent-CustomerBringsDefectiveComputer-id-0001_di" bpmnElement="StartEvent-CustomerBringsDefectiveComputer-id-0001">
