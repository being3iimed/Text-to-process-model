<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ecommerce-order-process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="2.0.0">
  <bpmn:process id="EcommerceOrderProcess-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CustomerInitiatesLogin-id-0001" name="Customer Initiates Login">
      <bpmn:outgoing>SequenceFlow-StartToEnterCredentials-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-EnterLoginCredentials-id-0001" name="Enter Login Credentials">
      <bpmn:incoming>SequenceFlow-StartToEnterCredentials-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnterCredentialsToCheck-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CheckCredentials-id-0001" name="Check Credentials">
      <bpmn:incoming>SequenceFlow-EnterCredentialsToCheck-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckToCredentialsValid-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CredentialsValid-id-0001" name="Credentials Valid?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckToCredentialsValid-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CredentialsValidToLoginFailed-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-CredentialsValidToSelectProduct-id-0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-LoginFailed-id-0001" name="Login Failed">
      <bpmn:incoming>SequenceFlow-CredentialsValidToLoginFailed-id-0004</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-SelectProduct-id-0001" name="Select Product">
      <bpmn:incoming>SequenceFlow-CredentialsValidToSelectProduct-id-0005</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ProductsSelectedToSelectProduct-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectProductToAddCart-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AddToCart-id-0001" name="Add to Cart">
      <bpmn:incoming>SequenceFlow-SelectProductToAddCart-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AddCartToSaveProduct-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-SaveProductToCart-id-0001" name="Save Product to Cart">
      <bpmn:incoming>SequenceFlow-AddCartToSaveProduct-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SaveProductToCheckAll-id-0008</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-CheckAllProductsSelected-id-0001" name="Check All Products Selected">
      <bpmn:incoming>SequenceFlow-SaveProductToCheckAll-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckAllToProductsSelected-id-0009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AllProductsSelected-id-0001" name="All Products Selected?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckAllToProductsSelected-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProductsSelectedToFinishOrder-id-0010</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ProductsSelectedToSelectProduct-id-0011</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-FinishOrder-id-0001" name="Finish Order">
      <bpmn:incoming>SequenceFlow-ProductsSelectedToFinishOrder-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FinishOrderToSplit-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0001" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-FinishOrderToSplit-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToPaymentProcessing-id-0013</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToPrepareShipment-id-0014</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="SubProcess-PaymentProcessing-id-0001" name="Payment Processing">
      <bpmn:incoming>SequenceFlow-SplitToPaymentProcessing-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PaymentProcessingToJoin-id-0015</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-PaymentStart-id-0001" name="Payment Start">
        <bpmn:outgoing>SequenceFlow-PaymentStartToEnterData-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-EnterPaymentData-id-0001" name="Enter Payment Data">
        <bpmn:incoming>SequenceFlow-PaymentStartToEnterData-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-EnterDataToReceiveConfirmation-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:receiveTask id="ReceiveTask-ReceiveBankConfirmation-id-0001" name="Receive: bank confirmation">
        <bpmn:incoming>SequenceFlow-EnterDataToReceiveConfirmation-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BankConfirmationToShipping-id-0003</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="BoundaryEvent-Timer10Min-BankConfirmation-id-0001" name="10 Minute Timeout" attachedToRef="ReceiveTask-ReceiveBankConfirmation-id-0001">
        <bpmn:outgoing>SequenceFlow-BoundaryToTimeoutNotification-id-0004</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-Timer10Min-BankConfirmation-id-0001_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="SendTask-PaymentTimeoutNotification-id-0001" name="Send: payment timeout notification">
        <bpmn:incoming>SequenceFlow-BoundaryToTimeoutNotification-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TimeoutNotificationToShipping-id-0005</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="UserTask-EnterShippingAddress-id-0001" name="Enter Shipping Address">
        <bpmn:incoming>SequenceFlow-BankConfirmationToShipping-id-0003</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-TimeoutNotificationToShipping-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ShippingToBillingDecision-id-0006</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-BillingDifferent-id-0001" name="Billing Different?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-ShippingToBillingDecision-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BillingDecisionToBillingAddress-id-0007</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-BillingDecisionToPaymentComplete-id-0008</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UserTask-EnterBillingAddress-id-0001" name="Enter Billing Address (if different)">
        <bpmn:incoming>SequenceFlow-BillingDecisionToBillingAddress-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BillingAddressToPaymentComplete-id-0009</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EndEvent-PaymentComplete-id-0001" name="Payment Complete">
        <bpmn:incoming>SequenceFlow-BillingDecisionToPaymentComplete-id-0008</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-BillingAddressToPaymentComplete-id-0009</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-PaymentStartToEnterData-id-0001" sourceRef="StartEvent-PaymentStart-id-0001" targetRef="UserTask-EnterPaymentData-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-EnterDataToReceiveConfirmation-id-0002" sourceRef="UserTask-EnterPaymentData-id-0001" targetRef="ReceiveTask-ReceiveBankConfirmation-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BankConfirmationToShipping-id-0003" sourceRef="ReceiveTask-ReceiveBankConfirmation-id-0001" targetRef="UserTask-EnterShippingAddress-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BoundaryToTimeoutNotification-id-0004" sourceRef="BoundaryEvent-Timer10Min-BankConfirmation-id-0001" targetRef="SendTask-PaymentTimeoutNotification-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TimeoutNotificationToShipping-id-0005" sourceRef="SendTask-PaymentTimeoutNotification-id-0001" targetRef="UserTask-EnterShippingAddress-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ShippingToBillingDecision-id-0006" sourceRef="UserTask-EnterShippingAddress-id-0001" targetRef="ExclusiveGateway-BillingDifferent-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BillingDecisionToBillingAddress-id-0007" name="billing_different" sourceRef="ExclusiveGateway-BillingDifferent-id-0001" targetRef="UserTask-EnterBillingAddress-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BillingDecisionToPaymentComplete-id-0008" sourceRef="ExclusiveGateway-BillingDifferent-id-0001" targetRef="EndEvent-PaymentComplete-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BillingAddressToPaymentComplete-id-0009" sourceRef="UserTask-EnterBillingAddress-id-0001" targetRef="EndEvent-PaymentComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="ServiceTask-PrepareShipment-id-0001" name="Prepare Shipment">
      <bpmn:incoming>SequenceFlow-SplitToPrepareShipment-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareShipmentToJoin-id-0016</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0001" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-PaymentProcessingToJoin-id-0015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-PrepareShipmentToJoin-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToFinalizeOrder-id-0017</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-FinalizeOrder-id-0001" name="Finalize Order">
      <bpmn:incoming>SequenceFlow-JoinToFinalizeOrder-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FinalizeOrderToOrderCompleted-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-OrderCompleted-id-0001" name="Order Completed">
      <bpmn:incoming>SequenceFlow-FinalizeOrderToOrderCompleted-id-0018</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToEnterCredentials-id-0001" sourceRef="StartEvent-CustomerInitiatesLogin-id-0001" targetRef="UserTask-EnterLoginCredentials-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EnterCredentialsToCheck-id-0002" sourceRef="UserTask-EnterLoginCredentials-id-0001" targetRef="ServiceTask-CheckCredentials-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckToCredentialsValid-id-0003" sourceRef="ServiceTask-CheckCredentials-id-0001" targetRef="ExclusiveGateway-CredentialsValid-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CredentialsValidToLoginFailed-id-0004" name="credentials_invalid" sourceRef="ExclusiveGateway-CredentialsValid-id-0001" targetRef="EndEvent-LoginFailed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CredentialsValidToSelectProduct-id-0005" name="credentials_valid" sourceRef="ExclusiveGateway-CredentialsValid-id-0001" targetRef="UserTask-SelectProduct-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectProductToAddCart-id-0006" sourceRef="UserTask-SelectProduct-id-0001" targetRef="UserTask-AddToCart-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AddCartToSaveProduct-id-0007" sourceRef="UserTask-AddToCart-id-0001" targetRef="ServiceTask-SaveProductToCart-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SaveProductToCheckAll-id-0008" sourceRef="ServiceTask-SaveProductToCart-id-0001" targetRef="ServiceTask-CheckAllProductsSelected-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckAllToProductsSelected-id-0009" sourceRef="ServiceTask-CheckAllProductsSelected-id-0001" targetRef="ExclusiveGateway-AllProductsSelected-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProductsSelectedToFinishOrder-id-0010" name="all_products_selected" sourceRef="ExclusiveGateway-AllProductsSelected-id-0001" targetRef="ServiceTask-FinishOrder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProductsSelectedToSelectProduct-id-0011" name="incomplete_selection" sourceRef="ExclusiveGateway-AllProductsSelected-id-0001" targetRef="UserTask-SelectProduct-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FinishOrderToSplit-id-0012" sourceRef="ServiceTask-FinishOrder-id-0001" targetRef="ParallelGateway-Split-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToPaymentProcessing-id-0013" sourceRef="ParallelGateway-Split-id-0001" targetRef="SubProcess-PaymentProcessing-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToPrepareShipment-id-0014" sourceRef="ParallelGateway-Split-id-0001" targetRef="ServiceTask-PrepareShipment-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PaymentProcessingToJoin-id-0015" sourceRef="SubProcess-PaymentProcessing-id-0001" targetRef="ParallelGateway-Join-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareShipmentToJoin-id-0016" sourceRef="ServiceTask-PrepareShipment-id-0001" targetRef="ParallelGateway-Join-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToFinalizeOrder-id-0017" sourceRef="ParallelGateway-Join-id-0001" targetRef="ServiceTask-FinalizeOrder-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FinalizeOrderToOrderCompleted-id-0018" sourceRef="ServiceTask-FinalizeOrder-id-0001" targetRef="EndEvent-OrderCompleted-id-0001" />
  </bpmn:process>
