<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="LegoCustomMachineProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="LegoCustomMachineProcess-id-0001" name="Lego Custom Machine Building Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ProcessStart-id-0001" name="Start Building Custom Lego Machine">
      <bpmn:outgoing>SequenceFlow-StartToDesign-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-DevelopBasicDesign-id-0001" name="Develop Basic Design">
      <bpmn:incoming>SequenceFlow-StartToDesign-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DesignToOrder-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-OrderLegoBrickSets-id-0001" name="Order Lego Brick Sets">
      <bpmn:incoming>SequenceFlow-DesignToOrder-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OrderToGiveSets-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-GiveLegoSetsToChildren-id-0001" name="Give Lego Sets to Children">
      <bpmn:incoming>SequenceFlow-OrderToGiveSets-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GiveSetsToSort-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ChildrenSortParts-id-0001" name="Children Sort Parts into Containers">
      <bpmn:incoming>SequenceFlow-GiveSetsToSort-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SortToSplit-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-SplitSubcomponents-id-0001" name="Build Subcomponents in Parallel" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SortToSplit-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToSub1-id-0006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToSub2-id-0007</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="SubProcess-BuildTestSubcomponent1-id-0001" name="Build and Test Subcomponent 1">
      <bpmn:incoming>SequenceFlow-SplitToSub1-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Sub1ToJoin-id-0008</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-Subcomponent1Start-id-0001" name="Start Subcomponent 1">
        <bpmn:outgoing>SequenceFlow-Sub1StartToBuild-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-BuildSubcomponent1-id-0001" name="Build Subcomponent 1">
        <bpmn:incoming>SequenceFlow-Sub1StartToBuild-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-RedesignToBuild1-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BuildToTest1-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="BoundaryEvent-Timer1Day-Subcomponent1-id-0001" name="1 Day Testing Timeout">
        <bpmn:outgoing>SequenceFlow-BoundaryToNotification1-id-0007</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-Timer1Day-Subcomponent1-id-0001_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="UserTask-TestSubcomponent1-id-0001" name="Test Subcomponent 1">
        <bpmn:incoming>SequenceFlow-BuildToTest1-id-0002</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-NotificationToTest1-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TestToGateway1-id-0003</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-TestResult1-id-0001" name="Test Result 1?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-TestToGateway1-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GatewayToSuccess1-id-0004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToFailure1-id-0005</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent-Subcomponent1Ready-id-0001" name="Subcomponent 1 Ready">
        <bpmn:incoming>SequenceFlow-GatewayToSuccess1-id-0004</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="UserTask-RedesignSubcomponent1-id-0001" name="Redesign Subcomponent 1">
        <bpmn:incoming>SequenceFlow-GatewayToFailure1-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RedesignToBuild1-id-0006</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="SendTask-TestingDelayNotification1-id-0001" name="Send: testing delay notification for Subcomponent 1">
        <bpmn:incoming>SequenceFlow-BoundaryToNotification1-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-NotificationToTest1-id-0008</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="SequenceFlow-Sub1StartToBuild-id-0001" sourceRef="StartEvent-Subcomponent1Start-id-0001" targetRef="UserTask-BuildSubcomponent1-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BuildToTest1-id-0002" sourceRef="UserTask-BuildSubcomponent1-id-0001" targetRef="UserTask-TestSubcomponent1-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TestToGateway1-id-0003" sourceRef="UserTask-TestSubcomponent1-id-0001" targetRef="ExclusiveGateway-TestResult1-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToSuccess1-id-0004" name="test_successful" sourceRef="ExclusiveGateway-TestResult1-id-0001" targetRef="EndEvent-Subcomponent1Ready-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToFailure1-id-0005" name="test_failed" sourceRef="ExclusiveGateway-TestResult1-id-0001" targetRef="UserTask-RedesignSubcomponent1-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-RedesignToBuild1-id-0006" sourceRef="UserTask-RedesignSubcomponent1-id-0001" targetRef="UserTask-BuildSubcomponent1-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BoundaryToNotification1-id-0007" sourceRef="BoundaryEvent-Timer1Day-Subcomponent1-id-0001" targetRef="SendTask-TestingDelayNotification1-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-NotificationToTest1-id-0008" sourceRef="SendTask-TestingDelayNotification1-id-0001" targetRef="UserTask-TestSubcomponent1-id-0001" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-BuildTestSubcomponent2-id-0002" name="Build and Test Subcomponent 2">
      <bpmn:incoming>SequenceFlow-SplitToSub2-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-Sub2ToJoin-id-0009</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-Subcomponent2Start-id-0001" name="Start Subcomponent 2">
        <bpmn:outgoing>SequenceFlow-Sub2StartToBuild-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-BuildSubcomponent2-id-0001" name="Build Subcomponent 2">
        <bpmn:incoming>SequenceFlow-Sub2StartToBuild-id-0001</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-RedesignToBuild2-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-BuildToTest2-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="BoundaryEvent-Timer1Day-Subcomponent2-id-0001" name="1 Day Testing Timeout">
        <bpmn:outgoing>SequenceFlow-BoundaryToNotification2-id-0007</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BoundaryEvent-Timer1Day-Subcomponent2-id-0001_EventDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="UserTask-TestSubcomponent2-id-0001" name="Test Subcomponent 2">
        <bpmn:incoming>SequenceFlow-BuildToTest2-id-0002</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-NotificationToTest2-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TestToGateway2-id-0003</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-TestResult2-id-0001" name="Test Result 2?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-TestToGateway2-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GatewayToSuccess2-id-0004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToFailure2-id-0005</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent-Subcomponent2Ready-id-0001" name="Subcomponent 2 Ready">
        <bpmn:incoming>SequenceFlow-GatewayToSuccess2-id-0004</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="UserTask-RedesignSubcomponent2-id-0001" name="Redesign Subcomponent 2">
        <bpmn:incoming>SequenceFlow-GatewayToFailure2-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RedesignToBuild2-id-0006</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="SendTask-TestingDelayNotification2-id-0001" name="Send: testing delay notification for Subcomponent 2">
        <bpmn:incoming>SequenceFlow-BoundaryToNotification2-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-NotificationToTest2-id-0008</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="SequenceFlow-Sub2StartToBuild-id-0001" sourceRef="StartEvent-Subcomponent2Start-id-0001" targetRef="UserTask-BuildSubcomponent2-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BuildToTest2-id-0002" sourceRef="UserTask-BuildSubcomponent2-id-0001" targetRef="UserTask-TestSubcomponent2-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TestToGateway2-id-0003" sourceRef="UserTask-TestSubcomponent2-id-0001" targetRef="ExclusiveGateway-TestResult2-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToSuccess2-id-0004" name="test_successful" sourceRef="ExclusiveGateway-TestResult2-id-0001" targetRef="EndEvent-Subcomponent2Ready-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToFailure2-id-0005" name="test_failed" sourceRef="ExclusiveGateway-TestResult2-id-0001" targetRef="UserTask-RedesignSubcomponent2-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-RedesignToBuild2-id-0006" sourceRef="UserTask-RedesignSubcomponent2-id-0001" targetRef="UserTask-BuildSubcomponent2-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-BoundaryToNotification2-id-0007" sourceRef="BoundaryEvent-Timer1Day-Subcomponent2-id-0001" targetRef="SendTask-TestingDelayNotification2-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-NotificationToTest2-id-0008" sourceRef="SendTask-TestingDelayNotification2-id-0001" targetRef="UserTask-TestSubcomponent2-id-0001" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="ParallelGateway-JoinSubcomponents-id-0001" name="Subcomponents Ready" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-Sub1ToJoin-id-0008</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-Sub2ToJoin-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToReorder-id-0010</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-ReorderIndividualParts-id-0001" name="Reorder Individual Parts">
      <bpmn:incoming>SequenceFlow-JoinToReorder-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReorderToAssemble-id-0011</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-AssembleMachine-id-0001" name="Assemble Machine">
      <bpmn:incoming>SequenceFlow-ReorderToAssemble-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssembleToEnd-id-0012</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-MachineAssemblyComplete-id-0001" name="Machine Assembly Complete">
      <bpmn:incoming>SequenceFlow-AssembleToEnd-id-0012</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToDesign-id-0001" sourceRef="StartEvent-ProcessStart-id-0001" targetRef="UserTask-DevelopBasicDesign-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DesignToOrder-id-0002" sourceRef="UserTask-DevelopBasicDesign-id-0001" targetRef="ServiceTask-OrderLegoBrickSets-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-OrderToGiveSets-id-0003" sourceRef="ServiceTask-OrderLegoBrickSets-id-0001" targetRef="UserTask-GiveLegoSetsToChildren-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GiveSetsToSort-id-0004" sourceRef="UserTask-GiveLegoSetsToChildren-id-0001" targetRef="UserTask-ChildrenSortParts-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SortToSplit-id-0005" sourceRef="UserTask-ChildrenSortParts-id-0001" targetRef="ParallelGateway-SplitSubcomponents-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToSub1-id-0006" sourceRef="ParallelGateway-SplitSubcomponents-id-0001" targetRef="SubProcess-BuildTestSubcomponent1-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToSub2-id-0007" sourceRef="ParallelGateway-SplitSubcomponents-id-0001" targetRef="SubProcess-BuildTestSubcomponent2-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-Sub1ToJoin-id-0008" sourceRef="SubProcess-BuildTestSubcomponent1-id-0001" targetRef="ParallelGateway-JoinSubcomponents-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-Sub2ToJoin-id-0009" sourceRef="SubProcess-BuildTestSubcomponent2-id-0002" targetRef="ParallelGateway-JoinSubcomponents-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToReorder-id-0010" sourceRef="ParallelGateway-JoinSubcomponents-id-0001" targetRef="ServiceTask-ReorderIndividualParts-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReorderToAssemble-id-0011" sourceRef="ServiceTask-ReorderIndividualParts-id-0001" targetRef="UserTask-AssembleMachine-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AssembleToEnd-id-0012" sourceRef="UserTask-AssembleMachine-id-0001" targetRef="EndEvent-MachineAssemblyComplete-id-0001" />
  </bpmn:process>
