        <di:waypoint x="2250" y="70" />
        <di:waypoint x="2275" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-InsuranceToPrepareSmall-id-0020_di" bpmnElement="SequenceFlow-InsuranceToPrepareSmall-id-0020">
        <di:waypoint x="2225" y="210" />
        <di:waypoint x="2325" y="210" />
        <di:waypoint x="2325" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
