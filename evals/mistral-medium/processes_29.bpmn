<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AustriaRelocationProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler (https://bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="Process_AustriaRelocation-id-0001" isExecutable="true">
    <bpmn:startEvent id="MessageStartEvent-VisaApplicationTrigger-id-0001" name="Visa Application Trigger">
      <bpmn:outgoing>SequenceFlow-TriggerToGather-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-GatherVisaDocuments-id-0001" name="Gather Visa Documents">
      <bpmn:incoming>SequenceFlow-TriggerToGather-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatherToSubmit-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-SubmitVisaApplication-id-0001" name="Submit Visa Application">
      <bpmn:incoming>SequenceFlow-GatherToSubmit-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubmitToReceive-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveVisaDecision-id-0001" name="Receive: Visa Decision">
      <bpmn:incoming>SequenceFlow-SubmitToReceive-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToGateway-id-0005</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer15DayVisaDecision-id-0001" name="15 Day SLA Timeout" attachedToRef="ReceiveTask-ReceiveVisaDecision-id-0001">
      <bpmn:outgoing>SequenceFlow-BoundaryToEscalation-id-0004</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer15DayVisaDecision-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-SendEscalationToConsulate-id-0001" name="Send: Escalation to Consulate">
      <bpmn:incoming>SequenceFlow-BoundaryToEscalation-id-0004</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-VisaDecision-id-0001" name="Visa Decision?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReceiveToGateway-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToParallel-id-0006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToRejected-id-0007</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-NegotiateAccommodation-id-0001" name="Negotiate Accommodation">
      <bpmn:incoming>SequenceFlow-SplitToAccommodation-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AccommodationToJoin-id-0012</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-OpenBankAccount-id-0001" name="Open Bank Account">
      <bpmn:incoming>SequenceFlow-SplitToBank-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BankToJoin-id-0013</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent-ErrorBankAccount-id-0001" name="Bank Document Rejection" attachedToRef="ServiceTask-OpenBankAccount-id-0001">
      <bpmn:outgoing>SequenceFlow-BankBoundaryToResolve-id-0010</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BoundaryEvent-ErrorBankAccount-id-0001_EventDef" errorRef="BANK_DOCUMENT_ERROR" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask-ResolveBankDocumentIssues-id-0001" name="Resolve Bank Document Issues">
      <bpmn:incoming>SequenceFlow-BankBoundaryToResolve-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ResolveToJoin-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-SplitAccommodationBank-id-0001" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-GatewayToParallel-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToAccommodation-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToBank-id-0009</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="ParallelGateway-JoinAccommodationBank-id-0001" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-ResolveToJoin-id-0011</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AccommodationToJoin-id-0012</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-BankToJoin-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToComplete-id-0014</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent-RelocationComplete-id-0001" name="Relocation Complete">
      <bpmn:incoming>SequenceFlow-JoinToComplete-id-0014</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-VisaRejected-id-0002" name="Visa Rejected">
      <bpmn:incoming>SequenceFlow-GatewayToRejected-id-0007</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess-VisaRenewal-id-0001" name="Visa Renewal">
      <bpmn:startEvent id="TimerStartEvent-VisaRenewalReminder-id-0001" name="Visa Renewal Reminder">
        <bpmn:outgoing>SequenceFlow-ReminderToSubmit-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-SubmitRenewalApplication-id-0001" name="Submit Renewal Application">
        <bpmn:incoming>SequenceFlow-ReminderToSubmit-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SubmitToReceive-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:receiveTask id="ReceiveTask-ReceiveRenewalDecision-id-0001" name="Receive: Renewal Decision">
        <bpmn:incoming>SequenceFlow-SubmitToReceive-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReceiveToEnd-id-0003</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:endEvent id="EndEvent-RenewalComplete-id-0001" name="Renewal Complete">
        <bpmn:incoming>SequenceFlow-ReceiveToEnd-id-0003</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-ReminderToSubmit-id-0001" sourceRef="TimerStartEvent-VisaRenewalReminder-id-0001" targetRef="UserTask-SubmitRenewalApplication-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SubmitToReceive-id-0002" sourceRef="UserTask-SubmitRenewalApplication-id-0001" targetRef="ReceiveTask-ReceiveRenewalDecision-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReceiveToEnd-id-0003" sourceRef="ReceiveTask-ReceiveRenewalDecision-id-0001" targetRef="EndEvent-RenewalComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="SequenceFlow-TriggerToGather-id-0001" sourceRef="MessageStartEvent-VisaApplicationTrigger-id-0001" targetRef="UserTask-GatherVisaDocuments-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatherToSubmit-id-0002" sourceRef="UserTask-GatherVisaDocuments-id-0001" targetRef="ServiceTask-SubmitVisaApplication-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubmitToReceive-id-0003" sourceRef="ServiceTask-SubmitVisaApplication-id-0001" targetRef="ReceiveTask-ReceiveVisaDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToEscalation-id-0004" sourceRef="BoundaryEvent-Timer15DayVisaDecision-id-0001" targetRef="SendTask-SendEscalationToConsulate-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveToGateway-id-0005" sourceRef="ReceiveTask-ReceiveVisaDecision-id-0001" targetRef="ExclusiveGateway-VisaDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToParallel-id-0006" name="visa_approved" sourceRef="ExclusiveGateway-VisaDecision-id-0001" targetRef="ParallelGateway-SplitAccommodationBank-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToRejected-id-0007" sourceRef="ExclusiveGateway-VisaDecision-id-0001" targetRef="EndEvent-VisaRejected-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToAccommodation-id-0008" sourceRef="ParallelGateway-SplitAccommodationBank-id-0001" targetRef="UserTask-NegotiateAccommodation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToBank-id-0009" sourceRef="ParallelGateway-SplitAccommodationBank-id-0001" targetRef="ServiceTask-OpenBankAccount-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BankBoundaryToResolve-id-0010" sourceRef="BoundaryEvent-ErrorBankAccount-id-0001" targetRef="UserTask-ResolveBankDocumentIssues-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ResolveToJoin-id-0011" sourceRef="UserTask-ResolveBankDocumentIssues-id-0001" targetRef="ParallelGateway-JoinAccommodationBank-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AccommodationToJoin-id-0012" sourceRef="UserTask-NegotiateAccommodation-id-0001" targetRef="ParallelGateway-JoinAccommodationBank-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BankToJoin-id-0013" sourceRef="ServiceTask-OpenBankAccount-id-0001" targetRef="ParallelGateway-JoinAccommodationBank-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToComplete-id-0014" sourceRef="ParallelGateway-JoinAccommodationBank-id-0001" targetRef="EndEvent-RelocationComplete-id-0001" />
  </bpmn:process>
  <bpmn:error id="BANK_DOCUMENT_ERROR" name="BANK_DOCUMENT_ERROR" />
