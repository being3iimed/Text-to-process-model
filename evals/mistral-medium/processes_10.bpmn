  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-DeploySolution-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-DeploySolution-id-0001" bpmnElement="SubProcess-DeploySolution-id-0001">
      <bpmndi:BPMNShape id="StartEvent-DeploymentInitiated-id-0001_di" bpmnElement="StartEvent-DeploymentInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ProcureTools-id-0001_di" bpmnElement="ServiceTask-ProcureTools-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-InstallSolution-id-0001_di" bpmnElement="ServiceTask-InstallSolution-id-0001">
