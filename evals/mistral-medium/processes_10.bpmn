      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ApprovalToDeploy-id-0005_di" bpmnElement="SequenceFlow-ApprovalToDeploy-id-0005">
        <di:waypoint x="375" y="95" />
