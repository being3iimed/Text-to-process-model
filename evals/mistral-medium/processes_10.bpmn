<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="IT-Solution-Request-Process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="IT-Solution-Request-Process-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-RequestSubmitted-id-0001" name="IT Solution Request Submitted">
      <bpmn:outgoing>SequenceFlow-StartToAssess-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-AssessRequest-id-0001" name="IT Assesses Request">
      <bpmn:incoming>SequenceFlow-StartToAssess-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssessToApproval-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ApprovalDecision-id-0001" name="Approval Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AssessToApproval-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalToReject-id-0003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ApprovalToDeploy-id-0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-RejectionNotice-id-0001" name="Send: Rejection Notice to Requester">
      <bpmn:incoming>SequenceFlow-ApprovalToReject-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RejectToEnd-id-0004</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-RequestRejected-id-0001" name="Request Rejected">
      <bpmn:incoming>SequenceFlow-RejectToEnd-id-0004</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess-DeploySolution-id-0001" name="Deploy Solution">
      <bpmn:incoming>SequenceFlow-ApprovalToDeploy-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeployToRollOut-id-0006</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-DeploymentInitiated-id-0001" name="Deployment Initiated">
        <bpmn:outgoing>SequenceFlow-StartToProcure-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-ProcureTools-id-0001" name="Procure Tools/Licenses">
        <bpmn:incoming>SequenceFlow-StartToProcure-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ProcureToInstall-id-0002</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-InstallSolution-id-0001" name="Install Solution">
        <bpmn:incoming>SequenceFlow-ProcureToInstall-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-InstallToTest-id-0003</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask-TestSolution-id-0001" name="Test in Controlled Environment">
        <bpmn:incoming>SequenceFlow-InstallToTest-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TestToGateway-id-0004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-TestResult-id-0001" name="Test Result" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-TestToGateway-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GatewayToSuccess-id-0005</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-GatewayToTroubleshoot-id-0006</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UserTask-Troubleshoot-id-0001" name="Troubleshoot Installation Issues">
        <bpmn:incoming>SequenceFlow-GatewayToTroubleshoot-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TroubleshootToFail-id-0007</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EndEvent-DeploymentFailed-id-0001" name="Deployment Failed">
        <bpmn:incoming>SequenceFlow-TroubleshootToFail-id-0007</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="EndEvent-DeploymentComplete-id-0001" name="Deployment Complete">
        <bpmn:incoming>SequenceFlow-GatewayToSuccess-id-0005</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StartToProcure-id-0001" sourceRef="StartEvent-DeploymentInitiated-id-0001" targetRef="ServiceTask-ProcureTools-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ProcureToInstall-id-0002" sourceRef="ServiceTask-ProcureTools-id-0001" targetRef="ServiceTask-InstallSolution-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-InstallToTest-id-0003" sourceRef="ServiceTask-InstallSolution-id-0001" targetRef="ServiceTask-TestSolution-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TestToGateway-id-0004" sourceRef="ServiceTask-TestSolution-id-0001" targetRef="ExclusiveGateway-TestResult-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToSuccess-id-0005" name="test_successful" sourceRef="ExclusiveGateway-TestResult-id-0001" targetRef="EndEvent-DeploymentComplete-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GatewayToTroubleshoot-id-0006" sourceRef="ExclusiveGateway-TestResult-id-0001" targetRef="UserTask-Troubleshoot-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TroubleshootToFail-id-0007" sourceRef="UserTask-Troubleshoot-id-0001" targetRef="EndEvent-DeploymentFailed-id-0001" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="ServiceTask-RollOut-id-0001" name="Roll Out to Department">
      <bpmn:incoming>SequenceFlow-DeployToRollOut-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RollOutToTraining-id-0007</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-TrainingDecision-id-0001" name="Training Required?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-RollOutToTraining-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainingToSupport-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-NoTrainingToMerge-id-0010</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ProvideTraining-id-0001" name="Provide Training">
      <bpmn:incoming>SequenceFlow-TrainingToSupport-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TrainingToMerge-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ITSupport-id-0001" name="IT Support Available">
      <bpmn:incoming>SequenceFlow-MergeToSupport-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SupportToEnd-id-0012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-RequestFulfilled-id-0001" name="Request Fulfilled">
      <bpmn:incoming>SequenceFlow-SupportToEnd-id-0012</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway-MergePaths-id-0001" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-TrainingToMerge-id-0009</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NoTrainingToMerge-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MergeToSupport-id-0011</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow-StartToAssess-id-0001" sourceRef="StartEvent-RequestSubmitted-id-0001" targetRef="UserTask-AssessRequest-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AssessToApproval-id-0002" sourceRef="UserTask-AssessRequest-id-0001" targetRef="ExclusiveGateway-ApprovalDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalToReject-id-0003" name="rejected" sourceRef="ExclusiveGateway-ApprovalDecision-id-0001" targetRef="SendTask-RejectionNotice-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RejectToEnd-id-0004" sourceRef="SendTask-RejectionNotice-id-0001" targetRef="EndEvent-RequestRejected-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalToDeploy-id-0005" name="approved" sourceRef="ExclusiveGateway-ApprovalDecision-id-0001" targetRef="SubProcess-DeploySolution-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DeployToRollOut-id-0006" sourceRef="SubProcess-DeploySolution-id-0001" targetRef="ServiceTask-RollOut-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RollOutToTraining-id-0007" sourceRef="ServiceTask-RollOut-id-0001" targetRef="ExclusiveGateway-TrainingDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TrainingToSupport-id-0008" name="training_required" sourceRef="ExclusiveGateway-TrainingDecision-id-0001" targetRef="UserTask-ProvideTraining-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TrainingToMerge-id-0009" sourceRef="UserTask-ProvideTraining-id-0001" targetRef="ExclusiveGateway-MergePaths-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NoTrainingToMerge-id-0010" sourceRef="ExclusiveGateway-TrainingDecision-id-0001" targetRef="ExclusiveGateway-MergePaths-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MergeToSupport-id-0011" sourceRef="ExclusiveGateway-MergePaths-id-0001" targetRef="ServiceTask-ITSupport-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SupportToEnd-id-0012" sourceRef="ServiceTask-ITSupport-id-0001" targetRef="EndEvent-RequestFulfilled-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_IT-Solution-Request-Process-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_IT-Solution-Request-Process-id-0001" bpmnElement="IT-Solution-Request-Process-id-0001">
      <bpmndi:BPMNShape id="StartEvent-RequestSubmitted-id-0001_di" bpmnElement="StartEvent-RequestSubmitted-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AssessRequest-id-0001_di" bpmnElement="UserTask-AssessRequest-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
