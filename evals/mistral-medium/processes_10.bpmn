      <bpmndi:BPMNShape id="EndEvent-RequestFulfilled-id-0001_di" bpmnElement="EndEvent-RequestFulfilled-id-0001">
        <dc:Bounds x="1407" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToAssess-id-0001_di" bpmnElement="SequenceFlow-StartToAssess-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AssessToApproval-id-0002_di" bpmnElement="SequenceFlow-AssessToApproval-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
