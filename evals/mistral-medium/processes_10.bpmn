      <bpmndi:BPMNShape id="ServiceTask-TestSolution-id-0001_di" bpmnElement="ServiceTask-TestSolution-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-TestResult-id-0001_di" bpmnElement="ExclusiveGateway-TestResult-id-0001" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-DeploymentComplete-id-0001_di" bpmnElement="EndEvent-DeploymentComplete-id-0001">
