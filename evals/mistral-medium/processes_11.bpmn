  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-BillingCycle-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-BillingCycle-id-0001" bpmnElement="SubProcess-BillingCycle-id-0001">
      <bpmndi:BPMNShape id="StartEvent-BillingCycleStart-id-0001_di" bpmnElement="StartEvent-BillingCycleStart-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ChargePayment-id-0001_di" bpmnElement="ServiceTask-ChargePayment-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
