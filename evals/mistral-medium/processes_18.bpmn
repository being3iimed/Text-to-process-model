<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UniversityEnrollment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process_UniversityEnrollment" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ApplicationSubmitted-id-0001" name="Application Submitted">
      <bpmn:outgoing>SequenceFlow-StartToReview-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ReviewApplication-id-0002" name="Admissions Office Reviews Application and Documents">
      <bpmn:incoming>SequenceFlow-StartToReview-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToDocumentsCheck-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DocumentsComplete-id-0003" name="Documents Complete?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToDocumentsCheck-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DocumentsMissing-id-0003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DocumentsComplete-id-0004</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-NotifyMissingDocuments-id-0004" name="Send: Notification to Applicant (Missing Documents)">
      <bpmn:incoming>SequenceFlow-DocumentsMissing-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NotifyToReceiveMissing-id-0005</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveMissingDocuments-id-0005" name="Receive: Missing Documents from Applicant">
      <bpmn:incoming>SequenceFlow-NotifyToReceiveMissing-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveMissingToMerge-id-0006</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="ParallelGateway-SplitEvaluation-id-0006" name="Parallel Evaluation" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-DocumentsComplete-id-0004</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReceiveMissingToMerge-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToEvaluate-id-0007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToProcessFees-id-0008</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-EvaluateApplication-id-0007" name="Admissions Committee Evaluates Application">
      <bpmn:incoming>SequenceFlow-SplitToEvaluate-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EvaluateToOutcome-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ProcessFees-id-0008" name="Finance Department Processes Fees/Waivers">
      <bpmn:incoming>SequenceFlow-SplitToProcessFees-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProcessFeesToJoin-id-0014</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ApplicationOutcome-id-0009" name="Application Outcome" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-EvaluateToOutcome-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApplicationApproved-id-0010</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ApplicationRejected-id-0011</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-SendAcceptanceLetter-id-0010" name="Send: Acceptance Letter">
      <bpmn:incoming>SequenceFlow-ApplicationApproved-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendAcceptanceToJoin-id-0013</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask-SendRejectionLetter-id-0011" name="Send: Rejection Letter">
      <bpmn:incoming>SequenceFlow-ApplicationRejected-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendRejectionToEnd-id-0012</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ApplicationRejected-id-0012" name="Application Rejected">
      <bpmn:incoming>SequenceFlow-SendRejectionToEnd-id-0012</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="ParallelGateway-JoinEvaluation-id-0013" name="Join Evaluation" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-SendAcceptanceToJoin-id-0013</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ProcessFeesToJoin-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToConfirmEnrollment-id-0015</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:receiveTask id="ReceiveTask-ConfirmEnrollment-id-0015" name="Receive: Enrollment Confirmation from Student">
      <bpmn:incoming>SequenceFlow-JoinToConfirmEnrollment-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConfirmEnrollmentToCheck-id-0019</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BoundaryEvent-EnrollmentDeadline-id-0016" name="7-Day Enrollment Deadline" attachedToRef="ReceiveTask-ConfirmEnrollment-id-0015">
      <bpmn:outgoing>SequenceFlow-DeadlineToCancel-id-0016</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-EnrollmentDeadline-id-0016_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ServiceTask-CancelApplication-id-0017" name="Cancel Application (Deadline Missed)">
      <bpmn:incoming>SequenceFlow-DeadlineToCancel-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CancelToNotice-id-0017</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask-SendCancellationNotice-id-0018" name="Send: Cancellation Notice">
      <bpmn:incoming>SequenceFlow-CancelToNotice-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NoticeToCanceledEnd-id-0018</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ApplicationCanceled-id-0019" name="Application Canceled (No Confirmation)">
      <bpmn:incoming>SequenceFlow-NoticeToCanceledEnd-id-0018</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-EnrollmentNotConfirmedToEnd-id-0021</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway-EnrollmentConfirmed-id-0020" name="Enrollment Confirmed?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ConfirmEnrollmentToCheck-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnrollmentConfirmedToOrientation-id-0020</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-EnrollmentNotConfirmedToEnd-id-0021</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-SendOrientationMaterials-id-0021" name="Send: Orientation Materials">
      <bpmn:incoming>SequenceFlow-EnrollmentConfirmedToOrientation-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OrientationToITSetup-id-0022</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ServiceTask-SetupITAccounts-id-0022" name="IT Department Sets Up Student Accounts (Email, Portal, Library)">
      <bpmn:incoming>SequenceFlow-OrientationToITSetup-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ITSetupToInternationalCheck-id-0023</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-InternationalStudent-id-0023" name="International Student?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ITSetupToInternationalCheck-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InternationalYesToVisa-id-0024</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-InternationalNoToStudyPlan-id-0025</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess-VisaProcessing-id-0024" name="Visa Processing">
      <bpmn:incoming>SequenceFlow-InternationalYesToVisa-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VisaToStudyPlan-id-0029</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-VisaProcessingInitiated-id-0025" name="Visa Processing Initiated">
        <bpmn:outgoing>SequenceFlow-VisaStartToReview-id-0025</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-ReviewVisaDocuments-id-0026" name="International Student Office Reviews Visa Documents">
        <bpmn:incoming>SequenceFlow-VisaStartToReview-id-0025</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReviewToIssueVisa-id-0026</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="ServiceTask-IssueVisaDocumentation-id-0027" name="Issue Visa Documentation">
        <bpmn:incoming>SequenceFlow-ReviewToIssueVisa-id-0026</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-IssueVisaToNotice-id-0027</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SendTask-SendVisaApprovalNotice-id-0028" name="Send: Visa Approval Notice to Student">
        <bpmn:incoming>SequenceFlow-IssueVisaToNotice-id-0027</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-NoticeToVisaEnd-id-0028</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="EndEvent-VisaProcessingComplete-id-0029" name="Visa Processing Complete">
        <bpmn:incoming>SequenceFlow-NoticeToVisaEnd-id-0028</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-VisaStartToReview-id-0025" sourceRef="StartEvent-VisaProcessingInitiated-id-0025" targetRef="UserTask-ReviewVisaDocuments-id-0026" />
      <bpmn:sequenceFlow id="SequenceFlow-ReviewToIssueVisa-id-0026" sourceRef="UserTask-ReviewVisaDocuments-id-0026" targetRef="ServiceTask-IssueVisaDocumentation-id-0027" />
      <bpmn:sequenceFlow id="SequenceFlow-IssueVisaToNotice-id-0027" sourceRef="ServiceTask-IssueVisaDocumentation-id-0027" targetRef="SendTask-SendVisaApprovalNotice-id-0028" />
      <bpmn:sequenceFlow id="SequenceFlow-NoticeToVisaEnd-id-0028" sourceRef="SendTask-SendVisaApprovalNotice-id-0028" targetRef="EndEvent-VisaProcessingComplete-id-0029" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-CreateStudyPlan-id-0030" name="Create Study Plan">
      <bpmn:incoming>SequenceFlow-InternationalNoToStudyPlan-id-0025</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-VisaToStudyPlan-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StudyPlanToAttendClasses-id-0038</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-StudyPlanCreationStarted-id-0031" name="Study Plan Creation Started">
        <bpmn:outgoing>SequenceFlow-StudyPlanStartToMeetAdvisor-id-0031</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-MeetAdvisor-id-0032" name="Meet with Academic Advisor">
        <bpmn:incoming>SequenceFlow-StudyPlanStartToMeetAdvisor-id-0031</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MeetAdvisorToSelectCourses-id-0032</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="UserTask-SelectCourses-id-0033" name="Select Courses">
        <bpmn:incoming>SequenceFlow-MeetAdvisorToSelectCourses-id-0032</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SelectCoursesToConflictsCheck-id-0033</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-ScheduleConflicts-id-0034" name="Schedule Conflicts?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-SelectCoursesToConflictsCheck-id-0033</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ConflictsExist-id-0034</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-NoConflicts-id-0035</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UserTask-ResolveConflicts-id-0035" name="Resolve Schedule Conflicts with Advisor">
        <bpmn:incoming>SequenceFlow-ConflictsExist-id-0034</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ResolveConflictsToFinalize-id-0036</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="ServiceTask-FinalizeStudyPlan-id-0036" name="Finalize and Submit Study Plan">
        <bpmn:incoming>SequenceFlow-NoConflicts-id-0035</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ResolveConflictsToFinalize-id-0036</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-FinalizeToStudyPlanEnd-id-0037</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-StudyPlanApproved-id-0037" name="Study Plan Approved">
        <bpmn:incoming>SequenceFlow-FinalizeToStudyPlanEnd-id-0037</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-StudyPlanStartToMeetAdvisor-id-0031" sourceRef="StartEvent-StudyPlanCreationStarted-id-0031" targetRef="UserTask-MeetAdvisor-id-0032" />
      <bpmn:sequenceFlow id="SequenceFlow-MeetAdvisorToSelectCourses-id-0032" sourceRef="UserTask-MeetAdvisor-id-0032" targetRef="UserTask-SelectCourses-id-0033" />
      <bpmn:sequenceFlow id="SequenceFlow-SelectCoursesToConflictsCheck-id-0033" sourceRef="UserTask-SelectCourses-id-0033" targetRef="ExclusiveGateway-ScheduleConflicts-id-0034" />
      <bpmn:sequenceFlow id="SequenceFlow-ConflictsExist-id-0034" name="schedule_conflicts_exist" sourceRef="ExclusiveGateway-ScheduleConflicts-id-0034" targetRef="UserTask-ResolveConflicts-id-0035" />
      <bpmn:sequenceFlow id="SequenceFlow-NoConflicts-id-0035" name="no_conflicts" sourceRef="ExclusiveGateway-ScheduleConflicts-id-0034" targetRef="ServiceTask-FinalizeStudyPlan-id-0036" />
      <bpmn:sequenceFlow id="SequenceFlow-ResolveConflictsToFinalize-id-0036" sourceRef="UserTask-ResolveConflicts-id-0035" targetRef="ServiceTask-FinalizeStudyPlan-id-0036" />
      <bpmn:sequenceFlow id="SequenceFlow-FinalizeToStudyPlanEnd-id-0037" sourceRef="ServiceTask-FinalizeStudyPlan-id-0036" targetRef="EndEvent-StudyPlanApproved-id-0037" />
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask-AttendClasses-id-0038" name="Student Attends Classes">
      <bpmn:incoming>SequenceFlow-StudyPlanToAttendClasses-id-0038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AttendClassesToAddDrop-id-0039</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AttendClassesLoopBack-id-0046</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AddDropCourses-id-0039" name="Add/Drop Courses (Within Add/Drop Period)">
      <bpmn:incoming>SequenceFlow-AttendClassesToAddDrop-id-0039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AddDropToPostGrades-id-0040</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-PostGrades-id-0040" name="Post Grades at Semester End">
      <bpmn:incoming>SequenceFlow-AddDropToPostGrades-id-0040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PostGradesToAppealCheck-id-0041</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SemesterLoopToStatusCheck-id-0045</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-StudentAppeals-id-0041" name="Student Files Appeal?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-PostGradesToAppealCheck-id-0041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AppealYesToAppealsProcess-id-0042</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AppealNoToSemesterLoop-id-0043</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess-AppealsProcess-id-0042" name="Appeals Process">
      <bpmn:incoming>SequenceFlow-AppealYesToAppealsProcess-id-0042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AppealsProcessToSemesterLoop-id-0044</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-AppealSubmitted-id-0043" name="Appeal Submitted">
        <bpmn:outgoing>SequenceFlow-AppealStartToSubmitForm-id-0043</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-SubmitAppealForm-id-0044" name="Student Submits Appeal Form">
        <bpmn:incoming>SequenceFlow-AppealStartToSubmitForm-id-0043</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SubmitFormToReview-id-0044</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="UserTask-ReviewAppeal-id-0045" name="Appeals Committee Reviews Case">
        <bpmn:incoming>SequenceFlow-SubmitFormToReview-id-0044</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReviewToMeetCommittee-id-0045</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="UserTask-MeetAppealsCommittee-id-0046" name="Appeals Committee Meets with Student">
        <bpmn:incoming>SequenceFlow-ReviewToMeetCommittee-id-0045</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-MeetCommitteeToDecision-id-0046</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-AppealDecision-id-0047" name="Appeal Decision" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-MeetCommitteeToDecision-id-0046</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AppealApproved-id-0047</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-AppealRejected-id-0048</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ServiceTask-UpdateRecord-id-0048" name="Update Student Record (Appeal Approved)">
        <bpmn:incoming>SequenceFlow-AppealApproved-id-0047</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-UpdateRecordToAppealEnd-id-0049</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SendTask-SendAppealRejection-id-0049" name="Send: Appeal Rejection Notice">
        <bpmn:incoming>SequenceFlow-AppealRejected-id-0048</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SendRejectionToAppealEnd-id-0050</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="EndEvent-AppealProcessComplete-id-0050" name="Appeal Process Complete">
        <bpmn:incoming>SequenceFlow-UpdateRecordToAppealEnd-id-0049</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SendRejectionToAppealEnd-id-0050</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-AppealStartToSubmitForm-id-0043" sourceRef="StartEvent-AppealSubmitted-id-0043" targetRef="UserTask-SubmitAppealForm-id-0044" />
      <bpmn:sequenceFlow id="SequenceFlow-SubmitFormToReview-id-0044" sourceRef="UserTask-SubmitAppealForm-id-0044" targetRef="UserTask-ReviewAppeal-id-0045" />
      <bpmn:sequenceFlow id="SequenceFlow-ReviewToMeetCommittee-id-0045" sourceRef="UserTask-ReviewAppeal-id-0045" targetRef="UserTask-MeetAppealsCommittee-id-0046" />
      <bpmn:sequenceFlow id="SequenceFlow-MeetCommitteeToDecision-id-0046" sourceRef="UserTask-MeetAppealsCommittee-id-0046" targetRef="ExclusiveGateway-AppealDecision-id-0047" />
      <bpmn:sequenceFlow id="SequenceFlow-AppealApproved-id-0047" name="appeal_approved" sourceRef="ExclusiveGateway-AppealDecision-id-0047" targetRef="ServiceTask-UpdateRecord-id-0048" />
      <bpmn:sequenceFlow id="SequenceFlow-AppealRejected-id-0048" name="appeal_rejected" sourceRef="ExclusiveGateway-AppealDecision-id-0047" targetRef="SendTask-SendAppealRejection-id-0049" />
      <bpmn:sequenceFlow id="SequenceFlow-UpdateRecordToAppealEnd-id-0049" sourceRef="ServiceTask-UpdateRecord-id-0048" targetRef="EndEvent-AppealProcessComplete-id-0050" />
      <bpmn:sequenceFlow id="SequenceFlow-SendRejectionToAppealEnd-id-0050" sourceRef="SendTask-SendAppealRejection-id-0049" targetRef="EndEvent-AppealProcessComplete-id-0050" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="ExclusiveGateway-StudentStatus-id-0051" name="Student Status" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-AppealNoToSemesterLoop-id-0043</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AppealsProcessToSemesterLoop-id-0044</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SemesterLoopToStatusCheck-id-0045</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AttendClassesLoopBack-id-0046</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-StudentGraduated-id-0051</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-StudentWithdrew-id-0052</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-StudentGraduated-id-0052" name="Student Graduated">
      <bpmn:incoming>SequenceFlow-StudentGraduated-id-0051</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-StudentWithdrew-id-0053" name="Student Withdrew">
      <bpmn:incoming>SequenceFlow-StudentWithdrew-id-0052</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToReview-id-0001" sourceRef="StartEvent-ApplicationSubmitted-id-0001" targetRef="UserTask-ReviewApplication-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToDocumentsCheck-id-0002" sourceRef="UserTask-ReviewApplication-id-0002" targetRef="ExclusiveGateway-DocumentsComplete-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-DocumentsMissing-id-0003" name="documents_missing" sourceRef="ExclusiveGateway-DocumentsComplete-id-0003" targetRef="SendTask-NotifyMissingDocuments-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-DocumentsComplete-id-0004" name="documents_complete" sourceRef="ExclusiveGateway-DocumentsComplete-id-0003" targetRef="ParallelGateway-SplitEvaluation-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-NotifyToReceiveMissing-id-0005" sourceRef="SendTask-NotifyMissingDocuments-id-0004" targetRef="ReceiveTask-ReceiveMissingDocuments-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveMissingToMerge-id-0006" sourceRef="ReceiveTask-ReceiveMissingDocuments-id-0005" targetRef="ParallelGateway-SplitEvaluation-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToEvaluate-id-0007" sourceRef="ParallelGateway-SplitEvaluation-id-0006" targetRef="UserTask-EvaluateApplication-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToProcessFees-id-0008" sourceRef="ParallelGateway-SplitEvaluation-id-0006" targetRef="ServiceTask-ProcessFees-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-EvaluateToOutcome-id-0009" sourceRef="UserTask-EvaluateApplication-id-0007" targetRef="ExclusiveGateway-ApplicationOutcome-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-ApplicationApproved-id-0010" name="application_approved" sourceRef="ExclusiveGateway-ApplicationOutcome-id-0009" targetRef="SendTask-SendAcceptanceLetter-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-ApplicationRejected-id-0011" name="application_rejected" sourceRef="ExclusiveGateway-ApplicationOutcome-id-0009" targetRef="SendTask-SendRejectionLetter-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-SendRejectionToEnd-id-0012" sourceRef="SendTask-SendRejectionLetter-id-0011" targetRef="EndEvent-ApplicationRejected-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-SendAcceptanceToJoin-id-0013" sourceRef="SendTask-SendAcceptanceLetter-id-0010" targetRef="ParallelGateway-JoinEvaluation-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-ProcessFeesToJoin-id-0014" sourceRef="ServiceTask-ProcessFees-id-0008" targetRef="ParallelGateway-JoinEvaluation-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToConfirmEnrollment-id-0015" sourceRef="ParallelGateway-JoinEvaluation-id-0013" targetRef="ReceiveTask-ConfirmEnrollment-id-0015" />
