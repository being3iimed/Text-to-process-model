      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveToGateway-id-0003_di" bpmnElement="SequenceFlow-ReceiveToGateway-id-0003">
        <di:waypoint x="425" y="70" />
