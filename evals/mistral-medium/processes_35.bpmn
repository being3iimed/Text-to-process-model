      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToProduce-id-0004_di" bpmnElement="SequenceFlow-GatewayToProduce-id-0004">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToCancel-id-0005_di" bpmnElement="SequenceFlow-GatewayToCancel-id-0005">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="657" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ProduceToEnd-id-0006_di" bpmnElement="SequenceFlow-ProduceToEnd-id-0006">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="807" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-ParallelPartsOrdering-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-ParallelPartsOrdering-id-0001" bpmnElement="SubProcess-ParallelPartsOrdering-id-0001">
      <bpmndi:BPMNShape id="StartEvent-OrderingInitiated-id-0001_di" bpmnElement="StartEvent-OrderingInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Split-id-0001_di" bpmnElement="ParallelGateway-Split-id-0001">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-OrderSupplierA-id-0001_di" bpmnElement="ServiceTask-OrderSupplierA-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-Join-id-0002_di" bpmnElement="ParallelGateway-Join-id-0002">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PartsOrdered-id-0001_di" bpmnElement="EndEvent-PartsOrdered-id-0001">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-OrderSupplierB-id-0002_di" bpmnElement="ServiceTask-OrderSupplierB-id-0002">
        <dc:Bounds x="325" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-OrderSupplierC-id-0003_di" bpmnElement="ServiceTask-OrderSupplierC-id-0003">
        <dc:Bounds x="325" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToSplit-id-0001_di" bpmnElement="SequenceFlow-StartToSplit-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="200" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToSupplierA-id-0002_di" bpmnElement="SequenceFlow-SplitToSupplierA-id-0002">
        <di:waypoint x="250" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToSupplierB-id-0003_di" bpmnElement="SequenceFlow-SplitToSupplierB-id-0003">
        <di:waypoint x="225" y="95" />
        <di:waypoint x="225" y="210" />
        <di:waypoint x="325" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SplitToSupplierC-id-0004_di" bpmnElement="SequenceFlow-SplitToSupplierC-id-0004">
        <di:waypoint x="225" y="95" />
        <di:waypoint x="225" y="350" />
        <di:waypoint x="325" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SupplierAToJoin-id-0005_di" bpmnElement="SequenceFlow-SupplierAToJoin-id-0005">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-JoinToEnd-id-0008_di" bpmnElement="SequenceFlow-JoinToEnd-id-0008">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SupplierBToJoin-id-0006_di" bpmnElement="SequenceFlow-SupplierBToJoin-id-0006">
        <di:waypoint x="425" y="210" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="525" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SupplierCToJoin-id-0007_di" bpmnElement="SequenceFlow-SupplierCToJoin-id-0007">
        <di:waypoint x="425" y="350" />
        <di:waypoint x="525" y="350" />
        <di:waypoint x="525" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
