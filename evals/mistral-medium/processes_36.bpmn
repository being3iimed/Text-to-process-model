<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="LuxuryPlaneCustomization-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="LuxuryPlaneCustomizationProcess" name="Luxury Airplane Customization &#38; Manufacturing Workflow" isExecutable="true">
    <bpmn:startEvent id="StartEvent-LuxuryPlaneCustomizationInitiated-id-0001" name="Luxury Plane Customization Initiated">
      <bpmn:outgoing>SequenceFlow-StartToCustomerInput-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ReceiveCustomerSpecifications-id-0001" name="Receive Customer Specifications">
      <bpmn:incoming>SequenceFlow-StartToCustomerInput-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerInputToGenerateOrders-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-GenerateManufacturingOrders-id-0001" name="Generate Manufacturing Orders">
      <bpmn:incoming>SequenceFlow-CustomerInputToGenerateOrders-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateOrdersToManufacturingSplit-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-ManufacturingSplit-id-0001" name="Parallel Manufacturing Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-GenerateOrdersToManufacturingSplit-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ManufacturingSplitToBars-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ManufacturingSplitToSeats-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ManufacturingSplitToToilets-id-0006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ManufacturingSplitToLighting-id-0007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-ManufacturingSplitToElectronics-id-0008</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="SubProcess-ManufactureCustomBars-id-0001" name="Manufacture Custom Bars">
      <bpmn:incoming>SequenceFlow-ManufacturingSplitToBars-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BarsReadyToJoin-id-0012</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-BarManufacturingStart-id-0001" name="Bar Manufacturing Start">
        <bpmn:outgoing>SequenceFlow-BarStartToSplit-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway-BarTypeSplit-id-0001" name="Bar Type Split" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-BarStartToSplit-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SplitToVodkaOrder-id-0002</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToWhiskeyOrder-id-0004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToChampagneOrder-id-0006</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToTequilaOrder-id-0008</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-SplitToSakeOrder-id-0010</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sendTask id="SendTask-SendVodkaBarOrderToRussia-id-0001" name="Send: Vodka Bar Order to Russia">
        <bpmn:incoming>SequenceFlow-SplitToVodkaOrder-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-VodkaOrderToReceive-id-0003</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask-ReceiveVodkaBarFromRussia-id-0001" name="Receive: Vodka Bar from Russia">
        <bpmn:incoming>SequenceFlow-VodkaOrderToReceive-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-VodkaReceiveToJoin-id-0012</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:sendTask id="SendTask-SendWhiskeyBarOrderToIreland-id-0002" name="Send: Whiskey Bar Order to Ireland">
        <bpmn:incoming>SequenceFlow-SplitToWhiskeyOrder-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-WhiskeyOrderToReceive-id-0005</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask-ReceiveWhiskeyBarFromIreland-id-0002" name="Receive: Whiskey Bar from Ireland">
        <bpmn:incoming>SequenceFlow-WhiskeyOrderToReceive-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-WhiskeyReceiveToJoin-id-0013</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:sendTask id="SendTask-SendChampagneBarOrderToFrance-id-0003" name="Send: Champagne Bar Order to France">
        <bpmn:incoming>SequenceFlow-SplitToChampagneOrder-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ChampagneOrderToReceive-id-0007</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask-ReceiveChampagneBarFromFrance-id-0003" name="Receive: Champagne Bar from France">
        <bpmn:incoming>SequenceFlow-ChampagneOrderToReceive-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ChampagneReceiveToJoin-id-0014</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:sendTask id="SendTask-SendTequilaBarOrderToMexico-id-0004" name="Send: Tequila Bar Order to Mexico">
        <bpmn:incoming>SequenceFlow-SplitToTequilaOrder-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TequilaOrderToReceive-id-0009</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask-ReceiveTequilaBarFromMexico-id-0004" name="Receive: Tequila Bar from Mexico">
        <bpmn:incoming>SequenceFlow-TequilaOrderToReceive-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TequilaReceiveToJoin-id-0015</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:sendTask id="SendTask-SendSakeBarOrderToJapan-id-0005" name="Send: Sake Bar Order to Japan">
        <bpmn:incoming>SequenceFlow-SplitToSakeOrder-id-0010</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SakeOrderToReceive-id-0011</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask-ReceiveSakeBarFromJapan-id-0005" name="Receive: Sake Bar from Japan">
        <bpmn:incoming>SequenceFlow-SakeOrderToReceive-id-0011</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SakeReceiveToJoin-id-0016</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:parallelGateway id="ParallelGateway-BarTypeJoin-id-0002" name="Bar Type Join" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-VodkaReceiveToJoin-id-0012</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-WhiskeyReceiveToJoin-id-0013</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-ChampagneReceiveToJoin-id-0014</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-TequilaReceiveToJoin-id-0015</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-SakeReceiveToJoin-id-0016</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-JoinToQualityCheck-id-0017</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="ServiceTask-QualityCheckBars-id-0001" name="Quality Check Bars">
        <bpmn:incoming>SequenceFlow-JoinToQualityCheck-id-0017</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-QualityCheckToEnd-id-0018</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-BarsReady-id-0001" name="Bars Ready">
        <bpmn:incoming>SequenceFlow-QualityCheckToEnd-id-0018</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-BarStartToSplit-id-0001" sourceRef="StartEvent-BarManufacturingStart-id-0001" targetRef="ParallelGateway-BarTypeSplit-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToVodkaOrder-id-0002" sourceRef="ParallelGateway-BarTypeSplit-id-0001" targetRef="SendTask-SendVodkaBarOrderToRussia-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-VodkaOrderToReceive-id-0003" sourceRef="SendTask-SendVodkaBarOrderToRussia-id-0001" targetRef="ReceiveTask-ReceiveVodkaBarFromRussia-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToWhiskeyOrder-id-0004" sourceRef="ParallelGateway-BarTypeSplit-id-0001" targetRef="SendTask-SendWhiskeyBarOrderToIreland-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-WhiskeyOrderToReceive-id-0005" sourceRef="SendTask-SendWhiskeyBarOrderToIreland-id-0002" targetRef="ReceiveTask-ReceiveWhiskeyBarFromIreland-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToChampagneOrder-id-0006" sourceRef="ParallelGateway-BarTypeSplit-id-0001" targetRef="SendTask-SendChampagneBarOrderToFrance-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-ChampagneOrderToReceive-id-0007" sourceRef="SendTask-SendChampagneBarOrderToFrance-id-0003" targetRef="ReceiveTask-ReceiveChampagneBarFromFrance-id-0003" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToTequilaOrder-id-0008" sourceRef="ParallelGateway-BarTypeSplit-id-0001" targetRef="SendTask-SendTequilaBarOrderToMexico-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-TequilaOrderToReceive-id-0009" sourceRef="SendTask-SendTequilaBarOrderToMexico-id-0004" targetRef="ReceiveTask-ReceiveTequilaBarFromMexico-id-0004" />
      <bpmn:sequenceFlow id="SequenceFlow-SplitToSakeOrder-id-0010" sourceRef="ParallelGateway-BarTypeSplit-id-0001" targetRef="SendTask-SendSakeBarOrderToJapan-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-SakeOrderToReceive-id-0011" sourceRef="SendTask-SendSakeBarOrderToJapan-id-0005" targetRef="ReceiveTask-ReceiveSakeBarFromJapan-id-0005" />
      <bpmn:sequenceFlow id="SequenceFlow-VodkaReceiveToJoin-id-0012" sourceRef="ReceiveTask-ReceiveVodkaBarFromRussia-id-0001" targetRef="ParallelGateway-BarTypeJoin-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-WhiskeyReceiveToJoin-id-0013" sourceRef="ReceiveTask-ReceiveWhiskeyBarFromIreland-id-0002" targetRef="ParallelGateway-BarTypeJoin-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-ChampagneReceiveToJoin-id-0014" sourceRef="ReceiveTask-ReceiveChampagneBarFromFrance-id-0003" targetRef="ParallelGateway-BarTypeJoin-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-TequilaReceiveToJoin-id-0015" sourceRef="ReceiveTask-ReceiveTequilaBarFromMexico-id-0004" targetRef="ParallelGateway-BarTypeJoin-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-SakeReceiveToJoin-id-0016" sourceRef="ReceiveTask-ReceiveSakeBarFromJapan-id-0005" targetRef="ParallelGateway-BarTypeJoin-id-0002" />
      <bpmn:sequenceFlow id="SequenceFlow-JoinToQualityCheck-id-0017" sourceRef="ParallelGateway-BarTypeJoin-id-0002" targetRef="ServiceTask-QualityCheckBars-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-QualityCheckToEnd-id-0018" sourceRef="ServiceTask-QualityCheckBars-id-0001" targetRef="EndEvent-BarsReady-id-0001" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess-ManufactureCustomSeats-id-0002" name="Manufacture Custom Seats">
      <bpmn:incoming>SequenceFlow-ManufacturingSplitToSeats-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SeatsReadyToJoin-id-0013</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-SeatManufacturingStart-id-0001" name="Seat Manufacturing Start">
        <bpmn:outgoing>SequenceFlow-SeatStartToOrder-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="SendTask-SendSeatOrderToGermany-id-0001" name="Send: Seat Order to Germany">
        <bpmn:incoming>SequenceFlow-SeatStartToOrder-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-OrderToReceive-id-0002</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="ReceiveTask-ReceiveSeatsFromGermany-id-0001" name="Receive: Seats from Germany">
        <bpmn:incoming>SequenceFlow-OrderToReceive-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ReceiveToInspect-id-0003</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:serviceTask id="ServiceTask-InspectSeatUpholstery-id-0001" name="Inspect Seat Upholstery">
        <bpmn:incoming>SequenceFlow-ReceiveToInspect-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-InspectToEnd-id-0004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-SeatsReady-id-0001" name="Seats Ready">
        <bpmn:incoming>SequenceFlow-InspectToEnd-id-0004</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-SeatStartToOrder-id-0001" sourceRef="StartEvent-SeatManufacturingStart-id-0001" targetRef="SendTask-SendSeatOrderToGermany-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-OrderToReceive-id-0002" sourceRef="SendTask-SendSeatOrderToGermany-id-0001" targetRef="ReceiveTask-ReceiveSeatsFromGermany-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ReceiveToInspect-id-0003" sourceRef="ReceiveTask-ReceiveSeatsFromGermany-id-0001" targetRef="ServiceTask-InspectSeatUpholstery-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-InspectToEnd-id-0004" sourceRef="ServiceTask-InspectSeatUpholstery-id-0001" targetRef="EndEvent-SeatsReady-id-0001" />
    </bpmn:subProcess>
    <bpmn:sendTask id="SendTask-SendToiletOrderToSwitzerland-id-0001" name="Send: Toilet Order to Switzerland">
      <bpmn:incoming>SequenceFlow-ManufacturingSplitToToilets-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ToiletOrderToReceive-id-0009</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveToiletsFromSwitzerland-id-0001" name="Receive: Toilets from Switzerland">
      <bpmn:incoming>SequenceFlow-ToiletOrderToReceive-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ToiletsReceivedToJoin-id-0014</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="SendTask-SendLightingOrderToNetherlands-id-0001" name="Send: Lighting Order to Netherlands">
      <bpmn:incoming>SequenceFlow-ManufacturingSplitToLighting-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LightingOrderToReceive-id-0010</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveLightingFromNetherlands-id-0001" name="Receive: Lighting from Netherlands">
      <bpmn:incoming>SequenceFlow-LightingOrderToReceive-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LightingReceivedToJoin-id-0015</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="SendTask-SendElectronicsOrderToSiliconValley-id-0001" name="Send: Electronics Order to Silicon Valley">
      <bpmn:incoming>SequenceFlow-ManufacturingSplitToElectronics-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ElectronicsOrderToReceive-id-0011</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveElectronicsFromSiliconValley-id-0001" name="Receive: Electronics from Silicon Valley">
      <bpmn:incoming>SequenceFlow-ElectronicsOrderToReceive-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ElectronicsReceivedToJoin-id-0016</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="ParallelGateway-ManufacturingJoin-id-0002" name="Parallel Manufacturing Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-BarsReadyToJoin-id-0012</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-SeatsReadyToJoin-id-0013</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ToiletsReceivedToJoin-id-0014</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-LightingReceivedToJoin-id-0015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ElectronicsReceivedToJoin-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ManufacturingJoinToAssembly-id-0017</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-AssembleInterior-id-0001" name="Assemble Interior">
      <bpmn:incoming>SequenceFlow-ManufacturingJoinToAssembly-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssemblyToTestFlight-id-0018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-ConductTestFlight-id-0001" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow-AssemblyToTestFlight-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TestFlightToProtocol-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="ScriptTask-GenerateTestProtocol-id-0001" name="Computation: Generate Test Protocol">
      <bpmn:incoming>SequenceFlow-TestFlightToProtocol-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProtocolToDistribution-id-0020</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:parallelGateway id="ParallelGateway-ProtocolDistribution-id-0001" name="Protocol Distribution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ProtocolToDistribution-id-0020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DistributionToCustomer-id-0021</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DistributionToLogs-id-0022</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="SendTask-SendTestProtocolToCustomer-id-0001" name="Send: Test Protocol to Customer">
      <bpmn:incoming>SequenceFlow-DistributionToCustomer-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CustomerProtocolToJoin-id-0023</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask-SendTestProtocolToManufacturingLogs-id-0002" name="Send: Test Protocol to Manufacturing Logs">
      <bpmn:incoming>SequenceFlow-DistributionToLogs-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LogsProtocolToJoin-id-0024</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="ParallelGateway-ProtocolDistributionJoin-id-0002" name="Protocol Distribution Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-CustomerProtocolToJoin-id-0023</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-LogsProtocolToJoin-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DistributionJoinToDelivery-id-0025</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-DeliverPlaneToCustomer-id-0001" name="Deliver Plane to Customer">
      <bpmn:incoming>SequenceFlow-DistributionJoinToDelivery-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DeliveryToConfirmation-id-0026</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveCustomerDeliveryConfirmation-id-0001" name="Receive: Customer Delivery Confirmation">
      <bpmn:incoming>SequenceFlow-DeliveryToConfirmation-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConfirmationToEnd-id-0027</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent-PlaneDeliveredAndConfirmed-id-0001" name="Plane Delivered and Confirmed">
      <bpmn:incoming>SequenceFlow-ConfirmationToEnd-id-0027</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCustomerInput-id-0001" sourceRef="StartEvent-LuxuryPlaneCustomizationInitiated-id-0001" targetRef="UserTask-ReceiveCustomerSpecifications-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerInputToGenerateOrders-id-0002" sourceRef="UserTask-ReceiveCustomerSpecifications-id-0001" targetRef="ServiceTask-GenerateManufacturingOrders-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateOrdersToManufacturingSplit-id-0003" sourceRef="ServiceTask-GenerateManufacturingOrders-id-0001" targetRef="ParallelGateway-ManufacturingSplit-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ManufacturingSplitToBars-id-0004" sourceRef="ParallelGateway-ManufacturingSplit-id-0001" targetRef="SubProcess-ManufactureCustomBars-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ManufacturingSplitToSeats-id-0005" sourceRef="ParallelGateway-ManufacturingSplit-id-0001" targetRef="SubProcess-ManufactureCustomSeats-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ManufacturingSplitToToilets-id-0006" sourceRef="ParallelGateway-ManufacturingSplit-id-0001" targetRef="SendTask-SendToiletOrderToSwitzerland-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ManufacturingSplitToLighting-id-0007" sourceRef="ParallelGateway-ManufacturingSplit-id-0001" targetRef="SendTask-SendLightingOrderToNetherlands-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ManufacturingSplitToElectronics-id-0008" sourceRef="ParallelGateway-ManufacturingSplit-id-0001" targetRef="SendTask-SendElectronicsOrderToSiliconValley-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ToiletOrderToReceive-id-0009" sourceRef="SendTask-SendToiletOrderToSwitzerland-id-0001" targetRef="ReceiveTask-ReceiveToiletsFromSwitzerland-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-LightingOrderToReceive-id-0010" sourceRef="SendTask-SendLightingOrderToNetherlands-id-0001" targetRef="ReceiveTask-ReceiveLightingFromNetherlands-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ElectronicsOrderToReceive-id-0011" sourceRef="SendTask-SendElectronicsOrderToSiliconValley-id-0001" targetRef="ReceiveTask-ReceiveElectronicsFromSiliconValley-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BarsReadyToJoin-id-0012" sourceRef="SubProcess-ManufactureCustomBars-id-0001" targetRef="ParallelGateway-ManufacturingJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-SeatsReadyToJoin-id-0013" sourceRef="SubProcess-ManufactureCustomSeats-id-0002" targetRef="ParallelGateway-ManufacturingJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ToiletsReceivedToJoin-id-0014" sourceRef="ReceiveTask-ReceiveToiletsFromSwitzerland-id-0001" targetRef="ParallelGateway-ManufacturingJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-LightingReceivedToJoin-id-0015" sourceRef="ReceiveTask-ReceiveLightingFromNetherlands-id-0001" targetRef="ParallelGateway-ManufacturingJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ElectronicsReceivedToJoin-id-0016" sourceRef="ReceiveTask-ReceiveElectronicsFromSiliconValley-id-0001" targetRef="ParallelGateway-ManufacturingJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ManufacturingJoinToAssembly-id-0017" sourceRef="ParallelGateway-ManufacturingJoin-id-0002" targetRef="ServiceTask-AssembleInterior-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AssemblyToTestFlight-id-0018" sourceRef="ServiceTask-AssembleInterior-id-0001" targetRef="ServiceTask-ConductTestFlight-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TestFlightToProtocol-id-0019" sourceRef="ServiceTask-ConductTestFlight-id-0001" targetRef="ScriptTask-GenerateTestProtocol-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProtocolToDistribution-id-0020" sourceRef="ScriptTask-GenerateTestProtocol-id-0001" targetRef="ParallelGateway-ProtocolDistribution-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DistributionToCustomer-id-0021" sourceRef="ParallelGateway-ProtocolDistribution-id-0001" targetRef="SendTask-SendTestProtocolToCustomer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DistributionToLogs-id-0022" sourceRef="ParallelGateway-ProtocolDistribution-id-0001" targetRef="SendTask-SendTestProtocolToManufacturingLogs-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CustomerProtocolToJoin-id-0023" sourceRef="SendTask-SendTestProtocolToCustomer-id-0001" targetRef="ParallelGateway-ProtocolDistributionJoin-id-0002" />
