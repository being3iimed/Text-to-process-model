<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="claims-review-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:process id="ClaimsReviewProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ClaimRegistered-id-0001" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow-StartToExamine-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-ExamineClaim-id-0001" name="Examine Claim">
      <bpmn:incoming>SequenceFlow-StartToExamine-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExamineToWrite-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-WriteSettlementRecommendation-id-0002" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow-ExamineToWrite-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WriteToReview-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ReviewRecommendation-id-0003" name="Review Recommendation">
      <bpmn:incoming>SequenceFlow-WriteToReview-id-0003</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ReviseToReview-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToGateway-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RecommendationStatus-id-0001" name="Recommendation Status?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToGateway-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToApprove-id-0005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToRevise-id-0006</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-RecommendationApproved-id-0001" name="Recommendation Approved">
      <bpmn:incoming>SequenceFlow-GatewayToApprove-id-0005</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-ReviseRecommendation-id-0004" name="Revise Recommendation">
      <bpmn:incoming>SequenceFlow-MaxCheckToRevise-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviseToReview-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-RecommendationStatus-id-0002" name="Recommendation Status?" gatewayDirection="Diverging" />
    <bpmn:scriptTask id="ScriptTask-IncrementRevisionCounter-id-0001" name="Computation: increment revision_counter">
      <bpmn:incoming>SequenceFlow-GatewayToRevise-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IncrementToMaxCheck-id-0007</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-MaxRevisions-id-0001" name="Max Revisions Reached?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-IncrementToMaxCheck-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MaxCheckToEscalate-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-MaxCheckToRevise-id-0009</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-EscalateToCommittee-id-0001" name="Escalate to Committee Review">
      <bpmn:incoming>SequenceFlow-MaxCheckToEscalate-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EscalateToEnd-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-EscalatedForReview-id-0002" name="Escalated for Committee Review">
      <bpmn:incoming>SequenceFlow-EscalateToEnd-id-0011</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToExamine-id-0001" sourceRef="StartEvent-ClaimRegistered-id-0001" targetRef="UserTask-ExamineClaim-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ExamineToWrite-id-0002" sourceRef="UserTask-ExamineClaim-id-0001" targetRef="UserTask-WriteSettlementRecommendation-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-WriteToReview-id-0003" sourceRef="UserTask-WriteSettlementRecommendation-id-0002" targetRef="UserTask-ReviewRecommendation-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToGateway-id-0004" sourceRef="UserTask-ReviewRecommendation-id-0003" targetRef="ExclusiveGateway-RecommendationStatus-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToApprove-id-0005" name="recommendation_status == &#39;OK&#39;" sourceRef="ExclusiveGateway-RecommendationStatus-id-0001" targetRef="EndEvent-RecommendationApproved-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToRevise-id-0006" name="recommendation_status == &#39;Not OK&#39;" sourceRef="ExclusiveGateway-RecommendationStatus-id-0001" targetRef="ScriptTask-IncrementRevisionCounter-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-IncrementToMaxCheck-id-0007" sourceRef="ScriptTask-IncrementRevisionCounter-id-0001" targetRef="ExclusiveGateway-MaxRevisions-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MaxCheckToEscalate-id-0008" name="revision_counter &#62; 3" sourceRef="ExclusiveGateway-MaxRevisions-id-0001" targetRef="UserTask-EscalateToCommittee-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MaxCheckToRevise-id-0009" name="revision_counter &#60;= 3" sourceRef="ExclusiveGateway-MaxRevisions-id-0001" targetRef="UserTask-ReviseRecommendation-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviseToReview-id-0010" sourceRef="UserTask-ReviseRecommendation-id-0004" targetRef="UserTask-ReviewRecommendation-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-EscalateToEnd-id-0011" sourceRef="UserTask-EscalateToCommittee-id-0001" targetRef="EndEvent-EscalatedForReview-id-0002" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ClaimsReviewProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_ClaimsReviewProcess" bpmnElement="ClaimsReviewProcess">
      <bpmndi:BPMNShape id="StartEvent-ClaimRegistered-id-0001_di" bpmnElement="StartEvent-ClaimRegistered-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ExamineClaim-id-0001_di" bpmnElement="UserTask-ExamineClaim-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-WriteSettlementRecommendation-id-0002_di" bpmnElement="UserTask-WriteSettlementRecommendation-id-0002">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviewRecommendation-id-0003_di" bpmnElement="UserTask-ReviewRecommendation-id-0003">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-RecommendationStatus-id-0001_di" bpmnElement="ExclusiveGateway-RecommendationStatus-id-0001" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RecommendationApproved-id-0001_di" bpmnElement="EndEvent-RecommendationApproved-id-0001">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-RecommendationStatus-id-0002_di" bpmnElement="ExclusiveGateway-RecommendationStatus-id-0002" isMarkerVisible="true">
        <dc:Bounds x="50" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScriptTask-IncrementRevisionCounter-id-0001_di" bpmnElement="ScriptTask-IncrementRevisionCounter-id-0001">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-MaxRevisions-id-0001_di" bpmnElement="ExclusiveGateway-MaxRevisions-id-0001" isMarkerVisible="true">
        <dc:Bounds x="950" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-EscalateToCommittee-id-0001_di" bpmnElement="UserTask-EscalateToCommittee-id-0001">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-EscalatedForReview-id-0002_di" bpmnElement="EndEvent-EscalatedForReview-id-0002">
        <dc:Bounds x="1257" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ReviseRecommendation-id-0004_di" bpmnElement="UserTask-ReviseRecommendation-id-0004">
        <dc:Bounds x="1075" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToExamine-id-0001_di" bpmnElement="SequenceFlow-StartToExamine-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ExamineToWrite-id-0002_di" bpmnElement="SequenceFlow-ExamineToWrite-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-WriteToReview-id-0003_di" bpmnElement="SequenceFlow-WriteToReview-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToGateway-id-0004_di" bpmnElement="SequenceFlow-ReviewToGateway-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToApprove-id-0005_di" bpmnElement="SequenceFlow-GatewayToApprove-id-0005">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="807" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToRevise-id-0006_di" bpmnElement="SequenceFlow-GatewayToRevise-id-0006">
        <di:waypoint x="675" y="95" />
        <di:waypoint x="675" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-IncrementToMaxCheck-id-0007_di" bpmnElement="SequenceFlow-IncrementToMaxCheck-id-0007">
        <di:waypoint x="875" y="210" />
        <di:waypoint x="950" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MaxCheckToEscalate-id-0008_di" bpmnElement="SequenceFlow-MaxCheckToEscalate-id-0008">
        <di:waypoint x="1000" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MaxCheckToRevise-id-0009_di" bpmnElement="SequenceFlow-MaxCheckToRevise-id-0009">
        <di:waypoint x="975" y="235" />
        <di:waypoint x="975" y="350" />
        <di:waypoint x="1075" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EscalateToEnd-id-0011_di" bpmnElement="SequenceFlow-EscalateToEnd-id-0011">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1257" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviseToReview-id-0010_di" bpmnElement="SequenceFlow-ReviseToReview-id-0010">
        <di:waypoint x="1125" y="390" />
        <di:waypoint x="1125" y="420" />
        <di:waypoint x="525" y="420" />
        <di:waypoint x="525" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
