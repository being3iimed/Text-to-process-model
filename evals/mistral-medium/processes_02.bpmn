<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="HiringProcessDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="HiringProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-HiringNeedIdentified-id-0001" name="Hiring Need Identified">
      <bpmn:outgoing>SequenceFlow-StartToJobCreation-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-HRCreatesJobDescription-id-0001" name="HR creates job description">
      <bpmn:incoming>SequenceFlow-StartToJobCreation-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JobCreationToPost-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-PostJobOnBoards-id-0001" name="Post job on boards">
      <bpmn:incoming>SequenceFlow-JobCreationToPost-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PostToScreen-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-ScreenResumes-id-0001" name="Screen resumes">
      <bpmn:incoming>SequenceFlow-PostToScreen-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ScreenToPhoneInterviews-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConductPhoneInterviews-id-0001" name="Conduct phone interviews">
      <bpmn:incoming>SequenceFlow-ScreenToPhoneInterviews-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PhoneToScheduleInterviews-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ScheduleInterviews-id-0001" name="Schedule in-person/virtual interviews">
      <bpmn:incoming>SequenceFlow-PhoneToScheduleInterviews-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ScheduleToFinalInterviews-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConductFinalInterviews-id-0001" name="Conduct final interviews">
      <bpmn:incoming>SequenceFlow-ScheduleToFinalInterviews-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FinalToSelectCandidate-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectCandidate-id-0001" name="Select candidate">
      <bpmn:incoming>SequenceFlow-FinalToSelectCandidate-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToOfferDecision-id-0008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-OfferDecision-id-0001" name="Offer Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SelectToOfferDecision-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OfferDecisionToExtendOffer-id-0009</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-OfferDecisionToPositionOpen-id-0010</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-ExtendOffer-id-0001" name="Extend offer">
      <bpmn:incoming>SequenceFlow-OfferDecisionToExtendOffer-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ExtendToSalaryNegotiation-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SalaryNegotiation-id-0001" name="Salary negotiation">
      <bpmn:incoming>SequenceFlow-ExtendToSalaryNegotiation-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NegotiationToAgreementCheck-id-0012</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AgreementCheck-id-0001" name="Agreement Check" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-NegotiationToAgreementCheck-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AgreementCheckToOnboarding-id-0013</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AgreementCheckToOfferWithdrawn-id-0014</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess-Onboarding-id-0001" name="Onboarding">
      <bpmn:incoming>SequenceFlow-AgreementCheckToOnboarding-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OnboardingCompleteToProcessComplete-id-0019</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-OnboardingStart-id-0001" name="Onboarding Start">
        <bpmn:outgoing>SequenceFlow-OnboardingStartToGeneratePaperwork-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask-GenerateOnboardingPaperwork-id-0001" name="Generate onboarding paperwork">
        <bpmn:incoming>SequenceFlow-OnboardingStartToGeneratePaperwork-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GenerateToOrientation-id-0002</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="UserTask-CompleteOrientation-id-0001" name="Complete orientation">
        <bpmn:incoming>SequenceFlow-GenerateToOrientation-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-OrientationToTraining-id-0003</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="UserTask-CompleteTraining-id-0001" name="Complete training">
        <bpmn:incoming>SequenceFlow-OrientationToTraining-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-TrainingToOnboardingComplete-id-0004</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EndEvent-OnboardingComplete-id-0001" name="Onboarding Complete">
        <bpmn:incoming>SequenceFlow-TrainingToOnboardingComplete-id-0004</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-OnboardingStartToGeneratePaperwork-id-0001" sourceRef="StartEvent-OnboardingStart-id-0001" targetRef="ServiceTask-GenerateOnboardingPaperwork-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GenerateToOrientation-id-0002" sourceRef="ServiceTask-GenerateOnboardingPaperwork-id-0001" targetRef="UserTask-CompleteOrientation-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-OrientationToTraining-id-0003" sourceRef="UserTask-CompleteOrientation-id-0001" targetRef="UserTask-CompleteTraining-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-TrainingToOnboardingComplete-id-0004" sourceRef="UserTask-CompleteTraining-id-0001" targetRef="EndEvent-OnboardingComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent-HiringProcessComplete-id-0001" name="Hiring Process Complete" />
    <bpmn:endEvent id="EndEvent-OfferWithdrawn-id-0001" name="Offer Withdrawn">
      <bpmn:incoming>SequenceFlow-AgreementCheckToOfferWithdrawn-id-0014</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-PositionRemainsOpen-id-0001" name="Position Remains Open">
      <bpmn:incoming>SequenceFlow-OfferDecisionToPositionOpen-id-0010</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0001" name="Process Complete">
      <bpmn:incoming>SequenceFlow-OnboardingCompleteToProcessComplete-id-0019</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToJobCreation-id-0001" sourceRef="StartEvent-HiringNeedIdentified-id-0001" targetRef="UserTask-HRCreatesJobDescription-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-JobCreationToPost-id-0002" sourceRef="UserTask-HRCreatesJobDescription-id-0001" targetRef="ServiceTask-PostJobOnBoards-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PostToScreen-id-0003" sourceRef="ServiceTask-PostJobOnBoards-id-0001" targetRef="UserTask-ScreenResumes-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ScreenToPhoneInterviews-id-0004" sourceRef="UserTask-ScreenResumes-id-0001" targetRef="UserTask-ConductPhoneInterviews-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PhoneToScheduleInterviews-id-0005" sourceRef="UserTask-ConductPhoneInterviews-id-0001" targetRef="UserTask-ScheduleInterviews-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ScheduleToFinalInterviews-id-0006" sourceRef="UserTask-ScheduleInterviews-id-0001" targetRef="UserTask-ConductFinalInterviews-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FinalToSelectCandidate-id-0007" sourceRef="UserTask-ConductFinalInterviews-id-0001" targetRef="UserTask-SelectCandidate-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToOfferDecision-id-0008" sourceRef="UserTask-SelectCandidate-id-0001" targetRef="ExclusiveGateway-OfferDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-OfferDecisionToExtendOffer-id-0009" name="offer accepted" sourceRef="ExclusiveGateway-OfferDecision-id-0001" targetRef="UserTask-ExtendOffer-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-OfferDecisionToPositionOpen-id-0010" name="offer rejected" sourceRef="ExclusiveGateway-OfferDecision-id-0001" targetRef="EndEvent-PositionRemainsOpen-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ExtendToSalaryNegotiation-id-0011" sourceRef="UserTask-ExtendOffer-id-0001" targetRef="UserTask-SalaryNegotiation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NegotiationToAgreementCheck-id-0012" sourceRef="UserTask-SalaryNegotiation-id-0001" targetRef="ExclusiveGateway-AgreementCheck-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AgreementCheckToOnboarding-id-0013" name="agreement reached" sourceRef="ExclusiveGateway-AgreementCheck-id-0001" targetRef="SubProcess-Onboarding-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AgreementCheckToOfferWithdrawn-id-0014" name="no agreement" sourceRef="ExclusiveGateway-AgreementCheck-id-0001" targetRef="EndEvent-OfferWithdrawn-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-OnboardingCompleteToProcessComplete-id-0019" sourceRef="SubProcess-Onboarding-id-0001" targetRef="EndEvent-ProcessComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HiringProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_HiringProcess" bpmnElement="HiringProcess">
      <bpmndi:BPMNShape id="StartEvent-HiringNeedIdentified-id-0001_di" bpmnElement="StartEvent-HiringNeedIdentified-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-HRCreatesJobDescription-id-0001_di" bpmnElement="UserTask-HRCreatesJobDescription-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PostJobOnBoards-id-0001_di" bpmnElement="ServiceTask-PostJobOnBoards-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ScreenResumes-id-0001_di" bpmnElement="UserTask-ScreenResumes-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ConductPhoneInterviews-id-0001_di" bpmnElement="UserTask-ConductPhoneInterviews-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ScheduleInterviews-id-0001_di" bpmnElement="UserTask-ScheduleInterviews-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ConductFinalInterviews-id-0001_di" bpmnElement="UserTask-ConductFinalInterviews-id-0001">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SelectCandidate-id-0001_di" bpmnElement="UserTask-SelectCandidate-id-0001">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-OfferDecision-id-0001_di" bpmnElement="ExclusiveGateway-OfferDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-ExtendOffer-id-0001_di" bpmnElement="UserTask-ExtendOffer-id-0001">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SalaryNegotiation-id-0001_di" bpmnElement="UserTask-SalaryNegotiation-id-0001">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-AgreementCheck-id-0001_di" bpmnElement="ExclusiveGateway-AgreementCheck-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1700" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-Onboarding-id-0001_di" bpmnElement="SubProcess-Onboarding-id-0001">
        <dc:Bounds x="1825" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessComplete-id-0001_di" bpmnElement="EndEvent-ProcessComplete-id-0001">
        <dc:Bounds x="2007" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-HiringProcessComplete-id-0001_di" bpmnElement="EndEvent-HiringProcessComplete-id-0001">
        <dc:Bounds x="57" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PositionRemainsOpen-id-0001_di" bpmnElement="EndEvent-PositionRemainsOpen-id-0001">
        <dc:Bounds x="1407" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-OfferWithdrawn-id-0001_di" bpmnElement="EndEvent-OfferWithdrawn-id-0001">
        <dc:Bounds x="1857" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToJobCreation-id-0001_di" bpmnElement="SequenceFlow-StartToJobCreation-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-JobCreationToPost-id-0002_di" bpmnElement="SequenceFlow-JobCreationToPost-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PostToScreen-id-0003_di" bpmnElement="SequenceFlow-PostToScreen-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ScreenToPhoneInterviews-id-0004_di" bpmnElement="SequenceFlow-ScreenToPhoneInterviews-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PhoneToScheduleInterviews-id-0005_di" bpmnElement="SequenceFlow-PhoneToScheduleInterviews-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ScheduleToFinalInterviews-id-0006_di" bpmnElement="SequenceFlow-ScheduleToFinalInterviews-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FinalToSelectCandidate-id-0007_di" bpmnElement="SequenceFlow-FinalToSelectCandidate-id-0007">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectToOfferDecision-id-0008_di" bpmnElement="SequenceFlow-SelectToOfferDecision-id-0008">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1250" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-OfferDecisionToExtendOffer-id-0009_di" bpmnElement="SequenceFlow-OfferDecisionToExtendOffer-id-0009">
        <di:waypoint x="1300" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-OfferDecisionToPositionOpen-id-0010_di" bpmnElement="SequenceFlow-OfferDecisionToPositionOpen-id-0010">
        <di:waypoint x="1275" y="95" />
        <di:waypoint x="1275" y="210" />
        <di:waypoint x="1407" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ExtendToSalaryNegotiation-id-0011_di" bpmnElement="SequenceFlow-ExtendToSalaryNegotiation-id-0011">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1525" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-NegotiationToAgreementCheck-id-0012_di" bpmnElement="SequenceFlow-NegotiationToAgreementCheck-id-0012">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1700" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AgreementCheckToOnboarding-id-0013_di" bpmnElement="SequenceFlow-AgreementCheckToOnboarding-id-0013">
        <di:waypoint x="1750" y="70" />
        <di:waypoint x="1825" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-AgreementCheckToOfferWithdrawn-id-0014_di" bpmnElement="SequenceFlow-AgreementCheckToOfferWithdrawn-id-0014">
        <di:waypoint x="1725" y="95" />
        <di:waypoint x="1725" y="210" />
        <di:waypoint x="1857" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-OnboardingCompleteToProcessComplete-id-0019_di" bpmnElement="SequenceFlow-OnboardingCompleteToProcessComplete-id-0019">
        <di:waypoint x="1925" y="70" />
        <di:waypoint x="2007" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-Onboarding-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-Onboarding-id-0001" bpmnElement="SubProcess-Onboarding-id-0001">
      <bpmndi:BPMNShape id="StartEvent-OnboardingStart-id-0001_di" bpmnElement="StartEvent-OnboardingStart-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateOnboardingPaperwork-id-0001_di" bpmnElement="ServiceTask-GenerateOnboardingPaperwork-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CompleteOrientation-id-0001_di" bpmnElement="UserTask-CompleteOrientation-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CompleteTraining-id-0001_di" bpmnElement="UserTask-CompleteTraining-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-OnboardingComplete-id-0001_di" bpmnElement="EndEvent-OnboardingComplete-id-0001">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-OnboardingStartToGeneratePaperwork-id-0001_di" bpmnElement="SequenceFlow-OnboardingStartToGeneratePaperwork-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GenerateToOrientation-id-0002_di" bpmnElement="SequenceFlow-GenerateToOrientation-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-OrientationToTraining-id-0003_di" bpmnElement="SequenceFlow-OrientationToTraining-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TrainingToOnboardingComplete-id-0004_di" bpmnElement="SequenceFlow-TrainingToOnboardingComplete-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
