<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ProductDevelopmentProcess-Definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler (https://bpmn.io)" exporterVersion="1.0">
  <bpmn:process id="ProductDevelopmentProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ProductDevelopmentInitiated-id-0001" name="Product Development Initiated">
      <bpmn:outgoing>SequenceFlow-StartToIdentifyIdea-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-IdentifyNewProductIdea-id-0001" name="Identify New Product Idea">
      <bpmn:incoming>SequenceFlow-StartToIdentifyIdea-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdeaToResearch-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-ConductInitialResearch-id-0001" name="Conduct Initial Research">
      <bpmn:incoming>SequenceFlow-IdeaToResearch-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ResearchToDraft-id-0003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask-DraftDesignConcepts-id-0001" name="Draft Design Concepts">
      <bpmn:incoming>SequenceFlow-ResearchToDraft-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DraftToSelect-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectPromisingDesign-id-0001" name="Select Promising Design">
      <bpmn:incoming>SequenceFlow-DraftToSelect-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectToBuild-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-BuildPrototype-id-0001" name="Build Prototype">
      <bpmn:incoming>SequenceFlow-SelectToBuild-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BuildToTest-id-0006</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-TestPrototype-id-0001" name="Test Prototype">
      <bpmn:incoming>SequenceFlow-BuildToTest-id-0006</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-RefineToTest-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TestToDecision-id-0007</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PrototypeDecision-id-0001" name="Prototype Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-TestToDecision-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DecisionToFeedback-id-0008</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DecisionToApproval-id-0009</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-CollectFeedback-id-0001" name="Collect Feedback">
      <bpmn:incoming>SequenceFlow-DecisionToFeedback-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FeedbackToRefine-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-RefinePrototype-id-0001" name="Refine Prototype">
      <bpmn:incoming>SequenceFlow-FeedbackToRefine-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RefineToTest-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-FinalApprovalDecision-id-0001" name="Final Approval Decision">
      <bpmn:incoming>SequenceFlow-MergeToApproval-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApprovalToDecision-id-0013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ApprovalDecision-id-0001" name="Approval Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ApprovalToDecision-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DecisionToApproved-id-0014</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DecisionToDiscarded-id-0015</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-PrototypeApproved-id-0001" name="Prototype Approved">
      <bpmn:incoming>SequenceFlow-DecisionToApproved-id-0014</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-PrototypeDiscarded-id-0002" name="Prototype Discarded">
      <bpmn:incoming>SequenceFlow-DecisionToDiscarded-id-0015</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PrototypeDecisionMerge-id-0002" name="Prototype Decision Merge" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-DecisionToApproval-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MergeToApproval-id-0012</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow-StartToIdentifyIdea-id-0001" sourceRef="StartEvent-ProductDevelopmentInitiated-id-0001" targetRef="UserTask-IdentifyNewProductIdea-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-IdeaToResearch-id-0002" sourceRef="UserTask-IdentifyNewProductIdea-id-0001" targetRef="ServiceTask-ConductInitialResearch-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ResearchToDraft-id-0003" sourceRef="ServiceTask-ConductInitialResearch-id-0001" targetRef="UserTask-DraftDesignConcepts-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DraftToSelect-id-0004" sourceRef="UserTask-DraftDesignConcepts-id-0001" targetRef="UserTask-SelectPromisingDesign-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectToBuild-id-0005" sourceRef="UserTask-SelectPromisingDesign-id-0001" targetRef="ServiceTask-BuildPrototype-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BuildToTest-id-0006" sourceRef="ServiceTask-BuildPrototype-id-0001" targetRef="ServiceTask-TestPrototype-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TestToDecision-id-0007" sourceRef="ServiceTask-TestPrototype-id-0001" targetRef="ExclusiveGateway-PrototypeDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DecisionToFeedback-id-0008" name="needs_refinement == true" sourceRef="ExclusiveGateway-PrototypeDecision-id-0001" targetRef="UserTask-CollectFeedback-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DecisionToApproval-id-0009" name="ready_for_approval == true" sourceRef="ExclusiveGateway-PrototypeDecision-id-0001" targetRef="ExclusiveGateway-PrototypeDecisionMerge-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-FeedbackToRefine-id-0010" sourceRef="UserTask-CollectFeedback-id-0001" targetRef="UserTask-RefinePrototype-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RefineToTest-id-0011" sourceRef="UserTask-RefinePrototype-id-0001" targetRef="ServiceTask-TestPrototype-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MergeToApproval-id-0012" sourceRef="ExclusiveGateway-PrototypeDecisionMerge-id-0002" targetRef="UserTask-FinalApprovalDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ApprovalToDecision-id-0013" sourceRef="UserTask-FinalApprovalDecision-id-0001" targetRef="ExclusiveGateway-ApprovalDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DecisionToApproved-id-0014" name="approved == true" sourceRef="ExclusiveGateway-ApprovalDecision-id-0001" targetRef="EndEvent-PrototypeApproved-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DecisionToDiscarded-id-0015" sourceRef="ExclusiveGateway-ApprovalDecision-id-0001" targetRef="EndEvent-PrototypeDiscarded-id-0002" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ProductDevelopmentProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_ProductDevelopmentProcess" bpmnElement="ProductDevelopmentProcess">
      <bpmndi:BPMNShape id="StartEvent-ProductDevelopmentInitiated-id-0001_di" bpmnElement="StartEvent-ProductDevelopmentInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-IdentifyNewProductIdea-id-0001_di" bpmnElement="UserTask-IdentifyNewProductIdea-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-ConductInitialResearch-id-0001_di" bpmnElement="ServiceTask-ConductInitialResearch-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DraftDesignConcepts-id-0001_di" bpmnElement="UserTask-DraftDesignConcepts-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-SelectPromisingDesign-id-0001_di" bpmnElement="UserTask-SelectPromisingDesign-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-BuildPrototype-id-0001_di" bpmnElement="ServiceTask-BuildPrototype-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TestPrototype-id-0001_di" bpmnElement="ServiceTask-TestPrototype-id-0001">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PrototypeDecision-id-0001_di" bpmnElement="ExclusiveGateway-PrototypeDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CollectFeedback-id-0001_di" bpmnElement="UserTask-CollectFeedback-id-0001">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-RefinePrototype-id-0001_di" bpmnElement="UserTask-RefinePrototype-id-0001">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-PrototypeDecisionMerge-id-0002_di" bpmnElement="ExclusiveGateway-PrototypeDecisionMerge-id-0002" isMarkerVisible="true">
        <dc:Bounds x="1550" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-FinalApprovalDecision-id-0001_di" bpmnElement="UserTask-FinalApprovalDecision-id-0001">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ApprovalDecision-id-0001_di" bpmnElement="ExclusiveGateway-ApprovalDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1850" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PrototypeApproved-id-0001_di" bpmnElement="EndEvent-PrototypeApproved-id-0001">
        <dc:Bounds x="2007" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PrototypeDiscarded-id-0002_di" bpmnElement="EndEvent-PrototypeDiscarded-id-0002">
        <dc:Bounds x="2007" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToIdentifyIdea-id-0001_di" bpmnElement="SequenceFlow-StartToIdentifyIdea-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-IdeaToResearch-id-0002_di" bpmnElement="SequenceFlow-IdeaToResearch-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ResearchToDraft-id-0003_di" bpmnElement="SequenceFlow-ResearchToDraft-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DraftToSelect-id-0004_di" bpmnElement="SequenceFlow-DraftToSelect-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SelectToBuild-id-0005_di" bpmnElement="SequenceFlow-SelectToBuild-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BuildToTest-id-0006_di" bpmnElement="SequenceFlow-BuildToTest-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-TestToDecision-id-0007_di" bpmnElement="SequenceFlow-TestToDecision-id-0007">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DecisionToFeedback-id-0008_di" bpmnElement="SequenceFlow-DecisionToFeedback-id-0008">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DecisionToApproval-id-0009_di" bpmnElement="SequenceFlow-DecisionToApproval-id-0009">
        <di:waypoint x="1125" y="95" />
        <di:waypoint x="1125" y="140" />
        <di:waypoint x="1575" y="140" />
        <di:waypoint x="1575" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FeedbackToRefine-id-0010_di" bpmnElement="SequenceFlow-FeedbackToRefine-id-0010">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RefineToTest-id-0011_di" bpmnElement="SequenceFlow-RefineToTest-id-0011">
        <di:waypoint x="1425" y="110" />
        <di:waypoint x="1425" y="140" />
        <di:waypoint x="975" y="140" />
        <di:waypoint x="975" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-MergeToApproval-id-0012_di" bpmnElement="SequenceFlow-MergeToApproval-id-0012">
        <di:waypoint x="1600" y="70" />
        <di:waypoint x="1675" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ApprovalToDecision-id-0013_di" bpmnElement="SequenceFlow-ApprovalToDecision-id-0013">
        <di:waypoint x="1775" y="70" />
        <di:waypoint x="1850" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DecisionToApproved-id-0014_di" bpmnElement="SequenceFlow-DecisionToApproved-id-0014">
        <di:waypoint x="1900" y="70" />
        <di:waypoint x="2007" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DecisionToDiscarded-id-0015_di" bpmnElement="SequenceFlow-DecisionToDiscarded-id-0015">
        <di:waypoint x="1875" y="95" />
        <di:waypoint x="1875" y="210" />
        <di:waypoint x="2007" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
