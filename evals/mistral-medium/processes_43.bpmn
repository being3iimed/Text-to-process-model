<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="CarServiceProcessDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="CarServiceProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent-ServiceCompleted-id-0001" name="Service Completed">
      <bpmn:outgoing>SequenceFlow-StartToCheckRegistration-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask-CheckCarRegistrationStatus-id-0001" name="Check Car Registration Status">
      <bpmn:incoming>SequenceFlow-StartToCheckRegistration-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckRegistrationToGateway-id-0002</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-CarRegistered-id-0001" name="Car Registered?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckRegistrationToGateway-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GatewayToServiceNotification-id-0003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-GatewayToUnregisteredEnd-id-0004</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-ServiceNotification-id-0001" name="Send: Service Notification">
      <bpmn:incoming>SequenceFlow-GatewayToServiceNotification-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ServiceNotificationToRepairWorkflow-id-0005</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="BoundaryEvent-Timer30Day-ServiceNotification-id-0001" name="30 Day Compliance Timeout" attachedToRef="SendTask-ServiceNotification-id-0001">
      <bpmn:outgoing>SequenceFlow-BoundaryToFineNotification-id-0008</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-Timer30Day-ServiceNotification-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-FineNotification-id-0001" name="Send: Fine Notification">
      <bpmn:incoming>SequenceFlow-BoundaryToFineNotification-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FineNotificationToFineIssued-id-0009</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-FineIssued-id-0001" name="Fine Issued">
      <bpmn:incoming>SequenceFlow-FineNotificationToFineIssued-id-0009</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess-RepairWorkflow-id-0001" name="Repair Workflow">
      <bpmn:incoming>SequenceFlow-ServiceNotificationToRepairWorkflow-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RepairWorkflowToPickerlConfirmation-id-0006</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-RepairInitiated-id-0001" name="Repair Initiated">
        <bpmn:outgoing>SequenceFlow-RepairStartToEnterProblems-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask-MechanicEntersCarProblems-id-0001" name="Mechanic Enters Car Problems">
        <bpmn:incoming>SequenceFlow-RepairStartToEnterProblems-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-EnterProblemsToRepairInProgress-id-0002</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-RepairInProgress-id-0001" name="Repair In Progress">
        <bpmn:incoming>SequenceFlow-EnterProblemsToRepairInProgress-id-0002</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-DailyUpdateToRepairInProgress-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-RepairInProgressToGenerateUpdate-id-0003</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-RepairInProgressToPayment-id-0007</bpmn:outgoing>
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="ServiceTask-GenerateStatusUpdate-id-0001" name="Generate Status Update">
        <bpmn:incoming>SequenceFlow-RepairInProgressToGenerateUpdate-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-GenerateUpdateToSendEmail-id-0004</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SendTask-StatusUpdateEmail-id-0001" name="Send: Status Update Email">
        <bpmn:incoming>SequenceFlow-GenerateUpdateToSendEmail-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-SendEmailToDailyUpdate-id-0005</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="IntermediateCatchEvent-DailyUpdate-id-0001" name="Daily Update Timer">
        <bpmn:incoming>SequenceFlow-SendEmailToDailyUpdate-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-DailyUpdateToRepairInProgress-id-0006</bpmn:outgoing>
      </bpmn:intermediateCatchEvent>
      <bpmn:receiveTask id="ReceiveTask-PaymentConfirmation-id-0001" name="Receive: Payment Confirmation">
        <bpmn:incoming>SequenceFlow-RepairInProgressToPayment-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PaymentToConfirmSuccess-id-0008</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:userTask id="UserTask-MechanicConfirmsRepairSuccess-id-0001" name="Mechanic Confirms Repair Success">
        <bpmn:incoming>SequenceFlow-PaymentToConfirmSuccess-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ConfirmSuccessToScheduleNext-id-0009</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="UserTask-MechanicSchedulesNextService-id-0001" name="Mechanic Schedules Next Service">
        <bpmn:incoming>SequenceFlow-ConfirmSuccessToScheduleNext-id-0009</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ScheduleNextToRepairComplete-id-0010</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EndEvent-RepairComplete-id-0001" name="Repair Complete">
        <bpmn:incoming>SequenceFlow-ScheduleNextToRepairComplete-id-0010</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow-RepairStartToEnterProblems-id-0001" sourceRef="StartEvent-RepairInitiated-id-0001" targetRef="UserTask-MechanicEntersCarProblems-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-EnterProblemsToRepairInProgress-id-0002" sourceRef="UserTask-MechanicEntersCarProblems-id-0001" targetRef="IntermediateCatchEvent-RepairInProgress-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-RepairInProgressToGenerateUpdate-id-0003" sourceRef="IntermediateCatchEvent-RepairInProgress-id-0001" targetRef="ServiceTask-GenerateStatusUpdate-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-GenerateUpdateToSendEmail-id-0004" sourceRef="ServiceTask-GenerateStatusUpdate-id-0001" targetRef="SendTask-StatusUpdateEmail-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-SendEmailToDailyUpdate-id-0005" sourceRef="SendTask-StatusUpdateEmail-id-0001" targetRef="IntermediateCatchEvent-DailyUpdate-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-DailyUpdateToRepairInProgress-id-0006" sourceRef="IntermediateCatchEvent-DailyUpdate-id-0001" targetRef="IntermediateCatchEvent-RepairInProgress-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-RepairInProgressToPayment-id-0007" name="repair_complete" sourceRef="IntermediateCatchEvent-RepairInProgress-id-0001" targetRef="ReceiveTask-PaymentConfirmation-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PaymentToConfirmSuccess-id-0008" sourceRef="ReceiveTask-PaymentConfirmation-id-0001" targetRef="UserTask-MechanicConfirmsRepairSuccess-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ConfirmSuccessToScheduleNext-id-0009" sourceRef="UserTask-MechanicConfirmsRepairSuccess-id-0001" targetRef="UserTask-MechanicSchedulesNextService-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ScheduleNextToRepairComplete-id-0010" sourceRef="UserTask-MechanicSchedulesNextService-id-0001" targetRef="EndEvent-RepairComplete-id-0001" />
    </bpmn:subProcess>
    <bpmn:sendTask id="SendTask-PickerlConfirmation-id-0001" name="Send: Pickerl Confirmation">
      <bpmn:incoming>SequenceFlow-RepairWorkflowToPickerlConfirmation-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PickerlConfirmationToProcessComplete-id-0007</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-ProcessComplete-id-0001" name="Process Complete">
      <bpmn:incoming>SequenceFlow-PickerlConfirmationToProcessComplete-id-0007</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent-UnregisteredVehicle-id-0001" name="Process Complete (Unregistered Vehicle)">
      <bpmn:incoming>SequenceFlow-GatewayToUnregisteredEnd-id-0004</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToCheckRegistration-id-0001" sourceRef="StartEvent-ServiceCompleted-id-0001" targetRef="ServiceTask-CheckCarRegistrationStatus-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckRegistrationToGateway-id-0002" sourceRef="ServiceTask-CheckCarRegistrationStatus-id-0001" targetRef="ExclusiveGateway-CarRegistered-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToServiceNotification-id-0003" name="car_registered" sourceRef="ExclusiveGateway-CarRegistered-id-0001" targetRef="SendTask-ServiceNotification-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GatewayToUnregisteredEnd-id-0004" sourceRef="ExclusiveGateway-CarRegistered-id-0001" targetRef="EndEvent-UnregisteredVehicle-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ServiceNotificationToRepairWorkflow-id-0005" sourceRef="SendTask-ServiceNotification-id-0001" targetRef="SubProcess-RepairWorkflow-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-RepairWorkflowToPickerlConfirmation-id-0006" sourceRef="SubProcess-RepairWorkflow-id-0001" targetRef="SendTask-PickerlConfirmation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PickerlConfirmationToProcessComplete-id-0007" sourceRef="SendTask-PickerlConfirmation-id-0001" targetRef="EndEvent-ProcessComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryToFineNotification-id-0008" sourceRef="BoundaryEvent-Timer30Day-ServiceNotification-id-0001" targetRef="SendTask-FineNotification-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-FineNotificationToFineIssued-id-0009" sourceRef="SendTask-FineNotification-id-0001" targetRef="EndEvent-FineIssued-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CarServiceProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_CarServiceProcess" bpmnElement="CarServiceProcess">
      <bpmndi:BPMNShape id="StartEvent-ServiceCompleted-id-0001_di" bpmnElement="StartEvent-ServiceCompleted-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-CheckCarRegistrationStatus-id-0001_di" bpmnElement="ServiceTask-CheckCarRegistrationStatus-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-CarRegistered-id-0001_di" bpmnElement="ExclusiveGateway-CarRegistered-id-0001" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-ServiceNotification-id-0001_di" bpmnElement="SendTask-ServiceNotification-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-Timer30Day-ServiceNotification-id-0001_di" bpmnElement="BoundaryEvent-Timer30Day-ServiceNotification-id-0001">
        <dc:Bounds x="507" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-RepairWorkflow-id-0001_di" bpmnElement="SubProcess-RepairWorkflow-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-PickerlConfirmation-id-0001_di" bpmnElement="SendTask-PickerlConfirmation-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ProcessComplete-id-0001_di" bpmnElement="EndEvent-ProcessComplete-id-0001">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-FineNotification-id-0001_di" bpmnElement="SendTask-FineNotification-id-0001">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-FineIssued-id-0001_di" bpmnElement="EndEvent-FineIssued-id-0001">
        <dc:Bounds x="807" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-UnregisteredVehicle-id-0001_di" bpmnElement="EndEvent-UnregisteredVehicle-id-0001">
        <dc:Bounds x="507" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToCheckRegistration-id-0001_di" bpmnElement="SequenceFlow-StartToCheckRegistration-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CheckRegistrationToGateway-id-0002_di" bpmnElement="SequenceFlow-CheckRegistrationToGateway-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToServiceNotification-id-0003_di" bpmnElement="SequenceFlow-GatewayToServiceNotification-id-0003">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GatewayToUnregisteredEnd-id-0004_di" bpmnElement="SequenceFlow-GatewayToUnregisteredEnd-id-0004">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="350" />
        <di:waypoint x="507" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ServiceNotificationToRepairWorkflow-id-0005_di" bpmnElement="SequenceFlow-ServiceNotificationToRepairWorkflow-id-0005">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-BoundaryToFineNotification-id-0008_di" bpmnElement="SequenceFlow-BoundaryToFineNotification-id-0008">
        <di:waypoint x="525" y="128" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RepairWorkflowToPickerlConfirmation-id-0006_di" bpmnElement="SequenceFlow-RepairWorkflowToPickerlConfirmation-id-0006">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PickerlConfirmationToProcessComplete-id-0007_di" bpmnElement="SequenceFlow-PickerlConfirmationToProcessComplete-id-0007">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-FineNotificationToFineIssued-id-0009_di" bpmnElement="SequenceFlow-FineNotificationToFineIssued-id-0009">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="807" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-RepairWorkflow-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-RepairWorkflow-id-0001" bpmnElement="SubProcess-RepairWorkflow-id-0001">
      <bpmndi:BPMNShape id="StartEvent-RepairInitiated-id-0001_di" bpmnElement="StartEvent-RepairInitiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-MechanicEntersCarProblems-id-0001_di" bpmnElement="UserTask-MechanicEntersCarProblems-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent-RepairInProgress-id-0001_di" bpmnElement="IntermediateCatchEvent-RepairInProgress-id-0001">
        <dc:Bounds x="357" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateStatusUpdate-id-0001_di" bpmnElement="ServiceTask-GenerateStatusUpdate-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-StatusUpdateEmail-id-0001_di" bpmnElement="SendTask-StatusUpdateEmail-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent-DailyUpdate-id-0001_di" bpmnElement="IntermediateCatchEvent-DailyUpdate-id-0001">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-PaymentConfirmation-id-0001_di" bpmnElement="ReceiveTask-PaymentConfirmation-id-0001">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-MechanicConfirmsRepairSuccess-id-0001_di" bpmnElement="UserTask-MechanicConfirmsRepairSuccess-id-0001">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-MechanicSchedulesNextService-id-0001_di" bpmnElement="UserTask-MechanicSchedulesNextService-id-0001">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-RepairComplete-id-0001_di" bpmnElement="EndEvent-RepairComplete-id-0001">
        <dc:Bounds x="957" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-RepairStartToEnterProblems-id-0001_di" bpmnElement="SequenceFlow-RepairStartToEnterProblems-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-EnterProblemsToRepairInProgress-id-0002_di" bpmnElement="SequenceFlow-EnterProblemsToRepairInProgress-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="357" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RepairInProgressToGenerateUpdate-id-0003_di" bpmnElement="SequenceFlow-RepairInProgressToGenerateUpdate-id-0003">
        <di:waypoint x="393" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-RepairInProgressToPayment-id-0007_di" bpmnElement="SequenceFlow-RepairInProgressToPayment-id-0007">
        <di:waypoint x="375" y="88" />
        <di:waypoint x="375" y="210" />
        <di:waypoint x="475" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-GenerateUpdateToSendEmail-id-0004_di" bpmnElement="SequenceFlow-GenerateUpdateToSendEmail-id-0004">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-SendEmailToDailyUpdate-id-0005_di" bpmnElement="SequenceFlow-SendEmailToDailyUpdate-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="807" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DailyUpdateToRepairInProgress-id-0006_di" bpmnElement="SequenceFlow-DailyUpdateToRepairInProgress-id-0006">
        <di:waypoint x="825" y="88" />
        <di:waypoint x="825" y="140" />
        <di:waypoint x="375" y="140" />
        <di:waypoint x="375" y="88" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PaymentToConfirmSuccess-id-0008_di" bpmnElement="SequenceFlow-PaymentToConfirmSuccess-id-0008">
        <di:waypoint x="575" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ConfirmSuccessToScheduleNext-id-0009_di" bpmnElement="SequenceFlow-ConfirmSuccessToScheduleNext-id-0009">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ScheduleNextToRepairComplete-id-0010_di" bpmnElement="SequenceFlow-ScheduleNextToRepairComplete-id-0010">
        <di:waypoint x="875" y="210" />
        <di:waypoint x="957" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
