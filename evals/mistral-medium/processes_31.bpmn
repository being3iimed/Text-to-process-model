<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BlizzardCharacterGenerator" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process_CharacterCreation" name="Blizzard Online Character Generator" isExecutable="true">
    <bpmn:startEvent id="StartEvent-StartCharacterCreation-id-0001" name="Start Character Creation">
      <bpmn:outgoing>SequenceFlow-StartToSplit-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway-Split-id-0001" name="Parallel Execution" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-StartToSplit-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToCheckAccount-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToBrainstormNames-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-CheckBattleNetAccount-id-0001" name="Check Battle.net Account">
      <bpmn:incoming>SequenceFlow-SplitToCheckAccount-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckAccountToAccountExists-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-AccountExists-id-0001" name="Account Exists?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckAccountToAccountExists-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AccountExistsToAccountSetupComplete-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-AccountExistsToEnterAccountInfo-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-AccountSetupComplete-id-0001" name="Account Setup Complete">
      <bpmn:incoming>SequenceFlow-AccountExistsToAccountSetupComplete-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ClickLinkToAccountSetupComplete-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AccountSetupCompleteToJoin-id-0001</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-EnterAccountInformation-id-0001" name="Enter Account Information">
      <bpmn:incoming>SequenceFlow-AccountExistsToEnterAccountInfo-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnterAccountInfoToSendEmail-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="SendTask-SendConfirmationEmail-id-0001" name="Send: confirmation email">
      <bpmn:incoming>SequenceFlow-EnterAccountInfoToSendEmail-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendEmailToReceiveEmail-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask-ReceiveConfirmationEmail-id-0001" name="Receive: confirmation email">
      <bpmn:incoming>SequenceFlow-SendEmailToReceiveEmail-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveEmailToClickLink-id-0001</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="UserTask-ClickConfirmationLink-id-0001" name="Click Confirmation Link">
      <bpmn:incoming>SequenceFlow-ReceiveEmailToClickLink-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ClickLinkToAccountSetupComplete-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-BrainstormCharacterNames-id-0001" name="Brainstorm Character Names">
      <bpmn:incoming>SequenceFlow-SplitToBrainstormNames-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BrainstormNamesToJoin-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-Join-id-0001" name="Synchronize Branches" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-BrainstormNamesToJoin-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AccountSetupCompleteToJoin-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToCheckSubscription-id-0001</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-CheckWoWSubscription-id-0001" name="Check WoW Subscription">
      <bpmn:incoming>SequenceFlow-JoinToCheckSubscription-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckSubscriptionToSubscriptionActive-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-SubscriptionActive-id-0001" name="Subscription Active?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckSubscriptionToSubscriptionActive-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SubscriptionActiveToLogIntoGame-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SubscriptionActiveToSelectPayment-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-SelectPaymentMethod-id-0001" name="Select Payment Method">
      <bpmn:incoming>SequenceFlow-SubscriptionActiveToSelectPayment-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectPaymentToPaymentMethod-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PaymentMethod-id-0001" name="Payment Method?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-SelectPaymentToPaymentMethod-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PaymentMethodToCreditCard-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PaymentMethodToBankAccount-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-EnterCreditCardInfo-id-0001" name="Enter Credit Card Info">
      <bpmn:incoming>SequenceFlow-PaymentMethodToCreditCard-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreditCardToLogIntoGame-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-EnterIBANBIC-id-0001" name="Enter IBAN/BIC">
      <bpmn:incoming>SequenceFlow-PaymentMethodToBankAccount-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BankAccountToLogIntoGame-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-LogIntoGame-id-0001" name="Log into Game">
      <bpmn:incoming>SequenceFlow-SubscriptionActiveToLogIntoGame-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CreditCardToLogIntoGame-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-BankAccountToLogIntoGame-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-LogIntoGameToSelectRealm-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-SelectRealmRaceClass-id-0001" name="Select Realm/Race/Class">
      <bpmn:incoming>SequenceFlow-LogIntoGameToSelectRealm-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SelectRealmToEnterName-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-EnterCharacterName-id-0001" name="Enter Character Name">
      <bpmn:incoming>SequenceFlow-SelectRealmToEnterName-id-0001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-NameAvailableToEnterName-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EnterNameToCheckAvailability-id-0001</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-CheckNameAvailability-id-0001" name="Check Name Availability">
      <bpmn:incoming>SequenceFlow-EnterNameToCheckAvailability-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckAvailabilityToNameAvailable-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-NameAvailable-id-0001" name="Name Available?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckAvailabilityToNameAvailable-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-NameAvailableToEnterName-id-0001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-NameAvailableToGenerateSelfies-id-0001</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask-GenerateCharacterSelfies-id-0001" name="Generate Character Selfies">
      <bpmn:incoming>SequenceFlow-NameAvailableToGenerateSelfies-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GenerateSelfiesToCharacterCreated-id-0001</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-CharacterCreated-id-0001" name="Character Created">
      <bpmn:incoming>SequenceFlow-GenerateSelfiesToCharacterCreated-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent-ExpansionRelease-id-0001" name="Expansion Release">
      <bpmn:outgoing>SequenceFlow-ExpansionReleaseToSendNotification-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="SendTask-SendExpansionNotification-id-0001" name="Send: expansion release notification">
      <bpmn:incoming>SequenceFlow-ExpansionReleaseToSendNotification-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SendNotificationToNotificationSent-id-0001</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent-NotificationSent-id-0001" name="Notification Sent">
      <bpmn:incoming>SequenceFlow-SendNotificationToNotificationSent-id-0001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToSplit-id-0001" sourceRef="StartEvent-StartCharacterCreation-id-0001" targetRef="ParallelGateway-Split-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToCheckAccount-id-0001" sourceRef="ParallelGateway-Split-id-0001" targetRef="UserTask-CheckBattleNetAccount-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckAccountToAccountExists-id-0001" sourceRef="UserTask-CheckBattleNetAccount-id-0001" targetRef="ExclusiveGateway-AccountExists-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AccountExistsToAccountSetupComplete-id-0001" name="account exists" sourceRef="ExclusiveGateway-AccountExists-id-0001" targetRef="EndEvent-AccountSetupComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AccountExistsToEnterAccountInfo-id-0001" name="no account" sourceRef="ExclusiveGateway-AccountExists-id-0001" targetRef="UserTask-EnterAccountInformation-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EnterAccountInfoToSendEmail-id-0001" sourceRef="UserTask-EnterAccountInformation-id-0001" targetRef="SendTask-SendConfirmationEmail-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendEmailToReceiveEmail-id-0001" sourceRef="SendTask-SendConfirmationEmail-id-0001" targetRef="ReceiveTask-ReceiveConfirmationEmail-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveEmailToClickLink-id-0001" sourceRef="ReceiveTask-ReceiveConfirmationEmail-id-0001" targetRef="UserTask-ClickConfirmationLink-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ClickLinkToAccountSetupComplete-id-0001" sourceRef="UserTask-ClickConfirmationLink-id-0001" targetRef="EndEvent-AccountSetupComplete-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToBrainstormNames-id-0001" sourceRef="ParallelGateway-Split-id-0001" targetRef="UserTask-BrainstormCharacterNames-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BrainstormNamesToJoin-id-0001" sourceRef="UserTask-BrainstormCharacterNames-id-0001" targetRef="ParallelGateway-Join-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AccountSetupCompleteToJoin-id-0001" sourceRef="EndEvent-AccountSetupComplete-id-0001" targetRef="ParallelGateway-Join-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToCheckSubscription-id-0001" sourceRef="ParallelGateway-Join-id-0001" targetRef="UserTask-CheckWoWSubscription-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckSubscriptionToSubscriptionActive-id-0001" sourceRef="UserTask-CheckWoWSubscription-id-0001" targetRef="ExclusiveGateway-SubscriptionActive-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubscriptionActiveToLogIntoGame-id-0001" name="subscription active" sourceRef="ExclusiveGateway-SubscriptionActive-id-0001" targetRef="UserTask-LogIntoGame-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SubscriptionActiveToSelectPayment-id-0001" name="subscription inactive" sourceRef="ExclusiveGateway-SubscriptionActive-id-0001" targetRef="UserTask-SelectPaymentMethod-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectPaymentToPaymentMethod-id-0001" sourceRef="UserTask-SelectPaymentMethod-id-0001" targetRef="ExclusiveGateway-PaymentMethod-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PaymentMethodToCreditCard-id-0001" name="credit card" sourceRef="ExclusiveGateway-PaymentMethod-id-0001" targetRef="UserTask-EnterCreditCardInfo-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PaymentMethodToBankAccount-id-0001" name="bank account" sourceRef="ExclusiveGateway-PaymentMethod-id-0001" targetRef="UserTask-EnterIBANBIC-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CreditCardToLogIntoGame-id-0001" sourceRef="UserTask-EnterCreditCardInfo-id-0001" targetRef="UserTask-LogIntoGame-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BankAccountToLogIntoGame-id-0001" sourceRef="UserTask-EnterIBANBIC-id-0001" targetRef="UserTask-LogIntoGame-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-LogIntoGameToSelectRealm-id-0001" sourceRef="UserTask-LogIntoGame-id-0001" targetRef="UserTask-SelectRealmRaceClass-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SelectRealmToEnterName-id-0001" sourceRef="UserTask-SelectRealmRaceClass-id-0001" targetRef="UserTask-EnterCharacterName-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-EnterNameToCheckAvailability-id-0001" sourceRef="UserTask-EnterCharacterName-id-0001" targetRef="ServiceTask-CheckNameAvailability-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckAvailabilityToNameAvailable-id-0001" sourceRef="ServiceTask-CheckNameAvailability-id-0001" targetRef="ExclusiveGateway-NameAvailable-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NameAvailableToEnterName-id-0001" name="name unavailable" sourceRef="ExclusiveGateway-NameAvailable-id-0001" targetRef="UserTask-EnterCharacterName-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-NameAvailableToGenerateSelfies-id-0001" name="name available" sourceRef="ExclusiveGateway-NameAvailable-id-0001" targetRef="ServiceTask-GenerateCharacterSelfies-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GenerateSelfiesToCharacterCreated-id-0001" sourceRef="ServiceTask-GenerateCharacterSelfies-id-0001" targetRef="EndEvent-CharacterCreated-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ExpansionReleaseToSendNotification-id-0001" sourceRef="StartEvent-ExpansionRelease-id-0001" targetRef="SendTask-SendExpansionNotification-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SendNotificationToNotificationSent-id-0001" sourceRef="SendTask-SendExpansionNotification-id-0001" targetRef="EndEvent-NotificationSent-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_CharacterCreation">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_CharacterCreation" bpmnElement="Process_CharacterCreation">
