        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CleanToDrape-id-0004_di" bpmnElement="SequenceFlow-CleanToDrape-id-0004">
