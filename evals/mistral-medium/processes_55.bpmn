<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CentralVenousCatheterization" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process_CentralVenousCatheterization" isExecutable="true">
    <bpmn:startEvent id="StartEvent-Initiated-id-0001" name="Central Venous Catheterization Initiated">
      <bpmn:outgoing>SequenceFlow-StartToPrepare-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-PrepareImplements-id-0001" name="Prepare implements">
      <bpmn:incoming>SequenceFlow-StartToPrepare-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrepareToWash-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-WashHands-id-0002" name="Wash hands and wear sterile clothes">
      <bpmn:incoming>SequenceFlow-PrepareToWash-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WashToClean-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CleanPunctureArea-id-0003" name="Clean puncture area">
      <bpmn:incoming>SequenceFlow-WashToClean-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CleanToDrape-id-0004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-DrapePunctureZone-id-0004" name="Drape puncture zone">
      <bpmn:incoming>SequenceFlow-CleanToDrape-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DrapeToConfigure-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConfigureUltrasound-id-0005" name="Configure ultrasound">
      <bpmn:incoming>SequenceFlow-DrapeToConfigure-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConfigureToApplyGel-id-0006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ApplyGelToProbe-id-0006" name="Apply gel to probe">
      <bpmn:incoming>SequenceFlow-ConfigureToApplyGel-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ApplyGelToCover-id-0007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CoverProbe-id-0007" name="Cover probe and apply sterile gel">
      <bpmn:incoming>SequenceFlow-ApplyGelToCover-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CoverToPosition-id-0008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-PositionProbeAndPatient-id-0008" name="Position probe and patient">
      <bpmn:incoming>SequenceFlow-CoverToPosition-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PositionToVeinIdentification-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="InclusiveGateway-VeinIdentification-id-0001" name="Identify vein">
      <bpmn:incoming>SequenceFlow-PositionToVeinIdentification-id-0009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VeinIdentificationToAnatomic-id-0010</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-VeinIdentificationToDoppler-id-0011</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-VeinIdentificationToCompression-id-0012</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="UserTask-IdentifyVeinAnatomic-id-0009" name="Identify vein using anatomic landmarks">
      <bpmn:incoming>SequenceFlow-VeinIdentificationToAnatomic-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnatomicToJoin-id-0013</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-IdentifyVeinDoppler-id-0010" name="Identify vein using Doppler">
      <bpmn:incoming>SequenceFlow-VeinIdentificationToDoppler-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DopplerToJoin-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-IdentifyVeinCompression-id-0011" name="Identify vein using compression">
      <bpmn:incoming>SequenceFlow-VeinIdentificationToCompression-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CompressionToJoin-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="InclusiveGateway-VeinIdentificationJoin-id-0002" name="Vein identification complete">
      <bpmn:incoming>SequenceFlow-AnatomicToJoin-id-0013</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-DopplerToJoin-id-0014</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-CompressionToJoin-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToAnesthetize-id-0016</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="UserTask-AnesthetizeAndPuncture-id-0012" name="Anesthetize and puncture">
      <bpmn:incoming>SequenceFlow-JoinToAnesthetize-id-0016</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-BloodReturnIncorrectToAnesthetize-id-0020</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-WirePositionIncorrectToAnesthetize-id-0026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AnesthetizeToCheckBlood-id-0017</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CheckBloodReturn-id-0013" name="Check blood return">
      <bpmn:incoming>SequenceFlow-AnesthetizeToCheckBlood-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckBloodToGateway-id-0018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-BloodReturn-id-0001" name="Blood return correct?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckBloodToGateway-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-BloodReturnCorrectToDrop-id-0019</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-BloodReturnIncorrectToAnesthetize-id-0020</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-DropProbe-id-0014" name="Drop probe and remove syringe">
      <bpmn:incoming>SequenceFlow-BloodReturnCorrectToDrop-id-0019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DropToInstallGuidewire-id-0021</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-InstallGuidewire-id-0015" name="Install guidewire">
      <bpmn:incoming>SequenceFlow-DropToInstallGuidewire-id-0021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InstallToRemoveTrocar-id-0022</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-RemoveTrocar-id-0016" name="Remove trocar">
      <bpmn:incoming>SequenceFlow-InstallToRemoveTrocar-id-0022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RemoveToCheckWire-id-0023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CheckWirePosition-id-0017" name="Check wire position [long/short axis]">
      <bpmn:incoming>SequenceFlow-RemoveToCheckWire-id-0023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CheckWireToGateway-id-0024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-WirePosition-id-0001" name="Wire position correct?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CheckWireToGateway-id-0024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WirePositionCorrectToWiden-id-0025</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-WirePositionIncorrectToAnesthetize-id-0026</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-WidenPathway-id-0018" name="Widen pathway">
      <bpmn:incoming>SequenceFlow-WirePositionCorrectToWiden-id-0025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WidenToAdvance-id-0027</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-AdvanceCatheter-id-0019" name="Advance catheter">
      <bpmn:incoming>SequenceFlow-WidenToAdvance-id-0027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdvanceToRemoveGuidewire-id-0028</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-RemoveGuidewire-id-0020" name="Remove guidewire">
      <bpmn:incoming>SequenceFlow-AdvanceToRemoveGuidewire-id-0028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-RemoveGuidewireToVerify-id-0029</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-VerifyFlow-id-0021" name="Verify flow/reflow and catheter position">
      <bpmn:incoming>SequenceFlow-RemoveGuidewireToVerify-id-0029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-VerifyToEnd-id-0030</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-ProcedureComplete-id-0001" name="Procedure Complete">
      <bpmn:incoming>SequenceFlow-VerifyToEnd-id-0030</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToPrepare-id-0001" sourceRef="StartEvent-Initiated-id-0001" targetRef="UserTask-PrepareImplements-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrepareToWash-id-0002" sourceRef="UserTask-PrepareImplements-id-0001" targetRef="UserTask-WashHands-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-WashToClean-id-0003" sourceRef="UserTask-WashHands-id-0002" targetRef="UserTask-CleanPunctureArea-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-CleanToDrape-id-0004" sourceRef="UserTask-CleanPunctureArea-id-0003" targetRef="UserTask-DrapePunctureZone-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-DrapeToConfigure-id-0005" sourceRef="UserTask-DrapePunctureZone-id-0004" targetRef="UserTask-ConfigureUltrasound-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-ConfigureToApplyGel-id-0006" sourceRef="UserTask-ConfigureUltrasound-id-0005" targetRef="UserTask-ApplyGelToProbe-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-ApplyGelToCover-id-0007" sourceRef="UserTask-ApplyGelToProbe-id-0006" targetRef="UserTask-CoverProbe-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-CoverToPosition-id-0008" sourceRef="UserTask-CoverProbe-id-0007" targetRef="UserTask-PositionProbeAndPatient-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-PositionToVeinIdentification-id-0009" sourceRef="UserTask-PositionProbeAndPatient-id-0008" targetRef="InclusiveGateway-VeinIdentification-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-VeinIdentificationToAnatomic-id-0010" name="anatomic" sourceRef="InclusiveGateway-VeinIdentification-id-0001" targetRef="UserTask-IdentifyVeinAnatomic-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-VeinIdentificationToDoppler-id-0011" name="doppler" sourceRef="InclusiveGateway-VeinIdentification-id-0001" targetRef="UserTask-IdentifyVeinDoppler-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-VeinIdentificationToCompression-id-0012" name="compression" sourceRef="InclusiveGateway-VeinIdentification-id-0001" targetRef="UserTask-IdentifyVeinCompression-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-AnatomicToJoin-id-0013" sourceRef="UserTask-IdentifyVeinAnatomic-id-0009" targetRef="InclusiveGateway-VeinIdentificationJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-DopplerToJoin-id-0014" sourceRef="UserTask-IdentifyVeinDoppler-id-0010" targetRef="InclusiveGateway-VeinIdentificationJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CompressionToJoin-id-0015" sourceRef="UserTask-IdentifyVeinCompression-id-0011" targetRef="InclusiveGateway-VeinIdentificationJoin-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToAnesthetize-id-0016" sourceRef="InclusiveGateway-VeinIdentificationJoin-id-0002" targetRef="UserTask-AnesthetizeAndPuncture-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-AnesthetizeToCheckBlood-id-0017" sourceRef="UserTask-AnesthetizeAndPuncture-id-0012" targetRef="UserTask-CheckBloodReturn-id-0013" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckBloodToGateway-id-0018" sourceRef="UserTask-CheckBloodReturn-id-0013" targetRef="ExclusiveGateway-BloodReturn-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BloodReturnCorrectToDrop-id-0019" name="blood_return == correct" sourceRef="ExclusiveGateway-BloodReturn-id-0001" targetRef="UserTask-DropProbe-id-0014" />
    <bpmn:sequenceFlow id="SequenceFlow-BloodReturnIncorrectToAnesthetize-id-0020" name="blood_return == incorrect" sourceRef="ExclusiveGateway-BloodReturn-id-0001" targetRef="UserTask-AnesthetizeAndPuncture-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-DropToInstallGuidewire-id-0021" sourceRef="UserTask-DropProbe-id-0014" targetRef="UserTask-InstallGuidewire-id-0015" />
    <bpmn:sequenceFlow id="SequenceFlow-InstallToRemoveTrocar-id-0022" sourceRef="UserTask-InstallGuidewire-id-0015" targetRef="UserTask-RemoveTrocar-id-0016" />
    <bpmn:sequenceFlow id="SequenceFlow-RemoveToCheckWire-id-0023" sourceRef="UserTask-RemoveTrocar-id-0016" targetRef="UserTask-CheckWirePosition-id-0017" />
    <bpmn:sequenceFlow id="SequenceFlow-CheckWireToGateway-id-0024" sourceRef="UserTask-CheckWirePosition-id-0017" targetRef="ExclusiveGateway-WirePosition-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-WirePositionCorrectToWiden-id-0025" name="wire_position == correct" sourceRef="ExclusiveGateway-WirePosition-id-0001" targetRef="UserTask-WidenPathway-id-0018" />
    <bpmn:sequenceFlow id="SequenceFlow-WirePositionIncorrectToAnesthetize-id-0026" name="wire_position == incorrect" sourceRef="ExclusiveGateway-WirePosition-id-0001" targetRef="UserTask-AnesthetizeAndPuncture-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-WidenToAdvance-id-0027" sourceRef="UserTask-WidenPathway-id-0018" targetRef="UserTask-AdvanceCatheter-id-0019" />
    <bpmn:sequenceFlow id="SequenceFlow-AdvanceToRemoveGuidewire-id-0028" sourceRef="UserTask-AdvanceCatheter-id-0019" targetRef="UserTask-RemoveGuidewire-id-0020" />
    <bpmn:sequenceFlow id="SequenceFlow-RemoveGuidewireToVerify-id-0029" sourceRef="UserTask-RemoveGuidewire-id-0020" targetRef="UserTask-VerifyFlow-id-0021" />
    <bpmn:sequenceFlow id="SequenceFlow-VerifyToEnd-id-0030" sourceRef="UserTask-VerifyFlow-id-0021" targetRef="EndEvent-ProcedureComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_CentralVenousCatheterization">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_CentralVenousCatheterization" bpmnElement="Process_CentralVenousCatheterization">
      <bpmndi:BPMNShape id="StartEvent-Initiated-id-0001_di" bpmnElement="StartEvent-Initiated-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-PrepareImplements-id-0001_di" bpmnElement="UserTask-PrepareImplements-id-0001">
