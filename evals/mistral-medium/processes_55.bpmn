        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-PrepareToWash-id-0002_di" bpmnElement="SequenceFlow-PrepareToWash-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-WashToClean-id-0003_di" bpmnElement="SequenceFlow-WashToClean-id-0003">
