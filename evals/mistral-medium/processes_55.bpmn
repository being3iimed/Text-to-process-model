      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-IdentifyVeinAnatomic-id-0009_di" bpmnElement="UserTask-IdentifyVeinAnatomic-id-0009">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InclusiveGateway-VeinIdentificationJoin-id-0002_di" bpmnElement="InclusiveGateway-VeinIdentificationJoin-id-0002">
        <dc:Bounds x="1700" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-AnesthetizeAndPuncture-id-0012_di" bpmnElement="UserTask-AnesthetizeAndPuncture-id-0012">
        <dc:Bounds x="1825" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CheckBloodReturn-id-0013_di" bpmnElement="UserTask-CheckBloodReturn-id-0013">
        <dc:Bounds x="1975" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-BloodReturn-id-0001_di" bpmnElement="ExclusiveGateway-BloodReturn-id-0001" isMarkerVisible="true">
        <dc:Bounds x="2150" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-DropProbe-id-0014_di" bpmnElement="UserTask-DropProbe-id-0014">
        <dc:Bounds x="2275" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-InstallGuidewire-id-0015_di" bpmnElement="UserTask-InstallGuidewire-id-0015">
        <dc:Bounds x="2425" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-RemoveTrocar-id-0016_di" bpmnElement="UserTask-RemoveTrocar-id-0016">
