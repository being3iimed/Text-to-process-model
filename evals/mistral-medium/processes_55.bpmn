        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DrapeToConfigure-id-0005_di" bpmnElement="SequenceFlow-DrapeToConfigure-id-0005">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ConfigureToApplyGel-id-0006_di" bpmnElement="SequenceFlow-ConfigureToApplyGel-id-0006">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ApplyGelToCover-id-0007_di" bpmnElement="SequenceFlow-ApplyGelToCover-id-0007">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-CoverToPosition-id-0008_di" bpmnElement="SequenceFlow-CoverToPosition-id-0008">
        <di:waypoint x="1175" y="70" />
