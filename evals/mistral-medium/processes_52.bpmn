<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="DismissalProcessDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="DismissalProcess" isExecutable="true">
    <bpmn:startEvent id="MessageStartEvent-DismissalReceivedFromMPON-id-0001" name="Dismissal Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToReceive-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="ReceiveTask-ReceiveDismissalFromMPON-id-0001" name="Receive: dismissal from MPON">
      <bpmn:incoming>SequenceFlow-StartToReceive-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReceiveToReview-id-0002</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="UserTask-MPOOReviewsDismissal-id-0001" name="MPOO reviews dismissal">
      <bpmn:incoming>SequenceFlow-ReceiveToReview-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToDecision-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-DismissalDecision-id-0001" name="Dismissal Decision" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-ReviewToDecision-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-DecisionToOppose-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-DecisionToConfirm-id-0005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask-SendOppositionToDismissal-id-0001" name="Send: opposition to dismissal">
      <bpmn:incoming>SequenceFlow-DecisionToOppose-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-OpposeToConverge-id-0006</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask-SendConfirmationOfDismissal-id-0002" name="Send: confirmation of dismissal">
      <bpmn:incoming>SequenceFlow-DecisionToConfirm-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConfirmToConverge-id-0007</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-ConvergePaths-id-0002" name="Converge Paths" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-OpposeToConverge-id-0006</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-ConfirmToConverge-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ConvergeToEnd-id-0008</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent-DismissalProcessComplete-id-0001" name="Dismissal Process Complete">
      <bpmn:incoming>SequenceFlow-ConvergeToEnd-id-0008</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToReceive-id-0001" sourceRef="MessageStartEvent-DismissalReceivedFromMPON-id-0001" targetRef="ReceiveTask-ReceiveDismissalFromMPON-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReceiveToReview-id-0002" sourceRef="ReceiveTask-ReceiveDismissalFromMPON-id-0001" targetRef="UserTask-MPOOReviewsDismissal-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToDecision-id-0003" sourceRef="UserTask-MPOOReviewsDismissal-id-0001" targetRef="ExclusiveGateway-DismissalDecision-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DecisionToOppose-id-0004" name="MPOO opposes dismissal" sourceRef="ExclusiveGateway-DismissalDecision-id-0001" targetRef="SendTask-SendOppositionToDismissal-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-DecisionToConfirm-id-0005" name="MPOO confirms dismissal" sourceRef="ExclusiveGateway-DismissalDecision-id-0001" targetRef="SendTask-SendConfirmationOfDismissal-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-OpposeToConverge-id-0006" sourceRef="SendTask-SendOppositionToDismissal-id-0001" targetRef="ExclusiveGateway-ConvergePaths-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ConfirmToConverge-id-0007" sourceRef="SendTask-SendConfirmationOfDismissal-id-0002" targetRef="ExclusiveGateway-ConvergePaths-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ConvergeToEnd-id-0008" sourceRef="ExclusiveGateway-ConvergePaths-id-0002" targetRef="EndEvent-DismissalProcessComplete-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_DismissalProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_DismissalProcess" bpmnElement="DismissalProcess">
      <bpmndi:BPMNShape id="MessageStartEvent-DismissalReceivedFromMPON-id-0001_di" bpmnElement="MessageStartEvent-DismissalReceivedFromMPON-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-ReceiveDismissalFromMPON-id-0001_di" bpmnElement="ReceiveTask-ReceiveDismissalFromMPON-id-0001">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-MPOOReviewsDismissal-id-0001_di" bpmnElement="UserTask-MPOOReviewsDismissal-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-DismissalDecision-id-0001_di" bpmnElement="ExclusiveGateway-DismissalDecision-id-0001" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendOppositionToDismissal-id-0001_di" bpmnElement="SendTask-SendOppositionToDismissal-id-0001">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ConvergePaths-id-0002_di" bpmnElement="ExclusiveGateway-ConvergePaths-id-0002" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-DismissalProcessComplete-id-0001_di" bpmnElement="EndEvent-DismissalProcessComplete-id-0001">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-SendConfirmationOfDismissal-id-0002_di" bpmnElement="SendTask-SendConfirmationOfDismissal-id-0002">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow-StartToReceive-id-0001_di" bpmnElement="SequenceFlow-StartToReceive-id-0001">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReceiveToReview-id-0002_di" bpmnElement="SequenceFlow-ReceiveToReview-id-0002">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ReviewToDecision-id-0003_di" bpmnElement="SequenceFlow-ReviewToDecision-id-0003">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DecisionToOppose-id-0004_di" bpmnElement="SequenceFlow-DecisionToOppose-id-0004">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-DecisionToConfirm-id-0005_di" bpmnElement="SequenceFlow-DecisionToConfirm-id-0005">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-OpposeToConverge-id-0006_di" bpmnElement="SequenceFlow-OpposeToConverge-id-0006">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ConvergeToEnd-id-0008_di" bpmnElement="SequenceFlow-ConvergeToEnd-id-0008">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow-ConfirmToConverge-id-0007_di" bpmnElement="SequenceFlow-ConfirmToConverge-id-0007">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="825" y="210" />
        <di:waypoint x="825" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
