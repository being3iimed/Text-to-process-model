<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_EmployeeDevelopmentProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process_EmployeeDevelopment" isExecutable="true">
    <bpmn:startEvent id="StartEvent-EmployeeDevelopmentProcessInitiated-id-0001" name="Employee Development Process Initiated">
      <bpmn:outgoing>SequenceFlow-StartToIdentifyNeeds-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-IdentifyDevelopmentNeeds-id-0001" name="Identify Development Needs">
      <bpmn:incoming>SequenceFlow-StartToIdentifyNeeds-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-IdentifyNeedsToCreatePlan-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-CreatePersonalDevelopmentPlan-id-0002" name="Create Personal Development Plan">
      <bpmn:incoming>SequenceFlow-IdentifyNeedsToCreatePlan-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-CreatePlanToSplitExecution-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway-SplitDevelopmentExecution-id-0001" name="Development Execution Split" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-CreatePlanToSplitExecution-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-SplitToAssignTraining-id-0004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-SplitToAssignMentorship-id-0005</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-AssignTrainingPrograms-id-0003" name="Assign Training Programs">
      <bpmn:incoming>SequenceFlow-SplitToAssignTraining-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignTrainingToJoin-id-0006</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-AssignMentorship-id-0004" name="Assign Mentorship">
      <bpmn:incoming>SequenceFlow-SplitToAssignMentorship-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AssignMentorshipToJoin-id-0007</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway-JoinDevelopmentExecution-id-0002" name="Development Execution Join" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-AssignTrainingToJoin-id-0006</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AssignMentorshipToJoin-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-JoinToWorkOnSkills-id-0008</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask-WorkOnSkillEnhancement-id-0005" name="Work on Skill Enhancement">
      <bpmn:incoming>SequenceFlow-JoinToWorkOnSkills-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WorkOnSkillsToProvideFeedback-id-0009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ProvideFeedbackAndEvaluation-id-0006" name="Provide Feedback and Evaluation">
      <bpmn:incoming>SequenceFlow-WorkOnSkillsToProvideFeedback-id-0009</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AdjustPlanToProvideFeedback-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProvideFeedbackToEvaluateMilestones-id-0010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-EvaluateMilestoneCompletion-id-0007" name="Evaluate Milestone Completion">
      <bpmn:incoming>SequenceFlow-ProvideFeedbackToEvaluateMilestones-id-0010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-EvaluateMilestonesToGateway-id-0011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-MilestonesAchieved-id-0001" name="Milestones Achieved?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-EvaluateMilestonesToGateway-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-MilestonesAchievedToPerformanceReview-id-0012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-MilestonesNotAchievedToAdjustPlan-id-0013</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-AdjustDevelopmentPlan-id-0008" name="Adjust Development Plan">
      <bpmn:incoming>SequenceFlow-MilestonesNotAchievedToAdjustPlan-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdjustPlanToProvideFeedback-id-0014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ConductFormalPerformanceReview-id-0009" name="Conduct Formal Performance Review">
      <bpmn:incoming>SequenceFlow-MilestonesAchievedToPerformanceReview-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-WorkOnSkillsToPerformanceReview-id-0015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway-PromotionApproved-id-0002" name="Promotion Approved?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-WorkOnSkillsToPerformanceReview-id-0015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PromotionApprovedToFinalize-id-0016</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PromotionDeniedToFeedback-id-0017</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask-FinalizePromotion-id-0010" name="Finalize Promotion">
      <bpmn:incoming>SequenceFlow-PromotionApprovedToFinalize-id-0016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-FinalizeToAdjustCompensation-id-0018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask-AdjustCompensation-id-0011" name="Adjust Compensation">
      <bpmn:incoming>SequenceFlow-FinalizeToAdjustCompensation-id-0018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AdjustCompensationToPromotedEnd-id-0019</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-EmployeePromotedToNewRole-id-0001" name="Employee Promoted to New Role">
      <bpmn:incoming>SequenceFlow-AdjustCompensationToPromotedEnd-id-0019</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask-ProvideDevelopmentFeedback-id-0012" name="Provide Development Feedback">
      <bpmn:incoming>SequenceFlow-PromotionDeniedToFeedback-id-0017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ProvideFeedbackToContinuedEnd-id-0020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent-DevelopmentPlanContinued-id-0002" name="Development Plan Continued">
      <bpmn:incoming>SequenceFlow-ProvideFeedbackToContinuedEnd-id-0020</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToIdentifyNeeds-id-0001" sourceRef="StartEvent-EmployeeDevelopmentProcessInitiated-id-0001" targetRef="UserTask-IdentifyDevelopmentNeeds-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-IdentifyNeedsToCreatePlan-id-0002" sourceRef="UserTask-IdentifyDevelopmentNeeds-id-0001" targetRef="UserTask-CreatePersonalDevelopmentPlan-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-CreatePlanToSplitExecution-id-0003" sourceRef="UserTask-CreatePersonalDevelopmentPlan-id-0002" targetRef="ParallelGateway-SplitDevelopmentExecution-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToAssignTraining-id-0004" sourceRef="ParallelGateway-SplitDevelopmentExecution-id-0001" targetRef="ServiceTask-AssignTrainingPrograms-id-0003" />
    <bpmn:sequenceFlow id="SequenceFlow-SplitToAssignMentorship-id-0005" sourceRef="ParallelGateway-SplitDevelopmentExecution-id-0001" targetRef="ServiceTask-AssignMentorship-id-0004" />
    <bpmn:sequenceFlow id="SequenceFlow-AssignTrainingToJoin-id-0006" sourceRef="ServiceTask-AssignTrainingPrograms-id-0003" targetRef="ParallelGateway-JoinDevelopmentExecution-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-AssignMentorshipToJoin-id-0007" sourceRef="ServiceTask-AssignMentorship-id-0004" targetRef="ParallelGateway-JoinDevelopmentExecution-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-JoinToWorkOnSkills-id-0008" sourceRef="ParallelGateway-JoinDevelopmentExecution-id-0002" targetRef="UserTask-WorkOnSkillEnhancement-id-0005" />
    <bpmn:sequenceFlow id="SequenceFlow-WorkOnSkillsToProvideFeedback-id-0009" sourceRef="UserTask-WorkOnSkillEnhancement-id-0005" targetRef="UserTask-ProvideFeedbackAndEvaluation-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-ProvideFeedbackToEvaluateMilestones-id-0010" sourceRef="UserTask-ProvideFeedbackAndEvaluation-id-0006" targetRef="UserTask-EvaluateMilestoneCompletion-id-0007" />
    <bpmn:sequenceFlow id="SequenceFlow-EvaluateMilestonesToGateway-id-0011" sourceRef="UserTask-EvaluateMilestoneCompletion-id-0007" targetRef="ExclusiveGateway-MilestonesAchieved-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-MilestonesAchievedToPerformanceReview-id-0012" name="milestones_achieved" sourceRef="ExclusiveGateway-MilestonesAchieved-id-0001" targetRef="UserTask-ConductFormalPerformanceReview-id-0009" />
    <bpmn:sequenceFlow id="SequenceFlow-MilestonesNotAchievedToAdjustPlan-id-0013" sourceRef="ExclusiveGateway-MilestonesAchieved-id-0001" targetRef="UserTask-AdjustDevelopmentPlan-id-0008" />
    <bpmn:sequenceFlow id="SequenceFlow-AdjustPlanToProvideFeedback-id-0014" sourceRef="UserTask-AdjustDevelopmentPlan-id-0008" targetRef="UserTask-ProvideFeedbackAndEvaluation-id-0006" />
    <bpmn:sequenceFlow id="SequenceFlow-WorkOnSkillsToPerformanceReview-id-0015" sourceRef="UserTask-ConductFormalPerformanceReview-id-0009" targetRef="ExclusiveGateway-PromotionApproved-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-PromotionApprovedToFinalize-id-0016" name="promotion_approved" sourceRef="ExclusiveGateway-PromotionApproved-id-0002" targetRef="UserTask-FinalizePromotion-id-0010" />
    <bpmn:sequenceFlow id="SequenceFlow-PromotionDeniedToFeedback-id-0017" sourceRef="ExclusiveGateway-PromotionApproved-id-0002" targetRef="UserTask-ProvideDevelopmentFeedback-id-0012" />
    <bpmn:sequenceFlow id="SequenceFlow-FinalizeToAdjustCompensation-id-0018" sourceRef="UserTask-FinalizePromotion-id-0010" targetRef="ServiceTask-AdjustCompensation-id-0011" />
    <bpmn:sequenceFlow id="SequenceFlow-AdjustCompensationToPromotedEnd-id-0019" sourceRef="ServiceTask-AdjustCompensation-id-0011" targetRef="EndEvent-EmployeePromotedToNewRole-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ProvideFeedbackToContinuedEnd-id-0020" sourceRef="UserTask-ProvideDevelopmentFeedback-id-0012" targetRef="EndEvent-DevelopmentPlanContinued-id-0002" />
  </bpmn:process>
