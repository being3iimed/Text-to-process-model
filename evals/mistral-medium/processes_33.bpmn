      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess-PlasticAcquisition-id-0001_di" bpmnElement="SubProcess-PlasticAcquisition-id-0001">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-PrinterSetupSplit-id-0001_di" bpmnElement="ParallelGateway-PrinterSetupSplit-id-0001">
        <dc:Bounds x="950" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-TurnOnPrinter-id-0001_di" bpmnElement="ServiceTask-TurnOnPrinter-id-0001">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway-PrinterSetupJoin-id-0001_di" bpmnElement="ParallelGateway-PrinterSetupJoin-id-0001">
        <dc:Bounds x="1400" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-GenerateGcode-id-0001_di" bpmnElement="ServiceTask-GenerateGcode-id-0001">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-PrintModel-id-0001_di" bpmnElement="ServiceTask-PrintModel-id-0001">
        <dc:Bounds x="1675" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-ModelPrinted-id-0001_di" bpmnElement="EndEvent-ModelPrinted-id-0001">
        <dc:Bounds x="1857" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask-HeatPrinterBed-id-0001_di" bpmnElement="ServiceTask-HeatPrinterBed-id-0001">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent-PrinterHeatingTimeout-id-0001_di" bpmnElement="BoundaryEvent-PrinterHeatingTimeout-id-0001">
        <dc:Bounds x="1107" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask-HeatingTimeoutAlert-id-0001_di" bpmnElement="SendTask-HeatingTimeoutAlert-id-0001">
        <dc:Bounds x="1225" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
