  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SubProcess-PlasticAcquisition-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_SubProcess-PlasticAcquisition-id-0001" bpmnElement="SubProcess-PlasticAcquisition-id-0001">
      <bpmndi:BPMNShape id="StartEvent-AcquisitionStart-id-0001_di" bpmnElement="StartEvent-AcquisitionStart-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ColorAvailability-id-0001_di" bpmnElement="ExclusiveGateway-ColorAvailability-id-0001" isMarkerVisible="true">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask-CheckPlasticStock-id-0001_di" bpmnElement="UserTask-CheckPlasticStock-id-0001">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-StockCheck-id-0001_di" bpmnElement="ExclusiveGateway-StockCheck-id-0001" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent-PlasticReady-id-0001_di" bpmnElement="EndEvent-PlasticReady-id-0001">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway-ConvergeAcquisition-id-0001_di" bpmnElement="ExclusiveGateway-ConvergeAcquisition-id-0001" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
