<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions-3DPrintingProcess-id-0001" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <bpmn:process id="Process-3DPrintingWorkflow-id-0001" isExecutable="true">
    <bpmn:startEvent id="StartEvent-CravingCustomModel-id-0001" name="Craving custom 3D model">
      <bpmn:outgoing>SequenceFlow-StartToInitialSketches-id-0001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask-SendInitialSketches-id-0001" name="Send initial sketches to artist">
      <bpmn:incoming>SequenceFlow-StartToInitialSketches-id-0001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-InitialSketchesToReview-id-0002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask-ReviewDraft-id-0002" name="Review artist&#39;s draft and request changes">
      <bpmn:incoming>SequenceFlow-InitialSketchesToReview-id-0002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ReviewToSTLReceive-id-0003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="ReceiveTask-FinalSTLFile-id-0001" name="Receive: final STL file from artist">
      <bpmn:incoming>SequenceFlow-ReviewToSTLReceive-id-0003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-STLToColorSelection-id-0004</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="UserTask-SelectPlasticColor-id-0001" name="Select plastic color for printing">
      <bpmn:incoming>SequenceFlow-STLToColorSelection-id-0004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-ColorToPlasticAcquisition-id-0005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SubProcess-PlasticAcquisition-id-0001" name="Plastic Acquisition">
      <bpmn:incoming>SequenceFlow-ColorToPlasticAcquisition-id-0005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PlasticAcquisitionToPrinterSetup-id-0006</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent-AcquisitionStart-id-0001" name="Acquisition Start">
        <bpmn:outgoing>SequenceFlow-AcquisitionStartToColorCheck-id-0001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="ExclusiveGateway-ColorAvailability-id-0001" name="Color available at home?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-AcquisitionStartToColorCheck-id-0001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-ColorAvailableToStockCheck-id-0002</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-ColorNotAvailableToOrder-id-0003</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UserTask-CheckPlasticStock-id-0001" name="Check plastic stock at home">
        <bpmn:incoming>SequenceFlow-ColorAvailableToStockCheck-id-0002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-StockCheckToStockGateway-id-0004</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ExclusiveGateway-StockCheck-id-0001" name="Stock ≥ 100g?" gatewayDirection="Diverging">
        <bpmn:incoming>SequenceFlow-StockCheckToStockGateway-id-0004</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-StockSufficientToReady-id-0005</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow-StockInsufficientToAddList-id-0006</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent-PlasticReady-id-0001" name="Plastic Ready">
        <bpmn:incoming>SequenceFlow-StockSufficientToReady-id-0005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PlasticReadyToConverge-id-0009</bpmn:outgoing>
      </bpmn:endEvent>
      <bpmn:userTask id="UserTask-AddToShoppingList-id-0001" name="Add plastic to shopping list">
        <bpmn:incoming>SequenceFlow-StockInsufficientToAddList-id-0006</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-AddListToConverge-id-0007</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EndEvent-PlasticOrderedScheduled-id-0001" name="Plastic Ordered/Scheduled">
        <bpmn:incoming>SequenceFlow-AddListToConverge-id-0007</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PlasticScheduledToConverge-id-0011</bpmn:outgoing>
      </bpmn:endEvent>
      <bpmn:serviceTask id="ServiceTask-OrderPlasticOnline-id-0001" name="Order plastic online">
        <bpmn:incoming>SequenceFlow-ColorNotAvailableToOrder-id-0003</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-OrderToConverge-id-0008</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent-PlasticOrdered-id-0001" name="Plastic Ordered">
        <bpmn:incoming>SequenceFlow-OrderToConverge-id-0008</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow-PlasticOrderedToConverge-id-0010</bpmn:outgoing>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="ExclusiveGateway-ConvergeAcquisition-id-0001" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow-PlasticReadyToConverge-id-0009</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-PlasticOrderedToConverge-id-0010</bpmn:incoming>
        <bpmn:incoming>SequenceFlow-PlasticScheduledToConverge-id-0011</bpmn:incoming>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="SequenceFlow-AcquisitionStartToColorCheck-id-0001" sourceRef="StartEvent-AcquisitionStart-id-0001" targetRef="ExclusiveGateway-ColorAvailability-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ColorAvailableToStockCheck-id-0002" name="Color available at home" sourceRef="ExclusiveGateway-ColorAvailability-id-0001" targetRef="UserTask-CheckPlasticStock-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-ColorNotAvailableToOrder-id-0003" name="Color not available" sourceRef="ExclusiveGateway-ColorAvailability-id-0001" targetRef="ServiceTask-OrderPlasticOnline-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-StockCheckToStockGateway-id-0004" sourceRef="UserTask-CheckPlasticStock-id-0001" targetRef="ExclusiveGateway-StockCheck-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-StockSufficientToReady-id-0005" name="Stock ≥ 100g" sourceRef="ExclusiveGateway-StockCheck-id-0001" targetRef="EndEvent-PlasticReady-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-StockInsufficientToAddList-id-0006" name="Stock &#60; 100g" sourceRef="ExclusiveGateway-StockCheck-id-0001" targetRef="UserTask-AddToShoppingList-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-AddListToConverge-id-0007" sourceRef="UserTask-AddToShoppingList-id-0001" targetRef="EndEvent-PlasticOrderedScheduled-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-OrderToConverge-id-0008" sourceRef="ServiceTask-OrderPlasticOnline-id-0001" targetRef="EndEvent-PlasticOrdered-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PlasticReadyToConverge-id-0009" sourceRef="EndEvent-PlasticReady-id-0001" targetRef="ExclusiveGateway-ConvergeAcquisition-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PlasticOrderedToConverge-id-0010" sourceRef="EndEvent-PlasticOrdered-id-0001" targetRef="ExclusiveGateway-ConvergeAcquisition-id-0001" />
      <bpmn:sequenceFlow id="SequenceFlow-PlasticScheduledToConverge-id-0011" sourceRef="EndEvent-PlasticOrderedScheduled-id-0001" targetRef="ExclusiveGateway-ConvergeAcquisition-id-0001" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="ParallelGateway-PrinterSetupSplit-id-0001" name="Parallel Printer Setup" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow-PlasticAcquisitionToPrinterSetup-id-0006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrinterSetupSplitToTurnOn-id-0007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow-PrinterSetupSplitToHeat-id-0008</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-TurnOnPrinter-id-0001" name="Turn on 3D printer">
      <bpmn:incoming>SequenceFlow-PrinterSetupSplitToTurnOn-id-0007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-TurnOnToPrinterSetupJoin-id-0009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-HeatPrinterBed-id-0001" name="Heat printer bed and extruder">
      <bpmn:incoming>SequenceFlow-PrinterSetupSplitToHeat-id-0008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-HeatToPrinterSetupJoin-id-0010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent-PrinterHeatingTimeout-id-0001" name="30 Minute Heating Timeout" attachedToRef="ServiceTask-HeatPrinterBed-id-0001">
      <bpmn:outgoing>SequenceFlow-BoundaryTimeoutToAlert-id-0011</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BoundaryEvent-PrinterHeatingTimeout-id-0001_EventDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask-HeatingTimeoutAlert-id-0001" name="Send: printer heating timeout alert">
      <bpmn:incoming>SequenceFlow-BoundaryTimeoutToAlert-id-0011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-AlertToPrinterSetupJoin-id-0012</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="ParallelGateway-PrinterSetupJoin-id-0001" name="Printer Setup Complete" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow-TurnOnToPrinterSetupJoin-id-0009</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-HeatToPrinterSetupJoin-id-0010</bpmn:incoming>
      <bpmn:incoming>SequenceFlow-AlertToPrinterSetupJoin-id-0012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrinterSetupJoinToGcode-id-0013</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask-GenerateGcode-id-0001" name="Generate gcode from STL">
      <bpmn:incoming>SequenceFlow-PrinterSetupJoinToGcode-id-0013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-GcodeToPrint-id-0014</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask-PrintModel-id-0001" name="Print 3D model">
      <bpmn:incoming>SequenceFlow-GcodeToPrint-id-0014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow-PrintToEnd-id-0015</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent-ModelPrinted-id-0001" name="3D model printed successfully">
      <bpmn:incoming>SequenceFlow-PrintToEnd-id-0015</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow-StartToInitialSketches-id-0001" sourceRef="StartEvent-CravingCustomModel-id-0001" targetRef="UserTask-SendInitialSketches-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-InitialSketchesToReview-id-0002" sourceRef="UserTask-SendInitialSketches-id-0001" targetRef="UserTask-ReviewDraft-id-0002" />
    <bpmn:sequenceFlow id="SequenceFlow-ReviewToSTLReceive-id-0003" sourceRef="UserTask-ReviewDraft-id-0002" targetRef="ReceiveTask-FinalSTLFile-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-STLToColorSelection-id-0004" sourceRef="ReceiveTask-FinalSTLFile-id-0001" targetRef="UserTask-SelectPlasticColor-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-ColorToPlasticAcquisition-id-0005" sourceRef="UserTask-SelectPlasticColor-id-0001" targetRef="SubProcess-PlasticAcquisition-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PlasticAcquisitionToPrinterSetup-id-0006" sourceRef="SubProcess-PlasticAcquisition-id-0001" targetRef="ParallelGateway-PrinterSetupSplit-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrinterSetupSplitToTurnOn-id-0007" sourceRef="ParallelGateway-PrinterSetupSplit-id-0001" targetRef="ServiceTask-TurnOnPrinter-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrinterSetupSplitToHeat-id-0008" sourceRef="ParallelGateway-PrinterSetupSplit-id-0001" targetRef="ServiceTask-HeatPrinterBed-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-TurnOnToPrinterSetupJoin-id-0009" sourceRef="ServiceTask-TurnOnPrinter-id-0001" targetRef="ParallelGateway-PrinterSetupJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-HeatToPrinterSetupJoin-id-0010" sourceRef="ServiceTask-HeatPrinterBed-id-0001" targetRef="ParallelGateway-PrinterSetupJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-BoundaryTimeoutToAlert-id-0011" sourceRef="BoundaryEvent-PrinterHeatingTimeout-id-0001" targetRef="SendTask-HeatingTimeoutAlert-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-AlertToPrinterSetupJoin-id-0012" sourceRef="SendTask-HeatingTimeoutAlert-id-0001" targetRef="ParallelGateway-PrinterSetupJoin-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrinterSetupJoinToGcode-id-0013" sourceRef="ParallelGateway-PrinterSetupJoin-id-0001" targetRef="ServiceTask-GenerateGcode-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-GcodeToPrint-id-0014" sourceRef="ServiceTask-GenerateGcode-id-0001" targetRef="ServiceTask-PrintModel-id-0001" />
    <bpmn:sequenceFlow id="SequenceFlow-PrintToEnd-id-0015" sourceRef="ServiceTask-PrintModel-id-0001" targetRef="EndEvent-ModelPrinted-id-0001" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process-3DPrintingWorkflow-id-0001">
    <bpmndi:BPMNPlane id="BPMNPlane_Process-3DPrintingWorkflow-id-0001" bpmnElement="Process-3DPrintingWorkflow-id-0001">
      <bpmndi:BPMNShape id="StartEvent-CravingCustomModel-id-0001_di" bpmnElement="StartEvent-CravingCustomModel-id-0001">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
