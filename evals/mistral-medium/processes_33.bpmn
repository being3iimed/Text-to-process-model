      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask-FinalSTLFile-id-0001_di" bpmnElement="ReceiveTask-FinalSTLFile-id-0001">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
